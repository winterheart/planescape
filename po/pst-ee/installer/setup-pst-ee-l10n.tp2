	~pst-ee-l10n/override/ru_ZZ/STARTBUT.BAM~       ~lang/ru_ZZ/override~
	~pst-ee-l10n/override/ru_ZZ/MOS2000.PVRZ~       ~lang/ru_ZZ/override~
	~pst-ee-l10n/override/ru_ZZ/MOS2001.PVRZ~       ~lang/ru_ZZ/override~
	~pst-ee-l10n/override/ru_ZZ/MOS2002.PVRZ~       ~lang/ru_ZZ/override~
	~pst-ee-l10n/override/ru_ZZ/MOS2003.PVRZ~       ~lang/ru_ZZ/override~
	~pst-ee-l10n/override/ru_ZZ/MOS2004.PVRZ~       ~lang/ru_ZZ/override~
