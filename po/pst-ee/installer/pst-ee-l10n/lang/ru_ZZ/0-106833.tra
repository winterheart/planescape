@24704 = ~«Понятно».~
@24705 = ~«Наверное, так и стоит поступить...»~
@24706 = ~«Наверное, так и стоит поступить...»~
@24707 = ~«Наверное, так и стоит поступить...»~
@24708 = ~Как только ты подходишь, труп останавливается и смотрит на тебя невидящим взглядом. На его лбу вырезан номер «782», а его губы крепко зашиты. От тела исходит легкий запах формальдегида.~
@24709 = ~«Я ищу ключ... быть может, он у тебя?»~
@24710 = ~Труп не отвечает.~
@24711 = ~«Тогда неважно. Прощай».~
@24712 = ~«Я ищу ключ... быть может, он у тебя?»~
@24713 = ~Осмотреть труп, проверить, есть ли у него ключ.~
@24714 = ~«Было приятно с тобой поболтать. Прощай».~
@24715 = ~Кажется, у этого трупа есть какой-то ключ. Он крепко держит его в левой руке, сжимая его большим и указательным пальцем мертвой хваткой. Чтобы взять ключ, тебе придется сломать руку.~
@24716 = ~«Мне нужен этот ключ, труп... похоже, тебе уже недолго осталось прозябать в этом мире».~
@24717 = ~Оставить труп в покое.~
@24718 = ~«Я хотел поговорить с тобой о торговце Заке».~
@24719 = ~Труп женщины смотрит на тебя пустым взглядом. На ее лбу вырезан номер «916»; ее губы крепко зашиты. От тела исходит легкий запах формальдегида.~
@24720 = ~«Итак... чем занимаешься вечером?»~
@24721 = ~Труп продолжает пялиться на тебя.~
@24722 = ~«Тогда прощай». ~
@24723 = ~«Что-то не так, Анна?»~
@24724 = ~«В чем проблема?»~
@24725 = ~«Тогда уйдем».~
@24726 = ~«Спрошу еще раз... в чем проблема?»~
@24727 = ~«Фелл?»~
@24728 = ~«Тогда уйдем».~
@24729 = ~«Анна, пока я здесь, тебе ничто не угрожает. Скажи мне, кто такой 'дабус'?»~
@24730 = ~«Что за 'дабус'?»~
@24731 = ~«Анна, пока я здесь, тебе ничто не угрожает. А теперь скажи мне, что здесь не так».~
@24732 = ~«Я думаю, что лучше прояснить этот вопрос прямо сейчас».~
@24733 = ~«Тогда уйдем».~
@24734 = ~«Хорошо... но ведь Фелл тоже дабус. Что не так?»~
@24735 = ~«Тогда прощай». ~
@24736 = ~«Тогда прощай». ~
@24737 = ~«Итак... чем занимаешься вечером?»~
@24738 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@24739 = ~Использовать на трупе свою способность «История костей».~
@24740 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@24741 = ~«Тогда прощай». ~
@24742 = ~«Тогда прощай». ~
@24743 = ~«Тогда прощай». ~
@24744 = ~«Было приятно с тобой поболтать. Прощай».~
@24745 = ~Оставить труп в покое.~
@24746 = ~«Было приятно с тобой поболтать. Прощай».~
@24747 = ~Оставить труп в покое.~
@24748 = ~«Было приятно с тобой поболтать. Прощай».~
