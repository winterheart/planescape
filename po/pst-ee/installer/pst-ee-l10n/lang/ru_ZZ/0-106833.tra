@7873 = ~Уйти.~
@7874 = ~Уйти.~
@7875 = ~«Кто умер?»~
@7876 = ~«Кого именно вы оплакиваете?»~
@7877 = ~«Кого именно вы оплакиваете?»~
@7878 = ~«Кого именно вы оплакиваете?»~
