@34975 = ~От этого оживленного трупа несет обугленным мясом и горелой одеждой. По правому боку тянутся довольно свежие следы от ожогов. Возможно, он был слишком близко к огню, и начал тлеть. На его лбу выгравирован номер «199»; его губы сшиты.~
@34976 = ~«Итак... что тут у нас интересного?»~
@34977 = ~Труп продолжает пялиться на тебя.~
@34978 = ~Оставить зомби в покое.~
@34979 = ~«Итак... что тут у нас интересного?»~
@34980 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@34981 = ~Использовать на трупе свою способность «История костей».~
@34982 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@34983 = ~Оставить зомби в покое.~
@34984 = ~«Было приятно с тобой поболтать. Прощай».~
@34985 = ~Оставить зомби в покое.~
@34986 = ~Труп женщины перестает ковылять, как только ты подходишь. Ты замечаешь номер «114», вырезанный у нее на лбу. Ее рот зашит, однако нитки начинают рваться и из ее губ слышится слабый стон.~
@34987 = ~«Итак... чем занимаешься вечером?»~
@34988 = ~Труп продолжает пялиться на тебя.~
@34989 = ~«Тогда прощай». ~
@34990 = ~«Пссст. Видел, как она посмотрела на меня? А? Ты видел это? Как она огибала взглядом кривую моей затылочной кости?»~
@34991 = ~«О чем это ты *толкуешь*?»~
@34992 = ~«Чт... да ты что, ОСЛЕП?! Она меня изучала! Она бесстыдно меня ХОТЕЛА!»~
@34993 = ~«Скорее хотела, чтобы ты *исчез*. Да она была слишком занята МНОЙ, чтобы отвлекаться на какую-то болтающуюся голову с большим ртом».~
@34994 = ~«Тобой? Ага, конечно! Уж поверь мне, крошкам из могил нет дела до 'мускулатуры', 'у меня великолепное тело' и 'я весь в шрамах и круто выгляжу'. Им нужны парни с ДУШОЙ. Типа меня, шеф. А трупов вроде ТЕБЯ повсюду навалом, как грязи».~
@34995 = ~«Как знаешь, Морт. Идем».~
@34996 = ~«По-моему, у тебя слишком богатое воображение. Она зомби. Труп. Мертвая. Скорее всего, она тебя даже не заметила».~
@34997 = ~«Да-да-да, как пожелаешь. Если бы ты был настолько долго мертв, как я, ты бы улавливал сигналы. Для тебя они, наверно, слишком ТОНКИЕ, чтобы их уловить, но именно поэтому я буду проводить ночи напролет с сочной свежеумершей крошкой, а ты будешь бегать вокруг с воплями 'А?' 'Чего здесь творится?' 'Куда пропала моя па-па-память?'»~
@34998 = ~«Как знаешь, Морт. Идем».~
@34999 = ~«По-моему, тебе стоит время от времени отключать свое воображение».~
@35000 = ~«Как знаешь, Морт. Идем».~
@35001 = ~«Ты имеешь в виду этот бессмысленный пустой могильный взгляд?»~
@35002 = ~«Тогда прощай». ~
