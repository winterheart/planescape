@41787 = ~«Забудь об этом. Прощай».~
@41788 = ~«Еще я слышал, что вы с Кесай-Серри — сводные сестры».~
@41789 = ~«Пожалуй, нет. У меня еще один вопрос...»~
@41790 = ~«Забудь об этом. Прощай».~
@41791 = ~«Я надеялся, что ты можешь помочь мне выяснить, *точно* ли Кесай является дочерью Равель».~
@41792 = ~«Не волнуйся об этом. У меня еще один вопрос».~
@41793 = ~«Забудь об этом. Прощай».~
@41794 = ~«Камбион?»~
@41795 = ~«Спасибо. У меня еще один вопрос...»~
@41796 = ~«Тогда я пойду и поговорю с ней. Спасибо, Кимаскси, и прощай».~
@41797 = ~«Я спросил, что это...»~
@41798 = ~«Нет... но у меня еще один вопрос».~
@41799 = ~«Нет. Прощай».~
@41800 = ~«Это уж лучше, чем полу-*ты*, Кимаскси».~
@41801 = ~«У меня еще один вопрос...»~
@41802 = ~«Прощай, Кимаскси».~
@41803 = ~«Достаточно, Кимаскси. У меня еще один вопрос...»~
@41804 = ~«У меня нет времени на это. Прощай».~
@41805 = ~«Марисса? Ты уверена?»~
@41806 = ~«Марисса... мы с ней еще не встречались. Ты уверена в этом?»~
@41807 = ~«Хмм. У меня еще один вопрос...»~
@41808 = ~«Тогда неважно. Прощай».~
@41809 = ~Стать на четвереньки и проверить.~
@41810 = ~«Хмм. У меня еще один вопрос...»~
@41811 = ~«Тогда неважно. Прощай».~
@41812 = ~«В таком случае, к меня еще один вопрос...»~
@41813 = ~«Это все, что я хотел узнать. Прощай».~
@41814 = ~«У меня еще один вопрос...»~
@41815 = ~«Тогда смею предположить, что тебя зовут Кимаскси, как написано на ошейнике. Счастливо».~
@41816 = ~«У меня еще один вопрос...»~
@41817 = ~«Тогда неважно. Прощай».~
@41818 = ~«Понятно... У меня еще один вопрос...»~
@41819 = ~«Хорошо... А теперь мне нужно идти. Счастливо».~
@41820 = ~«Зачем кому-то *вообще* нюхать твои штаны?»~
@41821 = ~~
@41822 = ~«Хмм. У меня еще один вопрос...»~
@41823 = ~«Это все, что я хотел узнать. Прощай».~
@41824 = ~«Нет, просто у меня есть несколько вопросов...»~
@41825 = ~«Вообще-то, я просто проходил мимо. Прощай».~
@41826 = ~«У меня есть несколько вопросов...» ~
@41827 = ~«Я просто проходил мимо, Кимаскси. Прощай».~
@41828 = ~«У меня еще один вопрос...»~
@41829 = ~«Это все, что я хотел узнать. Прощай».~
@41830 = ~«Послушай, шеф. Очевидно, ты еще не отошел от свидания со смертью, поэтому у меня два небольших совета для тебя. Во-первых, если у тебя возникают вопросы, *спроси* меня, хорошо?»

^NПРИМЕЧАНИЕ: <SPEAKTO>^-~
@41831 = ~«Хорошо... если у меня возникнут вопросы, я спрошу у тебя».~
@41832 = ~«Во-вторых, если ты хоть *наполовину* забывчив от того, каким кажешься, то начни записывать свои мысли: как только ты встретишь то, что *может* быть важным, запиши это, чтобы не забыть».~
@41833 = ~«Если бы у меня был бы дневник, который *должен* был быть рядом со мной, я бы так и поступил».~
@41834 = ~«Тогда заведи себе новый, шеф. Без проблем. Вокруг для тебя полным-полно пергамента и чернил».~
@41835 = ~«Хм-м. Ну хорошо. Хуже от этого не будет... Заведу себе новый».~
@41836 = ~«Записывай в него каждый свой шаг. Если начнешь забывать важные вещи... например, кто ты... или, что еще важнее, кто *я*... то воспользуйся им, чтобы освежить свою память».

^NПРИМЕЧАНИЕ: Чтобы получить доступ к дневнику, выберите кнопку дневника из быстрого меню. Ваш дневник будет автоматически обновляться в течение всей игры.^-~
@41837 = ~«Ладно... Уяснил. Идем».~
@41838 = ~«Что тебя гложет, шеф?»~ [MRT515]
@41839 = ~Число смертей:~
@41840 = ~«Можешь еще раз прочитать, что у меня вытатуировано на спине?»~
@41841 = ~«Еще раз, что это за место?»~
@41842 = ~«Это место такое огромное... Кто за ним присматривает?»~
@41843 = ~«Еще раз, кто эти смотрители?»~
@41844 = ~«Эти трупы... откуда они все берутся?»~
@41845 = ~«До этого ты говорил, чтобы я не убивал *женские* трупы. Почему?»~
@41846 = ~«Как мне использовать эти бинты?»~
@41847 = ~«Пока ничего, Морт. Просто проверяю, что ты еще со мной».~
@41848 = ~«Пока ничего, Морт. Просто проверяю, что ты еще со мной».~
@41849 = ~«Эй, шеф, *да ладно* тебе. Только не говори, что ты опять все забыл».~
@41850 = ~«Мне просто нужно освежить свою память».~
@41851 = ~«Ладно, неважно. У меня есть другие вопросы...»~
@41852 = ~«Ладно, забудь. Идем».~
@41853 = ~«Ладно, забудь. Идем».~
@41854 = ~«Готов поспорить, что услышу ЭТО много раз, — Морт прочищает горло. — Посмотрим...»

'Я знаю, что ты чувствуешь себя так, как будто ты выпил несколько бочонков помоев из Стикса, но тебе надо СОСРЕДОТОЧИТЬСЯ. Среди твоих вещей есть ДНЕВНИК, который прольет свет на это темное дело. ФАРОД сможет дополнить оставшуюся часть истории, если его уже не записали в книгу мертвых'.~
@41855 = ~«Фарод... хм-м. Продолжай».~
@41856 = ~«Неважно. У меня есть другие вопросы...»~
@41857 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41858 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41859 = ~«Сейчас, сейчас, погоди, — Морт на миг умолкает. — Хорошо, вот последний кусок...»

'Не потеряй дневник, иначе мы вновь окажемся в Стиксе. И что бы ты ни делал, НЕ ГОВОРИ никому, КТО ты и ЧТО с тобой произошло, иначе тебя живо отправят в крематорий. Делай так, как я сказал: ПРОЧТИ дневник, а затем НАЙДИ Фарода'.~
@41860 = ~«Когда я очнулся, рядом со мной не было дневника?»~
@41861 = ~«Тогда ладно. У меня есть другие вопросы...»~
@41862 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41863 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41864 = ~«Нет... ты был обобран догола. Как я уже говорил, похоже, что достаточно того дневника, что написан у тебя на теле».~
@41865 = ~«Ты уверен, что не знаешь никого по имени Фарод?»~
@41866 = ~«И то правда. У меня есть другие вопросы...»~
@41867 = ~«Ладно. Идем».~
@41868 = ~«Ладно. Идем».~
@41869 = ~«Неа. В общем, какой-нибудь пень да знает, как добраться до него. Надо поспрашивать в округе... ПОСЛЕ того, как мы выберемся отсюда».~
@41870 = ~«Перед тем как мы пойдем, у меня есть еще вопросы...»~
@41871 = ~«Ладно. Идем».~
@41872 = ~«Ладно. Идем».~
@41873 = ~«Оно называется 'Моргом'... это такое большое черное здание с чарующей архитектурой беременной паучихи».~
@41874 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41875 = ~«Это все, что я хотел узнать. Спасибо».~
@41876 = ~«Это все, что я хотел узнать. Спасибо».~
@41877 = ~«Они зовут себя 'тленными'. Ты их не пропустишь: они питают особую тягу к черному цвету и окоченевшему выражению лица. Они — всего лишь кучка свихнувшихся упырей, поклоняющихся смерти. Они верят в то, что все должны умереть... и лучше раньше, чем позже».~
@41878 = ~«Я запутался... какое тленным дело, если я сбегу?»~
@41879 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41880 = ~«Понятно. Тогда я буду осторожен».~
@41881 = ~«Понятно. Тогда я буду осторожен».~
@41882 = ~«Ты что, вообще ничего не слушал?! Я сказал, что трухлявые верят в то, что ВСЕ должны умереть, и лучше раньше, чем позже. Думаешь, что трупы, которых ты видел, счастливее в книге мертвых, чем вне ее?»~
@41883 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41884 = ~«Ладно... Я... попробую это запомнить».~
@41885 = ~«Ладно... Я... попробую это запомнить».~
@41886 = ~«Нууу... просто *используй* их. Останавливает кровотечение и все такое».

^NПРИМЕЧАНИЕ: <BANDAGES2>^-~
@41887 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41888 = ~«Спасибо. Думаю, я смогу с ними справиться».~
@41889 = ~«Спасибо. Думаю, я смогу с ними справиться».~
@41890 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — все, что осталось от тех бедолаг, кто продал свои тела смотрителям».~
@41891 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41892 = ~«Ладно... Я... попробую это запомнить».~
@41893 = ~«Ладно... Я... попробую это запомнить».~
@41894 = ~«Чт... ты *серьезно*? Послушай, шеф, у этих мертвых крошек есть последняя возможность познакомиться с такими крутыми громилами как мы. Нам следует быть более *деликатными*... не ломать их ради ключей, не отрывать им конечности, ничего такого».~
@41895 = ~«Последняя возможность? Погоди... о *чем* это ты толкуешь?»~
@41896 = ~«Неважно. У меня к тебе еще вопросы...»~
@41897 = ~«Ладно... Я... попробую это запомнить».~
@41898 = ~«Шеф, ОНИ мертвы, МЫ тоже мертвы... улавливаешь, куда я клоню? А? А?»~
@41899 = ~«Нет... не очень, если честно».~
@41900 = ~«Ты это *несерьезно*».~
@41901 = ~«Неважно. У меня к тебе еще вопросы...»~
@41902 = ~«Я достаточно наслушался. Идем».~
@41903 = ~«Шеф, для нас до этих ковыляющих цыпочек — открытая дорога. Мы *все* по крайней мере один раз умирали: у нас есть общая тема для разговоров. Они предрасположены к мужчинам с нашим опытом смерти».~
@41904 = ~«Постой... разве ты не говорил до этого, что я *не мертвый*?»~
@41905 = ~«Неважно. У меня к тебе еще вопросы...»~
@41906 = ~«Я достаточно наслушался. Идем».~
@41907 = ~«Ну... хорошо, *ты*, может быть, и не мертвый, а вот *я* — да. И как я уже говорил, я не против разделить гроб с какой-нибудь из здешних красивеньких жилистых покойниц». Морт начинает в предвкушении щелкать зубами. «Конечно же, у здешних смотрителей есть приоритет, так что им это навряд ли понравится...»~
@41908 = ~«У меня есть другие вопросы к тебе, Морт...»~
@41909 = ~«Я достаточно наслушался. Идем».~
@41910 = ~«Силы небесные. Это одна из этих ЧЕРТОВЫХ книг».~
@41911 = ~«Что такое?»~
@41912 = ~Сделай меня ВОРОМ, Тестокль.~
@41913 = ~«Если я прав, то это та книга, куда они записывают имена всех несчастных бедолаг, которым не повезло оказаться здесь».~
@41914 = ~«А мое имя может быть там?»~
@41915 = ~«Э... ну... *Возможно*. Чтобы определить это, нужно потрясти черепушкой вон с тем парящим трухлявиком. Вот только я не уверен, что это хорошая идея».~
@41916 = ~«Мне нужны ответы. Я поговорю с ним».~
@41917 = ~Оставить его в покое.~
@41918 = ~Человек отвешивает подчеркнуто-показушный поклон, и дает карточку, в которой можно разобрать лишь «Джамбл Смыслогуб — эКстраордный Колдун и хаоситеК». Затем он выхватывает карточку у тебя из рук и начинает есть ее, не переставая дико улыбаться.~
@41919 = ~Морт шепчет: «В каком-то дурдоме недостает постояльца».~
@41920 = ~«Джамбл, у меня несколько вопросов...»~
@41921 = ~«Ты тот, кто проклял Вонючку, не так ли?»~
@41922 = ~«А теперь я ухожу, Джамбл. Прощай».~
@41923 = ~«Ого... шеф, похоже, что в тебя только что бросили проклятье...»~
@41924 = ~«Что ты со мной сделал Джамбл?»~
@41925 = ~«Джамбл... пожалуйста, убери это, что бы ты там не натворил».~
@41926 = ~«Что бы ты там не сделал, Джамбл, убери это... или ты об этом горько пожалеешь».~
@41927 = ~«Пошли уже, Морт».~
@41928 = ~«Джамбл, у меня несколько вопросов...»~
@41929 = ~«Ты тот, кто проклял Вонючку, не так ли?»~
@41930 = ~«А теперь я ухожу, Джамбл. Прощай».~
@41931 = ~Джамбл зевает и смотрит в сторону, барабаня по пузу ладонями.~
@41932 = ~«Джамбл? Как на счет моих вопросов?»~
@41933 = ~«Неважно... Прощай».~
@41934 = ~Джамбл закатывает глаза. Он поворачивается к тебе, глупо ухмыляясь, затем показывает оскорбительный жест.~
@41935 = ~«Ответь хотя бы на вопрос: это ты проклял Вонючку?»~
@41936 = ~«Ты немой? Поэтому ты мне не отвечаешь?»~
@41937 = ~Правда: «Мне нужны ответы, и, если нужно, я их из тебя выбью».~
@41938 = ~Блеф: «Мне нужны ответы, и, если нужно, я их из тебя выбью».~
@41939 = ~Уйти.~
@41940 = ~Джамбл поднимает голову и дарит тебе идиотскую улыбку. Он медленно пожимает плечами... затем закрывает глаза и показывает тебе язык.~
@41941 = ~Правда: «Мне нужны ответы, и, если нужно, я их из тебя выбью».~
@41942 = ~Блеф: «Мне нужны ответы, и, если нужно, я их из тебя выбью».~
@41943 = ~Уйти.~
@41944 = ~Джамбл поднимает бровь и отступает на шаг. Внезапно он раскрывает рот и изрыгает поток невразумительного бормотания (хотя его губы и глотка при этом не двигаются).~
@41945 = ~«Что за?..»~
@41946 = ~Джамбл закрывает рот, и бормотание прекращается... прищурив глаза, он рассматривает тебя; его пухлое лицо озаряет самодовольная улыбка. И вдруг ты икаешь.

Снова икаешь. Еще раз. И еще.

Джамбл Смыслогуб попросту отворачивается и знаком показывает тебе уходить.~
@41947 = ~«Что ты со мной сделал?»~
@41948 = ~«Джамбл... пожалуйста, убери это, что бы ты там не натворил».~
@41949 = ~«Что бы ты там не сделал, убери это... или ты об этом горько пожалеешь».~
@41950 = ~«Лучше мне найти кого-то, кто бы помог мне избавиться от этого проклятья. Прощай».~
@41951 = ~Джамбл не обращает на тебя никакого внимания.~
@41952 = ~Атаковать его.~
@41953 = ~«Лучше мне найти кого-то, кто бы помог мне избавиться от этого проклятья. Прощай».~
@41954 = ~Джамбл делает невинное лицо и пожимает плечами, как бы говоря «Я не знаю». Он прикрывает рот рукой и хихикает, словно беззаботная школьница.~
@41955 = ~«Я хотел бы, чтобы ты снял с него проклятье».~
@41956 = ~«У меня есть другие вопросы...»~
@41957 = ~«Это все, что я хотел узнать. Прощай».~
@41958 = ~Джамбл притворяется, будто не слышит тебя: он громко рыгает и продолжает барабанить себя по пузу. Его глаза блуждают по Фестхоллу.~
@41959 = ~«Я могу хоть что-нибудь сделать, чтобы ты снял проклятие с Вонючки?»~
@41960 = ~Правда: «Сними с него проклятье, Джамбл, пока мне не пришлось причинить тебе боль».~
@41961 = ~Блеф: «Сними с него проклятье, Джамбл, пока мне не пришлось причинить тебе боль».~
@41962 = ~Уйти.~
@41963 = ~Джамбл мотает головой, не смотря на тебя.~
@41964 = ~Правда: «Сними с Вонючки проклятье, Джамбл, пока мне не пришлось причинить тебе боль».~
@41965 = ~Блеф: «Сними с Вонючки проклятье, Джамбл, пока мне не пришлось причинить тебе боль».~
@41966 = ~Уйти.~
@41967 = ~Джамбл Смыслогуб отвешивает тебе свой фирменный, подчеркнуто-показушный поклон, затем поднимает голову и с интересом глядит на тебя.~
@41968 = ~«Джамбл, у меня несколько вопросов...»~
@41969 = ~«Ты тот, кто проклял Вонючку, не так ли?»~
@41970 = ~«Я просто проходил мимо. Прощай».~
@41971 = ~Заметив тебя, Джамбл хмурится, показывает тебе кукиш и жестом гонит прочь.~
@41972 = ~Наслать на него проклятье, которому тебя обучил Салабеш.~
@41973 = ~«Джамбл, мне нужно, чтобы ты снял с меня проклятье, которое ты наложил».~
@41974 = ~«У меня есть несколько вопросов...» ~
@41975 = ~Уйти.~
@41976 = ~Он закатывает глаза и подчеркнуто зевает.~
@41977 = ~Наслать на него проклятье, которому тебя обучил Салабеш.~
@41978 = ~Правда: «Снимай проклятье, Джамбл, пока мне не пришлось причинить тебе боль».~
@41979 = ~Блеф: «Снимай проклятье, Джамбл, пока мне не пришлось причинить тебе боль».~
@41980 = ~Уйти.~
@41981 = ~Джамбл Смыслогуб подчеркнуто рассматривает и чистит свои ногти.~
@41982 = ~Наслать на него проклятье, которому тебя обучил Салабеш.~
@41983 = ~Атаковать его.~
@41984 = ~Уйти.~
@41985 = ~Когда ты произносишь загадочные слова проклятья Салабеша, Джамбл смотрит на тебя слегка скептически. После минуты неловкого молчания маг-хаоситек понимает, что ничего не случилось... и лицо его расплывается в злобной усмешке.~
@41986 = ~Продолжить...~
@41987 = ~Он раскрывает рот, чтобы ответить еще одним своим проклятьем... и вдруг осознает, что у него нет голоса! Проклятье Салабеша отняло у Джамбла дар речи, таким образом, лишив его способности проклинать других. Он в панике сжимает свое горло, чуть не плача.~
@41988 = ~«Похоже, теперь мы поменялись местами, Джамбл. Как ты думаешь, что будет, если кто-нибудь из тех, — *ик!* — кого ты когда-то проклял, узнает, что ты больше не можешь говорить... или проклинать?»~
@41989 = ~Джамбл падает на колени и смотрит на тебя умоляюще. Кажется, он готов разрыдаться.~
@41990 = ~«Ты — *ик!* — снимешь с меня проклятье, которое ты наложил? И поклянешься больше никогда не проклинать кого-либо, кто не желал тебе зла?»~
@41991 = ~Джамбл кладет руку на сердце и решительно кивает.~
@41992 = ~«Отлично. В таком случае, я сниму проклятье...»~
@41993 = ~Как только ты снимаешь с Джамбла проклятье Салабеша, он вздыхает с облегчением. Взамен он снимает с тебя свое проклятье, и твоя икота, наконец, проходит. Затем он смиренно кланяется и опускает свой взгляд на пол.~
@41994 = ~«Еще я бы хотел, чтобы ты снял проклятие с Вонючки».~
@41995 = ~«Прощай, Джамбл».~
@41996 = ~Надув губы, Джамбл кивает и взмахом руки снимает проклятье с Вонючки.~
@41997 = ~«Спасибо. Прощай, Джамбл».~
@41998 = ~Джамбл отдает тебе неловкий поклон и смущенно смотрит на тебя. Ясно, что больше он не желает иметь с тобой дело.~
@41999 = ~«Я хотел бы, чтобы ты снял с Вонючки свое старое проклятье».~
@42000 = ~«Джамбл, я просто проходил мимо. Прощай».~
@42001 = ~Оставить его в покое.~
@42002 = ~Мужчина выдает кривую усмешку и указывает на себя большим пальцем правой руки. «Пестиком зовут, я — *гах!* — алхимик». Он снова указывает на себя, на этот раз указательным пальцем левой руки. «Звать Килн. *Хгрк!* Чего-нибудь нужно?»~
@42003 = ~«С тобой все в порядке?»~
@42004 = ~«Чем ты торгуешь?»~
@42005 = ~«Да, у меня есть несколько вопросов...»~
@42006 = ~«Нет, ничего страшного. Прощай».~
@42007 = ~«*Угак*!» Его левая рука взмывает и бьет по прилавку, при этом волосы на его предплечье скручиваются. На прилавке нацарапаны ряды закорючек — список из нескольких товаров с ценам. Ты отмечаешь, что здесь, похоже, имеется в наличии некоторое количество смесей и амулетов.~
@42008 = ~«Я хотел бы кое-что купить...»~
@42009 = ~«С тобой все в порядке?»~
@42010 = ~«Вообще-то, у меня есть несколько вопросов...»~
@42011 = ~«По правде говоря, здесь нет ничего нужного мне. Прощай».~
@42012 = ~Половина его рта опускается вниз в недовольной гримасе; он качает головой. «Я целый день торчу на складе. *Га-а-а-к!*» Он резко вздрагивает: внезапно над его переносицей выскакивает третий глаз... левый глаз уходит в сторону, и новый глаз занимает его место. «Я разговариваю только по поводу своей — *фнак*! — лавки, сэр». После того как он это сказал, кожа его лица, казалось бы, «съедает» новый глаз, и левый глаз возвращается на старое место.~
@42013 = ~«С тобой все в порядке?»~
@42014 = ~«Старый инженер в Литейной сказал, что мне нужно достать образец своей крови и кожи, чтобы его машина заработала. Мне нужно, чтобы ты мне в этом помог».~
@42015 = ~«Тогда прощай». ~
@42016 = ~«Да. *Хгак*!» Несколько секунд его горло сотрясается в конвульсиях, потом оно успокаивается. Неожиданно на его шее вылазит огромный гнойник, светящийся зеленым. «Еще что-нибудь, сэр? *Гок*!» Его горло снова сжимается, и волна трепещущей плоти поглощает раздутый зеленый гнойник на шее. Некоторое время он сильно кашляет, потом, кажется, успокаивается. «Фух».~
@42017 = ~«Можно поинтересоваться, что с тобой случилось?»~
@42018 = ~«У меня есть несколько вопросов...» ~
@42019 = ~«Тогда прощай». ~
@42020 = ~Левый глаз раздраженно закатывается вверх. Правый глаз смотрит на тебя искоса. «Слишком много выпил».~
@42021 = ~«Слишком много *чего*?»~
@42022 = ~«У меня есть другие вопросы...»~
@42023 = ~«Это все, что я хотел узнать. Прощай».~
@42024 = ~«Зелий. Выпил слишком много зелий. *Фгаог*!» Его рот опускается вниз под подбородок; из его левой ноздри вырастает еще одна. «Больше, чем когда-либо, это уж точно! Это из-за зелья превращений, сваренного — *хгрк!* — в Лимбо».~
@42025 = ~«Я могу чем-нибудь помочь?»~
@42026 = ~«У меня есть другие вопросы...»~
@42027 = ~«Это все, что я хотел узнать. Прощай».~
@42028 = ~Глаза мужчины поворачиваются внутрь, чтобы посмотреть друг на друга, потом снова смотрят на тебя. «Не знаю. *Фнг*!» Он вздрагивает; рот под подбородком двигается вверх и накрывает недавно выросшую ноздрю. «Такие вещи случаются очень часто; похоже, мы не можем — *фнуг!* — не перепробовать свой ассортимент. Если ты найдешь, чем нам помочь, мы оба — *гукак*! — будем благодарны, сэр».~
@42029 = ~«У меня есть другие вопросы...»~
@42030 = ~«Если я найду способ, я дам тебе знать. Прощай».~
@42031 = ~Ты видишь Пестика Килна. Он — или они — выглядит, как и раньше, жутковато: его плоть непрестанно меняется и движется по его лицу и телу. «Еще раз добро — *снрф!* — пожаловать, сэр».~
@42032 = ~«У меня есть Эликсир ужасного разделения... думаешь, это тебе поможет?»~
@42033 = ~«С тобой все в порядке?»~
@42034 = ~«Я хотел бы кое-что купить...»~
@42035 = ~«У меня есть несколько вопросов...» ~
@42036 = ~«Я просто проходил мимо. Прощай».~
@42037 = ~Оба его глаза неожиданно впиваются в пузырек в твоих руках. Он кивает, облизывая губы.~
@42038 = ~«Тогда вот, держи...»~
@42039 = ~«Знаешь, мне бы не помешало вознаграждение».~
@42040 = ~Пестик Килн берет пузырек обеими руками и ставит его под прилавок. Его левый глаз фокусируется на тебе, в то время как его правый глаз и рука сосредотачиваются на яростном исписывании прилавка. «Мы можем использовать это для приготовления кое-чего, что может — *хгрк*! — вмиг нас исправить. А теперь дай нам минутку, чтобы мы разобрались — *гак*! — с этим делом, а в награду мы сделаем тебе немного лечебных снадобий». Он оборачивается, чтобы пройти в заднюю часть лавки...~
@42041 = ~~
@42042 = ~«Ладно... Тогда на том и распрощаемся».~
@42043 = ~Левый глаз поворачивается назад, а правый остается сфокусированным на тебе. Он кивает. «Будет ли достаточно нескольких — *фнг!* — лечебных товаров, сэр?»~
@42044 = ~«Да, держи».~
@42045 = ~«Нет... Пока что я оставлю это при себе. Прощай».~
@42046 = ~«Соскоб? *Шник*! Хорошо». Его правая рука берет лезвие бритвы, левая — пузырек с широким горлышком. Он соскабливает с твоей руки небольшой кусочек кожи, кладет его в пузырек вместе с небольшим количеством твоей крови. Потом он кладет на твою рану кусочек марли и дает тебе пузырек. «Еще что-нибудь -*гу-гак*! — нужно, сэр?»~
@42047 = ~«Нет, но... с тобой все в порядке?»~
@42048 = ~«Да... я хотел бы кое-что купить».~
@42049 = ~«Нет, это все. Спасибо и прощай».~
@42050 = ~Этот человек очень напоминает Пестика Килна, только без двигающейся кожи и постоянных мелких мутаций. «Еще раз здравствуй, добро пожаловать. Чем я, Пестик, могу помочь тебе?»~
@42051 = ~«Я надеялся получить немного лечебных смесей...»~
@42052 = ~«У меня есть несколько вопросов...» ~
@42053 = ~«Я хотел бы кое-что купить...»~
@42054 = ~«Вообще-то, я просто проходил мимо. Прощай, Пестик».~
@42055 = ~«Да, конечно. Твое вознаграждение, да? Так, посмотрим... Я, конечно же, сделаю их для тебя бесплатно... но мне нужны соответствующие ингредиенты. Хм-м-м... сердце они, или гематитовый порошок, или волос дэва, или нитка из одежды аасимона, или кровь самовосстанавливающегося существа, такого как тролль, или...»~
@42056 = ~«Вообще-то, мои раны заживают *очень* быстро».~
@42057 = ~Пестик поднимает бровь. «Вот как? Ну, тогда твоя кровь вполне подойдет. Вот... дай мне немного, если ты не против».~
@42058 = ~Дать ему немного своей крови.~
@42059 = ~Взяв небольшое количество твоей крови, Пестик удаляется в заднюю часть лавки и возвращается с несколькими предметами, похожими на свернувшиеся капли крови. «Если положить этот амулет из запекшейся крови на язык, он залечивает имеющиеся раны и некоторое время помогает уберечься от новых».~
@42060 = ~«Спасибо, Пестик. У меня есть другие вопросы...»~
@42061 = ~«Благодарю. Теперь я хотел бы кое-что купить...»~
@42062 = ~«Прощай, Пестик, и спасибо».~
@42063 = ~«Мои глубочайшие извинения, сэр, но я разговариваю только по поводу моей лавки. Кроме того, я редко выхожу наружу, понимаешь? Тебе лучше поискать кого-нибудь другого для ответов на твои вопросы».~
@42064 = ~«Старый инженер в Литейной сказал, что мне нужно достать образец своей крови и кожи, чтобы его машина заработала. Мне нужно, чтобы ты мне в этом помог».~
@42065 = ~«Тогда я хотел бы кое-что купить...»~
@42066 = ~«В таком случае, прощай».~
@42067 = ~«Соскоб? Хорошо». Пестик достает лезвие бритвы и пузырек с широким горлышком. Затем он соскабливает с твоей руки небольшой кусочек кожи и кладет его в пузырек вместе с небольшим количеством твоей крови. Потом он кладет на твою рану кусочек марли и дает тебе пузырек. «Еще что-нибудь нужно, сэр?»~
@42068 = ~«Да... я хотел бы кое-что купить».~
@42069 = ~«Нет, это все. Спасибо и прощай».~
@42070 = ~Ты видишь Пестика, алхимика. «Еще раз здравствуй, добро пожаловать. Чем могу я тебе помочь?»~
@42071 = ~«Я надеялся получить немного лечебных смесей...»~
@42072 = ~«У меня есть несколько вопросов...» ~
@42073 = ~«Я хотел бы кое-что купить...»~
@42074 = ~«Вообще-то, я просто проходил мимо. Прощай, Пестик».~
@42075 = ~Лицо этого человека очень напоминает лицо Пестика Килна, только без двигающейся кожи и постоянных мелких мутаций. «Еще раз здрасте... зовут Килн. Чего-нибудь нужно?»~
@42076 = ~«Я надеялся получить немного лечебных смесей».~
@42077 = ~«У меня есть несколько вопросов...» ~
@42078 = ~«Я хотел кое-что купить...»~
@42079 = ~«Я, собственно, просто проходил мимо. Прощай, Килн».~
@42080 = ~Ты видишь Килна, помощника алхимика. «Еще раз здрасте... чего-нибудь нужно?»~
@42081 = ~«Я надеялся получить немного лечебных смесей».~
@42082 = ~«У меня есть несколько вопросов...» ~
@42083 = ~«Я хотел кое-что купить...»~
@42084 = ~«Я, собственно, просто проходил мимо. Прощай, Килн».~
@42085 = ~«Ты еще с Пестиком не говорил? Он этими делами заведует».~
@42086 = ~«Тогда я пойду, поговорю с ним. Прощай».~
@42087 = ~«Я целый день торчу на складе... Я не подхожу для ответов на твои вопросы».~
@42088 = ~«Старый инженер в Литейной сказал, что мне нужно достать образец своей крови и кожи, чтобы его машина заработала. Мне нужно, чтобы ты мне в этом помог».~
@42089 = ~«Тогда можно здесь что-нибудь купить?»~
@42090 = ~«В таком случае, прощай».~
@42091 = ~«Тебе нужно поговорит с Пестиком, это уж точно. Он этими делами заведует».~
@42092 = ~«Тогда я пойду, поговорю с ним. Прощай».~
@42093 = ~«Думаю, она слепа по собственному желанию, а не по воле случая».~
@42094 = ~«Тогда я, пожалуй, осмотрюсь вокруг. Прощай».~
@42095 = ~«Конечно. Пожалуйста, спрашивайте».~
@42096 = ~«У меня вопрос насчет одного из экспонатов...»~
@42097 = ~«Ты можешь видеть, Ивана?»~
@42098 = ~«Ты можешь видеть, Ивана?»~
@42099 = ~«Ты знаешь, что это за маленькая игрушка, похожая на куб?»~
@42100 = ~«Ты кажешься мне знакомой... Ты не знаешь никого по имени Ив?»~
@42101 = ~«Ты уже поговорила с дочерью, Ивана?»~
@42102 = ~«Что это за место?»~
@42103 = ~«Что тут есть интересного?»~
@42104 = ~«Где здесь можно найти работу?»~
@42105 = ~«У меня вопросы об одном месте...»~
@42106 = ~«Мне просто нужно сориентироваться...»~
@42107 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@42108 = ~«Вообще-то, неважно. Прощай».~
@42109 = ~«Боюсь, что я не отхожу далеко от галереи и не могу помочь вам в этом деле. Вы могли бы попробовать спросить кого-нибудь еще».~
@42110 = ~«У меня есть другие вопросы...»~
@42111 = ~«Тогда прощай». ~
@42112 = ~«Это моя дочь, — на миг в молочной белизне ее глаз появляется намек на грусть. — Мы больше не разговариваем друг с другом».~
@42113 = ~«Почему?»~
@42114 = ~«У меня есть другие вопросы...»~
@42115 = ~«Это все, что я хотел узнать. Прощай».~
@42116 = ~«Нам нечего друг другу сказать. Она ушла в погоне за историями... и все по неведомой мне причине».~
@42117 = ~«Она рассказала мне историю, которая может быть ответом на этот вопрос...»~
@42118 = ~«У меня есть другие вопросы...»~
@42119 = ~«Это все, что я хотел узнать. Прощай».~
@42120 = ~Ивана поднимает брови. «О? Расскажите, будьте так любезны? Я буду очень благодарна, сэр...»~
@42121 = ~Рассказать ей историю Охотницы-за-рассказами, про ее бесконечные поиски истории, содержащей истину, которую она ищет.~
@42122 = ~«Может, в другой раз. У меня есть другой вопрос...»~
@42123 = ~«В другой раз. Прощай».~
@42124 = ~Ивана медленно кивает. «Я... понятия не имела. Я обязательно с ней увижусь. Спасибо вам, сэр, за то, что принесли мне новости о моей дочери». Когда она произносит это, ее бледные зрачки медленно наполняются цветом, пока, наконец, не становятся ярко-зелеными.~
@42125 = ~«Твои глаза... теперь ты можешь видеть, Ивана?»~
@42126 = ~«У меня есть другие вопросы...»~
@42127 = ~«Это все, что я хотел узнать. Прощай».~
@42128 = ~Она кивает, улыбаясь.~
@42129 = ~«У меня есть другие вопросы...»~
@42130 = ~«Это все, что я хотел узнать. Прощай».~
@42131 = ~«Одну минуту, сэр... ваш голос; в нем слышна тяжесть времени и ран. Будьте так любезны, позвольте мне прикоснуться к вашему лицу?»~
@42132 = ~«Да, пожалуйста».~
@42133 = ~«Нет. Лучше не надо».~
@42134 = ~«Постойте...»~
@42135 = ~Ивана кивает. «Отлично. Больше я не буду просить вас об этом».~
@42136 = ~«У меня есть несколько вопросов...» ~
@42137 = ~«Я уже должен идти. Прощай».~
@42138 = ~Ивана улыбается, нежно пробегая своими старыми руками по твоему лицу. Она нахмуривается, слегка озадаченная. «Так много шрамов... и старых, и новых. Похоже... — она касается твоего горла, краснеет и одергивает руку. — Простите меня, сэр. Мне было интересно, как далеко они простираются».~
@42139 = ~«Ничего страшного. Они везде: все мое тело в шрамах».~
@42140 = ~«Просто больше так не делай, старуха».~
@42141 = ~Ивана кивает.~
@42142 = ~«У меня есть несколько вопросов...» ~
@42143 = ~«Я уже должен идти. Прощай».~
@42144 = ~«Я не вижу только потому, что не хочу видеть. Со временем я позволю своему зрению вернуться, чтобы снова взглянуть на экспонаты своей галереи новым, свежим взглядом».~
@42145 = ~«У меня есть другие вопросы...»~
@42146 = ~«Это все, что я хотел узнать. Прощай».~
@42147 = ~Ивана кивает, улыбаясь. «Ваша подруга совершенно права, сэр...»~
@42148 = ~«Да, мы снова разговариваем друг с другом... и я должна поблагодарить вас за это. Я рада, что снова могу говорить с дочерью». Ивана улыбается тебе.~
@42149 = ~«У меня есть другие вопросы...»~
@42150 = ~«Это все, что я хотел узнать. Прощай».~
@42151 = ~«Ну, это моя галерея планов, — она улыбается и показывает вокруг себя. — Экспонаты привезены отовсюду. Некоторые из них я продаю, некоторые — храню. И демонстрирую каждый из них, в то или иное время. Пожалуйста, полюбуйтесь ими...  и если у вас возникнут вопросы относительно экспонатов, задавайте их не колеблясь».~
@42152 = ~«У меня есть другие вопросы...»~
@42153 = ~«Это все, что я хотел узнать. Прощай».~
@42154 = ~«Она ночная ведьма, одна из старейших серых сестер Пустоши, которые пришли в Сигил много веков назад для совершения загадочных опытов. Считается, что эти опыты перечили воле Леди, и что таким образом Равель была изгнана из Сигила и навеки заключена в один из лабиринтов Леди, где ее тело покоится по сей день...»~
@42155 = ~«Продолжай...»~
@42156 = ~«Погоди... У меня есть другие вопросы...»~
@42157 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@42158 = ~«Говорят, Равель была лучшей по части загадок и головоломок, но считается, что лишь одна загадка, точнее, вопрос, изводил древнюю ночную ведьму: 'Что может изменить сущность человека?'»~
@42159 = ~«Продолжай...»~
@42160 = ~«Погоди... У меня есть другие вопросы...»~
@42161 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@42162 = ~«Она бросала вызов всем заинтересованным. Она обещала научить каждого пришедшего к ней своему ремеслу... только если они смогут удовлетворить ее ответом на этот вопрос. Если нет — они соглашаются стать ее закуской. Многие умирали, желая обучится у Равель, и считается, что до самых последних ее часов в Сигиле Равель так и не нашла ответа на свой вопрос».~
@42163 = ~«Продолжай...»~
@42164 = ~«Погоди... У меня есть другие вопросы...»~
@42165 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@42166 = ~«Считается, что преступлением Равель было намерение разбить Клетку, взломать Сигил по каким-то неизвестным причинам, — Ивана вздыхает. — Это все, что я о ней знаю».~
@42167 = ~«У меня есть другие вопросы...»~
@42168 = ~«Это все, что я хотел узнать. Прощай».~
@42169 = ~«О? И о каком же? Об одной из картин?»~
@42170 = ~«Аркадийские витражи».~
@42171 = ~«Боевой рог Ахерона».~
@42172 = ~«Темные птицы Окантуса».~
@42173 = ~«Рубиновая статуэтка».~
@42174 = ~«Живая цепь китона».~
@42175 = ~«Статуя кричащего человека».~
@42176 = ~«Да, одна из картин...»~
@42177 = ~«А вообще, позволь мне спросить кое о чем еще...»~
@42178 = ~«Вообще-то, неважно. Прощай».~
@42179 = ~«Какая, сэр?»~
@42180 = ~«Побережье Карасуфры».~
@42181 = ~«Мародеры Внешних земель».~
@42182 = ~«Хазазот, пожирающий Нгара».~
@42183 = ~«Поверхность Таласии».~
@42184 = ~«Библиотека».~
@42185 = ~«Глупость Удо».~
@42186 = ~«Долина под Клангеддином».~
@42187 = ~«Серая ведьма Ойноса».~
@42188 = ~«Исследование волнообразных движений #7».~
@42189 = ~«Минутный взгляд со стен Моччмы».~
@42190 = ~«А вообще, позволь мне спросить кое о чем еще...»~
@42191 = ~«Вообще-то, неважно. Прощай».~
@42192 = ~«Это витражное окно найдено висящим на третьем слое Аркадии тридцать два года назад. Оно предсказывало событие, которому суждено было случиться. Когда оно произошло, картинка поблекла и стала такой, какой вы ее сейчас видите. Считается, что окно накапливает свет и тьму Шара ночи и дня в Аркадии, а потом медленно испускает их, создавая непродолжительные, но постепенно гаснущие рассветы и закаты, однако лишь в самом стекле».~
@42193 = ~«Шар ночи и дня? Аркадия?»~
@42194 = ~«Позволь спросить по поводу другого экспоната...»~
@42195 = ~«У меня есть другие вопросы...»~
@42196 = ~«Это все, что я хотел узнать. Прощай».~
@42197 = ~«Аркадия — план мирного порядка, также известный как Земля идеального добра. Шар ночи и дня — это сфера на вершине высочайшего пика Аркадии; каждая его половина испускает либо свет, либо тьму. Вращения Шара дает Аркадии день и ночь».~
@42198 = ~«Позволь спросить по поводу другого экспоната...»~
@42199 = ~«У меня есть другие вопросы...»~
@42200 = ~«Это все, что я хотел узнать. Прощай».~
@42201 = ~«Ах, Очищающий рог... это рог из кованого свинца, металла, добытого прямо с куба Ахерона. Говорят, что в последний раз рог звучал, когда батальоны Шакала встретились с кланами Выбитого Глаза в битве на Спорных землях. Легенда гласит, что сила этого рога была использована под конец битвы, чтобы собрать вместе летающие кубы, которые добили разгромленный батальон Шакалов, прежде чем он смог сбежать».~
@42202 = ~«Кубы? Ахерон?»~
@42203 = ~«Позволь спросить по поводу другого экспоната...»~
@42204 = ~«У меня есть другие вопросы...»~
@42205 = ~«Это все, что я хотел узнать. Прощай».~
@42206 = ~«Ахерон — это план строго поддерживаемого порядка, где послушание важнее добра. Он состоит из гигантских металлических кубов, летающих в бесконечной пустоте... многие кубы столь велики, что на их гранях построены города и даже целые королевства».~
@42207 = ~«Позволь спросить по поводу другого экспоната...»~
@42208 = ~«У меня есть другие вопросы...»~
@42209 = ~«Это все, что я хотел узнать. Прощай».~
@42210 = ~«Все они отколоты от огромного волшебного пласта вечного черного льда, который покоится в темных недрах плана Окантус, — Ивана умолкает, постукивая пальцами по подбородку. — Говорят, что этим пластом льда заканчивается река Стикс, и что воспоминания всех, кто погрузился в уничтожающие память воды Стикса, все еще лежат замороженные в этом льду».~
@42211 = ~«Если воды Стикса уничтожают память, будет ли этот лед с Окантуса действовать так же?»~
@42212 = ~«Позволь спросить по поводу другого экспоната...»~
@42213 = ~«У меня есть другие вопросы...»~
@42214 = ~«Это все, что я хотел узнать. Прощай».~
@42215 = ~«Я могу лишь предположить, что да».~
@42216 = ~«Позволь спросить по поводу другого экспоната...»~
@42217 = ~«У меня есть другие вопросы...»~
@42218 = ~«Это все, что я хотел узнать. Прощай».~
@42219 = ~«Этот экспонат был найден в соборе, который находится на первом слое плодородных полей Элизиума — Беззаботной Амории, на границе с рекой Океанус. Название этой вещи неизвестно, но мастерство его исполнения считается одним из наиболее впечатляющих примеров обработки драгоценных камней на планах. Одно лишь то, как он собирает, преломляет и усиливает свет, проходящий через его грани, заставляет сердце замереть. Похоже, он раскрывает возможную идеологическую связь между наиболее злыми и наиболее светлыми существами в мультивселенной... просто восхитительно».~
@42220 = ~«Позволь спросить по поводу другого экспоната...»~
@42221 = ~«У меня есть другие вопросы...»~
@42222 = ~«Это все, что я хотел узнать. Прощай».~
@42223 = ~«Эта цепь из Звенящего Хайтера, города цепей, висящего на Минауросе, третьем слое плана Баатора. Тамошние цепи — лучшие в мультивселенной, однако обитатели Звенящего Хайтера злы и жестоки, и используют цепи в качестве живого оружия против всех гостей Звенящего Хайтера, нарушающих их законы».~
@42224 = ~«Китоны перемещаются по городу цепей, словно пауки по паутине, украшенные цепями, которыми туго обтянуты их тела. Китоны обладают силой, известной как 'дар цепей', которая позволяет им управлять цепями силой мысли. Считается, что цепь из моей галереи была оживлена во время битвы, в которой китон, управлявший ею, был убит проклятым молотом... и его жизненная сущность перешла в саму цепь».~
@42225 = ~«Позволь спросить по поводу другого экспоната...»~
@42226 = ~«У меня есть другие вопросы...»~
@42227 = ~«У меня есть другие вопросы...»~
@42228 = ~«Это все, что я хотел узнать. Прощай».~
@42229 = ~«Считается, что эта статуя — конечная судьба этерсерийского чародея Гангройгидона. Атакованный враждебным конклавом чародеев, находясь в пике ужасного безумия, он был лишен свободы заклинанием, которое обратило его плоть в камень. Говорят, будто Гангройгидон застыл с последним страшным проклятием на губах, столь ужасным, что ему *никогда* не следовало слетать с уст живого человека».~
@42230 = ~«Говорят, что ярость проклятия столь сильна, что срывает плоть с костей услышавшего его, и даже может раскалывать камни».~
@42231 = ~«Позволь спросить по поводу другого экспоната...»~
@42232 = ~«У меня есть другие вопросы...»~
@42233 = ~«Это все, что я хотел узнать. Прощай».~
@42234 = ~«Карасуфра — это слой Звериных земель, где царит вечная ночь. Он наполнен всевозможными видами животных, выслеживающих добычу в темноте. Художник, полюбивший Владычицу котов и последовавший за ней на ее родной план, отдал мне эти картины. Он так и не раскрыл мне секрет их создания».~
@42235 = ~«Позволь спросить по поводу другой картины...»~
@42236 = ~«У меня есть другие вопросы...»~
@42237 = ~«Это все, что я хотел узнать. Прощай».~
@42238 = ~«Примечательный экспонат, не правда ли? Художнику удался весьма интересный эффект с формой теней на скалах. Женщина, принесшая мне картину, сказала, что нашла ее в заброшенном лагере во Внешних землях... написавшего ее художника так и не нашли. Он, предположительно, был убит теми же мародерами, которые были запечатлены на картине».~
@42239 = ~«Позволь спросить по поводу другой картины...»~
@42240 = ~«У меня есть другие вопросы...»~
@42241 = ~«Это все, что я хотел узнать. Прощай».~
@42242 = ~«Эта картина была срисована с одной из стен камеры в Заставе, крупнейшем сигильском сумасшедшем доме. Все, что мог выговорить ее обитатель, — это 'Хазазот сожрал Нгара... Хазазот сожрал Нгара...'. Пожалуй, немножко жутковато, тем не менее, это отличное полотно».~
@42243 = ~«Позволь спросить по поводу другой картины...»~
@42244 = ~«У меня есть другие вопросы...»~
@42245 = ~«Это все, что я хотел узнать. Прощай».~
@42246 = ~«Таласия — это море, откуда берет начало и куда впадает река Океанус, огибающая почти весь план Элизиум. Картина написана одним из многочисленных островитян».~
@42247 = ~«Позволь спросить по поводу другой картины...»~
@42248 = ~«У меня есть другие вопросы...»~
@42249 = ~«Это все, что я хотел узнать. Прощай».~
@42250 = ~«Мне мало что известно об этом экспонате... однажды он был попросту оставлен у порога моей галереи, завернутый в черное сукно и подписанный 'Из Цитадели'. Один хорошо осведомленный посетитель высказал гипотезу, что это, должно быть, замок какого-то великого чародея, подвешенный в полуплане, который он сам и создал».~
@42251 = ~«Позволь спросить по поводу другой картины...»~
@42252 = ~«У меня есть другие вопросы...»~
@42253 = ~«Это все, что я хотел узнать. Прощай».~
@42254 = ~«Эта картина иллюстрирует одну из легенд Первичного мира Гоха. Удо был королем-чародеем, столь искусным и могущественным, что решил создать заклинание, которое должно было превратить его в силу, а людей его великого народа — в божественных слуг. Когда Удо сотворил это заклинание, в его дворец ударила молния, подожгла его и, прежде чем утих гром, город опустел... не осталось ничего живого. Пропало более семидесяти тысяч человек, бесследно, в мгновение ока. Никто не знает, что случилось с Удо и его народом».~
@42255 = ~«Позволь спросить по поводу другой картины...»~
@42256 = ~«У меня есть другие вопросы...»~
@42257 = ~«Это все, что я хотел узнать. Прощай».~
@42258 = ~«Эту картину продал мне Бульбог Камненос... на ней — пространство под горой Клангеддин на плане Аркадия, дом дварфских эйнхериев — духов Верхних планов, служащих в качестве хранителей или воинов».~
@42259 = ~«Позволь спросить по поводу другой картины...»~
@42260 = ~«У меня есть другие вопросы...»~
@42261 = ~«Это все, что я хотел узнать. Прощай».~
@42262 = ~«Говорят, будто это портрет Равель Заморочки, вероятно, самой злой ведьмы из когда-либо существовавших, которая устрашала Серую пустошь, и не только».~
@42263 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@42264 = ~«Позволь спросить по поводу другой картины...»~
@42265 = ~«У меня есть другие вопросы...»~
@42266 = ~«Это все, что я хотел узнать. Прощай».~
@42267 = ~«Этот экспонат продал мне юноша, имени которого я не знаю. У него было несколько таких картин, но у остальных уже были хозяева... если верить его словам. Мне бы так хотелось собрать полную коллекцию, но, увы — нередко кажется, что некоторым вещам не суждено сбыться».~
@42268 = ~«Позволь спросить по поводу другой картины...»~
@42269 = ~«У меня есть другие вопросы...»~
@42270 = ~«Это все, что я хотел узнать. Прощай».~
@42271 = ~«Моччма — это гитцерайская крепость, парящая на плане Лимбо. Минутный взгляд был написан исследовательницей хаоса Ди. В минуты, когда ее не одолевало безумие, она с идеальной четкостью помнила все увиденное».~
@42272 = ~«Позволь спросить по поводу другой картины...»~
@42273 = ~«У меня есть другие вопросы...»~
@42274 = ~«Это все, что я хотел узнать. Прощай».~
@42275 = ~Ивана улыбается и жестом предлагает подойти к ней. «И вновь приветствую. У вас есть вопросы относительно одного из экспонатов?»~
@42276 = ~«Нет, но имеются другие вопросы...»~
@42277 = ~«Да...»~
@42278 = ~«Пока нет. Прощай, Ивана».~
@42279 = ~Ивана берет предмет и проводит по нему пальцами. Она ощупывает его поверхность, затем возвращает тебе. «Это, несомненно, нечто большее, чем просто добротно сделанный игрушечный модрон. Быть может, это что-то вроде головоломки или портального ключа».~
@42280 = ~«Что за модрон?»~
@42281 = ~«У меня есть другие вопросы...»~
@42282 = ~«Это все, что я хотел узнать. Прощай».~
@42283 = ~«Модроны — раса законопослушных упорядоченных существ. У них много форм, каждая из которых занимает свой уровень в жесткой иерархии модронов. Мне кажется, что этот вид называется 'квадрон'».~
@42284 = ~«У меня есть другие вопросы...»~
@42285 = ~«Это все, что я хотел узнать. Прощай».~
@42286 = ~«Как пожелаешь. Теперь ты ВОР».~
@42287 = ~~
@42288 = ~«Шшш! Ни шшагу ближе, человек!»~
@42289 = ~«Ты портишшшь нашшу ловушшшку!»~
@42290 = ~«Было приятно с тобой поболтать. Прощай».~
@42291 = ~Оставить зомби в покое.~
@42292 = ~Оставить зомби в покое.~
@42293 = ~Похоже, у этого трупа нет ключа... да и вряд ли он смог бы им воспользоваться. Его пальцы перебиты, как будто кто-то постучал по ним молотком. Ты замечаешь, что его левое плечо сильно перевязано... бинтами можно воспользоваться, если снять их с трупа.~
@42294 = ~«Похоже, что нет... Ты случайно не знаешь, у кого из твоих приятелей есть ключ от этого места?»~
@42295 = ~«Похоже, что нет... Ты случайно не знаешь, у кого из твоих приятелей есть ключ от этого места?»~
@42296 = ~«Было приятно с тобой поболтать. Прощай».~
@42297 = ~Оставить зомби в покое.~
@42298 = ~«Э, шеф... они не слышат тебя, понятно? Они мертвы».~
@42299 = ~«Но ты ведь тоже мертв. И разговариваешь со мной».~
@42300 = ~«Ага, но *я* особенный. Смерть не смогла убить мою жажду к жизни. А здешние трупы... — Морт обводит комнату взглядом. — Они и при жизни из себя ничего не представляли».~
@42301 = ~«Понятно...»~
@42302 = ~«Слушай шеф... Наблюдение за тем, как ты пытаешься поболтать с этими трупами, не способствует укреплению моей морали. Давай оставим разговоры с мертвецами сумасшедшим, ладно?»~
@42303 = ~«Хорошо. Идем».~
@42304 = ~Оставить труп в покое.~
@42305 = ~Оставить труп в покое.~
@42306 = ~«Кажется, просителю повезло, шеф. Смотри... у него в руке ключ».~
@42307 = ~Записка от трупа #1201~
@42308 = ~«Было приятно с тобой поболтать. Прощай».~
@42309 = ~Оставить труп в покое.~
@42310 = ~Оставить труп в покое.~
@42311 = ~У этого трупа ничего нет... но ты замечаешь, что его руки сильно перевязаны. Бинты могут пригодиться, если снять их с трупа.~
@42312 = ~«Похоже, ключа у тебя нет... Ты случайно не знаешь, у кого из твоих приятелей есть ключ от этого места?»~
@42313 = ~«Похоже, ключа у тебя нет... Ты случайно не знаешь, у кого из твоих приятелей есть ключ от этого места?»~
@42314 = ~«Было приятно с тобой поболтать. Прощай».~
@42315 = ~Оставить труп в покое.~
@42316 = ~«Приветствую?..»~
@42317 = ~«Должно быть, это тело Мертвина...»~
@42318 = ~Оставить его в покое.~
@42319 = ~~
@42320 = ~Безголовое тело на миг перестает рыскать и останавливается. Его руки начинают тянуться вперед, как бы нащупывая, где именно ты находишься.~
@42321 = ~Позволить потрогать себя.~
@42322 = ~Схватить его за руку.~
@42323 = ~Отступить от него.~
@42324 = ~Спустя миг его пальцы притрагиваются к твоему предплечью. Он хватается за твою руку и следует к плечу, потом к голове. Ощупав твое лицо и голову, его руки притрагиваются к твоей шее, как бы что-то проверяя. Наконец он хватает твою руку и яростно пожимает ее в знак приветствия. Ты отмечаешь, что кожа у него холодная и немного липкая.~
@42325 = ~«Ты меня понимаешь?»~
@42326 = ~«Я должен идти. Прощай».~
@42327 = ~Безголовый неожиданно подскакивает и крепко хватает тебя за руку, пожимая ее... это тело без головы кажется довольно дружелюбным. У него сильная хватка, но кожа у него холодная и немного липкая.~
@42328 = ~«Где твоя голова? Ты вообще меня понимаешь?»~
@42329 = ~«Я должен идти. Прощай».~
@42330 = ~Тело делает ряд движений руками и ждет ответа. Кажется, оно задало тебе вопрос.~
@42331 = ~«Что? Я не понимаю...»~
@42332 = ~«Я должен идти. Прощай».~
@42333 = ~Тело без головы несколько секунд топает ногой, почесывая подбородок головы-протеза. Внезапно оно подымает палец, будто что-то придумав. Оно указывает на тебя, затем на глаза своей деревянной головы, затем снова на тебя. Потом оно указывает на свою деревянную голову обеими руками, пожимает плечами и указывает на тебя.~
@42334 = ~«Э-э, нет... Твоей головы я нигде не видел».~
@42335 = ~Безголовое тело пожимает плечами, опускает плечи и поворачивается, чтобы отойти.~
@42336 = ~Уйти.~
@42337 = ~Тело перемещается в твою сторону, вытянув руки к коробке с головой Мертвина.~
@42338 = ~Позволить телу Мертвина забрать его голову.~
@42339 = ~Не дать голову телу.~
@42340 = ~«Ох, так намного лучше; спасибо, сэр! Думаю, мое тело без меня стало немного беспокойным, — тело крепко обнимает стальную коробку. — Да, мне тебя тоже не хватало... — тело берет коробку под мышку и кланяется тебе. — Что касается тебя, сэр... ты, несомненно, заслужил *некоторое* вознаграждение за беспокойство. Так, посмотрим, что тут у меня... — тело роется в карманах, и, ничего там не отыскав, лезет в тунику. Наконец оно дает тебе несколько горстей медных монет.~
@42341 = ~«Спасибо, Мертвин. У меня есть другие вопросы...»~
@42342 = ~«Благодарю. Прощай, Мертвин».~
@42343 = ~«Конечно, спрашивай, что захочешь!»~
@42344 = ~«Как вышло, что ты... остался без головы?»~
@42345 = ~«Что ты здесь делаешь?»~
@42346 = ~«Что ты можешь рассказать об этом месте?»~
@42347 = ~«Что ты знаешь о Равель Заморочке?»~
@42348 = ~«Неважно, Мертвин. Прощай».~
@42349 = ~«Я не уверен, правда... тело положило меня в одном из лекционных залов, и следующее, что я помню, это что кто-то сбежал со мной! Следующее, что я помню, это как ты меня подобрал...»~
@42350 = ~«Но я имею в виду, каким образом ты лишился своей *головы*?»~
@42351 = ~«У меня есть другие вопросы...»~
@42352 = ~«Это все, что я хотел узнать. Прощай».~
@42353 = ~Тело заметно напрягается. «О, мы об этом не любим говорить. Это было ужасно, правда... но что было — то прошло, не стоит ворошить прошлое. Я лишь скажу, что нахожусь в коробке, потому что моя голова выглядит не столь презентабельно, как мое тело, если ты понимаешь, о чем я».~
@42354 = ~«У меня есть другие вопросы...»~
@42355 = ~«Это все, что я хотел узнать. Прощай».~
@42356 = ~«В основном я брожу по Фестхоллу. Ну, знаешь: шатаюсь туда-сюда. Я не чувствующий, прошу заметить, но мне просто нравится наблюдать весь этот разношерстый народ, что тут бродит».~
@42357 = ~«Чувствующий?»~
@42358 = ~«У меня есть другие вопросы...»~
@42359 = ~«Это все, что я хотел узнать. Прощай».~
@42360 = ~Тело осторожно качает стальной коробкой, «кивая» головой внутри. «Да... ну, знаешь, Общество Восприятия. Они из кожи вон лезут, пытаясь все перепробовать, считают, что они в конце концов наткнутся на какую-нибудь великую тайну мультивселенной, если будут продолжать заниматься этим достаточно долго». Тело пожимает плечами.~
@42361 = ~«У меня есть другие вопросы...»~
@42362 = ~«Это все, что я хотел узнать. Прощай».~
@42363 = ~Мертвин, кажется, сбит с толку. «Разве не всем известно о Городском Фестхолле? Хм-м-м... что ж, это штаб-квартира чувствующих, и что, вероятно, более важно — в ней находятся их сенсориумы».~
@42364 = ~«Расскажи мне об этих сенсориумах...»~
@42365 = ~«Чувствующие?»~
@42366 = ~«У меня есть другие вопросы...»~
@42367 = ~«Это все, что я хотел узнать. Прощай».~
@42368 = ~«Здешний привратник может объяснить это лучше меня, сэр... это комнаты, где храниться много заколдованных камней, которые, в свою очередь, содержат различные впечатления и переживания, которые в них записали. Публичные сенсориумы открыты для каждого, но за их пользование взимается небольшая плата. Частные сенсориумы доступны только для чувствующих, членов Общества Восприятия».~
@42369 = ~«Чувствующие?»~
@42370 = ~«У меня есть другие вопросы...»~
@42371 = ~«Это все, что я хотел узнать. Прощай».~
@42372 = ~«Равель? Не припомню такой женщины...»~
@42373 = ~«Тогда у меня еще вопрос...»~
@42374 = ~«В таком случае, прощай».~
@42375 = ~Обезглавленный человек все еще бродит вокруг, натыкаясь на стены, колонны и другие предметы. Его фальшивая деревянная голова ненадежно качается на плечах, когда он ходит взад-вперед.~
@42376 = ~«Приветствую?..»~
@42377 = ~«Приветствую?..»~
@42378 = ~«Должно быть, это тело Мертвина...»~
@42379 = ~Оставить его в покое.~
@42380 = ~~
@42381 = ~Тело Мертвина стоит здесь, неторопливо перебирая пальцами по стальной коробке, в которой находится его голова. Когда ты подходишь, оно наклоняет коробку вперед. «И снова здравствуй, сэр!»~
@42382 = ~«Приветствую. у меня есть несколько вопросов, Мертвин...»~
@42383 = ~«Я просто мимо проходил, Мертвин. Счастливо».~
@42384 = ~У этой прочной стальной коробки сверху есть толстая кожаная ручка, но как ее открыть — непонятно: выглядит она наглухо запаянной. На одной из сторон имеется несколько очень узких прорезей, хотя через них ты не можешь толком разглядеть, что в коробке. Из прорезей доносится слащавый гнилостный запах. Изучая емкость более внимательно, ты замечаешь, она слегка покачивается в твоих руках. Внутри что-то двигается! Из нее доносится мужской голос: «Эй, там... есть там кто-нибудь? Меня зовут Мертвин... кто-нибудь? Эй?»~
@42385 = ~«Да... здравствуй...»~
@42386 = ~Проигнорировать голос и отложит коробку.~
@42387 = ~«Хвала силам! Ты случайно не видел мое тело? Его трудно не заметить... бродит с глупой деревянной башкой на плечах... должно быть, оно уже стерло ноги до коленей, разыскивая меня!»~
@42388 = ~«Да... в Городском Фестхолл».~
@42389 = ~«Нет... Не думаю...»~
@42390 = ~«Тогда фортуна мне улыбнулась! Могу ли я уговорить тебя вернуть меня ему, сударь?»~
@42391 = ~«Да, я сделаю это для тебя».~
@42392 = ~«А что мне от этого будет?»~
@42393 = ~«Возможно, позже. Прощай».~
@42394 = ~«Великолепно! Премного благодарен, сэр. А теперь, если не возражаешь, мы отложим этот разговор до тех пор, пока я не вернусь к своему телу».~
@42395 = ~«Но у меня есть несколько вопросов...»~
@42396 = ~«Ладно... Прощай».~
@42397 = ~«В этом я не сомневаюсь, сэр: не каждый день попадаются отрезанные говорящие головы в железных коробках... но это подождет. Видишь ли, очень уж это скучно: быть в разлуке с телом... прими мои глубочайшие извинения».~
@42398 = ~«Тогда ладно. Прощай».~
@42399 = ~«Э... моя благодарность?»~
@42400 = ~«Сойдет. Я верну тебя на место».~
@42401 = ~«Мне бы что-нибудь более значительное».~
@42402 = ~«Ну, я уверен, что по дороге к моему телу мы наверняка захватим что-нибудь подходящее, сэр. Можешь сначала вернуть меня?»~
@42403 = ~«Ладно, я сделаю это».~
@42404 = ~«Дай мне что-нибудь сейчас».~
@42405 = ~«Э... ну, видишь ли, в данный момент у меня в самом деле ничего с собой *нет*. Видишь ли, я *всего лишь* голова в запертом железном ящике».~
@42406 = ~«Ладно... Я сделаю это».~
@42407 = ~«Отлично... вот и будешь гнить в своем ящике, Мертвин».~
@42408 = ~«Постой! Погоди, сударь! Послушай, я могу тебе *что-нибудь* дать, просто сначала мне нужно вернуться к своему телу!»~
@42409 = ~«Ладно, я сделаю это».~
@42410 = ~«Мы поговорим об этом позже. Прощай».~
@42411 = ~«О, боги. Что ж, это было бы уже слишком — надеяться на такое, правда? Как бы там ни было, оно, вероятно, шатается по Городскому Фестхоллу, что в северо-восточном углу Чиновничьего района. Могу ли я каким-то образом уговорить тебя доставить меня к нему, сударь?»~
@42412 = ~«Да, я сделаю это для тебя».~
@42413 = ~«А что мне от этого будет?»~
@42414 = ~«Возможно, позже. Прощай».~
@42415 = ~Голова Мертвина в коробке начинает суетиться, когда ты ее поднимаешь. «О, и снова привет... скажи-ка, есть ли шанс, что ты вернешь меня моему телу? Уверяю тебя, я буду *очень* благодарен...»~
@42416 = ~«Да, я сделаю это для тебя».~
@42417 = ~«А что мне от этого будет?»~
@42418 = ~«Возможно, позже. Прощай».~
@42419 = ~Голова Мертвина в коробке начинает суетиться, когда ты ее поднимаешь. «Мы уже пришли, сударь? М-м-м... я не *вижу* своего тела...»~
@42420 = ~«Мы еще не пришли, однако у меня есть несколько вопросов...»~
@42421 = ~«Мы еще не пришли. Прощай».~
@42422 = ~Внезапно голос Мертвина эхом раздается в стальной коробке. «О! О! Вот оно! Это мое тело! Послушай, старина... вон там...»~
@42423 = ~«О, да брось... это не очень вежливо, сэр. Да и на кой черт, в конце концов, сдалась тебе моя голова?»~
@42424 = ~Позволить телу Мертвина забрать его голову.~
@42425 = ~«Извини, ты еще немного побудешь у меня. Прощай».~
@42426 = ~«Кто ты?»~
@42427 = ~«Что ты можешь рассказать об этом месте?»~
@42428 = ~«У меня нет к тебе вопросов. Прощай».~
@42429 = ~Анаци удивленно смотрит на тебя своими слезящимися глазами, затем перекидывается парой слов с Дакконом.~
@42430 = ~«Что она сказала?»~
@42431 = ~«Убей ее, Даккон. Заставь ее мучиться».~
@42432 = ~«Даккон, избавь ее от страданий. Очевидно, что ей очень больно, и она недолго еще протянет».~
@42433 = ~«Давай убираться отсюда, Даккон. Попрощайся с ней».~
@42434 = ~Избавить ее от страданий.~
@42435 = ~Заколоть ее для развлечения.~
@42436 = ~Она пристально смотрит на тебя и произносит Даккону пару неразборчивых слов.~
@42437 = ~Даккон смотрит на тебя и говорит: «Она не понимает тебя. Она говорит, что умирает».~
@42438 = ~«От чего она умирает?»~
@42439 = ~«Может, тогда тебе лучше ее просто убить. Но заставь ее помучиться».~
@42440 = ~«Мы можем что-нибудь для ее сделать?»~
@42441 = ~«Отлично. Нам нужно идти».~
@42442 = ~«Ее зовут Анаци. Она говорит, что когда-то работала здесь на консервном заводе, но полмесяца назад ее болезнь стала для нее невыносимой. Ее покинули, выгнали из дома и оставили умирать. Ей больно говорить, болезнь искалечила ей разум. Она говорит, что не может дать тебе ничего ценного».~
@42443 = ~«И?»~
@42444 = ~«Тогда оставим ее в покое. Может, она поправится».~
@42445 = ~Глаза Даккона тускнеют, однако он делает тебе поклон. Он поворачивается к старухе, показывает ей Неразрывный Круг Зертимона и произносит ей несколько коротких слов. Она бросает на тебя взгляд, полный ненависти, и снова поворачивается к Даккону. Он обнажает клинок. Она стоит перед ним, глядя ему прямо в глаза. Он делает замах...~
@42446 = ~«Остановись, Даккон. Мы оставим ее в покое. Пошли».~
@42447 = ~«Лучше заколи ее, Даккон. Я сказал, доставь ей страдания».~
@42448 = ~Дать ему прикончить ее.~
@42449 = ~«*Знай*, что она не излечится. Я могу избавить ее от страданий. Вот и все. Моя обязанность как *зерта* из Народа — предоставить ей выбор».~
@42450 = ~«Тогда сделай это. И заставь ее помучиться».~
@42451 = ~«Тогда будь милосерден, Даккон».~
@42452 = ~«Не делай этого. Нас ждут другие дела».~
@42453 = ~Даккон смотрит на тебя без эмоций, затем поворачивается и делает поклон женщине-гитцерай перед тем, как вы уходите.~
@42454 = ~Не смотря на тебя, Даккон пронзает ее тело лезвием *карача*. Она судорожно вздыхает, и с ее губ начинает течь кровавая слюна. Ее взгляд мутнеет, а ноги подкашиваются. Она соскальзывает с меча и падает на землю.~
@42455 = ~«Пошли отсюда».~
@42456 = ~Даккон обнажает клинок и ждет, пока женщина приготовится. Она касается вынутого им ненадолго Неразрывного Круга Зертимона, ее лицо выражает мужество. Его клинок мутнеет, и когда он завершает удар, она падает на твердые камни сигильских улиц, истекая кровью.~
@42457 = ~«Отличный удар, Даккон. Идем».~
@42458 = ~Она касается вынутого им ненадолго Неразрывного Круга Зертимона, ее лицо выражает мужество. Его клинок мутнеет, и когда он завершает удар, она падает на твердые камни сигильских улиц, истекая кровью.~
@42459 = ~«Пошли, Даккон».~
@42460 = ~«Ее зовут Анаци. Ее болезнь смертельна. Она причиняет ей мучения. Стойкость Народа к дурному воздуху этого района ниже, чем у вас, людей. Я — *зерт*. Моя обязанность — предоставить ей выбор. Она умоляла меня сделать это, поскольку Народ обходит ее стороной».~
@42461 = ~«Тогда сделай это. И заставь ее помучиться».~
@42462 = ~«Тогда будь милосерден, Даккон».~
@42463 = ~«Не делай этого. Нас ждут другие дела».~
@42464 = ~Мар~
@42465 = ~Браскен~
@42466 = ~Курьер~
@42467 = ~Перед тобой больная женщина-гитцерай. Она сгорблена, ее постоянный кашель явно причиняет ей боль: она держит у лица платок, насквозь пропитанный кровью и мокротой. Она следит за тобой, шипя.~
@42468 = ~«Приветствую».~
@42469 = ~«Кто ты?»~
@42470 = ~«Что ты можешь рассказать об этом месте?»~
@42471 = ~«Тебе нужно лечение? Я могу для тебя что-нибудь сделать?»~
@42472 = ~«Что с тобой?»~
@42473 = ~«У меня нет к тебе вопросов. Прощай».~
@42474 = ~Старая гитцерайка выглядит еще хуже, чем раньше, если такое возможно. Она пытается шипеть на тебя, но у нее начинается приступ кровавого кашля.~
@42475 = ~«Тебе нужно лечение? Я могу для тебя что-нибудь сделать?»~
@42476 = ~«Что с тобой?»~
@42477 = ~«Ты не могла бы ответить мне на несколько вопросов?»~
@42478 = ~«Прощай, старуха».~
@42479 = ~Она все кашляет и кашляет, наполняя свой промокший платок мокротой. Ее глаза ненавистно глядят на тебя.~
@42480 = ~«Тебе нужно лечение? Я могу для тебя что-нибудь сделать?»~
@42481 = ~«Что с тобой?»~
@42482 = ~«Тогда прощай». ~
@42483 = ~Она кашляет, пренебрежительно отмахиваясь от тебя. Она кутается в свои лохмотья, явно желая, чтобы ее оставили умирать в одиночестве.~
@42484 = ~«Тебе больно? Я могу тебе хоть *чем-то* помочь?»~
@42485 = ~Дать ей немного монет.~
@42486 = ~«Слушай, просто ответь на пару вопросов...»~
@42487 = ~«Тогда ладно. Прощай».~
@42488 = ~Сквозь кашель она произносит пару фраз на неведомом тебе языке и сгибается пополам от очередного приступа мучительного кашля.~
@42489 = ~«Тогда прощай». ~
@42490 = ~Она выбивает монеты из твоей руки, рассыпая их по улице. Она снова вяло шипит на тебя.~
@42491 = ~«Тогда прощай». ~
@42492 = ~Она бессильно показывает на воздух над ней. Затем она указывает на Литейную, на мусор, на горы угля, а потом на свою грудь. Как бы подчеркивая свои слова, она разражается еще одним приступом кашля, который оставляет кровь на ее губах.~
@42493 = ~«Это все смог?»~
@42494 = ~«Я могу дать тебе какое-нибудь лекарство?»~
@42495 = ~Она кивает и еще раз хрипло кашляет.~
@42496 = ~«Я могу дать тебе какое-нибудь лекарство?»~
@42497 = ~«Тогда я ничего не могу для тебя сделать. Прощай».~
@42498 = ~Ее взгляд мрачнеет, когда она указывает на твое оружие, затем на себя.~
@42499 = ~«Ты хочешь, чтобы я тебя убил?»~
@42500 = ~«Я не стану это делать для тебя. Прощай».~
@42501 = ~Она кивает головой так энергично, как только может, расплачиваясь за это ужасным приступом кашля. Она твердо указывает на твое оружие. В ее желтых глазах не видно страха.~
@42502 = ~«Ну что ж, удачи тебе в следующей жизни».~
@42503 = ~«Я не стану этого делать для тебя».~
@42504 = ~Она сплевывает кровавый комок слизи тебе под ноги, когда ты отворачиваешься.~
@42505 = ~Оставить ее в покое.~
@42506 = ~Убить ее.~
@42507 = ~Она смотрит на тебя отважно и без тени страха, в ожидании смертельного удара.~
@42508 = ~Избавить ее от страданий.~
@42509 = ~«Я не могу это сделать для тебя».~
@42510 = ~Ты убиваешь ее ловким ударом. Ее тело оседает на твердую мостовую, но почему-то она кажется благодарной.~
@42511 = ~«Прощай, гитцерайка».~
@42512 = ~Покупатель~
@42513 = ~Микка~
@42514 = ~Удалить~
@42515 = ~~
@42516 = ~~
@42517 = ~~
@42518 = ~атакован~
@42519 = ~Ты видишь офицера Гармониума. При твоем приближении он бросает на тебя скучающий взгляд.~
@42520 = ~Он бросает на тебя скучающий взгляд. «Приветствую, гражданин. Вортен, Третья ступень, к твоим услугам».~
@42521 = ~~
@42522 = ~~
@42523 = ~~
@42524 = ~~
@42525 = ~~
@42526 = ~~
@42527 = ~~
@42528 = ~~
@42529 = ~~
@42530 = ~~
@42531 = ~~
@42532 = ~«Правда? Ну да, так и есть».~
@42533 = ~«Я Луис. А *ты* кто? Чурбан неотесанный, который к тому же роется в чужих вещах...»~
@42534 = ~«Что ж, сэр, если тебе необходимо знать... я здесь в качестве шкафа».~
@42535 = ~«Так уж случилось, что я превратился в шкаф, потому что *хочу* быть шкафом. *Не для того*, чтобы смотреть, как дамы раздеваются, или чтобы они клали свое мягкое благоухающее нижнее белье в мои ящики, где оно может тереться о мою кожу. Такого рода обвинение оскорбительны для практикующегося в магических искусствах... Я лишь хотел испытать, *каково* оно — быть шкафом. Видеть, обонять, ощущать...»~
@42536 = ~«Да! Да, и они всем сердцем поддерживают это... ну, если быть точным, не всем. И хотя они *не высказывали* своего одобрения в моем присутствии, так как они не вполне осознают, что шкаф — это я, мне бы не хотелось, чтобы они что-то заподозрили и начали интересоваться этим делом».~
@42537 = ~«Отлично! Шикарно! Открой третий ящик, бездельник». Когда ты просовываешь руку в ящик, он со всей силы захлопывается — тебе еле удается вовремя одернуть пальцы.~
@42538 = ~«Ха-ха! Кретин! Идиот! Я сказал 'открой ящик', и ты полез...» Чтобы подчеркнуть это, он еще раз захлопывает ящик, затем начинает трястись от смеха.~
@42539 = ~«Отлично! Шикарно! Открой третий ящик, бездельник». Когда ты просовываешь руку в ящик, он со всей силы захлопывается. Жгуча боль пробегает по твоей руке, когда ты выдергиваешь свои разбитые пальцы.~
@42540 = ~«Ты *ничего* такого не сделаешь! Пожалуй, даже самые *заурядные* личности знают, что в Борделе нельзя применять жестокость... тебя просто выставят. И даже если бы это было *не так*, уверяю тебя, мое владение Искусством весьма впечатляюще».~
@42541 = ~«Прежде всего, скажу тебе вот что: я уже давным-давно не выходил из Борделя... Я неплохо осведомлен относительно его обитателей и их дел. Уверяю тебя, болтать обо мне совершенно бесполезно — ты утратишь меня как потенциальный источник информации, а я попросту исчезну до того, как кто-нибудь начнет проверять твои заявления, и ты выставишь себя дураком».~
@42542 = ~«Да?»~
@42543 = ~Кажется, шкаф на миг задумался об этом. «Мне нет нужды делиться подобными тайнами с такими как ты! И кроме того, в настоящий момент нет причин возвращаться к прежней форме, ведь я еще не прочувствовал до конца, каково оно — быть шкафом. Сложная это штука: хранить и сортировать мягкие вычурные вещи, вдыхать изумительные женские запахи». Ящик выдвигается и задвигается со звуком, имитирующим блаженный вздох.~
@42544 = ~«Лучше бы тебе выяснить это самому, чем услышать от меня... в конце концов, в этом половина всего удовольствия. Скажу лишь то, что ты скорее всего и сам знаешь: оно называется Борделем утоления интеллектуальной страсти, и здешние куртизанки специализируются на искусстве речи и общения».~
@42545 = ~«А, Экко. Знаешь, ведь она не всегда была немой. В противном случае, я уверен, что она бы со временем научилась каким-нибудь средствам общения. Должно быть, это случилось недавно».~
@42546 = ~«Я бы не заходил так далеко, чтобы называть ее дочерью *Равель*, однако она *действительно* ночная ведьма — в этом-то я точно уверен. Обрати внимание на кожу, глаза, сильный характер и эту ее беспричинную одержимость чужими снами... все это верные знаки, верные знаки. Несомненно, только решительное отрицание Кесай ее истинной сути пока что не позволяет ей превратиться в сгорбленную старую каргу, которыми становятся все ночные ведьмы».~
@42547 = ~«Ах да... я *слышал* об этом. Какая досада! Доводилось ли тебе когда-нибудь испытывать то изысканное удовольствие от вдыхания ее аромата? — ящики шкафа, казалось бы, трепещут от наслаждения. — Он был просто изумителен, этот запах. Нет, к сожалению, я не знаю, где найти аромат милой госпожи Вивьен».~
@42548 = ~«Я слышал, что она, бывало, гуляла в малиновой вуали, но недавно забралась в свою комнату и затемнила ее. Не знаю, что там приключилось. Значит, эта ее вуаль пропала?»~
@42549 = ~«Мало кто, поживший в Сигиле хоть какое-то время, не знает о ней хоть что-нибудь. Хотя должен поинтересоваться, что же ты хочешь знать о ней?»~
@42550 = ~«Знаешь что, да ты спятил... точно спятил. 'Совершенно рехнулся' — вот как это, по-моему, называется. Равель давным-давно изгнали из Сигила, и если она еще не умерла, ты *сам* захочешь умереть, если тебе каким-то образом удастся ее найти. Поговаривают, что раньше она съедала всех, кто ее находил, и, скорее всего, она окажет тебе ту же услугу. Я бы лучше в это все не лез».~
@42551 = ~«Нет никакой десятой ученицы! Что за чушь ты несешь?»~
@42552 = ~Тебе удалось выдернуть из шкафа кусок материи — полупрозрачную малиновую вуаль. Пряча ее, ты отмечаешь, что от нее исходит легкий экзотический и весьма приятный аромат.~
@42553 = ~«Проклятье! Ах ты негодяй! Мерзавец! Подлец! *Сейчас же* верни мне ее! Это не твое! Это очень личный предмет одежды, принадлежащий даме из этого заведения. Дамы не будут рады узнать, что ты трогаешь их личные вещи!»~
@42554 = ~«Я не занимаюсь ничем преступным или злонамеренным, в отличие от тебя! Я просто впитываю ощущения, необходимые для моего личностного роста».~
@42555 = ~Ты попросту не можешь двигаться достаточно быстро, чтобы выхватить малиновую материю у Луиса... лучшее, что тебе удается — это прищемить себе пальцы.~
@42556 = ~«Нет. Ни за что. Никогда».~
@42557 = ~«*Мпф*. Прекрати! Прекрати, кому говорят! Осторожней с ручками! Не поцарапай отделку! Проклятый надоедливый мерзавец!» Шкаф предпринимает отчаянную попытку, но ты, наконец, открываешь ящик и выхватываешь оттуда кусок материи — полупрозрачную малиновую вуаль. Пряча ее, ты отмечаешь, что от нее исходит легкий экзотический и весьма приятный аромат.~
@42558 = ~Ящик остается закрытым. Ты слышишь, как он сопит и хрипит от напряжения. «Убирайся *прочь*, варвар!»~
@42559 = ~«О, перестань заниматься этой ерундой! Это очень утомляет. Это превосходит все известные мне значения слова *тоска*!»~
@42560 = ~«Прекрати! Какая скукота! Ты навеваешь на меня сон».~
@42561 = ~Шкаф зевает, показывая малиновую ткань, уютно лежащую среди какого-то белья. Ты суешь туда руку и достаешь ее, прежде чем ящик закрывается. Пряча ее, ты отмечаешь, что от нее исходит легкий экзотический и весьма приятный аромат.~
@42562 = ~Это Луис, говорящий шкаф.~
@42563 = ~Это Луис, говорящий шкаф.~
@42564 = ~Над шкафом нависла грозная тишина; ответа не слышно. Ты уверен, что это все еще Луис — ты практически *ощущаешь* ненависть, излучаемую древесиной, — но он не будет с тобой говорить.~
@42565 = ~Ты в готовности стоишь у шкафа. Он продолжает греметь ящиками, но ни разу не остается открытым настолько, чтобы ты успел схватить ткань.~
@42566 = ~«Тебе *кажется*? *КАЖЕТСЯ*?! Как можно быть настолько невоспитанным, таким смехотворно дерзким, чтобы высказывать подобные обвинения, не будучи абсолютно *уверенным* в них?! Да как ты *посмел*! Нахальный невоспитанный тип! Пожалуй, мне следовало...»

Пока Луис изливает потоки брани и проклятий, его ящики открываются и закрываются... среди других вещей ты замечаешь небольшой сверток малиновой ткани. Однако постоянные открывания и закрывания ящиков шкафа усложняют доступ к ней.~
@42567 = ~Просто уйти.~
@42568 = ~«Ты *говоришь*?»~
@42569 = ~«Кто ты?»~
@42570 = ~«Что ты здесь делаешь?»~
@42571 = ~«Мне уже пора идти. Счастливо».~
@42572 = ~«Кто ты?»~
@42573 = ~«Что ты здесь делаешь?»~
@42574 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
@42575 = ~«Забудь об этом. Что ты тут делаешь?»~
@42576 = ~«Неважно. Прощай».~
@42577 = ~«Но *зачем* тебе быть шкафом в этом борделе?»~
@42578 = ~«Это все, что я хотел узнать. Прощай».~
@42579 = ~«Так значит, все женщины об этом знают?»~
@42580 = ~«Хорошо. У меня есть другой вопрос...»~
@42581 = ~«Это все, что я хотел узнать. Прощай».~
@42582 = ~«За свое молчание мне от тебя кое-что понадобится».~
@42583 = ~«За свое молчание мне от тебя кое-что понадобится».~
@42584 = ~«У меня есть вопросы к тебе...»~
@42585 = ~«Это все, что я хотел узнать. Прощай».~
@42586 = ~«Я сейчас же все расскажу им».~
@42587 = ~«Я собираюсь расколоть тебя на дрова».~
@42588 = ~«Весьма забавно. У меня есть пара вопросов, Луис...»~
@42589 = ~Уйти.~
@42590 = ~«Тогда ладно... Я просто пойду и расскажу им о тебе».~
@42591 = ~«Тогда у меня есть несколько вопросов...»~
@42592 = ~«В таком случае, прощай».~
@42593 = ~«Тогда я, пожалуй, порублю тебя на дрова».~
@42594 = ~«Я понимаю. В таком случае, у меня еще вопросы...»~
@42595 = ~«Понятно. Тогда прощай, Луис».~
@42596 = ~«Ага... и зачем тебе быть шкафом в этом борделе?»~
@42597 = ~«Ты можешь вернуть себе нормальную форму, если захочешь?»~
@42598 = ~«Что ты можешь сказать об этом месте?»~
@42599 = ~«Ненни сказала мне, что видела мужчину, выходящего из комнаты Кимаскси Змееязыкой... Мне кажется, это был ты, Луис».~
@42600 = ~«Что ты можешь рассказать о молчаливой куртизанке?»~
@42601 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@42602 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@42603 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@42604 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@42605 = ~«Я переговорил со всеми девятью куртизанками... ты не знаешь, кто десятая или где она находится?»~
@42606 = ~«Неважно. Прощай».~
@42607 = ~«У меня есть другие вопросы...»~
@42608 = ~«Это все, что я хотел узнать. Прощай».~
@42609 = ~«У меня есть другие вопросы...»~
@42610 = ~«Это все, что я хотел узнать. Прощай».~
@42611 = ~«У меня есть другие вопросы...»~
@42612 = ~«Это все, что я хотел узнать. Прощай».~
@42613 = ~«У меня есть другие вопросы...»~
@42614 = ~«Это все, что я хотел узнать. Прощай».~
@42615 = ~«У меня есть другие вопросы...»~
@42616 = ~«Да. У меня еще один вопрос...»~
@42617 = ~«Да. Прощай, Луис».~
@42618 = ~«Мне нужно найти ее».~
@42619 = ~«Неважно. У меня другой вопрос...»~
@42620 = ~«Забудь, что я о ней спрашивал. Прощай, Луис».~
@42621 = ~«У меня есть другие вопросы...»~
@42622 = ~«Это все, что я хотел узнать. Прощай».~
@42623 = ~«Неважно. У меня другой вопрос...»~
@42624 = ~«Забудь об этом, Луис. Счастливо».~
@42625 = ~«Ах, значит, для тебя это нормально, деревянный ты извращенец?»~
@42626 = ~«Да-да... Прощай, Луис».~
@42627 = ~«Да-да... Прощай, Луис».~
@42628 = ~«Отдай мне эту малиновую ткань».~
@42629 = ~Выдвинуть ящик и забрать ткань.~
@42630 = ~Выдвинуть ящик и забрать ткань.~
@42631 = ~Ныть и клянчить ткань.~
@42632 = ~Выдвинуть ящик и забрать ткань.~
@42633 = ~Выдвинуть ящик и забрать ткань.~
@42634 = ~Ныть и клянчить ткань.~
@42635 = ~«Отдай мне малиновую ткань, Луис».~
@42636 = ~Выдвинуть ящик и забрать ткань.~
@42637 = ~Ныть и клянчить ткань.~
@42638 = ~«Отдай мне эту малиновую ткань».~
@42639 = ~Выдвинуть ящик и забрать ткань.~
@42640 = ~Еще немного поныть и поклянчить ткань.~
@42641 = ~«Отдай мне эту малиновую ткань».~
@42642 = ~Выдвинуть ящик и забрать ткань.~
@42643 = ~Выдвинуть ящик и забрать ткань.~
@42644 = ~Продолжить ныть и клянчить.~
@42645 = ~«Луис, у меня есть кое-какие вопросы...»~
@42646 = ~Оставить его в покое.~
@42647 = ~«Луис, у меня есть кое-какие вопросы...»~
@42648 = ~Оставить его в покое.~
@42649 = ~«Пока, Луис».~
@42650 = ~Уйти.~
@42651 = ~Попробовать схватить ее, пока ящик открыт.~
@42652 = ~Попробовать схватить ее, пока ящик открыт.~
@42653 = ~Попытаться выхватить ее.~
@42654 = ~Попытаться выхватить ее.~
@42655 = ~Дождаться возможности схватить ее.~
@42656 = ~На ощупь цепь немного теплая, будто живая. Ты замечаешь, что к цепи по всей длине приварены различные шипы, крючочки, иглы и другие маленькие острые предметы.~
@42657 = ~Прикоснуться к цепи.~
@42658 = ~Уйти.~
@42659 = ~Уйти.~
@42660 = ~Ты кладешь руку на картину, точно не зная, чего ожидать... но ощущаешь лишь фактуру покрытого краской холста.~
@42661 = ~Поверхность картины сильно пахнет морским воздухом.~
@42662 = ~Понюхать картину.~
@42663 = ~Прикоснуться к картине.~
@42664 = ~Уйти.~
@42665 = ~Понюхать картину.~
@42666 = ~Уйти.~
@42667 = ~Прикоснуться к картине.~
@42668 = ~Уйти.~
@42669 = ~Как бы ты не старался, ты не можешь выдавить из рога ни звука. Ты убираешь губы от мундштука, ощущая привкус крови, дыма и металла.~
@42670 = ~Уйти.~
@42671 = ~Уйти.~
@42672 = ~Уйти.~
@42673 = ~Уйти.~
@42674 = ~Прикоснуться к картине.~
@42675 = ~Уйти.~
@42676 = ~Довольно странно, но поверхности картины ничем не примечательна.~
@42677 = ~Уйти.~
@42678 = ~Уйти.~
@42679 = ~Уйти.~
@42680 = ~Уйти.~
@42681 = ~Это портрет гротескной крючконосой старухи. Кожа у нее нездорового голубовато-серого цвета. Ее глаза светятся красным, как угольки угасающего пламени. Ее подбородок, длинный и острый, выступает вперед в неправильном прикусе. Два желтых клыка торчат из ее нижней челюсти, словно небольшие бивни. Улыбка на ее сморщенных багровых губах говорит о страшном секрете. Табличка гласит: «Серая ведьма Ойноса».~
@42682 = ~Ты уже собираешься отвернуться от картины, но что-то притягивает твое внимание... в твоей голове возникает странное покалывающее ощущение... воспоминания, начинающие всплывать на поверхность...~
@42683 = ~Ты вспоминаешь, как стоишь, сбитый с толку, в лабиринте колючих кустов. Перед тобой стоит отвратительная старуха с картины, сотрясаясь от дикого хохота. Ты раздраженно стискиваешь зубы, размышляя над тем, почему она смеется над тобой. «Мой бедный дорогой прелестный человечек! — мурлычет она. — Ведь это же было твое *первое* желание!» Она указывает на твой лоб костлявым пальцем с когтем. Твои виски начинают болезненно пульсировать... но больше ты ничего не можешь вспомнить.~
@42684 = ~Уйти.~
@42685 = ~~
@42686 = ~Уйти.~
@42687 = ~Попытаться вспомнить.~
@42688 = ~Отвернуться, подавить воспоминания.~
@42689 = ~Уйти.~
@42690 = ~~
@42691 = ~Ты кладешь ладонь на холст... самой ряби ты не чувствуешь, однако при первом прикосновении через твою руку пробегает прохладное покалывающее ощущение.~
@42692 = ~~
@42693 = ~Прикоснуться к картине.~
@42694 = ~~
@42695 = ~~
@42696 = ~Уйти.~
@42697 = ~~
@42698 = ~Уйти.~
@42699 = ~~
@42700 = ~~
@42701 = ~~
@42702 = ~~
@42703 = ~~
@42704 = ~Уйти.~
@42705 = ~~
@42706 = ~Ты пытаешься прикоснуться к колышущимся осколкам стекла, но обнаруживаешь, что не можешь этого сделать... твоя рука останавливается у самой поверхности окна.~
@42707 = ~~
@42708 = ~Тебе удается лишь расшибить себе костяшки пальцев: это стекло — все равно что лист железа.~
@42709 = ~Прикоснуться к стеклу.~
@42710 = ~Уйти.~
@42711 = ~~
@42712 = ~~
@42713 = ~~
@42714 = ~Стукнуть по стеклу.~
@42715 = ~~
@42716 = ~~
@42717 = ~Уйти.~
@42718 = ~Уйти.~
@42719 = ~Ты кладешь руку на холст... как ты и подозревал, он физически неподвижен: меняется само изображение на нем.~
@42720 = ~Прикоснуться к картине.~
@42721 = ~Уйти.~
@42722 = ~Уйти.~
@42723 = ~~
@42724 = ~~
@42725 = ~~
@42726 = ~~
@42727 = ~~
@42728 = ~~
@42729 = ~~
@42730 = ~Твой лим-лим напоминает насекомое и животное одновременно. Ноги слишком большие, в отличие от рудиментарных маленьких рук, пестрый полупанцирь закрывает всю спину. У него также есть пара насекомовидных крыла, пара небольших черных глаз и вечно радостно улыбающийся рот.~
@42731 = ~«Пийо! Пийо!» Лим-лим весело прыгает, жужжа крыльями. Похоже, он очень быстро привязывается к хозяину.~
@42732 = ~Ты пытаешься отвесить быстрый пинок своему лим-лиму, однако он ловко подпрыгивает. «Пийо!» Он разворачивается и убегает, жужжа крыльями.~
@42733 = ~Осмотреть своего лим-лима.~
@42734 = ~Поднять своего лим-лима обратно.~
@42735 = ~Погладить своего лим-лима.~
@42736 = ~Пнуть своего лим-лима.~
@42737 = ~Прекратить играть с своим лим-лимом.~
@42738 = ~Поднять своего лим-лима обратно.~
@42739 = ~Погладить своего лим-лима.~
@42740 = ~Пнуть своего лим-лима.~
@42741 = ~Прекратить играть с своим лим-лимом.~
@42742 = ~Поднять своего лим-лима обратно.~
@42743 = ~Погладить своего лим-лима еще немного.~
@42744 = ~Пнуть своего лим-лима.~
@42745 = ~Прекратить играть с своим лим-лимом.~
@42746 = ~Отпустить его.~
@42747 = ~Догнать его, попытаться пнуть его еще раз.~
@42748 = ~Отпустить лим-лима немного побегать вокруг.~
@42749 = ~Погладить лим-лима.~
@42750 = ~Пнуть лим-лима.~
@42751 = ~Прекратить играть с лим-лимом.~
@42752 = ~Твой лим-лим напоминает насекомое и животное одновременно. Ноги слишком большие, в отличие от рудиментарных маленьких рук, пестрый полупанцирь закрывает всю спину. У него также есть пара насекомовидных крыла, пара небольших черных глаз и рот, который всегда кажется радостно улыбающимся.~
@42753 = ~Отпустить лим-лима немного побегать вокруг.~
@42754 = ~Погладить лим-лима.~
@42755 = ~Пнуть лим-лима.~
@42756 = ~Прекратить играть с лим-лимом.~
@42757 = ~«Пийо! Пийо!» Лим-лим весело извивается, жужжа крыльями. Похоже, он очень быстро привязывается к хозяину.~
@42758 = ~Отпустить лим-лима немного побегать вокруг.~
@42759 = ~Погладить лим-лима еще немного.~
@42760 = ~Пнуть лим-лима.~
@42761 = ~Прекратить играть с лим-лимом.~
@42762 = ~Ты пытаешься отвесить пинок лим-лиму, однако он выворачивается из твоих рук и спархивает на землю!~
@42763 = ~«Ой...»~
@42764 = ~~
@42765 = ~Эта арка углубляется в небольшое здание лишь на пару дюймов, после чего преграждается плотной стеной отбросов. Мусор набит туда так туго, что он все равно что кирпичная кладка.~
@42766 = ~~
