@7023 = ~«Это все, что я хотел узнать. Прощай».~
@7024 = ~«Ты можешь задать ему другой вопрос?»~
@7025 = ~«Это все, что я хотел узнать. Прощай».~
@7026 = ~«Ты можешь задать ему другой вопрос?»~
@7027 = ~«Это все, что я хотел узнать. Прощай».~
@7028 = ~«И все же, ты можешь спросить его?»~
@7029 = ~«Хватит нотаций, просто спроси его».~
@7030 = ~«Ты можешь задать ему другой вопрос?»~
@7031 = ~«Тогда неважно. Идем».~
@7032 = ~«Покажи мне, пожалуйста, 'Tavern1'».~
@7033 = ~Картина маслом, портрет девушки.~
@7034 = ~Вьющееся растение с черными побегами... Стебли выглядят очень острыми.~
@7035 = ~Здесь навалены горы мусора... Похоже на большую городскую свалку.~
@7036 = ~Тестовый напиток для Таверны 1~
@7037 = ~«Покажи мне, пожалуйста, 'Temple1'».~
@7038 = ~«Неважно. Верни меня меня в главное меню».~
@7039 = ~«Я хочу выйти из этого диалога».~
@7040 = ~Отвернувшись, ты замечаешь, что Морт уставился на тебя. «А? А?»~
@7041 = ~«Ты *видел*, как эта мертвая красотка меня осматривала? — зубы Морта стучат в предвкушении. — Она ищет какого-то счастливчика-рубаку, который согреет ее уютненький гробик».~
@7042 = ~Морт игнорирует тебя, становясь задумчивым. «Вообще-то я не возражаю против внимания к себе... просто мне больше нравится, когда за мной видят нечто большее, чем просто череп, понимаешь? У меня есть чувства, которые доминируют над моими животными инстинктами. Я хочу уважения, а не просто ночного летания по мавзолею».~
@7043 = ~«Ого, шеф...» Морт немного отлетает, чтобы ты не смог до него дотянуться. «Женщинам больше нравятся любовники, а не бойцы».~
@7044 = ~«Да, я просто череп, но у меня большое сердце».~
@7045 = ~«Тебе наплевать на мою жизнь, мои мечты и чаяния?! Отлично, ну и пусть. У меня нет сердца, зато у меня есть *душа*».~
@7046 = ~«Будь у тебя хоть половина того здравого смысла, с которым ты умер, ты бы понял, — голос Морта становится жутко самодовольным. — Что касается летописей любви, отмечу, что все они были написаны мной».~
@7047 = ~«Было приятно поболтать с тобой. Прощай».~
@7048 = ~Оставить тело в покое.~
@7049 = ~«Было приятно поболтать с тобой. Прощай».~
@7050 = ~Оставить тело в покое.~
@7051 = ~«Ну ладно. Было приятно поболтать с тобой. Прощай».~
@7052 = ~«Ну ладно. Было приятно поболтать с тобой. Прощай».~
@7053 = ~Оставить тело в покое.~
@7054 = ~Оставить тело в покое.~
@7055 = ~«Что такое?»~
@7056 = ~«*Пожалуйста*, только не начинай».~
@7057 = ~«О чем это ты *толкуешь*?»~
@7058 = ~«Что, ты имеешь в виду этот бессмысленный пустой могильный взгляд?»~
@7059 = ~«Продолжай в том же духе, и *я* отправлю тебя куда-нибудь полетать».~
@7060 = ~«Морт, *ты* — череп. Для всех ты только череп. Смирись с этим».~
@7061 = ~«Понимаю. А теперь идем отсюда, хорошо?»~
@7062 = ~«Ты, наверное, *последний* из всех, от кого я хотел бы слушать советы по части романтики».~
@7063 = ~«Как знаешь, Морт. Идем».~
@7064 = ~«Вообще-то, у тебя его *тоже* нет».~
@7065 = ~«Как знаешь, Морт. Идем».~
@7066 = ~«Ну, вообще-то, я могу поспорить на что угодно, что... а, забудь. Идем».~
@7067 = ~«Как знаешь, Морт. Идем».~
@7068 = ~«Как знаешь, Морт. Идем».~
@7069 = ~Кто-то позаботился о том, чтобы связать кости скелета кожаными ремнями, окутывающими тело на манер, напоминающий мускулы и сухожилия. Ремни привязаны к железными скобам, вбитым в суставы скелета. Этот скелет в хорошем состоянии; на костях, недавно покрытых известкой, все еще видны следы тела, покрывавшего его. ~
@7070 = ~Как и со всеми скелетами в Морге, кто-то позаботился о том, чтобы связать кости скелета кожаными ремнями, окутывающими тело на манер, напоминающий мускулы и сухожилия. Но в отличие от скелетов из Морга, у него нет железных скоб... тебе неясно, каким образом суставы соединяются. Тем не менее, этот скелет в хорошем состоянии; на костях, недавно покрытых известкой, все еще видны следы тела, покрывавшего его.~
@7071 = ~Морт изучает скелет, но затем качает головой. «Не... Этот слишком чистый... на нем почти не осталось мяса. К тому же, я никогда не смогу очистить кости от этой побелки».~
@7072 = ~«Эй, а как насчет этого скелета, Морт? Пойдет такое тело?»~
@7073 = ~«Прощай».~
@7074 = ~Оставить скелета в покое.~
@7075 = ~Оставить скелета в покое.~
@7076 = ~«Не знаю, если он — 'слишком чистый'... то тебе стоит изучить значение слова чистота».~
@7077 = ~«Ладно. Идем».~
@7078 = ~Этот тленный одет в длинную темную мантию, его руки вложены в рукава. Он склонил голову и поет в неторопливом темпе с остальными тленными, окружающими его.~
@7079 = ~«Приветствую».~
@7080 = ~Эта тленная одета в длинную темную мантию, ее руки вложены в рукава. Она склонила голову и поет в неторопливом темпе с остальными тленными, окружающими ее.~
@7081 = ~«Приветствую».~
@7082 = ~«Я один из оплакивающих, которые болтаются у киоска тленных в AR0200 (Улей B). Мы 'оплакиваем живых' и игрок может попросить нас поплакать за тех, кто потерял своих любимых».~
@7083 = ~ «Спасибо за информацию».~
@7084 = ~«Я один из оплакивающих, которые болтаются у киоска тленных в AR0200 (Улей B). Мы 'оплакиваем живых' и игрок может попросить нас поплакать за тех, кто потерял своих любимых».~
@7085 = ~«Спасибо за информацию».~
@7086 = ~«Надо бы отправить еще один отчет в Центральный архив...»~
@7087 = ~«Так-так, может быть, здесь есть кто-нибудь, а?»~
@7088 = ~«Фе! Трижды-проклятая сыпь...»~
@7089 = ~«Фе! Трижды-проклятая бутылка!»~
@7090 = ~«Хннн...»~
@7091 = ~«Очищенная. Не лучше ночного горшка! Фе!»~
@7092 = ~«Этим мелким вредителям уже недолго осталось!..»~
@7093 = ~Ты осматриваешь зубы Ингресс. Ты не можешь избавится от ощущения сходства с жучками из слоновой кости... Ты чувствуешь, что они внимательно смотрят на тебя, ожидая твою команду.~
@7094 = ~«Эй, Морт. Подойди-ка сюда на минутку».~
@7095 = ~«Э-э-эй! Стража! Здесь нарушитель!»~
@7096 = ~Готово.~
@7097 = ~«Сэр, вам бы лучше исчезнуть. Если уж вас должны вывести, я не хочу укрывать вас здесь».~
@7098 = ~Уйти.~
@7099 = ~«Чем могу служить, сэр?»~
@7100 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7101 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7102 = ~«Расскажи мне о своем предшественнике».~
@7103 = ~«Расскажи мне о своем предшественнике».~
@7104 = ~«Расскажи мне о своем предшественнике».~
@7105 = ~«Ничего. Прощай».~
@7106 = ~«Прошу прощения, сэр. Бригадир говорит, что вы проводите слишком много времени в кузнице. Нам нужно, чтобы и другие имели к ней доступ. Примите мои извинения, сэр».~
@7107 = ~«Расскажи мне о своем предшественнике».~
@7108 = ~«Расскажи мне о своем предшественнике».~
@7109 = ~«Расскажи мне о своем предшественнике».~
@7110 = ~«Ладно. Прощай».~
@7111 = ~«Изволите немного руды? Хорошо. Используйте ее с толком, сэр. С ней нужно хорошо обращаться».~
@7112 = ~«Я постараюсь. Прощай».~
@7113 = ~«Как угодно. Прощай».~
@7114 = ~«Странные вещи творятся! Как только Сароса посадили под замок, Тильдон просто исчез. Ни записки, ни объяснения... ничего. Просто встал и ушел. Он был та еще сволочь, так что никто о нем особо не горевал».~
@7115 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7116 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7117 = ~«Понятно. Прощай».~
@7118 = ~«Что ж! Как только его арестовали и заперли, мы постарались на славу, чтобы стереть его из памяти. Мы всегда ненавидели этого пня, это уж точно, и без него с нам стало легче».~
@7119 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7120 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7121 = ~«Понятно. Прощай».~
@7122 = ~«Очень жаль, что Сароса больше нет. Хотя вместе с ним сгинул и этот болван Тильдон... сделка с нечистым, не иначе. Сарос мне нравился, но Тильдон? Его больше нет. Этого вполне достаточно».~
@7123 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7124 = ~«Я хочу воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@7125 = ~«Понятно. Прощай».~
@7126 = ~«Ничего. Прощай».~
@7127 = ~«Прямо на юг-запад от Морга, или прямо на юг от Собирателей пыли, бара трухлявых».~
@7128 = ~«Леди Боли? Ты что, никогда *не слышал* о ней? Должно быть, ты либо благословен, либо еще более безмоз... э, еще мало знаешь о Сигиле — он тихонько смеется. — Слово Леди — закон в Сигиле, — он немного призадумывается. — Хотя она не очень-то и разговорчива. На самом деле, она убийственно молчалива».~
@7129 = ~Он с опаской смотрит на тебя. «Не нужно много говорить о ней, рубака... тебе не нужно попадать в ее тень или петь ей хвалебные речи, хорошо? И не будем больше об этом. Трясти черепушкой про Леди — это глупо, очень глупо».~
@7130 = ~«Точно!»~
@7131 = ~«Ничего. Прощай».~
@7132 = ~«Неважно. Прощай».~
@7133 = ~«Спасибо. Прощай».~
@7134 = ~«У меня есть другие вопросы...»~
@7135 = ~«Понятно. Спасибо за информацию. Прощай».~
@7136 = ~«Я выслушал достаточно. Прощай».~
@7137 = ~«А что это за 'ключи', про которые ты говорил?»~
@7138 = ~«Куда ведут все эти двери?»~
@7139 = ~«У меня есть другие вопросы к тебе...»~
@7140 = ~«Это все, что я хотел узнать. Прощай».~
@7141 = ~«У меня есть другие вопросы...»~
@7142 = ~«Тогда ладно... Прощай».~
@7143 = ~«У меня есть другие вопросы...»~
@7144 = ~«Неважно. Прощай».~
@7145 = ~«Понятно. У меня есть другие вопросы...»~
@7146 = ~«Неважно. Прощай».~
@7147 = ~«Неважно. Прощай».~
@7148 = ~«Понятно. Прощай».~
@7149 = ~«Неважно. Прощай».~
@7150 = ~«Прощай».~
@7151 = ~«У меня есть другие вопросы...»~
@7152 = ~«Спасибо. Прощай».~
@7153 = ~«Что-то типа закона».~
@7154 = ~«Что ты еще можешь рассказать об этой Леди?»~
@7155 = ~«Неважно. Прощай».~
@7156 = ~«Тогда прощай». ~
@7157 = ~Эти врата ведут назад в Морг.~
@7158 = ~Бар собирателей пыли~
@7159 = ~Огромный монумент... нет никакой таблички, объясняющей, для чего он поставлен.~
@7160 = ~На обсидиановом монументе высечены имена.~
@7161 = ~На обсидиановой стене высечены тысячи имен.~
@7162 = ~Окно Морга... Настолько грязное и закопченное, что совершенно не пропускает свет.~
@7163 = ~Похоже на зеркало... только вот отражения бара в нем нет.~
@7164 = ~Эти двери сделаны из черного невзрачного металла. Непохоже, что их можно открыть.~
@7165 = ~Барная стойка сделана из зеленого камня, который испаряет любую попадающуюся на него жидкость.~
@7166 = ~Кажется, это нечто вроде плевательницы для нежити... на песчаном дне лежат выброшенные части тел.~
@7167 = ~Эта бочка наполнена темной жидкостью, сильно пахнущей рассолом.~
@7168 = ~Содержимое этих булькающих резервуаров переливается в деревянные бочонки. Вокруг них в воздухе ощущается слабый запах уксуса.~
@7169 = ~В этом светильнике давно кончилось масло. На дне остался только пепел.~
@7170 = ~Кажется, саркофаг находится здесь уже несколько столетий. У него нет крышки... похоже, он сделан из цельного камня.~
@7171 = ~Запертые металлические ворота. Выглядят невероятно старо, но, в отличие от других ворот в городе, на этих нет ржавчины.~
@7172 = ~Это окно (если это и правда окно), похоже, сделано из синего камня, который движется и колеблется, когда ты на него смотришь. Оно излучает тусклый свет города.~
@7173 = ~Грубая деревянная тележка. Похоже, она развалится, если кто-нибудь попробует ей воспользоваться.~
@7174 = ~Старая тележка из лавки.~
@7175 = ~Деревянные доски этих ящиков деформировались, что позволяет тебе заглянуть внутрь. Внутри — гнилые мешки с зерном.~
@7176 = ~Кажется, этот огромный ящик используется еще и как подиум.~
@7177 = ~Эти бочки пусты. Обода, держащие доски, почти полностью проржавели.~
@7178 = ~Эта скамья вот-вот развалится.~
@7179 = ~Похоже на дверь, но нет ни ручки, ни каких-либо средств открыть ее.~
@7180 = ~Эмблема над дверью гласит: «Управление по борьбе с вредителями и болезнями».~
@7181 = ~Похоже, эти врата ведут в район Морга.~
@7182 = ~Довольно странно, но эта решетка как будто была выращена, а не выкована.~
@7183 = ~Анна немного остывает, однако хвост по-прежнему мечется из стороны в сторону. «Лучше следи за собой, если хочешь оставаться целым».~
@7184 = ~Анна делает взмах своим хвостом... очевидно, он подразумевает что-то оскорбительное.~
@7185 = ~Анна проводит лезвием по лицу женщины, оставляя тонкий кровавый след на щеке. «Теперь ты меченая», — шипит она. Женщина от страха не может пошевелиться. ~
@7186 = ~Грация кивает, как бы предоставляя тебе уединение. «Я скоро вернусь». Она поворачивается и уходит.~
@7187 = ~«Мимир — это говорящая энциклопедия. Это я, шеф».~
@7188 = ~Морт, словно загипнотизированный, очарованно слушает поток оскорблений, изливающийся изо рта проститутки. После этой словесной лавины Морт несколько мгновений молчит, затем поворачивается к тебе. «Ого, шеф. Есть несколько новых ругательств в моем старом добром арсенале». Он поворачивается назад к переводящей дыхание проститутке. «И я тебя тоже люблю».~ [MRT387]
@7189 = ~Над входом в это здание на камне нарисован белый овал с черной молнией, проходящей через него.~
@7190 = ~«Приветствую».~
@7191 = ~Пройти мимо.~
@7192 = ~«А?»~
@7193 = ~«Я потерял дневник».~
@7194 = ~«Может, ты мне поможешь найти то, что я потерял».~
@7195 = ~«Вообще-то, у меня несколько вопросов...»~
@7196 = ~«Не сегодня, спасибо».~
@7197 = ~«Забудь про дневник. Может, ты поможешь найти то, чего мне *на самом* деле не хватает».~
@7198 = ~«Я ничего не терял, но у меня есть пара вопросов...»~
@7199 = ~«Неважно. Прощай».~
@7200 = ~«Понятно. Сколько?»~
@7201 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@7202 = ~«Неважно. Прощай».~
@7203 = ~«Готово».~
@7204 = ~«Забудь об этом. Лучше ответь на несколько вопросов...»~
@7205 = ~«Неважно. Я сам найду то, что ищу, спасибо».~
@7206 = ~«Неважно. Я сам найду то, что ищу, спасибо».~
@7207 = ~«Неважно. Я сам найду то, что ищу, спасибо».~
@7208 = ~Идти за ней...~
@7209 = ~Кажется, это что-то вроде канавы. Однако не похоже, что ею часто пользуются.~
@7210 = ~Над дверным проемом нацарапано: «Бар 'Тлеющий труп'».~
@7211 = ~Идти за ней...~
@7212 = ~Идти за ней...~
@7213 = ~«Э-э... Тогда прощай».~
@7214 = ~«Э-э... 'мимира'?»~
@7215 = ~«Не парься насчет этого, Морт. Судя по ее виду, я скорее спасаю тебя от второй смерти».~
@7216 = ~Через эти печные трубы горячий воздух выводится из здания.~
@7217 = ~«Тогда неважно. Прощай».~
@7218 = ~«Э-э...»~
@7219 = ~«Я могу заплатить. Сколько?»~
@7220 = ~Должно быть, эти бочки здесь для собирания дождевой воды. Они наполнены одной лишь пылью.~
@7221 = ~Растения, вьющиеся по этому зданию, пожухли от излучаемого стенами жара.~
@7222 = ~Эта хлипкая платформа вот-вот развалится.~
@7223 = ~«Я могу заплатить. Сколько?»~
@7224 = ~«Я могу заплатить. Сколько?»~
@7225 = ~«Тогда неважно. Прощай».~
@7226 = ~«Справедливо. Вот десять монет».~
@7227 = ~«Неважно».~
@7228 = ~«Я запомню это. Прощай».~
@7229 = ~«Я запомню это. Прощай».~
@7230 = ~«Я запомню это. Прощай».~
@7231 = ~«Я хотел бы кое о чем узнать...»~
@7232 = ~«Можешь рассказать об этом городе?»~
@7233 = ~«Можешь рассказать о Сигиле?»~
@7234 = ~«Что-то не так?»~
@7235 = ~«И в самом деле, привет, — шкаф снова фыркает. — Так, что тут у нас? Негодяй в поисках вычурного дамского белья, хм-м?»~
@7236 = ~«Можешь рассказать о здешних интересных местах?»~
@7237 = ~«Можешь рассказать мне о фракциях?»~
@7238 = ~«Ты можешь рассказать о Леди Боли?»~
@7239 = ~«Я ищу кое-кого по имени Фарод».~
@7240 = ~«Я ищу дневник».~
@7241 = ~«На самом деле, ничего. Прощай».~
@7242 = ~«Что такое?»~
@7243 = ~«Что такое?»~
@7244 = ~«Вообще-то, у меня есть другие вопросы...»~
@7245 = ~«Неважно. Прощай».~
@7246 = ~«Неважно. Прощай».~
@7247 = ~«Неважно. Прощай».~
@7248 = ~«А где точнее находится Сигил?»~
@7249 = ~«Вообще-то, у меня есть другие вопросы...»~
@7250 = ~«Неважно. Прощай».~
@7251 = ~«Неважно. Прощай».~
@7252 = ~«Неважно. Прощай».~
@7253 = ~«А почему это 'белиберда'?»~
@7254 = ~«Вообще-то, у меня есть другие вопросы...»~
@7255 = ~«Неважно. Прощай».~
@7256 = ~«Неважно. Прощай».~
@7257 = ~«Неважно. Прощай».~
@7258 = ~«Хм-м. У меня есть другие вопросы...»~
@7259 = ~«Спасибо за информацию. Прощай».~
@7260 = ~«Спасибо за информацию. Прощай».~
@7261 = ~«Спасибо за информацию. Прощай».~
@7262 = ~«Собирают тела? Зачем?»~
@7263 = ~«Что еще интересного есть в округе?»~
@7264 = ~«Отлично... У меня есть другие вопросы...»~
@7265 = ~«Неважно. Прощай».~
@7266 = ~«Неважно. Прощай».~
@7267 = ~«Неважно. Прощай».~
@7268 = ~Тот, кто изображен на этом портрете, похож на человека лишь отдаленно.~
@7269 = ~«Что еще интересного есть в округе?»~
@7270 = ~«Отлично... У меня есть другие вопросы...»~
@7271 = ~Под платформой — густые заросли остролистника. Кажется, только они и не дают ей развалиться.~
@7272 = ~«Неважно. Прощай».~
@7273 = ~«Неважно. Прощай».~
@7274 = ~«Неважно. Прощай».~
@7275 = ~«И даже тленных?»~
@7276 = ~«Отлично... У меня есть другие вопросы...»~
@7277 = ~«Неважно. Прощай».~
@7278 = ~«Неважно. Прощай».~
@7279 = ~«Неважно. Прощай».~
@7280 = ~«Понятно... У меня есть другие вопросы...» ~
@7281 = ~«Очень доходчиво... Прощай».~
@7282 = ~«Очень доходчиво... Прощай».~
@7283 = ~«Очень доходчиво... Прощай».~
@7284 = ~«У меня есть другие вопросы...»~
@7285 = ~«Неважно. Прощай».~
@7286 = ~«Неважно. Прощай».~
@7287 = ~«Неважно. Прощай».~
@7288 = ~Перед тобой тленный с кривой улыбкой, застывшей на его лице. Несмотря на улыбку, его глаза безжизненны. Правая рука короче левой, и он покачивает ее на перевязи, будто убаюкивая малое дитя.~
@7289 = ~«Приветствую».~
@7290 = ~Оставить мужчину в покое.~
@7291 = ~Глаза тленного скользят по тебе. «Имя». Когда он произносит это слово, голос его звучит, как звон колокольчика.~
@7292 = ~«Я... не знаю».~
@7293 = ~«Э... прости, что отвлек».~
@7294 = ~«Нет имени, нет имени, ничем не помогу тебе, — нараспев произносит тленный. — Нужно имя, чтобы увидеть, где оно умерло».~
@7295 = ~«Что?»~
@7296 = ~«Получив имя при рождении, верни его назад, когда оно тебе больше не нужно. Смерть-имен, Смерть-имен». Его глаза скользят по монолиту и по стенам. «Много имен похоронено здесь Смертью-имен. Скажи мне имя, и я покажу его могилу».~
@7297 = ~«Захария».~
@7298 = ~«Дейонарра».~
@7299 = ~«Дхолл».~
@7300 = ~«Дхолл».~
@7301 = ~~
@7302 = ~~
@7303 = ~«Квентин».~
@7304 = ~«Э... Не знаю. Попробуй 'Адан'».~
@7305 = ~Он качает головой. «Еще не умерло это имя. Не похоронено здесь. Еще не время, еще не время».~
@7306 = ~«Давай попробуем другое имя...»~
@7307 = ~«Ты можешь похоронить для меня имя?»~
@7308 = ~«Хорошо... Извини, что отвлек».~
@7309 = ~Он кивает, затем вынимает маленькую руку из перевязи на боку. Она атрофирована... по размерам не больше детской. «Чтоб похоронить, нужно звенелки заплатить. Три медяка, три».~
@7310 = ~«Захария».~
@7311 = ~«Дейонарра».~
@7312 = ~«Дхолл».~
@7313 = ~«Дхолл».~
@7314 = ~~
@7315 = ~~
@7316 = ~~
@7317 = ~«Квентин».~
@7318 = ~«Хорошо. Вот тридцать монет».~
@7319 = ~«Хорошо. Вот двадцать одна монета».~
@7320 = ~«Хорошо. Вот девять монет».~
@7321 = ~«Хм-м... Мне не хватает. Но у меня еще были вопросы...»~
@7322 = ~«Хм-м... Мне не хватает. Но у меня еще были вопросы...»~
@7323 = ~«Хм-м... Мне не хватает. Но у меня еще были вопросы...»~
@7324 = ~«Тогда забудем об этом... У меня есть еще вопросы...»~
@7325 = ~«Неважно. Прощай».~
@7326 = ~«Неважно. Прощай».~
@7327 = ~«Неважно. Прощай».~
@7328 = ~«За *такую* цену я хочу знать о нем все, что тебе известно».~
@7329 = ~«Что ты можешь о нем рассказать?»~
@7330 = ~«Тогда забудем об этом... У меня есть еще вопросы...»~
@7331 = ~«Неважно. Прощай».~
@7332 = ~«Неважно. Прощай».~
@7333 = ~«Неважно. Прощай».~
@7334 = ~«Где я могу его найти?»~
@7335 = ~«Где я могу его найти?»~
@7336 = ~«Забудь о Фароде... У меня есть другие вопросы...»~
@7337 = ~«Неважно. Прощай».~
@7338 = ~«Неважно. Прощай».~
@7339 = ~«Неважно. Прощай».~
@7340 = ~«Площади Старьевщиков?»~
@7341 = ~«Понятно... У меня есть другие вопросы...» ~
@7342 = ~«Спасибо за информацию. Прощай».~
@7343 = ~«Спасибо за информацию. Прощай».~
@7344 = ~«Спасибо за информацию. Прощай».~
@7345 = ~«Кто такие сборщики?»~
@7346 = ~«Понятно... У меня есть другие вопросы...» ~
@7347 = ~«Спасибо за информацию. Прощай».~
@7348 = ~«Спасибо за информацию. Прощай».~
@7349 = ~«Спасибо за информацию. Прощай».~
@7350 = ~Медяки падают в руку Смерти-Имен, и он прячет ее назад. Его глаза, закатившись, неожиданно оживают и взметаются в поисках места на монолите и стенах мемориала.~
@7351 = ~Подождать...~
@7352 = ~Он находит на стене место, быстро подходит к нему и наклоняется, затем принимается высекать что-то на стене. Спустя несколько минут он завершает работу, поднимается и возвращается к тебе. «Похоронено». Последнее слово заставляет тебя почувствовать себя неуютно.~
@7353 = ~«Я хотел бы, чтобы ты поискал для меня имя...»~
@7354 = ~«Я хотел бы похоронить другое имя».~
@7355 = ~«Спасибо. Прощай».~
@7356 = ~Перед тобой Смерть-имен. Он стоит перед монументом с искривленной улыбкой, а его рука висит на перевязи.~
@7357 = ~«Приветствую».~
@7358 = ~Оставить его в покое.~
@7359 = ~И снова глаза тленного глядят на тебя. «Имя». Когда он произносит это слово, голос его звучит, как звон колокольчика.~
@7360 = ~«Я... не знаю».~
@7361 = ~«Я хотел бы похоронить имя».~
@7362 = ~«Захария».~
@7363 = ~«Дейонарра».~
@7364 = ~«Дхолл».~
@7365 = ~«Дхолл».~
@7366 = ~«Сиси».~
@7367 = ~«Сиси».~
@7368 = ~«Квентин».~
@7369 = ~Он закатывает глаза. Дико поблескивая, его взгляд пробегается по стенам монумента, с нечеловеческой скоростью просматривая имена. Затем он указывает на одну из стен. «Похоронено».~
@7370 = ~Осмотреть то место, куда он указывает.~
@7371 = ~«У меня есть другое имя...»~
@7372 = ~«Я хотел бы похоронить имя».~
@7373 = ~«Просто проверяю. Прощай».~
@7374 = ~Это то самое имя, которое ты запросил. Оно выбито на черном камне тонкой вязью, и практически теряется в море имен, окружающих его.~
@7375 = ~«У меня есть другое имя...»~
@7376 = ~«Я хотел бы похоронить имя...»~
@7377 = ~«Просто проверяю. Прощай».~
@7378 = ~Он качает головой. «Похоронено». ~
@7379 = ~«Я ищу развлечений».~
@7380 = ~«У меня есть другое имя...»~
@7381 = ~«Я ищу работу».~
@7382 = ~«Я хотел бы похоронить имя...»~
@7383 = ~«Просто проверяю. Прощай».~
@7384 = ~Он закатывает глаза. Дико поблескивая, его взгляд пробегается по стенам монумента, с нечеловеческой скоростью просматривая имена. Затем он указывает на одну из стен. «Похоронено».~
@7385 = ~«Неважно. Прощай».~
@7386 = ~Осмотреть то место, куда он указывает.~
@7387 = ~«У меня есть другое имя...»~
@7388 = ~«Я хотел бы похоронить имя».~
@7389 = ~«Неважно. Прощай».~
@7390 = ~«Просто проверяю. Прощай».~
@7391 = ~Имя Квентина, высеченное на черном камне слегка неровным почерком. К несчастью для Квентина, его имя не разломило монумент пополам, так и не оправдав его надежд.~
@7392 = ~«У меня есть другое имя...»~
@7393 = ~«Неважно. Прощай».~
@7394 = ~«Я хотел бы похоронить имя...»~
@7395 = ~«Понятно... У меня есть другие вопросы...» ~
@7396 = ~«Спасибо за информацию. Прощай».~
@7397 = ~«Спасибо за информацию. Прощай».~
@7398 = ~«Спасибо за информацию. Прощай».~
@7399 = ~«Понятно... У меня есть другие вопросы...» ~
@7400 = ~«Спасибо за информацию. Прощай».~
@7401 = ~«Спасибо за информацию. Прощай».~
@7402 = ~«Спасибо за информацию. Прощай».~
@7403 = ~«Просто проверяю. Прощай».~
@7404 = ~Медяки падают в руку Смерти-Имен, и он прячет ее назад. Его глаза, закатившись, неожиданно оживают и взметаются в поисках места на монолите и стенах мемориала.~
@7405 = ~Подождать...~
@7406 = ~Он поворачивается к основанию монолита, быстро подбегает к нему, наклоняется и начинает что-то на нем высекать. К несчастью для Квентина, монумент не разломился после его имени. Мгновение спустя Смерть-имен завершает работу, поднимается и возвращается к тебе. «Похоронено». Последнее слово заставляет тебя почувствовать себя неуютно.~
@7407 = ~«Я хотел бы, чтобы ты поискал для меня имя...»~
@7408 = ~«Я хотел бы похоронить другое имя».~
@7409 = ~«Спасибо. Прощай».~
@7410 = ~Перед тобой мужчина средних лет. Он достаточно крепок, с толстой бычьей шеей, но его плечи ссутулены, как будто на них давит огромный вес. Он в нетерпении смотрит на черный монолит, стоящий перед ним.~
@7411 = ~«Приветствую».~
@7412 = ~Оставить мужчину в покое.~
@7413 = ~Мужчина бросает на тебя взгляд. «Тут полно места, рубака. Не нужно спрашивать моего разрешения, чтобы остаться здесь».~
@7414 = ~«На самом деле, я хотел узнать, что из себя представляет монолит».~
@7415 = ~«Хорошо, прошу прощения, что побеспокоил».~
@7416 = ~«Это надгробие планов, — он ухмыляется. — Целые кладбища имен нацарапаны на этом камне. Надеюсь, что мое имя расколет этот камень надвое, — он указывает на основание монолита. — 'Квентин', его выбьют прямо здесь, и его хватит для того, чтобы эта проклятая вещь свалилась на землю».~
@7417 = ~«Надгробие планов?»~
@7418 = ~«Понятно. Прощай».~
@7419 = ~«Ага, — Квентин грустно улыбается. — Трухлявые высекают имена мертвых на этом монументе... — он обводит жестом вокруг. — И на этих стенах. Места недостаточно, как видишь, но это неважно... они делают, что могут. Половину имен вообще не разобрать».~
@7420 = ~«Что ты здесь делаешь?»~
@7421 = ~«Понятно. Прощай».~
@7422 = ~«Читаю новые имена. Нахожу их каждый день, пытаюсь вспомнить, знал ли я их, вот и все».~
@7423 = ~«Тленные записывают имена всех тех, кто умер, на этот монумент?»~
@7424 = ~«Понятно. Прощай».~
@7425 = ~«Ага, они выбивают их на этом камне... и на стенах тоже, — Квентин ухмыляется. — Не понимаю, почему они возятся со всем этим подсчетом мертвых... Трухлявых ведь больше беспокоят живые».~
@7426 = ~«Живые?»~
@7427 = ~«Живые?»~
@7428 = ~«Понятно. Прощай».~
@7429 = ~«Ага... видел тех тленных плакальщиков, которые приходят сюда? Они ведь не мертвых оплакивают, они оплакивают живых. Ты от них и слова не дождешься, если только не попросишь их оплакать какого-нибудь несчастного *живого* пня».~
@7430 = ~«А почему они оплакивают живых?»~
@7431 = ~«Понятно. Прощай».~
@7432 = ~«Хороший вопрос, рубака, — он пожимает плечами. — Спроси-ка лучше у них. По мне, так причин жалеть мертвых в три раза больше, чем любого бедолагу, живущего в этой яме, — он кивает на монумент. — Каждое имя на нем благословлено в моей книге».~
@7433 = ~«А ты не слышал о ком-нибудь, кто вернулся назад после того, как его имя было высечено здесь?»~
@7434 = ~«Что ты можешь сказать об этом сумасшедшем тленном с другой стороны монолита?»~
@7435 = ~«Понятно. Спасибо за разговор. Прощай».~
@7436 = ~Ты видишь Квентина. Он все еще изучает камень, как будто пытаясь взглядом свалить его.~
@7437 = ~«Приветствую тебя, Квентин».~
@7438 = ~Оставить его в покое.~
@7439 = ~«А?» Квентин поворачивается к тебе, а затем кивает. «А, приятно встретиться снова, рубака. Пришел занять местечко на камне для своего имени?»~
@7440 = ~«Пока нет. У меня есть вопросы к тебе...»~
@7441 = ~«Нет, просто проходил мимо. Прощай, Квентин».~
@7442 = ~Квентин глупо улыбается. «Не самая здравомыслящая птичка в этом курятнике, правда? Этого полоумного зовут Смерть-имен, — Квентин ухмыляется. — Хотя 'Смерть-ума' ему подошло бы куда больше». ~
@7443 = ~«А что он делает здесь?»~
@7444 = ~«Понятно. Спасибо».~
@7445 = ~«Он хранитель этого мемориала. Знает, где написано каждое из имен, и, если нужно, может указать, где оно. Конечно, он немного тронутый, но пару раз он мне помогал, — он пожимает плечами. — А еще он высекает новые имена, когда их владельцы покидают этот мир».~
@7446 = ~«У меня есть другие вопросы к тебе...»~
@7447 = ~«Понятно. Спасибо».~
@7448 = ~«Ты имеешь в виду, возвращаются из смерти? — Квентин мотает головой. — Ни одного, рубака. Любой живущий умирает — такова природа вещей, — он пожимает плечами. — По крайней мере, на планах всегда так было, но можно предположить, что возможно и такое».~
@7449 = ~«Пожалуй, это так. Слушай, у меня есть к тебе другие вопросы...»~
@7450 = ~«Понятно. Спасибо».~
@7451 = ~«От вопросов нет вреда, рубака».~
@7452 = ~«Можешь еще раз сказать, что это за монумент?»~
@7453 = ~«Что ты здесь делаешь?»~
@7454 = ~«А ты не слышал о ком-нибудь, кто вернулся назад после того, как его имя было высечено здесь?»~
@7455 = ~«Что ты можешь сказать об этом сумасшедшем тленном с другой стороны монолита?»~
@7456 = ~«Понятно. Спасибо».~
@7457 = ~«Отлично... У меня есть другие вопросы...»~
@7458 = ~«Неважно. Прощай».~
@7459 = ~«Неважно. Прощай».~
@7460 = ~«Неважно. Прощай».~
@7461 = ~«У меня есть вопросы к тебе. То есть... дай только собраться».~
@7462 = ~«Спасибо. Прощай».~
@7463 = ~«Спасибо. Прощай».~
@7464 = ~«Спасибо. Прощай».~
@7465 = ~«Справедливо. Вот семь монет».~
@7466 = ~«Неважно».~
@7467 = ~«Справедливо. Вот три монеты».~
@7468 = ~«Неважно».~
@7469 = ~«Эй! Успокойся, Анна...»~
@7470 = ~«Убери свои чертовы клинки!»~
@7471 = ~Посмотреть, чем это закончится.~
@7472 = ~«'Подровняешь мне корешок'? А за это надо платить?»~
@7473 = ~«Прекрати угрожать женщине, или я подровняю *твой* хвост, ясно?»~
@7474 = ~«Твоего мнения я не спрашивал, Анна».~
@7475 = ~«Ладно, ладно... Успокойся».~
@7476 = ~«*Не угрожай* мне, Анна. У тебя-то всего одна жизнь, улавливаешь?»~
@7477 = ~«Твоего мнения я не спрашивал, Анна».~
@7478 = ~«Ну хорошо, хорошо... просто успокойся. Твоя бесовская кровь вот-вот закипит».~
@7479 = ~Амулет из черепной крысы~
@7480 = ~«Ха. Неплохо сработано».~
@7481 = ~«Успокойся, Анна...»~
@7482 = ~Пойти за проституткой...~
@7483 = ~«Понятно. Ладно, не парься насчет этого, Морт. Если поглядеть на нее, то я скорее спасаю тебя от второй смерти».~
@7484 = ~«Просто уходим отсюда. Прощай, красавица».~
@7485 = ~Уйти.~
@7486 = ~«С тобой все в порядке?»~
@7487 = ~«Прощай».~
@7488 = ~«Прощай».~
@7489 = ~«Прощай».~
@7490 = ~«Прощай».~
@7491 = ~«А ты предлагаешь?»~
@7492 = ~«Ага, ну да ладно. Слушай, возможно, ты можешь мне помочь. У меня есть вопросы...»~
@7493 = ~«Прощай».~
@7494 = ~«Прощай».~
@7495 = ~«Прощай».~
@7496 = ~«Прощай».~
@7497 = ~«Нет, спасибо. Однако у меня есть вопросы...»~
