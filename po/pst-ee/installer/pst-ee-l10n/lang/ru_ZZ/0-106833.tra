@34055 = ~~
@34056 = ~~
@34057 = ~~
@34058 = ~~
@34059 = ~~
@34060 = ~~
@34061 = ~~
@34062 = ~~
@34063 = ~~
@34064 = ~~
@34065 = ~~
@34066 = ~~
@34067 = ~~
@34068 = ~~
@34069 = ~~
@34070 = ~~
@34071 = ~~
@34072 = ~~
@34073 = ~~
@34074 = ~~
@34075 = ~~
@34076 = ~~
@34077 = ~~
@34078 = ~~
@34079 = ~~
@34080 = ~~
@34081 = ~Чувство великих потерь, как темный капюшон, покрывает эту старушку. Взглянув на нее, ты слышишь долгий горестный вздох, вылетевший из ее губ.~
@34082 = ~«Приветствую...»~
@34083 = ~Оставить женщину в покое.~
@34084 = ~Она смотрит на твое лицо, косящие мрачные глаза уставились на тебя ясным взглядом. «Прости меня, молодой рубака, но я уже пожилая женщина и не очень хорошо вижу... я тебя знаю?»~
@34085 = ~«Нет».~
@34086 = ~«Может быть, но я не знаю».~
@34087 = ~«Один раз наши пути пересеклись, вот и все».~
@34088 = ~Твой ответ немного напугал ее. «И что тогда тебе надо?»~
@34089 = ~«У меня есть несколько вопросов...» ~
@34090 = ~«Ничего. Прощай».~
@34091 = ~«Вопросы?» Она застывает в ужасе. «О нет... ты ведь 'приключенец', не так ли? Имя, работа и прочее гнилье, да? Нафига мне это надо? Пошел прочь!»~
@34092 = ~«Я не приключенец».~
@34093 = ~«Нет, я не... на самом деле, по крайней мере...»~
@34094 = ~«Тогда прощай». ~
@34095 = ~«Задвинься!» Женщина тычет в тебя пальцем. «Я следила за тленными, когда те записали имя моего мужа, проклятая его душонка, моих сына и обеих дочек, 'прилюченцы' до мозга костей, теперь все они в Мемориале! Когда-то я *тоже* неплохо махала мечом, так что я знаю, как они выглядят!» Кажется, женщина приходит в форму; ее щеки зарумянились, она прямо-таки брызжет слюной, крича на тебя.~
@34096 = ~Слушать ее тираду дальше.~
@34097 = ~Уйти.~
@34098 = ~«Могу поспорить, что у тебя припасено *куча*» всяких тупых вопросов!» Она пародирует твою героическую позу: «Привет, у меня есть вопросы к тебе... ты не можешь рассказать об этом месте? Кто такая Леди Боли? Я ищу магический Железный Пояс Хвастуна, не видел такого? Не знаешь, где может находиться портал на 2817-й План Бездны? Не знаешь, где Святой Увечащий и Возвращающийся Огненный Разящий Холодом Гронков Молот, Стреляющий-Молниями-Из-Твоей-Задницы?» Она сплевывает. «Довольно этого дерьма! Чтоб ты в книге мертвых оказался! Я должна пнуть тебя в зад уже только за то, что ты осмелился спросить бедную женщину об этом всем! А теперь проваливай и оставь меня в покое!»~
@34099 = ~Уйти.~
@34100 = ~Как только женщина смотрит на тебя, ее выражение лица становится кислым. «Нет, нет, нет! Только не ты опять! Я не хочу с тобой разговаривать, так что исчезни! *ИСЧЕЗНИ*!»~
@34101 = ~Уйти.~
@34102 = ~Эта тяжелая дверь не только заперта, но и забаррикадирована. Здесь тебе не пройти.~
@34103 = ~Ты находишься слишком далеко, чтобы разглядеть это.~
@34104 = ~В этих рунах слышен гул мистической силы.~
@34105 = ~Выхлопы горячего зловония периодически выходят из горловины этой огромной трубы. Тяжелая железная решетка преграждает путь к ее краю.~
@34106 = ~Похоже, этот человек умер от какой-то кошмарной изнурительной болезни.~
@34107 = ~Когда ты входишь в комнату, крупный, крепко сложенный человек встает со стула и подходит к тебе. «ДАРОВА! Меня звать Биш. А ты кем будешь?»~
@34108 = ~«Что значит: у тебя нет имени? Что, в Стиксе купался, бедняжка бестолковая?! — ты замечаешь, как рука Биша медленно тянется к оружию. — Или просто не хочешь его говорить? Кажись, ты что-то там скрываешь».~
@34109 = ~«Ад-чего? — Биш бросает на тебя безучастный взгляд, затем бешено трясет головой. — Я тебя раньше не видел, и Фарод не говорил ни про каких Аданов на подходе, — ты замечаешь, как рука Биша медленно тянется к оружию. — Тебе лучше сказать мне, какое у тебя дело, пень».~
@34110 = ~Внезапно Биш выхватывает свое оружие. «Отлично. Раз не хочешь говорить со мной прямо, я это из тебя выбью».~
@34111 = ~Как только ты разворачиваешься, чтобы уйти, Биш преграждает тебе путь. «Я спрошу тебя еще раз, пень: как тебя ЗОВУТ?!»~
@34112 = ~«Если бы Фарод хотел тебя видеть, я бы об этом знал, — внезапно Биш выхватывает оружие. — Я устал играть с тобой в загадки, пень. Лучше поищу ответы на твоем трупе».~
@34113 = ~«Говоришь, был здесь раньше? Дневник не дневник, а тебя я раньше не видел. Сдается мне, ты тут что-то вынюхиваешь прямо у меня под носом, — внезапно Биш выхватывает оружие. — Надеюсь, дело было стоящее, пень».~
@34114 = ~Биш вскидывает руки над головой от негодования. «Забудь, пень! Это вообще неважно, — он качает головой взад-вперед. — Вот что важно, так это что ты здесь делаешь?»~
@34115 = ~Биш смотрит на тебя угрюмо. «Ладно, можешь идти». Когда ты проходишь мимо него, он наклоняется и тихо произносит: «Запомни вот что, пень: если будешь создавать здесь неприятности, я разнесу тебе череп, как только увижу».~
@34116 = ~Биш качает головой. «Мы все чего-то хотим, рубака, — он начинает хохотать. — Я тебя не знаю, и ты мне не нравишься, так что предлагаю сделку: твои деньги или твоя голова».~
@34117 = ~«Да ты еще большая бестолочь, чем я думал, рубака! — Биш пожимает плечами. — Ладно, заморыш, посмотрим, что ты из себя представляешь!»~
@34118 = ~Биш ворчит: «Ты похож на четкого рубаку — ни дать, ни взять, — он кивает тебе, перед тем как достать оружие. — Но отсюда ты уже не выберешься».~
@34119 = ~Биш проводит тщательный обыск твоего имущества. «Все равно стоило бы оставить себе твою голову — она у тебя, похоже, самая ценная! А теперь пошевелись. И предупреждаю: если будешь создавать здесь проблемы — догоню и добью!»  ~
@34120 = ~Ты видишь Биша, подходящего к своему посту. Когда ты подходишь, он смотрит в твою сторону и кивает. «Дарова. Иди куда шел, и быстро».~
@34121 = ~Биш перетряхивает твои пожитки на предмет мелочи... но ничего не находит. «Ты что, спецом тратишь мое время, или думаешь, твое тряпье чего-то стоит? — Биш начинает размахивать оружием. — Все сходится к тому, что придется продать твое тело!»~
@34122 = ~Биш подскакивает, чтобы встретить тебя с оружием в руках! «Что я тебе говорил, пень? Пошумел там внизу — теперь получишь по черепу!»~
@34123 = ~«У меня нет имени».~
@34124 = ~Ложь: «Меня зовут Адан» .~
@34125 = ~«Не твое дело».~
@34126 = ~Не обращать на него внимания и продолжить идти.~
@34127 = ~«Послушай, я говорю тебе правду. Я не знаю своего имени».~
@34128 = ~«Мне нечего скрывать, и я не хочу нарываться на неприятности. Я просто хочу пройти».~
@34129 = ~Ложь: «Ладно-ладно... меня зовут Адан».~
@34130 = ~«Я всего лишь хочу пройти».~
@34131 = ~«Если ты сейчас же не отойдешь — хлопот не оберешься».~
@34132 = ~«Если ты сейчас же не отойдешь — хлопот не оберешься».~
@34133 = ~«Я разыскиваю мужчину по имени Фарод».~
@34134 = ~«Я ищу дневник».~
@34135 = ~«Мне сказали, что где-то здесь я могу найти Фарода».~
@34136 = ~«Не твое дело».~
@34137 = ~Напасть на Биша.~
@34138 = ~«Я разыскиваю мужчину по имени Фарод».~
@34139 = ~«Я ищу дневник».~
@34140 = ~«Не твое дело».~
@34141 = ~«Мне нечего скрывать, и я не хочу нарываться на неприятности. Я просто хочу пройти».~
@34142 = ~«Я всего лишь хочу пройти».~
@34143 = ~«Если ты сейчас же не отойдешь — хлопот не оберешься».~
@34144 = ~«Если ты сейчас же не отойдешь — хлопот не оберешься».~
@34145 = ~Напасть на Биша.~
@34146 = ~Не обращать внимания на Биша, пройти мимо.~
@34147 = ~«Только попробуй...»~
@34148 = ~«Я не знаю своего имени».~
@34149 = ~Ложь: «Меня зовут Адан» .~
@34150 = ~«Не твое дело!»~
@34151 = ~Напасть на Биша.~
@34152 = ~Продолжать игнорировать Биша, попытаться обойти его.~
@34153 = ~«Я так не думаю...»~
@34154 = ~«Как знаешь..»~
@34155 = ~«Я разыскиваю мужчину по имени Фарод».~
@34156 = ~«Я ищу дневник».~
@34157 = ~«Не твое дело».~
@34158 = ~«Я не хочу нарываться на неприятности. Я просто хочу пройти».~
@34159 = ~«Я всего лишь хочу пройти».~
@34160 = ~«Если ты сейчас же не отойдешь — хлопот не оберешься».~
@34161 = ~«Если ты сейчас же не отойдешь — хлопот не оберешься».~
@34162 = ~Напасть на Биша.~
@34163 = ~Не обращать внимания на Биша, пройти мимо.~
@34164 = ~«Прощай...»~
@34165 = ~«Я буду делать то, что захочу...»~
@34166 = ~«Тогда деньги».~
@34167 = ~«Тогда деньги».~
@34168 = ~«Ты ничего не получишь!»~
@34169 = ~«Я тебе покажу бестолочь...»~
@34170 = ~«Позволю себе не согласиться...»~
@34171 = ~«Я пошел».~
@34172 = ~«Ублюдок...»~
@34173 = ~«Хорошо».~
@34174 = ~«Попробуй...»~
@34175 = ~«Как знаешь..»~
@34176 = ~Эта мутная вода цвета ржавчины холодна как лед.~
@34177 = ~Похоже, это головка массивного сверлильного устройства, которое погрузилось в камень и сломало свою ось.~
@34178 = ~Ты не можешь точно определить, что это за механизмы, но, скорее всего, они предназначены для горных работ или сверления камня.~
@34179 = ~[no text]~
@34180 = ~[no text]~
@34181 = ~[no text]~
@34182 = ~[no text]~
@34183 = ~[no text]~
@34184 = ~Покои Ненни~
@34185 = ~Покои Джульетты~
@34186 = ~Наверх в бордель~
@34187 = ~Сотни кусочков прозрачного зеленого стекла, из которых состоит это витражное окно, как будто ничем не скреплены, и скорее свободно висят в воздухе, чудесным образом удерживаемые в железной раме. Осколки медленно колышутся и создают замысловатые узоры за окном, на все лады преломляя освещение галереи в разных направлениях. Небольшая табличка возле окна гласит: «Аркадийские витражи».~
@34188 = ~Это массивный рог из кованого свинца, обвитый медными цепями. Он ужасно покорежен, будто его раздавила какая-то чудовищная сила. По всей его длине торчат зазубренные лезвия, как будто он служил какому-то гигантскому существу не только боевым рогом, но и дубиной. Табличка, прикрепленная под рогом, гласит: «Очищающий рог Ахерона».~
@34189 = ~Попробовать самое очевидное и попытаться дунуть в рог.~
@34190 = ~На этом пьедестале установлена сверкающая рубиновая статуэтка, вырезанная в виде крылатого человекообразного существа. Фигурка по своей сути то ли демоническая, то ли ангельская... но какая именно, сказать трудно — она странным образом преломляет освещение галереи. И нет таблички, указывающей, чем именно является статуэтка.~
@34191 = ~Этот прозрачный камень, хранящийся в петле из гравированных серебряных лент, пульсирует ярким внутренним светом. У его основания выгравировано «ИВ».~
@34192 = ~Это окровавленная живая железная цепь, сматывающаяся и разматывающаяся сама по себе. Цепь изгибается и скручивается, словно хребет змеи. На маленькой табличке написано: «Живая цепь китона из Звенящего Хайтера».~
@34193 = ~Эта картина, абстрактная работа в зеленых и пурпурных тонах, скручивается и рябит перед глазами. Если присмотреться повнимательнее, оказывается, что меняется скорее не само полотно, а рисунок на нем. Табличка гласит: «Минутный взгляд со стен Моччмы».~
@34194 = ~Этот янтарный камень, хранящийся в петле из гравированных серебряных лент, пульсирует мягким желтым светом. У его основания выгравировано «КИМАСКСИ ЗМЕЕЯЗЫКАЯ».~
@34195 = ~Этот красно-оранжевый камень, хранящийся в петле из гравированных серебряных лент, пульсирует теплым оранжевым светом. У его основания выгравировано «ДОЛОРА».~
@34196 = ~Поверхность этой картины... дикий коллаж ярких цветов... непрерывно рябит, словно поверхность пруда во время мелкого дождя. Табличка гласит «Эскиз движения волн #7».~
@34197 = ~Этот полупрозрачный голубовато-белый камень, хранящийся в петле из гравированных серебряных лент, пульсирует мягким голубым светом. У его основания выгравировано «КЕСАЙ-СЕРРИ».~
@34198 = ~Набор из четырех картин, изображающих пустынный морской берег поздней ночью. Воздух вокруг картин слегка отдает солью, а нарисованное море, казалось бы, хлещет о темный берег. Табличка гласит: «Побережье Карасуфры».~
@34199 = ~Этот фиолетовый камень, хранящийся в петле из гравированных серебряных лент, пульсирует густым фиолетовым светом. У его основания выгравировано «МАРИССА».~
@34200 = ~На этой картине — высокие черные скалы на фоне кроваво-красного неба. Кажется, будто среди утесов прячутся какие-то фигуры, но когда ты прищуриваешься и пытаешься разглядеть их, они исчезают. Табличка гласит: «Мародеры Внешних Земель».~
@34201 = ~На этой картине показано нечто похожее на бесконечно длинный поток ядовито-зеленых газов, простирающийся в темноте. В правом нижнем углу можно увидеть горизонт разрушенной каменистой равнины... создается впечатление, что «голова» зеленого облака поднялась, чтобы обрушиться на нее. Надпись гласит: «Хазазот, пожирающий Нгара».~
@34202 = ~Эта картина изображает морской пейзаж с огромным красно-оранжевым солнцем, садящимся за полуостров или большую пристань. Пейзаж, даже будучи неоригинальным, захватывает дыхание: игра угасающего дневного света на воде передана идеально. Однако, если смотреть на нарисованное солнце даже непродолжительное время, твои глаза начинают болеть. Табличка гласит «Поверхность Таласии».~
@34203 = ~На этой картине изображена громадная гранитная цитадель — уродливая штуковина, продолговатая и низкая, покрытая гаргульями со злобными взглядами. Она висит среди чего-то, похожего на ночное небо. На заднем плане вдоль правой стороны клубится облако малиновых и фиолетовых испарений. Надпись на табличке незамысловатая — «Библиотека».~
@34204 = ~На этой картине — мрачный городской пейзаж, панорама какого-то гигантского центра цивилизации, сожженного дотла. Тем не менее, улицы этого места пусты: нет ни солдат, ни беженцев, ни даже трупов. Табличка гласит: «Глупость Удо».~
@34205 = ~Похоже, это подземный пейзаж... внутреннее пространство огромной пещеры, покрытой гигантской разноцветной плесенью, слегка светящейся в темноте. Табличка гласит: «Долина под Клангеддином».~
@34206 = ~Это портрет гротескной крючконосой старухи. Кожа у нее нездорового голубовато-серого цвета. Ее глаза светятся красным, как угольки угасающего пламени. Ее подбородок, длинный и острый, выступает вперед в неправильном прикусе. Два желтых клыка торчат из ее нижней челюсти, словно небольшие бивни. Улыбка на ее сморщенных багровых губах говорит о страшном секрете. Табличка гласит: «Серая ведьма Ойноса».~
@34207 = ~Этот фиолетовый камень, хранящийся в петле из гравированных серебряных лент, пульсирует мягким лиловым светом. У его основания выгравировано «ВИВЬЕН».~
@34208 = ~Этот полупрозрачный зеленый камень, хранящийся в петле из гравированных серебряных лент, пульсирует ярким зеленым светом. У его основания выгравировано «ЭККО».~
@34209 = ~Этот сверкающий красный камень, хранящийся в петле из гравированных серебряных лент, пульсирует ярким малиновым светом. У его основания выгравировано «НЕННИ».~
@34210 = ~Этот полупрозрачный камень цвета индиго, хранящийся в петле из гравированных серебряных лент, пульсирует темно-синим светом. У его основания выгравировано «ДЖУЛЬЕТТА».~
@34211 = ~Этот серовато-белый камень, хранящийся в петле из гравированных серебряных лент, пульсирует светом. Что-то было выгравировано у его основания, но надпись стерли.~
@34212 = ~«Я камень переживаний #1 из публичного сенсориума Городского Фестхолла».~
@34213 = ~«Я камень переживаний #2 из публичного сенсориума Городского Фестхолла».~
@34214 = ~Это необычный фиолетовый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34215 = ~Это необычный желто-зеленый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34216 = ~Это необычный красно-оранжевый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34217 = ~Это необычный фиолетовый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34218 = ~Это необычный светло-голубой камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34219 = ~Это необычный красно-оранжевый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34220 = ~Это необычный фиолетовый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34221 = ~Это необычный фиолетовый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@34222 = ~Достать банку с бальзамирующей жидкостью и иголку для Эи-Вейн.~
@34223 = ~Странная женщина с когтями на руках и бледной кожей из бальзамационной комнаты Морга на втором этаже ошибочно приняла меня за зомби и попросила меня принести ей бальзамирующую жидкость и иголку с ниткой. Они должны быть где-то в Морге.~
@34224 = ~Странная женщина с когтями на руках и бледной кожей из бальзамационной комнаты Морга на втором этаже ошибочно приняла меня за зомби и попросила меня принести ей бальзамирующую жидкость и иголку с ниткой. Это потребовало немного времени, но я все-таки сумел найти их и принести ей.~
@34225 = ~Достать ключ от бальзамационной для Ваксиса.~
@34226 = ~Я встретил замаскированного под зомби шпиона в восточной комнате Морга, к югу от бальзамационной. Он попросил меня принести ему ключ от бальзамационной. В обмен он поможет, как он сказал, выбраться отсюда.~
@34227 = ~Я встретил замаскированного под зомби шпиона в восточной комнате Морга, к югу от бальзамационной. Он попросил меня принести ему ключ от бальзамационной. В обмен он поможет, как он сказал, выбраться отсюда. Я получил ключ у Эи-Вейн и дал его Ваксису.~
@34228 = ~Избавить Димтри от пребывания в виде зомби.~
@34229 = ~Зомби Димтри хочет избавиться от своего состояния, чтобы он смог упокоиться с миром. Мне нужно найти его создателя, Себастиона, и попросить его сделать это.~
@34230 = ~Я научился у Себастиона подходящему заклинанию, чтобы освободить Димтри, который, наконец, обрел покой.~
@34231 = ~Забрать со склада подушку для гроба.~
@34232 = ~Мне нужно забрать со склада подушку для гроба. Возможно, там мне сперва нужно будет с чем-то разобраться.~
@34233 = ~Я успешно разобрался с проблемами на складе и теперь у меня есть подушка для гроба.~
@34234 = ~Забрать со склада планы гробницы.~
@34235 = ~Макс. ЗД:~
@34236 = ~Сила: ~
@34237 = ~Интеллект:~
@34238 = ~Мудрость:~
@34239 = ~Ловкость:~
@34240 = ~Телосложение:~
@34241 = ~Обаяние:~
@34242 = ~Класс брони:~
@34243 = ~Изменилось мировоззрение [Morte]~
@34244 = ~Анце дарит тебе свою неизменную беззубую усмешку. «И снова добро пожаловать, рубака. Чего надобно сегодня?»~
@34245 = ~«Хотелось бы глянуть на твои товары».~
@34246 = ~«У меня есть несколько вопросов...» ~
@34247 = ~«Ничего. Прощай».~
@34248 = ~«Я грущу по своему пацану, по Лазло. Магазин не открою до... не знаю когда...»~
@34249 = ~Уйти.~
@34250 = ~У тебя Ловкость неуклюжего болвана. Ты получаешь штраф в -%d к Классу Брони.~
@34251 = ~Твоя Ловкость демонстрирует твои плохие рефлексы. Ты получаешь штраф -%d к Классу Брони.~
@34252 = ~Из-за низкой Ловкости ты получаешь штраф -%d к своему Классу Брони.~
@34253 = ~За свое ущербное Телосложение ты расплачиваешься штрафом в -%d очков жизни на каждый уровень.~
@34254 = ~За свое слабое Телосложение ты расплачиваешься штрафом в -%d очков жизни на каждый уровень.~
@34255 = ~Твой Интеллект выдает в тебе слюнтяя-идиота.~
@34256 = ~Твой Интеллект намного ниже среднего.~
@34257 = ~Твой Интеллект ниже среднего.~
@34258 = ~Твоя Мудрость выдает в тебе одного из глупейших людей.~
@34259 = ~Твоя Мудрость намного ниже средней.~
@34260 = ~Твоя Мудрость ниже средней.~
@34261 = ~Твое Телосложение ниже среднего.~
@34262 = ~Твое Обаяние отвратительно.~
@34263 = ~Твое Обаяние намного ниже среднего.~
@34264 = ~Перед тобой крупный шумный торговец. Он кажется совершенно безволосым, а его бледно-желтая кожа покрыта рубцами от ожогов. Он пристально наблюдает за твоим приближением.~
@34265 = ~«Приветствую».~
@34266 = ~Не обращать внимания на мужчину.~
@34267 = ~Он улыбается тебе. «Здравствуй, я Уголек. Слыхал о тебе. Ты тот пустоголовый чувак в шрамах, что бродит по районам и задает вопросы. Чем могу подсобить?»~
@34268 = ~«У меня есть несколько вопросов...» ~
@34269 = ~«Похоже, у тебя самого есть парочка шрамов».~
@34270 = ~«Ничего, прощай».~
@34271 = ~«Буду рад ответить на твои вопросы... — он прищуривается и выдает лукавую улыбку. — То есть, насчет лавки и товаров перед тобой. Я тебе не осведомитель какой-то».~
@34272 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@34273 = ~«У меня украли череп. Ты не знаешь, кто бы мог это сделать?»~
@34274 = ~«Я хочу купить оружие».~
@34275 = ~«Я хочу купить магические вещи».~
@34276 = ~«Меня интересуют заклинания».~
@34277 = ~«Что это за место?»~
@34278 = ~«Я должен идти. Прощай».~
@34279 = ~Он хмурится в раздумьях. «Лотар... Повелитель... не, чего-то не припомню».~
@34280 = ~«Понятно. У меня есть еще вопросы...»~
@34281 = ~«Спасибо, прощай».~
@34282 = ~Он хмурится. «Череп? Ты сказал... череп?»~
@34283 = ~«Да, череп».~
@34284 = ~«Нет, я пошутил».~
@34285 = ~«Неважно. Прощай».~
@34286 = ~Он смотрит на тебя озадаченно. «Не пойму, на кой тебе вообще понадобился череп, не говоря уже о том, чтобы какой-нибудь пень его прикарманил».~
@34287 = ~«Понятно. У меня есть еще вопросы...»~
@34288 = ~«Спасибо, прощай».~
@34289 = ~Он смотрит на тебя раздраженно. «Походу, мы тут разными делами занимаемся, рубака. Приходи, как будет какое-нить серьезное дельце ко мне».~
@34290 = ~«У меня к тебе еще несколько вопросов...»~
@34291 = ~«Я должен идти. Прощай».~
@34292 = ~Он выглядит рассерженным. «Мне не до твоих вопросов. Хочешь чего-нить *купить*? Мне не так много осталось, чтоб торчать здесь и отвечать на твои вопросы. Если нужно потрепаться, иди к тому ленивому сопляку Лазло. Он тебе хоть бублик вокруг Великих Колец наговорит, если будет такой шанс».~
@34293 = ~«Лазло?»~
@34294 = ~«Спасибо, прощай».~
@34295 = ~Он кивает. «Обычно он смотрит за печкой».~
@34296 = ~«Спасибо, прощай».~
@34297 = ~Он указывает на другой конец рынка. «Тогда тебе к Анце. Его место — возле печки».~
@34298 = ~«У меня есть другие вопросы...»~
@34299 = ~«Спасибо, прощай».~
@34300 = ~Он указывает на другой конец рынка. «Тогда тебе к Аалеку. Он обустроился в дальнем конце, возле печки».~
@34301 = ~«У меня есть другие вопросы...»~
@34302 = ~«Спасибо, прощай».~
@34303 = ~Он улыбается. «Походу, я могу тебе в этом помочь. Дай-ка я тебе покажу свои запасы».~
@34304 = ~«Хорошо». ~
@34305 = ~«Неважно, прощай».~
@34306 = ~Null node~
@34307 = ~~
@34308 = ~~
@34309 = ~~
@34310 = ~Он хмурится, потом начинает хохотать. «Ага, есть такое. Пару лет назад жил я в Улье. А тут какой-то полоумный маг решил выжечь целый район Сигила. Еще чуть-чуть — и спалил бы меня вместе с ним в придачу. Целый месяц хворал, так вот».~
@34311 = ~«Месяц? Это не так уж и долго».~
@34312 = ~«Ясно. У меня к тебе несколько вопросов...»~
@34313 = ~«Я должен идти. Прощай».~
@34314 = ~Он кивает и смотрит куда-то вдаль. «Могло быть и похуже. Местный маг меня заштопал, подлечил шрамы, и все такое. Можно было бы и волосы назад отрастить, но мне типа и так нравится».~
@34315 = ~«Думаешь, тот маг смог бы и мне помочь со шрамами?»~
@34316 = ~«Ясно. У меня к тебе несколько вопросов...»~
@34317 = ~«Я должен идти. Прощай».~
@34318 = ~Он окидывает тебя взглядом и пожимает плечами. «А почему бы и нет. Твои шрамы не то чтобы совсем плохи... — он внимательно смотрит на тебя. — Хотя, нашел кого спросить. Потолкуй лучше с ним сам. Его зовут Себастион, он обосновался неподалеку от Литейной».~
@34319 = ~«Может, так и сделаю. У меня к тебе пара вопросов...»~
@34320 = ~«Я должен идти. Прощай».~
@34321 = ~Уголек улыбается тебе. «Значит, снова пришел? Чего тебе на этот раз показать?»~
@34322 = ~«У меня есть несколько вопросов...» ~
@34323 = ~«Мне нужны кое-какие заклинания».~
@34324 = ~«Ничего, прощай».~
@34325 = ~Он гордым жестом показывает вокруг себя. «Это открытый рынок, один из лучших в Сигиле. Удача улыбнулась тебе, рубака, раз ты заглянул сюда. У нас тут пустует прилавок, — он указывает на соседний прилавок. — Коли будешь торговцем, можешь тут устраиваться поудобней и торговать вместе с нами, только не шуми и не надоедай...»~
@34326 = ~«Почему этот прилавок пустует?»~
@34327 = ~«Я это запомню. У меня еще несколько вопросов...»~
@34328 = ~«Спасибо. Я должен идти. Прощай».~
@34329 = ~Он обращает взгляд на пустой прилавок. «Здесь было место торговца по имени Зак. Недавно прописался в книге мертвых, — он хмурится. — Та еще странная история».~
@34330 = ~«И чем она странная?»~
@34331 = ~«Книга мертвых?»~
@34332 = ~«У меня есть другие вопросы...»~
@34333 = ~«Спасибо. Я должен идти. Прощай».~
@34334 = ~Он на миг задумывается. «Ну... я вообще не в теме, но вроде как у Зака были какие-то деловые затруднения, и ему нужно было немного деньжат. Ну, он и занял у барыги Байрона Пикита. Потом Пикит попытался отобрать у Зака его дело, но тот не дался», — он умолкает.~
@34335 = ~«Продолжай».~
@34336 = ~Он вздыхает и качает головой. «Вскоре после этого Зак записался в жмурики. Пикит повел в суд его вдовушку, Трист, и затребовал денег, что Зак задолжал. А она заявляет, что долг уплачен, и у нее есть бумажки, чтоб это доказать... но оказывается, что они пропали».~
@34337 = ~«Так что же все-таки случилось?»~
@34338 = ~«У меня есть другие вопросы...»~
@34339 = ~«Спасибо. Я должен идти. Прощай».~
@34340 = ~Он пожимает плечами. «Не имея доказательств, что долг уплачен, пришлось продать его дело, а Трист оказалась в ответе за остаток долга. Она не смогла его погасить, так что отправилась на аукцион».~
@34341 = ~«Аукцион?»~
@34342 = ~«Ты что-то говорил насчет отсутствующих бумаг».~
@34343 = ~«У меня есть другие вопросы...»~
@34344 = ~«Спасибо. Я должен идти. Прощай».~
@34345 = ~«Ага, аукцион рабов. Если не можешь расплатиться с долгами, тебя продают в рабство на пару годков, в наказание». Он грустно качает головой.~
@34346 = ~«Где находится аукцион?»~
@34347 = ~«Ты что-то говорил насчет отсутствующих бумаг».~
@34348 = ~«У меня есть другие вопросы...»~
@34349 = ~«Спасибо. Я должен идти. Прощай».~
@34350 = ~«Иди на север от рынка. Его не пропустишь — там будет куча народу».~
@34351 = ~«Ты что-то говорил насчет отсутствующих бумаг».~
@34352 = ~«У меня есть другие вопросы...»~
@34353 = ~«Спасибо. Я должен идти. Прощай».~
@34354 = ~«Ага. Трист клялась, что муженек ее Зак долг сполна уплатил, и у нее есть бумажки, чтоб это доказать. Пошла она за ними — а их нету, — он сердито фыркает. — Ставлю на то, что за этим всем стоит Пикит».~
@34355 = ~«Где я могу найти этого Пикита?»~
@34356 = ~«Кто-то занимается этим делом?»~
@34357 = ~«Понятно. У меня есть другие вопросы...»~
@34358 = ~Он бросает на тебя странный взгляд. «Что, в пустоголовые затесался? Он откинулся и записал себя в книгу мертвых».~
@34359 = ~«Понятно. Так что ты там говорил о пустом прилавке?»~
@34360 = ~«Понятно. У меня есть другие вопросы...»~
@34361 = ~«Спасибо. Я должен идти. Прощай».~
@34362 = ~«Насиживает свое место прямо возле рынка. Ты его не пропустишь».~
@34363 = ~«Понятно. У меня есть другие вопросы...»~
@34364 = ~«Спасибо. Я должен идти. Прощай».~
@34365 = ~Перед тобой темноволосая бледноватая женщина с утонченными чертами. Когда она поворачивается к тебе, ты замечаешь, что ее глаза — кажется, раньше они были серыми — приобрели стальной оттенок.~
@34366 = ~«Приветствую...»~
@34367 = ~«Тогда не будем тратить время, хорошо? Мои Заточки защитят меня».~
@34368 = ~«Ты всегда должен во всем быть уверен, парень. Вот я уверен, что ты сейчас умрешь». Он делает небольшое движение рукой.~
@34369 = ~«Ты можешь думать что угодно, но все, что здесь происходит — мое дело. Еще раз... Что ты здесь делаешь?»~
@34370 = ~«Жаль, что ты это сказал. Тем более жаль, что ты умрешь». Он делает рукой сигнал и вынимает свой нож.~
@34371 = ~«Ты уже нашел того правдоборца, Черного Бутона? Уложил его, как мы договаривались?»~
@34372 = ~«Еще нет? Ты что, слабак? Найди его и не возвращайся, пока не доведешь дело до конца!» В ярости он отворачивается от тебя.~
@34373 = ~Глаза Гнилого Уильяма сверкают. «Ты разобрался с ним, да? Тогда получай награду. Дай только достану ее...» Он выхватывает свой кинжал и целится им тебе в живот.~
@34374 = ~Его взгляд, как кинжал, пронзает тебя насквозь. «Ты убил эту жалкую сучку, как мы и договаривались, или опять пришел хвастаться своим провалом?»~
@34375 = ~Он качает головой. «Даже те бедолаги, которые называют себя моими товарищами, могут ответить за свои слова. А ты просто пустышка, вот ты кто. Мы окажем городу услугу, избавившись от тебя». Он достает свой нож.~
@34376 = ~«Ага, так ты все-таки сделал свою работу. Теперь мне нужно избавиться от этого проклятого убийцы, от которого мои люди постоянно пропадают. Я даже удвою награду. Как тебе это нравится? Ты ведь не хочешь отказываться от этого предложения?»~
@34377 = ~Мне нужно забрать со склада планы гробницы. Возможно, там мне сперва нужно будет с чем-то разобраться.~
@34378 = ~Я успешно разобрался с проблемами на складе и теперь у меня есть планы гробницы.~
@34379 = ~«Ты уверен в этом? Тебе не нужна эта работа?»~
@34380 = ~«Очень жаль, правда. Эх, ну что ж. Ребята, пора сжечь этот мусор». Он медленно достает свой нож и приближается к тебе...~
@34381 = ~«Хорошо, хорошо. Ты найдешь его где-то в переулке. Думаю, он прячется в тенях».~
@34382 = ~«Ты уже разделался с той жалкой сучкой Кристалл?»~
@34383 = ~Он говорит сквозь стиснутые зубы, четко произнося каждое слово. «Не... возвращайся... назад... пока... она... не... умрет. Ты... все... понял? — он отворачивается. — Чтоб духу твоего здесь не было, пока она не исчезнет».~
@34384 = ~«О чем это ты?»~
@34385 = ~«Я ищу Фарода».~
@34386 = ~«Я ищу дневник».~
@34387 = ~«Я просто проходил мимо».~
@34388 = ~«Мне не нужны неприятности».~
@34389 = ~«Черный Бутон хочет твоей смерти».~
@34390 = ~«Кристалл хочет твоей смерти».~
@34391 = ~«Я сказал, что это не твое дело».~
@34392 = ~Сражаться.~
@34393 = ~Сбежать.~
@34394 = ~«Еще нет».~
@34395 = ~«Я нашел его, но он убедил меня убить тебя вместо него».~
@34396 = ~«Он мертв. Где моя награда?»~
@34397 = ~«Сначала у меня есть несколько вопросов...»~
@34398 = ~«Тогда ладно».~
@34399 = ~Сражаться.~
@34400 = ~Сбежать.~
@34401 = ~«Еще нет».~
@34402 = ~«Она мертва».~
@34403 = ~Сражаться.~
@34404 = ~Сбежать.~
@34405 = ~«Боюсь, что я намерен от него отказаться».~
@34406 = ~«Я сделаю это».~
@34407 = ~«Нет, не нужна».~
@34408 = ~«Если подумать, двойное вознаграждение — звучит совсем неплохо. Я сделаю это».~
@34409 = ~Сражаться.~
@34410 = ~Сбежать.~
@34411 = ~«Я найду его».~
@34412 = ~«Еще нет».~
@34413 = ~«Она мертва».~
@34414 = ~«Отлично. Прощай».~
@34415 = ~«Да. Он мертв. Вам больше не нужно беспокоиться о нем и его банде».~
@34416 = ~«Если это остановит твою назойливость, то я это сделаю».~
@34417 = ~«Я все еще не хочу этого. Прощай».~
@34418 = ~«Тогда прощай». ~
@34419 = ~«Забудь об этом».~
@34420 = ~«Что еще?»~
@34421 = ~«А что для меня?»~
@34422 = ~«Я сделаю это».~
@34423 = ~«А что для меня?»~
@34424 = ~«Не заинтересован. Прощай».~
@34425 = ~«Да».~
@34426 = ~«Нет».~
@34427 = ~«По рукам. Прощай».~
@34428 = ~Есть ли вообще кто-нибудь, чьей смерти не желает Кристалл? Теперь я ищу борца за справедливость по имени Черный Бутон. Она пообещала мне деньги и дружбу в обмен на это задание.~
@34429 = ~«Отлично. Прощай».~
@34430 = ~«Пока нет».~
@34431 = ~«Да. Теперь вам не нужно больше о нем беспокоиться».~
@34432 = ~«Конечно. Прощай».~
@34433 = ~Я получил солидное вознаграждение за приложенные мной усилия по уничтожению Черного Бутона. Весьма и весьма солидное.~
@34434 = ~«Прощай».~
@34435 = ~«Я продолжу поиски. Прощай».~
@34436 = ~«Хочется посмотреть, как ты попытаешься это сделать с дырками в своей шкуре».~
@34437 = ~«Я уже заплатил».~
@34438 = ~Блеф: «Я уже заплатил».~
@34439 = ~Сбежать.~
@34440 = ~«С Гнилым Уильямом? Ага, ты встретишься с ним не раньше, чем я встречусь с твоим кошельком».~
@34441 = ~«Ни за что. Сперва ты истечешь кровью».~
@34442 = ~«Сколько тебе надо?»~
@34443 = ~«Нет. Это не так уж важно».~
@34444 = ~«Это не так много». Он великодушно говорит. «Всего лишь десять звенелок, и ты пройдешь мимо».~
@34445 = ~«По рукам».~
@34446 = ~«Ни за что».~
@34447 = ~«Тогда ты обнаружишь, что это не так уж важно, когда начнешь истекать кровью».~
@34448 = ~Сражаться.~
@34449 = ~Сбежать.~
@34450 = ~Он берет твои деньги, прячет их в карман и говорит: «А теперь проваливай отсюда».~
@34451 = ~Уйти.~
@34452 = ~«Тогда отсюда ты уйдешь убитым». Он выхватывает свой нож и нападает!~
@34453 = ~Сражаться.~
@34454 = ~Сбежать.~
@34455 = ~Он вглядывается в тень, делает жест рукой и снова смотрит на тебя. «Хорошо. Проходи, пень».~
@34456 = ~«Спасибо. Прощай».~
@34457 = ~Он вглядывается в тень, делает жест рукой и снова смотрит на тебя. «Нет, не платил. Теперь ты умрешь».~
@34458 = ~Сражаться.~
@34459 = ~Сбежать.~
@34460 = ~«Что, опять ты? Тебе что, не надоело нам платить? Похоже, нет, раз ты здесь. Десять монет, и ты можешь вернуться еще раз».~
@34461 = ~«Мне нужно переговорить с вашим главарем».~
@34462 = ~«Сколько тебе надо?»~
@34463 = ~«Хочется посмотреть, как ты попытаешься это сделать с дырками в своей шкуре».~
@34464 = ~«Я уже заплатил».~
@34465 = ~Блеф: «Я уже заплатил».~
@34466 = ~Сбежать.~
@34467 = ~«Я слышал, Гнилой Уильям подбил тебя на убийство, а? Пока ты не разберешься с этим, для тебя будет старая цена. Десять звенелок».~
@34468 = ~«Хорошо. Держи».~
@34469 = ~«У меня нет столько».~
@34470 = ~«Но я работаю на Гнилого Уильяма!»~
@34471 = ~«На самом деле тебе не стоит их собирать».~
@34472 = ~«Только через мой труп».~
@34473 = ~«Я уже заплатил».~
@34474 = ~Блеф: «Я уже заплатил».~
@34475 = ~«Ты все еще не убил кое-кого для Гнилого Уильяма? За отсрочку — деньги на бочку. Десять монет и ты можешь идти своей беззаботной дорогой».~
@34476 = ~«Хорошо. Держи».~
@34477 = ~«У меня нет столько».~
@34478 = ~«Но я работаю на Гнилого Уильяма!»~
@34479 = ~«На самом деле тебе не стоит их собирать».~
@34480 = ~«Только через мой труп».~
@34481 = ~«Я уже заплатил».~
@34482 = ~Блеф: «Я уже заплатил».~
@34483 = ~«Благодарю. Повидай меня, когда пойдешь назад, ладно?» Он подмигивает тебе.~
@34484 = ~«Весело. Прощай».~
@34485 = ~«Как жаль. Гнилой Уильям будет очень несчастлив слышать, что тебя подвесили на ноже». Он достает свое оружие и бросается в атаку.~
@34486 = ~Сражаться.~
@34487 = ~Сбежать.~
@34488 = ~«И я тоже. Что скажешь? Платить и говорить или кровоточить?»~
@34489 = ~«Я заплачу».~
@34490 = ~«У меня нет столько».~
@34491 = ~Сражаться.~
@34492 = ~Сбежать.~
@34493 = ~«Я уже заплатил».~
@34494 = ~Блеф: «Я уже заплатил».~
@34495 = ~«На самом деле тебе не стоит их собирать».~
@34496 = ~«Только через мой труп».~
@34497 = ~Он с опаской смотрит на тебя, пытаясь уяснить твои слова. «На этот раз я тебе прощаю. Проваливай отсюда».~
@34498 = ~«Спасибо. Прощай».~
@34499 = ~«Ты даже не представляешь, как я хотел услышать это». Он выхватывает свой нож и нападает.~
@34500 = ~Сражаться.~
@34501 = ~Сбежать.~
@34502 = ~«Ты вписал имя Гнилого Уильяма в книгу мертвых кровавыми чернилами, рубака. Теперь ты можешь свободно проходить по территории Бритвенных Ангелов».~
@34503 = ~«Спасибо. Прощай».~
@34504 = ~Этот уличный житель встречает тебя с чрезмерной вежливостью и низким поклоном. «Приветствую, незнакомец. Ты выбрал, э-э, благоприятный день для прохождения через нашу территорию. Плата составляет всего лишь десять монет».~
@34505 = ~«Десять монет? Это чересчур!»~
@34506 = ~«Я только что заплатил вон тем пням!»~
@34507 = ~«Десять? Хорошо. Держи».~
@34508 = ~«Я уже заплатил».~
@34509 = ~Блеф: «Я уже заплатил».~
@34510 = ~«Тебе придется со мной сразиться ради них».~
@34511 = ~«Сначала попробуй меня поймать».~
@34512 = ~«Всего лишь десять монет. Это наша территория. Уверен, ты знал, что это не место для слабаков. Ты явился сюда по собственной воле. Выбирай, чем будешь расплачиваться: медяками или кровью. Так что?»~
@34513 = ~«Монетами. Держи».~
@34514 = ~«Кровью».~
@34515 = ~«Сначала попробуй меня догнать».~
@34516 = ~«А, те придурки не с нами. Заточки — наши заклятые враги. Теперь ты рассчитаешься с нами или мы оставим твою тушку лежать на земле».~
@34517 = ~«Тогда вот. Возьми деньги».~
@34518 = ~«Ты сдохнешь раньше, приятель».~
@34519 = ~«Сначала попробуй меня догнать».~
@34520 = ~«Бритвенные Ангелы благодарят тебя. Иди с миром, путник».~
@34521 = ~«Спасибо, пень. Прощай».~
@34522 = ~Бритвенный Ангел на миг вглядывается в тени, и, сделав жест рукой, кивает. «Ладно. Двигай. Мы возьмем с тебя плату в следующий раз».~
@34523 = ~«Я и не сомневаюсь. Прощай».~
@34524 = ~Бритвенный Ангел на миг вглядывается в тени, и, сделав жест рукой, качает головой. «Нет, ты не платил. Это последнее предупреждение. Десять монет или холодная земля».~
@34525 = ~«Тогда вот. Возьми деньги».~
@34526 = ~«Попробуй взять их у меня, пень».~
@34527 = ~«Сначала попробуй меня поймать».~
@34528 = ~«Вижу, ты вернулся. Цена прежняя, если хочешь пройти. Десять монет, приятель, и ты уйдешь без новых шрамов».~
@34529 = ~«Десять монет? Это чересчур!»~
@34530 = ~«Я только что заплатил вон тем пням!»~
@34531 = ~«Десять? Хорошо. Держи».~
@34532 = ~«Я уже заплатил».~
@34533 = ~Блеф: «Я уже заплатил».~
@34534 = ~«Тебе придется со мной сразиться ради них».~
@34535 = ~«Сначала попробуй меня поймать».~
@34536 = ~«Слышал, что ты выполняешь какую-то работенку для Кристалл. Хорошо. Сделай ее пошустрей, понял? О... пока не забыл: ты должен заплатить за проход. Теперь ты с нами, поэтому и платишь полцены: каких-то пять монет».~
@34537 = ~«Но я работаю на Кристалл!»~
@34538 = ~«Держи».~
@34539 = ~«Я только что заплатил вон тем пням!»~
@34540 = ~«Я уже заплатил».~
@34541 = ~Блеф: «Я уже заплатил».~
@34542 = ~«Ты сдохнешь раньше, приятель».~
@34543 = ~«Сначала попробуй меня поймать».~
@34544 = ~«Как, ты еще не прикончил Гнилого Уильяма? Тогда гони пять монет, пока Кристалл не решит иначе».~
@34545 = ~«Но я работаю на Кристалл!»~
@34546 = ~«Держи».~
@34547 = ~«Я только что заплатил вон тем пням!»~
@34548 = ~«Я уже заплатил».~
@34549 = ~Блеф: «Я уже заплатил».~
@34550 = ~«Ты сдохнешь раньше, приятель».~
@34551 = ~«Сначала попробуй меня поймать».~
@34552 = ~«Это ты. А этот я. Нам всем жрать охота, вот ты нас и прокормишь. Пять монет, или я порву тебя на грелки».~
@34553 = ~«Держи».~
@34554 = ~«Ты сдохнешь раньше, приятель».~
@34555 = ~«Сначала попробуй меня поймать».~
@34556 = ~«Бывай. Удачи с этим ублюдком Гнилым Уильямом».~
@34557 = ~«Ага, спасибо».~
@34558 = ~«Ага, и те придется их убить, чтобы вернуть деньги назад. Но они были там, а мы — здесь. Плати, приятель».~
@34559 = ~«Держи».~
@34560 = ~«Почему бы не попробовать взять их у меня? Я готов».~
@34561 = ~«Ни за что. Я ухожу».~
@34562 = ~Бритвенный Ангел вглядывается в тень за подтверждением. Он поворачивается обратно. «Ага, мои извинения. Проходи».~
@34563 = ~«Спасибо».~
@34564 = ~Бритвенный Ангел вглядывается в тень за подтверждением. Он поворачивается обратно. «Нет, ты не платил. Плати, дружок, иначе до Гнилого Уильяма тебе не добраться».~
@34565 = ~«Держи».~
@34566 = ~«Я убью его сразу после того, как расправлюсь с тобой».~
@34567 = ~«Не думаю, что тебе удастся догнать меня»~
@34568 = ~«Ты расплатился, убив эту сучку Кристалл. Хорошая новость для босса. Но как по мне, нам все равно стоило бы тебя прирезать. Так что... вали отсюда».~
@34569 = ~«Как трогательно. Прощай».~
@34570 = ~«Ты очень скоро нам заплатишь. Монетой или кровью. Иди, поговори с собирателем пошлины — и не пытайся пройти мимо него. Доходчиво?»~
@34571 = ~«Я так не думаю».~
@34572 = ~«Хорошо».~
@34573 = ~Сбежать.~
@34574 = ~«Ты уже заплатил, почему бы тебе не исчезнуть? Не суй свой нос куда попало».~
@34575 = ~«Как бы то ни было. Прощай».~
@34576 = ~«Мне сказали, что у тебя бесплатный пропуск через территорию Бритвенных Ангелов, пень. Не злоупотребляй этим».~
@34577 = ~«Спасибо. Прощай».~
@34578 = ~«Стой здесь. Кто-нибудь подойдет поговорить с тобой».~
@34579 = ~«Даже и не думай. Я буду уже очень далеко, пока он здесь появится».~
@34580 = ~«Почему бы не поприветствовать его твоей кровью? Только сначала я ее пролью».~
@34581 = ~«Отлично. Я буду ждать здесь».~
@34582 = ~«Ты заплатил, ты можешь идти куда хочешь. Наслаждайся этим, пока можешь».~
@34583 = ~«Спасибо, я так и сделаю. Прощай».~
@34584 = ~Фракция: нейтральный

Не принадлежит какой-либо фракции.~
@34585 = ~Фракция: Верящие в Первопричину («Боголюди»)

Девиз: Все живое происходит из одной священной первопричины, возвышаясь и опускаясь в испытаниях, поставленных мирозданием.~
@34586 = ~Фракция: Убийцы милосердия («Красная смерть»)

Девиз: Правосудие повсюду. Правильно примененное наказание ведет к совершенству.~
@34587 = ~Фракция: Общество Восприятия («Чувствующие»)

Девиз: Познай вселенную, прочувствовав ее до конца. Чувства прокладывают путь к истине, поскольку мультивселенная не существует за пределами осязаемого.~
@34588 = ~Фракция: Тленные («Мертвые»)

Девиз: Все мертвы. Отринь свои чувства. Сделав это, ты приблизишься к чистоте Истинной Смерти.~
@34589 = ~Фракция: Революционная лига («Анархисты»)

Девиз: Уничтожь фракции; они построены на лжи и алчности. Разрушь их всех до основания и перестрой то, что осталось. Так ты постигнешь истину.~
@34590 = ~Фракция: Хаоситеки («Хаоситы»)

Девиз: Правда хаос это. В беспорядочном воздействии на мультивселенную лежит секрет ее познания.~
@34591 = ~Фрактол Хаоситеков («Хаоситов»)

Девиз?! ФРАКТОЛ Хаоситов сей-час ТЫ! Хаос в истине. Случайным образом о-хватывая мультивселенную, узнаешь ли ее секреты?~
@34592 = ~В этом месте нельзя сохранять игру.~
@34593 = ~Во время диалога нельзя сохранять игру.~
@34594 = ~Во время отдыха или показа ролика нельзя сохранять игру.~
@34595 = ~Во время игровой сцены нельзя сохранять игру.~
@34596 = ~При торговле нельзя сохранять игру.~
@34597 = ~В текущий момент нельзя сохранять игру.~
@34598 = ~Пока рядом есть опасные существа, нельзя сохранять игру.~
@34599 = ~Сейчас ты не можешь отдыхать.~
@34600 = ~Ты не можешь отдыхать, пока рядом есть опасные существа.~
@34601 = ~Ты не можешь отдыхать здесь.~
@34602 = ~Конец~
@34603 = ~Дальше~
@34604 = ~«Маленькая птичка заблудилась, а? Если птичка хочет жить, птичке нужно заплатить».~
@34605 = ~«Сколько?»~
@34606 = ~«Тебе нужны мои деньги? Попробуй отбери!»~
@34607 = ~«Сначала попробуй меня поймать».~
@34608 = ~«Десять звенелок, мой дорогой друг!»~
@34609 = ~«На, бери».~
@34610 = ~«У меня нет столько».~
@34611 = ~«Даже и не думай. Тебе придется снять их с моего трупа».~
@34612 = ~«Сначала попробуй меня поймать!»~
@34613 = ~Головорез, издеваясь, кланяется. «Надеюсь, что наше сотрудничество в дальнейшем будет таким же плодотворным».~
@34614 = ~«Да-да, конечно. Прощай».~
@34615 = ~Головорез изображает шок. «В таком случае, ты заплатишь кровью. Прощай, приятель».~
@34616 = ~«Эй, погоди...»~
@34617 = ~«Сначала попробуй».~
@34618 = ~«Маленькая птичка вернулась домой, а? Пришла покормить остальных в гнезде?»~
@34619 = ~«О чем это ты?»~
@34620 = ~«Вот твоя плата».~
@34621 = ~«Я принес тебе смерть».~
@34622 = ~Его лицо вытягивается в притворной муке. «Ты что, уже забыл? Ах, дорогуша. Десять звенелок — такса, чтобы пройти по моей улице. Давай, отсыпай».~
@34623 = ~«На, держи».~
@34624 = ~«На этот раз я буду драться».~
@34625 = ~«А мы не можем как-нибудь договориться?»~
@34626 = ~«Извини, пень. Все должны играть по правилам, и тебе придется заплатить кровью. Передай своим силам мой пламенный привет».~
@34627 = ~Сражаться.~
@34628 = ~Сбежать.~
@34629 = ~Перед тобой хорошо одетый мужчина средних лет. Он разглядывает толпу опытным взглядом. Заметив твое приближение, он бегло осматривает тебя.~
@34630 = ~Он улыбается и делает едва заметный кивок. «Я Байрон Пикит, ростовщик. Чем могу помочь?»~
@34631 = ~Он еще раз кивает. «Да, я оказываю услуги торговцам. Хочешь начать дело? Удержаться на плаву, когда все пошло наперекосяк? Или, может, расширить дело? В любом случае, ты пришел ко мне за средствами, — он осматривает тебя с головы до ног. — Сомневаюсь, что ты торговец, так чего же тебе нужно от меня?»~
@34632 = ~Он улыбается и на миг отводит взгляд. «Возможно, торговец смертью, но явно не тот, с кем я обычно веду дела, — он хмурится. — Если ты собираешься и дальше занимать мое время, прошу перейти к цели визита».~
@34633 = ~Он хмурится и качает головой. «Нет, не вижу на то причины... — он осматривает тебя с ног до головы. — Ты точно не из тех, с кем я веду дела. Думаю, тебе стоит уйти». Он отводит взгляд.~
@34634 = ~Он вздыхает. «Хорошо, поторопись».~
@34635 = ~«Если ты имеешь в виду район в целом, то он называется Нижним районом. Если ты имеешь в виду конкретно это место, то это — открытый рынок».~
@34636 = ~У него скучающий вид. «Это жилище для простого народа, — он показывает вокруг себя. — Оглянись, и ты увидишь все, что можно здесь увидеть... То есть ничего. Ничего интересного».~
@34637 = ~Он улыбается. «Единственное, в чем преуспели эти глупые бедолаги — это трата денег. Это дает им ощущение того, что они действительно чего-то достигли в своей бессмысленной жизни». Он умолкает и с пренебрежением оглядывается по сторонам.~
@34638 = ~Он пожимает плечами. «Там, где есть деньги, обязательно найдутся торговцы и воры. Я помогаю торговцам, которые желают избавиться, — он показывает вокруг, — от тяжело заработанной монеты». Он улыбается.~
@34639 = ~«Не я... — он бросает на тебя расчетливый взгляд и улыбается. — Почему ты спрашиваешь?»~
@34640 = ~Он смеется. «Такое любопытство может оказаться опасным... даже фатальным, если не соблюдать осторожности». Он умолкает, чтобы обдумать следующие свои слова, при этом внимательно тебя рассматривая. «Может, тебе стоит поговорить с Ленни. Обычно его можно найти на юго-востоке от рынка, — на миг он умолкает. — Передай, что я тебя послал».~
@34641 = ~Он указывает на здание у себя за спиной. «Превосходный рынок, удовлетворит почти любые нужды, — он умолкает, чтобы немного подумать, прежде чем продолжить. — Там нет ничего экзотического; те бедолаги не могут себе позволить такие товары, и тем не менее, это неплохой рынок».~
@34642 = ~Он пожимает плечами. «Я не гид. Если хочешь узнать Сигил, тебе придется исследовать его. Советую так и поступить. Однако должен предупредить тебя, что если ты заглянешь слишком глубоко, то умрешь».~
@34643 = ~Он ненадолго раздумывает, прикидывая, что именно тебе сказать. «Сигил хранит много тайн, и светлых, и темных. Раскрой слишком много темных тайн — и поплатишься за это жизнью».~
@34644 = ~Он глядит на тебя удивленно, затем выдает резкий смешок. «Они перестанут быть тайнами, если я их раскрою, не так ли?»~
@34645 = ~«А, Трист...» Он хмурится и отводит глаза в сторону. Мгновение спустя он обращает на тебя взгляд, поднимая брови. «Что насчет нее?»~
@34646 = ~Он вздыхает, качая головой. «Нет никакого *пропавшего* документа. Это уловка, с помощью которой Трист хотела посеять смуту вокруг ее долга. Это дело было тщательно расследовано убийцами милосердия, и они не нашли никаких следов подобного документа».~
@34647 = ~«Да, это фракция фанатиков, посвятивших себя поиску *истины* в уголовных делах и раздаче справедливости. Суд Сигила часто использует их в качестве следователей. Они очень дотошны, и они ничего там не нашли...» Он глядит на тебя.~
@34648 = ~«Это возможно, но очень маловероятно. Ты, очевидно, мало знаком с убийцами милосердия и их методами, раз делаешь такие заявления. Если им не удалось найти документ, то его не существует». Он сердито смотрит на тебя.~
@34649 = ~Он чуть было не выходит из себя, но потом его лицо расползается от злорадной ухмылки. «Какая ужасная мысль... как жаль, что этому нет никаких доказательств...» Он продолжает ухмыляться тебе.~
@34650 = ~«Да, она могла, и я предлагал ей, — он смотрит на тебя сурово. — Однако она мне отказала. Я не даю второго шанса. Никто не отказывает мне, не поплатившись за это. Никто...»~
@34651 = ~Он смеется над тобой. «Ну, тогда желаю удачи. Раз убийцам милосердия не удалось помочь бедняжке Трист, я не думаю, что у тебя есть хоть какой-то шанс это сделать. А теперь отвали, бедолага». Он отворачивается от тебя.~
@34652 = ~«Нет, мне тебя хватит на всю оставшуюся жизнь. Я не стану отвечать на твои вопросы. А теперь проваливай, неудачник». Он отворачивается от тебя.~
@34653 = ~Он смотрит на тебя в недоумении. «Правда? И зачем, во имя девяти кругов ада, тебе понадобилось его искать?»~
@34654 = ~Он на мгновение умолкает. «А у меня есть причины, довольно веские — можешь не сомневаться, — чтобы никому не указывать на Лотара. А теперь проваливай, неудачник». Он отворачивается.~
@34655 = ~«И что? Что ты собираешься делать? Просто так прийти и потребовать его назад? — он окидывает тебя взглядом сверху донизу. — Соглашусь, что на вид ты вполне можешь за себя постоять в бою, но чтобы против Лотара? — он фыркает. — Твой череп украсит его стены».~
@34656 = ~Он вызывающе хохочет и бросает на тебя скептический взгляд. «Лотар выше закона, пень. Он слишком влиятелен и слишком силен...»~
@34657 = ~Он качает головой. «Правда... — он вздыхает и смотрит в сторону. — Могу тебя заверить: теперь твой череп не вернуть. Забудь о нем, найди себе замену».~
@34658 = ~«Потому что, скорее всего, твоим черепом теперь владеет Повелитель Костей, Лотар. А если это действительно так, то можешь о нем забыть». Он пожимает плечами.~
@34659 = ~Ты видишь Байрона Пикита, ростовщика. «Вернулся?»~
@34660 = ~Он смеется и оглядывается. «Что, правда? Ну, это не из тех вещей, которые рассказываются первому встречному, — он изучает тебя, что-то обдумывая. — Как я уже говорил, я не имею ничего общего с ворами... Может, тебе стоит поговорить с Ленни. Обычно он околачивается на юго-востоке от рынка, — он делает паузу. — Передай ему, что тебя послал я».~
@34661 = ~«Приветствую».~
@34662 = ~Не обращать на него внимания.~
@34663 = ~«Ростовщик?»~
@34664 = ~«У меня есть несколько вопросов...» ~
@34665 = ~«Неважно. Прощай».~
@34666 = ~«Я торговец».~
@34667 = ~«У меня есть несколько вопросов...» ~
@34668 = ~«Ничего, прощай».~
@34669 = ~«Ты мог бы рассказать мне о своем деле?»~
@34670 = ~«У меня есть несколько вопросов...» ~
@34671 = ~~
@34672 = ~«У меня есть несколько вопросов...» ~
@34673 = ~«Хорошо, прощай».~
@34674 = ~«Что это за место?»~
@34675 = ~«Я хотел бы поговорить с тобой насчет Трист».~
@34676 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@34677 = ~«У меня пропал череп... не знаешь, кому могло понадобиться нечто подобное?»~
@34678 = ~«Я должен идти. Прощай».~
@34679 = ~«Расскажи мне о Нижнем районе».~
@34680 = ~«Расскажи мне об открытом рынке».~
@34681 = ~«У меня есть другие вопросы...»~
@34682 = ~«Я должен идти. Прощай».~
@34683 = ~«Тогда зачем ты здесь?»~
@34684 = ~«Расскажи мне об открытом рынке».~
@34685 = ~«У меня есть другие вопросы...»~
@34686 = ~«Я должен идти. Прощай».~
@34687 = ~«Продолжай».~
@34688 = ~«У меня есть другие вопросы...»~
@34689 = ~«Я должен идти. Прощай».~
@34690 = ~«А воры? Кто помогает *им*?»~
@34691 = ~«Понятно... У меня есть другие вопросы...»~
@34692 = ~«Я должен идти. Прощай».~
@34693 = ~«Назовем это любопытством...»~
@34694 = ~«Мне нужна кое-какая подготовка...»~
@34695 = ~«Назовем это любопытством...»~
@34696 = ~К юго-востоку от рынка можно найти такого себе вора по имени Ленни. Возможно, я мог бы у него кое-чему научиться.~
@34697 = ~«Расскажи мне об открытом рынке».~
@34698 = ~«У меня есть другие вопросы...»~
@34699 = ~«Истинная Смерть?..»~
@34700 = ~«Мы с тобой еще встретимся».~
@34701 = ~«Хм... 'Юс'? 'Клюс'? Нет...»~
@34702 = ~«'Шлюс'? Нет... 'союс'? Нет...»~
@34703 = ~«Может, 'минюс'... нет...»~
@34704 = ~::Фыркает::~
