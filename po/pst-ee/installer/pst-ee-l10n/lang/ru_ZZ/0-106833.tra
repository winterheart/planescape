@19661 = ~«Приветствую...»~
@19662 = ~Оставить зомби в покое.~
@19663 = ~«Расскажи мне о Тухлой Мери».~
@19664 = ~«У меня есть другие вопросы...»~
@19665 = ~«Это все, что я хотел узнать. Прощай».~
@19666 = ~«Гниющие трупы не выглядят для меня привлекательными, Морт. Даже женские трупы».~
@19667 = ~ «Ну, наверно, если не обращать внимания на 'вонючее разлагающееся мясо в трупных червях', то...»~
@19668 = ~Не обращать на него внимания, поздороваться с зомби.~
@19669 = ~Не обращать на него внимания, поздороваться с зомби.~
@19670 = ~Не обращать на него внимания, поздороваться с зомби.~
@19671 = ~Не обращать на него внимания, поздороваться с зомби.~
@19672 = ~Закл. <LEVEL> уровня~
@19673 = ~Опыт~
@19674 = ~Следующий уровень~
@19675 = ~Этот желтоглазый, истекающий слюной упырь воняет кровью и падалью. Он перебирает своими крючковатыми пальцами с длинными грязными когтями, беспрестанно нюхая воздух. Его кожа болезненно-зеленого цвета и покрыта гниющими влажными язвами.~
@19676 = ~Упырь прищуривается и рычит на тебя. Его язык, не менее двух ладоней в длину, высовывается и облизывает покрытые струпьями губы.~
@19677 = ~Упырь продолжает жадно глядеть на тебя. Он стискивает и разжимает когтистые кулаки, будто борясь с желанием броситься на тебя и сожрать.~
@19678 = ~Упырь шипит на тебя: «Молчать, мясо! Ни слова! Я не слушаю мясных тварей! Я слышу только твое сердце, кровь в мясных венах, сладкую, вкусную кровь... вкусное сочное сердце... — из его рта течет слюна, капая на пыльные плиты. — МОЛЧАТЬ!»~
@19679 = ~Когда ты подходишь, упырь начинает шипеть на тебя: «Прочь! Убирайся прочь! Я не *разговариваю* с мясной тварью, я не *слушаю*, мясо! УХОДИ!»~
@19680 = ~Этот желтоглазый, истекающий слюной упырь воняет кровью и падалью. Он перебирает своими крючковатыми пальцами с длинными грязными когтями, беспрестанно нюхая воздух. Его кожа болезненно-зеленого цвета и покрыта гниющими влажными язвами.~
@19681 = ~«Э... даже не знаю, захочешь ли ты говорить с этой... тварью».~
@19682 = ~«Когда-то они были людьми... Они, или их предки, ели трупы, и вот во что они превратились. Довольно таки мерзкая вещь, шеф... На самом деле, они больше похожи на животных. *Опасных* животных».~
@19683 = ~«Приветствую...»~
@19684 = ~Оставить упыря в покое.~
@19685 = ~«У меня есть несколько вопросов...» ~
@19686 = ~«Мне уже нужно идти. Прощай».~
@19687 = ~«Успокойся и ответь на мои вопросы».~
@19688 = ~«Тогда прощай». ~
@19689 = ~«Тогда прощай». ~
@19690 = ~Уйти.~
@19691 = ~«Почему нет, Морт?»~
@19692 = ~«Ладно. Идем».~
@19693 = ~Не обращать внимания на Морта, поздороваться с упырем.~
@19694 = ~«Ладно. Идем».~
@19695 = ~«Я все равно с ним поговорю».~
@19696 = ~Эта упыриха воняет кровью и падалью. По ее длинным тонким волосам, которые она то и дело убирает со своих желтых глаз жуткими когтями, ползают жуки и черви. Ее кожа болезненно-зеленого цвета и покрыта гниющими влажными язвами.~
@19697 = ~Упыриха прищуривается и рычит на тебя. Ее язык, не менее двух ладоней в длину, высовывается и облизывает покрытые струпьями губы.~
@19698 = ~Упыриха продолжает жадно глядеть на тебя. Она стискивает и разжимает когтистые кулаки, будто борясь с желанием броситься на тебя и сожрать.~
@19699 = ~Упыриха визжит на тебя: «Молчать, мясо! Ни слова! Я не слушаю мясных тварей! Я слышу только твое сердце, кровь в мясных венах, сладкую, вкусную кровь... вкусное сочное сердце... — из ее рта течет слюна, капая на пыльные плиты. — МОЛЧАТЬ!»~
@19700 = ~Когда ты подходишь, упыриха начинает визжать на тебя: «Прочь! Убирайся прочь! Я не *разговариваю* с мясной тварью, я не *слушаю*, мясо! УХОДИ!»~
@19701 = ~Эта упыриха воняет кровью и падалью. По ее длинным тонким волосам, которые она то и дело убирает со своих желтых глаз жуткими когтями, ползают жуки и черви. Ее кожа болезненно-зеленого цвета и покрыта гниющими влажными язвами.~
@19702 = ~«Э... даже не знаю, захочешь ли ты говорить с этой... тварью».~
@19703 = ~«Когда-то они были людьми... Они, или их предки, ели трупы, и вот во что они превратились. Довольно таки мерзкая вещь, шеф... На самом деле, они больше похожи на животных. *Опасных* животных».~
@19704 = ~«Это не то же самое, шеф...»~
@19705 = ~«Приветствую...»~
@19706 = ~Оставить упыриху в покое.~
@19707 = ~«У меня есть несколько вопросов...»~
@19708 = ~«Мне уже нужно идти. Прощай».~
@19709 = ~«Успокойся и ответь на мои вопросы».~
@19710 = ~«Тогда прощай». ~
@19711 = ~«Тогда прощай». ~
@19712 = ~Уйти.~
@19713 = ~«Морт, ты меня удивляешь... Это нежить женского пола. Обычно этого для тебя достаточно».~
@19714 = ~«Почему нет, Морт?»~
@19715 = ~«Ладно. Идем».~
@19716 = ~Не обращать внимания на Морта, поздороваться с упырем.~
@19717 = ~«Ладно. Идем».~
@19718 = ~«Я все равно с ней поговорю».~
@19719 = ~На костях этого древнего оживленного трупа не осталось плоти... только несколько цветных тряпок, служащих скорее украшением, чем одеждой.~
@19720 = ~«Приветствую и тебя», — его тихий спокойный голос выходит из черепа вместе с облачком пыли.~
@19721 = ~«Отвечу, как смогу, — при разговоре из челюстей скелета сыпется пыль. — Спрашивай, о чем хочешь: времени на разговоры у меня довольно».~
@19722 = ~«Ты в месте, которое мы зовем Мертвыми Народами... сие наши владения и жилище под городом Сигил. Сие только малая толика нашей цивилизации, граница... Мертвые Народы расходятся на многие лиги во тьме».~
@19723 = ~«Сие место — земли нежити, коей управляет наш Безмолвный Король. Здесь есть зомби, а также упыри. Недалеко, в катакомбах на востоке, живут черепные крысы. Еще сюда иногда попадают живые, такие как ты или Соэго».~
@19724 = ~Скелет неторопливо кивает, позвонки его шеи слегка поскрипывают. «Пожалуйста, спрашивай».~
@19725 = ~Скелет кивает. «Мы здесь самые старые из нежити, мы все почти без плоти. Мы пытаемся служить другим советчиками и наставниками, поддерживая здесь добрый мир».~
@19726 = ~«Они сильные, но неторопливые умом и телом. Они сохранили в себе больше человечности, эмоций, чем мы. Они у нас вместо рабочих. За ними присматривает Тухлая Мери, самая заботливая и умная из них».~
@19727 = ~«Упыри — сильные, жестокие и ненасытные твари. Ими управляет ужасная Акаста. Они служат нашему сообществу, Мертвым Народам, в качестве охраны... но они ненадежны. Их удерживает страх перед великим числом другой нежити и перед Безмолвным Королем. Без нашего могучего повелителя, командующего ими, мы... да и наши подопечные... однажды можем стать их добычей».~
@19728 = ~«О ком ты хочешь узнать?»~
@19729 = ~«Наш владыка и повелитель. Его называют Безмолвным Королем, потому что он говорит только в моменты крайней необходимости, — во время разговора скелет жестикулирует, при этом его старые суставы скрипят и щелкают. — Спроси о нем Харгримма, нашего верховного жреца. Он сможет рассказать тебе больше».~
@19730 = ~«Паразиты, чей ум крепчает при приближении к себе подобным. Когда-то они были серьезной угрозой... они нападали на наших подопечных, тревожили кости молчащих. Сейчас они держатся в восточной части катакомб. Упыри словили и съели достаточно крыс, так что пока что их бесчинствам положен конец».~
@19731 = ~«Он был вроде миссионера, тленным, что надеялся убедить нас предаться Истинной Смерти. Теперь, как я знаю, он один из наших подопечных».~
@19732 = ~«Он вроде как миссионер, тленный, который надеется убедить нас предаться Истинной Смерти. Его можно найти в часовне в северной части этих холодных пыльных залов. Возможно, ты захочешь с ним поговорить».~
@19733 = ~«А что делают живые в наземном мире? Мы живем своей жизнью здесь, в безмолвной тьме. Мы защищаем наших подопечных, молчащих, от мародерств».~
@19734 = ~«Молчащие... мертвые, пребывающие во сне. Мы защищаем их, следим за их покоем».~
@19735 = ~Скелет пожимает плечами, его лопатки скребутся сзади по грудной клетке. «Нет. Пожалуй, тебе стоит поговорить с Харгриммом, нашим верховным жрецом. Он многое знает».~
@19736 = ~Скелет касается подбородка, слегка подняв голову. «Упырям разрешено есть тех, кого застали за разграблением катакомб. Безмолвный Король считает, что другим бродящим здесь незваным гостям — вроде тебя — лучше позволить зачахнуть здесь, чтобы они стали нашим подопечным, а не обедом упырей. Возможно, ты захочешь поговорить с Харгриммом, нашим верховным жрецом: он тот, кто говорит с Безмолвным Королем».~
@19737 = ~Скелет кивает. «Чтобы стать одним из наших подопечных. Чтобы пополнить ряды молчащих».~
@19738 = ~«И снова приветствую. Уже привыкаешь к новому дому?»~
@19739 = ~«Многие, — он пересчитывает их на пожелтевших, покрытых пылью костях пальцев. — Голодные неуправляемые упыри, крысы и больше всего... живые. Те, из погребенной деревни, слуги человека по имени Фарод, часто спускаются в склепы Мертвых Народов, тревожат молчащих. Я не знаю, зачем, да и мне все равно... единственное, что меня волнует — чтобы мы прекратили здесь их грязные дела».~
@19740 = ~Скелет изящно кивает. «О ком?»~
@19741 = ~«Наш верховный жрец. Это он говорит с Безмолвным Королем, передавая нам приказы и законы нашего повелителя. Он здесь, комнате перед тронным залом Безмолвного Короля».~
@19742 = ~«Она медлительна, но заботлива и мудра. Она вроде как мать другим зомби. Ее можно найти в комнате к западу от места, где ты впервые попал в Мертвые Народы».~
@19743 = ~«Она ужасный вожак стаи упырей, которые зовут себя Паршивыми. Они служат Мертвым Народам охраной и защитой... пока служат. Она присматривает за комнатой, где ты впервые попал в Мертвые Народы».~
@19744 = ~«Приветствую...»~
