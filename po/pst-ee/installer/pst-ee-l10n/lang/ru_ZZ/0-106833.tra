@16024 = ~Правда: «Довольно. Отдай мне кулон или умри».~
@16025 = ~Блеф: «Довольно. Отдай мне кулон или умри».~
@16026 = ~«У меня есть другие вопросы...»~
@16027 = ~«Это все, что я хотел узнать. Прощай».~
@16028 = ~«Хорошо. Продолжай...»~
@16029 = ~Правда: «Довольно. Отдай мне кулон или умри».~
@16030 = ~Блеф: «Довольно. Отдай мне кулон или умри».~
@16031 = ~«Может быть, в другой раз. У меня есть несколько вопросов...»~
@16032 = ~«Возможно, в другой раз. Прощай».~
@16033 = ~«И почему я должен этому верить?»~
@16034 = ~«Понятно. Продолжай...»~
@16035 = ~Правда: «Довольно. Отдай мне кулон или умри».~
@16036 = ~Блеф: «Довольно. Отдай мне кулон или умри».~
