@33761 = ~«Это все, что я хотел узнать. Прощай».~
@33762 = ~«Где находится Морг?»~
@33763 = ~«Где находится мемориал?»~
@33764 = ~«Где находится мавзолей?»~
@33765 = ~«Куда ведут западные ворота?»~
@33766 = ~«Это все, что я хотел узнать. Прощай».~
@33767 = ~К тебе подходит жутко выглядящий мужчина с кривой улыбкой на лице. «Здорово, знаток... как дела? Я здешний осведомитель, так что если у тебя найдется медяк в запасе, то я скажу тебе, куда идти и все такое».~
@33768 = ~«Здорово, знаток... как дела? Я здешний осведомитель, так что если у тебя найдется медяк в запасе, то я скажу тебе, куда идти и все такое».~
@33769 = ~«Хооо, клянусь задницей силы... Да ты на самом деле еще сопливее, чем кажешься! Осведомитель — это проводник, знаток».~
@33770 = ~Мужчина хватает твою монету мертвой хваткой и подмигивает. «Отлично! Из этой части Улья есть два выхода: один — на севере и один — на юго-востоке. Да, и если ты ищешь, где бы подраться, то можешь завернуть в переулок на северо-востоке. А еще у нас здесь Управление по борьбе с вредителями и заболеваниями и большой такой рынок».~
@33771 = ~«В центре южной половины этого района... вход — с юга: ты просто иди по южной дороге по линии восток-запад, пока не увидишь его».~
@33772 = ~«В южном крюке, у углового здания в северной половине этого района. Если пойдешь по северной дороге по линии восток-запад, то увидишь его. Куча людей, куча торгашей и все такое».~
@33773 = ~«В другую часть Улья, знаток. Там есть ночлежка, так что если ты устал... или просто ранен... и хочешь немного посопеть...»~
@33774 = ~«Всего лишь в другую часть Улья, знаток. Там ты можешь заиметь пару татуировок, а еще там отличный бар — называется 'Тлеющий труп'».~
@33775 = ~Мужчина пожимает плечами. «Это просто место, где можно немного покуролесить, вот и все... просто ты смахиваешь на бойца, поэтому-то я и сказал. В общем, он на северо-востоке... держись от него подальше, если не ищешь проблем».~
@33776 = ~«Что за осведомитель?»~
@33777 = ~«Конечно... вот медяк».~
@33778 = ~«Больше ничего. Прощай».~
@33779 = ~«Что за осведомитель?»~
@33780 = ~«Конечно... вот медяк».~
@33781 = ~«Больше ничего. Прощай».~
@33782 = ~«Хорошо... вот медяк».~
@33783 = ~«Сейчас мне это не нужно, спасибо. Прощай».~
@33784 = ~«Где находится Управление по борьбе с вредителями и заболеваниями?»~
@33785 = ~«Где находится Рынок?»~
@33786 = ~«Куда ведут северные ворота?»~
@33787 = ~«Куда ведут юго-восточные ворота?»~
@33788 = ~«А что насчет того переулка, о котором ты говорил?»~
@33789 = ~«Это все, что я хотел узнать. Прощай».~
