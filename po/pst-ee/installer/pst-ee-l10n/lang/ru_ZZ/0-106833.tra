@61945 = ~Игнус~
@61946 = ~Вейлор~
@61947 = ~«Те крылья на твоей спине... Кто ты такая?»~
@61948 = ~«Те крылья на твоей спине... Кто ты такая?»~
@61949 = ~«Те крылья на твоей спине... Кто ты такая?»~
@61950 = ~«Могу ли я спросить, госпожа Грация: крылья на твоей спине... ты ведь не человек, верно?»~
@61951 = ~«Могу ли я спросить, госпожа Грация: крылья на твоей спине... ты ведь не человек, верно?»~
@61952 = ~«Могу ли я спросить, госпожа Грация: крылья на твоей спине... ты ведь не человек, верно?»~
@61953 = ~«Как ты получила имя 'Падшая Грация'?»~
@61954 = ~«Почему тебя зовут Падшей Грацией?»~
@61955 = ~«Почему тебя зовут Падшей Грацией?»~
@61956 = ~«Почему тебя зовут Падшей Грацией?»~
@61957 = ~«Как ты получила имя 'Падшая Грация'?»~
@61958 = ~«Можешь рассказать мне, что тебе известно про чувствующих?»~
@61959 = ~«Ты можешь обучить меня чему-нибудь из Искусства, Грация?»~
@61960 = ~«Я хотел бы поговорить о нас...»~
@61961 = ~«Я хотел бы поговорить о наших спутниках...»~
@61962 = ~«Ты вообще пользуешься оружием?»~
@61963 = ~«У меня есть вопросы о нашем путешествии...»~
@61964 = ~«Неважно. Пошли».~
@61965 = ~«На сегодня вопросов больше нет. Прощай».~
@61966 = ~Кири убила Карла Парфидора. Я связался с Робертой, и она выплатила мне мою долю. Все сработали хорошо.~
@61967 = ~Карл Парфидор не даст мне увидеться с Товусом Гильяфом, бюргером Проклятого. Я решил рассказать ему, что его жена Роберта замышляла его смерть. Я надеялся, что из благодарность он позволит мне увидеться с Товусом. Вместо этого он пригрозил мне тюрьмой за сообщничество, если я не уйду.~
@61968 = ~«Акционер Гилтспур хочет, чтобы ты повесил этот рекламный листок».~
@61969 = ~На улицу Протяжных вздохов~
@61970 = ~В Верхний район~
@61971 = ~«У меня есть несколько вопросов...» ~
@61972 = ~«Прощай, Хамрис».~
@61973 = ~~
@61974 = ~«Зачем ты основала бордель?»~
@61975 = ~«Можно почитать твой дневник?»~
@61976 = ~«Ив сказала, что у тебя есть рассказ, которым ты не хочешь с ней делиться».~
@61977 = ~«Я хотел бы послушать твою историю еще раз».~
@61978 = ~«Похоже, что Вришика не испытывает к тебе особой любви».~
@61979 = ~«Можешь рассказать мне об этом символе на моей руке?»~
@61980 = ~«Доводилось ли тебе слышать о ночной ведьме по имени Равель?»~
@61981 = ~«Можешь еще раз сказать, что ты знаешь о Равель?»~
@61982 = ~«Что ты знаешь о Кровавой войне?»~
@61983 = ~«Когда мы были в лабиринте Равель, она сказала, что ты испытала боль... это так?»~
@61984 = ~«На самом деле, у меня есть другие вопросы...»~
@61985 = ~«Неважно. Пошли».~
@61986 = ~«И ты — танарри?»~
@61987 = ~«Как ты попала в Сигил?»~
@61988 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@61989 = ~«Спасибо за объяснение... Идем».~
@61990 = ~«О, не нужно извинений. Я с большим удовольствием сообщу тебе причины, если хочешь».~
@61991 = ~«Зачем ты основала подобное место?»~
@61992 = ~«Зачем ты основала подобное место?»~
@61993 = ~«Если ты из Бездны, как ты попала в Сигил?»~
@61994 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@61995 = ~«Спасибо за объяснение... Идем».~
@61996 = ~«Прошу прощения, госпожа Грация. Я не хотел быть настолько прямолинейным. Мне было просто любопытно».~
@61997 = ~«Так... почему же?»~
@61998 = ~«Просто довольно странно, чтобы суккуб основал подобное заведение... Предназначение этого места противоречит твоему естеству».~
@61999 = ~«Понятно. У меня еще несколько вопросов...»~
@62000 = ~«Неважно. Можно задать тебе еще несколько вопросов?»~
@62001 = ~«Я должен идти. Прощай».~
@62002 = ~«Забудь про объяснения... Пошли».~
@62003 = ~«Я должен идти. Прощай».~
@62004 = ~«Чтобы частично ответить на твой вопрос, тебе следует знать, что я состою в Обществе Восприятия. Наша фракция верит, что каждому необходимо пережить как можно больше всего в мультивселенной».~
@62005 = ~«Из этих порталов выходят какие-нибудь существа?»~
@62006 = ~«И именно поэтому ты основала бордель?»~
@62007 = ~«У меня еще несколько вопросов...»~
@62008 = ~«Понятно. Нет нужды объяснять остальное. Можно задать тебе другие вопросы?»~
@62009 = ~«Я должен идти. Прощай».~
@62010 = ~«Спасибо за объяснение... Идем».~
@62011 = ~«Да, я бы хотел их услышать».~
@62012 = ~«Просто довольно странно, чтобы суккуб основал подобное заведение... Предназначение этого места противоречит твоему естеству».~
@62013 = ~«У меня еще несколько вопросов...»~
@62014 = ~«Я должен идти. Прощай».~
@62015 = ~«Не сейчас. Могу ли я задать тебе другие вопросы?»~
@62016 = ~«Может быть, в другой раз... Пойдем».~
@62017 = ~«Этот бордель призван утолять страсть даже самых заядлых интеллектуалов. Он предназначен для стимуляции разума, повышения знания о себе и других, создания новых способов *познания* другого. Он для тех, кто ищет нечто большее, нежели низменные телесные удовольствия, которых и так достаточно в Улье и Нижнем районе».~
@62018 = ~«Ну я бы не стал называть их низ.. э-э-э, то есть, я могу понять это. Значит, бордель — это что-то типа школы?»~
@62019 = ~«Понимаю. Это заведение поощряет интеллектуальные виды состязаний, а не, э-э-э, *другие* виды. Так значит, бордель — это что-то вроде учебного заведения?»~
@62020 = ~«Могу ли я задать тебе другие вопросы?»~
@62021 = ~«Спасибо за объяснение... Идем».~
@62022 = ~«Когда-то я был магом, но свернул с пути Искусства. Я хочу снова вернуться на этот путь».~
@62023 = ~«Да. Я надеюсь, что, обучаясь искусству говорить и его тонкостям, посетители и ученики смогут узнать о себе что-то новое. Каждый ограничен лишь своим владением речью. Умение с помощью слов вызывать эмоции — колоссальный навык».~
@62024 = ~«Если ты из Бездны, как ты попала в Сигил?»~
@62025 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62026 = ~«Спасибо за объяснение... Идем».~
@62027 = ~«Верно. Я — низшая танарри, а точнее, суккуб, — она тихонько вздыхает. — Боюсь, что мы уж слишком распространенные на Нижних планах и в других местах, что не в нашу пользу. Большинство представителей моей расы проводят свое время, соблазняя мертвых различными плотскими утехами».~
@62028 = ~«А ты?..»~
@62029 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62030 = ~«Я услышал достаточно. Идем».~
@62031 = ~«Я — низшая танарри, а точнее, суккуб, — она тихонько вздыхает. — Боюсь, что мы уж слишком распространенные на Нижних планах и в других местах, что не в нашу пользу. Большинство представителей моей расы проводят свое время, соблазняя смертных различными плотскими утехами».~
@62032 = ~«А ты?..»~
@62033 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62034 = ~«Я услышал достаточно. Идем».~
@62035 = ~«Хотелось бы думать, что я дистанцировалась от всего этого... В конце концов, это слишком примитивный и непродуктивный способ тратить свое время в мультивселенной. Ведь есть гораздо более интересные занятия, не так ли?»~
@62036 = ~«Пожалуй, да. Могу ли я задать тебе другие вопросы?»~
@62037 = ~«Я услышал достаточно. Идем».~
@62038 = ~«Чувствующие — это фракция Сигила, посвященная переживаниям. Без переживаний и ощущений большая часть мультивселенной для нас недоступна. Поэтому чувствующие стремятся пережить как можно больше: пережив все на свете, можно раскрыть истину мультивселенной».~
@62039 = ~«Интересная философия. Могу ли я присоединиться к чувствующим?»~
@62040 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62041 = ~«Я услышал достаточно. Идем».~
@62042 = ~«Чтобы присоединиться к чувствующим, достаточно быть учеником жизни».~
@62043 = ~«Я имел в виду, что хотел бы присоединиться к фракции».~
@62044 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62045 = ~«Я услышал достаточно. Идем».~
@62046 = ~«Конечно... прости, что поддразниваю, — Грация кивает. — Если желаешь присоединиться к чувствующим — попытай счастья в Городском Фестхолле. Кто-нибудь там должен тебе помочь».~
@62047 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62048 = ~«Хорошо. Идем».~
@62049 = ~«Кровавая война — это конфликт, бушующий на Нижних планах между баатезу и танарри. Они бьются друг с другом, дабы выяснить, какое зло должно главенствовать — упорядоченное или хаотическое, — Падшая Грация делает паузу. — Лучше избегать этой войны любой ценой. Пусть танарри и баатезу толкут друг другу морды и позволят остальным планам пребывать в мире... или, как минимум, в относительном мире».~
@62050 = ~«Относительном?»~
@62051 = ~«Они используют людскую пехоту?»~
@62052 = ~«Сколько она уже продолжается?»~
@62053 = ~«Ты на ней служила?»~
@62054 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62055 = ~«Я услышал достаточно. Идем».~
@62056 = ~«Ну, война настолько велика, что большинство рас втягиваются в нее против своей воли. Игнорировать ее так же опасно, как и участвовать в ней».~
@62057 = ~«Они используют людскую пехоту?»~
@62058 = ~«Сколько она уже продолжается?»~
@62059 = ~«Ты на ней служила?»~
@62060 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62061 = ~«Я услышал достаточно. Идем».~
@62062 = ~«Да, такое случается. В Кровавой войне участвует множество человеческих наемников. Они служат либо в качестве солдат, либо в качестве пушечного мяса, либо в качестве провианта для нечистых».~
@62063 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62064 = ~«Сколько она уже продолжается?»~
@62065 = ~«Ты на ней служила?»~
@62066 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62067 = ~«Я услышал достаточно. Идем».~
@62068 = ~«Согласно летописям, Кровавая война идет с тех пор, как баатезу впервые повстречали танарри... *очень* давно. Я даже не уверена, что у людей найдется подходящее название такому отрезку времени, — Падшая Грация качает головой. — Боюсь, что баатезу и танарри никогда не нравились друг другу».~
@62069 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62070 = ~«Они используют людскую пехоту?»~
@62071 = ~«Ты на ней служила?»~
@62072 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62073 = ~«Я услышал достаточно. Идем».~
@62074 = ~«Нет. Моя мать служила. Суккубы в основном соблазняют смертных, чтобы забрать их души в Бездну и породить больше танарри, и чтобы те шли умирать на Кровавую войну».~
@62075 = ~«Твоя мать? Она служила на Кровавой войне?»~
@62076 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62077 = ~«Они используют людскую пехоту?»~
@62078 = ~«Сколько она уже продолжается?»~
@62079 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62080 = ~«Я услышал достаточно. Идем».~
@62081 = ~«Да. Она была одной из лучших. Она соблазнила бесчисленное множество смертных мужчин. Теперь она живет в Бездне, продает в рабство своих детей».~
@62082 = ~«Тебя... продала в рабство твоя мать?»~
@62083 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62084 = ~«Они используют людскую пехоту?»~
@62085 = ~«Сколько она уже продолжается?»~
@62086 = ~«Эти вопросы тебя не сильно беспокоят?»~
@62087 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62088 = ~«Я услышал достаточно. Идем».~
@62089 = ~«На некоторое время. Я вырвала свободу в соревновании на импровизацию. Это было очень давно».~
@62090 = ~«Кому она тебя продала?»~
@62091 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62092 = ~«Они используют людскую пехоту?»~
@62093 = ~«Сколько она уже продолжается?»~
@62094 = ~«Эти вопросы тебя не сильно беспокоят?»~
@62095 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62096 = ~«Я услышал достаточно. Идем».~
@62097 = ~«О чем они толковали?»~
@62098 = ~«Я должен идти. Прощай».~
@62099 = ~«Башню?»~
@62100 = ~«У меня еще несколько вопросов...»~
@62101 = ~«Я должен идти. Прощай».~
@62102 = ~«Какой ключ?»~
@62103 = ~«Может, секрет как раз в том, что чтобы попасть туда, нужно не хотеть туда попасть...»~
@62104 = ~«Скажи мне, где находится этот портал».~
@62105 = ~«Она продала мена баатезу. Наверное, она считала, что они просто убьют меня. Несмотря на познания в других областях, она очень мало знала об их культуре».~
@62106 = ~«Она продала тебя заклятым врагам танарри?»~
@62107 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62108 = ~«Они используют людскую пехоту?»~
@62109 = ~«Сколько она уже продолжается?»~
@62110 = ~«Эти вопросы тебя не сильно беспокоят?»~
@62111 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62112 = ~«Я услышал достаточно. Идем».~
@62113 = ~«Да, — Падшая Грация расправляет плечи. — Ты хотел узнать что-нибудь еще?»~
@62114 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62115 = ~«Они используют людскую пехоту?»~
@62116 = ~«Сколько она уже продолжается?»~
@62117 = ~«Эти вопросы тебя не сильно беспокоят?»~
@62118 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62119 = ~«Я услышал достаточно. Идем».~
@62120 = ~«О, нет-нет, вовсе нет. Лучше помни вот о чем: Кровавая война стоит за большинством событий на планах. Важно понимать, что она из себя представляет и зачем ведется».~
@62121 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@62122 = ~«Они используют людскую пехоту?»~
@62123 = ~«Сколько она уже продолжается?»~
@62124 = ~«Ты на ней служила?»~
@62125 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@62126 = ~«Я услышал достаточно. Идем».~
@62127 = ~«Мне знакомо это имя, — Падшая Грация умолкает и какое-то время размышляет. — Вокруг этого имени роится очень много слухов. Многие считают ее выдумкой, но я подозреваю, что она действительно существует, и что в свое время она произвела неизгладимое впечатление на Клетку, пребывая здесь». Она озадаченно смотрит на тебя. «А почему ты спрашиваешь?»~
@62128 = ~«Я намерен ее разыскать».~
@62129 = ~«Неважно. У меня есть другие вопросы...»~
@62130 = ~«Просто так... Я услышал достаточно. Идем».~
@62131 = ~Грация поднимает бровь. «Правда? Не могу не спросить: зачем?»~
@62132 = ~«Мне нужна информация, которой она располагает».~
@62133 = ~«Неважно. У меня есть другие вопросы...»~
@62134 = ~«Просто так... Я услышал достаточно. Идем».~
@62135 = ~«И эта информация больше никому недоступна?»~
@62136 = ~«Подозреваю, что только Равель владеет нужными мне знаниями».~
@62137 = ~«Неважно. У меня есть другие вопросы...»~
@62138 = ~«Не знаю, но я намерен это выяснить. Пошли».~
@62139 = ~Грация мягко кладет свою руку на твою. «Подумай: если Равель действительно существует, то она чрезвычайно могущественна и коварна. Если рассказы о ее деяниях хоть отчасти верны, то она — существо, открывшее новые определения слова 'зло'. Найти ее — задача не из простых». ~
@62140 = ~«Я осознаю это».~
@62141 = ~«Что ж, легенды мне еще не встречались. Прогулочка будет что надо, — она улыбается. — Разве ты не пробовал заниматься чем-то скучным?»~
@62142 = ~«Нет, не пробовал... Тебе известно еще что-нибудь о Равель?»~
@62143 = ~~
@62144 = ~~
@62145 = ~«Ничего не могу с этим поделать. Можно задать тебе еще пару вопросов?»~
@62146 = ~«Возможно, и делал — в прошлых своих воплощениях, но не теперь. Идем».~
@62147 = ~«Поговаривают, что она была одной из ведьм Серой пустоши. Многие уверены, что силой и коварством она намного превзошла своих сестер. Давным-давно она пришла в Сигил; ходят слухи, что кроме зла, которое она там сотворила, своими поступками она поставила под угрозу саму Клетку. Сейчас о ней слышно только в байках, она — персонаж детских сказок, — Грация делает паузу. — Полагаю, Леди Боли разобралась с ней так же, как и со всеми угрозами Сигилу».~
@62148 = ~«Как?»~
@62149 = ~«Что такое Серая пустошь?»~
@62150 = ~«Кто еще может знать о ней что-нибудь?»~
@62151 = ~«Могу ли я задать тебе другие вопросы?»~
@62152 = ~«Понятно. Идем».~
@62153 = ~«Скорее всего, Равель попала в лабиринт, в одну из тюрем Леди».~
@62154 = ~«Лабиринт? Это еще что такое?»~
@62155 = ~«Что такое Серая пустошь?»~
@62156 = ~«Кто еще может знать о ней что-нибудь?»~
@62157 = ~«Могу ли я задать тебе другие вопросы?»~
@62158 = ~«Понятно. Идем».~
@62159 = ~«Гиблый план, находящийся как раз посередине между Баатором и Бездной. Чаще всего он становится полем битвы в Кровавой войне».~
@62160 = ~«Ты знаешь, что случилось с Равель?»~
@62161 = ~«Довольно о Равель... Что такое Кровавая война?»~
@62162 = ~«Кто еще может знать о ней что-нибудь?»~
@62163 = ~«Могу ли я задать тебе другие вопросы?»~
@62164 = ~«Понятно. Идем».~
@62165 = ~«Кто-нибудь в Фестхолле может знать о ней больше».~
@62166 = ~«Ты знаешь, что случилось с Равель?»~
@62167 = ~«Что такое Серая пустошь?»~
@62168 = ~«Могу ли я задать тебе другие вопросы?»~
@62169 = ~«Тогда, наверно, мы туда направимся. Пошли».~
@62170 = ~NULL~
@62171 = ~«Смысл имен — сложная тема. Тут много рассказывать, и большую часть лучше оставить недосказанной».~
@62172 = ~«Падшая Грация — это твое настоящее имя?»~
@62173 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@62174 = ~«Всегда рад тебя видеть, друг. Возьми эти два заклинания: они тебе могут пригодятся. А теперь, с твоего позволения, я вернусь к своим делам».~
@62175 = ~«Тогда больше не будем об этом. Пошли».~
@62176 = ~«Может быть, — она улыбается. — А может быть, и нет. Есть имена, которыми нарекают, а есть — которые заслуживают. Кому судить, которое из них настоящее?»~
@62177 = ~«Прощай».~
@62178 = ~«Мне кажется, что заслуженное имя имеет больший вес».~
@62179 = ~«Мне кажется, что нареченное имя имеет больший вес».~
@62180 = ~«Спасибо, Себастион».~
@62181 = ~«Не уверен, что в именах есть какая-либо ценность».~
@62182 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@62183 = ~«Тогда больше не будем об этом. Пошли».~
@62184 = ~«Возможно, таки и есть. Почему тебе так кажется?»~
@62185 = ~«Потому что заслуженное имя неслучайно; оно говорит о том, чего ты достиг».~
@62186 = ~«Возможно, таки и есть. Почему тебе так кажется?»~
@62187 = ~«Потому что по нему люди воспринимают тебя. А их восприятие может перевесить твое самоосознание».~
@62188 = ~Он с любопытством глядит на тебя: «Правда?»~
@62189 = ~«Имя — всего лишь покров из букв, скрывающий человека, не более. Иногда имя может рассказать тебе кое-что о человеке, может даже помочь определить этого человека. Однако имя — это не то, чем этот человек *является*».~
@62190 = ~Грация кивает. «Верно подмечено».~
@62191 = ~«Так почему же тебя зовут Падшей Грацией?»~
@62192 = ~«Так почему же тебя зовут Падшей Грацией?»~
@62193 = ~«Так почему же тебя зовут Падшей Грацией?»~
@62194 = ~«Не все ли равно? — она улыбается. — Это заслуженное имя».~
@62195 = ~«Для меня это важно. Я хотел бы знать, как ты получила это имя».~
@62196 = ~«Не все ли равно? — она улыбается. — Это нареченное имя».~
@62197 = ~«Для меня это важно. Я хотел бы знать, как ты получила это имя».~
@62198 = ~«Не все ли равно? — она улыбается. — Это всего лишь покров из букв».~
@62199 = ~«Для меня это важно. Я хотел бы знать, как ты получила это имя».~
@62200 = ~«Я пала в глазах своего народа... Может быть, кто-то скажет наоборот, вознеслась, но слово 'падшая' мне больше *подходит*, — она вопросительно смотрит на тебя. — Ведь в этом есть какой-то смысл?» ~
@62201 = ~«Да. В конце концов, слово 'падшая' несет в себе чувство утраты».~
@62202 = ~«Да. Можно задать тебе еще пару вопросов?»~
@62203 = ~«Да... Кажется, я понимаю. Пойдем».~
@62204 = ~Умолкнув на мгновение, Падшая Грация задумчиво кивает. «Да... наверно, потому оно и кажется мне таким. Я... уже давно смирилась с утратой, но имя осталось».~
@62205 = ~«Ты уверена, что смирилась с этим?»~
@62206 = ~«Ты уверена, что смирилась с этим? Похоже, Равель другого мнения».~
@62207 = ~«Ты уверена, что смирилась с этим?»~
@62208 = ~«Ты уверена, что смирилась с этим? Похоже, Равель другого мнения».~
@62209 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@62210 = ~«Понятно. Идем».~
@62211 = ~Падшая Грация встречается с тобой взглядом, и тебя вновь поражает сверкающая синева ее глаз... Они беспокойны, словно океан перед бурей. «Я так считала раньше. И все же, поговорив с тобой, я кое-что поняла, — она улыбается. — Спасибо тебе».~
@62212 = ~«Ну, если хочешь поговорить об этом — дай мне знать, хорошо?»~
@62213 = ~«Ну, если хочешь поговорить об этом — дай мне знать, хорошо?»~
@62214 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@62215 = ~«Ладно. Идем».~
@62216 = ~Она кивает. «Ты так добр. Я обязательно так и сделаю».~
@62217 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@62218 = ~«Ладно. Идем».~
@62219 = ~Грация соединяет пальцы так, чтобы ладони образовали подобие круга. «Говорят, что Леди обладает способностью брать части Сигила...» Ты с удивлением видишь, как призрачный образ мизинца Грации отделяется от руки и сам по себе парит в воздухе, вращаясь вдоль небольшого круга. «...и делать из них лабиринт».~
@62220 = ~«Продолжай...»~
@62221 = ~«Понятно. Расскажи мне о плане, из которого родом Равель... о Серой пустоши».~
@62222 = ~«Думаю, я понял. Кто-нибудь еще может знать больше о Равель?»~
@62223 = ~«Неважно. Можно задать тебе другие вопросы?»~
@62224 = ~«Понятно. Это все, что я хотел узнать. Идем».~
@62225 = ~Небольшой призрачный круг парит в воздухе, затем начинает медленно вращаться. «В эту часть Сигила она помещает узника. Попав в лабиринт, выбраться из него уже нельзя. Это может случиться в любое время, пока ты гуляешь по улице, входишь через дверь, — она резко хлопает в ладони, — и вдруг оказываешься в другом месте». Внутри призрачного круга ты неожиданно замечаешь мерцающее движение, как будто внутри кто-то бродит.~
@62226 = ~«Продолжай...»~
@62227 = ~«Понятно. Расскажи мне о плане, из которого родом Равель... о Серой пустоши».~
@62228 = ~«Думаю, я понял. Кто-нибудь еще может знать больше о Равель?»~
@62229 = ~«Неважно. Можно задать тебе другие вопросы?»~
@62230 = ~«Понятно. Это все, что я хотел узнать. Идем».~
@62231 = ~Грация продолжает; крошечный призрачный лабиринт отражается в ее глазах. «Говорят, что в каждом лабиринте есть портал наружу, но найти его нелегко. Возможно, их оставили для того, чтобы дать узнику надежду. А, может, для того, чтобы помучить его». Призрачный лабиринт меркнет. «Наверно, и для того, и для другого».~
@62232 = ~«Понятно. Расскажи мне о плане, из которого родом Равель... о Серой пустоши».~
@62233 = ~«Думаю, я понял. Кто-нибудь еще может знать больше о Равель?»~
@62234 = ~«Неважно. Можно задать тебе другие вопросы?»~
@62235 = ~«Понятно. Это все, что я хотел узнать. Идем».~
@62236 = ~«Это точно. Не могу винить ее за это».~
@62237 = ~«А что она имела в виду, говоря, что ты — подстилка баатезу?»~
@62238 = ~«А что она имела в виду, говоря, что ты — подстилка баатезу?»~
@62239 = ~«А что она имела в виду, говоря, что ты — подстилка баатезу?»~
@62240 = ~«Почему?»~
@62241 = ~«Могу ли я задать тебе другие вопросы?»~
@62242 = ~«Понятно. Это все, что я хотел узнать. Идем».~
@62243 = ~«Мы уже говорили об этом. Некоторое время я была рабыней баатезу. Тогда они подвергали меня различным пыткам».~
@62244 = ~«Ну, меня больше интересует упомянутая Вришкой часть насчет 'подстилки баатезу'. Что она под этим подразумевала?»~
@62245 = ~«Тогда неважно. Почему ты сказала, что не можешь винить Вришку за ее ненависть к тебе?»~
@62246 = ~«Могу ли я задать тебе другие вопросы?»~
@62247 = ~«Это все, что я хотел узнать. Идем».~
@62248 = ~«Какое-то время я была рабыней баатезу — это было много лет назад. Я вырвала себе свободу в соревновании на импровизацию». ~
@62249 = ~«Ну, меня больше интересует упомянутая Вришкой часть насчет 'подстилки баатезу'. Что она под этим подразумевала?»~
@62250 = ~«Понятно. Почему ты сказала, что не можешь винить Вришку за ее ненависть к тебе?»~
@62251 = ~«Могу ли я задать тебе другие вопросы?»~
@62252 = ~«Это все, что я хотел узнать. Идем».~
@62253 = ~«Ты ведь помнишь, что я рассказывала тебе о моем прошлом?»~
@62254 = ~«Ну, меня больше интересует упомянутая Вришкой часть насчет 'подстилки баатезу'. Что она под этим подразумевала?»~
@62255 = ~«Тогда неважно. Почему ты сказала, что не можешь винить Вришку за ее ненависть к тебе?»~
@62256 = ~«Могу ли я задать тебе другие вопросы?»~
@62257 = ~«Понятно. Это все, что я хотел узнать. Идем».~
@62258 = ~В лице Падшей Грации отражается любопытство... Она некоторое время тебя рассматривает, пытаясь прочесть выражение твоего лица. Потом приглушенным голосом спрашивает: «Это важно?»~
@62259 = ~«Для меня — да. Я хотел бы знать, с кем путешествую».~
@62260 = ~«Нет. Почему ты сказала, что не можешь винить Вришку за ее ненависть к тебе?»~
@62261 = ~«Могу ли я задать тебе другие вопросы?»~
@62262 = ~«Это все, что я хотел узнать. Идем».~
@62263 = ~«Чтобы ответить на твой вопрос, я скажу тебе вот что: баатезу — не люди. Их страсть — это власти, а не плоть, и им нет дела до того похоти и насилия, которая бывает у людей, когда те держат в плену других людей. Пытки баатезу намного более утонченные и увечные, в сравнении *любым* насилием над плотью, и шрамы от них не затягиваются еще долгое время. Ты это хотел узнать?» ~
@62264 = ~«Да. Я просто хотел понять, с кем я путешествую».~
@62265 = ~«Да. Почему ты сказала, что не можешь винить Вришку за ее ненависть к тебе?»~
@62266 = ~«Могу ли я задать тебе другие вопросы?»~
@62267 = ~«Это все, что я хотел узнать. Идем».~
@62268 = ~«Я думала, что ты это уже узнал, — Падшая Грация опускает голову. — Я ошибалась».~
@62269 = ~«Почему ты сказала, что не можешь винить Вришку за ее ненависть к тебе?»~
@62270 = ~«Могу ли я задать тебе другие вопросы?»~
@62271 = ~«Это все, что я хотел узнать. Идем».~
@62272 = ~«Вришка — танарри, нечистый дух, как и я, но только другого вида — алу-демон. Чтобы понять Вришику, ты должен понимать, что культура танарри — это хаос, а хаос по своей природе не имеет ничего общего с честностью и справедливостью. Алу-демонов рассматривают как нечто... ненужное. Бесполезное. Во многих смыслах это даже хуже, чем смертный приговор».~
@62273 = ~«А что она имела в виду, говоря, что ты — подстилка баатезу?»~
@62274 = ~«А что она имела в виду, говоря, что ты — подстилка баатезу?»~
@62275 = ~«А что она имела в виду, говоря, что ты — подстилка баатезу?»~
@62276 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62277 = ~«Это все, что я хотел узнать. Идем».~
@62278 = ~Падшая Грация на мгновение умолкает, ее взгляд становится отдаленным. Когда она возвращается к тебе, в ее глазах появляется странный лазурный оттенок, говорящий о печали и слезах.~
@62279 = ~«Равель видит многое своими черно-ежевичными глазами. Она видит вещи, скрытые от других глаз, даже саму природу вещей, — она медленно качает головой. — Иногда... иногда боль дает о себе знать. Я поняла, насколько это *трудно* — идти против своей природы».~
@62280 = ~«С тобой все в порядке?»~
@62281 = ~«С тобой все в порядке?»~
@62282 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62283 = ~«Это все, что я хотел узнать. Идем».~
@62284 = ~Она едва заметно улыбается. Вы встречаетесь взглядами. «Да... как мило, что ты спросил. Боль все еще дает о себе знать, но я смирилась со своей сущностью много веков назад».~
@62285 = ~«Ну хорош...»~
@62286 = ~Грация перебивает тебя: «Спасибо тебе за то, что спрашиваешь о моем состоянии. Я приветствую твое участие».~
@62287 = ~«Просто хотел убедиться, что ты в порядке. У меня есть другие вопросы».~
@62288 = ~«Конечно. Просто проверял, все ли с тобой хорошо. Идем».~
@62289 = ~Падшая Грация еле заметно качает головой. «Нет, не думаю. Искусство... отличается от дисциплин, которые я практикую».~
@62290 = ~«Что ты имеешь в виду?»~
@62291 = ~«Неважно. Можно задать тебе еще несколько вопросов?»~
@62292 = ~«Это все, что я хотел узнать. Идем».~
@62293 = ~«Мои 'силы', какими ты их видишь, берут начало из моей веры — это не манипуляции с энергией, как в случае Искусства. Искусство — это *механизм*, с помощью которого можно подчинять себе силы мультивселенной посредством жестов, ритуалов и устройств. Мои 'силы' приходят ко мне иными путями. Моя вера и сущность моих убеждений позволяют мне приоткрывать часть самой мультивселенной».~
@62294 = ~«Сущность твоих убеждений? Во что ты веришь?»~
@62295 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@62296 = ~«Это все, что я хотел узнать. Идем».~
@62297 = ~«Я верю в *Чувственный опыт*. Я верю, что человек может меняться, меняться к лучшему: чем большая часть мультивселенной доступна ему для восприятия, тем больше мультивселенная позволяет ему понять. Моя вера в сущность Чувственного опыта позволяет мне...» Она на миг умолкает, задумавшись. ~
@62298 = ~Ты подходишь к месту расположения портала, о котором говорил тот мальчишка, Лазло. Ты начинаешь прокручивать в голове ваш с ним разговор. Ты вспоминаешь свои слова: «Может, секрет как раз в том, что чтобы попасть туда, нужно не хотеть туда попасть...»~
@62299 = ~Подавить в себе малейшее желание войти в башню.~
@62300 = ~Уйти.~
@62301 = ~Morte Taunts 3~ [MRT316]
@62302 = ~Morte Taunts 4~ [MRT317]
@62303 = ~Morte Taunts 5~ [MRT318]
@62304 = ~Morte Taunts 6~ [MRT319]
@62305 = ~Morte Taunts 7~ [MRT459A]
@62306 = ~Morte Taunts 8~ [MRT321]
@62307 = ~Morte Taunts 9~ [MRT322]
@62308 = ~Morte Taunts 10~ [MRT323]
@62309 = ~Morte Taunts 11~ [MRT324]
@62310 = ~Morte Taunts 12~ [MRT325]
@62311 = ~Morte Taunts 13~ [MRT326]
@62312 = ~Morte Taunts 14~ [MRT327]
@62313 = ~Morte Taunts 15~ [MRT328]
@62314 = ~Morte Taunts 16~ [MRT329]
@62315 = ~Morte Taunts 17~ [MRT330]
@62316 = ~Morte Taunts 18~ [MRT331]
@62317 = ~Morte Taunts 19~ [MRT332]
@62318 = ~Morte Taunts 20~ [MRT333]
@62319 = ~Morte Taunts 21~ [MRT334]
@62320 = ~Morte Taunts 22~ [MRT335D]
@62321 = ~Morte Taunts 23~ [MRT322AL]
@62322 = ~Annah Morale 6~ [ANA017]
@62323 = ~Annah Happy 4~ [ANA022]
@62324 = ~Annah Annoyed 10~ [ANA040A]
@62325 = ~Annah Serious 1~ [ANA043A]
@62326 = ~Annah Tired 1~ [ANA074B]
@62327 = ~Annah Bored 8~ [ANA098A]
@62328 = ~Annah Hurt (Was Damage 1)~ [ANA127C]
@62329 = ~Annah Damage 2~ [ANA128C]
@62330 = ~Annah Dying 1~ [ANA138F]
