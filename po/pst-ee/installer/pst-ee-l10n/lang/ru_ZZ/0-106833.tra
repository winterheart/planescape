@46902 = ~Nordom Location, Clerk's Ward (Upper Class Part of Town) 1~ [NOR041]
@46903 = ~Nordom Location, Lower Ward (Industrial Part of Town) 1~ [NOR042]
@46904 = ~Nordom Location, Ravel's Maze (Extradimensional prison) 1~ [NOR043]
@46905 = ~Nordom Location, Baator (Hell) 1~ [NOR044]
@46906 = ~«Ладно. Прощай».~
@46907 = ~«Он верящий, сэр, истинный верящий. Однако у него часто меняется настроение, и все эти странствия по мультивселенной не могут не сказаться на голове. Ты либо теряешь общую картину, либо получаешь слишком много. Так или иначе, это не к добру. Надеюсь, он вернется в целости и сохранности».~
@46908 = ~«Что ж, посмотрим. Прощай».~
@46909 = ~«Приветствую, сэр. Вас прислал Кельдор? Сандоз зашел туда и вот уже целый день беснуется и что-то бормочет за дверью. Надеюсь, вы сможете что-нибудь с ним сделать».~
@46910 = ~«На этот счет посмотрим». Крикнуть через дверь: «Сандоз! Нужно поговорить!»~
@46911 = ~«Хотите поговорить с Сандозом, сэр? Удачи...»~
@46912 = ~«Спасибо». Крикнуть через дверь: «Сандоз! Нужно поговорить!»~
@46913 = ~«Сэр». Похоже, стражник не желает продолжать разговор.~
@46914 = ~«Прощай».~
@46915 = ~«Ладно, я ухожу. Прощай».~
@46916 = ~Голос Сандоза приглушен толщей двери. «Чего тебе надо?» В его голосе звучит отчаяние и одиночество.~
@46917 = ~«Я пришел поговорить с тобой, Сандоз».~
@46918 = ~«Я пришел передать тебе слова твоей дочери».~
@46919 = ~«Я пришел сказать тебе, как разом покончить с этим».~
@46920 = ~«Мне сказали, что мне следует поговорить с тобой. Полагаю, никто не хочет твоей смерти».~
@46921 = ~«Ничего. Прощай».~
@46922 = ~Голос обрывается, «Кто еще это может быть? Это мои комнаты, это моя фракция, — он горько смеется. — Здесь я и умру».~
@46923 = ~«Расскажи мне о себе, Сандоз».~
@46924 = ~«Ты хочешь услышать, что твоя дочь просила тебе передать?»~
@46925 = ~«Что ж, тогда удачи. Никому до тебя дела нет».~
@46926 = ~«Мне сказали, что мне следует поговорить с тобой. Полагаю, никто не хочет твоей смерти».~
@46927 = ~«Хочешь поговорить? Действительно хочешь? А, может, лучше послушаешь? — голос замолкает, будто разогреваясь. — Зачем все это — вот что я хочу знать. Зачем мы делаем то, что мы делаем? Что заставляет нас двигаться вперед, а?»~
@46928 = ~Подождать, пока он не продолжит.~
@46929 = ~«Я бы сказал, что сама жизнь движет нас вперед».~
@46930 = ~«Не знаю, что?»~
@46931 = ~Следует пауза. Голос звучит вновь, еще более надломлено, чем раньше. «Ты говорил с моей дочерью?»~
@46932 = ~«Да. Вот, что она сказала: Вся жизнь — это испытание. Никто не может проскочить напрямую к его завершению. Это не ответ. Только хранители рока и тленные верят в полное разрушение — и за это ты всегда их презирал. Вспомни об этом».~
@46933 = ~«Да, и она сказала, что ты можешь покончить собой, если хочешь».~
@46934 = ~Он гулко смеется, словно пустая бочка. «Она так и сказала? Погоди-ка минуту».~
@46935 = ~«Можешь не спешить».~
@46936 = ~Ты слышишь приглушенный всхлип и проклятие. Через мгновение раздается скрежетание дерева по полу, внезапное движение и безошибочно узнаваемый хруст ломающихся костей.~
@46937 = ~«Чему быть, того не миновать...»~
@46938 = ~Когда он говорит снова, голос звучит более уравновешенно. «Ступай вниз и скажи Кельдору, что ты вразумил меня. Скоро мне нужно будет с ним увидеться... но ты свою работу сделал. А теперь уходи».~
@46939 = ~«Спасибо. Прощай».~
@46940 = ~«Понятно... послали ко мне обеспокоенного чужака, чтобы вразумить меня, да? Ха! — голос затихает до заговорщицкого шепота. — Они пообещали принять тебя, если ты сходишь поговорить со мной? Они подумали, что это сделает тебя более заботливым?»~
@46941 = ~Подождать, пока он не продолжит.~
@46942 = ~«Я просто хотел помочь».~
@46943 = ~«Ну? Так говори уже! Или ты внезапно онемел? Ха! Если бы ты видел хоть половину того, что видел я... половину всех вещей, что я узрел...»~
@46944 = ~«Что ты видел?»~
@46945 = ~«Ты себе даже не представляешь, что видел *я*, Сандоз, и, как видишь, покончить с собой я не грожусь, ведь так? Приятель, возьми себя в руки и немного повзрослей».~
@46946 = ~«Тогда, возможно, для тебя будет лучше погрузить себя в сладкое забытье...»~
@46947 = ~«Я видел невообразимые ужасы. Видел искаженного, измученного бога, окруженного смеющейся нечистью. Я видел, как слой Бездны влился в сущность единой личности... Я видел, как исказились все законы природы, и видел, как все правды человеческие встали с ног на голову. Все это для меня утратило смысл и стало невыносимым! Зачем, я тебя спрашиваю, в чем смысл?»~
@46948 = ~«В этом заключается основа философии боголюдей, Сандоз. Просто помни, что ты проходишь испытания. Теперь ты понимаешь или хотя бы видишь все, через что ты прошел. Посмотри на деяния рук твоих, и спроси себя, чему ты должен был научиться».~
@46949 = ~«В этом заключается основа философии боголюдей, Сандоз. Просто помни, что ты проходишь испытания. Теперь ты понимаешь или хотя бы видишь все, через что ты прошел. Посмотри на деяния рук твоих, и спроси себя, чему ты должен был научиться».~
@46950 = ~«В этом заключается основа философии боголюдей, Сандоз. Просто помни, что ты проходишь испытания. Теперь ты понимаешь или хотя бы видишь все, через что ты прошел. Посмотри на деяния рук твоих, и спроси себя, чему ты должен был научиться».~
@46951 = ~«Не знаю в, чем заключается смысл всего, но думаю, что смысл жизни — в самой жизни».~
@46952 = ~«Смысла нет».~
@46953 = ~Он горько сплевывает. Вы слышите как слюна попадает в дверь. «Пошел прочь, пока не отрастишь себе мозг, или найди кого-нибудь, кто даст тебе ответы». После этого он ни на что не отвечает.~
@46954 = ~«Тогда прощай».~
@46955 = ~~
@46956 = ~Он издает лающий смех. «По крайней мере, они тебя хорошо натаскали. Мне нужно подумать над этим. Надеюсь, ты не торопишься».~
@46957 = ~«В моем распоряжении время всего мира, Сандоз. Ты думай, не торопись».~
@46958 = ~За дверью слышится короткий, острый вздох, а затем низкий, недовольный смешок. «А ты не очень-то вежлив, да? А если я тебе скажу, что моя голова уже в петле?»~
@46959 = ~«Тогда я скажу тебе, что тебе пора перестать делать из себя посмешище и посмотреть действительности в глаза. Самоубийство ничего не изменит. Оно только докажет, что ты не прошел свое испытание».~
@46960 = ~«Кишка у тебя тонка. Честно говоря, если ты такой трус, что хочешь себя убить, то думаю, тебе просто не хватит духа довести начатое до конца».~
@46961 = ~«Ты... Ну ладно... дай мне минуту все обдумать...»~
@46962 = ~«Можешь не спешить».~
@46963 = ~«Гордыня! Гордыня и самомнение! Мы продолжаем себе говорить, что мы представляем из себя что-то, значим что-то, что есть причина, по которой мы есть, но в конце... в конце есть только чернота. Я *видел* черноту, которой все заканчивается, и бессмысленно это отрицать. Но мы продолжаем тешить себя глупой гордыней. В этом нет ни какого смысла».~
@46964 = ~«Ты не задумывался, что стал богочеловеком не просто так?»~
@46965 = ~«Теперь, когда ты упомянул об этом, я понимаю, что ты прав...»~
@46966 = ~«О чем это ты?»~
@46967 = ~«Однажды ты нашел причину. Ты верил, что мы все проходим испытание. Ты верил, что мы все должны пройти через эту конечную черноту, преодолеть ее. Не говори теперь, что ослабел».~
@46968 = ~«Почему ты присоединился к боголюдям?»~
@46969 = ~«Потому что я думал, что в этом есть смысл. Я ошибался. Смысла нет. Любовь, семья, богатство, достижения... все это пустышки».~
@46970 = ~«Все? Я могу тебя как-нибудь переубедить?»~
@46971 = ~«Но жизнь продолжается. Ты стал богочеловеком, потому что верил в шанс сотворения чего-либо великолепного. Пройди это испытание, Сандоз, и станешь сильнее, чем прежде».~
@46972 = ~«Найди кого-нибудь, кто сможет меня переубедить, кого-то, кто мне скажет иначе. Похоже, сам ты не можешь... так что поищи других». Он отходит от двери, и разговор продолжать невозможно.~
@46973 = ~«Я еще вернусь».~
@46974 = ~«Я обязан тебе жизнью, чужак. Я не забуду этого. Но сейчас мне нужно кое-что обдумать. Надеюсь, ты меня простишь за то, что я не стану с тобой сейчас разговаривать».~
@46975 = ~«Конечно. Прощай».~
@46976 = ~АРБАЛЕТНЫЕ СТРЕЛЫ ЗЕФИРА
Урон: 2-5 колющий
Магический урон: +1
THAC0: +1
Скорость: 10
Вес: 0
Специализация: снаряды

Эти арбалетные стрелы имеют наконечники с бороздками по бокам. Они наносят урона не больше, чем обычные стрелы, однако несут на себе слабое заклятье, которое корректирует их направление в полете и таким образом увеличивает шансы попадания по противнику. ~
@46977 = ~СВИСТЯЩИЕ АРБАЛЕТНЫЕ СТРЕЛЫ
Урон: 2-5 колющий
Скорость: 10
Вес: 0
Специализация: снаряды

Эти арбалетные стрелы имеют наконечники с бороздками по бокам. Они непрерывно издают странный свист с переменной высотой тона. Свести с ума противника этим свистом не получится, но раздражает сильно.~
@46978 = ~КАНДАЛЫ
Вес: 10

Это тяжелые чугунные кандалы. Толстые цепи гарантируют, что кем бы ни был заключенный, он не сбежит.

Время от времени они бросают маленькие электрические дуги на ближайшие токопроводящие предметы.~
@46979 = ~РАСЩЕПЛЕННЫЕ АРБАЛЕТНЫЕ СТРЕЛЫ
Урон: 2-5 колющий
Speed: 10
Вес: 0
Специализация: снаряды

Наконечники этих стрел выполнены в форме буквы «U». Их края остры как бритвы, а древко сделано из какого-то неизвестного тебе сплава.~
@46980 = ~ПУЗЫРЕК С ДУХАМИ
Вес: 1

Это пузырек с духами. К флакону прикреплен небольшой распылитель, при использовании выпускающий легкую дымку. Похоже на то, что в пузырьке осталось совсем немного жидкости.~
@46981 = ~КРЫЛАТЫЕ АРБАЛЕТНЫЕ СТРЕЛЫ
Урон: 3-6 колющий
THAC0: +1
Скорость: 5
Вес: 0
Специализация: снаряды

Наконечники этих арбалетных стрел выполнены в форме оперенных крыльев. Сами же они очень легкие и больше напоминают стрелы для лука. Несмотря на то, что они не волшебные, они более точны и причиняют больше урона при попадании, нежели обычные стрелы для арбалета.~
@46982 = ~ЗАЗУБРЕННЫЕ АРБАЛЕТНЫЕ СТРЕЛЫ
Урон: 3-6 колющий
Магический урон: +1
THAC0: +1
Скорость: 10
Вес: 0
Специализация: снаряды

У этих зачарованных стрел вдоль древка начертаны зубчатые черные руны. При выстреле они вздымаются, как хребет, и образуют дополнительный ряд похожих на шипы ужасных лезвий, которые вонзаются в цель.~
@46983 = ~КЛЫКАСТЫЕ АРБАЛЕТНЫЕ СТРЕЛЫ
Урон: 2-5 колющий
Вес: 0
Специализация: снаряды

Наконечники этих зачарованных стрел имеют два длинных клыка, загнутых наружу. На вид они опасные... и голодные.~
@46984 = ~СЕРЕБРЯНАЯ РАМКА
Вес: 1

Это тусклая серебряная рамка. Когда-то в нее могла быть вставлена маленькая картина, но теперь рамка пустует.~
@46985 = ~Это невидимое оружие, которое Равель использует в бою.~
@46986 = ~МЕТКА БРИТВЕННЫХ АНГЕЛОВ
Вызывает: «Защита от зла»
Вес: 0
Не используется злыми персонажами

Эта татуировка — напоминание о помощи, которую ты оказал Бритвенным Ангелам в переулке Опасных углов. Твой удар по злу в самом сердце переулка теперь дает тебе некоторую защиту от тех, кто носит в сердце злобу.

У этой татуировки ограниченное количество использований.~
@46987 = ~СФЕРИЧЕСКИЕ АРБАЛЕТНЫЕ СТРЕЛЫ
Урон: 1-2 дробящий
Скорость: 10
Вес: 0
Специализация: снаряды

У этих арбалетных стрел мягкие, похожие на шпатлевку наконечники шарообразной формы. Ты понятия не имеешь, для чего они нужны. ~
@46988 = ~Арбалетные стрелы содрогания~
@46989 = ~Арбалетные стрелы Кессека-Пожирателя~
@46990 = ~Окровавленный платок~
@46991 = ~Шоколадный квазит~
@46992 = ~Кодекс необъяснимого~
@46993 = ~Малиновая вуаль~
@46994 = ~Слезы дэва~
@46995 = ~Кружка ледяного эля~
@46996 = ~Кружка ледяного эля с Темной птицей внутри~
@46997 = ~Эликсир ужасного разделения~
@46998 = ~Язык нечистого~
@46999 = ~Мазь Горгоны~
@47000 = ~Носовой платок~
@47001 = ~Арбалетные стрелы свистящего рока~
@47002 = ~Этот громадный труп тихо стоит в углу комнаты, лицом к стене. Похоже, раньше это был крупный мужчина в расцвете лет и, судя по состоянию тела, умер он совсем недавно. На лбу виден недавно вышитый номер «1664». Кажется, труп служит в качестве библиотекаря: в руках он несет огромную стопку книг.~
@47003 = ~Осмотреть книги.~
@47004 = ~Снова осмотреть книги.~
@47005 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@47006 = ~Использовать на трупе свою способность «История костей».~
@47007 = ~«Было приятно с тобой поболтать. Прощай».~
@47008 = ~Оставить труп в покое.~
@47009 = ~Зомби безучастно пялится в стену.~
@47010 = ~Оставить труп в покое.~
@47011 = ~Труп даже не шевелится. Несмотря на недавнюю смерть, похоже, что он не сможет ответить на твои вопросы.~
@47012 = ~Оставить труп в покое.~
@47013 = ~Похоже, это старые бухгалтерские книги Морга, не представляющие никакого интереса. Тем не менее, просматривая их, ты обнаруживаешь вырванную страницу между двумя книгами. Неожиданно у тебя возникает ощущение, что кто-то поместил ее сюда, чтобы спрятать. ~
@47014 = ~Взять страницу.~
@47015 = ~Кажется, эта страница не из бухгалтерских книг... похоже, она из какого-то регистрационного журнала. Корешок ровный, как будто страницу срезали ножом, и ты подозреваешь, что ее удалили специально.~
@47016 = ~Прочитать ее. ~
@47017 = ~Ты бегло осматриваешь страницу... это список тел, доставленных в Морг и зарегистрированных в Приемной комнате. Все записи принадлежат недавно прибывшим телам.

^NПРИМЕЧАНИЕ: <READSTUFF>^-~
@47018 = ~Снова осмотреть зомби.~
@47019 = ~Взять страницу с собой и уйти.~
@47020 = ~~
@47021 = ~Похоже, это старые бухгалтерские книги Морга, не представляющие никакого интереса. Ты снова просматриваешь тексты, но больше ничего не находишь.  ~
@47022 = ~«И как это тебя угораздило стать библиотекарем? Другие места были заняты?»~
@47023 = ~Оставить зомби в покое.~
@47024 = ~Кажется, этот парень куда-то спешит. Остановив его, ты встречаешь его возмущенный взгляд: он явно хочет поскорее уйти.~
@47025 = ~«У меня к тебе несколько вопросов».~
@47026 = ~«Кто ты?»~
@47027 = ~«Что ты можешь рассказать об этом месте?»~
@47028 = ~~
@47029 = ~Он останавливается на миг, но явно не слушает, что ты ему говоришь. «Не знаю», — говорит он и уходит.~
@47030 = ~«Тогда прощай». ~
@47031 = ~«Забудь. Можешь продолжить свой путь».~
@47032 = ~При твоем приближении гниющие головы на вратах начинают говорить, по очереди произнося слова и складывая из них осмысленные предложения. «Пропал, пропал. Потерян предателем, потерян светом».~
@47033 = ~«А что случилось с городом?»~
@47034 = ~«Что случилось с вами?»~
@47035 = ~«Спасибо за новость. Прощайте».~
@47036 = ~«Унесен ветром, смыт волной зла. Сквозь врата ушел, ушел. Город пропал, утонул в своей ненависти. Сквозь врата, в Красную тюрьму, тюремный план... в Карцери».~
@47037 = ~«Карцери? Расскажите мне о Карцери».~
@47038 = ~«Вы можете говорить нормально?»~
@47039 = ~«Что случилось с вами?»~
@47040 = ~«Есть идеи, как попасть туда или вернуть его сюда?»~
@47041 = ~«У меня нет на это времени. Прощайте».~
@47042 = ~«Преданные, презренные, подставленные... наказанные, казненные, оставленные в назидание. Подвешенные здесь врагами. Пропали, пропали, пропали».~
@47043 = ~«Мне кажется, или в последнее время развелось слишком много говорящих голов без тела?»~
@47044 = ~«Мне кажется, или в последнее время развелось слишком много говорящих голов без тела?»~
@47045 = ~«Куда все подевались?»~
@47046 = ~Головы умолкают. Переглянувшись между собой, они снова поворачиваются к тебе, стыдливо свисая с врат.~
@47047 = ~«Ну хорошо. Что случилось с Проклятым?»~
@47048 = ~«Ладно. Прощайте».~
@47049 = ~«Через врата, в тюрьму... нет возврата из тюрьмы, нет. Иди через врата, через врата... Там тебя ждет твоя судьба».~
@47050 = ~«Что вы знаете о моей судьбе?»~
@47051 = ~«Спасибо. Прощайте».~
@47052 = ~«Дэва ждет тебя». Головы умолкают и больше не реагируют ни на какие расспросы.~
@47053 = ~«Тогда прощайте».~
@47054 = ~«Под вуалью все... затенено, залито светом. Ничего не разберешь. Все непросто. Нет».~
@47055 = ~«Ну хорошо, а что случилось с вами?»~
@47056 = ~«Есть идеи, как попасть в город или вернуть его сюда?»~
@47057 = ~«Тогда ладно. Прощайте».~
@47058 = ~Поначалу головы молчат, затем начинают перешептываться, а затем и общаться в полный голос.~
@47059 = ~«Что случилось с Проклятым?»~
@47060 = ~«Что случилось с вами?»~
@47061 = ~«Забудьте. Прощайте».~
@47062 = ~Когда ты подходишь к вратам, гниющие головы, украшающие обвитую остролистником арку, начинают с тобой говорить, перебивая друг друга. «В Карцери... тюремный план... землю преданных и предателей, обманщиков и жертв. Эти врата... закрыты... пока».~
@47063 = ~«Когда они откроются снова?»~
@47064 = ~«Что вы можете рассказать о Карцери?»~
@47065 = ~«Что случилось с вами?»~
@47066 = ~«Спасибо. Прощайте».~
@47067 = ~«Врата... все еще закрыты. Прохода нет».~
@47068 = ~«Когда они откроются снова?»~
@47069 = ~«Что вы можете рассказать о Карцери?»~
@47070 = ~«Что случилось с вами?»~
@47071 = ~«'НАСЛЕДСТВО, — написано в записке, — НЕ ЗАБУДЬ ЗАБРАТЬ СВОЕ НАСЛЕДСТВО', и еще маленький ШИФР, нацарапанный возле нее: 51-AA...»

«Несомненно, это ЛОВУШКА, устроенная еще одним из моих ЛОЖНЫХ Я. Мне нужно УНИЧТОЖИТЬ ее».~
@47072 = ~«Спасибо. Прощайте».~
@47073 = ~~
@47074 = ~Ничего. Отложить дневник.~
@47075 = ~«Когда пройдет чумной мор. Когда прекратится болезнь. Когда уйдет смерть».~
@47076 = ~«Что вы можете рассказать о Карцери?»~
@47077 = ~«Что случилось с вами?»~
@47078 = ~«Спасибо. Прощайте».~
@47079 = ~Прочесть еще что-нибудь.~
@47080 = ~«Тюремный план... зло, хаос... Миры внутри миров, сферы внутри сфер, подвешенные словно жемчужины в небесах.. Красная тюрьма, погибель богов и титанов».~
@47081 = ~Отложить дневник.~
@47082 = ~«Когда ворота откроются?»~
@47083 = ~«Что случилось с вами?»~
@47084 = ~«Прощайте».~
@47085 = ~«Преданные, презренные, подставленные... наказанные, казненные, оставленные в назидание. Подвешенные здесь врагами. Пропали, пропали, пропали».~
@47086 = ~«Когда ворота откроются?»~
@47087 = ~«Что вы можете рассказать о Карцери?»~
@47088 = ~«Прощайте».~
@47089 = ~«Тюремный план... зло, хаос... Миры внутри миров, сферы внутри сфер, подвешенные словно жемчужины в небесах.. Красная тюрьма, погибель богов и титанов».~
@47090 = ~«Вы можете говорить нормально?»~
@47091 = ~«Что случилось с вами?»~
@47092 = ~«Есть идеи, как попасть туда или вернуть его сюда?»~
@47093 = ~«У меня нет на это времени. Прощайте».~
@47094 = ~Это необычный желто-зеленый камень. Он надежно прикреплен к подставке, на которой он покоится.~
@47095 = ~Уйти.~
@47096 = ~Это желто-зеленый камень, к которому тебя направил клерк. В нем хранится переживание «Неизбежная боль».~
@47097 = ~Начать переживание.~
@47098 = ~Уйти.~
@47099 = ~Переживание короткое и яркое: ты борешься с другим человеком, который слегка сильнее тебя, на краю чертовски горячего потока лавы. Твою руку с оружием медленно и неумолимо отгибают все ближе и ближе к магме. Капли пота, появившись, тут же испаряются; волосы на тыльной стороне руки чернеют и дымятся от ужасающего жара. Наконец, твой страдальческий крик эхом отражается от стен каньона вокруг тебя, твоя рука с топором погружается в лаву и за несколько мучительных секунд превращается в пепел.~
@47100 = ~Оторваться от переживания.~
@47101 = ~Оторваться от переживания и уйти.~
@47102 = ~Это желто-зеленый камень, к которому тебя направил клерк. В нем хранится переживание «Психоз».~
@47103 = ~Начать переживание.~
@47104 = ~Уйти.~
@47105 = ~Переживание это странное, очень волнующее... ты приставил нож к чьей-то глотке, твоя рука зажала ему рот, твое тяжелое горячее дыхание направлено ему в лицо. Ты начинаешь вонзать нож... по чуть-чуть. Нож образует ямку на коже и, наконец, прорезает ее. По твоей руке бежит поток горячей крови, слышен звук захлебывающегося дыхания, ужасное чувство извращенного ликования... и это все.~
@47106 = ~Оторваться от переживания.~
@47107 = ~Оторваться от переживания и уйти.~
@47108 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47109 = ~Уйти.~
@47110 = ~Это необычный светло-голубой камень. Он надежно прикреплен к подставке, на которой он покоится.~
@47111 = ~Уйти.~
@47112 = ~Это светло-голубой камень, к которому тебя направил клерк. В нем хранится переживание «Нежная любовь».~
@47113 = ~Начать переживание.~
@47114 = ~Уйти.~
@47115 = ~Твои глаза закрыты. Ты чувствуешь, что стоишь на цыпочках, крепко прижавшись к кому-то. Мягкие нежные губы прикасаются к твоим, даря тебе нежнейший из поцелуев... Твое сердце чуть ли не выпрыгивает из груди, тебе кажется, будто ты можешь упасть на спину и попросту плыть в пространстве...~
@47116 = ~Оторваться от переживания.~
@47117 = ~Оторваться от переживания и уйти.~
@47118 = ~Это светло-голубой камень, к которому тебя направил клерк. В нем хранится переживание «Мучительная зависть».~
@47119 = ~Начать переживание.~
@47120 = ~Уйти.~
@47121 = ~Ты чувствуешь, как искривляются твои губы, когда молодой светловолосый герой в доспехах, сияющих, как полированное серебряное зеркало, снова заходит в твою таверну. Повесив свой бархатный плащ на крючок в стене, он осматривает твоих клиентов жемчужными глазами, улыбаясь так, что служанки падают в обморок. Ты ставишь кружку, которую только-что протирал, и громко фыркаешь, представляя, как бы это выглядело, если бы его перевернуть и засунуть в бочку с дождевой водой...~
@47122 = ~Оторваться от переживания.~
@47123 = ~Оторваться от переживания и уйти.~
@47124 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47125 = ~Уйти.~
@47126 = ~Раук~
@47127 = ~Раук~
@47128 = ~Его лицо спокойно, но в голосе слышна ярость. «Ты предал наши идеалы. Для тебя здесь нет места. Наша стража проводит тебя к выходу. Уйдешь ли ты с миром?»~
@47129 = ~«Я бы хотел извиниться и снова присоединиться к верящим в Первопричину».~
@47130 = ~«Я уйду с миром».~
@47131 = ~«Тебе придется тащить меня отсюда».~
@47132 = ~«Однажды ты повернулся спиной к нашим убеждениям, и теперь нет пути обратно. Если хочешь, можешь рассматривать это как еще одно испытание, но мы не откроемся тебе и не станем помогать тебе на твоем пути к просветлению. А теперь... уйдешь ли ты с миром, или прольется кровь?»~
@47133 = ~«Я уйду с миром».~
@47134 = ~«Тебе придется тащить меня отсюда».~
@47135 = ~«Приветствую, друг! Чем я могу помочь тебе сегодня?»~
@47136 = ~«Я хотел бы немного подлечиться, если можно».~
@47137 = ~«Мне нужно купить кое-какие вещи».~
@47138 = ~«Мне нужно место для отдыха».~
@47139 = ~«Я хотел бы увидеть секретный проект, если это возможно».~
@47140 = ~«Я потерял символ, дающий доступ к помещению секретного проекта».~
@47141 = ~Том Уловок~
@47142 = ~Зеленое существо~
@47143 = ~«Бедай-Линн попросила меня саботировать машину».~
@47144 = ~«Бедай-Линн — та, кто разрушил машину».~
@47145 = ~«Бедай-Линн — та, кто разрушил машину».~
@47146 = ~«Бедай-Линн попросила меня саботировать машину. Я отказал ей, но подумал, что тебе следует знать об этом».~
@47147 = ~«Бедай-Линн попросила меня убить Сандоза. Я подумал, что тебе следует знать об этом».~
@47148 = ~«Бедай-Линн попросила меня убить Сандоза. Я подумал, что тебе следует знать об этом».~
@47149 = ~«Бедай-Линн убила Сандоза».~
@47150 = ~«Бедай-Линн убила Сандоза».~
@47151 = ~«У меня для тебя послание от аукциониста Гилтспура».~
@47152 = ~«Ты доказал, что заслуживаешь доверия. Вот. Возьми это, — он втискивает в твои руки монету, украшенную символом боголюдей. — Не теряй его. Если потеряешь — боюсь, что я не смогу его заменить, так что будь осторожен. Могу ли я чем-то еще тебе помочь?»~
@47153 = ~«Да, у меня еще пара вопросов...»~
@47154 = ~«Нет, спасибо. Прощай».~
@47155 = ~«Я сожалею, что не могу выдать тебе другой. Я же предупреждал, что не смогу заменить его, разве не так? — он вздыхает. — Могу ли я чем-то еще помочь тебе?»~
@47156 = ~«Ответь еще на пару вопросов...»~
@47157 = ~«Нет. Прощай».~
@47158 = ~Его веселое лицо становится жестким и мрачным. «Это так? Тогда мы посадим ее под арест и выясним правду. И если это правда... мы ее казним. Извини. Мне нужно кое о чем позаботиться».~
@47159 = ~«Не торопись».~
@47160 = ~Когда Кельдор возвращается, лицо его неподвижно. «Твои сведения помогли задержать опасную преступницу. Этим мы заработали признание у Гармониума и убийц милосердия, и мы обязаны тебе за это. Прими нашу благодарность... и, между нами говоря, я признателен тебе за то, что ты подтвердил мое мнение о том, что ты — прекрасный выбор для боголюдей».~
@47161 = ~«Без проблем. У меня есть еще вопросы...»~
@47162 = ~«Спасибо. Прощай».~
@47163 = ~Его веселое лицо становится жестким и мрачным. «Это так? Тогда мы посадим ее под арест и выясним правду. И если это правда... мы ее казним. Извини. Мне нужно кое о чем позаботиться».~
@47164 = ~«Не торопись».~
@47165 = ~Когда он возвращается, лицо его мрачнеет еще больше. «Она исчезла. Никто не видел, как она ускользнула, и никто не знает, куда она ушла. Так или иначе, прими мою благодарность за то, что предупредил нас о ее предательстве. Будь уверен: если она здесь покажется, она обречена. Даю тебе слово».~
@47166 = ~«У меня несколько вопросов к тебе...»~
@47167 = ~«Если увижу ее, я об этом позабочусь. Прощай».~
@47168 = ~«Еще вопросы? Что я могу для тебя сделать?»~
@47169 = ~«Я хотел бы немного подлечиться, если можно».~
@47170 = ~«Мне нужно купить кое-какие вещи».~
@47171 = ~«Мне нужно место для отдыха».~
@47172 = ~«Я хотел бы увидеть секретный проект, если это возможно».~
@47173 = ~«Я потерял символ, дающий доступ к помещению секретного проекта».~
@47174 = ~«Бедай-Линн попросила меня саботировать машину».~
@47175 = ~«Бедай-Линн — та, кто разрушил машину».~
@47176 = ~«Бедай-Линн — та, кто разрушил машину».~
@47177 = ~«Бедай-Линн попросила меня саботировать машину. Я отказал ей, но подумал, что тебе следует знать об этом».~
@47178 = ~«Бедай-Линн попросила меня убить Сандоза. Я подумал, что тебе следует знать об этом».~
@47179 = ~«Бедай-Линн попросила меня убить Сандоза. Я подумал, что тебе следует знать об этом».~
@47180 = ~«Бедай-Линн убила Сандоза».~
@47181 = ~«Бедай-Линн убила Сандоза».~
@47182 = ~«У меня для тебя послание от аукциониста Гилтспура».~
@47183 = ~«Примешь ли ты присягу боголюдей и присоединишься к нам?»~
@47184 = ~«Да».~
@47185 = ~«Да».~
@47186 = ~«Да».~
@47187 = ~Клятва: «Жизненные невзгоды испытывают нас. Все, с чем бы я не столкнулся, послужит мне уроком. Болью мультивселенная закрепит мои уроки. То, что я больше всего ненавижу в других — отражение того, что я больше всего ненавижу в себе. Я буду стремиться раскрыть свой потенциал и помогать другим достигать их целей. Я буду помнить, что во всем присутствует искра божественности. Я клянусь в верности верящим в Первопричину и их целям, и никогда не отвергну их». Ты клянешься, и Кельдор улыбается. «Добро пожаловать к боголюдям, парень. Тебе что-нибудь нужно от меня сейчас?»~
@47188 = ~«У меня есть несколько вопросов...» ~
@47189 = ~«Сейчас — ничего. Прощай».~
@47190 = ~«Что же ты хочешь знать?»~
@47191 = ~«Кто ты?»~
@47192 = ~«Что ты можешь рассказать мне об этом месте?»~
@47193 = ~«В чем выгода от присоединения к боголюдям?»~
@47194 = ~«Расскажи побольше о своей фракции».~
@47195 = ~«Что ты можешь рассказать мне о своей фракции?»~
@47196 = ~«Я хотел бы присоединиться к боголюдям».~
@47197 = ~«Я хотел бы присоединиться к боголюдям».~
@47198 = ~«Я хотел бы присоединиться к боголюдям».~
@47199 = ~«Я хотел бы присоединиться к боголюдям».~
@47200 = ~«Я хочу задать несколько вопросов о кузнице».~
@47201 = ~«Я хотел бы поговорить о расследовании убийства».~
@47202 = ~«Я хотел бы поговорить о Сандозе».~
@47203 = ~«Я хотел бы принести присягу боголюдям».~
@47204 = ~«Я хотел бы увидеть секретный проект, если это возможно».~
@47205 = ~«Я потерял символ, дающий доступ к помещению секретного проекта».~
@47206 = ~«Бедай-Линн попросила меня саботировать машину».~
@47207 = ~«Бедай-Линн — та, кто разрушил машину».~
@47208 = ~«Бедай-Линн — та, кто разрушил машину».~
@47209 = ~«Бедай-Линн попросила меня саботировать машину. Я отказал ей, но подумал, что тебе следует знать об этом».~
@47210 = ~«Бедай-Линн попросила меня убить Сандоза. Я подумал, что тебе следует знать об этом».~
@47211 = ~«Бедай-Линн попросила меня убить Сандоза. Я подумал, что тебе следует знать об этом».~
@47212 = ~«Бедай-Линн убила Сандоза».~
@47213 = ~«Бедай-Линн убила Сандоза».~
@47214 = ~~
@47215 = ~Он улыбается. «Дружище, я не могу дать тебе это, пока ты не докажешь свое расположение к боголюдям».~
@47216 = ~«Тогда ответь мне еще на пару вопросов...»~
@47217 = ~«Может, позже. Прощай».~
@47218 = ~«Сожалею, что не могу выдать тебе другой, — вздыхает он. — Могу ли я помочь тебе еще чем-то?»~
@47219 = ~«Ответь еще на пару вопросов...»~
@47220 = ~«Нет. Прощай».~
@47221 = ~Его веселое лицо становится жестким и мрачным. «Это так? Тогда мы посадим ее под арест и выясним правду. И если это правда... мы ее казним. Извини. Мне нужно кое о чем позаботиться».~
@47222 = ~«Не торопись».~
@47223 = ~Когда Кельдор возвращается, лицо его неподвижно. «Твои сведения помогли задержать опасную преступницу. Этим мы заработали признание у Гармониума и убийц милосердия, и мы обязаны тебе за это. Прими нашу благодарность... и, между нами говоря, я признателен тебе за то, что ты подтвердил мое мнение о том, что ты — прекрасный выбор для боголюдей».~
@47224 = ~«Без проблем. У меня есть еще вопросы...»~
@47225 = ~«Спасибо. Прощай».~
@47226 = ~Его веселое лицо становится жестким и мрачным. «Это так? Тогда мы посадим ее под арест и выясним правду. И если это правда... мы ее казним. Извини. Мне нужно кое о чем позаботиться».~
@47227 = ~«Не торопись».~
@47228 = ~Когда он возвращается, лицо его мрачнеет еще больше. «Она исчезла. Никто не видел, как она ускользнула, и никто не знает, куда она ушла. Так или иначе, прими мою благодарность за то, что предупредил нас о ее предательстве. Будь уверен: если она здесь покажется, она обречена. Даю тебе слово».~
@47229 = ~«У меня несколько вопросов к тебе...»~
@47230 = ~«Если увижу ее, я об этом позабочусь. Прощай».~
@47231 = ~«Вдобавок к тому, что ты присоединишься к таким славным людям, какие у нас тут имеются, — улыбается он, — ты получишь почти неограниченный доступ к ресурсам. У нас есть заклинания, вещи, места для отдыха. Некоторые из них предназначены только для нашей фракции. Часть из них можно найти по всему Сигилу. Все это намного дешевле для членов нашей фракции».~
@47232 = ~«Хорошо. У меня были другие вопросы...»~
@47233 = ~«Спасибо. Прощай».~
@47234 = ~«Это Великая Литейная, дом верящих в Первопричину, также известных под именем боголюди. Здесь мы создаем вещи, которые поставляются во все планы — мы известны во многих мирах. Здесь работают только лучшие. Говорят, что наши кузнецы соперничают с кузнецами самой горы Клангеддин. Лично я не считаю, что мы настолько хороши... но мы ОЧЕНЬ близки к этому».~
@47235 = ~«Вы можете взяться за дополнительную работу?»~
@47236 = ~«Что ты можешь рассказать о здешних людях?»~
@47237 = ~«Понятно. У меня есть другие вопросы...»~
@47238 = ~«Спасибо. Прощай».~
@47239 = ~«Увы, друг, это невозможно. В данный момент мы заняты долговременным заказом, который забирает большую часть наших ресурсов. Может быть, когда мы закончим... это вопрос нескольких лет, — он пожимает плечами. — Прими мои извинения».~
@47240 = ~«У меня есть другие вопросы...»~
@47241 = ~«Спасибо. Прощай».~
@47242 = ~«У нас тут много разного народа, в большинстве своем — кузнецы и рабочие, которые поддерживают деятельность этого места. Также у нас есть парочка инженеров, которые делают какие-то невероятные вещи с тканью реальности. Как-нибудь спроси Нила Зандера о его Построителе снов».~
@47243 = ~«Может, я так и сделаю. У меня есть другие вопросы...»~
@47244 = ~«Прощай».~
@47245 = ~Он широко улыбается. «Друг мой, я Кельдор Дурианский, один из фрактотумов боголюдей, и формально управляю этим местом, пока наше настоящее начальство ушло на тайное совещание».~
@47246 = ~«Что ты можешь рассказать мне о своей фракции?»~
@47247 = ~«У меня есть другие вопросы...»~
@47248 = ~«Спасибо. Прощай».~
@47249 = ~Он улыбается, его лицо покрывается морщинками. «Что бы ты хотел узнать о нас?»~
@47250 = ~«Как мне присоединиться?»~
@47251 = ~«Как мне присоединиться?»~
@47252 = ~«Как мне присоединиться?»~
@47253 = ~«Как мне присоединиться?»~
@47254 = ~«Каковы убеждения этой фракции?»~
@47255 = ~«Расскажи мне об истории фракции».~
@47256 = ~«Что я получу, будучи членом фракции?»~
@47257 = ~«Какие у фракции враги?»~
@47258 = ~«А вообще, чем вы занимаетесь?»~
@47259 = ~«Почему вас так называют?»~
@47260 = ~«Пока ничего. У меня есть другие вопросы...»~
@47261 = ~«Ничего. Прощай».~
@47262 = ~«С удовольствием. Что бы ты хотел узнать?»~
@47263 = ~«Как мне присоединиться?»~
@47264 = ~«Как мне присоединиться?»~
@47265 = ~«Как мне присоединиться?»~
@47266 = ~«Как мне присоединиться?»~
@47267 = ~«Каковы убеждения этой фракции?»~
@47268 = ~«Расскажи мне об истории фракции».~
@47269 = ~«Что я получу, будучи членом фракции?»~
@47270 = ~«Какие у фракции враги?»~
@47271 = ~«А вообще, чем вы занимаетесь?»~
@47272 = ~«Почему вас так называют?»~
@47273 = ~«Пока ничего. У меня есть другие вопросы...»~
@47274 = ~«Ничего. Прощай».~
@47275 = ~«Если хочешь присоединиться к верящим в Первопричину, ты должен выполнить три задания. Первое задание такое: ты должен пойти в кузницу и создать предмет. Это покажет, что ты способен увидеть возможность даже в простом куске железа; что ты способен создать нечто, способное выдержать испытание временем. Это определит твою проницательность и способность делать возможное действительным. Поговори с Алиссой, бригадиром в главной литейной, чтобы увидеть, как все это делается».~
@47276 = ~«У меня есть другие вопросы...»~
@47277 = ~«Я займусь этим. Прощай».~
@47278 = ~На его лице появляется лукавая улыбка. «Ну, сначала ты должен отречься от членства в фракции тленных».~
@47279 = ~«Отлично. Я отрекаюсь от них. Что мне нужно делать?»~
@47280 = ~«Не уверен, готов ли я сделать это. Ответь мне еще на пару вопросов о твоей фракции, хорошо?»~
@47281 = ~«Не в этот раз. У меня есть другие вопросы, не касающиеся твоей фракции».~
@47282 = ~«Не в этот раз, спасибо. Прощай».~
@47283 = ~На его лице появляется лукавая улыбка. «Ну, сначала ты должен отречься от членства в фракции чувствующих».~
@47284 = ~«Отлично. Я отрекаюсь от них. Что мне нужно делать?»~
@47285 = ~«Не уверен, готов ли я сделать это. Ответь мне еще на пару вопросов о твоей фракции, хорошо?»~
@47286 = ~«Не в этот раз. У меня есть другие вопросы, не касающиеся твоей фракции».~
@47287 = ~«Не в этот раз, спасибо. Прощай».~
@47288 = ~На его лице появляется лукавая улыбка. «Ну, сначала ты должен отречься от членства в фракции хаоситеков».~
@47289 = ~«Отлично. Я отрекаюсь от них. Что мне нужно делать?»~
@47290 = ~«Не уверен, готов ли я сделать это. Ответь мне еще на пару вопросов о твоей фракции, хорошо?»~
@47291 = ~«Не в этот раз. У меня есть другие вопросы, не касающиеся твоей фракции».~
@47292 = ~«Не в этот раз, спасибо. Прощай».~
@47293 = ~«Любой из здешних кузнецов вполне может помочь тебе».~
@47294 = ~«Хорошо. У меня есть другие вопросы к тебе».~
@47295 = ~«Спасибо. Прощай».~
@47296 = ~«Мы верим, что вселенная — это гигантский полигон, место, где мы проходим серию испытаний. Эти испытания продолжаются в течение всей твоей жизни, в течении всех твоих жизней. Каждый шаг, каждый день вполне может стать для тебя испытанием, и твое вознаграждение в следующей жизни зависит от того, насколько хорошо ты усвоил уроки теперешней жизни. Мы верим, что тело учится на опыте... и что опыт распространяется на все твои жизни, превращая тебя в нечто большее, чем если бы у тебя была одна жизнь».~
@47297 = ~«Так какой же смысл у всего этого?»~
@47298 = ~«Пока что убедительно. Продолжай».~
@47299 = ~«Ладно... есть еще вопросы о твоей фракции».~
@47300 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47301 = ~«Спасибо за уделенное время. Прощай».~
@47302 = ~«Общепринято считать, что мы были основаны Перреном, еще до Великого Переворота, когда фракций стало пятнадцать. Во время Переворота Ожи Фонейская свела убеждения фракции к тому, чем они являются теперь. Она перевоплощалась тысячу раз, и могла вспомнить *каждую* из своих воплощений. Она научила нас, как обращаться со своей интуицией, и привела нас в новую эпоху. Эти двое были самыми важными фигурами в нашей фракции. У нас есть множество других историй, но эти раскрывают саму суть».~
@47303 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47304 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47305 = ~«Спасибо за уделенное время. Прощай».~
@47306 = ~«Ну, кроме доступа к нашей прекрасной литейной, жилью и питанию для тебя и твоих друзей, особых предметов и заклинаний, и более благосклонной реакции на тебя прохожих на улице, нас больше незачем рекомендовать. Конечно, если ты планируешь присоединиться к нам только из корыстных интересов, я бы не советовал тебе делать это».~
@47307 = ~«Анна, цветочек мой ненаглядный, разве я не учил тебя *уважать* мертвых? — на лице Фарода появляется тонкая улыбка, он делает тебе легкий поклон. — Этот находчивый труп хочет знать, где ты его нашла».~
@47308 = ~«Ах да, это моя ошибка... — Фарод кивает, затем его тон угрожающе понижается. — И все же, моя дорогая Анна, эта ошибка стала ТВОЕЙ... потому что он был только одной ногой в книге мертвых, когда ты принесла его ко мне, — он легонько стучит костылем по плитам. — Он очнулся, нашел меня... ТАК неловко вышло».~
@47309 = ~«Проведи его туда, где ты нашла его тело, Анна, — чтобы подчеркнуть это, Фарод стукает костылем. — Проведи его на улицу с призраками, — Фарод пару мгновений оглядывает Анну, затем ухмыляется и поворачивается к тебе. — Если ты ненароком разминешься с моей дорогой Анной по дороге в переулок, вернись к Фароду. Я проведу тебя сам...»~
@47310 = ~«Анна... — Фарод говорит негромко, но его голос прорезает слова девчонки как нож. — Будь его проводником. Пригляди, чтобы с ним ничего не случилось, пока он в деревне. А потом веди его, куда он пожелает».~
@47311 = ~«А, ну что еще?» Перед тобой поразительная рыжеволосая девушка, одетая в кожаную броню... ты даже не заметил, как она вошла в комнату. Ее правая рука покрыта рядом соединенных пластин, похожих на кожу какого-то животного, а левую руку защищает рогатый наплечник. Странно, но у нее есть хвост... который мечется из стороны в сторону, пока ты на него смотришь.~ [ANA229B]
@47312 = ~Девушка, не обращая на тебя внимания, поворачивается к Фароду. «Че на этот раз? Не собираюсь я выгуливать этого паршивого пса, ни за что. Заставь кого-нибудь из своих молокососов».~
@47313 = ~«Че? Это ты о чем? — она косится на тебя. — Он же не жмурик».~
@47314 = ~«И че? — Анна глядит на тебя, затем пожимает плечами. — Ему не стоит изображать жмурика в Улье, когда я поблизости, а не то очутится в руках трухлявых».~
@47315 = ~«О да, а может, это ТЕБЕ стоило быть поосторожней, глядишь, и не лежал бы на мостовой мордой вниз, закоченевший как жмурик, а?!»~
@47316 = ~«Я не боюсь ТЕБЯ...» Руки Анны устремляются вниз вдоль боков и выхватывают из ножен пару зловещих ударных кинжалов. «Тебе лучше отойти, не то они будут торчать у тебя из глаз!»~
@47317 = ~«Пф-ф-ф, — Анна косится на Фарода, затем бросает на тебя взгляд. — Тогда погнали. И бодрее перебирай ногами, усек? У меня на таких как ты нет лишнего времени».~
@47318 = ~«Во как? Что ж, тогда обнюхивай свою могилку сам, придурок! Я не буду...»~
@47319 = ~Анна сплевывает на землю. «Чтоб вас оспа побила...»~
@47320 = ~«Так значит это ты покажешь мне место, где нашли мое тело?»~
@47321 = ~«Ты Анна? Мы встречались с тобой в Улье — напротив Морга, верно?»~
@47322 = ~«Может, тебе стоило ПРОВЕРИТЬ, жив я или мертв, перед тем как бросать меня там».~
@47323 = ~«Хватит... где ты нашла мое тело?»~
@47324 = ~«Может, стоит показать твоей грязной мародерской шкуре, каково это — лежать полумертвым в переулке».~
@47325 = ~«Хватит... где ты нашла мое тело?»~
@47326 = ~«Вообще-то, я еще не закончил обследовать Погребенную деревню... пойдем на место моей смерти, когда я тут разберусь».~
@47327 = ~«Отлично. Веди».~
@47328 = ~«Я так и думал... а теперь пошли».~
@47329 = ~Анна указывает на дверь перед тобой. «Туда нам и нужно».~
@47330 = ~«Хорошо, подойдем к ней».~
@47331 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47332 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47333 = ~«Спасибо за уделенное время. Прощай».~
@47334 = ~«По сути, у нас нет врагов. И все же, есть такие, кто не согласен с нашими взглядами. Мрачная Кабала насмехается над идеей того, что мы стремимся к чему-то более совершенному. Я считаю, что даже если они и не согласны с этой точкой зрения, им бы следовало смириться с ней... также, как и тленным. Тленные считают, что жизнь — это иллюзия, подготовка к Истинной Смерти, а наша вера отстаивает причинность жизни. Они содействуют смерти — мы празднуем жизнь. Что может быть большей противоположностью?»~
@47335 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47336 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47337 = ~«Спасибо за уделенное время. Прощай».~
@47338 = ~«Ну, мы управляем Великой Литейной. Также мы управляем Домом Предвестника, где мы готовим людей, которые кажутся весьма способными... бойцов, которые показывают какие-либо способности, выделяющие их среди простых смертных. Некоторые говорят, что мы делаем это, потому что хотим, чтобы на нашей стороне была сила, но правда в том, что мы делаем это, потому что считаем, что это тоже часть наших испытаний. Мы изо всех сил стараемся сделать так, чтобы каждый был готов принять на себя свои обязанностями: мы хотим видеть, как движется мультивселенная».~
@47339 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47340 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47341 = ~«Спасибо за уделенное время. Прощай».~
@47342 = ~«Хороший вопрос. Наше настоящее название — верящие в Первопричину, поскольку мы верим, что вся жизнь берет начало от чистого первозданного источника. Но поскольку мы верим, что все существа имеют в себе потенциальную божественность, вполне естественно, что нас еще называют 'боголюдьми'».~
@47343 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47344 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47345 = ~«Спасибо за уделенное время. Прощай».~
@47346 = ~«Мы не вполне уверены в этом. В конце концов, мы ведь еще не дошли до конца, ведь так? Лучшее, что нам остается — это считать, что мы тратим свою жизнь на поиск ответов, правильных для нас. И в конечном счете мы обретаем божественность, или даже нечто большее. Что нас ждет — можно лишь гадать».~
@47347 = ~«Ладно. Продолжай».~
@47348 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47349 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47350 = ~«Спасибо за уделенное время. Прощай».~
@47351 = ~«Итак. Жизнь — это испытание. Мы проходим испытание. После этого мы переходим в другую форму. Это может быть форма архона, нечистого духа или силы. И, как всегда, решения, принимаемые нами в этой жизни, позволяют выбрать наш путь. Свободны ли мы в принятии решений — все еще спорный вопрос, — он улыбается. — Конечно, я сторонник свободной воли людей... Сама мысль о том, что мои решения уже приняты за меня, мне противна».~
@47352 = ~«Ладно... У меня еще вопросы касательно твоей фракции».~
@47353 = ~«У меня есть другие вопросы, не касающиеся твоей фракции...»~
@47354 = ~«Спасибо за уделенное время. Прощай».~
@47355 = ~«У тебя вопросы относительно кузницы? Постараюсь ответить на все, что могу».~
@47356 = ~«Еще раз, с кем мне нужно поговорить?»~
@47357 = ~Показать ему выкованный тобой предмет: «Я завершил свое творение».~
@47358 = ~Показать ему выкованный тобой предмет: «Я завершил свое творение».~
@47359 = ~Показать ему выкованный тобой предмет: «Я завершил свое творение».~
@47360 = ~«Вообще-то, просто ответь еще на несколько вопросов...»~
@47361 = ~«Забудь. Прощай».~
@47362 = ~Он забирает его у тебя и внимательно рассматривает. Похоже, он сдерживается от резких слов. «По крайней мере, ты старался, хм? Ты готов к следующему испытанию? Я, конечно, надеюсь на это...»~
@47363 = ~«Полагаю, да...»~
@47364 = ~Он забирает его у тебя и внимательно рассматривает. «Это сойдет. Еще немного практики — и ты можешь стать полезным кузнецом. Ты готов к следующему испытанию? Я, конечно, надеюсь на это...»~
@47365 = ~«Полагаю, да...»~
@47366 = ~Он забирает его у тебя и внимательно рассматривает. «Это, несомненно, один из лучших выкованных новобранцем образцов, что мне доводилось видеть. Ты далеко пойдешь, друг мой. Ты готов к следующему испытанию? Я, конечно, надеюсь на это...»~
@47367 = ~«Полагаю, да...»~
@47368 = ~Он мрачно продолжает. «В Литейной произошло убийство, и вместо проведения обычного испытания я поручаю тебе выследить убийцу. Поговори с Алиссой Тилд, бригадиром в главной литейной, и начни оттуда. Когда закончишь расследование и будешь готов назвать преступника, возвращайся ко мне».~
@47369 = ~«Ладно. Сперва ответь мне на пару вопросов...»~
@47370 = ~«Я вернусь. Прощай».~
@47371 = ~«Ну? Ты нашел виновного в этом гнусном преступлении? У тебя есть улики?»~
@47372 = ~«Пока недостаточно. Сперва я хотел задать тебе еще пару вопросов...»~
@47373 = ~«Да. Тильдон во всем виновен. У него нет настоящего алиби».~
@47374 = ~«Да. Сарос во всем виновен. Известно, что он тайком бродит по всей Литейной».~
@47375 = ~«Да. Виновны Тильдон и Сарос, как, впрочем, и Бедай-Линн. Никто из них не может отчитаться за свои действия в ночь убийства».~
@47376 = ~«Да. Тильдон виновен. Сарос дал мне шило, которое он нашел возле тела. Это шило Тильдона».~
@47377 = ~«Да. Сарос виновен. Он пытался подставить Тильдона, украв его шило. Заявил, что нашел его возле тела, но Тильдон отрицает это. Сарос — вот кто вам нужен».~
@47378 = ~«Сарос сделал это. Он в союзе с анархистами».~
@47379 = ~«Тильдон совершил преступление, но Сарос пытался подставить его. Это план анархистов, и Сарос в нем — ключевая фигура. Арестуйте их обоих».~
@47380 = ~«Тильдон сделал это. У него были личные проблемы с Авильдоном, и он пытался ложно обвинить Сароса в этом преступлении. Казните его».~
@47381 = ~«Сарос — анархист, и он хотел разрушить Литейную. Он пытался ложно обвинить Тильдона в этом преступлении».~
@47382 = ~Он качает головой. «Мы уже проходили через это. Для обвинения недостаточно доказательств. Иди и собери побольше улик». Он возвращается к своей работе.~
@47383 = ~«Тогда прощай» .~
@47384 = ~Он качает головой. «Я бы никогда и не подумал, что это Тильдон. Я верю, что твое расследование было исчерпывающим... и я доверяю тебе. Позволь мне вызвать стражу».~
@47385 = ~«Не торопись».~
@47386 = ~Похоже, он опечален исходом испытания. «Готово. Спасибо за успешное расследование. Тебе осталось выполнить лишь одно задание. Сандоз, отец Сароссы и Сароса, один из наиболее важных членов нашей фракции, вернулся из кошмарного путешествия. Он закрылся у себя в комнате в башне и угрожает покончить с собой. Поговори с ним. Останови его».~
@47387 = ~«Я займусь этим. Только ответь мне еще на пару вопросов...»~
@47388 = ~«Я займусь этим. Прощай».~
@47389 = ~Он раскрывает рот от удивления. «Не могу поверить, чтобы Сарос делал такое... но к чему Тильдону лгать? Это мрачная задача, но раз ты так утверждаешь — да будет так. Придется взять его под арест. Позволь мне вызвать стражу».~
@47390 = ~«Не торопись».~
@47391 = ~«Что? Оба? Печальный день для боголюдей, воистину печальный... Дай мне минуту, чтобы позвать стражу».~
@47392 = ~«Не торопись».~
@47393 = ~«Тебе удалось убедить его в том, что жизнь имеет смысл?»~
@47394 = ~«Еще нет. По крайней мере, он все еще жив. Ответь мне еще на несколько вопросов, хорошо?»~
@47395 = ~«Мне удалось это. Он вновь обрел жажду жизни».~
@47396 = ~«Мне это не удалось. Он покончил с собой».~
@47397 = ~«Еще нет. Я работаю над этим. Прощай».~
@47398 = ~«Тебе это удалось? Замечательная новость! Поздравляю, друг мой! Ты доказал, что достоин того, чтобы присоединиться к боголюдям! Хочешь присягнуть сейчас, или, может быть, в другой раз?»~
@47399 = ~«Сейчас».~
@47400 = ~«Сейчас».~
@47401 = ~«Сейчас».~
@47402 = ~«Тебе не удалось? Это очень печальные новости. Но ты попытался, верно? Это важно. То, что ты попытался, — он изо всех сил пытается выглядеть радостным, но эта жалкая попытка ему не удается. — Желаешь ли ты принять присягу, или отложим этот вопрос?»~
@47403 = ~«Сейчас».~
@47404 = ~«Сейчас».~
@47405 = ~«Сейчас».~
@47406 = ~Ты видишь крепкого мужчину, который своим видом просто излучает жизненную энергию. Его загорелое лицо покрыто морщинами, а его черную бороду уже тронула седина. «Приветствую, незнакомец, добро пожаловать! Что я могу для тебя сделать в этот чудный денек?»~
@47407 = ~«Я хотел бы задать тебе пару вопросов...»~
@47408 = ~«У меня для тебя послание от аукциониста Гилтспура».~
@47409 = ~«Рад нашей встрече, друг! Чем я могу помочь тебе сегодня?»~
@47410 = ~«Можешь ли ты ответить на несколько вопросов?»~
@47411 = ~«У меня для тебя послание от аукциониста Гилтспура».~
@47412 = ~Гэмлин~
@47413 = ~Гэмлин~
@47414 = ~Уйти.~
@47415 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Жуткая скука».~
@47416 = ~Уйти.~
@47417 = ~Это переживание длится не более нескольких минут, но кажется, что проходит несколько *часов*... Длинная занудная лекция в сухой пыльной аудитории Чалмского университета в Сигиле. Ты осматриваешь просторный зал с надеждой скорчить кому-нибудь рожу, но другие студенты либо спят, либо безразлично смотрят в пространство. Ты роняешь перо, поднимаешь его, роняешь еще раз... хоть какое-то занятие. Ты прикидываешь, а не ткнуть ли им себе в глаз, просто чтобы проверить, почувствуешь ли ты хоть что-нибудь в этой невероятной скуке...~
@47418 = ~Оторваться от переживания.~
@47419 = ~Оторваться от переживания и уйти.~
@47420 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Лютая ненависть».~
@47421 = ~Начать переживание.~
@47422 = ~Уйти.~
@47423 = ~Твои узкие желтые глаза наполняются ядовитыми слезами боли; ты собираешь ошметки своих маленьких красных чешуйчатых крыльев с пола. Ты скромно выходишь из кабинета Гробы, стискивая свои иглообразные зубы под сомкнутыми губами.

Конечно, ты всего лишь спинагон, наименьший среди дьяволов, но это же не причина, чтобы пещерный демон порвал твои крылья из-за того, что ему не понравилось сообщение, которое ты ему принес! Что теперь делать твоему хозяину-гелугону? Он точно ничего не сможет сказать Гробе, да и какой прок от спинагона без крыльев? Вероятно, тебя скинут в Огненную Яму за «некомпетентность»!

О мести не может быть и речи, так что все, что остается тебе делать — это трясти своим когтистым кулаком и ненавидеть, ненавидеть, *НЕНАВИДЕТЬ* Гробу со всей силой, на которую способно твое маленькое черное сердце дьявола...~
@47424 = ~Оторваться от переживания.~
@47425 = ~Оторваться от переживания и уйти.~
@47426 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47427 = ~Уйти.~
@47428 = ~Начать переживание.~
@47429 = ~Уйти.~
@47430 = ~Уйти.~
@47431 = ~Это желто-зеленый камень, к которому тебя направил клерк. В нем хранится переживание «Крайнее удивление».~
@47432 = ~Начать переживание.~
@47433 = ~Уйти.~
@47434 = ~В нерешительности ты открываешь рот и неглубоко вдыхаешь... и вода врывается в твои легкие, как прохладный воздух. Ты улыбаешься и делаешь глубокий вдох. Ты таращишься по сторонам, медленно погружаясь на дно гавани, где сотни красочных рыбок колышутся в запутанных ветвях блестящих кораллов. Когда твои ступни касаются дна, ты смотришь на киль своего корабля и громко смеешься от радости; к поверхности устремляется череда огромных пузырей...~
@47435 = ~Оторваться от переживания.~
@47436 = ~Оторваться от переживания и уйти.~
@47437 = ~Это желто-зеленый камень, к которому тебя направил клерк. В нем хранится переживание «Чистое веселье».~
@47438 = ~Начать переживание.~
@47439 = ~Уйти.~
@47440 = ~Танцуя и приплясывая под шумную праздничную музыку лесных эльфов, ты с дюжиной танцоров кружишь по лесу, вертишься как дервиш, улыбаешься и хохочешь как сумасшедший. Веселящиеся лесные обитателей вопят, хлопают и пляшут вокруг тебя; над вашими головами по воздуху проносятся феи, оставляя искрящиеся разноцветные следы...~
@47441 = ~Оторваться от переживания.~
@47442 = ~Оторваться от переживания и уйти.~
@47443 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47444 = ~Уйти.~
@47445 = ~Уйти.~
@47446 = ~Это красно-оранжевый камень, к которому тебя направил клерк. В нем хранится переживание «Всепоглощающее нетерпение».~
@47447 = ~Начать переживание.~
@47448 = ~Уйти.~
@47449 = ~Ты споришь с Амнасом Ужасно Медлительным, Хранителем Львиного ключа, насчет того, важны ли твои поиски настолько, чтобы доверить тебе этот артефакт. Переживание это — одно сплошное мучение... буквально за каждым его словом следует значительная пауза; каждая изложенная им мысль повторяется снова и снова, пока он не позволяет тебе ответить. Ты приводишь аргумент... потом ждешь, ждешь, *ждешь*, пока он не выдаст свой контраргумент. На который ты раздражительно выпаливаешь свой контраргумент... а потом снова должен выслушивать еще один из растянутых, уклончивых, кажущихся бесконечными контраргументов Амнаса. Это все, что ты можешь сделать, исключая вариант, чтобы попросту снести клыкастую голову нечистого и вырвать ключ у дергающегося трупа...~
@47450 = ~Оторваться от переживания.~
@47451 = ~Это красно-оранжевый камень, к которому тебя направил клерк. В нем хранится переживание «Удовольствие от испуга».~
@47452 = ~Оторваться от переживания и уйти.~
@47453 = ~Начать переживание.~
@47454 = ~Уйти.~
@47455 = ~Ты оборачиваешь голову, чтобы осмотреть большую хитрую штуковину, пристегнутую к твоей спине... С нее свисает набор из четырех крыльев, как у летучей мыши; каждое из них сделано из кожи, туго натянутой на плетеный каркас. С обрыва, на котором ты стоишь, Летающая крепость Дилгияра кажется всего лишь крошечной точкой, висящей в серо-голубом небе: на многие мили вокруг нет ничего, кроме воздуха. «Вот так путешествует *каждый* на плане Воздуха, — сказали они, — это просто». Ты ухмыляешься, отступаешь подальше и, разбежавшись, спрыгиваешь со скалы в прохладный поток ветра внизу, оставив желудок где-то позади. Когда крылья внезапно ловят ветер, через все твое тело проходит ошеломляющая дрожь: ты паришь над небытием к жилищу Стихийного Принца...~
@47456 = ~Оторваться от переживания.~
@47457 = ~Оторваться от переживания и уйти.~
@47458 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47459 = ~Уйти.~
@47460 = ~Уйти.~
@47461 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Усталая капитуляция».~
@47462 = ~Начать переживание.~
@47463 = ~Уйти.~
@47464 = ~Дрожа, стуча зубами, безнадежно надеясь, что тебя найдут, ты скручиваешься под одеялом из снега, чтобы сохранить остатки тепла. Борясь с отяжелевшими веками, чтобы не заснуть, ты вдруг осознаешь, что уже не чувствуешь рук... ног... на твоем лице лед... ты устал, ты устал так сильно, что наконец уступаешь неизбежному. Ты закрываешь глаза, горько приветствуя сон. Ощущение поражения выдавливает из твоих щемящих глаз одинокую слезинку, обреченную застыть, даже не достигнув щеки.~
@47465 = ~Оторваться от переживания.~
@47466 = ~Оторваться от переживания и уйти.~
@47467 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Мрачная решительность».~
@47468 = ~Начать переживание.~
@47469 = ~Уйти.~
@47470 = ~Помещение было полностью разгромлено, и все еще продолжало разрушаться, в то время как десятки дерущихся метали оружие, смертоносную магию и самих себя друг в друга в отчаянной битве до последнего. Столбы удушливого зеленого дыма поднимались над грудой безвольных тел, из которой ты вылез, еле увернувшись от какого-то демонического заклинания. Вот она — через дорогу, за дерущейся толпой, за кровопролитной битвой перед тобой, стоит, нетронутая, на чудом устоявшем столе — твоя кружка медовухи! И ты вернешь ее, даже если придется убить всех до единого этих шумных посетителей таверны!~
@47471 = ~Оторваться от переживания.~
@47472 = ~Оторваться от переживания и уйти.~
@47473 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47474 = ~Уйти.~
@47475 = ~Уйти.~
@47476 = ~Это светло-голубой камень, к которому тебя направил клерк. В нем хранится переживание «Сверхъестественная похоть».~
@47477 = ~Начать переживание.~
@47478 = ~Уйти.~
@47479 = ~Ты обнаруживаешь себя в процессе совокупления с суккубом, существом столь сильной потусторонней красоты, что тебя не смущают даже на ее демонские рожки и хлещущий хвост. Она тяжело дышит над тобой... ты жаждешь ее так сильно, что всем своим естеством сосредотачиваешься на этой единственной цели. Когда твоя жизнь вырывается из тебя сверкающим взрывом, ты слышишь радостный смех суккуба — она выпивает тебя досуха, превратив твое тело в бездушный остов...~
@47480 = ~Оторваться от переживания.~
@47481 = ~Оторваться от переживания и уйти.~
@47482 = ~Это светло-голубой камень, к которому тебя направил клерк. В нем хранится переживание «Полное недоумение».~
@47483 = ~Начать переживание.~
@47484 = ~Уйти.~
@47485 = ~Ты просыпаешься от тревожного сна и обнаруживаешь, что находишься во своем влажном логове, превращенный в весьма небольшое четвероногое мясистое существо. Ты лежишь на непокрытой панцирем, совершенно незащищенной спине, и, подняв свою крохотную голову, без обычных на ней усиков, все, что ты можешь разобрать — это твой розоватый живот, частично покрытый мягкими вьющимися волосками, совсем непохожими на черную щетину, которую ты привык там видеть. Твои две — только две! — ноги теперь торчат из нижней части туловища, а не вокруг брюшка. Они выглядят слишком толстыми и неуклюжими по отношению к телу, и безвольно лежат, не пытаясь поднять тебя сами по себе: только сильно сосредоточившись, ты можешь ими двигать. Что с тобой *приключилось*?~
@47486 = ~Оторваться от переживания.~
@47487 = ~Оторваться от переживания и уйти.~
@47488 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47489 = ~Уйти.~
@47490 = ~Уйти.~
@47491 = ~Это красно-оранжевый камень, к которому тебя направил клерк. В нем хранится переживание «Горькое раскаяние».~
@47492 = ~Начать переживание.~
@47493 = ~Уйти.~
@47494 = ~Ты стоишь на палубе своего флагмана, Божественного Молота, когда он подплывает к континенту Агархейм, поддерживаемый в воздухе магическими ветрами. Сама земля дрожит под обстрелом твоего флота; тысячи корабельных пушек и бомбард швыряют колдовским огнем, словно мстительные боги. Ударная волна достигает твоего корабля только несколько минут спустя — непрекращающаяся вибрация, проходящая через все древнее судно и шевелящая даже твои кости — и сопровождается непрерывным рокотом. Когда горы начинают тонуть, а окружающие их моря — кипеть, твой первый офицер подходит и становится рядом с тобой.~
@47495 = ~Продолжить переживание.~
@47496 = ~Прервать переживание и уйти.~
@47497 = ~«Милорд адмирал... разрешите говорить свободно, сэр».

Ты кивком даешь молчаливое согласие, тебя мутит от догадки о том, какой вопрос он задаст.

«Милорд... простите, но почему? Кто дал нам право? Миллиарды жизней...»~
@47498 = ~Продолжить переживание.~
@47499 = ~Прервать переживание и уйти.~
@47500 = ~Ты отвечаешь, не оборачиваясь к нему, не в силах оторвать глаза от Румоса, огромной столицы государства, когда она превращается в облако раскаленных газов шириной в двенадцать миль, и все еще растущее. «Если бы ты знал все вероломство Агаритов, первый офицер Фелм, вероломство за пределами человеческого понимания... ты бы понял. Ты говоришь о нашем праве истреблять их? Да мы не в праве оставить их в живых».~
@47501 = ~Продолжить переживание.~
@47502 = ~Прервать переживание и уйти.~
@47503 = ~«Но... сэр? Все они — предатели? Несомненно, это лишь один на сотню тысяч. Как много невинных...»

«Молчать! Больше ни слова об этом. Так сказал наш король, и его воля исполнена. Порученная нам задача ужасна, и не годится для обдумывания или вопросов. Нет места для жалости, нет места для сожалений — только *долг*».~
@47504 = ~Продолжить переживание.~
@47505 = ~Прервать переживание и уйти.~
@47506 = ~Некоторое время вы молча стоите, наблюдая последние минуты Агархейма. Наконец ты вздыхаешь... низкий прерывистый выдох, звучащий так, будто что-то у тебя внутри сломано. Под медной пластиной, покрывающей изуродованную половину твоего лица, твой мертвый глаз начинает плакать...~
@47507 = ~Продолжить переживание.~
@47508 = ~Прервать переживание и уйти.~
@47509 = ~«Фалм... друг мой... я тебя понимаю. Теперь, глядя на, что я натворил, я понимаю, что если бы я обдумывал то, что сделал... то, что я сделал *на самом деле*... я бы сошел с ума. Подобное деяние... страдания сокрушили бы и уничтожили меня. Так что, первый офицер Фалм, получается, в Агархейме *нет* невинных... ни матерей, ни детей, ни людей *вообще*. Только предатели. Подлые хитрые предатели, заслуживающие в полной мере гнев нашего священнейшего короля. Понимаешь?»~
@47510 = ~Продолжить переживание.~
@47511 = ~Прервать переживание и уйти.~
@47512 = ~«Д-да, милорд».

«Хорошо. А теперь иди... я хочу побыть здесь один».

«Слушаюсь, лорд адмирал». Фалм кивает и спускается вниз, оставив тебя наедине с концом цивилизации.~
@47513 = ~Оторваться от переживания.~
@47514 = ~Оторваться от переживания и уйти.~
@47515 = ~Это красно-оранжевый камень, к которому тебя направил клерк. В нем хранится переживание «Неописуемое разочарование».~
@47516 = ~Начать переживание.~
@47517 = ~Уйти.~
@47518 = ~Теперь ты видишь ее, корону Хефона, сверкающую на мраморном пьедестале. До нее не больше двадцати шагов... с нею ты могла бы вырвать власть над армиями Этанополиса из рук твоего вероломного брата и восстановит отцовское королевство. Какой же дурак твой жалкий братец... ты мрачно улыбаешься этой мысли... оставить в живых единственную дочь короля, думая, что она не сможет ему навредить. ~
@47519 = ~Продолжить переживание.~
@47520 = ~Прервать переживание и уйти.~
@47521 = ~Звук! Скрип кожаных сандалий, тихое шипение... сюда, за третью колонну! Теперь она близко, Медуза Полафи, ревностно охраняющая корону, которую ее слуги давным-давно украли для нее. Прокрадываясь за широкой колонной, ты крепко стискиваешь свой надежный Трижды-благословенный дротик. С Шлемом проворства и Щитом сотни отражений даже такая тварь, как Полафи, тебе нипочем. Теперь в любой миг она может выйти из-за колонны и встреться с тобой. Даже если она отвернется от щита, твой дротик несомненно найдет ее глотку...~
@47522 = ~Продолжить переживание.~
@47523 = ~Прервать переживание и уйти.~
@47524 = ~Внезапно кто-то нежно прикасается к твоему плечу. Ты раскрываешь рот от удивления, обернувшись к лицу — конечно же — Медузы. Смирившись с неизбежным, ты успеваешь лишь выпустить из легких пронзительный крик разочарования... и все части твоего тела... превращаются в холодный серый камень.~
@47525 = ~Оторваться от переживания.~
@47526 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47527 = ~Оторваться от переживания и уйти.~
@47528 = ~Уйти.~
@47529 = ~Уйти.~
@47530 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Чрезвычайно важная тайна».~
@47531 = ~Начать переживание.~
@47532 = ~Уйти.~
@47533 = ~Шестеро имперских слуг спешат перед тобой, распахивая настежь золотые двери Дворца Дракона.

«Да здравствует императрица! — кричат они в унисон. — Тысячу лет! Да здравствует императрица! Тысячу лет!» ~
@47534 = ~Продолжить переживание.~
@47535 = ~Прервать переживание и уйти.~
@47536 = ~За порогом десятки преданных военачальников, королей по праву, падают ниц, касаясь пола головами в почтении, когда ты проходишь мимо них к великому Имперскому трону.~
@47537 = ~Продолжить переживание.~
@47538 = ~Прервать переживание и уйти.~
@47539 = ~Когда ты поворачиваешься лицом к своим слугам, сев на Имперский трон, ты позволяешь небольшой удовлетворенной улыбке прокрасться на тщательно подведенные губы. В твоем сознании мелькает лишь одна мысль...~
@47540 = ~Продолжить переживание.~
@47541 = ~Прервать переживание и уйти.~
@47542 = ~...что тело молодой императрицы, Ву Цу Ша, разбитое, лежит на дне Колодца Одиночества, и что ты — Баи Хва, дочь торговца лошадьми — наконец, готова пошатнуть Империю и подорвать династию Ву до самого ее основания.~
@47543 = ~Оторваться от переживания.~
@47544 = ~Оторваться от переживания и уйти.~
@47545 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Потрясение и нарастающая жажда мести».~
@47546 = ~Начать переживание.~
@47547 = ~Уйти.~
@47548 = ~Ты стоишь где-то на нижних планах, в знойном месте, где земля из кованной меди, а небо из бронзы. Здесь тела грешников, просителей в этом страшном месте, валяются среди железной ежевики и бронзовых скорпионов, пока их кости не превращаются в мелкую серую пыль.~
@47549 = ~Продолжить переживание.~
@47550 = ~Прервать переживание и уйти.~
@47551 = ~Ты косишься на горизонт; костяная пыль поднимается под порывами зловонного ветра, несущего ее со звуком мучительных стонов. Здесь нет ничего, только плоский металлический ландшафт, тянущийся, насколько хватает глаз. Пыль везде и во всем... она жжет тебе глаза, покрывает твой рот изнутри вязкой пленкой. Ты сплевываешь, стираешь ее пальцем, но безуспешно: твой рот уже полностью осквернен ее вкусом.~
@47552 = ~Продолжить переживание.~
@47553 = ~Прервать переживание и уйти.~
@47554 = ~Ты смотришь на «ключ» в своей руке... миниатюрный платиновый шарик... и вспоминаешь лицо человека, который торжественно клялся тебе, что магический портал, через который ты должен пройти — теперь уже, конечно, прошел, — ведет к зеленым полям Байтопии. Во имя всех сил и их посредников, кто-то должен за это заплатить.~
@47555 = ~Оторваться от переживания.~
@47556 = ~Оторваться от переживания и уйти.~
@47557 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47558 = ~Уйти.~
@47559 = ~«Ничего. Прошу прощения за вторжение».~
@47560 = ~«Гробница уже пуста».~
@47561 = ~«Гробница уже пуста».~
@47562 = ~Уйти.~
@47563 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Медленно накатывающий ужас».~
@47564 = ~Начать переживание.~
@47565 = ~Уйти.~
@47566 = ~«Каково оно?» — думаешь ты, внимательно разглядывая вино. Сидящий на другом конце стола скрюченный старик хитро улыбается тебе.

«Прошу вас, сэр, попробуйте, — шепчет он, его тихий голос звучит, как сухие листья, несущиеся по булыжной мостовой. — Уверяю вас, оно более чем оправдает ваши ожидания».~
@47567 = ~Продолжить переживание.~
@47568 = ~Прервать переживание и уйти.~
@47569 = ~Ты киваешь ему и поднимаешь хрустальный бокал, наблюдая игру света в малиновом напитке. Чтобы отведать его, ты преодолел долгий путь... долго и упорно разыскивал этого старика... и будь ты проклят, если теперь позволишь себе торопиться. Нужно насладиться этим моментом.~
@47570 = ~Продолжить переживание.~
@47571 = ~Прервать переживание и уйти.~
@47572 = ~Ты подносишь бокал к губам, вдыхаешь аромат. Букет у него легкий, сладкий, пьянящий... почти дурманящий. Ты перепробовал несчетное количество напитков... написал много книг о них, об их запахе и вкусе, о способах их производства, путешествуя по планам. Но этот... этот напиток считали легендарным. Ни один из встреченных тобой людей не пробовал его. Истории о нем просто нелепы — ничто не может быть таким вкусным. Но если в них есть хоть крупица правды, это должен быть действительно отличный напиток.~
@47573 = ~Продолжить переживание.~
@47574 = ~Прервать переживание и уйти.~
@47575 = ~Наконец ты делаешь осторожный глоток...~
@47576 = ~Продолжить переживание.~
@47577 = ~Прервать переживание и уйти.~
@47578 = ~Невероятно! Неописуемо! Когда его букет омывает твою вкусовую палитру, ты с трудом сдерживаешь порыв содрогнуться от удовольствия. Ничто... *ничто* из того, что ты пробовал за свою долгую жизнь, не имело подобного вкуса. Ты смотришь на старика, испуганно обнаружив, что кубок уже пуст: ты осушил его одним глотком. Ты вытираешь глаза тыльной стороной ладони, не понимая, когда ты начал плакать.~
@47579 = ~Продолжить переживание.~
@47580 = ~Прервать переживание и уйти.~
@47581 = ~«Слезы радости, да? — старик тихонько смеется. — Весьма приятно для языка, не правда ли? Быть может, вы хотите еще?» Он снова улыбается тебе.

«Да... да, если можно...»~
@47582 = ~Продолжить переживание.~
@47583 = ~Прервать переживание и уйти.~
@47584 = ~«Конечно», — отвечает он, наполняя твой бокал. Как ты не стараешься, ты не можешь удержаться, и выпиваешь его одним глотком. Ты засовываешь в бокал палец в попытке найти последнюю каплю. Он еще несколько раз наполняет бокал, и каждый раз ты проглатываешь его, словно изголодавшийся на пиру, не в силах контролировать себя, не в силах отказать себе в том, чтобы не испытать его изысканный вкус еще раз.~
@47585 = ~Продолжить переживание.~
@47586 = ~Прервать переживание и уйти.~
@47587 = ~Он снова тихонько хихикает. «Что за напиток... человек готов ради него на все, разве нет?»

Ты киваешь, не колеблясь. «Да, человек готов...» Глядя на него, ты внезапно обнаруживаешь, что его лукавая улыбка принимает уже совершенно иное значение. Ощущение ужаса начинает подкрадываться к тебе, несмотря на мучительное желание еще раз попробовать этот кроваво-красный напиток...~
@47588 = ~Продолжить переживание.~
@47589 = ~Прервать переживание и уйти.~
@47590 = ~«Да, да... — старик ухмыляется, его желтые глаза блестят. — Человек сделает *что-угодно*, будучи *порабощенным* этим напитком... даже самые ужасные, самые гнусные вещи... как ты вскоре и увидишь, мой новый слуга».~
@47591 = ~Оторваться от переживания.~
@47592 = ~Оторваться от переживания и уйти.~
@47593 = ~Это фиолетовый камень, к которому тебя направил клерк. В нем хранится переживание «Ликантропия».~
@47594 = ~Начать переживание.~
@47595 = ~Уйти.~
@47596 = ~Вдруг осознав, что время уже почти настало, ты вскакиваешь с постели и стремглав выбегаешь из хижины в окружающий ее лес. Спотыкаясь в темноте, ты подходишь к маленькой поляне, залитой лунным светом... той, которую ты нашел на прошлой неделе и решил воспользоваться ею сегодня ночью. Ты торопливо раздеваешься, садишься в высокую траву и ждешь. ~
@47597 = ~Продолжить переживание.~
@47598 = ~Прервать переживание и уйти.~
@47599 = ~Ты закрываешь глаза, слушая спокойное пение сверчков, гортанное кваканье жаб в ручье поблизости, шелест трав, ласкаемых ветром. О чем будет думать тот, кто увидит это твоими глазами, *проживет* этот миг и то, что будет дальше? Скоро ты отправишься в город и найдешь клирика, чтобы он избавил тебя от этого проклятья... а пока можно воспользоваться моментом. Ты потираешь ладони в предвкушении, улыбаясь, как бородатый рыжеволосый гигант-безумец, одиноко сидящий нагишом на лесной поляне, поздней ночью.~
@47600 = ~Продолжить переживание.~
@47601 = ~Прервать переживание и уйти.~
@47602 = ~Мороз пробегает у тебя по коже, и твои чувства значительно обостряются. Ты вдыхаешь носом, улавливая все запахи вокруг себя: сырой земли, пота на сброшенной тобой одежде, опоссума, боязливо взбирающегося на дерево позади тебя...~
@47603 = ~Продолжить переживание.~
@47604 = ~Прервать переживание и уйти.~
@47605 = ~Ты открываешь глаза и смотришь на свои предплечья. Под слабым светом луны вся их поверхность еле заметно дрожит... но уже через миг плоть начинает немыслимо вздыматься, и наружу пробиваются пучки густой бурой шерсти. С ужасающим хрустом, который издают ломающиеся суставы и перемалываемые кости, твоя спина и плечи начинают сгибаться и расширяться... неприятно, но не так уж больно. Твои мышцы, все твое тело удваивается, утраивается в размерах и продолжает расти.~
@47606 = ~Продолжить переживание.~
@47607 = ~Прервать переживание и уйти.~
@47608 = ~Все еще в восторге от собственного преображения, ты наблюдаешь, как пальцы твои усыхают, руки превращаются в мясистые лапы, покрытые шерстью, с массивными черными когтями. Изменившись, твои глаза приспосабливаются к темноте, и ночь становится светлее... тебе становится видна широкая пасть; ты осторожно трогаешь свой влажный сопящий нос, посмеиваясь про себя. В следующий раз, думаешь ты, когда проклятье начнет действовать, ты поглядишь в зеркало или водоем... рассмотришь, как меняется твое лицо, утрачивая свои привычные черты и становясь медвежьей мордой.~
@47609 = ~Продолжить переживание.~
@47610 = ~Прервать переживание и уйти.~
@47611 = ~Вскоре становится сложно сосредоточиться на чем-либо, кроме своих базовых потребностей... хорошо бы поесть, прямо сейчас. Да, поесть... может, тебе повезет, и ты найдешь в ручье славного жирного сома. Пыхтя, ты поднимаешь свой массивный зад и начинаешь брести через лес на всех четырех, направляясь к берегу...~
@47612 = ~Оторваться от переживания.~
@47613 = ~Оторваться от переживания и уйти.~
@47614 = ~Похоже, это переживание пробудило в тебе какие-то похожие, давно забытые воспоминания... ты чувствуешь, будто что-то приобрел, используя камень переживаний.~
@47615 = ~Уйти.~
@47616 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47617 = ~«Что с тобой?»~
@47618 = ~«Что случилось с твоим добродушным нравом?»~
@47619 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47620 = ~«Скоро. Иди спать».~
@47621 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47622 = ~«Что с тобой?»~
@47623 = ~«Что случилось с твоим добродушным нравом?»~
@47624 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47625 = ~«Скоро. Иди спать».~
@47626 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47627 = ~«Что с тобой?»~
@47628 = ~«Что случилось с твоим добродушным нравом?»~
@47629 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47630 = ~«Скоро. Иди спать».~
@47631 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47632 = ~«Что с тобой?»~
@47633 = ~«Что случилось с твоим добродушным нравом?»~
@47634 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47635 = ~«Скоро. Иди спать».~
@47636 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47637 = ~«Что с тобой?»~
@47638 = ~«Что случилось с твоим добродушным нравом?»~
@47639 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47640 = ~«Скоро. Иди спать».~
@47641 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47642 = ~«Что с тобой?»~
@47643 = ~«Что случилось с твоим добродушным нравом?»~
@47644 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47645 = ~«Скоро. Иди спать».~
@47646 = ~«Что? Чего ты хочешь? Когда уже начнет литься кровь?»~
@47647 = ~«Что с тобой?»~
@47648 = ~«Что с тобой?»~
@47649 = ~«Что случилось с твоим добродушным нравом?»~
@47650 = ~«Скоро. Мне только нужно задать тебе пару вопросов».~
@47651 = ~«Скоро. Иди спать».~
@47652 = ~«То было тогда, это — теперь. Меня уже тошнит от всего этого безделья и жеманства. Идем, убьем кого-нибудь, а?»~
@47653 = ~«Я хочу знать, что случилось с твоей личностью».~
@47654 = ~«Сперва ответь мне на пару вопросов».~
@47655 = ~«Забудь. Мы поговорим позже».~
@47656 = ~«Только если потом кого-нибудь убьем».~
@47657 = ~«Что с тобой случилось?»~
@47658 = ~«Что ты можешь сказать о Морте?»~
@47659 = ~«Что ты можешь сказать об Анне?»~
@47660 = ~«Что ты можешь сказать о Дакконе?»~
@47661 = ~«Что ты можешь рассказать о Падшей Грации?»~
@47662 = ~«Что ты можешь сказать о Вейлоре?»~
@47663 = ~«Что ты можешь сказать об Игнусе?»~
@47664 = ~«Что ты можешь сказать о Нордоме?»~
@47665 = ~«Что ты можешь сказать о себе?»~
@47666 = ~«Что ты можешь сказать о себе?»~
@47667 = ~«Что ты можешь сказать о себе?»~
@47668 = ~«Забудь. Прощай».~
@47669 = ~«Скажем так: среда, в которой мы находимся, благоприятна для ненависти. Оставим это, ладно? Я *ненавижу* Нижние планы, а они — меня».~
@47670 = ~«Почему?»~
@47671 = ~«Тогда ответь мне на пару вопросов».~
@47672 = ~«Довольно. Я тебя прячу».~
@47673 = ~«Потому что однажды они меня испортили, и больше этого не повторится, пень! А теперь заткнись и пошли убивать!»~
@47674 = ~«Сначала ответь на несколько вопросов...»~
@47675 = ~«На этом разговор окончен».~
@47676 = ~Оружие угрюмо молчит.~
@47677 = ~«Он — зло, продажный пень, и я бы доверял ему не дальше, чем мог его зашвырнуть... если бы у меня были руки. Тебе следует проявить благоразумие и *повнимательнее* приглядываться к его советам. Скажем так, тебе не следует ему доверять: раньше я встречал таких как он, и однажды они ударят тебе в спину».~
@47678 = ~«Насчет нее не знаю. В ней течет кровь нечистого. Нечисти ты не можешь доверять. Советую бросить ее, и поскорее. Кроме того, она еще ребенок. Ты мог бы подыскать кого-нибудь... поопытнее... ну, ты понимаешь, о чем я».~
@47679 = ~«Спасибо за информацию. У меня есть другие вопросы...»~
@47680 = ~«Спасибо».~
@47681 = ~«Этот суровый, бесстрастный и тощий? От него пользы, как от сношения с модроном. Больше мне добавить нечего».~
@47682 = ~«Спасибо за информацию. У меня есть другие вопросы...»~
@47683 = ~«Спасибо».~
@47684 = ~«Конечно, верь ей, почему бы нет. Никогда не бойся довериться танарри. То, что они родились злыми, не значит, что они плохие. Кстати, это был сарказм».~
@47685 = ~«Спасибо за информацию. У меня есть другие вопросы...»~
@47686 = ~«Спасибо».~
@47687 = ~«Без понятия. Никогда его раньше не видел».~
@47688 = ~«Спасибо за информацию. У меня есть другие вопросы...»~
@47689 = ~«Спасибо».~
@47690 = ~«Я Оправдатель. Я был выкован под эгидой Гора в Аркадии. Слушай, ты мне кажешься знакомым... Меня назвали так, потому что я могу найти оправдание почти любой вещи. Кроме того, после нескольких взмахов мной большинство понимает, что все сказанное тобой оправдано».~
@47691 = ~«Знакомым чем?»~
@47692 = ~«Понятно. У меня еще вопросы...» ~
@47693 = ~«Ладно. Прощай».~
@47694 = ~«Я все еще Оправдатель... знаешь что, ты все еще чем-то кажешься мне знакомым, и это сводит меня с  ума... что-то насчет танарри и... эх, неважно. Я твой лучший друг и худший кошмар. Смотря с какого конца посмотреть, пень. Зовут Оправдатель. ОПРАВДАТЕЛЬ. Не забывай об этом».~
@47695 = ~«Еще не выяснил, откуда ты меня знаешь? Хорошо. У меня еще вопросы...»~
@47696 = ~«До сих пор не вспомнил, а? Тогда прощай».~
@47697 = ~«Теперь я вспомнил, кто ты такой. Когда-то ты считал себя моим владельцем. Все эти шрамы сбили меня с толку, но теперь-то я вспомнил твое личико. И знаешь, что? После того, как ты погиб, отбиваясь от тех вроков, они испортили меня. Все из-за тебя. Хотя знаешь, за тобой следует кровь. Раз уж я при тебе, не сомневаюсь, что ты омоешь меня кровью».~
@47698 = ~«Кто такие вроки?»~
@47699 = ~«Испортили тебя? Каким образом?»~
@47700 = ~«Забудь об этом. У меня есть еще вопросы...»~
@47701 = ~«Забудь об этом».~
@47702 = ~«Не знаю. Я вспомню, если не будешь мне надоедать».~
@47703 = ~«Отлично. У меня еще вопросы...»~
@47704 = ~«Отлично. Веселого вспоминания. Прощай».~
@47705 = ~«Кто такие вроки? Ты что, ничего не помнишь? Это танаррийские демоны-стервятники. Мне казалось, что после того, как их копье пробило тебе грудь, ты мог бы запомнить эдакий пустяк. Мы дрались с ними, мы убивали их, но одному из них удалось записать тебя в книгу мертвых... а потом они взяли меня и испортили».~
@47706 = ~«Испортили как?»~
@47707 = ~«Отлично. У меня есть другие вопросы...»~
@47708 = ~«Очень жаль. Прощай».~
@47709 = ~Его голос звучит едва ли не отчаянно в попытке не вспоминать. «Тебе лучше не знать. Их разум чужероден и порочен до самого основания. Пришлось служить таким как они... — он дрожит в твоей руке. — Такое не хочется вспоминать. Надо отдать им должное — они изобретательны в пытках».~
@47710 = ~«У меня есть еще вопросы...» ~
@47711 = ~«Еще бы. Прощай».~
@47712 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47713 = ~«Что произошло?»~
@47714 = ~«Что произошло?»~
@47715 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47716 = ~«Без проблем. Прощай».~
@47717 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47718 = ~«Что произошло?»~
@47719 = ~«Что произошло?»~
@47720 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47721 = ~«Без проблем. Прощай».~
@47722 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47723 = ~«Что произошло?»~
@47724 = ~«Что произошло?»~
@47725 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47726 = ~«Без проблем. Прощай».~
@47727 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47728 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47729 = ~«Что произошло?»~
@47730 = ~«Что произошло?»~
@47731 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47732 = ~«Без проблем. Прощай».~
@47733 = ~«Что произошло?»~
@47734 = ~«Что произошло?»~
@47735 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47736 = ~«Без проблем. Прощай».~
@47737 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47738 = ~«Что произошло?»~
@47739 = ~«Что произошло?»~
@47740 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47741 = ~«Без проблем. Прощай».~
@47742 = ~Оправдатель говорит чуть ли не смущенно: «Я слегка съехал с катушек на этих Нижних планах, босс. Извини. Я постараюсь больше этого не допустить».~
@47743 = ~«Что произошло?»~
@47744 = ~«Что произошло?»~
@47745 = ~«Без проблем. Просто ответь мне на пару вопросов».~
@47746 = ~«Без проблем. Прощай».~
@47747 = ~«Когда-то давно мы с моим владельцем пошли за чем-то в Бездну. Забыл, за чем. Мы решили, что достаточно круты, чтобы нарываться на каждого встречного. Мы ошибались. Моего владельца убили, а меня забрали и... *испортили*. Временами, когда меня обнажают на Нижних планах, я начинаю злиться».~
@47748 = ~«Очень жаль. У меня к тебе несколько вопросов...»~
@47749 = ~«Очень жаль. Прощай».~
@47750 = ~«Все, что угодно, босс».~
@47751 = ~«Что с тобой случилось?»~
@47752 = ~«Что ты можешь сказать о Морте?»~
@47753 = ~«Что ты можешь сказать об Анне?»~
@47754 = ~«Что ты можешь сказать о Дакконе?»~
@47755 = ~«Что ты можешь рассказать о Падшей Грации?»~
@47756 = ~«Что ты можешь сказать о Вейлоре?»~
@47757 = ~«Что ты можешь сказать об Игнусе?»~
@47758 = ~«Что ты можешь сказать о Нордоме?»~
@47759 = ~«Что ты можешь сказать о себе?»~
@47760 = ~«Что ты можешь сказать о себе?»~
@47761 = ~«Что ты можешь сказать о себе?»~
@47762 = ~«Забудь. Прощай».~
@47763 = ~«Когда-то давно, когда ты был моим владельцем, мы пошли за чем-то в Бездну. Забыл, за чем. Мы решили, что достаточно круты, чтобы нарываться на каждого встречного. Мы ошибались. Мы ввязались в драку с вроками, танаррийскими демонами-стервятниками, и хотя мы перебили их целую кучу, одному из них удалось разорвать на части твое сердце своим беспощадным копьем. Меня забрали и... *испортили*. Временами, когда меня обнажают на Нижних планах, меня начинает колбасить».~
@47764 = ~«Это ужасно. У меня есть другие вопросы к тебе...»~
@47765 = ~«Очень жаль. Прощай».~
@47766 = ~Кажется, он немного смущен. «Я потерял контроль над той частью, которую испортили танарри, когда я потерялся в Бездне. Обычно мне удается с ней справляться. Извини, босс».~
@47767 = ~«Без проблем. Ответь еще на несколько вопросов...»~
@47768 = ~«Без проблем. Прощай».~
@47769 = ~У тебя складывается впечатление, что Глаз палицы двигается туда-сюда. Он шепчет: «У меня насчет него дурное предчувствие, босс, но я не могу этого объяснить. Кажется, я знаю этого черепа; он связан с кучей плохих воспоминаний. Но я не могу этого объяснить, потому что не помню...»~
@47770 = ~«Может, позже. У меня есть другие вопросы...»~
@47771 = ~«Может, позже. Прощай».~
@47772 = ~«Сказать честно? Ну, она немного горячая... но мне кажется, она на тебя запала. Она это скрывает, но... думаю, ты можешь ей доверять, пока не предашь ее».~
@47773 = ~«Спасибо. У меня есть другие вопросы...»~
@47774 = ~«Спасибо. Прощай».~
@47775 = ~«Он странствует с тобой не просто так, босс, и я не уверен, что это в твоих интересах. Ты же знаешь этих гитцераев: они держатся вместе, а если и сотрудничают с другими, то по определенным причинам. Я не буду спускать с него свой Глаз».~
@47776 = ~«Спасибо. У меня есть другие вопросы...»~
@47777 = ~«Спасибо за участие. Прощай».~
@47778 = ~Палица неистово шепчет тебе: «Босс! Что у тебя за дела с танарри? Два слова: танарри, суккуб. Она — зло. Ее кровь создана из злой сущности. Ей нельзя верить. Она может хорошо себя вести, но это еще ничего не значит. Она может говорить тебе, что изменилась, но это всего лишь еще одно вранье. Она и весь ее род плетет сети обмана. Всегда. Такова их сущность».~
@47779 = ~«Спасибо за мнение. Ответь еще на пару вопросов...»~
@47780 = ~«Спасибо за мнение. Прощай».~
@47781 = ~«Вообще-то ... ну, вообще-то, ничего. Я его не знаю, босс».~
@47782 = ~«Хорошо. Тогда ответь на несколько вопросов...»~
@47783 = ~«Ладно. Прощай».~
@47784 = ~«Я Оправдатель. Меня так назвали, потому что я могу найти объяснение почти всему. Кроме того, после нескольких взмахов мной большинство понимает, что все сказанное тобой оправдано. Я был выкован кузнецами авгуров самого бога Гора на равнинах Гелиополиса в Аркадии. Слушай... ты кажешься мне знакомым...»~
@47785 = ~«Знакомым чем?»~
@47786 = ~«Понятно. У меня еще вопросы...» ~
@47787 = ~«Ладно. Прощай».~
@47788 = ~«Что тут сказать? Я оружие добра и света, и от меня есть толк в драках. Знаешь, что: есть в тебе что-то знакомое, и это сводит меня с ума... что-то насчет танарри и... эх, неважно. Я твой лучший друг и худший кошмар. Смотря с какого конца посмотреть». Он хохочет над собственной шуткой.~
@47789 = ~«Еще не выяснил, откуда ты меня знаешь? Хорошо. У меня еще вопросы...»~
@47790 = ~«До сих пор не вспомнил, а? Тогда прощай».~
@47791 = ~«Теперь-то я вспомнил, кто ты такой! Когда-то давным-давно ты владел мной. В моей памяти есть пробелы, но... да, это ты. Все эти шрамы сбили меня с толку. Теперь ты намного более грозный. Должно быть, тебе пришлось несладко: я, бывало, помогал тебе советами, когда ты восставал из мертвых, но когда ты помер в Бездне, отбиваясь от тех вроков, они забрали меня с собой и оставили тебя гнить. Рад, что мы снова встретились».~
@47792 = ~«Кто такие вроки?»~
@47793 = ~«Испортили тебя? Каким образом?»~
@47794 = ~«Забудь об этом. У меня есть еще вопросы...»~
@47795 = ~«Забудь об этом».~
@47796 = ~Я выяснил, что Оправдатель, говорящая палица, кода-то был моим оружием. Он мало что помнит из моего прошлого, но похоже на то, что мы ходили за чем-то в Бездну, где я и погиб.~
@47797 = ~«Извини, но я правда не могу сейчас вспомнить... дай мне еще немного времени — уверен, я вспомню».~
@47798 = ~«Отлично. У меня еще вопросы...»~
@47799 = ~«Отлично. Веселого вспоминания. Прощай».~
@47800 = ~«Они танаррийские демоны-стервятники. Ты храбро сражался, но их было слишком много. Им удалось пробиться через нашу оборону, они проткнули тебе сердце шипастым копьем и оставили истекать кровью. Они забрали меня и испортили... это был кошмар...»~
@47801 = ~«Испортили как?»~
@47802 = ~«У меня есть еще вопросы...» ~
@47803 = ~«Очень жаль. Прощай».~
@47804 = ~Его голос звучит едва ли не отчаянно в попытке не вспоминать. «Тебе лучше не знать. Их разум чужероден и порочен до самого основания. Пришлось служить таким как они... — он дрожит в твоей руке. — Такое не хочется вспоминать. Надо отдать им должное — они изобретательны в пытках».~
@47805 = ~«У меня есть еще вопросы...» ~
@47806 = ~«Еще бы. Прощай».~
@47807 = ~~
@47808 = ~На прочном металле этой палицы вырезан глаз, точнее, Глаз. Когда палица начинает говорить, он вспыхивает синим, передавая тебе ее мысли и чувства. «Здравствуй. Должно быть, ты мой новый хозяин».~
@47809 = ~«Правильно. У меня есть пара вопросов к тебе...»~
@47810 = ~«И снова здравствуй. Чего ты от меня хочешь?»~
@47811 = ~«Мне нужно всего лишь несколько ответов...»~
@47812 = ~«Ничего. Прощай».~
@47813 = ~«Похоже, у этой дубинки что-то вроде зависти к чужой мудрости. Забей, палка».~
@47814 = ~«Умолкни. У меня есть другие вопросы...»~
@47815 = ~«На этом разговор окончен».~
@47816 = ~То, что ты сперва принял за дверь в арке, оказалось картиной. Художник использовал тени от нависающей арки и несколько утонченных эффектов детализации, чтобы придать этой двери иллюзию материальности.~
@47817 = ~«Анна, ты уверена, что это и есть та дверь?»~
@47818 = ~Закрыть глаза, открыть дверь.~
@47819 = ~Осмотреть дверь.~
@47820 = ~Оставить «дверь» в покое.~
@47821 = ~~
@47822 = ~Ты закрываешь глаза, тянешь руку к двери и нащупываешь ее... к своему удивлению, ты обнаруживаешь ручку. Приложив небольшое усилие, ты открываешь дверь. Узкий проход ведет в здание; оттуда доносится отдаленное завывание.~
@47823 = ~«Настало время идти...»~
@47824 = ~Не считая мастерства исполнения, в этой картине нет ничего примечательного. «Дверь» нарисована на грубой каменной стене; ты ощущаешь камень и раствор под нарисованной деревянной поверхностью.~
@47825 = ~«Анна, ты уверена, что это и есть та дверь?»~
@47826 = ~Закрыть глаза, открыть дверь.~
@47827 = ~Оставить «дверь» в покое.~
@47828 = ~«Хорошо. Это все, что я хотел узнать. Прощай».~
@47829 = ~«Моей милой Анне пришлось пробираться в переулок, где она нашла тебя, через одно из их жилищ... пристанище, кишащее ими, стояло между ней и тем переулком».~
@47830 = ~«Да... она сказала что-то насчет того, что у хаоситов есть особый вход, — Фарод на миг задумывается. — Это дверь, которую можно открыть, лишь закрыв глаза. Иначе она будет выглядеть просто одной из картин Улья, на которой нарисована дверь».~
@47831 = ~«Да... — с улыбкой говорит Фарод. — Пути Сигила неисповедимы, трупик. Пути Сигила неисповедимы».~
@47832 = ~«Значит... есть здание, через которое мне нужно пройти, *прежде* чем я попаду на эту 'улицу с призраками'?»~
@47833 = ~«У меня есть другие вопросы к тебе...»~
@47834 = ~«Хорошо. Это все, что я хотел узнать. Прощай».~
@47835 = ~«Я припоминаю эту дверь... она на северо-востоке от Тлеющего трупа. Однако я думал, что это просто картина. Значит, она становится НАСТОЯЩЕЙ, если открыть ее с закрытыми глазами?»~
@47836 = ~«Значит, эта... нарисованная дверь... на северо-востоке от Тлеющего трупа? И она становится СОВСЕМ не нарисованной, если пытаешься открыть ее с закрытыми глазами?»~
@47837 = ~«У меня есть другие вопросы к тебе...»~
@47838 = ~«Отлично, это все, что я желал знать. Пойду, поищу ту нарисованную дверь».~
@47839 = ~«У меня есть другие вопросы к тебе...»~
@47840 = ~«Отлично, это все, что я желал знать. Пойду, поищу ту нарисованную дверь».~
@47841 = ~Джарим остался очень довольным рубином, который я принес ему. Интересно, был бы он так же доволен, если бы я сказал ему, что этот камень со шкатулки Моридора?~
@47842 = ~Изготовителю заклинаний по имени Джарим нужен рубин для завершения своих заклинаний. Он обещал щедро вознаградить мои поиски, если я принесу ему камень. Его дом находится на площади Старьевщиков.~
@47843 = ~Гниющий Копчик, владелец таверны «Ворота предателей», сообщил мне, что отцы города при расширении тюрьмы обнаружили в подземелье заключенного в каменный пузырь дэва. Они его, естественно, не освободили, только забрали у него меч и им наводили порядок в камерах заключенных.~
@47844 = ~Человек по имени Креден сказал мне, что если я хочу пройти сквозь забитую мусором арку на площади Старьевщиков, мне следует спросить об этом женщину по имени Гвоздинка. Еще он сказал, что Гвоздинка находится к северо-востоку от Управления по борьбе с вредителями и болезнями, у кучи деревянного мусора.~
@47845 = ~Девор, торговец со склада, сказал, что если что-то случится, то я должен вернуться к нему. В обмен я согласился оставить его в покое.~
@47846 = ~В комнате Соэго я нашел спрятанный дневник, описывающий в деталях то, как на него напал крысооборотень, как в итоге у него развилась ликантропия, и как он сбежал из Морга после того, как непреднамеренного убил и сожрал своего друга. В поисках укрытия он забрел в Логово Мысли и согласился служить Многоединому, коллективному разуму черепных крыс, которые там собрались. Теперь он живет в Мертвых Народах, шпионя за нежитью для Многоединого, который надеется однажды захватить эту часть катакомб.~
@47847 = ~Набат из таверны «Ворота предателей» рассказал, что мне нужно сделать для третьей части ключа. Возле ворот во Внешние земли живет смотритель, который, по слухам, богатый человек... и еще говорят, что его собираются убрать из-за его богатства.~
@47848 = ~Фарод сказал мне, где нашли мое тело... на «улице с призраками» возле бара «Тлеющий труп» в Улье. Возможно, там я смогу выяснить обстоятельства своей смерти. Он сказал, что чтобы добраться до переулка, я должен пройти через здание с множеством комнат, занимаемое хаоситами. Вход в это здание — нарисованная дверь к северу от Тлеющего трупа; когда закрываешь глаза, дверь становится настоящей. Этот город становится все более и более странным... ~
@47849 = ~«Ага... ее намалевали чокнутые маляры из Голодных Псов. Это настоящая дверь, но как только ты посмотришь на нее, она становится картиной».~
@47850 = ~«Как им это удалось?»~
@47851 = ~Анна пожимает плечами. «На планах бывают и более странные штуки, — внезапно она мрачнеет. — Ты еще спроси, как те удалось выписаться из книги мертвых после того, как я была УВЕРЕНА, что ты труп».~
@47852 = ~«Значит, эта дверь... мне просто не смотреть на нее? А *потом* открыть?»~
@47853 = ~Анна смотрит на дверь, потом кивает. «В этом-то и весь секрет, если верить слухам».~
@47854 = ~«Тогда ладно... Сделаем, как ты говоришь. Просто...»~
@47855 = ~«Погодь! — Анна останавливает тебя перед дверью. — Это единственная известная мне дорога туда, где я нашла твой труп, но она не самая безопасная, сечешь? Ты уверен, что готов? Я здесь не за тем, чтоб нянчиться с тобой, без разницы, что там наплел старый костыль».~
@47856 = ~«Что такого опасного за этой дверью?»~
@47857 = ~«Не беспокойся обо мне, просто держись сзади. А теперь дай-ка я открою дверь».~
@47858 = ~«Пойду-ка я захвачу еще оружия и отдохну чуток перед тем, как мы войдем».~
@47859 = ~«Хаоситы, — шепчет Анна. — Они не дружат с головой. Лают, как сумасшедшие, день и ночь. Могут раскрасить тебя краской, а могут разбить тебе черепушку как горшок. Опасные знатоки».~
@47860 = ~«Не волнуйся: я из их фракции».~
@47861 = ~«Раз они такие опасные, тогда как тебе удалось пробраться?»~
@47862 = ~«Не беспокойся обо мне, просто держись сзади. А теперь дай-ка я открою дверь».~
@47863 = ~«Хм-м. Тогда пойдем, прикупим снаряжения и вернемся позже».~
@47864 = ~«О, так ты считаешь, что все хаоситы дружат между собой? — она презрительно усмехается. — Тогда ты ДОСТАТОЧНО чокнутый, чтобы быть одним из них».~
@47865 = ~«Раз они такие опасные, тогда как тебе удалось пробраться?»~
@47866 = ~«Не беспокойся обо мне, просто держись сзади. А теперь дай-ка я открою дверь».~
@47867 = ~«Хм-м. Тогда пойдем, прикупим снаряжения и вернемся позже».~
@47868 = ~«Я кралась тихонько как мышка. Нельзя же тебя покрасить или замочить, если тебя НЕ ВИДЯТ, — она окидывает тебя хмурым взглядом с ног до головы. — Сомневаюсь, что смогу провернуть такой же трюк с тобой. На вид ты тот еще увалень».~
@47869 = ~«Просто держись позади. Дай-ка я открою дверь...»~
@47870 = ~«Хм-м. Тогда пойдем, прикупим снаряжения и вернемся позже».~
@47871 = ~Невидимое оружие Равель~
@47872 = ~Негативный символ~
@47873 = ~Метка Бритвенных Ангелов~
@47874 = ~Атака Тени 1~
@47875 = ~Атака Тени 2~
@47876 = ~Кинжал~
@47877 = ~Это невидимое оружие, используемое Тенью #1 в рубящей атаке.~
@47878 = ~Это невидимое оружие, используемое Тенью #2 в рубящей атаке.~
@47879 = ~КОГТИСТАЯ ЛАПА
Вес: 1

Это лапа какой-то крупной птицы. Скорее всего, кто-то ее выбросил из обеда.~
@47880 = ~ТРУБКА
Вес: 0

Это маленькая деревянная трубка, вырезанная в форме головы демона.~
@47881 = ~КАСТЕТ
Урон: 1-10 колющий
Скорость: 1
Вес: 1
Специализация: кулаки
Не используется магами

Будучи полностью переделанным вариантом обычного кастета, этот кастет снабжен длинными бритвенно-острыми лезвиями. ~
@47882 = ~КАСТЕТ
Урон: 1-6 колющий
Скорость: 1
Вес: 1
Специализация: кулаки
Не используется магами

Это кастет с маленькими шипами, приваренными к нему для нанесения дополнительного урона.~
@47883 = ~«ПОТРОШИТЕЛЬ»
(уникальное, артефакт, уловка)
Урон: 4-80 + 20
+20 к попаданию
+20 к Классу Брони
Устанавливает все параметры в 25
Вес: 0
Скорость: 1
Специализация: клинковые

Это страшное оружие явно предназначено для того, чтобы тестеры смогли как можно быстрее убить любое существо на их пути.~
@47884 = ~«Что?.. Кто?..»~
@47885 = ~«Приветствую».~
@47886 = ~«Прощай».~
@47887 = ~«Опять ты?»~
@47888 = ~«Приветствую».~
@47889 = ~«Прощай».~
@47890 = ~«А, ты вернулся. Ну как, нашел?»~
@47891 = ~«Нет, все еще ищу».~
@47892 = ~«А что я должен был искать?»~
@47893 = ~«Такой тебе подходит?»~
@47894 = ~«Привет еще раз. Извини за грубость, но теперь, когда у меня есть рубин, мне нужно подготовиться к совершению заклинания».~
@47895 = ~«Прощай».~
@47896 = ~«У меня нет времени на твои разговоры. Понимаешь, я думаю над тем, как мне закончить свое заклинание без ключевого компонента».~
@47897 = ~«Возможно, я смогу помочь».~
@47898 = ~«Тогда я, пожалуй, пойду. Прощай».~
@47899 = ~Джарим на секунду умолкает. «Думаю, хуже от этого не будет. Для завершения заклинания мне нужен рубин. Он должен быть исключительного качества, а не тот мусор, что продается на рынке. Если найдешь такой, принеси его мне, и я щедро оплачу твои заботы».~
@47900 = ~«Прощай».~
@47901 = ~«Не сдавайся. Рубин обязательно должен быть где-то поблизости».~
@47902 = ~«Прощай».~
@47903 = ~«Ты должен был искать рубин, вспоминаешь? И если находишь, принести его сюда».~
@47904 = ~«Прощай».~
@47905 = ~«Он великолепен! А где ты его... А, неважно. Вот, держи, — Джарим в обмен за камень дает тебе порядочное количество монет. — А теперь, если ты не против, я бы хотел бы поработать над своим заклинанием».~
@47906 = ~«Прощай».~
@47907 = ~Перед тобой крепкий парень. Похоже, он распределяет содержимое ящиков по прилавкам на рынке. Он кивает, когда ты подходишь. «Добрый день, рубака».~
@47908 = ~«Приветствую».~
@47909 = ~Игнорировать его.~
@47910 = ~Он снова кивает. «Чем я могу тебе помочь?»~
@47911 = ~«У меня есть несколько вопросов...»~
@47912 = ~«Ничего. Прощай».~
@47913 = ~«Хорошо». Он ждет твоих вопросов.~
@47914 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@47915 = ~Он качает головой. «Повелитель Костей... не любит гостей, рубака. Можешь его искать, но тебе не *захочется* его найти».~
@47916 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@47917 = ~«Где мне купить оружие?»~
@47918 = ~«Где мне купить что-нибудь магическое?»~
@47919 = ~«Что ты можешь рассказать об этом районе?»~
@47920 = ~«Неважно. Прощай».~
@47921 = ~Он некоторое время пристально смотрит на тебя, потом его взгляд останавливается на твоих шрамах. Он пожимает плечами, смотря тебе в глаза. «Выйди из рынка, следуй на юг, потом немного на восток. Там будет разрушенный дом. Да хранят тебя силы, рубака». Он отворачивается и возвращается к своим делам.~
@47922 = ~«Спасибо. Прощай».~
@47923 = ~~
@47924 = ~~
@47925 = ~~
@47926 = ~~
@47927 = ~Он хмурится и осматривает тебя сверху донизу. «Что ж... в этом черепе было что-нибудь особенное?»~
@47928 = ~«Нет».~
@47929 = ~«Да. Он говорящий».~
@47930 = ~Он пожимает плечами. «Тогда не вижу, зачем он мог кому-то понадобиться».~
@47931 = ~«Да...»~
@47932 = ~«Ладно. Позволь мне спросить кое о чем еще...»~
@47933 = ~«Я должен идти. Прощай».~
@47934 = ~Он бросает на тебя взгляд. «Я бы сказал, что его можно считать особенным. Что означает, что он мог привлечь внимание Лотара, Повелителя Костей».~
@47935 = ~«Где мне найти этого Лотара?»~
@47936 = ~~
@47937 = ~«Тебе следует поговорить с Анце. Обычно он у прилавка возле печки».~
@47938 = ~«У меня есть еще вопросы...»~
@47939 = ~«Я должен идти. Прощай».~
@47940 = ~~
@47941 = ~«Что, если он умеет говорить?»~
@47942 = ~«У меня есть еще вопросы...»~
@47943 = ~«Я должен идти. Прощай».~
@47944 = ~«Тебе нужно поговорит с Аалеком, он обычно у дальнего прилавка возле печки».~
@47945 = ~«У меня есть еще вопросы...»~
@47946 = ~«Я должен идти. Прощай».~
@47947 = ~Он вздыхает. «Это мой дом... Думаю, есть места и получше, но есть и похуже, — он снова пожимает плечами. — Если нужны подробности, подойди к парню Анце, Лазло. Он обычно возле печки. Парнишка — любитель поболтать».~
@47948 = ~«У меня есть другие вопросы...»~
@47949 = ~«Я должен идти. Прощай».~
@47950 = ~Рабочий поднимает на тебя взгляд. «Здравствуй. Чем могу помочь?»~
@47951 = ~«У меня есть несколько вопросов...»~
@47952 = ~«Ничем, прощай».~
@47953 = ~Перед тобой крепкий с виду парень. Кажется, он поглощен проверкой содержимого ящиков. Он не замечает твоего приближения.~
@47954 = ~«Приветствую».~
@47955 = ~Игнорировать его.~
@47956 = ~Он смотрит на тебя через плечо, затем возвращается к работе. «Извини, рубака. Я не могу прерваться, чтобы потрепаться с тобой. Слишком много работы». Он возвращается к своим делам.~
@47957 = ~«У меня есть несколько вопросов...» ~
@47958 = ~«Хорошо, прощай».~
@47959 = ~Говоря с тобой, он не отрывается от работы. «Извини, придется тебе найти кого-нибудь другого для твоих вопросов: у меня попросту нет времени. Спроси у Лазло, он обычно возле топки».~
@47960 = ~Уйти.~
@47961 = ~Перед тобой работник рынка. Он замечает твое приближение и хмурится. «Привет, рубака».~
@47962 = ~«У меня есть несколько вопросов...» ~
@47963 = ~Он издает вздох. «Я бы тебе помог, да времени нет. Спроси у Лазло, он обычно возле топки».~
@47964 = ~«Ладно. Прощай».~
@47965 = ~Перед тобой жилистый старик, который, судя по всему, наблюдает за всеми рабочими рынка. Время от времени он выкрикивает им приказы, и те быстро исполняют их. Он хмурится при твоем приближении.~
@47966 = ~«Приветствую».~
@47967 = ~Игнорировать его.~
@47968 = ~Его лицо из хмурого превращается в сердитое. «Я тебя знаю, ты тот пень, который ходит по округе и всех расспрашивает». Он пристально смотрит на тебя, ожидая твоих возражений.~
@47969 = ~~
@47970 = ~«Да, у меня и к тебе есть парочка вопросов...»~
@47971 = ~Встать в позу: «И что с того?»~
@47972 = ~«Неважно, прощай».~
@47973 = ~Он самодовольно кивает. «Ага, вот только у меня нет времени на твои вопросы. Советую тебе уйти, пока я не позвал стражу... и не надоедай моим людям, слышишь?»~
@47974 = ~«Тогда зови стражу — я с ними справлюсь».~
@47975 = ~«Тогда мне пора. Прощай».~
@47976 = ~Он кивает. «Как хочешь, полоумный пень. Стража! У меня тут проблемы!»~
@47977 = ~~
@47978 = ~Уйти до их прихода.~
@47979 = ~Он смотрит на тебя прищурено. «Ну, раз так, тогда тебе следует знать, что ты назойливая муха, а у меня времени нет на мух. И у моих людей тоже, так что оставь их в покое».~
@47980 = ~«Я всего лишь хотел задать пару вопросов...»~
@47981 = ~«Мне не нравишься ни ты, ни твой тон. Как насчет того, чтобы поучить тебя манерам?»~
@47982 = ~«Ну так наколись, пень! Бывай».~
@47983 = ~Он начинает что-то говорить, но останавливается, чтобы рассмотреть твои габариты и покрывающие тебя шрамы. Он поворачивается, чтобы взглянуть на ближайшего стражника, и раскрывает рот...~
@47984 = ~Правда: «Да я свернуть твою тощую шейку, не успеешь ты и пикнуть...»~
@47985 = ~Блеф: «Да я свернуть твою тощую шейку, не успеешь ты и пикнуть...»~
@47986 = ~Уйти, пока ситуация не вышла из-под контроля.~
@47987 = ~Он бросает на тебя осторожный взгляд, и ты чувствуешь, что подавил его. «У меня есть... дела, и мне некогда этим заниматься. Хорошего тебе дня». Он разворачивается и уходит.~
@47988 = ~Уйти.~
@47989 = ~Перед тобой жилистый старик, который, судя по всему, наблюдает за всеми рабочими рынка. Время от времени он выкрикивает им приказы, и те быстро исполняют их. Он хмурится, когда ты подходишь. «Ага... опять ты, назойливая муха. Мне нечего тебе сказать, пень. Сгинь!»~
@47990 = ~Уйти.~
@47991 = ~Перед тобой мужчина средних лет, усердно работающий с ящиками товаров. Он кивает тебе, когда ты подходишь.~
@47992 = ~«Приветствую».~
@47993 = ~Не обращать на него внимания.~
@47994 = ~Он улыбается и смахивает пот со лба. «Привет, рубака».~
@47995 = ~«У меня есть пара вопросов...» ~
@47996 = ~«Неважно, прощай».~
@47997 = ~Он кивает. «Хорошо...»~
@47998 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@47999 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@48000 = ~«Где бы мне купить оружие?»~
@48001 = ~«Где бы мне купить магические предметы?»~
@48002 = ~«Неважно. Прощай».~
@48003 = ~Он качает головой. «Никогда о нем не слышал. Я поспрашиваю в округе: может, кто знает».~
@48004 = ~«У меня еще вопросы...»~
@48005 = ~«Спасибо, прощай».~
@48006 = ~Он смотрит на тебя равнодушно. «Череп пропал... я, э... — он пожимает плечами. — Извини, я ничего об этом не знаю...» Похоже на то, что он хочет что-то у тебя спросить, но не решается.~
@48007 = ~«У меня еще вопросы...»~
@48008 = ~«Спасибо, прощай».~
@48009 = ~На мгновение он задумывается, как бы пытаясь понять, что ты только что у него спросил. «Ну... оружие? Даже не знаю... Полагаю, им торгует один из здешних торговцев. Однако это не то, в чем нуждается обычный горожанин».~
@48010 = ~«А как ты защитишь себя без оружия?»~
@48011 = ~«У меня еще вопросы...»~
@48012 = ~«Спасибо, прощай».~
@48013 = ~Он смотрит на тебя недоверчиво. «Гармониум... это они должны защищать нас, граждан. Они поддерживают порядок, наказывают виновных и так далее. Гражданин не должен беспокоится о самозащите». Он смотрит на тебя спокойным взглядом.~
@48014 = ~«У меня еще вопросы...»~
@48015 = ~«Спасибо, прощай».~
@48016 = ~«Магические? Я... — его лицо принимает растерянный вид. — Я не знаю. Может, у одного из торговцев, но ведь магия не то чтобы распространена... так ведь?» Он ждет твоего ответа.~
@48017 = ~«Ты просто не знаешь, не так ли?»~
@48018 = ~«У меня еще вопросы...»~
@48019 = ~«Спасибо, прощай».~
@48020 = ~Он смотрит на тебя потрясенно. «Ну, нет... то есть, да... э, ну... пожалуй, нет, — он пожимает плечами. — Меня называют наивным, но я вовсе так не считаю. Просто я не такой *бывалый*, как некоторые, вот и все».~
@48021 = ~«Какого же цвета небо в твоей вселенной?..»~
@48022 = ~«У меня еще вопросы...»~
@48023 = ~«Спасибо, прощай».~
@48024 = ~Он смотрит вверх и показывает. «Желтого.. это из-за дыма и всего прочего, идущего от фабрик».~
@48025 = ~«Неважно. У меня есть другие вопросы...»~
@48026 = ~«Спасибо, прощай».~
@48027 = ~Рабочий смотрит на тебя. «Здравствуй. Чем могу помочь?»~
@48028 = ~«У меня есть пара вопросов...» ~
@48029 = ~«Неважно, прощай».~
@48030 = ~Ты раскрываешь мерцающий металл. Он кажется странно спокойным. У тебя складывается впечатление, будто он дремлет, пока поблизости нет портального ключа.~
@48031 = ~Сложить его и спрятать.~
@48032 = ~Слабая тень~
@48033 = ~Глашатай хранилища Девятого мира~
@48034 = ~Служащий Проклятого~
@48035 = ~Кассий~
@48036 = ~Эбб Коленоскрип~
@48037 = ~Китла~
@48038 = ~Большая Тень~
@48039 = ~Даллан~
@48040 = ~Дона Куишо~
@48041 = ~Перед тобой пьяный стражник. Он облачен в доспехи защитника Проклятого, однако, похоже, что его выпивка — единственное, что он будет защищать. Он смотрит на тебя без особого интереса.~
@48042 = ~«Кто ты?»~
@48043 = ~«Что ты здесь делаешь?»~
@48044 = ~«Забудь. Прощай».~
@48045 = ~Чек-ка Плут внимательно и осторожно, насколько может это сделать пьяный человек, осматривает тебя. Презрительно усмехнувшись, он возвращается к своей кружке.~
@48046 = ~«Кто ты?»~
@48047 = ~«Что ты здесь делаешь?»~
@48048 = ~«Тогда прощай». ~
@48049 = ~«Чек-ка Плут. Элита Проклятого». Он отрыгивает.~
@48050 = ~«Что ты здесь делаешь?»~
@48051 = ~«Прощай».~
@48052 = ~«Как хорошо, что ты к нам присоединился!»~
@48053 = ~«Могу ли я предложить свою помощь?»~
@48054 = ~«Хорошего отдыха!»~
@48055 = ~«Здравствуй! Я здесь для того, чтобы ПОГЛОТИТЬ ТВОЮ ВКУСНУЮ ХИЛУЮ ПЛОТЬ, ЖАЛКИЙ ЧЕЛОВЕЧИШКА!»~
@48056 = ~«О, прошу прощения, боюсь, что я должна СЛОМАТЬ ТВОИ ХРУПКИЕ КОСТОЧКИ И СБРОСИТЬ ТВОИ ДРОЖАЩИЕ МЯСНЫЕ ОШМЕТКИ В САМУЮ ГЛУБОКУЮ ПРОПАСТЬ В КАРЦЕРИ!»~
@48057 = ~«Ой! Похоже, что ТЫ ВРЯД ЛИ УТОЛИШЬ МОЮ БЕСКОНЕЧНУЮ ЖАЖДУ СМЕРТНОЙ ПЛОТИ, МЕЛКИЙ ГРЫЗУН! ПРОЧЬ, ЧЕРВЯК!»~
@48058 = ~«ТЫ НИЧТОЖЕСТВО! СКЛОНИСЬ ПЕРЕД МОЕЙ НЕЧЕСТИВОЙ СИЛОЙ, И, БЫТЬ МОЖЕТ, Я СДЕЛАЮ ТЕБЯ ЛЕМУРОМ ВСЕГО НА ДЕСЯТЬ ТЫСЯЧ ЛЕТ!»~
@48059 = ~«М-м-п-ф! М-М-М-П-Ф! Р-Р-Р! М-м-п-ф!»~
@48060 = ~«Добро пожаловать в наш Бордель!»~
@48061 = ~«Приветствую!»~
@48062 = ~«Привет!»~
@48063 = ~«Привет!»~
@48064 = ~«Хорошего тебе дня!»~
@48065 = ~«Могу ли я чем-нибудь помочь?»~
@48066 = ~«Привет».~
@48067 = ~«У тебя есть для меня история?»~
@48068 = ~«Здорово!»~
@48069 = ~«Хе!»~
@48070 = ~::Надувает губы::~
@48071 = ~::Дуется::~
@48072 = ~::Хандрит::~
@48073 = ~«М-м... привет».~
@48074 = ~«Мне нравится то, что я вижу».~
@48075 = ~«Ты хотел бы что-нибудь мне рассказать?»~
@48076 = ~«Ты один?»~
@48077 = ~«Ого, что это у нас тут?»~
@48078 = ~«Не желаешь сыграть в игру?»~
@48079 = ~«Не желаешь немного подискутировать?»~
@48080 = ~«Снова привет».~
@48081 = ~«ЗАТКНИСЬ!»~
@48082 = ~«Пошел вон, пока я тебя не вышвырнула!»~
@48083 = ~«НИКОГДА не видела ничего НАСТОЛЬКО отвратительного!»~
@48084 = ~Он указывает на Гниющего Копчика. «Слежу за ним. Говорят, у него здесь туннель есть, вот я и хочу выяснить, правда ли это. Жду. Слежу. А теперь проваливай. Мне нужно следить».~
@48085 = ~«Кто ты?»~
@48086 = ~«Тогда прощай». ~
@48087 = ~Пьяный стражник с ревом бросается на тебя. Очевидно, он хочет видеть тебя мертвым.~
@48088 = ~Сражаться.~
@48089 = ~~
@48090 = ~Окровавленный платок~
@48091 = ~P2 SFull~
@48092 = ~P1 SFull~
@48093 = ~P2 SFull CFull~
@48094 = ~P3 SFull CFull~
@48095 = ~Атака Тени 3~
@48096 = ~Перед тобой мрачный худощавый мужчина. Его лицо выветрено и покрыто морщинами, с покрасневшими глазами. Завидев тебя, он выпрямляется. «Добро пожаловать в Ворота предателей. Я — Гниющий Копчик, хозяин таверны».~
@48097 = ~«Что-то не так?»~
@48098 = ~«Что это за имя такое?»~
@48099 = ~«Почему бы тебе не прогуляться чуток по Баатору, бездельник!»~
@48100 = ~«Разве я ПРОСИЛА тебя приходить сюда, ты, бестолковый пень?! Проваливай!»~
@48101 = ~«Чем торгуешь?»~
@48102 = ~«ОПЯТЬ?! АХ ТЫ БЕСТОЛКОВЫЙ МЕШОК НАВОЗА!»~
@48103 = ~«Да, госпожа...»~
@48104 = ~«ПОЛУЧАЙ!»~
@48105 = ~«И ЕЩЕ!»~
@48106 = ~«УФ!»~
@48107 = ~«Мне нужно место для отдыха».~
@48108 = ~«Рад за тебя. Прощай».~
@48109 = ~«Наверно, то, что мою дочь выкрали работорговцы, и теперь это место закроют за долги, и мне придется его уступить одному из уродов-богачей из первого круга». Он присматривается к тебе тщательнее. «Ты ведь тот парень, который вынюхивает насчет дэва, так? Вот что. Ты поможешь мне — я помогу тебе».~
@48110 = ~«Что ты знаешь о дэва?»~
@48111 = ~«Что мне нужно сделать?»~
@48112 = ~«Поговорим об этом позднее. Сейчас у меня есть другие вопросы...»~
@48113 = ~«Дай подумать над этим. Я к тебе еще вернусь. Прощай».~
@48114 = ~Он смотрит на тебя. «Копчиком меня назвали при рождении, пень. А Гниющего я получил из-за того, что кое-кто из моих бывших друзей распускал про меня всякие вздорные слухи». Похоже, он *очень* зол. «Что тебе нужно, черт тебя побери? Ты приключенец или типа того?»~
@48115 = ~«А что? Что-то не так?»~
@48116 = ~«А что? Что-то не так?»~
@48117 = ~«Я хотел бы задать пару вопросов...»~
@48118 = ~«Чем торгуешь?»~
@48119 = ~«Мне нужно место для отдыха».~
@48120 = ~«Рад за тебя. Прощай».~
@48121 = ~«ОЙ!»~
@48122 = ~«И БОЛЬШЕ НЕ ВОЗВРАЩАЙСЯ, ЖАЛКОЕ ПОДОБИЕ МУЖЧИНЫ!»~
@48123 = ~«Спасибо... госпожа».~
@48124 = ~«Субъект обнаружен».~
@48125 = ~Он хитро улыбается. «Ты ведь ищешь его, верно? Могу тебе сообщить, что он спрятан глубоко под тюрьмой. Еще могу рассказать, как туда попасть, исключая варианты быть арестованным или подкупить кого-нибудь — они все равно не сработают».~
@48126 = ~«Поведение субъекта статично».~
@48127 = ~«Что мне нужно для этого сделать?»~
@48128 = ~«Чего ты хочешь узнать?»~
@48129 = ~«Почему город выглядит таким покинутым?»~
@48130 = ~«Почему город выглядит таким покинутым?»~
@48131 = ~«Что ты можешь рассказать об этом месте?»~
@48132 = ~«Ты что-то говорил насчет того, что тебе нужна помощь. Что ты хочешь, чтобы я сделал?»~
@48133 = ~«Что ты знаешь о дэва?»~
@48134 = ~«Чем торгуешь?»~
@48135 = ~«Пожалуй, ничего. Прощай».~
@48136 = ~«Иди, поговори с Маркесом. Он бывший член Гармониума. Он знает тех работорговцев, и у него есть первая часть ключа, который откроет тебе дорогу к дэва. Всего частей пять, но этот ключ — ненастоящая вещь. Когда соберешь их всех, скажи мне — и ты получишь мои знания. А пока это останется тайной. Тебе придется выполнить просьбы всех держателей ключа».~
@48137 = ~«Дай подумать над этим. У меня есть другие вопросы».~
@48138 = ~«Я не буду этого делать».~
@48139 = ~«Я сделаю это».~
@48140 = ~«Послушай... Черт побери! Ненавижу просить у незнакомцев, но мне кажется, что я смогу помочь тебе, если ты поможешь мне». Он спешно продолжает: «Мою дочь похитили, ее собираются продать, а без ее помощи я потеряю это место. У меня есть информация, которая может тебе весьма пригодиться. Ты почешешь мне спинку, я почешу тебе, понимаешь?»~
@48141 = ~«Что тебе нужно?»~
@48142 = ~«Забудь. Сейчас я очень занят».~
@48143 = ~«Ха. Как всегда, проблем в изобилии. Во-первых, для расширения тюрьмы роют норы, и вот в одной из них находят этого дэва, заключенного в огромный обсидиановый пузырь и прикованного к полу. Они забрали его меч для того, чтобы держать преступников в своих клетках. И теперь обсуждают, что делать с этим небожителем, все волосы на себе изорвали, пытаясь понять, какую можно пользу получить из этой находки и навариться на 'дружках'... а тут еще чума вспыхнула».~
@48144 = ~«Чума?»~
@48145 = ~«Что ты знаешь о дэва?»~
@48146 = ~«Почему дэва заточили?»~
@48147 = ~«У меня есть другие вопросы...»~
@48148 = ~«Спасибо. Прощай».~
@48149 = ~«Манеры субъекта сдержаны».~
@48150 = ~«Субъект общается с человеком мужского пола».~
@48151 = ~«Субъект играет в игру с человеком мужского пола».~
@48152 = ~2 на 3~
@48153 = ~Ты испытал свое бессмертие на стихии и был уничтожен.~
@48154 = ~Ты потерял источник информации, жизненно важный для твоих поисков.~
@48155 = ~Ты был выведен из строя и больше не можешь закончить игру.~
@48156 = ~Уровень~
@48157 = ~~
@48158 = ~~
@48159 = ~«Спасибо. Прощай».~
@48160 = ~Гниющий Копчик сказал мне, что Проклятый был поражен чумой незадолго после того, как официальные лица открыли тюрьму с дэва.~
@48161 = ~«Рассадник слухов и кривотолков, вот что это за место. Никто никому не верит. Никто не сделает другому одолжения, если только не будет уверен, что тот останется у него в долгу. Все ненавидят друг друга и пытаются облапошить других. Например, такого как ты... Ты — готовая жертва, потому что не знаешь правил. Зуб даю, что тебя кинут».~
@48162 = ~«У меня есть еще несколько вопросов...»~
@48163 = ~«Спасибо. Прощай».~
@48164 = ~«Спасибо. Прощай».~
@48165 = ~«Не будешь мне помогать — от меня тоже ничего не дождешься. Вон из моего заведения».~
@48166 = ~«Нет. Чем ты здесь торгуешь??»~
@48167 = ~«Нет. Мне нужно место для отдыха».~
@48168 = ~«Я передумал. Я помогу тебе».~
@48169 = ~«Тогда я ухожу. Прощай».~
@48170 = ~«Маркес скажет тебе, что нужно делать, а когда закончишь с этим делом, он укажет тебе на другого владельца ключа».~
@48171 = ~«Прощай».~
@48172 = ~«Только если ты меня убьешь — но тогда все дороги в этом городе для тебя закрыты. Ты сгниешь тут заживо, пень. Я не шучу. Ты не сможешь отсюда выбраться».~
@48173 = ~Все равно убить его.~
@48174 = ~Уйти.~
@48175 = ~«Все верно. Что-то косит народ наповал. Делает людей озлобленными и раздражительными, но слишком слабыми, чтобы что-нибудь с этим сделать. Стража перекрыла части города и теперь сидит как на иголках. Они могут упрятать тебя в тюрьму по любому предлогу. Не знаю, как ты сумел попасть в город, но выбраться из него ты сможешь только через портал».~
@48176 = ~«У меня есть еще несколько вопросов...»~
@48177 = ~«Спасибо. Прощай».~
@48178 = ~«Спасибо. Прощай».~
@48179 = ~Он пристально смотрит на тебя, пытаясь выяснить, не шутишь ли ты с ним. «Я ведь сказал, что они нашли его зарытым в землю, ведь так? Это значит, что я понятия не имею, как он там внизу оказался. Жаль, что у меня нет власти сажать дэва в клетки. Это было бы как нельзя кстати».~
@48180 = ~«Ладно, тогда ответь еще на пару вопросов».~
@48181 = ~«Спасибо. Прощай».~
@48182 = ~«Спасибо. Прощай».~
@48183 = ~С едва скрываемым беспокойством в глазах он задает вопрос: «Накопал что-нибудь насчет моей дочери? Я очень за нее беспокоюсь. Пожалуйста, сообщи Маркесу, если что услышишь».~
@48184 = ~«Я не собираюсь ее искать».~
@48185 = ~«Пока нет. У меня есть несколько вопросов».~
@48186 = ~«Пока нет. Чем ты здесь торгуешь?»~
@48187 = ~«Пока нет. Мне нужно место для отдыха».~
@48188 = ~«Да. Она скоро придет сюда. Пойду, переговорю с Маркесом. Прощай».~
@48189 = ~В его глазах видна горечь утраты. «Чего тебе надо, рубака?»~
@48190 = ~«А что вообще такого в этом ключе?»~
@48191 = ~«Чем торгуешь?»~
@48192 = ~«Мне нужно место для отдыха».~
@48193 = ~«Ничего. Прощай».~
@48194 = ~«Это ключ, но он неосязаем, если ты понимаешь, о чем я. Когда ты соберешь все его части, скажи мне, он откроет в моем разуме нужные знания. А до тех пор они останутся в тайне. Тебе нужно выполнить просьбы владельцев ключей. Это все, что ты хотел?»~
@48195 = ~«Чем торгуешь?»~
@48196 = ~«Мне нужно место для отдыха».~
@48197 = ~«Да. Прощай».~
@48198 = ~«Как продвигаются дела с ключом? Похоже, ты очень хочешь заполучить его. Уверен, ты его получишь».~
@48199 = ~«А что вообще такого в этом ключе?»~
@48200 = ~«Чем торгуешь?»~
@48201 = ~«Мне нужно место для отдыха».~
@48202 = ~«Ничего. Прощай».~
@48203 = ~«Нужно сделать еще одно дельце. Видишь вон ту пьяную сволочь Чек-ка Плута? Убей его». Он повышает голос: «Эй, Чек-ка! Твоя смерть пришла!»~
@48204 = ~«Теперь, когда ты убил того пьяницу, ворота можно отпереть. Ты готов? Как только ты войдешь, назад пути не будет: дверь будет закрыта, забаррикадирована и магически защищена».~
@48205 = ~«Я готов».~
@48206 = ~«Сперва я бы хотел отдохнуть в трактире».~
@48207 = ~«Сначала я бы хотел взглянуть на твои товары».~
@48208 = ~«Еще нет».~
@48209 = ~«Тогда возвращайся, когда будешь готов».~
@48210 = ~«Я так и сделаю. Прощай».~
@48211 = ~«Ты готов? Как только ты войдешь, назад пути не будет: дверь будет закрыта, забаррикадирована и магически защищена».~
@48212 = ~«Я готов».~
@48213 = ~«Сперва я бы хотел отдохнуть в трактире».~
@48214 = ~«Сначала я бы хотел взглянуть на твои товары».~
@48215 = ~«Еще нет».~
@48216 = ~Store Item Script
First one
Don't translate type 25~
@48217 = ~Another item script
Is this what Yuki wants?
I hope so.~
@48218 = ~InParty("MORTE")
Class(SelectedCharacter, Fighter)~
@48219 = ~«Знатоки! Убейте его!»~
@48220 = ~::Мрачно бормочет::~
@48221 = ~Этот с виду скучающий крысооборотень, похоже, рад любому поводу развеять скуку. «Чего те, мясо?»~
@48222 = ~«Мне нужно выбраться».~
@48223 = ~«Мне просто нужно с тобой поговорить».~
@48224 = ~«Ничего. Забудь».~
@48225 = ~«Да ну? И что же может стоить того, чтобы ослушаться Мантуока и рискнуть разозлить крыс, а?»~
@48226 = ~«Ваши жизни. Если ты меня выпустишь, я оставлю вас в живых».~
@48227 = ~«Ваши жизни. Если ты меня выпустишь, я оставлю вас в живых».~
@48228 = ~«Обещание того, что никто никогда не узнает о том, что я сделаю... и, пожалуй, обещание нескольких монет позже».~
@48229 = ~«И как они узнают?»~
@48230 = ~«Как насчет звенелок?»~
@48231 = ~«Подумай вот о чем: я, несомненно, представляю для вас опасность, и все же говорю с вами на равных. Ты же не думаешь, что эти стены меня удержат, если я захочу выйти? Говорю безо всяких угроз: в твоих же интересах выпустить меня».~
@48232 = ~«Потому что я когда-нибудь отсюда выберусь, и тогда здесь будет заварушка».~
@48233 = ~«Сам подумай, я вот не могу ничего сообразить».~
@48234 = ~Раймон внимательно осматривает тебя сверху донизу. Заметив жестокость в твоих глазах и размеры твоих мускулов, он очень осторожно отпирает и открывает дверь. Затем он отступает в сторону и отводит от тебя взгляд.~
@48235 = ~«Спасибо, приятель».~
@48236 = ~«Пока».~
@48237 = ~Он отводит от тебя взгляд. «Прошу, не трогай меня, знаток... Я только делал свою работу».~
@48238 = ~«Я подумаю над этим. Прощай».~
@48239 = ~Он внимательно осматривает тебя и фыркает. «Ты че, думаешь, можешь мне навредить? Поищи-ка сперва другой выход!»~
@48240 = ~«Что, если я пообещаю, что никто никогда не узнает о том, что я сделаю... и, пожалуй, еще несколько монет позже».~
@48241 = ~«Почему бы тебе просто не выпустить меня?»~
@48242 = ~«Что, если я дам тебе пару монет?»~
@48243 = ~«Подумай вот о чем: я, несомненно, представляю для вас опасность, и все же говорю с вами на равных. Ты же не думаешь, что эти стены меня удержат, если я захочу выйти? Говорю безо всяких угроз: в твоих же интересах выпустить меня».~
@48244 = ~«Потому что я когда-нибудь отсюда выберусь, и тогда здесь будет заварушка».~
@48245 = ~«Что ж, я подумаю над этим. Прощай».~
@48246 = ~«В общем, звучит неплохо. В любом случае клал я на Мантуока, — он отпирает дверь, открывает ее и отходит в сторону. — А теперь проваливай отсюда, пока я еще могу делать вид, что не вижу тебя».~
@48247 = ~«Да пожалуйста. Прощай».~
@48248 = ~«Вот чего еще... чего-то у тебя кошелек приятно так позвякивает. Сотня монет — уверен, ею ты можешь поделиться — и можешь идти».~
@48249 = ~«По рукам».~
@48250 = ~«Забудь».~
@48251 = ~«Брось через решетку, и тогда я тебя выпущу. И пока ты не спросил: тебе остается только поверить мне, верно, Шаддеус?» — он ухмыляется своему напарнику.~
@48252 = ~«Хорошо. Держи».~
@48253 = ~«У меня нет столько...»~
@48254 = ~«Забудь».~
@48255 = ~Он тщательно пересчитывает монеты. Когда он, наконец, убеждается, что они все на месте, он отпирает тебе дверь. «А теперь проваливай!»~
@48256 = ~«Хорошо, хорошо». ~
@48257 = ~«Тогда ты отсюда не выберешься, так ведь?» Его смех напоминает чириканье. Он отворачивается.~
@48258 = ~«Проклятье...»~
@48259 = ~«Ты просто хочешь поговорить, так? Вот только не получится у тебя разговора с Раймоном, эт уж точно!» — он отворачивается от тебя.~
@48260 = ~«Я хочу поговорить на счет того, чтобы выпустить меня отсюда».~
@48261 = ~«Вот и отлично».~
@48262 = ~Он презрительно тебе усмехается. «Будто бы я тебе поверил? — его усы дергаются. — Попробуй еще разок».~
@48263 = ~«Если ты выпустишь меня отсюда, я оставлю тебе жизнь».~
@48264 = ~«Если ты выпустишь меня отсюда, я оставлю тебе жизнь».~
@48265 = ~«Как насчет звенелок?»~
@48266 = ~«Подумай вот о чем: я, несомненно, представляю для вас опасность, и все же говорю с вами на равных. Ты же не думаешь, что эти стены меня удержат, если я захочу выйти? Говорю безо всяких угроз: в твоих же интересах выпустить меня».~
@48267 = ~«Потому что я когда-нибудь отсюда выберусь, и тогда здесь будет заварушка».~
@48268 = ~«Забудь».~
@48269 = ~«Чего тебе еще, пустоголовый?»~
@48270 = ~«Я хочу поговорить с тобой».~
@48271 = ~«Я хочу обсудить варианты своего выхода отсюда».~
@48272 = ~«Ничего. Забудь».~
@48273 = ~Когда ты приближаешься к прутьям, блестит серебро, и один из охранников-оборотней кидается на другого со ошеломляющей жестокостью!~
@48274 = ~(продолжить)~
@48275 = ~«Вот так, — он берет с тела Раймона ключи, отпирает дверь и открывает ее тебе. — А теперь пошевеливайся». Он отвешивает быстрый поклон и убегает.~
@48276 = ~«Конечно. Спасибо».~
@48277 = ~«Тебя удивляет, почему я это сделал, ведь так? Когда-то я жил в Погребенной деревне. Меня звали Шаддеус. Я не хочу быть крысооборотнем, и не считаю, что эта зараза делает меня менее человечным. Уходи. Сейчас же». Он отпирает дверь, открывает ее тебе и убегает прочь.~
@48278 = ~«Спасибо, Шаддеус. Прощай».~
@48279 = ~Прикончив своего приятеля-оборотня, этот парень смотрит прямо на Анну: «Анна, это Шаддеус. Я выпускаю тебя. Я не могу видеть тебя вот так, в клетке. Замолви за меня словечко, если вернешься в деревню, и скажи им, что тут происходит нечто зловещее. Пока не могу сказать, что, но... ты же сама это знаешь».~
@48280 = ~Когда ты приближаешься к прутьям, блестит серебро, и один из охранников-оборотней кидается на другого со ошеломляющей жестокостью!~
@48281 = ~(продолжить)~
@48282 = ~::Весело посвистывает::~
@48283 = ~::Прикрывает рот::~
@48284 = ~Global("Appearance", "GLOBAL", 1)~
@48285 = ~Ручной Лим-Лим~
@48286 = ~Запечатанный свиток~
@48287 = ~Кодекс необъяснимого~
@48288 = ~Кувшин с монстром~
@48289 = ~Анна~
@48290 = ~ДУБИНКА
Урон: 4-16 Дробящий
Скорость: 3
Вес: 4
Специализация: Дубинки
Используется только Ворами

Грубая дубинка, сделанная из позвоночника и головы огромной птицы.

~
@48291 = ~СЛЕЗЫ ДЭВА
Вес: 1

На ярлычке этого маленького стеклянного пузырька написано «Слезы дэва». Они были собраны у дэва, захваченного в плен во время стычки на Кровавой войне. Нечистые пытали плененного ангела целую вечность, пока он, наконец, не сбежал. В этом маленьком пузырьке содержатся двенадцать слез, которые он проронил за то время. Говорят, слезы дэва способны смягчить самый дикий гнев... даже такой, как у языка нечистого.~
@48292 = ~Золотое кольцо~
@48293 = ~КИНЖАЛ
Урон: 1-6 колющий
Скорость: 2
Вес: 1
Специализация: клинковые
Не используется жрецами

У этого кинжала были деньки и получше. Постоянные небрежное и неправильное обращение превратили клинок в печальное зрелище.~
@48294 = ~КРУЖКА ЛЕДЯНОГО ЭЛЯ
Вес: 2

Это большая оловянная кружка необычной конструкции, на ее поверхности выгравированы необычные руны. Она сохраняет свое содержимое ледяным вне зависимости от окружающей температуры.~
@48295 = ~P1 SFull CFull~
@48296 = ~КОЖАНАЯ КУРТКА
Класс Брони: 4
Вес: 12
Используется только Анной

Этот образец прочной кожаной брони, безусловно, был создан для женщины. Куртка изготовлена с необычайным мастерством: в разных местах на ее поверхности тщательно скрыты небольшие металлические пластины и полосы, которые обеспечивают ощутимую защиту, не стесняя при этом движений. Похоже, броня больше всего подходит «подвижному» бойцу, который наиболее полно использует свободу движения, предоставляемую ей.~
@48297 = ~КРУЖКА ЛЕДЯНОГО ЭЛЯ С ТЕМНОЙ ПТИЦЕЙ ВНУТРИ
Вес: 3

Это большая оловянная кружка необычной конструкции, на ее поверхности выгравированы необычные руны. Она сохраняет свое содержимое ледяным вне зависимости от окружающей температуры. Сейчас в ней Темная птица Окантуса — осколок черного льда с выставки в галерее Иваны в Чиновничьем районе.~
@48298 = ~Ключ из фаланги пальца~
@48299 = ~МЯСНИЦКИЙ НОЖ
Урон: 3-10 рубящий
Скорость 6
Вес: 4
Специализация: топоры
Используется только бойцами

Этот массивный мясницкий нож, похоже, использовался не только на бойне. Его широкое плоское лезвие имеет больше зарубок, чем большинство увиденных тобой боевых топоров, а в его деревянную рукоятку навсегда въелись следы крови.
~
@48300 = ~ЭЛИКСИР УЖАСНОГО РАЗДЕЛЕНИЯ
Вес: 1

Этот пузырек с Эликсиром ужасного разделения был составлен ученой, которая обнаружила, что одержима своей темной половиной, которая время от времени брала над ней контроль и приказывала ей делать ужасные вещи. Это снадобье должно было «отделить» от нее темную половину, создав два отдельных существа. Однако прежде чем она успела воспользоваться им, ее нашли и казнили убийцы милосердия, наказав за серию извращенных убийств.

Эликсир действует лишь на тех, в чьем теле сосуществуют более одной сущности (например, на одержимых нечистым духом).~
@48301 = ~Странный предмет~
@48302 = ~КРИВОЙ НОЖ
Урон: 1-3 рубящий
Скорость: 1
Вес: 1
Используется только магами

Это нож необыкновенного качества и мастерства изготовления. Он хорошо сбалансирован и его загнутый клинок способен рассечь плоть без особых усилий.
~
@48303 = ~ЯЗЫК НЕЧИСТОГО
Вес: 2

Это серебристый язык нечистого, плавающий в банке с соленым раствором. Говорят, что если поместить его в рот какого-либо живого существа, то оно получит дар речи, даже если до этого оно не умело говорить.~
@48304 = ~Тренировочная булава~
@48305 = ~~
@48306 = ~КИНЖАЛ
Урон: 1-4 колющий
Скорость: 1
Вес: 1
Специализация: клинковые
Используется только магами

У этого кинжала странная загнутая рукоятка, придающая оружию ужасный баланс и усложняющая его использование. На обеих сторонах клинка кинжала тщательно выгравированы мелкие руны.
~
@48307 = ~МАЗЬ ГОРГОНЫ
Вес: 1

Маленькая бутылочка с надписью «Мазь Горгоны». Если намазать ею любое существо, обращенное в камень, мазь возвращает его плоть в нормальное состояние.~
@48308 = ~Дубина с шипами~
@48309 = ~КИНЖАЛ
Урон: 2-5 колющий
Скорость: 1
Вес: 1
Специализация: клинковые
Используется только ворами

Этот изящный кинжал короток и легок, что делает его идеальным оружием для скрытия в рукаве или сапоге.
~
@48310 = ~НОСОВОЙ ПЛАТОК
Вес: 0

Это ничем не примечательный шелковый носовой платок.~
@48311 = ~Колючая дубина~
@48312 = ~Ключи Долоры~
@48313 = ~КИНЖАЛ
Урон: 3-7 колющий
Скорость: 1
Вес: 1
Специализация: клинковые
Используется только ворами

Это хорошо сбалансированный кинжал с гладкой черной рукоятью и зазубренными кромками. Кинжал во многом похож на другие виденные тобой клинки, за исключением любопытного багрянистого оттенка поверхности клинка.
~
@48314 = ~КЛЮЧИ К СЕРДЦУ ДОЛОРЫ
Вес: 0

Это пара ключей на цепочке с брелком в форме сердца. Поверхность сердца исписана сотнями крошечных цифр, и на нем есть надпись 'ДОЛОРА'.~
@48315 = ~Бутылек~
@48316 = ~Прах лингвиста~
@48317 = ~БЛЕСТЯЩИЙ БОЕВОЙ ТОПОР
Урон: 2-9 рубящий
Скорость: 6
Вес: 4
Специализация: топоры
Используется только бойцами

Лезвие этого топора отменно отполировано — поверхность его отражает свет как зеркало. Топор невероятно легок, будто его собирались использовать скорее как украшение, чем как настоящее оружие.
~
@48318 = ~ПРАХ ЛИНГВИСТА
Вес: 3

Это урна, заполненная прахом и обугленными кусочками костей. У ее основания высечены слова «Фин Эндли, любимый муж, отец и знаток сотни языков».~
@48319 = ~Улыбающийся пузырек~
@48320 = ~Любовное письмо~
@48321 = ~ОБУГЛЕННАЯ РУКА
Вес: 1

Это твоя обугленная рука; она была обрублена по кисть, а плоть, некогда окружавшая кости, была начисто сожжена, оставив одни лишь голые кости. Несмотря на отсутствие кожи и мышц, рука хорошо держится, и кости ее не распадаются. Боль от отсеченной руки была близка к тому пределу, который ты был способен вытерпеть; на руке и кисти остались почерневшие болезненные шрамы. В довершение ты отметил, что рана на твоей плоти заживала медленно и плохо... если бы Игнус атаковал тебя со всей яростью, он мог бы собрать достаточно жара и пламени, чтобы выздоровление оказалось проблематичным... возможно, он смог бы даже уничтожить тебя? Эта мысль вовсе не радует тебя.

Игнус упомянул, что эти обугленные остатки твоей руки каким-то образом удерживают в себе частицу его инфернальной мощи... которая теперь перешла к тебе. Но у тебя нет никаких идей, как ею воспользоваться. 
~
@48322 = ~ЛЮБОВНОЕ ПИСЬМО
Вес: 0

Это страстное, пылкое и довольно выразительное любовное письмо. Тем не менее, кому оно предназначено и от кого пришло — все равно не ясно.~
@48323 = ~Кандалы~
@48324 = ~Кувшин с монстром~
@48325 = ~ОБУГЛЕННЫЕ ВНУТРЕННОСТИ
Вес: 2

Это обугленные внутренности; Игнус упомянул, что эти обугленные остатки каким-то образом удерживают в себе частицу его инфернальной мощи..., которая теперь перешла к тебе. Но у тебя нет никаких идей, как ими воспользоваться. Даже если бы ты *захотел* ими воспользоваться.
~
@48326 = ~КУВШИН С МОНСТРОМ
Вес: 4

Это обыкновенный тяжелый металлический кувшин с пробкой на шарнире. Несмотря на вполне обычный внешний вид, тебе совершенно не хочется прикасаться к этой вещи, как будто она может тебя укусить. Тебе сказали, что внутри кувшина заточен какой-то монстр, однако в горлышке кувшина видна только чернильная темнота.~
@48327 = ~Ручной лим-лим~
@48328 = ~Ручной лим-лим~
@48329 = ~ОБОЖЖЕННЫЙ ГЛАЗ
Вес: 0

Это обожженные остатки твоего глаза, опаленного прикосновением Игнуса. Он упомянул, что эти останки каким-то образом удерживают в себе частицу его инфернальной мощи... которая теперь перешла к тебе. Но у тебя нет никаких идей, как им воспользоваться.~
@48330 = ~РУЧНОЙ ЛИМ-ЛИМ
Вес: 5

Это твой ручной лим-лим.~
@48331 = ~Пузырек с духами~
@48332 = ~Кольцо почти-невидимости~
@48333 = ~ОБУГЛЕННАЯ КОСТЬ ПАЛЬЦА
Вес: 0

Это твой обугленный указательный палец правой руки; кончик пальца обломился, а плоть, некогда окружавшая кости, превратилась в пепел. Игнус всего-навсего *прикоснулся* к нему, но этого оказалось достаточно, чтобы оставить на твоей руке почерневшие болезненные шрамы. В довершение ты отметил, что рана на твоей плоти заживала медленно и плохо... если бы Игнус атаковал тебя со всей яростью, он мог бы собрать достаточно жара и пламени, чтобы выздоровление оказалось проблематичным... возможно, он смог бы даже уничтожить тебя? Эта мысль тебя нисколько не радует.

Игнус упомянул, что эти обугленные остатки твоего пальца каким-то образом удерживают в себе частицу его инфернальной мощи... которая теперь перешла к тебе. Но у тебя нет никаких идей, как им воспользоваться. 
~
@48334 = ~КОЛЬЦО ПОЧТИ-НЕВИДИМОСТИ ЙЕВРЫ
Особенность: +1 к Классу Брони
Вес: 0

Это кольцо почти-невидимости Йевры. Оно делает владельца невидимым — почти. Иногда, на короткое время носящий его становится очень, ну *очень* близким к тому, чтобы стать невидимым — событие, которое нередко приводит нападающего в замешательство, — и таким образом по нему становится сложнее попасть.~
@48335 = ~Серебряная рамка~
@48336 = ~Надушенная вуаль~
@48337 = ~ЧЕКАН
Вес: 5

Это оружие состоит из длинной металлической рукоятки и острого загнутого наконечника на одном из ее концов. Оно великолепного качества и отлично сбалансировано.~
@48338 = ~НАДУШЕННАЯ ВУАЛЬ
Вес: 0

Это превосходная благоухающая малиновая вуаль. Какой бы материал не был использован для ее изготовления, он столь легкий и прозрачный, что вуаль кажется скорее пучком чистого и яркого света, чем изделием из крашенной ткани. Однако более примечательным является не внешний вид вуали, а ее запах — несомненно, один из самых экзотических и волнующих ароматов, которые ты имел удовольствие вдыхать.~
@48339 = ~Каменный лим-лим~
@48340 = ~Каменный лим-лим~
@48341 = ~КАЧЕСТВЕННОЕ ЗЕРКАЛО
Вес: 2

Это зеркало весьма богато украшено и вставлено в позолоченную платиновую рамку. Отражающая поверхность стекла, похоже, была кристаллизована естественным путем, в отличии от обычного стекла.~
@48342 = ~КАМЕННЫЙ ЛИМ-ЛИМ
Вес: 10

Это твой ручной лим-лим, обращенный в камень окаменяющим взглядом Мариссы. Он весит по крайней мере вдвое больше прежнего. Его маленькая улыбающаяся пасть навсегда застыла с таким выражением, что ты почти что слышишь его веселое щебетание: «Пийо!»~
@48343 = ~Трубка~
@48344 = ~Меч Винн~
@48345 = ~КУВАЛДА
Урон: 2-9 дробящий
Скорость: 7
Вес: 5
Специализация: молоты
Используется только бойцами

Изначально предназначенный для тяжелых работ, этот огромный молот может стать грозным оружием. Боек сделан из чугуна, а рукоять длинной почти с человеческую руку. Даже не будучи заколдованной, кувалда — наиболее разрушительная среди всех молотов.~
@48346 = ~МЕЧ ВИНН
(уникальный, артефакт)
Урон: 2-7 рубящий
THAC0: +1
Скорость: 1
Вес: 1
Специализация: клинковые
Не используется жрецами

Меч Винн (также известный под названием «Клинок мошенника») больше похож на декоративный кинжал, чем на годное для боя оружие. Хотя его балансировка оставляет желать лучшего, на него наложена могущественная магия, и потому в бою он эффективнее, чем более «обычный» нож. Однако величайшая сила меча Винн заключается в способности позволять своему владельцу жульничать: попросту держа «меч» поднятым в соответствующей театральной позе, его владелец победит в любой игре, в которой будет найден этот артефакт.~
@48347 = ~Дубинка~
@48348 = ~Книга читов~
@48349 = ~ЧЕРЕП-КУЛОН
Вес: 1

Этот необычный кулон в форме черепа сделан из какого-то серебристого металла. Череп окружают шесть кристаллов, образуя нечто вроде короны. Через глазок над черепом продет кожаный шнурок.~
@48350 = ~КНИГА ЧИТОВ
Вес: 4

Это печально известная Книга читов, массивный манускрипт мелких грязных уверток, являющийся, по всей видимости, плодом сотрудничества десятков подлых продвинутых игроков.

Как только будет решено точно, сколько функций из числа возможных можно будет реализовать в ней за тот короткий отрезок времени, который мы можем ей уделить, ты сможешь жульничать, жульничать, *жульничать* как сумасшедший. Хо-хо!~
@48351 = ~Таинственный запечатанный свиток~
@48352 = ~Подозрительный запечатанный свиток~
@48353 = ~ТАИНСТВЕННЫЙ ЗАПЕЧАТАННЫЙ СВИТОК
Вес: 1

Этот свиток туго связан красной лентой и запечатан воском.~
@48354 = ~ПОДОЗРИТЕЛЬНЫЙ ЗАПЕЧАТАННЫЙ СВИТОК
Вес: 1

Этот свиток туго связан красной лентой и запечатан воском. Ты не можешь понять, почему, но у тебя плохое предчувствие насчет этой вещи — как будто вскрытие и чтение свитка может каким-то образом быть опасным.~
@48355 = ~Уйти.~
@48356 = ~Этот проход углубляется в небольшое здание лишь на пару дюймов, после чего преграждается плотной стеной отбросов. Мусор набит туда так туго, что он все равно что кирпичная кладка. Однако, когда ты подходишь ближе, контур арки начинает мерцать. Ты замечаешь, что кусок мусора у тебя в руках тоже начал мерцать.~
@48357 = ~Затолкнуть мусор в арку.~
@48358 = ~Отступить и уйти.~
@48359 = ~Это портал, связывающий площадь Старьевщиков со входом в Мусорные районы. К сожалению, в текущий момент при тебе нет мусора, который нужен для его активации.~
@48360 = ~Уйти.~
@48361 = ~Это портал, связывающий площадь Старьевщиков со входом в Мусорные районы. Он уже начал мерцать из-за близости мусора, который ты несешь с собой.~
@48362 = ~Затолкнуть мусор в арку.~
@48363 = ~Уйти.~
@48364 = ~Стена отбросов дрожит и колышется, казалось бы, вдавливается внутрь, раскрывая открытое пространство за собой... похоже, в арке образовался то ли проход, то ли портал.~
@48365 = ~Готово.~
@48366 = ~Уйти.~
@48367 = ~Отступить и уйти.~
@48368 = ~«Кажется, это заклинание делается так».~
@48369 = ~«Может, заклинание делается вот так».~
@48370 = ~«Псст! Эй, ты!»~
@48371 = ~Ключ к комнате в Фестхолле~
@48372 = ~Любовные узы~
@48373 = ~Браслет~
@48374 = ~Механический хлам~
@48375 = ~Безделушка~
@48376 = ~Мертвое сердце~
@48377 = ~Пример свитка~
@48378 = ~ПРИМЕР СВИТКА
Позволяет наложить «Пример».
Позволяет скопировать «Пример» в книгу заклинаний.
Эффект:
Дистанция:
Длительность:
Вес: 0
Используется только магами.

ОПИСАНИЕ:~
@48379 = ~ДВОЙНОЙ ПРИЦЕЛ В ФОРМЕ ПУЗЫРЯ
Вес: 0

В этом причудливом пузыреобразном прицеле имеется две линзы, установленные рядом. Если смотреть сквозь него, все начинает двоиться, отчего становится трудно определить, какая из целей настоящая.~
@48380 = ~БРАСЛЕТ
Вес: 3

Этот предмет сделан из длинных чугунных нитей, переплетенных в виде в виде браслета. Вся внешняя, а также внутренняя поверхность браслета покрыта острыми шипами. Похоже, что носящий его человек должен испытывать мучительную боль.~
@48381 = ~БРАСЛЕТ
Вес: 2

Похоже, этот браслет сделан из серебра и в него инкрустирован полудрагоценный камень.~
@48382 = ~ПАЛИЦА
Урон: 3-9 дробящий
Скорость: 6
Вес: 10
Специализация: булавы
Используется только бойцами

Палица стандартной конструкции. Довольно эффективна при нанесении сокрушительных ударов по врагу.~
@48383 = ~МЕРТВОЕ СЕРДЦЕ
Вес: 1

Это мерзкая масса, мягкая на ощупь, и хотя для этого и нет повода, в ней ОЩУЩАЕТСЯ зло. Время от времени сердце оставляет за собой струйку серого тумана, который рассеивается в воздухе.~
@48384 = ~ПОБИТАЯ УРНА
Вес: 1

Эта урна выглядит так, будто она хранилась в подвале много столетий. Кажется, в ней содержится немалое количество праха, однако на внешней поверхности урны отсутствуют пометки о том, чей это прах.~
@48385 = ~ОБРАБОТАННЫЕ КИШКИ
Вес: 2

Это липкая масса окровавленных кишок, принадлежащих тебе. Равель быстро и безболезненно вынула их из твоего тела, когда превратилась в Марту во время вашего разговора в лабиринте Черных шипов. Жидкость, покрывающая эти кишки, сгустилась, превратившись в гладкую смолу, и когда держишь их, кажется, будто в руках у тебя сухой резиновый жгут. Ты вынужден признаться, что от их вида за пределами твоего тела тебе становится не по себе.

Равель... Марта... КЕМ БЫ НИ БЫЛА та свихнувшаяся ведьма... упомянула, что кишки эти будут служить в качестве могущественного амулета, но ты не представляешь, на что они могут сгодиться.~
@48386 = ~ПРИМЕР СВИТКА
Позволяет наложить «Пример».
Позволяет скопировать «Пример» в книгу заклинаний.
Эффект:
Дистанция:
Длительность:
Вес: 0
Используется только магами.

ОПИСАНИЕ:~
@48387 = ~«Подь сюда!»~
@48388 = ~«Хочешь немного заработать?»~
@48389 = ~«Оно должно быть где-то здесь».~
@48390 = ~Пример свитка~
@48391 = ~НЕГАТИВНЫЙ СИМВОЛ
Особенность: защищает от теней
Особенность: временно удерживает создания теней
Вес: 0

Это «негативный символ», плоский черный диск, с виду совершенно бесплотный. Если перевернуть его, оказывается, что у него нет третьего измерения — этот предмет вообще не имеет толщины. Он дает тебе некоторую власть над созданиями теней: ты можешь приказать им замереть на несколько драгоценных секунд. Чем сильнее тень, тем слабее она подчиняется приказу.

В качестве дополнительного преимущества, при ношении этого символа *кем-либо* из членов твоего отряда он действует как защита от теней. Он не предотвращает нападения теней на твой отряд, но теням будет значительно сложнее нанести тебе урон, пока ты носишь с собой этот символ.~
@48392 = ~ТАТУИРОВКА ЗЛОБЫ
Вызывает: «Невыносимая насмешка Таши»
Вес: 0

Эта татуировка символизирует то, как с помощью простого заявления ты расколол отношения между Корвусом и Кариной до того, как у них появился шанс укрепиться. Данная татуировка позволяет использовать безответную любовь Корвуса и превратить ее в оружие против других.

Когда способности татуировки истощаются, она исчезает.~
@48393 = ~ИМЯ ПРИМЕРНОГО ЗАКЛИНАНИЯ~
@48394 = ~Остановить/продолжить игру~
@48395 = ~Страницы~
@48396 = ~Он задумывается. «Ага, я знаю, о чем ты толкуешь. Однажды через нее прошла девчонка, зовут Гвоздинка. Я это видел, пока искал крыс. Даже не знаю, как ей это удалось. Скорее всего, ты найдешь ее к северо-востоку отсюда: она там роется в куче деревянного мусора, ищет гвозди и другие железяки».~
@48397 = ~«Спасибо. У меня есть другой вопрос...»~
@48398 = ~«Это все, что я хотел узнать. Прощай».~
@48399 = ~«Мне посоветовали расспросить человека по имени Креден напротив Управления по борьбе с вредителями и болезнями насчет забитой мусором арки на площади Старьевщиков. Можешь мне в этом помочь?»~
@48400 = ~Гвоздинка медленно кивает. «Это портал. Я наткнулась на него совершенно случайно... все, что тебе нужно — куча мусора при себе, и тогда ты сможешь через него пройти. За порталом есть небольшое открытое пространство и проход, ведущий под землю, но я решила не искать проблем, и просто развернулась и вернулась назад. Вот... — у нее в руке пригоршня мусора. — Используй это, если надо. Я все равно хотела это выбросить».~
@48401 = ~«Спасибо. У меня есть другие вопросы...»~
@48402 = ~«Спасибо, Гвоздинка. Прощай».~
@48403 = ~«Мне посоветовали спросить женщину по имени Гвоздинка, которую можно найти здесь неподалеку от кучи строительных лесов, о забитой мусором арке на площади Старьевщиков. Ты можешь мне помочь?»~
@48404 = ~Спустя не которое время Мортай возвращается с пыльным куском пергамента в руках. Он подымает его так, чтобы ты смог разглядеть его, но из рук не выпускает.~
@48405 = ~Осмотреть пергамент.~
@48406 = ~«Посмотрим...»~
@48407 = ~Ты раскрываешь мерцающий металл, и он тут же начинает оживленно потрескивать. Он превращается в металлическое кольцо, зависшее в воздухе. Что-то из твоего имущества активизировало его!

У тебя появляется чувство, что тебе следует проверить, есть ли у тебя все необходимое: возможно, ты еще *нескоро* вернешься в Сигил.~
@48408 = ~Пройти сквозь портал.~
@48409 = ~Сложить его и спрятать.~
@48410 = ~Перед тобой коротышка с подавляемым негодованием в глазах. Рявкая распоряжениями на своих рабочих, он нетерпеливо оборачивается к тебе. «Чего надо?»~
@48411 = ~«Кто ты?»~
@48412 = ~«Что это за место?»~
@48413 = ~«Что ты можешь сказать о Проклятом?»~
@48414 = ~«Я разговаривал с Гримскальпом. Он сказал, что у тебя для меня кое-что есть».~
@48415 = ~«Ничего. Прощай».~
@48416 = ~«Для тебя у меня ничего нет, приятель, ничего. Позволь мне просто выполнять работу, хорошо? Случится что, вернись сюда, и мы позаботимся о тебе, но сейчас нам лучше не встречаться».~
@48417 = ~«Ладно. Прощай».~
@48418 = ~«Что, опять ты? Чего тебе надо?»~
@48419 = ~«Кто ты?»~
@48420 = ~«Что это за место?»~
@48421 = ~«Что ты можешь сказать о Проклятом?»~
@48422 = ~«Я разговаривал с Гримскальпом. Он сказал, что у тебя для меня кое-что есть».~
@48423 = ~«Ничего. Прощай».~
@48424 = ~«Я — Девор. Это — мой склад. Вон они — мои рабочие. А это — мое время, впустую потраченное на тебя».~
@48425 = ~«Хорошо. У меня есть еще несколько вопросов...»~
@48426 = ~«Спасибо. Прощай».~
@48427 = ~Он раздраженно вздыхает. «Это — склад. Мы храним разные вещи — оружие, золото, спиртное, ткани, еду — все, что нужно. Ты ведь слышал о складах, верно?»~
@48428 = ~«Конечно. У меня есть другие вопросы...»~
@48429 = ~«Прощай».~
@48430 = ~«Это город, в котором люди пытаются свести концы с концами. Мы делаем все, что можем, а иногда нас отвлекает какой-нибудь приключенец, который считает, что мы весь день напролет только и делаем, что ждем, когда же нас кто-нибудь порасспрашивает».~
@48431 = ~«Хорошо, у меня есть еще пара вопросов...»~
@48432 = ~«Намек понял. Прощай».~
@48433 = ~«Гримскальп? То есть он не умер? В последний раз, когда я его видел, он волочился к... а, понял. Он прислал тебя, чтобы запугать меня и забрать его часть добычи. Или вежливо попросить ее... Или как там это делается у анархистов в Сигиле? Вечно он играл в непонятные игры. Это была единственная возможность для нас... э-э, то есть, для НИХ, хе-хе-хе... воткнуть пару ножичков в него. Схожу за его добычей. Скоро вернусь».~
@48434 = ~«И побыстрее».~
@48435 = ~Он вздыхает. «Ну что еще?»~
@48436 = ~«Кто ты?»~
@48437 = ~«Что это за место?»~
@48438 = ~«Что ты можешь сказать о Проклятом?»~
@48439 = ~«Я разговаривал с Гримскальпом. Он сказал, что у тебя для меня кое-что есть».~
@48440 = ~Он вернулся с мешочком монет и парой грубых перчаток. Немного волнуясь, он произносит: «Вот, держи их. А теперь иди отсюда».~
@48441 = ~«У меня есть еще пара вопросов к тебе...»~
@48442 = ~«Прощай».~
@48443 = ~«Забудь. Прощай».~
@48444 = ~Это высокий худощавый мужчина, одетый в грубую малиновую мантию, с резкими продолговатыми чертами лица. Когда ты подходишь, он церемонно кланяется. «Я Салабеш, также нередко называемый Ониксом, будущий наставник магов в Городском Фестхолле. У тебя ко мне дело, я правильно понимаю?..»~
@48445 = ~«Нет... только несколько вопросов...»~
@48446 = ~«Нет. Прощай».~
@48447 = ~«Хм-м, о чем? Надеюсь, не о районе и тому подобных вещах... на такие вопросы тебе могут ответить немало других людей, а я лучше направлю тебя к кому-нибудь из них».~
@48448 = ~«Почему тебя называют 'Ониксом'?»~
@48449 = ~«Что ты имел в виду под 'будущим наставником магов в Фестхолле'?»~
@48450 = ~«Ты Мастер проклятий? Может быть, ты мог бы — *ик!* — помочь мне...»~
@48451 = ~«Ты тот маг, который проклял актера вниз по улице?»~
@48452 = ~«Неважно. Прощай».~
@48453 = ~Салабеш самодовольно ухмыляется. «Я не удивлен».~
@48454 = ~«Почему тебя называют 'Ониксом'?»~
@48455 = ~«Что ты имел в виду под 'будущим наставником магов в Фестхолле'?»~
@48456 = ~«Ты Мастер проклятий? Может быть, ты мог бы — *ик!* — помочь мне...»~
@48457 = ~«Ты тот маг, который проклял актера вниз по улице?»~
@48458 = ~«Неважно. Прощай».~
@48459 = ~«Это длинная история, которую я сокращу, чтобы не тратить время попусту. Раньше, в дни моей молодости, меня звали Золотым Салабешем, потому что поговаривали, у меня золотое сердце... холодное, жесткое и трусливо-желтое. Итак, я проклял глупца, который придумал *это*, да так, что он мог говорить только задом и испражняться через рот. Скоро мне придумали новое прозвище 'Оникс' — по той же причине, что и 'Золотой', хотя, по правде говоря, оно не такое меткое. Как бы там ни было, теперь я гораздо добрее... и намного реже насылаю разного рода проклятия. Не уверен, заслуживаю ли я еще это прозвище».~
@48460 = ~«У меня есть другие вопросы...»~
@48461 = ~«Это все, что я хотел узнать. Прощай».~
@48462 = ~«Помочь тебе? — Салабеш насмешливо ухмыляется. — Сомневаюсь». Не успеваешь ты ответить, как он вздыхает и качает головой. «Что ж... *возможно*, я помогу. Так что же тебя беспокоит?»~
@48463 = ~«Джамбл Смыслогуб проклял меня».~
@48464 = ~«А вообще, не обращай внимания. Счастливо».~
@48465 = ~«Джамбл Смыслогуб? Ха! Этот бормочущий идиот еще *ни разу* не смог одержать надо мной верх! Ух, ну и битвы же у нас были... — Салабеш нахмуривается. — Но теперь для меня все это в прошлом. Понимаешь, это больше не по мне. Я действительно не знаю, как тебе помочь... к тому же, это *его* проклятье. Не из тех, которые можно встретить на предметах и тому подобных вещах, ну ты понимаешь, которые можно развеять простой магией... снять его должен *он*, и по доброй воле».~
@48466 = ~«Ну, тогда ты мог бы научить меня проклятию, чтобы я смог его проклясть?»~
@48467 = ~«Тогда у меня еще вопросы...»~
@48468 = ~«В таком случае, прощай».~
@48469 = ~«Хм-м. Ну... обычно я такого не делаю. Держу свои проклятья при себе, ну ты понимаешь. Да и потом, чтобы выучить даже одно-единственное проклятие, понадобится очень много времени — больше, чем я могу позволить себе потратить».~
@48470 = ~«Я мог бы заплатить тебе за беспокойство...»~
@48471 = ~«Наверное, ты просто боишься, что твои проклятья уже не настолько хороши, чтобы переплюнуть его...»~
@48472 = ~«Тогда у меня еще вопросы...»~
@48473 = ~«В таком случае, прощай».~
@48474 = ~«Нет, нет... Я просто не хочу это делать, — Салабеш смотрит тебе прямо в глаза. — А теперь, любезный, будь добр, заканчивай с этой темой, пока ты не начал раздражать меня».~
@48475 = ~«Наверное, ты просто боишься, что твои проклятья уже не настолько хороши, чтобы переплюнуть его...»~
@48476 = ~«Хорошо. У меня есть другой вопрос...»~
@48477 = ~«У меня все, Салабеш. Прощай».~
@48478 = ~«*Что*?! Что за нелепость... так, слушай сюда, первобытный мешок со шрамами: Салабеш Оникс — *МАСТЕР* проклятий, другого такого нету! Да я могу сказать тебе одну единственную фразу, от которой все проклятия того простофили станут совершенно бесполезными!»~
@48479 = ~«Тогда научи меня...»~
@48480 = ~Скривиться, посмотреть скептически.~
@48481 = ~«Уверен, так оно и есть. У меня есть еще один вопрос...»~
@48482 = ~~
@48483 = ~~
@48484 = ~«Ну хорошо, хорошо... прощай».~
@48485 = ~«Ну все! Ты *вынуждаешь* меня делать это! — Салабеш произносит несколько невероятных слов... слов силы, которые ты запоминаешь, чтобы позже использовать против Джамбла. — Ну вот! Посмотри, что *это* сделает с ним, и потом попробуй сказать, что Салабеш Оникс — *не* Мастер проклятий!»~
@48486 = ~«Спасибо, Салабеш; так и сделаю. Прощай».~
@48487 = ~Я научился у Салабеша Оникса короткому проклятью, которое могу применить против Джамбла Смыслогуба.~
@48488 = ~«А... — Салабеш прищуривает глаза, его рот искривляется. — *Он*. Да, я его проклял, и он более чем заслуживал этого! Насмехаться над проходящим мимо магом... что за дурак мог до такого додуматься? Да он просто *напрашивался*! В конце концов, я же Салабеш Оникс, Мастер проклятий. Но ты не волнуйся... проклятие безвредно. И даже улучшает его никудышную игру, во всяком случае, он не пропадет».~
@48489 = ~«Мастер проклятий? Тогда, может, ты бы мог — *ик!* — помочь мне...»~
@48490 = ~«У меня есть другие вопросы...»~
@48491 = ~«Это все, что я хотел узнать. Прощай».~
@48492 = ~«Это престижная должность — быть официальным наставником в одном из тренировочных залов Фестхолла. Когда-нибудь я займу должность наставника, но в текущий момент ее занимает леди Торнкомб. Если бы мне как-то удалось доказать, что я буду лучшим наставником...»~
@48493 = ~«Ты можешь обратить внимание на тот факт, что она одержима камнями переживаний. Похоже, она больше не хочет преподавать...»~
@48494 = ~«У меня есть другие вопросы...»~
@48495 = ~«Это все, что я хотел узнать. Прощай».~
@48496 = ~Я рассказал Салабешу, что леди Торнкомб проводит все свое время в сенсориуме и больше не желает преподавать. Он пожелал занять ее место, но я не уверен насчет того, насколько хороший учитель из него получится. Пожалуй, мне лучше сообщить леди Торнкомб о его намерениях, чтобы дать ей последний шанс сделать выбор.~
@48497 = ~Салабеш искривляет губы в зловещей улыбке. «Значит, *вот* как? И ее больше не заботит учеба? Превосходно... — он довольно потирает руки. — Тогда я немедленно потребую, чтобы меня назначили новым учителем магов».~
@48498 = ~«У меня есть другие вопросы...»~
@48499 = ~«Это все, что я хотел узнать. Прощай».~
@48500 = ~Ты видишь Салабеша Оникса. Он делает короткий, но изящный полупоклон. «Хм-м. Вновь ты стоишь передо мной...»~
@48501 = ~«Да. У меня есть несколько вопросов...»~
@48502 = ~«Я просто проходил. Прощай».~
@48503 = ~Эта ниша углубляется в северную стену всего лишь на несколько шагов, после чего внезапно обрывается.~
@48504 = ~Уйти.~
@48505 = ~Эта ниша углубляется в северную стену всего лишь на несколько шагов, после чего внезапно обрывается.

Это то самое место, куда сказала тебе зайти Тухлая Мери, закрыв перед этим глаза и подумав о Безмолвном Короле. Поскольку она все еще «жива», от этого должен активироваться портал в тронный зал Безмолвного Короля.~
@48506 = ~Ничего не произошло. Наверное, Тухлая Мери мертва...~
@48507 = ~Попробовать активировать портал.~
@48508 = ~Активировать портал.~
@48509 = ~Уйти, не активировав портал.~
@48510 = ~Уйти.~
@48511 = ~«У меня есть несколько вопросов...» ~
@48512 = ~«В данный момент мне ничего не нужно. Прощай».~
@48513 = ~«Мы с удовольствием ответим на любые вопросы, на какие сможем, пока они касаются Фестхолла или Общества Восприятия».~
@48514 = ~«Я хотел бы спросить о тебе...»~
@48515 = ~«А чем ты можешь помочь мне, Сплинтер?»~
@48516 = ~«Я могу здесь где-нибудь отдохнуть?»~
@48517 = ~«Расскажи мне о Фестхолле».~
@48518 = ~«Расскажи мне об Обществе Восприятия».~
@48519 = ~«Я тут кое-кого ищу...»~
@48520 = ~«Тут есть кто-нибудь, кто может что-то знать о Равель Заморочке?»~
@48521 = ~«Вообще-то, неважно. Прощай».~
@48522 = ~«В этом славном холле мы занимаемся многими вещами, путник. Мы отвечаем на вопросы гостей о Фестхолле и его обитателях. Мы указываем дорогу в сенсориумы и лекционные залы посетителям и членам Общества Восприятия. Кроме того, мы принимаем в Общество новых членов. И наконец, через нас осуществляется торговля запасами Общества... заклинаниями, вещами и тому подобным».~
@48523 = ~«У меня есть другие вопросы...»~
@48524 = ~«Ты не подскажешь мне дорогу в сенсориумы?»~
@48525 = ~«Какие лекции тут можно посетить?»~
@48526 = ~«Я хотел бы купить кое-что из запасов чувствующих...»~
@48527 = ~«Могу ли я купить что-нибудь из запасов чувствующих?»~
@48528 = ~«Это все, что я хотел узнать. Прощай».~
@48529 = ~«Их два: публичный сенсориум, где посетители могут пользоваться камнями переживаний по цене от десяти до пятидесяти монет, и частный сенсориум, куда допускаются только члены Общества Восприятия. Ты не сможешь добраться до них самостоятельно: мы должны *отвести* тебя туда».~
@48530 = ~«Тогда отведи меня в публичный сенсориум».~
@48531 = ~«Тогда отведи меня в частный сенсориум».~
@48532 = ~«Как мне попасть в частный сенсориум?»~
@48533 = ~«Постой... У меня вопрос о другом...»~
@48534 = ~«Вообще-то, мне уже пора. Счастливо».~
@48535 = ~«Текущими лекторами Фестхолла являются: Защитник смерти, рассказывающий о смерти и о том, что следует за ней, Кривой Гизис, рассказывающий о Кровавой войне, и Приверженец Трех Планов, рассказывающий о силе мировоззрения и веры. При условии, что в данный момент они находятся здесь в добром здравии, мы можем направить тебя на одну из их лекций в любое время».~
@48536 = ~«Я хотел бы посетить лекцию Защитника смерти».~
@48537 = ~«Я хотел бы посетить лекцию Кривого Гизиса».~
@48538 = ~«Я хотел бы посетить лекцию Приверженца Трех Планов».~
@48539 = ~«У меня есть вопрос насчет других вещей...»~
@48540 = ~«Это все, что я хотел узнать. Прощай».~
@48541 = ~«Мы уже практически все рассказали. Мы — Сплинтер, привратник Фестхолла, полубог, сын Исахара и Король-Жрец Ура. В наш мир пришли путешественники по планам и рассказали нам про Общество Восприятия; мы пришли в восторг и вернулись вместе с ними. Мы оставили Ур в надежных руках королевы, чтобы прибыть в это место и некоторое время переживать 'неволю' и 'покорность'. Поскольку время здесь течет не так, как в Уре, столетие здесь — всего лишь несколько месяцев в нашем мире. Лет через десять мы, пожалуй, будем готовы вернуться в Ур и продолжить правление им».~
@48542 = ~«Понятно... У меня есть другой вопрос...»~
@48543 = ~«Это... все, что я желал знать. Прощай, Сплинтер».~
@48544 = ~«Городской Фестхолл — одно из самых больших зданий в Сигиле, каким и подобает быть дому Общества Восприятия, крупнейшей фракции в городе. В нем есть сенсориумы, лекционные залы, тренировочные залы — как для посетителей, так и для членов Общества».~
@48545 = ~«Расскажи мне об Обществе Восприятия».~
@48546 = ~«Расскажи мне о сенсориумах».~
@48547 = ~«Расскажи мне о тренировочных залах».~
@48548 = ~«У меня есть другие вопросы...»~
@48549 = ~«Это все, что я хотел узнать. Прощай».~
@48550 = ~«Суть верований чувствующих заключается в том, мультивселенная может быть познана *по-настоящему* только с помощью чувств. Если чего-то не можно ощутить, то его *не существует*. Только через переживания... испытывая весь доступный чувственный опыт... можно полностью раскрыть Истину мультивселенной. Таким образом, в Обществе Восприятия переживания накапливаются и разделяются с другими, обычно через сенсориумы».~
@48551 = ~«Могу ли я стать чувствующим?»~
@48552 = ~«У меня есть другие вопросы...»~
@48553 = ~«Это все, что я хотел узнать. Прощай».~
@48554 = ~«Сенсориумы — это комнаты, в которых находится множество записывающих камней, или камней переживаний. На эти камни наложены чары, позволяющие им сохранять различные чувства и переживания, которые затем могут быть пережиты другими. Если тебе будет угодно, мы можем направить тебя в один из них».~
@48555 = ~«Да, пожалуйста».~
@48556 = ~«Нет, но меня есть другой вопрос...»~
@48557 = ~«Нет... Не сейчас. Прощай».~
@48558 = ~«Их три: для воинов, для воров и для практикующих магию. Если хочешь найти их, пройди в среднюю дверь в восточной стене, затем в дверь за ней. Ты очутишься на стыке коридоров... в том, что идет на восток, есть три двери на южной стене. Каждая из них ведет в один из тренировочных залов».~
@48559 = ~«У меня есть другие вопросы...»~
@48560 = ~«Это все, что я хотел узнать. Прощай».~
@48561 = ~«Кого же ты ищешь, путник?»~
@48562 = ~«Финама, лингвиста».~
@48563 = ~«Госпожу Джолми из дома Сирма...»~
@48564 = ~«Весельчака».~
@48565 = ~«Ки-Саи, наставника воинов».~
@48566 = ~«Илая Хейвлока, наставника воров».~
@48567 = ~«Леди Торнкомб, наставницу магов».~
@48568 = ~«Монтекки, здешнего фрактотума».~
@48569 = ~«Монтекки, здешнего фрактотума».~
@48570 = ~«Вообще-то, никого. У меня еще вопрос...»~
@48571 = ~«Неважно. Прощай, Сплинтер».~
@48572 = ~«В данный момент Финам не читает здесь лекций, так что, скорее всего, ты найдешь его у себя дома. Иди на юг от входа в Фестхолл между галереей Иваны и аптекой. Увидишь его справа: небольшой пятиугольный домик на запад от антикварного магазина».~
@48573 = ~«Спасибо. У меня есть другой вопрос...»~
@48574 = ~«Это все, что я хотел узнать. Прощай».~
@48575 = ~«Джолми с недавних пор пребывает в этом самом зале. Мы думаем, что она ищет или ждет кого-то. Как бы там ни было, она должна быть неподалеку».~
@48576 = ~«Спасибо. У меня есть другой вопрос...»~
@48577 = ~«Это все, что я хотел узнать. Прощай».~
@48578 = ~~
@48579 = ~«Ки-Саи часто ищет уединенные места для медитации. Скорее всего, он в самой безлюдной комнате: стоит вдали от остальных, неподвижный, в состоянии молчаливого созерцания».~
@48580 = ~«Спасибо. У меня есть другой вопрос...»~
@48581 = ~«Это все, что я хотел узнать. Прощай».~
@48582 = ~«Илай Хейвлок недавно покинул здание, и выглядел рассерженным. Мы думаем, что он бродит по району неподалеку от Городского Фестхолла».~
@48583 = ~«Спасибо. У меня есть другой вопрос...»~
@48584 = ~«Это все, что я хотел узнать. Прощай».~
@48585 = ~Сплинтер слегка мрачнеет, прищуривая глаза. «Вне всякого сомнения, ее можно найти в одном из сенсориумов. В последнее время леди Торнкомб уклоняется от своих обязанностей, проводя слишком много времени с камнями переживаний. Ты не сможешь добраться туда сам, однако мы можем *отвести* тебя туда, если захочешь».~
@48586 = ~«Да, пожалуйста».~
@48587 = ~«Нет, но меня есть другой вопрос...»~
@48588 = ~«Нет... Не сейчас. Прощай».~
@48589 = ~«Монтекки — занятой молодой человек; обычно он мечется между этой комнатой и тремя другими в восточной стене».~
@48590 = ~«Спасибо. У меня есть другой вопрос...»~
@48591 = ~«Это все, что я хотел узнать. Прощай».~
@48592 = ~«Чтобы присоединиться к Обществу Восприятия, нужно быть готовым делиться своими впечатлениями. Требуется пять переживаний — по одному на каждое чувство. Или одно переживание, содержащее сильные элементы всех пяти чувств. Это должны быть либо новые впечатления, либо улучшенный вариант тех, что у нас уже есть. Если мы найдем их подходящими, они будут помещены в камни переживаний, а ты, став чувствующим, будешь обучен Чувствительному прикосновению. Это позволить тебе забирать чужую боль, исцеляя других переживанием их страданий».~
@48593 = ~«Я уже являюсь членом фракции боголюдей, но...»~
@48594 = ~«Я уже являюсь членом фракции тленных, но...»~
@48595 = ~«Я уже являюсь членом... другой фракции, но...»~
@48596 = ~«Я уже являюсь членом фракции хаоситеков, но...»~
@48597 = ~«Я уже являюсь членом фракции боголюдей. Я передумал... Я не стану их предавать».~
@48598 = ~«Я уже являюсь членом фракции тленных. Я передумал... Я не стану их предавать».~
@48599 = ~«Я уже являюсь членом... другой фракции. Я передумал... Я не стану их предавать».~
@48600 = ~«Я уже являюсь членом фракции хаоситеков. Я передумал... Я не стану их предавать».~
@48601 = ~«Я готов. Я хочу стать чувствующим».~
@48602 = ~«У меня есть другие вопросы...»~
@48603 = ~«Это все, что я хотел узнать. Прощай».~
@48604 = ~«Ты должен быть членом Общества Восприятия».~
@48605 = ~«Тогда могу ли я стать чувствующим?»~
@48606 = ~«А что, если я уже *был* чувствующим? Меня здесь уже давно не было, однако уверяю тебя... я был чувствующим».~
@48607 = ~Блеф: «О, так я и *есть* чувствующий, правда».~
@48608 = ~Блеф: «Но ведь я член фракции, Сплинтер... меня просто уже давным-давно здесь не было. В свое отсутствие я собрал много впечатлений... столько, сколько шрамов на моем теле».~
@48609 = ~«У меня есть другие вопросы...»~
@48610 = ~«Это все, что я хотел узнать. Прощай».~
@48611 = ~Сплинтер сильно наклоняется, чтобы рассмотреть тебя повнимательнее. «Мы тебя не узнаем... однако мы не видим лжи, стекающей с твоего языка. Отлично. Мы предоставим тебе доступ к привилегиям, доступным лишь членам Общества Восприятия... *если* ты покажешь нам последние собранные тобой впечатления».~
@48612 = ~«Хорошо... Я готов».~
@48613 = ~«Забудь. У меня есть другой вопрос...»~
@48614 = ~«Неважно. Прощай, Сплинтер».~
@48615 = ~«Истинный Жрец-Король Ура способен видеть стекающую с языка ложь. Неразумно обманывать нас, путник».~
@48616 = ~«Я... пошутил, я не обманывал. У меня есть другой вопрос...»~
@48617 = ~«В таком случае, прошу прощения. У меня есть другой вопрос...»~
@48618 = ~«Я просто... пошутил над тобой, Сплинтер. Прощай».~
@48619 = ~«Тогда я прошу твоего прощения, Сплинтер. Прощай».~
@48620 = ~Он сужает глаза и фыркает, осматривая тебя. «Очень... хорошо. Мы предоставим тебе доступ к привилегиям, доступным лишь членам Общества Восприятия... *если* ты можешь показать нам собранные тобой недавно впечатления».~
@48621 = ~«Хорошо... Я готов».~
@48622 = ~«Забудь. У меня есть другой вопрос...»~
@48623 = ~«Неважно. Прощай, Сплинтер».~
@48624 = ~Сплинтер только кивает.~
@48625 = ~«У меня есть другие вопросы...»~
@48626 = ~«Прощай».~
@48627 = ~«Тебе не будет прощения. Пути назад не будет».~
@48628 = ~«Я готов присоединиться к Обществу Восприятия. Я больше не предан боголюдям».~
@48629 = ~«Я готов присоединиться к Обществу Восприятия. Я больше не предан тленным».~
@48630 = ~«Я готов присоединиться к Обществу Восприятия. Я больше не предан... своей старой фракции».~
@48631 = ~«Я готов присоединиться к Обществу Восприятия. Я больше не предан хаоситекам».~
@48632 = ~Солгать, чтобы проникнуть к чувствующим для анархистов: «Я готов присоединиться к Обществу Восприятия. Я больше не предан... своей старой фракции».~
@48633 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@48634 = ~«Не думаю, что готов это сделать. Прощай».~
@48635 = ~«Во-первых, какой *запах*, или переживание, связанное с ним, ты можешь нам предложить?»~
@48636 = ~«Вообще-то, я хотел бы поделиться переживанием, в котором участвовали все пять чувств: я проснулся, не понимая, где я нахожусь, на холодной окровавленной железной плите в недрах Морга, места, где встречаются лишь тленные и трупы под их опекой...»~
@48637 = ~Он кивает. «Волнительное переживание».~
@48638 = ~«И я даже не упомянул про пустозвонящего черепа, который налетел на меня, как только я встал. Этого достаточно, Сплинтер?»~
@48639 = ~«Да... теперь мы пройдем к пустому камню, чтобы записать твои впечатления. Тебе будет предоставлен доступ к привилегиям, доступным лишь членам Общества Восприятия; также ты будешь обучен Чувствительному прикосновению».~
@48640 = ~Следовать за ним, чтобы записать твои впечатления и изучить Чувствительное прикосновение.~
@48641 = ~Следовать за ним, чтобы записать твои впечатления и притвориться, будто изучаешь Чувствительное прикосновение.~
@48642 = ~Вы со Сплинтером возвращаетесь в фойе Городского Фестхолла.

«Мы приветствуем тебя в Обществе Восприятия, путник. Пусть дальнейшие странствия и переживания устилают тебе дорогу к великой истине мультивселенной».~
@48643 = ~«Спасибо, Сплинтер. У меня есть другие вопросы...»~
@48644 = ~«Спасибо. Прощай, Сплинтер».~
@48645 = ~«Тогда нам требуется пять переживаний — по одному на каждое телесное чувство... или единственное переживание с сильными элементами всех пяти чувств».~
@48646 = ~«Тогда я могу поделиться одним переживанием: я проснулся, не понимая, где я нахожусь, на холодной окровавленной железной плите в недрах Морга, места, где можно встретить только тленных и трупов под их опекой...»~
@48647 = ~Он кивает. «Волнительное переживание».~
@48648 = ~«И я даже не упомянул про пустозвонящего черепа, который налетел на меня, как только я встал. Этого достаточно, Сплинтер?»~
@48649 = ~«Да. Мы вновь приветствуем тебя, путник, и предоставляем тебе доступ к привилегиям, доступным лишь членам Общества Восприятия».~
@48650 = ~«Спасибо, Сплинтер. У меня есть другие вопросы...»~
@48651 = ~«Спасибо. Прощай, Сплинтер».~
@48652 = ~«В Фестхолле есть жилье, но пользоваться им разрешено только членам Общества Восприятия. Если хочешь нанести туда визит, иди по Фестхоллу на восток отсюда: в конце концов, ты туда доберешься. Тамошний служащий пропускает чувствующих в комнаты».~
@48653 = ~«А... нельзя ли как-нибудь по-другому получить здесь комнату?»~
@48654 = ~«У меня есть другие вопросы...»~
@48655 = ~«Это все, что я хотел узнать. Прощай».~
@48656 = ~Сплинтер холодно приветствует тебя, когда ты подходишь. «Мы вновь приветствуем тебя в Городском Фестхолле, путник. Чем мы можем тебе помочь?»~
@48657 = ~«У меня есть несколько вопросов...» ~
@48658 = ~«В данный момент мне ничего не нужно. Прощай».~
@48659 = ~Сплинтер кивает. «Продолжай».~
@48660 = ~«Все мое тело провоняло бальзамирующей жидкостью, но даже ему не перебить этот медный запах крови вокруг меня. Десятки тел лежат на бесчисленных окровавленных плитах, таких же, как та, с которой я встал. Все они потрошатся и свежуются кошмарными механическими устройствами непонятного предназначения. Единственные слышимые звуки — скрежет металла и шаткая поступь неживых рабочих, толкающих плиты взад-вперед по Моргу по ржавым железным рельсам».~
@48661 = ~Сплинтер кивает. «Продолжай».~
@48662 = ~«Все мое тело провоняло бальзамирующей жидкостью, но даже ему не перебить этот медный запах крови вокруг меня. Десятки тел лежат на бесчисленных окровавленных плитах, таких же, как та, с которой я встал. Все они потрошатся и свежуются кошмарными механическими устройствами непонятного предназначения. Единственные слышимые звуки — скрежет металла и шаткая поступь неживых рабочих, толкающих плиты взад-вперед по Моргу по ржавым железным рельсам».~
@48663 = ~Сплинтер закрывает глаза и задумывается на секунду. «Мы советуем тебе поговорить на счет Равель с волшебником по имени Квелл. Он постоянно где-нибудь в Фестхолле, чаще всего — в частном сенсориуме».~
@48664 = ~«Покажи мне дорогу в частный сенсориум».~
@48665 = ~«Как мне попасть в частный сенсориум?»~
@48666 = ~«У меня есть другие вопросы...»~
@48667 = ~«Это все, что я хотел узнать. Прощай».~
@48668 = ~«Обычно Весельчак ходит туда-сюда вокруг лекционных залов. Иди через среднюю дверь в восточной стене, затем через дверь за ней. Скорее всего, он будет бродить по коридору, в который ты попадешь».~
@48669 = ~«Спасибо. У меня есть другой вопрос...»~
@48670 = ~«Это все, что я хотел узнать. Прощай».~
@48671 = ~«Куда этот идиот его спрятал?»~
@48672 = ~«Что теперь делать?»~
@48673 = ~«Друзья будут злиться на Раука».~
@48674 = ~«Раук принес кольца, хозяева».~
@48675 = ~«Аааааа...»~
@48676 = ~«Браааааа...»~
@48677 = ~«Вааааа...»~
@48678 = ~«Гааааа...»~
@48679 = ~«Ой! Браааааа...»~
@48680 = ~«Эээ... Браааааа...»~
@48681 = ~«Тогда приступим».~
@48682 = ~«Кхм!»~
@48683 = ~«Ой! Браааааа...»~
@48684 = ~«Мы сделали это!»~
@48685 = ~«Берегись! Оно атакует!»~
@48686 = ~Перед тобой куб с парой рук, ног и парой небольших крылышек по бокам. Спереди куба есть лицо, которое при твоем приближении фокусирует на тебе глаза.~
@48687 = ~«Приветствую».~
@48688 = ~Не обращать внимания на существо.~
@48689 = ~«Приветствуем». У существа монотонный и бесполый голос.~
@48690 = ~«У меня есть несколько вопросов...» ~
@48691 = ~«Неважно. Прощай».~
@48692 = ~Существо смотрит на тебя пустым взглядом. «Сформулируй свой вопрос».~
@48693 = ~«Кто ты?»~
@48694 = ~«Что ты такое?»~
@48695 = ~«Что это за место?»~
@48696 = ~«На что именно способен Рубикон?»~
@48697 = ~«Я хочу создать подземелье для исследований».~
@48698 = ~«Я хочу воспользоваться портальными линзами для путешествия».~
@48699 = ~~
@48700 = ~«Мы — модрон».~
@48701 = ~«Твое имя Модрон?»~
@48702 = ~«У меня есть несколько вопросов...» ~
@48703 = ~«Я должен идти. Прощай».~
@48704 = ~«Мы — модрон. Мы не имеем имен. Мы — модрон. Все, что ты видишь здесь, — модрон. Мы — одно».~
@48705 = ~«Но если у вас нет имен, как вы отличаете друг друга?»~
@48706 = ~«У меня есть несколько вопросов...» ~
@48707 = ~«Я должен идти. Прощай».~
@48708 = ~Анализируя твой вопрос, модрон на некоторое время умолкает. «Мы знаем. Мы — модрон. Мы — часть целого. Как ты сознаешь ладонь частью руки, так и мы сознаем каждую часть целого».~
@48709 = ~«А что насчет тебя как личности...»~
@48710 = ~«Очень интересно. У меня есть другие вопросы...»~
@48711 = ~«Я должен идти. Прощай».~
@48712 = ~«Мы — модрон, мы — квадрон».~
@48713 = ~«Что такое модрон?»~
@48714 = ~«Что такое квадрон?»~
@48715 = ~«У меня есть несколько вопросов...» ~
@48716 = ~«Я должен идти. Прощай».~
@48717 = ~«Мы — модрон. Наша раса идентифицируется так».~
@48718 = ~«А что такое квадрон?»~
@48719 = ~«У меня есть несколько вопросов...» ~
@48720 = ~«Я должен идти. Прощай».~
@48721 = ~«Внутри нашей расы мы идентифицируемся как тип квадрон».~
@48722 = ~«А что такое модрон?»~
@48723 = ~«У меня есть несколько вопросов...» ~
@48724 = ~«Я должен идти. Прощай».~
@48725 = ~«Это проект Подземелья Рубикон».~
@48726 = ~«А что это на самом деле?»~
@48727 = ~«У меня есть несколько вопросов...» ~
@48728 = ~«Я должен идти. Прощай».~
@48729 = ~Модрон издает жужжание, пока отвечает тебе. «Рубикон: задачи проекта — определить движущие силы, как социальные, так и асоциальные, окружающие среду, собранную в виде подземелья, и попытаться объяснить аберрации, которые возникают в подобных средах». ~
@48730 = ~«И как вы собираетесь это сделать?»~
@48731 = ~«О каких еще аберрациях ты говоришь?»~
@48732 = ~«У меня есть несколько вопросов...» ~
@48733 = ~«Я должен идти. Прощай».~
@48734 = ~«Рубикон способен сформировать серию комнат, соединенных определенным способом, который обычно именуется *подземельем*. Каждое подземелье может иметь три уровня сложности: простой, нормальный и сложный. Подземелье заполняется монстрами, ловушками и сокровищами согласно выбранному уровню сложности. После создания подземелье можно полностью исследовать», — модрон начинает низко гудеть.~
@48735 = ~«Что это за жужжание?»~
@48736 = ~«Ты что-то сказал про аберрации?»~
@48737 = ~«Интересно. Я хотел бы попробовать одно из этих подземелий».~
@48738 = ~«У меня есть несколько вопросов...» ~
@48739 = ~«Я должен идти. Прощай».~
@48740 = ~«Запросы, на которые необходимо ответить: Что привлекает людей в подземелья? Почему люди так часто стараются проникнуть в них, если подобные места содержат опасность? Почему именно подземелья? Каковы движущие силы реального подземелья? Мы... — он делает паузу. — Я не понимаю».~
@48741 = ~~
@48742 = ~«Да, пожалуйста».~
@48743 = ~Согнуть левое колено, пока нога не согнется под углом пятнадцать градусов, расправить по максимуму оба крыла, потом повернуть правую руку в месте крепления на 180 градусов.~
@48744 = ~Согнуть левое колено, пока нога не согнется под углом пятнадцать градусов, расправить по максимуму оба крыла, потом повернуть правую руку в месте крепления на 180 градусов.~
@48745 = ~Согнуть левое колено, пока нога не согнется под углом пятнадцать градусов, расправить по максимуму оба крыла, потом повернуть правую руку в месте крепления на 180 градусов.~
@48746 = ~Согнуть левое колено, пока нога не согнется под углом пятнадцать градусов, расправить по максимуму оба крыла, потом повернуть правую руку в месте крепления на 180 градусов.~
@48747 = ~Повернуть правую руку.~
@48748 = ~«Интересно. Я хотел бы попробовать одно из этих подземелий».~
@48749 = ~«Ты начал говорить *я* вместо *мы*...»~
@48750 = ~«У меня есть несколько вопросов...» ~
@48751 = ~«Я должен идти. Прощай».~
@48752 = ~Перед ответом нависает долгое молчание. «Запрос отклонен... Проект приостановлен из-за... происшествия».~
@48753 = ~«Какого происшествия?»~
@48754 = ~«У меня есть несколько вопросов...» ~
@48755 = ~«Я должен идти. Прощай».~
@48756 = ~«Сооружение подземелья стало нестабильным, вызвав неопределенность. Активированные предохранители предотвращения коллапса подземелья вызвали неопределенность. Портальные линзы дали сбой, вызвав разрыв связи с домашним планом Механусом, вызвав неопределенность. Требуется сброс подземелья».~
@48757 = ~«Так почему бы не сбросить его?»~
@48758 = ~«У меня есть несколько вопросов...» ~
@48759 = ~«Я должен идти. Прощай».~
@48760 = ~«Сброс может быть инициализирован только директором проекта. Директор проекта дезинтегрирован. Портальные линзы дали сбой, и контакт с Механусом был прерван. Невозможно получить нового руководителя с Механуса».~
@48761 = ~«Давай начистоту. Вы не можете сделать сброс без директора, но директора вы не сможете достать, не сделав сброс?»~
@48762 = ~«У меня есть несколько вопросов...» ~
@48763 = ~«Я должен идти. Прощай».~
@48764 = ~Модрон начинает обеспокоенно вертеться. «Суждение верно. Проект приостановлен».~
@48765 = ~«Слушай, я ведь приключенец, и бывал в подобных подземельях. Почему бы мне не стать вашим директором?»~
@48766 = ~«У меня есть несколько вопросов...» ~
@48767 = ~«Я должен идти. Прощай».~
@48768 = ~Неожиданно комната наполняется гулом, который также неожиданно исчезает. «Содействие принято. Теперь ты директор проекта. Сообщи следующую задачу».~
@48769 = ~«Сбросить подземелье».~
@48770 = ~«Инициализация сброса...» Комната заполнена низким бренчанием, которое не столько слышится, сколько осязается. «Снос существующего подземелья...» Сила звука повышается, начинает вибрировать пол. «Инициализация нового подземелья...» Звук достигает такой громкости, что тебе кажется, что голова вот-вот взорвется. Неожиданно все стихает. «Сброс завершен. Статус сооружения подземелья: простой. Ожидаем следующие инструкции, директор».~
@48771 = ~«У меня есть несколько вопросов...» ~
@48772 = ~«Я должен идти. Прощай».~
@48773 = ~«Рубикон способен сформировать серию комнат, соединенных определенным способом, который обычно именуется *подземельем*. Каждое подземелье может иметь три уровня сложности: простой, нормальный и сложный. Подземелье заполняется монстрами, ловушками и сокровищами согласно выбранному уровню сложности. После создания подземелье можно полностью исследовать, — модрон делает паузу. — Альтернативные возможности доступны с помощью портальных линз».~
@48774 = ~«Что еще за альтернативные возможности?»~
@48775 = ~«У меня есть несколько вопросов...» ~
@48776 = ~«Я должен идти. Прощай».~
@48777 = ~«Рубикон может принять форму врат в другие локации, временно присоединившись к заранее известным порталам. Данный эффект известен под названием *портальных линз*. Благодаря этому возможно использовать портал из Рубикона, не путешествуя при этом к местоположению самого портала».~
@48778 = ~«Значит, если мне известен портал, я смогу попасть в его место назначения прямо отсюда?»~
@48779 = ~«Верно, директор».~
@48780 = ~«У меня есть несколько вопросов...» ~
@48781 = ~«Я должен идти. Прощай».~
@48782 = ~«Выбери уровень сложности».~
@48783 = ~«Он уже установлен на простом, так что просто создайте новое подземелье».~
@48784 = ~«Он выставлен на простом, измени его на нормальный».~
@48785 = ~«Он выставлен на простом, измени его на сложный».~
@48786 = ~«Он уже установлен на нормальном, так что просто создайте новое подземелье».~
@48787 = ~«Он выставлен на нормальном, измени его на простой».~
@48788 = ~«Он выставлен на нормальном, измени его на сложный».~
@48789 = ~«Он уже установлен на сложном, так что просто создайте новое подземелье».~
@48790 = ~«Он выставлен на сложном, измени его на нормальный».~
@48791 = ~«Он выставлен на сложном, измени его на простой».~
@48792 = ~«Неважно, оставьте его как есть».~
@48793 = ~«Снос существующего подземелья...» Комната наполняется низким бренчанием. «Инициализация нового подземелья...» Пол начинает вибрировать, после чего все стихает. «Подземелье создано. Ожидаем следующие инструкции, директор».~
@48794 = ~«Пока все. Прощай».~
@48795 = ~«Настройки не изменены. Ожидаем следующие инструкции, директор».~
@48796 = ~«Пока что все. Прощай».~
@48797 = ~«Сформулируй свое направление, директор».~
@48798 = ~~
@48799 = ~~
@48800 = ~Ты видишь мужчину, который смотрит внутрь здания.~
@48801 = ~«Приветствую».~
@48802 = ~Оставить мужчину в покое.~
@48803 = ~«Опять ты... я тебе, что, не говорил, что это мое место? Потеряйся, или я буду жесток с тобой!»~
@48804 = ~«Хочется посмотреть на эту попытку».~
@48805 = ~«Прощай».~
@48806 = ~«Я первым нашел это место. Тебе лучше не пытаться, раз ты не знаешь, что хорошо для тебя».~
@48807 = ~«И что ты собираешься делать?»~
@48808 = ~«Прощай».~
@48809 = ~«Ты сам напросился!»~
@48810 = ~Атаковать его.~
@48811 = ~~
@48812 = ~Ты видишь хилого человека, жмущегося к углу.~
@48813 = ~«Приветствую».~
@48814 = ~~
@48815 = ~«Нет, не здесь... да *где* же эта книга?»~
@48816 = ~Пространство под нависающей веткой тускло сияет... Похоже, за ней находится маленькая ежевичная комнатка. Осматривая ее, ты вдруг замечаешь, что подаренный Равель амулет начал извиваться как змея.~
@48817 = ~Обвить амулет Равель вокруг указательного пальца левой руки и шагнуть в портал.~
@48818 = ~~
@48819 = ~Осмотреть амулет, дождаться, что произойдет.~
@48820 = ~Эта арка сделана из сучковатых ветвей дерева, которое выросло из пола лабиринта, а затем упало и образовало арку. Когда ты подходишь к ней, пространство в ней начинает тускло светиться... Похоже, что ведет она в какой-то необычный черношипный сад.~
@48821 = ~Подойти к левой стороне арки, поцарапать кору ногтями, затем шагнуть в портал.~
@48822 = ~Осмотреть арку.~
@48823 = ~Похоже, эта ежевичная арка открывает вид на крупный город в пустыне, окруженный высокими стенами... Должно быть, это и есть тюрьма, о которой говорила Равель.~
@48824 = ~Обхватить себя руками наподобие клетки и шагнуть в портал.~
@48825 = ~Оставить портал в покое.~
@48826 = ~ТАТУИРОВКА ТРИСТ
Особенность: +3 к спасброскам против паралича
Вес: 0

Эта татуировка символизирует твои заслуги в освобождении Трист. При ношении она защищает от оков, паралича и любых других сковывающих или удерживающих атак.~
@48827 = ~ТАТУИРОВКА ОКА ПРАВОСУДИЯ
Вызывает: «Обнаружить зло»
Особенность: +1 к Силе
Вес: 0

Эта татуировка рассказывает о том, как ты помог Трист, и изображает арест и суд над Байроном Пикитом. Данная татуировка усиливает зрение и разум носителя: она позволяет чувствовать несправедливость, и дает силу, чтобы устранить ее.

Сила татуировки может быть использована ограниченное количество раз, но когда Обнаружение зла исчерпывается, татуировка остается.~
@48828 = ~ТАТУИРОВКА МЕРТВОЙ ЖИЗНИ
Вызывает: «Поднять мертвеца»
Вес: 0
Используется только Безымянным

Эта татуировка рассказывает о том, как ты спас жизнь Димтри, подарив ему вторую смерть. Было ли это глубокой благодарностью Димтри, или силой, переданной в словах, что были сказаны тобой, чтобы освободить его, — теперь эта татуировка позволяет тебе пользоваться данным опытом и возвращать других из-за грани смерти.

Эта татуировка будет действовать только три раза, после чего исчезнет с кожи.~
@48829 = ~ТАТУИРОВКА ГИБЕЛИ ГРОСУКА
Вызывает: «Улучшенная сила»
Вес: 0

Эта татуировка рассказывает о твоем содействии Себастиону в убийстве абишая Гросука. Данная татуировка вызывает эти переживания и увеличивает грубую силу носителя, чтобы избежать неприятных сложностей с законом.

Сила татуировки ограничена. Когда ее сила истощается, татуировка исчезает без следа.~
@48830 = ~ТАТУИРОВКА ПОГИБЕЛИ СЕБАСТИОНА
Вызывает: «Хождение по огню»
Вес: 0

Эта татуировка рассказывает о том, как ты предал Себастиона абишаю Гросуку. Татуировка использует этот опыт, позволяя тебе усилить малейшие следы злобной благодарности абишая и увеличить ее. Будучи начертанной на теле, эта татуировка обладает способностью отводить тепло от тела.

Подобно благодарности любого баатезу, сила данной татуировки ограничена. Когда ее сила исчепывается, она исчезает без следа.~
@48831 = ~ТАТУИРОВКА ГРЕЗ ЭС-АННОНА
Особенности:
   +1 к спасброскам от заклинаний
   +2 к базовым очкам жизни
Вес: 0

Почему-то рассказ Плакальщиков Эс-Аннона навевает на тебя странную ностальгию, которую ты связываешь с Феллом. Данная татуировка вызывает ностальгию, а также непоколебимость Плакальщиков Эс-Аннона, даруя тебе прибавку к здоровью и выносливости.

С художественной точки зрения, это одна из лучших работ Фелла: хотя татуировка изображает лишь неприукрашенный образ Эс-Аннона, каким его описывали Плакальщики Эс-Аннона, ты почти *ощущаешь* его огромные сверхъестественные скверы и проспекты из света в этом замысловатом символе. Эта татуировка помогает сохранить память о городе и мечты его горожан о том, что его величие никогда не забудут.~
@48832 = ~СЕРЬГИ СЦЕПЛЕННЫХ ЗУБОВ
Особенность: +5% бонуса к умению вскрывать замки
Вес: 0
Используется только ворами

Пожалуй, сама идея того, что Анна станет носить что-либо только в качестве украшения, заставляет тебя отнестись к этим серьгам с подозрительностью.

При более тщательном осмотре ты обнаруживаешь, что на самом деле эти тонкие металлические серьги — набор искусно сделанных отмычек. При необходимости ты можешь отцепить их и использовать для взлома стойких замков. 

^NПРИМЕЧАНИЕ: Эти серьги увеличивают твое умение взлома замков только в том случае, если ты носишь их.^-~
@48833 = ~ТАТУИРОВКА ВОССОЕДИНЕНИЯ
Вызывает: «Друзья»
Вес: 0

Эта татуировка рассказывает, как ты свел вместе Корвуса и Карину. Она позволяет тебе использовать немного их радости от того, что они нашли друг друга, чтобы улучшить твои отношения с окружающими.

После того, как способности татуировки израсходованы, она исчезает.~
@48834 = ~Татуировка погибели Себастиона~
@48835 = ~Татуировка грез Эс-Аннона~
@48836 = ~Серьги сцепленных зубов~
@48837 = ~Татуировка мертвой жизни~
@48838 = ~Свиток благословления~
@48839 = ~Свиток исцеления легких ран~
@48840 = ~Свиток проклятия~
@48841 = ~Свиток обнаружение зла~
@48842 = ~Свиток ореола малого откровения ~
@48843 = ~Свиток защиты от зла~
@48844 = ~Свиток помощи~
@48845 = ~Татуировка могил Эс-Аннона~
@48846 = ~СВИТОК БЛАГОСЛОВЛЕНИЯ
Позволяет наложить заклинание «Благословление»
Уровень: 1/Жрец
Дальность: 180 футов
Длительность: 30 секунд
Скорость: 1
Область действия: круг радиусом в 70 футов
Спасбросок: нет
Вес: 0
Используется только жрецами

Благо для спутников, дарующее силу, в которой они нуждаются.

Благословление дает +1 к попаданию и +1 ко всем спасброскам для всех дружественных существ в радиусе 70 футов от точки наложения.~
@48847 = ~СВИТОК ИСЦЕЛЕНИЯ ЛЕГКИХ РАН
Позволяет наложить заклинание «Исцеление легких ран»
Уровень: 1/Жрец
Дальность: 0
Длительность: постоянная / мгновенно
Скорость: 1
Область действия: существо, к которому прикоснулись
Спасбросок: нет
Вес: 0
Используется только жрецами

Это заклинание закрывает легкие раны на цели.

Заклинатель может наложить заклинание на любого в пределах касания, в 30-футовой области. Исцеление легких ран лечит 8 очков жизни у цели. Восстановленные очки жизни не могут превышать их максимального количества.~
@48848 = ~СВИТОК ПРОКЛЯТИЯ
Позволяет наложить заклинание «Проклятие»
Уровень: 1/Жрец
Дальность: 180 футов
Длительность: 30 секунд
Скорость: 1
Область действия: круг радиусом в 50 футов
Спасбросок: нет
Вес: 0
Используется только жрецами

Погибель для врагов, ослабляющая их.

В отличие от Благословления, Проклятие дает всем вражеским целям в 50-футовом радиусе -1 к атаке и -1 к спасброскам на 30 секунд.~
@48849 = ~СВИТОК ОБНАРУЖЕНИЯ ЗЛА
Позволяет сотворить заклинание «Обнаружить зло»
Уровень: 1/Жрец
Дальность: 0
Длительность: 50 секунд + 25 секунд/уровень (максимум 5 минут)
Скорость: 1
Область действия: колдующий
Спасбросок: нет
Вес: 0
Используется только жрецами

Это заклинание обнаруживает злые намеренья, раскрывая внутреннюю сущность цели.

После сотворения это заклинание определяет любые злые эманации от существ, находящихся в пределах дальности заклинания на 50 секунд + 25 секунд / уровень колдующего. ~
@48850 = ~СВИТОК ОРЕОЛА МАЛОГО ОТКРОВЕНИЯ
Позволяет наложить заклинание «Ореол малого откровения»
Уровень: 1/Жрец
Дальность: 240 футов
Длительность: 20 секунд на уровень
Скорость: 1
Область действия: 10 кв. футов в пределах 40-футового радиуса
Спасбросок: нет
Вес: 0
Используется только жрецами

Очерчивает врагов жреца ореолом света, позволяя легче их видеть и легче в них попадать.

После прочтения заклинания персонажи игрока выбирают любую конечную точку в пределах дальности заклинания для центрирования заклинания. Далее от центра исходит яркий зеленый свет, распространяясь вплоть до 40-футового радиуса. На время действия заклинания все враждебные существа будут окружены светом, который накладывает на всех затронутых существа штраф +2 к Классу Брони. От этого заклинания нет спасброска. Кроме того, заклинание вызывает сияние вокруг невидимых существ.~
@48851 = ~СВИТОК ЗАЩИТЫ ОТ ЗЛА
Позволяет наложить заклинание «Защита от зла»
Уровень: 1/Жрец
Дальность: 0
Длительность: 10 секунд за уровень
Скорость: 1
Область действия: 1 существо
Спасбросок: нет
Вес: 0
Используется только жрецами

Это заклинание окружает заклинателя кольцом защиты, которое помогает защитить его от нападения существ со злыми намереньями.

Это заклинание дает защиту от злых существ в виде магического барьера, который окружает заколдованного. Оно дает штраф -2 к броскам атаки злых существ, и дарует бонус +2 ко всем спасброскам, которые были вызваны подобными злыми атаками, на 10 секунд / уровень заклинателя.~
@48852 = ~СВИТОК ПОМОЩИ
Позволяет наложить заклинание «Помощь»
Уровень: 2/Жрец
Дальность: 0
Длительность: 10 секунд + 10 секунд за уровень
Скорость: 1
Область действия: особая
Спасбросок: нет
Вес: 0
Используется только жрецами

Вселяет отвагу в союзника, даруя ему дополнительную ловкость и способность выдерживать больше урона.

Помощь дарует +1 к попаданию и +1 к спасброскам существа-цели при условии, что объект еще не ввязался в схватку. Также заклинание дает 1-8 дополнительных очков жизни для существа-цели на время действия заклинания; кроме того, заклинание позволяет существу иметь больше очков жизни, чем обычно. Эти очки жизни временные и исчезают, когда заканчивается действие заклинания. Однако, если существо теряет эти очки из-за повреждений, дополнительные очки не теряются по окончанию действия заклинания.~
@48853 = ~СВИТОК ИСЦЕЛЕНИЯ СРЕДНИХ РАН
Позволяет наложить заклинание «Исцеление средних ран»
Уровень: 2/Жрец
Дальность: 0
Длительность: постоянная/мгновенно
Скорость: 2
Область действия: существо, к которому прикоснулись
Спасбросок: нет
Вес: 0
Используется только жрецами

Это заклинание закрывает средние раны.

После создания заклинания появляется наводящий курсор, и игрок может наложить заклинание на любого в пределах досягаемости. Исцеление средних ран лечит у цели 11 очков урона. Восстановленные очки жизни существа не могут превысить его максимум очков жизни.~
@48854 = ~СВИТОК ДУХОВНОГО МОЛОТА
Позволяет создать заклинание «Духовный молот»
Уровень: 2/Жрец
Дальность: 30 футов за уровень
Длительность: переменная (см. ниже)
Скорость: 1
Область действия: 1 цель
Спасбросок: уменьшает эффект вдвое
Вес: 0
Используется только жрецами

Это заклинание вызывает молот из духовной энергии, который сокрушает твоих врагов.

После сотворения заклинание колдующий выбирает цель в пределах дальности заклинания. Молот наносит 4-10 очков сокрушительного урона за каждые три уровня заклинателя, действуя как оружие +1 (+1 к попаданию и +1 к урону), и еще +1 за каждые шесть уровней колдующего, вплоть до максимума +3.~
@48855 = ~СВИТОК ВЫЗОВА МОЛНИИ
Позволяет создать заклинание «Вызов молнии» 
Уровень: 3/Жрец
Дальность: 180 футов
Длительность: мгновенно
Скорость: 3
Область действия: 10-футовый радиус
Спасбросок: уменьшает эффект вдвое
Вес: 0
Используется только жрецами

Это заклинание призывает ярость природы в союзники против твоих врагов.

Колдующий может вызвать один электрический разряд, бросив его на врагов с 2-16 очками электрического урона, плюс 1-8 дополнительных очков за каждый уровень заклинателя. Этот урон наносится любому существу в 10-футовом радиусе от места, куда попал разряд. Область действия — 10-футовый радиус. Спасбросок против заклинаний приводит к половинному урону.~
@48856 = ~ТАТУИРОВКА МОГИЛ ЭС-АННОНА
Особенности:
   +2 к спасброску против магии смерти
   +2 к базовым очкам жизни
Вес: 0

Эта татуировка — наверно, последний кусочек Эс-Аннона, в котором он будет существовать... поскольку Плакальщики Эс-Аннона умирают от старости и болезней, их могилы станут единственным, что осталось от Эс-Аннона. Этот символ вызывает страдания Плакальщиков и использует их как щит от урона, увеличивая твои шансы избежать их участи.~
@48857 = ~Очевидно, эта металлическая плита служит в качестве кровати. Кажется, сбоку у нее есть пластина, которую можно открыть.~
@48858 = ~~
@48859 = ~Открыть ее и заглянуть внутрь.~
@48860 = ~~
@48861 = ~Уйти.~
@48862 = ~Тебе не удастся покопаться в вещах Соэго, пока он рядом. Сперва тебе нужно как-нибудь отвлечь или выманить его отсюда.~
@48863 = ~Уйти.~
@48864 = ~Убедившись, что Соэго нет поблизости, ты открываешь маленькую панель и заглядываешь внутрь. Там есть что-то вроде книги или дневника.~
@48865 = ~Вынуть и почитать.~
@48866 = ~Закрыть панель и уйти.~
@48867 = ~Книга оказывается дневником Соэго. В нем он в деталях описал, как на него напал крысооборотень, как в итоге у него развилась ликантропия, и как он сбежал из Морга после того, как непреднамеренного убил и сожрал своего друга. В поисках укрытия он забрел в Логово Мысли и согласился служить Многоединому, коллективному разуму черепных крыс, которые там собрались. Теперь он живет в Мертвых Народах, шпионя за нежитью для Многоединого, который надеется однажды захватить эту часть катакомб.~
@48868 = ~Положить дневник на место, закрыть панель и уйти.~
@48869 = ~Инвентарь~
@48870 = ~Дневник~
@48871 = ~Карта~
@48872 = ~Заклинания мага~
@48873 = ~Заклинания жреца~
@48874 = ~Параметры~
@48875 = ~Характеристики персонажа~
@48876 = ~Вернуться в игру~
@48877 = ~Центрировать на персонаже~
@48878 = ~Меню действий~
@48879 = ~Меню действий — назад~
@48880 = ~Меню действий — вперед~
@48881 = ~Разное~
@48882 = ~Расположение~
@48883 = ~Быстрое сохранение~
@48884 = ~Действия~
@48885 = ~Атаковать~
@48886 = ~Произнести заклинание~
@48887 = ~Охранять~
@48888 = ~Использовать предмет~
@48889 = ~Диалог~
@48890 = ~Формирования~
@48891 = ~Воровство~
@48892 = ~Скрытность~
@48893 = ~Обнаружение ловушек~
@48894 = ~Стоп~
@48895 = ~Особые навыки~
@48896 = ~Множественный выбор~
@48897 = ~Выбрать 1-2~
@48898 = ~Выбрать 3-4~
@48899 = ~Выбрать 5-6~
@48900 = ~Выбрать 1-3~
@48901 = ~На большой гробнице вырезана короткая надпись.~
@48902 = ~Прочитать надпись.~
@48903 = ~Выбрать 4-6~
@48904 = ~Выбрать всех~
@48905 = ~«Улей, рядом с Ночлежкой».~
@48906 = ~«Улей, рядом с Моргом».~
@48907 = ~«Улей, рядом с рынком».~
@48908 = ~«Улей, рядом с баром Тлеющий труп».~
@48909 = ~«Нижний район».~
@48910 = ~«Чиновничий район».~
@48911 = ~«Катакомбы плачущих камней».~
@48912 = ~«Неважно. Пока что все. Прощай».~
@48913 = ~Перед тобой модрон-инженер. «Приветствуем».~
@48914 = ~«У меня есть несколько вопросов...» ~
@48915 = ~«Неважно. Прощай».~
@48916 = ~«Я... — модрон смущенно умолкает. Комнату наполняет усиленное жужжание, которое быстро стихает. — Мы — модрон. Мы — часть целого. Целое — это модрон. Больше ничего».~
@48917 = ~«Очень интересно. У меня есть другие вопросы...»~
@48918 = ~«Я должен идти. Прощай».~
@48919 = ~Модрон обеспокоенно смотрит на тебя, затем оглядывает комнату. «Ты ошибаешься. Мы — модрон. Мы — единое... Мы не хотим обсуждать это».~
@48920 = ~«Хорошо. Я бы хотел попробовать одно из тех подземелий, о которых ты говорил».~
@48921 = ~«Я знаю, что я слышал. Ты начал говорить *я*, а потом...»~
@48922 = ~«У меня есть несколько вопросов...» ~
@48923 = ~«Я должен идти. Прощай».~
@48924 = ~Модрон хмуро смотрит на тебя. В его голосе угадывается нотка ярости. «Нет. Мы — модрон. Мы — часть единого. Мы не хотим обсуждать это больше». Комнату наполняет сердитое жужжание, которое затем стихает.~
@48925 = ~«Хорошо. Я бы хотел попробовать одно из тех подземелий, о которых ты говорил».~
@48926 = ~«У меня есть несколько вопросов...» ~
@48927 = ~«Я должен идти. Прощай».~
@48928 = ~«Рубикон является великолепным достижением и... — он умолкает на секунду. — Я... Мы... его содержимое».~
@48929 = ~«Ты что-то сказал про аберрации?»~
@48930 = ~«Интересно. Я хотел бы попробовать одно из этих подземелий».~
@48931 = ~«У меня есть несколько вопросов...» ~
@48932 = ~«Я должен идти. Прощай».~
@48933 = ~Ты видишь добротно отделанную шкатулку с огромным красным самоцветом на крышке. Кажется, что от нее несет ужасом.~
@48934 = ~Открыть шкатулку.~
@48935 = ~Отложить шкатулку.~
@48936 = ~Перед тобой хрупкая стеклянная бусина. Если присмотреться, то можно заметить вихрящуюся цветную дымку.~
@48937 = ~Разбить бусину.~
@48938 = ~Отложить бусину.~
@48939 = ~Скелет игнорирует все попытки заговорить с ним.~
@48940 = ~Уйти.~
@48941 = ~Выбрать персонажа 1~
@48942 = ~Выбрать персонажа 2~
@48943 = ~Выбрать персонажа 3~
@48944 = ~Выбрать персонажа 4~
@48945 = ~Выбрать персонажа 5~
@48946 = ~Выбрать персонажа 6~
@48947 = ~Вкл/выкл бег~
@48948 = ~Быстрое оружие 1~
@48949 = ~Быстрое оружие 2~
@48950 = ~Быстрое оружие 3~
@48951 = ~Быстрое оружие 4~
@48952 = ~Быстрый предмет 1~
@48953 = ~Быстрый предмет 2~
@48954 = ~Быстрый предмет 3~
@48955 = ~Быстрый предмет 4~
@48956 = ~Быстрый предмет 5~
@48957 = ~Вкл/выкл ИИ~
@48958 = ~Свиток исцеления средних ран~
@48959 = ~Свиток духовного молота~
@48960 = ~Свиток вызова молнии~
@48961 = ~Свиток хождения по огню~
