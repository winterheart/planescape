@7931 = ~«Кого именно вы оплакиваете?»~
@7932 = ~«Кого именно вы оплакиваете?»~
@7933 = ~«Кого именно вы оплакиваете?»~
@7934 = ~«Кого именно вы оплакиваете?»~
@7935 = ~«Кого именно вы оплакиваете?»~
@7936 = ~«Кого именно вы оплакиваете?»~
@7937 = ~«Неважно. У меня есть другие вопросы...»~
@7938 = ~«Думаю, я выслушал достаточно. Прощай».~
@7939 = ~«Что ты делаешь?»~
@7940 = ~«Почему ваши песнопения изменились?»~
@7941 = ~«Я оплакиваю покойника».~
@7942 = ~«У меня просьба от того, кто потерял другого».~
@7943 = ~«Я хотел бы послушать ваше пение».~
@7944 = ~«Извини за беспокойство. Прощай».~
@7945 = ~Попробовать вспомнить...~
@7946 = ~Попробовать вспомнить...~
@7947 = ~Попробовать вспомнить...~
@7948 = ~Попробовать вспомнить...~
@7949 = ~Стряхнуть воспоминание.~
@7950 = ~Восстановить самообладание.~
@7951 = ~Восстановить самообладание.~
@7952 = ~Снова слушать.~
@7953 = ~Оставить их — пускай себе поют.~
@7954 = ~«У меня есть вопросы к тебе...»~
@7955 = ~Оставить их — пускай себе поют.~
@7956 = ~«У меня есть вопросы к тебе...»~
@7957 = ~Оставить их — пускай себе поют.~
@7958 = ~«У меня есть вопросы к тебе...»~
@7959 = ~Оставить их — пускай себе поют.~
@7960 = ~«У меня есть вопросы к тебе...»~
@7961 = ~Оставить их — пускай себе поют.~
@7962 = ~«Ваше пение изменилось... Я слышу отличия в тоне и ритме».~
@7963 = ~«Ладно, забудь».~
@7964 = ~«У меня есть другие вопросы...»~
@7965 = ~«Может оно и так. Прощай».~
@7966 = ~«Дейонарры? Кажется, я слышал о ней. Тебе известно, как она умерла?»~
@7967 = ~«У меня есть другие вопросы...»~
@7968 = ~«Спасибо. Это все, что я желал узнать».~
@7969 = ~«Я оправился. Кому-то из тех, кого вы оплакивали до меня, помощь нужна больше, чем мне».~
@7970 = ~«У меня есть другие вопросы...»~
@7971 = ~«Спасибо. Это все, что я желал узнать».~
@7972 = ~«Она оправилась. Кому-то из тех, кого вы оплакивали до ее, помощь нужна больше, чем ей».~
@7973 = ~«У меня есть другие вопросы...»~
@7974 = ~«Спасибо. Это все, что я желал узнать».~
@7975 = ~«Э-э... Адан оправился. Кому-то из тех, кого вы оплакивали до его, помощь нужна больше, чем ему».~
@7976 = ~«У меня есть другие вопросы...»~
@7977 = ~«Спасибо. Это все, что я желал узнать».~
@7978 = ~«У меня есть другие вопросы...»~
@7979 = ~Слушать.~
@7980 = ~Уйти.~
@7981 = ~«Нет. Это не вызывает у них никаких эмоций».~
@7982 = ~«Да. Женщина, жена Ангиара, потеряла своего сына. Скорбь повисла на ней тяжелой ношей».~
@7983 = ~Ложь: «Э-э, да... мой друг, э-э... Адан... недавно потерял близкого человека. Он скорбит по умершему».~
@7984 = ~«Да, последняя смерть принесла им много страданий и боли».~
@7985 = ~«Прошу прощения... Я ошибся. Прощай».~
@7986 = ~«Если это возможно — это бы сильно облегчило мою боль».~
@7987 = ~«Нет, в этом нет нужды. Прощай».~
@7988 = ~«У меня есть другие вопросы...»~
@7989 = ~«Хорошо. Это все, что я желал знать».~
@7990 = ~«Если это возможно — это бы сильно облегчило их боль».~
@7991 = ~«Нет, в этом нет нужды. Прощай».~
@7992 = ~«У меня есть вопросы к тебе...»~
@7993 = ~Оставить их — пускай себе поют.~
@7994 = ~«Он оправился. Кому-то из тех, кого вы оплакивали до его, помощь нужна больше, чем ему».~
@7995 = ~«У меня есть другие вопросы...»~
@7996 = ~«Спасибо. Это все, что я желал узнать».~
@7997 = ~«Я понимаю».~
@7998 = ~«Нет. Забудь об этом».~
@7999 = ~«Хорошо. Келлера, у меня есть еще вопросы к тебе...»~
@8000 = ~«Довольно изящная цепь умозаключений. Это так, Келлера?»~
@8001 = ~«Очень интересно. Я запомню это. А пока, Келлера, ответь на другие вопросы».~
@8002 = ~«Довольно изящная цепь умозаключений. Это так, Келлера?»~
@8003 = ~«Очень интересно. Я запомню это. А пока, Келлера, ответь на другие вопросы».~
@8004 = ~У ворот Морга расположилась сгорбленная фигура в капюшоне. Его лицо скрыто тенью от капюшона... все, что ты видишь, — это его небритый подбородок, покрытый какой-то пурпурно-зеленой сыпью. Похоже, больше всего она выражена на шее, а ближе к подбородку она редеет.~
@8005 = ~«Приветствую».~
@8006 = ~Человек даже не шелохнулся... выдержав драматическую паузу, он неожиданно отвечает высоким, тоненьким голосом, который бы больше подошел не мужчине, а девочке лет десяти. «Хай?»~
@8007 = ~«Хай?»~
@8008 = ~«Сифилитик я, хай».~
@8009 = ~«Жду жмуриков, вот что, хай».~
@8010 = ~«Нахожу жмурика, протаскиваю его через ворота, получаю немного звенелок, а потом опять жду, хай».~
@8011 = ~«Жмурики для тленного, что медяки для сборщика: несешь им покойничка, они дают тебе медь на входе, вот и все, хай».~
@8012 = ~«Улицы чистенькие, все жмурики на своих местах, улицы не воняют, покойнички пристроены, остаются за воротами, и все счастливы, хай».~
@8013 = ~«Затаскивают внутрь ворот, кладут на плиты, потрошат их, хоронят или заставляют ходить, хай».~
@8014 = ~«Хай, кое-кого они заставляют вернуться — если жмурик разрешил тленным это делать, — и потом жмурик становится скелетом или зомбаком».~
@8015 = ~«Мама с папой так назвали, пожелали сифилиса первенцу. И проклятье сбылось, еще как, хай». Ты снова невольно бросаешь взгляд на пурпурно-зеленую сыпь на подбородке и шее Сифилитика. ~
@8016 = ~Ты видишь Сифилитика, сгорбленного у ворот Морга. Он... или она... даже не сдвинулся с места с вашей последней встречи.~
@8017 = ~«Дай-ка Сифилитику поглядеть, как ты строишь из себя жмурика. Если выйдет хорошо — Сифилитик затащит тебя внутрь, хай». ~
@8018 = ~Сифилитик беззвучно наблюдает за твоим спектаклем. Когда ты поднимаешься, он говорит: «Тленные тебе не поверят. Всегда проверяют, что жмурик — это жмурик, а если жмурик дышит, то они его не берут. Не пойдет, хай».~
@8019 = ~Сифилитик беззвучно наблюдает за твоим спектаклем. Когда ты поднимаешься, он говорит: «Хай, Сифилитик продаст тебя. Хочешь прямо сейчас?»~
@8020 = ~Вопрос никак не смутил Сифилитика. «Хай, конечно, как в прошлый раз, хай?»~
@8021 = ~«Хай. Много раз ты просил, Сифилитик всегда делал».~
@8022 = ~«Много раз, хай».~
@8023 = ~«Хай».~
@8024 = ~«Ты жмурик, который недолго остается жмуриком, хай. У тебя всегда все по-честному с Сифилитиком, ага».~
@8025 = ~«Ты жмурик, который недолго остается жмуриком, хай. У тебя всегда все по-честному с Сифилитиком, ага».~
@8026 = ~Сифилитик вытаскивает руки из одежды: каждая из его покрытых сыпью рук держит по ржавому кинжалу. Лезвия мгновенно оставляют две линии поперек твоего горла, и свет перед тобой меркнет...~
@8027 = ~«Хай, сборщик. Собирает жмуриков, относит их тленным у ворот в обмен на звенелки».~
@8028 = ~«Хай, никакого ден-вика я не видел. Коли что в Улье пропадет — уже и не сыщешь. Может, так и с ден-виком случилось, хай».~
@8029 = ~«Хай, Фарод. Сборщик, большая шишка, имя на слуху; от него большая тень, хай».~
@8030 = ~«Хай, сборщик. Собирает трупаки, относит их тленным в обмен на звенелки».~
@8031 = ~«Хай, здесь он, в Улье. Где-то здесь, хай».~
@8032 = ~«Хай, где-то в Улье он. Фарод вечно прячется. Найти его непросто, это точно. Да и искать-то не стоит».~
@8033 = ~«Хай, многие его терпеть не могут, другие сборщики даже. Могильник его ненавидит, совсем не любит Фарода, хай».~
@8034 = ~«Хай, Могильник — имя на слуху, громкое, за ним длинная тень. Говорит Сифилитику, что делать, вот так».~
@8035 = ~«Хай, Могильник знает тайны, ага. Знает нычки Фарода, ага. Могильник на площади Старьевщиков, за много кварталов на запад отсюдова, хай. Скажи Могильнику, что тебя прислал Сифилитик, и Могильник поделиться с Сифилитиком медью, хай».~
@8036 = ~«Хай, только жмурики или тленные могут пройти через ворота. Хочешь, Сифилитик опять сделает тебя жмуриком?»~
@8037 = ~Оставить человека в покое.~
@8038 = ~«Кто ты?»~
@8039 = ~Оставить его в покое.~
@8040 = ~«Кто ты?»~
@8041 = ~«Почему у тебя такое имя — Сифилитик?»~
@8042 = ~«Что ты делаешь?»~
@8043 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@8044 = ~«Я потерял дневник... может, он тебе попадался?»~
@8045 = ~«Ты можешь протащить меня в Морг?»~
@8046 = ~«Если я притворюсь мертвым, сможешь меня протащить внутрь?»~
@8047 = ~«Извини за беспокойство. Прощай».~
@8048 = ~«Э... Сифилитик?»~
@8049 = ~«Что ты делаешь?»~
@8050 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@8051 = ~«Я потерял дневник... может, он тебе попадался?»~
@8052 = ~«Извини за беспокойство. Прощай».~
@8053 = ~«Жмуриков? То есть трупов? Зачем?»~
@8054 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8055 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8056 = ~«Через ворота? Для чего?»~
@8057 = ~«Главные ворота — единственный способ попасть в Морг?»~
@8058 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8059 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8060 = ~«А почему тленные платят за мертвецов?»~
@8061 = ~«Сборщик? Что это значит?»~
@8062 = ~«Главные ворота — единственный способ попасть в Морг?»~
@8063 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8064 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8065 = ~«А что тленные *делают* с трупами, которыми покупают?»~
@8066 = ~«Главные ворота — единственный способ попасть в Морг?»~
@8067 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8068 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8069 = ~«Заставляют ходить?»~
@8070 = ~«Главные ворота — единственный способ попасть в Морг?»~
@8071 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8072 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8073 = ~«Главные ворота — единственный способ попасть в Морг?»~
@8074 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8075 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8076 = ~«Ой... У меня есть еще вопросы к тебе...»~
@8077 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8078 = ~«Сифилитик, у меня есть еще вопросы к тебе...»~
@8079 = ~Оставить Сифилитика в покое.~
@8080 = ~Притвориться мертвым...~
@8081 = ~Притвориться мертвым...~
@8082 = ~Притвориться мертвым...~
@8083 = ~Притвориться мертвым...~
@8084 = ~Притвориться мертвым...~
@8085 = ~«Не сейчас. У меня есть несколько вопросов...»~
@8086 = ~«Неважно, может быть, в следующий раз. Прощай».~
@8087 = ~«Погоди, а если я буду взаправду мертвым? Ты сможешь взять и продать мое тело?»~
@8088 = ~«Это проблема. Слушай, у меня еще есть вопросы...»~
@8089 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8090 = ~«Да».~
@8091 = ~«Да».~
@8092 = ~~
@8093 = ~~
@8094 = ~«Нет, пока нет. Сперва у меня есть другие вопросы».~
@8095 = ~«Может, в другой раз, спасибо. Прощай».~
@8096 = ~«Да».~
@8097 = ~«Э... 'прошлый раз'?»~
@8098 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8099 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8100 = ~«Э... сколько раз, точнее?»~
@8101 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8102 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8103 = ~«Ого... так мы уже встречались?»~
@8104 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8105 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8106 = ~«Ты что-нибудь обо мне знаешь?»~
@8107 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8108 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8109 = ~«А еще что-нибудь ты обо мне знаешь?»~
@8110 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8111 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8112 = ~«Э... а кроме этого, ты еще что-нибудь знаешь?»~
@8113 = ~«Тогда убей меня. Мне нужно попасть в Морг».~
@8114 = ~«Э, тогда ладно. Как насчет того, чтобы я притворился мертвым, а ты протащил меня внутрь?»~
@8115 = ~«Хм-м. Слушай, у меня есть несколько вопросов...»~
@8116 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8117 = ~Упасть в темноту...~
@8118 = ~Упасть в темноту...~
@8119 = ~«Зачем тленным мертвые люди... то есть, жмурики?»~
@8120 = ~«Главные ворота — единственный способ попасть в Морг?»~
@8121 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8122 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8123 = ~«Понятно. Слушай, у меня есть несколько вопросов...»~
@8124 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8125 = ~«Сборщик?»~
@8126 = ~«Ты знаешь, где его можно найти?»~
@8127 = ~«У меня есть другие вопросы...»~
@8128 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8129 = ~«Ты знаешь, где его можно найти?»~
@8130 = ~«О, у меня есть другие вопросы...»~
@8131 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8132 = ~«А поточнее?»~
@8133 = ~«У меня есть другие вопросы...»~
@8134 = ~«Тогда я попробую его выследить его. Прощай».~
@8135 = ~«'Искать не стоит'? Что ты имеешь в виду?»~
@8136 = ~«У меня есть другие вопросы...»~
@8137 = ~«Тогда я сам его найду, спасибо. Прощай».~
@8138 = ~«Могильник?»~
@8139 = ~«У меня есть другие вопросы...»~
@8140 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8141 = ~«А твой босс... этот Могильник... знает, где находится Фарод?»~
@8142 = ~«А твой босс... этот Могильник... знает, где находится Фарод?»~
@8143 = ~«Хм-м. У меня есть другие вопросы...»~
@8144 = ~«Это все, что я хотел узнать, спасибо. Прощай».~
@8145 = ~«У меня есть другие вопросы...»~
@8146 = ~«Площадь Старьевщиков, на запад отсюда? Хорошо, тогда пойду найду этого Могильника».~
@8147 = ~«Э... опять?»~
@8148 = ~«Да, сделай меня мертвецом. Мне нужно попасть в Морг».~
@8149 = ~«Может, мне лучше притвориться мертвым? Сможешь меня таким способом протащить внутрь?»~
@8150 = ~«Нет, нет... У меня есть другие вопросы...»~
@8151 = ~«Может, в другой раз, спасибо. Прощай».~
@8152 = ~«Пойду, еще раз поищу того пня».~
@8153 = ~«Пф!»~
@8154 = ~«Где вы все?»~
@8155 = ~«Может быть, здесь?»~
@8156 = ~«Тьфу! Пусто, хоть шаром покати!»~
@8157 = ~«Тьфу! Если так пойдет, придется прирезать какого-нибудь пня!»~
@8158 = ~«И куда провалились все мертвецы?!»~
@8159 = ~«Может быть, жмурики лежат здесь?»~
@8160 = ~«Что, в этом городе больше никто *не умирает*?»~
@8161 = ~«Жмурики?»~
@8162 = ~«Да где же вы, проклятые жмурики?!»~
@8163 = ~«Жмурики? Где вы?»~
@8164 = ~«Эй? Жмурики?»~
@8165 = ~«Жмурики? Давайте, выходите!»~
@8166 = ~«Мэри, милая моя, не видала поблизости жмуриков?»~
@8167 = ~«Может, Мэри что-нибудь подскажет».~
@8168 = ~«Пф. Нет ничего».~
@8169 = ~«Шари? Дорогуша? Не видала жмуриков поблизости?»~
@8170 = ~«А! Может, Шари знает?»~
@8171 = ~«Ну хорошо...»~
@8172 = ~«Рози, красавица моя, тебе жмурики не попадались?»~
@8173 = ~«Эй, Рози!»~
@8174 = ~«А! Рози может знать!»~
@8175 = ~«Где же... Где...»~
@8176 = ~«Пф! Нахальная девка!»~
@8177 = ~«Нэн, любовь моя, я ищу жмуриков... любого жмурика».~
@8178 = ~«А! Может, Нан знает что-нибудь!»~
@8179 = ~«И куда теперь?..»~
@8180 = ~«Может быть, вот это *третий* поворот налево?»~
@8181 = ~«Нет-нет... совсем не похоже».~
@8182 = ~«Пф. Ну ладно, девчонка».~
@8183 = ~«А вот я не плачу тебе срезанными медяками».~
@8184 = ~«Срезанными медяками?! Мои медяки так же хороши, как этот бедолага!»~
@8185 = ~«Кажется, я совсем заблудился...»~
@8186 = ~«Все эти улицы на одно лицо...»~
@8187 = ~Исход души~
@8188 = ~Печень Захарии~
@8189 = ~Сердце Захарии~
@8190 = ~Выбор персонажа~
@8191 = ~Диалог~
@8192 = ~Выбрать оружие~
@8193 = ~Выбрать заклинание~
@8194 = ~Выбрать предмет~
@8195 = ~Выбрать особый навык~
@8196 = ~Кнопка действия~
@8197 = ~Повернуть предметы влево~
@8198 = ~Повернуть предметы вправо~
@8199 = ~Якорь меню (чтобы передвинуть меню, нажми и удерживай кнопку мыши)~
@8200 = ~дн.~
@8201 = ~Тленная, скорее всего, услышала тебя, но вида не подала.~
@8202 = ~Все тленные поют в одном тоне и ритме. Напев каждые несколько минут переходит в крик, после чего медленно стихает, подобно эху. Когда и оно стихает, тленные произносят несколько строк во славу «Истинной Смерти», после чего продолжают петь.~
@8203 = ~Тленная поднимает голову. Она не перестает петь в том же темпе и тоне, что и другие тленные вокруг нее.~
@8204 = ~Тленная не обращает на тебя внимания — вместо этого она кивает и продолжает петь.~
@8205 = ~Плакальщица внезапно останавливается и рассматривает тебя. «Скорбишь ли ты по усопшему?»~
@8206 = ~«Мы будем оплакивать твою боль и боль ее отца, если это не причинит никому обиду».~
@8207 = ~«Мы будем оплакивать твою боль, если таково твое желание».~
@8208 = ~«Мы будем оплакивать твою боль, если таково твое желание».~
@8209 = ~«Мы будем оплакивать ее боль, если это не причинит ей обиду».~
@8210 = ~«Мы будем оплакивать его боль, если это не причинит ему обиду».~
@8211 = ~Тленная кивает и возвращается к пению.~
@8212 = ~Тленная кивает головой и возвращается к пению.~
@8213 = ~«Мы оплакиваем».~
@8214 = ~«Мы оплакиваем не мертвых. Мы оплакиваем живых».~
@8215 = ~«Мы оплакиваем живых, испытывающих боль утраты».~
@8216 = ~«Уход души к Истинной Смерти часто оставляет ощущение беспокойства. Когда уходит любимый, утрату часто сопровождают скорбь и чувство потери».~
@8217 = ~«Скорбь и чувство утраты — сильные эмоции. Подобные эмоции привязывают живущего к этому существованию, не позволяя ему достичь Истинной Смерти в тот момент, когда смерть приходит к нему. Мы оплакиваем живых, поглощенных подобными эмоциями».~
@8218 = ~«Иногда ее называют последней смертью. Истинная Смерть — это освобождение от серого, полного боли существования. Это освобождение от эмоций, от разума, от этих оболочек».~
@8219 = ~Тленная кивает. «Некоторые это так и называют. Но это не совсем точно».~
@8220 = ~Тленная ждет.~
@8221 = ~Все тленные поют в одном тоне и ритме. В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев повторяется словно волна, накатывающая на береговую линию. С этой мыслью в тебе пробуждается воспоминание...~
@8222 = ~Твое воспоминание смутно: ты стоишь на далеком берегу... где-то в другом месте, далеко отсюда. Рядом с тобой — женщина. Она стоит слева от тебя, как раз за пределами твоего периферийного зрения, поэтому ты не можешь ее различить. При попытке освежить воспоминание оно ускользает...~
@8223 = ~...и ты снова стоишь рядом с тленными-плакальщиками. Их пение теперь едва слышно. Они останавливаются, произносят несколько строк во славу «Истинной Смерти», затем снова начинают петь.~
@8224 = ~Все тленные поют в одном тоне и ритме. В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев по тону намного выше, и напоминает свист летящей стрелы или ветер, гуляющий по каньону. Он начинается и заканчивается быстро: после того как тленные умолкают, они произносят несколько строк во славу «Истинной Смерти», а затем начинают петь снова.~
@8225 = ~Все тленные поют в одном тоне и ритме. В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, в этом напеве есть некая энергетика и случайность: он непредсказуем, и его высота меняется, едва он проходит через их губы. И сколько бы не менялся напев, все тленные попадают в такт. Как только песнопение, наконец, становится едва слышным, тленные произносят несколько строк во славу «Истинной Смерти», а затем начинают петь снова.~
@8226 = ~В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев состоит из одной единственной ноты, звучащей несколько минут... он напоминает тебе звон большого колокола. После этого тленные некоторое время молчат, затем произносят несколько строк во славу «Истинной Смерти» и продолжают петь.~
@8227 = ~В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев намного нежнее: иногда он звучит настолько тихо, что сливается с шумом улиц. Тленные на несколько минут полностью умолкают, потом произносят несколько строк во славу «Истинной Смерти» и продолжают петь.~
@8228 = ~Тленная изумленно смотрит на тебя. «Наше пение не поменялось. Мы продолжаем один и тот же напев с того момента, как начали петь».~
@8229 = ~Тленная качает головой. «Возможно, это ты изменился».~
@8230 = ~«Я оплакиваю Яниса. Его ранила потеря его первой и единственной дочери Дейонарры».~
@8231 = ~«Мы оплакиваем твою скорбь по усопшим».~
@8232 = ~«Мы оплакиваем жену Ангиара, которая скорбит по усопшему».~
@8233 = ~«Мы оплакиваем Адана, который скорбит по усопшему».~
@8234 = ~Тленная кивает и возвращается к пению.~
@8235 = ~Плакальщица внезапно останавливается и рассматривает тебя. «Скорбит ли тот, о ком ты говоришь, по усопшему?»~
@8236 = ~«Мы будем оплакивать твою боль, если таково твое желание».~
@8237 = ~«Подробности ее смерти мне неизвестны».~
@8238 = ~«Мы будем оплакивать их боль, если это не причинит им обиду».~
@8239 = ~В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, различить этот напев намного сложнее. Слушая его, ты вдруг понимаешь, что звучит он как-то по-странному приглушенно, как будто сам воздух поглощает его. Песнопение тленных стихает спустя несколько минут. Они произносят несколько строк во славу «Истинной Смерти», затем продолжают петь.~
@8240 = ~«Мы оплакиваем упомянутого тобой, который скорбит по усопшему».~
@8241 = ~Уйти.~
@8242 = ~«Я хотел бы немного поговорить с тобой».~
@8243 = ~Слушать их пение.~
@8244 = ~Слушать их пение.~
@8245 = ~Слушать их пение.~
@8246 = ~Слушать их пение.~
@8247 = ~Слушать их пение.~
@8248 = ~Слушать их пение.~
@8249 = ~Слушать их пение.~
@8250 = ~Уйти.~
@8251 = ~«Приветствую».~
@8252 = ~Оставить их — пускай себе поют.~
@8253 = ~«Что ты делаешь?»~
@8254 = ~«Я оплакиваю покойника».~
@8255 = ~«Я здесь ради того, кто потерял другого».~
@8256 = ~«Извини за беспокойство. Прощай».~
@8257 = ~«Я хотел бы поговорить с тобой».~
@8258 = ~Слушать их пение.~
@8259 = ~Слушать их пение.~
@8260 = ~Слушать их пение.~
@8261 = ~Слушать их пение.~
@8262 = ~Слушать их пение.~
@8263 = ~Слушать их пение.~
@8264 = ~Слушать их пение.~
@8265 = ~Оставить ее в покое.~
@8266 = ~«Нет. Смерть не тревожит мои чувства».~
@8267 = ~Правда: «Да... Мне кажется, что я в ответе за смерть невинной женщины, Дейонарры. Меня не дает покоя не только это: я чувствую вину за то горе, которое причинил ее отцу».~
@8268 = ~Правда: «Да... Я в ответе за смерть невинного мужчины, Захарии. Его смерть не дает мне покоя».~
@8269 = ~Правда: «Да... Я в ответе за смерть множества невинных на многих планах. Я едва выношу страдания, причиняемые осознанием этого факта».~
@8270 = ~«Не я. Есть женщина, жена Ангиара, которая потеряла своего сына. Скорбь повисла на ней тяжелой ношей».~
@8271 = ~Ложь: «Нет, э-э, я говорю о своем друге, э-э... Адане: он скорбит по умершему».~
@8272 = ~«Да, последняя смерть принесла мне много страданий и боли».~
@8273 = ~«Прошу прощения... Я оговорился. Прощай».~
@8274 = ~«Если это возможно — это бы сильно облегчило мою боль и боль ее отца».~
@8275 = ~«Нет, в этом нет нужды. Прощай».~
@8276 = ~«Если это возможно — это бы сильно облегчило мою боль».~
@8277 = ~«Нет, в этом нет нужды. Прощай».~
@8278 = ~«Если это возможно — это бы сильно облегчило мою боль».~
@8279 = ~«Нет, в этом нет нужды. Прощай».~
@8280 = ~«Если это возможно — это бы сильно облегчило ее боль».~
@8281 = ~«Нет, в этом нет нужды. Прощай».~
@8282 = ~«Если это возможно — это бы сильно облегчило его боль».~
@8283 = ~«Нет, в этом нет нужды. Прощай».~
@8284 = ~Слушать их пение.~
@8285 = ~Слушать их пение.~
