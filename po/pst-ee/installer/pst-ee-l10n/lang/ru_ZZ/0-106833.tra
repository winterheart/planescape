@2240 = ~~
@2241 = ~Хватит врать!~
@2242 = ~~
@2243 = ~~
@2244 = ~~
@2245 = ~~
@2246 = ~Ложь: «Она живет к юго-востоку от Морга, неподалеку от одного из мавзолеев».~
@2247 = ~«Прошу прощения, ты сказал 'тетя Маргарита'? Я тебя неправильно понял и подумал о другой».~
@2248 = ~«Ой, подожди. Я думал, что ты спрашивал о ближайших борделях. Неважно».~
@2249 = ~Человек трясет головой. «О, нет-нет... она не *настолько* близка к нему. Возможно, вы подумали о ком-то другом». Человек оглядывается, затем снова обращается к тебе. «Я поищу еще кого-нибудь, кто может знать. Благодарю за уделенное время, уважаемый господин».~
@2250 = ~«Прощай».~
@2251 = ~«Прощай».~
@2252 = ~«Прощай».~
@2253 = ~«Прощай».~
@2254 = ~«Прощай».~
@2255 = ~Человек разочарованно хмурится. «Ах, было бы слишком большой удачей надеяться на то, что вам известно это место, — он слегка кивает в знак благодарности. — Что ж, благодарю вас за уделенное время, уважаемый господин, вы были самым приветливым на этих улицах».~
@2256 = ~«Прощай».~
@2257 = ~«Прощай».~
@2258 = ~«Прощай».~
@2259 = ~«Прощай».~
@2260 = ~«Прощай».~
@2261 = ~«Несложно было ошибиться, господин. Тем не менее, благодарю за уделенное время».~
@2262 = ~«Прощай».~
@2263 = ~«Прощай».~
@2264 = ~«Прощай».~
@2265 = ~«Прощай».~
@2266 = ~«Прощай».~
@2267 = ~Мужчина моргает от неожиданности. «Э-э, нет-нет, — он натянуто улыбается. — Моя тетя не вовлечена в подобные занятия».~
@2268 = ~«Это не то, что *я* слышал».~
@2269 = ~«Прощай».~
@2270 = ~«Прощай».~
@2271 = ~«Прощай».~
@2272 = ~«Прощай».~
@2273 = ~«Прощай».~
@2274 = ~Мужчина выглядит смущенным. «Я... лучше покину вас, уважаемый господин».~
@2275 = ~«Передавай от меня привет своей тете. Скажи ей, что я скоро вернусь».~
@2276 = ~Этот мужчина медленно поворачивается, когда ты подходишь ближе. Его глаза — словно два уголька; они быстро пробегают по тебе, затем встречаются с твоими глазами. Хотя он и похож на человека, но у него кожа желтоватого оттенка и худощавое лицо. У него щуплое угловатое телосложение; его конечности выглядят так, будто они сделаны из одних лишь жил, натянутых на кости. Его одежда — причудливая смесь пестрых цветов и глухих оттенков грязно-коричневого.~
@2277 = ~Он делает секундную паузу, изучая тебя, затем отвечает на ломанном всеобщем: «Ты мне *известен*». Его трудно понять из-за акцента: он будто берет каждое слово, выплевывает его, а потом еще и протягивает каждую гласную. Ударение, которое он ставит на слово *известен*, кажется тебе странным. «Я выслушаю тебя».~
@2278 = ~«Твое имя мне *известно*. Твои деяния мне *известны*. Твоя суть стала *известной* благодаря твоим поступкам. Ты *известен* как друг Народа, — его глаза снова пробегают по тебе, словно заново оценивая. — Я выслушаю тебя».~
@2279 = ~«Твое имя мне *известно*. Ты напоил землю кровью гитьянки. Твоя суть стала *известной* благодаря твоим поступкам. Ты *известен* как друг Народа, — его глаза снова пробегают по тебе, словно заново оценивая. — Я выслушаю тебя».~
@2280 = ~«Твое имя мне *известно*. Ты помог одной из Народа, которая отравилась ядами этого города. Твоя суть стала *известной* благодаря этому поступку. Ты *известен* как друг Народа, — его глаза снова пробегают по тебе, словно заново оценивая. — Я выслушаю тебя».~
@2281 = ~Мужчина продолжает молчать. Он не отвечает на твое приветствие, просто смотрит на тебя пристальным взглядом.~
@2282 = ~На миг кажется, будто гит тебя не расслышал. Потом раздается свист стали, и в руках гита появляется клинок. Шипя, он бросается на тебя!~
@2283 = ~Гит продолжает молчать, хотя его черные глаза все еще прикованы к тебе.~
@2284 = ~Он делает секундную паузу, изучая тебя, затем отвечает на ломанном всеобщем: «Ты *неизвестен* мне». Его трудно понять из-за акцента: он будто берет каждое слово, выплевывает его, а потом еще и протягивает каждую гласную. Ударение, которое он ставит на слово *неизвестен*, кажется тебе странным. «Чего ты хочешь?»~
@2285 = ~«Я не стану тебя слушать». Он, похоже, собирается пройти мимо тебя.~
@2286 = ~Он останавливается, и ваши взгляды вновь встречаются. Прежде чем ты успеваешь что-то сказать, раздается свист стали, и в его руке внезапно появляется клинок. «Посторонись».~
@2287 = ~Выражение его лица не меняется. «Посторонись».~
@2288 = ~Шипя, он бросается на тебя!~
@2289 = ~Пустой узел.~
@2290 = ~«Катцнии-у-ворот».~
@2291 = ~Катцнии-у-ворот: «Спроси, и ответишь и на мой вопрос, и свой».

*(Катцнии была гитцерайской паломницей, которая бродила по родному плану гитцераев, Лимбо, и «проверяла» знания своего народа. Она подходила к воротам каждого гитцерайского города и задавала ряд вопросов. Ответы горожан позволяли ей познать сущность гитцераев, живших за стенами. Однако Катцнии не подозревала, что вопросы, которые она задавала, позволяли гитцераям также познать ее сущность.)*~
@2292 = ~Гит делает паузу, затем произносит: «Задавай свои вопросы. Я выслушаю тебя».~
@2293 = ~Ты видишь женщину, одетую в выцветшие, заплатанные лохмотья. При твоем приближении она бросает на тебя быстрый взгляд, но затем быстро отворачивается, не желая встречаться с тобой взглядом.~
@2294 = ~«Приветствую».~
@2295 = ~Игнорировать ее.~
@2296 = ~Женщина снова бросает на тебя быстрый взгляд, одаривая тебя ледяными взором, а затем отворачивается. ~
@2297 = ~«Э-э... мисс?»~
@2298 = ~Игнорировать ее.~
@2299 = ~Она поворачивается... но на этот раз в ее руке ты видишь кинжал. «Оставь меня в покое, собака, или я запихаю это в тебя так глубоко, что никто его больше не найдет!»~
@2300 = ~«Убери это... Я просто хочу задать тебе пару вопросов».~
@2301 = ~Оставить ее в покое.~
@2302 = ~Она делает полукруг над своим сердцем свободной рукой, пытаясь оберечься от зла. «Мне нечего сказать тебя! Исчезни!» ~
@2303 = ~Атаковать ее.~
@2304 = ~Уйти.~
@2305 = ~Перед тобой мрачная бледная женщина в черной мантии. Она смотрит в никуда и не замечает твоего присутствия.~
@2306 = ~«Приветствую».~
@2307 = ~Оставить ее в покое.~
@2308 = ~Перед тобой мрачная бледная тленная в черной мантии. Она смотрит в никуда и не замечает твоего присутствия.~
@2309 = ~Она медленно поворачивает к тебе лицо. «Да?»~
@2310 = ~Она прячет свои руки в одеждах и ждет.~
@2311 = ~Она мотает головой.~
@2312 = ~Она мотает головой.~
@2313 = ~«Приветствую».~
@2314 = ~Оставить ее в покое.~
@2315 = ~«У меня есть несколько вопросов...» ~
@2316 = ~«Ничего, неважно».~
@2317 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@2318 = ~«Я ищу потерявшийся дневник. Тебе он не попадался?»~
@2319 = ~«Ничего, неважно».~
@2320 = ~«Я ищу потерявшийся дневник. Тебе он не попадался?»~
@2321 = ~«Все равно спасибо. Прощай».~
@2322 = ~«Ты не знаешь, где я могу найти человека по имени Фарод?»~
@2323 = ~«Все равно спасибо. Прощай».~
@2324 = ~Перед тобой хмурый бледный мужчина в черной мантии. Он тебя не замечает.~
@2325 = ~Перед тобой хмурый бледный тленный в черной мантии. Он тебя не замечает.~
@2326 = ~Он медленно поворачивает к тебе лицо. «Да?»~
@2327 = ~Он прячет свои руки в одеждах и ждет.~
@2328 = ~Он мотает головой.~
@2329 = ~Он мотает головой.~
@2330 = ~«Приветствую».~
@2331 = ~Оставить его в покое.~
@2332 = ~«Приветствую».~
@2333 = ~Оставить его в покое.~
@2334 = ~«У меня есть пара вопросов...» ~
@2335 = ~«Ничего, неважно».~
@2336 = ~«Ты не знаешь, где я могу найти человека по имени Фарод?»~
@2337 = ~«Я ищу потерявшийся дневник. Тебе он не попадался?»~
@2338 = ~«Ничего, неважно».~
@2339 = ~«Я ищу потерявшийся дневник. Тебе он не попадался?»~
@2340 = ~«Все равно спасибо. Прощай».~
@2341 = ~«Ты не знаешь, где я могу найти человека по имени Фарод?»~
@2342 = ~«Все равно спасибо. Прощай».~
@2343 = ~Житель Улья~
@2344 = ~«Такой мне *неизвестен*».~
@2345 = ~«Этот предмет мне *неизвестен*».~
@2346 = ~«Тонущая Ачали».~
@2347 = ~Тонущая Ачали: в основном, это «вопрос, ответ на который бесполезен». Обычно это просьба уточнить нечеткий и «бестолковый» вопрос.

*(Гитцераи живут на внешнем плане Лимбо, плане хаоса. Стабильность может быть достигнута только с помощью разума, придающего форму материи хаоса; для этого нужны сосредоточенность и дисциплинированность. Ачали — мифическая глупая гитцерайка, потерявшаяся в Лимбо; она была способна лишь на то, чтобы образовать вокруг себя островок. Дрейфуя в материи хаоса, она встретила путешественника по планам, который предложил ей помощь. Однако Ачали задала так много бессмысленных и расплывчатых вопросов, что островок вещества вокруг нее растворился, и она утонула в Лимбо.)*~
@2348 = ~«Бросай это дело, шеф. Говорить с гитом — все равно что из остролистника варенье делать. Пойдем».~
@2349 = ~«Ага, 'гит'...» Морт оглядывается на гита, который все еще смотрит на тебя. «Поговорим об этом в другой раз».~
@2350 = ~«Приветствую».~
@2351 = ~«Приветствую».~
@2352 = ~«Приветствую».~
@2353 = ~Оставить его в покое.~
@2354 = ~«Не стоит утруждать себя пустыми разговорами со старым Незнание-это-Счастье. Пошли отсюда, шеф».~
@2355 = ~«'Я... 'известен' тебе? Ты знаешь, кто я?»~
@2356 = ~«'Я... 'известен' тебе? Ты знаешь, кто я?»~
@2357 = ~«'Я... 'известен' тебе? Ты знаешь, кто я?»~
@2358 = ~«Понятно... Слушай, у меня тут несколько вопросов...»~
@2359 = ~«Рубака, я бы на твоем месте оставила его: без толку тратить слова на гита, который не идет на разговор, сечешь? Пошли».~
@2360 = ~«Ага, гит». Похоже, она не хочет обсуждать это, пока гит смотрит на вас обоих. «Давай-ка сваливать отсюда, лады?»~
@2361 = ~«Мне нечего у тебя спросить. Прощай».~
@2362 = ~«Хорошо. У меня есть другие вопросы...»~
@2363 = ~Оставить гита в покое.~
@2364 = ~«Хорошо. У меня есть другие вопросы...»~
@2365 = ~«Не бери в голову... просто идем отсюда, лады?»~
@2366 = ~Оставить гита в покое.~
@2367 = ~«Хорошо. У меня есть другие вопросы...»~
@2368 = ~Оставить гита в покое.~
@2369 = ~«Ты гитьянки, верно? У меня к тебе несколько вопросов...»~
@2370 = ~«Твой вопрос — удар вслепую. Стрела без направления, — его лоб хмурится. — Ответ на этот вопрос озадачил бы и Вождя. Нет времени на такие ответы. Скажи мне прямо, что ты хочешь *знать*».~
@2371 = ~Гит делает паузу, затем произносит: «Задавай свои вопросы. Я выслушаю тебя».~
@2372 = ~«Говорят, что она — королева этого города. Ее разум *неизвестен* мне».~
@2373 = ~«Они те, кто разделяет между собой этот город». Когда он произносит это, его голос меняется: в нем появляются нотки отвращения.~
@2374 = ~«В разделении нет силы. Разделенный город падет».~
@2375 = ~«Этот город ведет во все места».~
@2376 = ~«Этот город — клетка с множеством дверей. Каждая дверь ведет в другое место».~
@2377 = ~«Любое строение с закрытыми дверями является клеткой».~
@2378 = ~«Каждая дверь этой клетки заперта. У каждой двери есть собственный ключ. Только так ты можешь пройти».~
@2379 = ~«Везде. Их столько же, сколько и мест, куда они ведут».~
@2380 = ~«Это трудно понять. Это нетрудно принять».~
@2381 = ~«Двери этой клетки ведут куда угодно. На любой план. В любой мир».~
@2382 = ~«Ты *неизвестен* мне. То, что интересует тебя, меня может вовсе не интересовать».~
@2383 = ~«Работы здесь немного. Можно ловить крыс за награду. Можно собирать мертвецов».~
@2384 = ~«Город платит за крысиные хвосты. Неси их в одно из Управлений по борьбе с вредителями».~
@2385 = ~«Многие умирают в этом городе каждую ночь. Тащи мертвецов Людям Тлена. Они заплатят за тела».~
@2386 = ~«Люди Тлена заботятся о мертвых. Они проводят последний обряд над каждым трупом».~
@2387 = ~«Многие умирают. Люди Тлена не могут собрать их всех сами. Они не хотят, чтобы мертвецы оставались на улицах. Они платят другим за то, что те приносят им мертвых».~
@2388 = ~«Он идет с тобой, — его лоб хмурится. — Как получилось, что он *неизвестен* тебе?»~
@2389 = ~«Он не немой. Если хочешь *узнать* его — расспроси его. Не оскорбляй нас обоих, относясь к одному из нас как к статуе».~
@2390 = ~«Это имя *известно* мне. Даккон — *зерт*, не принадлежащий к Народу».~
@2391 = ~«Тот, кто *знает* слова Зертимона. *Познавая* его слова, он *познает* себя».~
@2392 = ~«Зертимон *познал* гитцераев, прежде чем они познали себя». Гитцерай на миг умолкает, словно в благоговении, потом продолжает: «Он определил наш Народ. Он дал нам единый разум. Тех, кто *знает* его слова, зовут *зертами*».~
@2393 = ~«Даккон — *зерт*...» Гитцерай кажется растерянным. Он на секунду умолкает, как бы пытаясь подобрать верные слова.~
@2394 = ~«Даккон — *зерт*, по слухам, *не знающий* слов Зертимона. Говорят, его разум рассеян. Говорят, что он *не знает* себя. Такие вещи — словно яд для гитцерая. Если эти слова правдивы, то он не принадлежит к Народу».~
@2395 = ~Финеас Т. Лорт XXXIX~
@2396 = ~Служащий Сигила~
@2397 = ~Ты видишь коренастого мужчину с сыпью и прыщами на лице. Одежда *указывает* на то, что он является представителем власти, однако она очень грязная, мятая и покрыта крысиной шерстью. Ты видишь, как он лениво почесывает себя короткими пальцами.~
@2398 = ~«Приветствую».~
@2399 = ~~
@2400 = ~Оставить мужчину в покое, осмотреть все вокруг.~
@2401 = ~«У меня есть несколько вопросов...» ~
@2402 = ~«Аййй!» — коротышка вскрикивает и испуганно подпрыгивает. Схватившись за сердце, он глубоко вздыхает и надевает очки на свой прыщавый нос. «Да-да? Чем могу служить... — он чешет свой нос, внимательно осматривая твои шрамы. — Я... э... у меня почти ничего нет, так что если ты решил ограбить это здание, то ты ошибся с местом».~
@2403 = ~«Я не собираюсь 'грабить здание'. Ты кто такой?»~
@2404 = ~«Значит, 'почти ничего нет'? Что ж, просто отдай, что у тебя *есть*, и останемся друзьями».~
@2405 = ~«Прощай».~
@2406 = ~«Айййй! О, силы... хватит ко мне так *подкрадываться*! — он надевает свои очки на нос и окидывает тебя тяжелым взглядом. — Чем могу быть полезен на *этот* раз, м-м-м?»~
@2407 = ~«Я? Я уважаемый Финеас Т. Лорт Тридцать девятый, управляющий в Улье этим филиалом Управления по борьбе с вредителями и заболеваниями. Считаю своей почетной обязанностью... — он чешет грудь и вздыхает, — проинформировать тебя, что мы, в бюрократическом смысле слова *мы*, включающем в себя всю бюрократическую систему Сигила, выплачиваем награду за любых вредителей и бездомных животных, способных заразить, — он чешется снова, — улицы славного Сигила, сердца мультивселенной, города, находящемся в центре всего сущего, города, на который *равняются* все остальные города».~
@2408 = ~«Награду?»~
@2409 = ~«Понятно. Думаю, я выслушал достаточно. Прощай».~
@2410 = ~«Да-да... мы, в бюрократическом смысле слова *мы*, включающем в себя всю бюрократическую систему Сигила, принимаем доказательства уничтожения мозгогрызунов, также известных как черепные крысы, которые несколько лет назад, если верить подсчетам популяции вредителей, довольно густо населяли район Улья. Я уполномочен бюрократической системой Сигила выплачивать награду в размере, — он выразительно вздыхает, — одного медяка за каждую черепную крысу, доставленную в мой филиал».~
@2411 = ~«'Черепную крысу'?»~
@2412 = ~«У меня нет крыс, но у меня есть крысиные хвосты».~
@2413 = ~«Понятно. Что ж, мне лучше пойти... прощай».~
@2414 = ~«Черепные крысы — это вид вредителей, которые становятся более умными при тесной близости со своими сородичами. Сама по себе черепная крыса — не больше чем досадная неприятность, снующая под полом и ворующая еду, однако если взять пять, десять или больше крыс, то их интеллект растет, становясь подобным нашему, — он чешется, презрительно усмехаясь. — Возможно, что две или три черепные крысы могли бы перехитрить *тебя*, сэр».~
@2415 = ~«Еще один такой комментарий, и я тебе тебе задницу на голову надену вместо шляпы».~
@2416 = ~«Сколько черепных крыс в Сигиле?»~
@2417 = ~«Расскажи мне о черепных крысах побольше».~
@2418 = ~«У меня нет крыс, но у меня есть крысиные хвосты».~
@2419 = ~Финеас моргает. Кажется, наконец-то твой вид произвел впечатление. «Хм-м-м. Беру назад свою последнюю реплику, особенно в свете твоего утверждения о превосходстве физической силы в данном социальном конфликте».~
@2420 = ~«Сколько черепных крыс в Сигиле?»~
@2421 = ~«Расскажи мне о черепных крысах побольше».~
@2422 = ~«У меня нет крыс, но у меня есть крысиные хвосты».~
@2423 = ~«Я выслушал достаточно. Прощай».~
@2424 = ~«Я выслушал достаточно. Прощай».~
@2425 = ~«Великолепно! Просто великолепно! — он восхищенно хлопает в ладоши. — Так, посмотрим...»~
@2426 = ~Хвост черепной крысы~
@2427 = ~Хвост черепной крысы~
@2428 = ~Хвосты черепных крыс~
@2429 = ~Хвосты черепных крыс~
@2430 = ~ХВОСТЫ ЧЕРЕПНЫХ КРЫС
Вес: 0

Это связка хвостов черепных крыс.~
@2431 = ~ХВОСТЫ ЧЕРЕПНЫХ КРЫС
Вес: 0

Это связка хвостов черепных крыс.~
@2432 = ~«Более чем достаточно для одного охотника за наградами... или даже нескольких».~
@2433 = ~«У меня есть другие вопросы...»~
@2434 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@2435 = ~«Чем больше их собирается вместе, тем опаснее они становятся... некоторые из них могут творить магические заклинания, некоторые — сопротивляться сильным магическим воздействиям, а еще они могут задействовать... коварную тактику, — он поправляет свои очки. — Как ты понимаешь, мы весьма заинтересованы сократить их численность в Сигиле».~
@2436 = ~«У меня есть другие вопросы...»~
@2437 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@2438 = ~«Что ж, это довольно легендарная история... понимаешь, я ведь родился в Сигиле...»~
@2439 = ~«Э...»~
@2440 = ~«...и потом я понял, что каким-то образом оскорбил своих коллег, после чего обнаружил себя 'повышенным' до этого филиала, да так и остался здесь на... *многие* годы». Он вздыхает, лениво почесывая свой нос.~
@2441 = ~«Э... *зевок*... У меня есть другие вопросы...»~
@2442 = ~«Понятно... что ж, спасибо за уделенное время. Прощай».~
@2443 = ~«Моя сыпь? Заразная? Нет-нет... по крайней мере, я так не думаю. Боюсь, это признак моей должности. Работа в буквальном смысле срастается с тобой». Он снова чешется.~
@2444 = ~«У меня есть другие вопросы...»~
@2445 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@2446 = ~«Э... ну конечно же... — он дотягивается до кассы под прилавком, открывает крышку и шарит внутри, затем достает несколько монет, которые он отдает тебе. — Надеюсь, в тебе проснется хоть небольшое чувство вины. Без этих скудных средств филиал не сможет покрыть свои затраты».~
@2447 = ~«Мое сердце просто обливается кровью. Прощай».~
@2448 = ~«Мне остается только догадываться, почему награбленного тебе не хватило. Почему ты вернулся?»~
@2449 = ~Оружейник~
@2450 = ~«Ты можешь отдать то, что у тебя в кассе, а потом я пойду».~
@2451 = ~«На сегодня ничего. Прощай».~
@2452 = ~Отдать крысиные хвосты, забрать награду.~
@2453 = ~«Лучше я их подержу некоторое время у себя. У меня есть вопросы...»~
@2454 = ~«Возможно, в другой раз. Прощай».~
@2455 = ~Финеас оживленно мурлычет, совершая обмен. «Спасибо, спасибо тебе, уважаемый сэр. Город Сигил и я от его имени благодарим тебя за приложенные усилия».~
@2456 = ~«У меня есть другие вопросы...»~
@2457 = ~«Спасибо. Если у меня будут еще хвосты, я обязательно вернусь».~
@2458 = ~«Хм-м-м-м? И твой вопрос о...»~
@2459 = ~«Кто ты?»~
@2460 = ~«Что ты здесь делаешь?»~
@2461 = ~«Как такой выдающийся человек... как ты, оказался в подобном месте?»~
@2462 = ~«Расскажи мне об этих черепных крысах».~
@2463 = ~«У меня есть крысиные хвосты. Я хотел бы получить за них награду».~
@2464 = ~«Твоя сыпь заразная?»~
@2465 = ~«Больше вопросов нет. Прощай».~
@2466 = ~Ждущий Смерти~
@2467 = ~Норочж~
@2468 = ~Мортай Сводящий-в-могилу~
@2469 = ~Старик Медноглазый~
@2470 = ~Скептик Увядшая~
@2471 = ~Эморик~
@2472 = ~Жена Ангиара~
@2473 = ~Ангиар~
@2474 = ~Перед тобой высокий молчаливый человек. Его можно запросто принять за статую, хотя глубокие морщины на лице и лбу заставляют тебя думать, что скульптор немного переборщил с долотом при вытесывании лица. Он выглядит по меньшей мере лет за пятьдесят, но вот насколько за пятьдесят, сказать трудно. Он медленно поворачивается к тебе, и ты замечаешь тусклый медный блеск в его глазах.~
@2475 = ~«Приветствую».~
@2476 = ~Оставить его в покое.~
@2477 = ~Старик Медноглазый смотрит на тебя. Цвет глаз трудно определить — настолько глубоко они посажены, — но медный блеск явственно различим.~
@2478 = ~«Я хочу подписать Контракт Смерти».~
@2479 = ~«Я хочу отменить Контракт Смерти, который подписал с тобой».~
@2480 = ~«Верни мне Контракт Смерти, который я подписал, или я заберу его силой».~
@2481 = ~Медноглазый еле заметно кивает и медленно засовывает руки в мантию. Левой рукой он вытаскивает небольшой мешочек из человеческой кожи, а правой — кусок пергамента, намотанный на ручку, сделанную из фаланги. Мешочек и пергамент медленно ложатся на стол перед тобой.~
@2482 = ~Взять пергамент и осмотреть его.~
@2483 = ~Подписать пергамент.~
@2484 = ~Подписать пергамент.~
@2485 = ~Осмотреть мешочек.~
@2486 = ~Взять мешочек.~
@2487 = ~Это контракт, свидетельствующий о том, что тленные получают во владение тело подписавшегося после того, как он пересечет Границу Вечности. Подписавшийся в обмен получает от тленных денежную сумму, оговоренную в момент подписания контракта. По всей видимости, именно она и содержится в мешочке.~
@2488 = ~Подменить пергамент другим контрактом, а затем подписать его.~
@2489 = ~Подменить пергамент другим контрактом, а затем подписать его.~
@2490 = ~Подменить пергамент другим контрактом, а затем подписать его.~
@2491 = ~Осмотреть пергамент.~
@2492 = ~Подписать пергамент.~
@2493 = ~«Я передумал. Прощай».~
@2494 = ~Осмотреть мешочек.~
@2495 = ~Взять мешочек.~
@2496 = ~Медноглазый никак не реагирует на подмену. Как только ты заканчиваешь подписывать контракт, Медноглазый кивает на мешочек в левой руке. Добравшись до мешочка, ты определяешь, что в нем около сотни медяков. Контракт в это время исчезает в рукаве мантии старика.~
@2497 = ~Медноглазый никак не реагирует на подмену. Как только ты заканчиваешь подписывать контракт, Медноглазый кивает на мешочек в левой руке. Он оставляет контракт на столе, будто предлагая изучить его снова... к своему ужасу ты замечаешь, что трюк не удался. Теперь, после твоей смерти, тленные завладеют твоим телом.~
@2498 = ~«У меня есть вопросы...» ~
@2499 = ~«Прощай».~
@2500 = ~«Ой... минуточку... могу ли я еще раз посмотреть на контракт?»~
@2501 = ~Уйти.~
@2502 = ~Пергамент исчезает в рукаве мантии Медноглазого. Он кивает на мешочек.~
@2503 = ~«Отдай мне этот контракт или я убью тебя!»~
@2504 = ~Взять мешочек и уйти.~
@2505 = ~Медноглазый не реагирует, но комната неожиданно погружается во мглу...~
@2506 = ~«Что за?!..»~
@2507 = ~Мешочек наполнен медяками. Похоже, в нем около сотни монет.~
@2508 = ~Взять пергамент и осмотреть его.~
@2509 = ~Подписать пергамент.~
@2510 = ~Снова осмотреть мешочек.~
@2511 = ~Взять мешочек.~
@2512 = ~«Я передумал. Прощай».~
@2513 = ~Ты пытаешься схватить мешочек, но он исчезает со стола. Несколько раз сморгнув, ты снова видишь его на столе. Медноглазый по-прежнему не спускает с тебя глаз.~
@2514 = ~Взять пергамент и осмотреть его.~
@2515 = ~Подписать пергамент.~
@2516 = ~Осмотреть мешочек.~
@2517 = ~Взять мешочек снова.~
@2518 = ~«Я передумал. Прощай».~
@2519 = ~Медноглазый хранит молчание.~
@2520 = ~Как только ты заканчиваешь подписывать контракт, Медноглазый кивает на мешочек в левой руке. В это же время контракт исчезает в его рукаве.~
@2521 = ~«Я хочу задать тебе несколько вопросов...»~
@2522 = ~«Я пришел подписать Контракт Смерти».~
@2523 = ~«Э-э... неважно. Прощай».~
@2524 = ~Не произнося ни слова, Медноглазый поднимает со стола пергамент с мешочком и кладет их в рукав своей мантии.~
@2525 = ~Уйти.~
@2526 = ~«Прощай».~
@2527 = ~«Понятно. У меня есть другие вопросы...»~
@2528 = ~«Какая еще работа есть в Улье?»~
@2529 = ~«А где находится этот переулок?»~
@2530 = ~«У меня есть другие вопросы...»~
@2531 = ~«Тогда неважно. У меня есть другие вопросы...»~
@2532 = ~«Ладно... Прощай».~
@2533 = ~«А где находится этот переулок?»~
@2534 = ~«Извини, у меня нет денег на пожертвования».~
@2535 = ~Ложь: «Извини, у меня нет денег на пожертвования».~
@2536 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@2537 = ~Agrive (Alley/B)~
@2538 = ~Житель Проклятого~
@2539 = ~Тегарин~
@2540 = ~Отпустить его... на этот раз.~
@2541 = ~Мужчина разочарованно хмурится. «Ах... ну что ж, благодарю вас за уделенное время, господин. Хорошего дня».~
@2542 = ~«Прощай».~
@2543 = ~Перед тобой хмурая бледная женщина в черной мантии. Она молча уставилась на свою выпивку.~
@2544 = ~Перед тобой хмурая бледная тленная в черной мантии. Она молча уставилась на свою выпивку.~
@2545 = ~«Приветствую».~
@2546 = ~Оставить ее в покое.~
@2547 = ~«Приветствую».~
@2548 = ~Оставить ее в покое.~
@2549 = ~Тленная поднимает голову «Да?»~
@2550 = ~«Можно задать тебе пару вопросов?»~
@2551 = ~«Неважно. Прощай».~
@2552 = ~«Только не сейчас». Тленная умолкает и возвращается к своей выпивке.~
@2553 = ~«Тогда прощай». ~
@2554 = ~Перед тобой хмурый бледный мужчина в черной мантии. Он молча уставился на свою выпивку.~
@2555 = ~Перед тобой хмурый бледный тленный в черной мантии. Он молча уставился на свою выпивку.~
@2556 = ~«Приветствую».~
@2557 = ~Оставить его в покое.~
@2558 = ~«Приветствую».~
@2559 = ~Оставить его в покое.~
@2560 = ~Тленный поднимает голову «Да?»~
@2561 = ~«Можно задать тебе пару вопросов?..»~
@2562 = ~«Неважно. Прощай».~
@2563 = ~«Только не сейчас». Тленный умолкает и возвращается к своей выпивке.~
@2564 = ~«Тогда прощай». ~
@2565 = ~Скелет, покачиваясь, поворачивается к тебе. Его кости связаны воедино кожаными ремнями, а с плеч спадает зеленая туника, заляпанная вином.~
@2566 = ~Осмотреть скелет.~
@2567 = ~«Красивая туника».~
@2568 = ~Использовать на скелете свою способность «История костей».~
@2569 = ~Осмотреть скелет.~
@2570 = ~Скелет не реагирует.~
@2571 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@2572 = ~Этот скелет не реагирует. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@2573 = ~Оставить скелета в покое.~
@2574 = ~Этот труп женщины одет в тяжелую джутовую блузку, покрытую пятнами от еды и вина. Ее губы крепко зашиты, а руки и ноги обернуты несколькими слоями бинтов. Похоже, бинты были пропитаны консервантами, чтобы уберечь плоть трупа... в результате трупная гниль была сменена на аналогичный по тошнотворности запах уксуса.~
@2575 = ~«Итак... чем занимаешься вечером?»~
@2576 = ~Использовать на скелете свою способность «История костей».~
@2577 = ~«Было приятно поболтать с тобой. Прощай».~
@2578 = ~Оставить тело в покое.~
@2579 = ~Зомби продолжает пялиться на тебя.~
@2580 = ~«Ну ладно. Было приятно поболтать с тобой. Прощай».~
@2581 = ~Зомби не реагирует. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@2582 = ~Оставить тело в покое.~
@2583 = ~Зомби смотрит на тебя пустыми глазами. Его рот крепко зашит, некоторые части тела полностью забинтованы. От тела доносится слабый запах алкоголя.~
@2584 = ~Зомби продолжает пялиться на тебя.~
@2585 = ~Зомби не реагирует. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@2586 = ~«Тогда прощай». ~
@2587 = ~«Итак... что тут у нас интересного?»~
@2588 = ~Использовать на скелете свою способность «История костей».~
@2589 = ~«Было приятно поболтать с тобой. Прощай».~
@2590 = ~«Было приятно поболтать с тобой. Прощай».~
@2591 = ~Оставить зомби в покое.~
@2592 = ~Загрузить игру~
@2593 = ~Начать новую игру~
@2594 = ~Повторить ролики~
@2595 = ~Выйти~
@2596 = ~УРОВЕНЬ~
@2597 = ~«Тогда прощай». ~
@2598 = ~«Было приятно поболтать с тобой. Прощай».~
@2599 = ~Оставить зомби в покое.~
@2600 = ~«Тогда прощай». ~
@2601 = ~«Пссст. Видел, как она посмотрела на меня? А? Ты видел это? Как она огибала взглядом кривую моей затылочной кости?»~
@2602 = ~«Ты имеешь в виду этот бессмысленный пустой могильный взгляд?»~
@2603 = ~«О чем это ты *толкуешь*?»~
@2604 = ~«Чт... да ты что, ОСЛЕП?! Она меня изучала! Она бесстыдно меня ХОТЕЛА!»~
@2605 = ~«Скорее хотела, чтобы ты *исчез*. Да она была слишком занята МНОЙ, чтобы отвлекаться на какую-то болтающуюся голову с большим ртом».~
@2606 = ~«По-моему, у тебя слишком богатое воображение. Она зомби. Труп. Мертвая. Скорее всего, она тебя даже не заметила».~
@2607 = ~«По-моему, тебе стоит время от времени отключать свое воображение».~
@2608 = ~«Как знаешь, Морт. Идем».~
@2609 = ~«Да-да-да, как пожелаешь. Если бы ты был настолько долго мертв, как я, ты бы улавливал сигналы. Для тебя они, наверно, слишком ТОНКИЕ, чтобы их уловить, но именно поэтому я буду проводить ночи напролет с сочной свежеумершей крошкой, а ты будешь бегать вокруг с воплями 'А?' 'Чего здесь творится?' 'Куда пропала моя па-па-память?'»~
@2610 = ~«Как знаешь, Морт. Идем».~
@2611 = ~«Тобой? Ага, конечно! Уж поверь мне, крошкам из могил нет дела до 'мускулатуры', 'у меня великолепное тело' и 'я весь в шрамах и круто выгляжу'. Им нужны парни с ДУШОЙ. Типа меня, шеф. А трупов вроде ТЕБЯ повсюду навалом, как грязи».~
@2612 = ~«Как знаешь, Морт. Идем».~
@2613 = ~«Тогда я ничем не могу тебе помочь. Прощай».~
@2614 = ~«Не за что. Прощай».~
@2615 = ~«Не за что. Прощай».~
@2616 = ~«Не за что. Прощай».~
@2617 = ~«Не за что... Прощай».~
@2618 = ~«Не за что. Прощай».~
@2619 = ~Хорошо. У меня есть другие вопросы...~
@2620 = ~«И не говори. Скажи, ты можешь ответить на пару моих вопросов?»~
@2621 = ~«Без проблем. Прощай, Осыпанный-Пеплом».~
@2622 = ~«Бар, который ты ищешь, рядом с Моргом. Иди от главных ворот Морга строго на юго-запад. Ты его не пропустишь».~
@2623 = ~Гнилой Уильям~
@2624 = ~Головорез с Переулка~
@2625 = ~Корефан~
@2626 = ~Мхульт~
@2627 = ~Нодд~
@2628 = ~Сборщик~
@2629 = ~Гронк~
@2630 = ~Слабая варгулья~
@2631 = ~Тестокль~
@2632 = ~«Я тестовый персонаж. Что пожелаешь?»~
@2633 = ~Я бы хотел пробежаться по тестовым полям для Джима.~
@2634 = ~Я бы хотел проверить, работают ли скобки.~
@2635 = ~Я хочу посмотреть, станешь ли ты волноваться, если я выберу этот ответ.~
@2636 = ~Я хочу проверить кое-что из AI.~
@2637 = ~«О, Джима Гарднера? Он такой милашка. Что он хочет, чтобы я сделала?»~
@2638 = ~«Сделай, пожалуйста, большой КУСОК текста и длинную цепочку ответов на него».~
@2639 = ~«Сделай, пожалуйста, маленький КУСОК текста и короткую цепочку ответов на него».~
@2640 = ~«О? Ты видишь это?» [Если скобки работают, то ты должен увидеть эту конструкцию.]~
@2641 = ~Вернуться в главное меню.~
@2642 = ~Просто проверяю, спасибо.~
@2643 = ~«Ты видишь это?! Ты видишь это?!»~
@2644 = ~Тихо! Ты никогда не узнаешь. Теперь верни меня в главное меню.~
@2645 = ~Сделай это еще раз.~
@2646 = ~Сделай беспокойную позу.~
@2647 = ~Сначала сделай анимацию стойки, подожди 2 секунды, потом сделай беспокойную позу, подожди 2 секунды, потом сделай еще раз стойку. Понял?~
@2648 = ~Тестокль~
@2649 = ~Ложь: «Ага, встань напротив Морга, а потом иди... три квартала на запад, кажется... а потом сверни в первый переулок направо».~
@2650 = ~«На самом деле, я не могу вспомнить, где он находится. Я вернусь, если вспомню. Прощай».~
@2651 = ~«Я ищу кое-кого по имени Фарод. Знаешь такого?»~
@2652 = ~«Я ищу потерянный дневник. Ты не знаешь, где я могу его найти?»~
@2653 = ~«Расскажи мне немного об этом месте».~
@2654 = ~«Расскажи мне немного о тленных».~
@2655 = ~«Неважно. Прощай».~
@2656 = ~«Хорошо. У меня есть другие вопросы...»~
@2657 = ~«Без проблем. Прощай, Осыпанный-Пеплом».~
@2658 = ~«Правда? А я думал, что тленные не ценят имущество».~
@2659 = ~«У меня есть другие вопросы...»~
@2660 = ~«Спасибо за внимание. Прощай».~
@2661 = ~Девятый Круг? Такого не существует.~
@2662 = ~«Для тленного у тебя... *необычная* точка зрения».~
@2663 = ~«Понятно. У меня еще вопросы...» ~
@2664 = ~ «Спасибо за информацию. Прощай».~
@2665 = ~«А я думал, что ты не очень знаком с этим местом».~
@2666 = ~«Похоже, ты знаешь *это* место очень хорошо».~
@2667 = ~«Похоже, ты знаешь *это* место очень хорошо».~
@2668 = ~«Понятно. У меня еще вопросы...» ~
@2669 = ~ «Спасибо за информацию. Прощай».~
@2670 = ~«Очень странно, что тленный не знает о Баре собирателей пыли — ведь он прямо перед Моргом».~
@2671 = ~«Понятно. У меня еще вопросы...» ~
@2672 = ~ «Спасибо за информацию. Прощай».~
@2673 = ~«Я это уже понял. Кто ты?»~
@2674 = ~Я хочу проверить диалоги.~
@2675 = ~«Например?..»~
@2676 = ~Неважно. Давай вернемся на секундочку в твое главное меню.~
@2677 = ~Беги от меня как можно быстрее. Как будто ты испугался. «RunAwayFrom ((PC), 2000)»~
@2678 = ~Беги от меня как можно быстрее. Как будто ты испугался. «RunAwayFrom ((PC), 2000)». НО НА ЭТОТ РАЗ, установи флаг Врага, посмотрим, что из этого получится.~
@2679 = ~«Неважно. Прощай».~
@2680 = ~«Понятно. У меня еще вопросы...» ~
@2681 = ~ «Спасибо за информацию. Прощай».~
@2682 = ~«Э-э... для тленного это довольно-таки *необычная* точка зрения».~
@2683 = ~«Такого я никогда не слышал ни от одного тленного. Кто ты?»~
@2684 = ~«Понятно. У меня еще вопросы...» ~
@2685 = ~ «Спасибо за информацию. Прощай».~
@2686 = ~«Девятый Круг? Такого не существует».~
@2687 = ~«Понятно... У меня еще вопросы...» ~
@2688 = ~«Отлично. Прощай».~
@2689 = ~Схватить его за руку.~
@2690 = ~Схватить его за руку.~
@2691 = ~«Так кто ты на самом деле?»~
@2692 = ~«Тогда ничего. Извини, если обидел».~
@2693 = ~Схватить его за руку.~
@2694 = ~Схватить его за руку.~
@2695 = ~«Ты не тленный. Ты карманник».~
@2696 = ~«Я тоже прошу прощения. Приготовься к смерти».~
@2697 = ~«Ничего, неважно. Прощай».~
@2698 = ~«Хорошо. А теперь проваливай».~
@2699 = ~Схватить его за руку.~
@2700 = ~Схватить его за руку.~
@2701 = ~~
@2702 = ~Неважно. Возвращайся в свой обычный цикл анимации.~
@2703 = ~Она закатывает глаза. «Например, какие диалоги?»~
@2704 = ~Неважно. Вернемся в твое главное меню.~
@2705 = ~Если я выберу этот вариант, который отправит тебя в ветку, которая тебе скажет атаковать меня, что будет, если в ответной не будет текста? Будет ли «Дальше» единственным отображаемым вариантом? И будет ли иметь место действия сценария (например, установка Враг)? Как насчет этого, какашка?»~
@2706 = ~Запутавшись, она нападает на тебя!~
@2707 = ~Если этот ответ перебросит меня на одну из веток Морта, и в ней не будет ответов на реплику Морта, что будет?~
@2708 = ~Неважно. Возвращайся в свой обычный цикл анимации, Тестокль.~
@2709 = ~«Что? Что такое? Это девчонка досаждает тебе?»~
@2710 = ~«Нет, я ничего не делала! Это он начал первым!»~
@2711 = ~«Верю. Наверное, будет лучше, если он вернется в основное меню и избавит меня от этого».~
@2712 = ~Просто проверяю, спасибо.~
