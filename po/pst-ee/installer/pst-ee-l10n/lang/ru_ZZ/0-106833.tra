@9614 = ~0100tm3~
@9615 = ~0100tm2~
@9616 = ~Уйти.~
@9617 = ~«Кто-нибудь! Моя сестра...»~
@9618 = ~«Умоляю, помогите! Пожалуйста!»~
@9619 = ~«Приииивет, рубака...»~
@9620 = ~«Ауууууууууу»~
@9621 = ~«Ав-уууууууууууу»~
@9622 = ~«А-уууууууууу»~
@9623 = ~«Арвуууууууу»~
@9624 = ~*Ик*~
@9625 = ~«Хее-хее-хеееее...»~
@9626 = ~«Почему улица троится?..»~
@9627 = ~«Ух ты... земля трясется...»~
@9628 = ~*Ик*~
@9629 = ~«Почему улица троится?..»~
@9630 = ~«Чегооо? Эххх... ничегооо...»~
@9631 = ~«Ухххх... все крууужииится...»~
@9632 = ~::Бормочет::~
@9633 = ~::Ворчит::~
@9634 = ~«На помощь!»~
@9635 = ~«Кто-нибудь! На помощь!»~
@9636 = ~«Надо порвать эту штуку...»~
@9637 = ~«Ты-ы мир-твяк?»~
@9638 = ~«Го-о-олоден».~
@9639 = ~«Хееее...»~
@9640 = ~«Хее-хее-хее...»~
@9641 = ~*Ик*~
@9642 = ~Он говорит медленно и монотонно, его голос полон страдания и безысходности. Даже сейчас его почти не отличить от бездушного зомби. «Что ты хочешь знать, милорд?»~
@9643 = ~Дух говорит так тихо, что ты с трудом его слышишь: губы трупа едва двигаются при каждом слове. «Я никто, милорд; бедное насекомое, отчаянно вцепившееся в Башню Утрат в Ойносе. Когда-то меня называли Арабеймом, милорд... давно, очень давно».~
@9644 = ~«Я жил в Сигиле, милорд. В Улье. Это было не самое ужасное место, как теперь мне кажется, по крайней мере, по сравнению с моим новым домом, где я теперь... Ойносом». Труп моргает, так медленно, что на мгновенье тебе кажется, что он просто закрыл глаза.~
@9645 = ~«Я был убит разбойниками, милорд. Я напился и заблудился по улицам Улья. В конце концов, я стал добычей банды головорезов. Вот и все. Наверно, моя жизнь стоила даже меньше тех медяков, которые получил сборщик за мое тело».~
@9646 = ~На секунду дух закрывает глаза; труп слегка дрожит. «Ужасный Ойнос, милорд. В Серой пустоши. Там, где пребывает моя душа, в тени Хин-Ойна, Башни Утрат».~
@9647 = ~«Для меня больше ничего нет, милорд. Я в вечной западне в чумной пустоши, в Ойносе. Для таких, как я, больше нет надежд». Кажется, дух опустился в более чем патетичное состояние, плечи трупа поникли под весом его скорби.~
@9648 = ~«Очень мало, милорд. Только то, что сюда доставляют умерших для погребения или кремации... или в качестве дешевой рабочей силы, как это случилось с моим телом».~
@9649 = ~Труп медленно качает головой из стороны в сторону. «Нет, милорд. Я не знаю никого с таким именем. Прошу прощения, милорд».~
@9650 = ~«Мало что можно сказать, милорд. Это земля моего Повелителя, лорда Хин-Ойна... полная боли и страданий, разлагающихся тел и душ. Это место полной безнадеги».~
@9651 = ~«Да, милорд. Плохое место, но там не так страшно, как в Ойносе».~
@9652 = ~«Да, милорд. Это очень большая башня, намного выше любого здания в Сигиле. Она сделана из кости, милорд, она очень похоже на позвоночник огромного существа. Там я и тружусь, восстанавливая урон, нанесенный армиями мятежных принцев, врагов моего Повелителя».~
@9653 = ~«Я знаю его только как Повелителя, милорд. Он — лорд Хин-Ойна, принц нечисти, несказанно могущественный ультралот. Он тот, кому принадлежит моя душа, и будет принадлежать вечно, обреченная чахнуть под его ступней, пока вечность не будет перемолота в Забвение».~
@9654 = ~«Да, милорд, сборщик. Тот, кто собирает мертвецов Сигила и доставляет их в Морг — там, где мы находимся — за небольшую цену». Дух оглядывает окружающую обстановку, затем тихо вздыхает.~
@9655 = ~«Я не хочу говорить об этом, милорд. Это не тема для разговоров». Похоже, дух непоколебим в данном вопросе.~
@9656 = ~Ты даже не замечаешь, как дух покинул тело, до тех пор, пока зомби, неуклюже шагая, не вернулся к своей работе.~
@9657 = ~Оставить духа в покое.~
@9658 = ~«Так кто ты?»~
@9659 = ~«Откуда ты?»~
@9660 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9661 = ~«Где ты... где находится твой дух... теперь?»~
@9662 = ~«Почему ты говоришь с таким отчаянием?»~
@9663 = ~«Что ты знаешь об этом месте?»~
@9664 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9665 = ~«Ничего, неважно».~
@9666 = ~«Башне Утрат?»~
@9667 = ~«Ойносе?»~
@9668 = ~«У меня есть другие вопросы...»~
@9669 = ~«Больше нет ничего, что я хотел бы узнать. Прощай».~
@9670 = ~«В Улье?»~
@9671 = ~«Ойносе?»~
@9672 = ~«У меня есть другие вопросы...»~
@9673 = ~«Это все, что я хотел узнать. Прощай».~
@9674 = ~«Почему ты такого низкого мнения о своей жизни?»~
@9675 = ~«Сборщик?»~
@9676 = ~«У меня есть другие вопросы...»~
@9677 = ~«Это все, что я хотел узнать. Прощай».~
@9678 = ~«Расскажи мне больше об этом... Ойносе».~
@9679 = ~«Хин-Ойна?»~
@9680 = ~«У меня есть другие вопросы...»~
@9681 = ~«Больше нет ничего, что я хотел бы узнать. Прощай».~
@9682 = ~«Ойносе?»~
@9683 = ~«Понятно. У меня есть другой вопрос...»~
@9684 = ~«Это все, что я хотел узнать. Прощай».~
@9685 = ~«Теперь понятно. Еще вопрос...»~
@9686 = ~«Больше нет ничего, что я хотел бы узнать. Прощай».~
@9687 = ~«Не надо извиняться. У меня еще вопрос...»~
@9688 = ~«Тогда прощай». ~
@9689 = ~«Кто такой этот... 'Повелитель'?»~
@9690 = ~«Хин-Ойна?»~
@9691 = ~«У меня есть другие вопросы...»~
@9692 = ~«Безусловно, это так. Прощай, дух».~
@9693 = ~«Ойносе?»~
@9694 = ~«У меня есть другие вопросы...»~
@9695 = ~«Это все, что я хотел узнать. Прощай».~
@9696 = ~«Кто такой этот 'Повелитель'?»~
@9697 = ~«Понятно. У меня есть другой вопрос...»~
@9698 = ~«Понятно. Теперь мне нужно идти, дух. Прощай».~
@9699 = ~«Расскажи мне об этом 'Хин-Ойне'».~
@9700 = ~«У меня есть другие вопросы...»~
@9701 = ~«Больше нет ничего, что я хотел бы узнать. Прощай».~
@9702 = ~«Что ты знаешь об этом Морге?»~
@9703 = ~«Понятно. У меня есть другой вопрос к тебе...»~
@9704 = ~«Это все, что я хотел узнать. Прощай».~
@9705 = ~«Хорошо. Тогда у меня есть вопросы...»~
@9706 = ~«Тогда прощай». ~
@9707 = ~Перед тобой печального вида уставший старик, который смотрит на иссохшее деревце. Он что-то бормочет себе под нос, потирая подбородок, словно пытаясь что-то решить. Иногда он горестно качает головой.~
@9708 = ~У этого существа тело барана и торс мужчины. Из косматой головы торчат закрученные рога, шерсть окрашена и на ней выстрижены замысловатые узоры. Цветные бусины и простые драгоценности вплетены в его волосы и свисают с рогов. Похоже, оно тебя не замечает.~
@9709 = ~Этот парень не обращает на тебя внимания; он поглощен энергичным общением с проституткой, стоящей перед ним.~
@9710 = ~Этот мужчина порядком нализался из своей тыквенной бутыли. Он с трудом может стоять, не то что разговаривать с тобой. От него воняет каким-то пойлом, блевотиной и затхлой мочой.~
@9711 = ~Этот мужчина покачивается из стороны в сторону, пытаясь поймать равновесие. На какое-то мгновение ему это удается, и он болезненно улыбается твоему правому уху.~
@9712 = ~Этот мужчина с диким взглядом согнулся и издает низкое рычание. Похоже, он уже много лет не стригся... волосы у него такие длинные, что образуют вуаль перед его глазами. У него длинные тонкие усы, лоснящиеся от жира и пота; их кончики уже так низко, что спутались с его всклоченной бородой. ~
@9713 = ~Тильдон~
@9714 = ~Саросса~
@9715 = ~Вонючка~
@9716 = ~Зомби-телохранитель~
@9717 = ~Бариавр~
@9718 = ~«На самом деле, лингвистика всегда представляла для меня большой интерес. Будучи студентом, я обнаружил, что могу без особых проблем изучать новые наречия».~
@9719 = ~«Это многое объясняет. Итак, ты больше не встречал убийц?»~
@9720 = ~«Понятно. Позволь мне спросить кое о чем еще...»~
@9721 = ~«Понятно. Спасибо за разговор. Прощай».~
@9722 = ~*Кхе-ке*~
@9723 = ~*Тьху*~
@9724 = ~«Вот... эээ... немного денег. Я принесу еще... эээ... потом».~
@9725 = ~«Уж постарайся. Иначе я пришлю его к тебе снова».~
@9726 = ~«Пф».~
@9727 = ~::Глоток::~
@9728 = ~«Ты выглядишь потерянным».~
@9729 = ~«Какой *прок* от тела после смерти?»~
@9730 = ~«Скоро еще один объявится...»~
@9731 = ~«Говорят, Морге все еще пропадают тела...»~
@9732 = ~«Эй, незнакомец... удели мне минуту».~
@9733 = ~«Вздор пустоголового...»~
@9734 = ~«Разве среди вас нет ни одного *мужчины*?!»~
@9735 = ~«Почему все вдруг пропадают, когда женщине нужна помощь?»~
@9736 = ~«Хм-м. Посмотрим, заработает ли эта часть».~
@9737 = ~«Чертов остролистник...»~
@9738 = ~«Может, здесь?..»~
@9739 = ~«Может, здесь...»~
@9740 = ~«Интересно, что случилось с тем старым упырем...»~
@9741 = ~«Хм-м... Может, здесь что-нибудь?..»~
@9742 = ~«Ах вы ублюдки, заритесь на мое...»~
@9743 = ~«Ничего...»~
@9744 = ~«Без понятия. Я был уже порядочно поджарен, прежде чем его остановили, если это кому и удалось. Кажется, припоминаю, как за ним в самом начале гнались люди, выкрикивали его имя... э-э... а! Игнис, кажется так. Игнис. Или типа того. Надеюсь, этому неудачнику досталось больше, чем мне!»~
@9745 = ~«Это все, что я хотел узнать. Прощай».~
@9746 = ~«Это все, что я хотел узнать. Прощай».~
@9747 = ~«Понятно. У меня к тебе еще вопросы...»~
@9748 = ~«Это все, что я хотел узнать. Прощай».~
@9749 = ~Зомби неподвижно стоит. Ты замечаешь чистое место на плече, где ты можешь вырезать ее имя.~
@9750 = ~Зомби немедленно поднимает руку (чтобы указать, где эта чертова Сиси может быть).~
@9751 = ~Зомби остается неподвижным. ~
@9752 = ~~
@9753 = ~~
@9754 = ~~
@9755 = ~~
@9756 = ~~
@9757 = ~~
@9758 = ~~
@9759 = ~~
@9760 = ~~
@9761 = ~~
@9762 = ~~
@9763 = ~~
@9764 = ~~
@9765 = ~~
@9766 = ~«Хм-м. А ты можешь похоронить для меня имя?»~
@9767 = ~«На сегодня имен нет. Извини, что отвлек тебя».~
@9768 = ~«Квентин».~
@9769 = ~«Хм-м... Эс-Аннон».~
@9770 = ~«У меня нет ни одной... звенелки. Может быть, в другой раз».~
@9771 = ~«Эс-Аннон».~
@9772 = ~«Э... 'Адан'?»~
@9773 = ~Похоже, эту башню построили для сбора дождевой воды.~
@9774 = ~К этой доске приколото множество крысиных хвостов.~
@9775 = ~Эта кастрюля воняет кровью и мертвыми крысами.~
@9776 = ~Похоже, это ржавое железное безобразие использовалось для взвешивания крысиных тел.~
@9777 = ~Похоже на часы, но нет ни циферблата, ни стрелок.~
@9778 = ~На этой стене нарисован узор из черных колючих веток.~
@9779 = ~На этой татуировке — вороной конь с белоснежными глазами и шипами, торчащими из его лопаток.~
@9780 = ~Эта картина изображает затемненную сферу, за которой шлейфом стелется туман.~
@9781 = ~На этом наброске изображен ряд черных рек, разветвляющихся, пересекающихся и сливающихся вместе.~
@9782 = ~На этом эскизе — контур зверя, внутри головы которого находится крохотный демон.~
@9783 = ~На этих деревянных рамах натянута человеческая кожа, покрытая татуировками.~
@9784 = ~На этой стене начертан горящий череп. По обе стороны от него — символы двойственности.~
@9785 = ~На этом эскизе — тень, отбрасывающая тень. По силуэту тени сложно определить, мужчина это или женщина.~
@9786 = ~Похоже, это необычное с виду кресло принадлежит постоянному клиенту.~
@9787 = ~Необычное произведение... искусства.~
@9788 = ~Печка сделана из чего-то вроде окаменелой древесины.~
@9789 = ~Перед тобой смазливый парень, одетый в нарядную одежду. Он выглядит крайне взволнованным.~
@9790 = ~«Приветствую».~
@9791 = ~Оставить его в покое.~
@9792 = ~До забулдыги с трудом доходит, что ты разговариваешь с ним. Он смущенно озирается, пытаясь найти источник твоего голоса. Ты замечаешь, что Анна подкрадывается к нему сзади с явным намерением поживиться его кошельком.~
@9793 = ~До забулдыги с трудом доходит, что ты разговариваешь с ним. Он смущенно озирается, пытаясь найти источник твоего голоса.~
@9794 = ~Повернувшись, он раздраженно смотрит на тебя. «Отвали, пень. Мне не о чем с тобой говорить». Он отводит взгляд в сторону.~
@9795 = ~«А, да? Шта? Ииииик!» Неожиданно его начинает обильно рвать; ты отпрыгиваешь назад, стараясь избежать брызг. Ничего более полезного от этого растрепанного вонючего разочарования ты не получишь.~
@9796 = ~«А, да? Шта? Ииииик!» Неожиданно его начинает обильно рвать; вместе с Анной ты отпрыгиваешь назад, стараясь избежать брызг. Ничего более полезного от этого растрепанного вонючего разочарования ты не получишь.~
@9797 = ~«Послушай, у меня всего лишь несколько вопросов к тебе».~
@9798 = ~«Извини за беспокойство. Прощай».~
@9799 = ~Он снова поворачивается к тебе, на этот раз немного рассерженный из-за твоей назойливости. «Задвинься. Я пытаюсь посмотреть на казнь, а ты тут трясешь свой черепушкой надо мной. Оставь меня в покое». Он снова отворачивается.~
@9800 = ~Похлопать его по плечу: «Мне начинают надоедать твои манеры. Ответь на мои вопросы, или я разобью твою милую мордашку».~
@9801 = ~Она пытается что-то сказать, но ты бросаешь на нее тяжелый взгляд, прежде чем она начинает протестовать. Скрестив руки и хлеща хвостом, она презрительно усмехается.~
@9802 = ~Делая вид, что не слышит тебя, она обшаривает кишащую вшами одежду мужчины. Поняв, что тот совсем без гроша, она легонько толкает его и отворачивается. «Ха! У него все равно нифига нет. Чертов забулдыга...»~
@9803 = ~Анна обшаривает кишащую вшами одежду мужчины. Поняв, что тот совсем без гроша, она легонько толкает его и отворачивается. «Ха! У него все равно нифига нет. Чертов забулдыга...»~
@9804 = ~«Отлично. Прощай».~
@9805 = ~Он поворачивается к тебе, лицо становится красным от гнева. «Да как ты смеешь! Я — племянник самого...»~
@9806 = ~Прервать его: «Да мне плевать, будь ты хоть муж самой Леди. Следующими словами из твоей 'черепушки' должны быть 'чем я могу помочь тебе'».~
@9807 = ~«У меня есть вопросы к тебе...»~
@9808 = ~Прервать его: «Забей. Об тебя даже руки марать не хочется».~
@9809 = ~«У меня есть вопросы к тебе...»~
@9810 = ~Кажется, парень готов буквально взорваться. Он осматривается по сторонам, но не находит поддержки среди толпы. «Ч-чем я могу помочь тебе?»~
@9811 = ~Игнорировать его.~
@9812 = ~«Ну вот... Это ведь не так сложно, верно? У меня есть вопросы к тебе».~
@9813 = ~«Анна... не надо».~
@9814 = ~Улыбнуться: «Ты уже помог. Одного твоего униженного взгляда уже достаточно. Всего хорошего».~
@9815 = ~«Я слушаю».~
@9816 = ~«Анна... не надо».~
@9817 = ~«Что происходит?»~
@9818 = ~«Кто здесь главный?»~
@9819 = ~Встряхнуть его, чтобы привлечь внимание.~
@9820 = ~«Я ищу дэва. Говорят, он где-то в городе».~
@9821 = ~«Какие последние новости?»~
@9822 = ~«Неважно. Всего хорошего».~
@9823 = ~«Просто казнь. Вот и все».~
@9824 = ~Оставить его в покое.~
@9825 = ~«А какое преступление он совершил?»~
@9826 = ~«Понятно. Тогда следующий вопрос».~
@9827 = ~«Спасибо. Прощай».~
@9828 = ~Встряхнуть его, чтобы привлечь внимание.~
@9829 = ~«Не знаю. Спроси в административном здании».~
@9830 = ~Оставить его в покое.~
@9831 = ~«Хорошо, так и сделаю. Позволь мне спросить кое-что еще».~
@9832 = ~Оставить его в покое.~
@9833 = ~Он злорадно улыбается. «Мой дядя, Товус Гильяф».~
@9834 = ~Оставить его в покое.~
@9835 = ~Встряхнуть его, чтобы привлечь внимание.~
@9836 = ~«Убери эту ухмылочку с лица, или я это сделаю за тебя».~
@9837 = ~Оставить его в покое.~
@9838 = ~Улыбка быстро пропадает с его лица. Не говоря ни слова, он хмуро смотрит на тебя.~
@9839 = ~«Так-то лучше. У меня к тебе другие вопросы».~
@9840 = ~Встряхнуть его, чтобы привлечь внимание.~
@9841 = ~«Пожалуй, хватит с тебя. Прощай».~
@9842 = ~Оставить его в покое.~
@9843 = ~«И тебе всего доброго. Надо бы рассказать о тебе моему дяде... ошрамованный». Он переключает свое внимание на толпу.~
@9844 = ~Уйти.~
@9845 = ~«Попробуй».~
@9846 = ~Он смотрит на тебя с презрением. «Хм. Дэва в Проклятом. Такое не каждый день можно увидеть. Я бы сказал, что ты ошибся местом или совсем пустоголовый».~
@9847 = ~«Ладно, следующий вопрос».~
@9848 = ~«Ладно. Прощай».~
@9849 = ~Он пожимает плечами. «Ничего, что могло бы меня заинтересовать».~
@9850 = ~«Понятно. Возможно, ты сможешь рассказать мне еще кое-что».~
@9851 = ~«Тогда прощай».~
@9852 = ~Перед тобой грубоватый мужик с обветренной кожей. Вид у него довольно угрюмый; он не замечает твоего приближения.~
@9853 = ~«Приветствую».~
@9854 = ~Игнорировать его.~
@9855 = ~Он медленно кивает, после чего издает какой-то булькающий звук. Из уголка рта по грязной и нечесаной бороде начинает стекать зеленая жидкость. Похоже, относительно ровно стоять ему удается гораздо лучше, чем поддерживать с тобой разговор».~
@9856 = ~~
@9857 = ~Он подпрыгивает от звука твоего голоса и быстро поворачивается к тебе. Его лицо побагровело, дыхание участилось.~
@9858 = ~~
@9859 = ~«Какие мы нервные».~
@9860 = ~«Брось, шеф... ты убьешь бедолагу, прежде чем тебе удастся его разбудить!»~
@9861 = ~«Извини, что напугал. Я хотел задать тебе пару вопросов».~
@9862 = ~«Извини, что побеспокоил тебя. Прощай».~
@9863 = ~Он бросает на тебя сердитый взгляд и достает из-за спины кинжал. «Отвали, пень! Гуляй отсюда, не то попадешь в книгу мертвых».~
@9864 = ~«Приветствую...»~
@9865 = ~«Успокойся. Мне просто нужно кое-что спросить».~
@9866 = ~Оставить его в покое.~
@9867 = ~«Неважно... Прощай».~
@9868 = ~«Убери свой клинок, не то им же тебя и прикончу».~
@9869 = ~~
@9870 = ~«Как пожелаешь. Прощай».~
@9871 = ~~
@9872 = ~Он принимает защитную стойку, угрожая тебе клинком. «У меня нет для тебя ответов. Мне нечего сказать. Отвали!»~
@9873 = ~«Убери свой клинок, не то им же тебя и прикончу».~
@9874 = ~«Отлично. Прощай».~
@9875 = ~Он смеется над тобой, размахивая клинком. «Тогда подходи. Я выпущу тебе кишки и буду смеяться, пока ты будешь умирать!»~
@9876 = ~Атаковать его.~
@9877 = ~~
@9878 = ~«Неважно. Прощай».~
@9879 = ~~
@9880 = ~У тебя такое впечатление, будто он не знает, что тебе ответить. Похоже, твои слова привели его в замешательство. «Я, э... Я немного задумался, рубака. Чего ты хочешь?» Он беспокойно глядит на тебя.~
@9881 = ~~
@9882 = ~«Ты прав, Морт. Идем».~
@9883 = ~«Всего лишь несколько ответов. Хорошо?»~
@9884 = ~«На самом деле — ничего. Прощай».~
@9885 = ~Он пристально смотрит на тебя, потом нервно оглядывается. «Один вопрос, а потом ты свалишь. У меня нет ни времени, ни желания».~
@9886 = ~«Я разыскиваю дэва. Насколько я понимаю, он в Проклятом».~
@9887 = ~«Кто здесь главный?»~
@9888 = ~«Какие местные новости?»~
@9889 = ~«Чем ты занимаешься?»~
@9890 = ~«Если бы тебе нужно было бы получить толковые ответы на кое-какие вопросы, к кому бы ты обратился?»~
@9891 = ~«Неважно. Всего хорошего».~
@9892 = ~Он непонимающе смотрит на тебя. «Ага, точно. Чтоб один из этих самодовольных бедолаг бродил по улицам Проклятого? Да ты чокнутый, рубака. Я дал тебе ответ, теперь проваливай». Он отворачивается и уходит.~
@9893 = ~Уйти.~
@9894 = ~«Товус Гильяф. Он в административном здании на городской площади. Я дал тебе ответ, теперь проваливай». Он отворачивается и уходит.~
@9895 = ~Уйти.~
@9896 = ~Он на миг задумывается. «Не знаю... Я слухов не собираю, рубака. Иди к 'Воротам предателей'. Это такая местная помойная яма неподалеку, — он вяло указывает направление. — Я дал тебе ответ, теперь проваливай». Он отворачивается и уходит.~
@9897 = ~Уйти.~
@9898 = ~Он смеется над тобой. «Этого тебе, пень, знать не нужно. Я дал тебе ответ, теперь проваливай». Он отворачивается и уходит.~
@9899 = ~Уйти.~
@9900 = ~Он смеется, улыбаясь тебе. «Хороший вопрос. А все-таки ты толковый рубака, — он на миг задумывается, потом внимательно на тебя смотрит. — На твоем месте я бы поговорил с Шар. Она где-то поблизости, бродит по улицам, так что найти ее будет нетрудно. Если будешь с ней вежлив, она тебе поможет. Я дал тебе ответ, теперь проваливай». Он отворачивается и уходит.~
@9901 = ~Уйти.~
@9902 = ~Перед тобой человек, облаченный в броню, с подвешенным сбоку мечом. Он с беспокойством наблюдает за твоим приближением.~
@9903 = ~«Приветствую».~
@9904 = ~Оставить его в покое.~
@9905 = ~Он кивает тебе, затем быстро оглядывается по сторонам. «И я тебя тоже. Чего ты хочешь?»~
@9906 = ~«Я хотел задать тебе пару вопросов».~
@9907 = ~«Неважно».~
@9908 = ~«Я в Проклятом недавно, так что сомневаюсь, что смогу ответить на них. И все же попробую».~
@9909 = ~«Ты слышал про дэва, который, возможно, находится в городе?»~
@9910 = ~«Могу ли я спросить, что ты делаешь в Проклятом?»~
@9911 = ~«Неважно».~
@9912 = ~Он с удивлением смотрит на тебя. «Дэва? Нет, не скажу, чтобы слышал. Да и что здесь делать дэва? В этом нет смысла».~
@9913 = ~«В общем, да... Что ты делаешь в Проклятом?»~
@9914 = ~«Понятия не имею. Мне нужно идти».~
@9915 = ~«Что ж, удачи тебе. Прощай».~
@9916 = ~«И тебе тоже».~
@9917 = ~«По профессии я наемник. Мне сказали, что в Проклятом можно найти работу — вот я и пришел. Но из-за чумы большая часть чертового города запечатана. Я не могу попасть туда, куда направлялся».~
@9918 = ~«Что ты знаешь об этой чуме?»~
@9919 = ~«Куда тебе нужно попасть?»~
@9920 = ~«Понятно. Нам пора прощаться».~
@9921 = ~Он пожимает плечами. «В сущности — ничего. Мне сказали, что она началась внезапно, но ее быстро взяли под контроль, запечатав зараженные районы города, — он вздыхает. — Чертовски неудобно. Теперь я не могу попасть на встречу».~
@9922 = ~«Куда тебе нужно попасть?»~
@9923 = ~«Благодарю. Мне нужно идти».~
@9924 = ~«В Четвертованный. Это место сбора наемников, но теперь в эту часть города не добраться».~
@9925 = ~«Понятно. Мне уже нужно идти».~
@9926 = ~Оставить его в покое.~
@9927 = ~Он осматривает тебя с ног до головы, прежде чем ответить. «И я тебя приветствую, рубака. Чем могу быть полезен?»~
@9928 = ~«Я хотел задать тебе пару вопросов».~
@9929 = ~«Неважно. Прощай».~
@9930 = ~Он некоторое время пристально смотрит на тебя, потом начинает тихонько посмеиваться. «Ничего не видел, ничего не слышал, ничего не знаю. Так что и ответить не смогу. А теперь беги, пока я тебя не поранил».~
@9931 = ~«С тебя ведь не убудет, если ответишь на пару простых вопросов. Как насчет такого?»~
@9932 = ~«Если мне придется выбить из тебя ответы, что ж, меня это устроит».~
@9933 = ~«Ладно. Всего хорошего».~
@9934 = ~Он хмуро глядит на тебя. «Нам не о чем говорить, пень. Это твой последний шанс уйти подобру-поздорову».~
@9935 = ~«Если мне придется выбить из тебя ответы, что ж, меня это устроит».~
@9936 = ~«Ладно. Всего хорошего».~
@9937 = ~Он осматривает тебя с ног до головы, уделяя внимание твоим шрамам, затем отвечает тебе дружелюбной улыбкой. «Ладно, напугать тебя не так-то просто. С такими можно вести разговор. Чего ты хочешь?»~
@9938 = ~«Просто пару ответов».~
@9939 = ~«Неважно».~
@9940 = ~Он пожимает плечами. «Конечно. Спрашивай».~
@9941 = ~«Я ищу одного дэва. Мне сказали, что он в Проклятом».~
@9942 = ~«Что ты можешь рассказать о Проклятом?»~
@9943 = ~«Кто здесь главный?»~
@9944 = ~«Что произошло в городе за последнее время?»~
@9945 = ~«Неважно. Прощай».~
@9946 = ~Он хихикает. «Это уж вряд ли, рубака. Не могу представить себе дэва, ступающего по этому городу. Разве что он хочет стереть его с лица земли. Мне кажется, что ты тратишь свое время попусту».~
@9947 = ~«Понятно. Еще вопрос».~
@9948 = ~«О чем это ты?»~
@9949 = ~«Спасибо. Прощай».~
@9950 = ~Он пожимает плечами. «Я слыхал, что некоторые пни зовут дэва ангелами. Проклятый — это тот тип города, в котором 'ангелы' не появились бы ни за что на свете. Не та сторона Кольца».~
@9951 = ~«Кольца?»~
@9952 = ~«Понятно. Еще вопрос».~
@9953 = ~«Кольца Внешних планов. Закон на одной стороне, хаос — на другой, а между ними — добро и зло. Ты здесь новенький, или как?» Он смотрит на тебя в недоумении.~
@9954 = ~«Можно и так сказать. Мне нужно спросить у тебя еще кое-что».~
@9955 = ~«Неважно. Прощай».~
@9956 = ~Он пожимает плечами и хитро улыбается. «Это славное местечко для подходящих людей. Все зависит от тебя и тех, кого ты знаешь».~
@9957 = ~«И с кем, по-твоему, мне стоит познакомиться?»~
@9958 = ~«Ладно, еще один вопрос».~
@9959 = ~«Понятно. Что ж, мне нужно идти».~
@9960 = ~Он на мгновение задумывается. «Рубаке вроде тебя было бы интересно побывать в 'Воротах предателей'. Это бар, которым заправляет человек по имени Гниющий Копчик, — он улыбается тебе. — Не говори ему, что это я тебя послал».~
@9961 = ~«Как мне найти это место?»~
@9962 = ~«Понятно. Еще вопрос».~
@9963 = ~«Спасибо. Прощай».~
@9964 = ~Он пожимает плечами. «Точно не знаю. Думаю, он вон там, — он указывает вправо от тебя. — Просто осмотрись, ты его найдешь».~
@9965 = ~«Ладно, еще один вопрос».~
@9966 = ~«Прощай».~
@9967 = ~«Товус Гильяф. Ты сможешь его найти в административном здании на городской площади».~
@9968 = ~«Что ты можешь сказать о Товусе?»~
@9969 = ~«Еще один вопрос».~
@9970 = ~«Спасибо. Всего хорошего».~
@9971 = ~«Никогда не имел с ним никаких дел. Если бы не тот факт, что он управляет этим городом, я бы и имени его не знал». Похоже, ему это надоедает.~
@9972 = ~«Хорошо. Хочу еще кое-что спросить».~
@9973 = ~«Тогда всего тебе хорошего».~
@9974 = ~Он оглядывается с выражением скуки. «В общем-то ничего. Сейчас здесь довольно тихо».~
@9975 = ~«Понятно. У меня есть к тебе другой вопрос».~
@9976 = ~«Я должен идти. Всего хорошего».~
@9977 = ~Перед тобой бедно одетый старик. Он замечает, что ты на него смотришь, и пытается улизнуть от тебя. Ты ловко сворачиваешь и перехватываешь его.~
@9978 = ~«Приветствую».~
@9979 = ~Оставить его в покое.~
@9980 = ~Он как будто собирается сбежать, но потом бросает эту идею. Его взгляд мечется по сторонам и не может сфокусироваться на тебе. Однако у тебя складывается впечатление, что он готов сбежать, не раздумывая. «У меня ничего нет! Я тебе ничего не сделал! Отпусти меня... пожалуйста!»~
@9981 = ~«Успокойся. Я просто хочу задать тебе пару вопросов. Хорошо?»~
@9982 = ~«Извини, что побеспокоил. Иди своей дорогой».~
@9983 = ~Его взгляд, наконец, фокусируется на тебе. Когда он оглядывает тебя сверху донизу, беспокойство в его глазах усиливается. «Я... Я бы помог, если мог, клянусь. Но я ничего не знаю... ничего, клянусь! Пожалуйста, отпусти меня».~
@9984 = ~«Откуда ты знаешь, что не можешь мне помочь, ведь ты даже не услышал вопрос?»~
@9985 = ~«Ладно. Иди».~
@9986 = ~Его взгляд начинает метаться, как будто он ждет нападения с любой стороны. Он начинает заламывать руки и нервно поглядывать на тебя, потом его внимание снова переключается на улицы вокруг него. «Э-э... Мне не нужны неприятности, понимаешь? Так что я взял за правило ничего не знать, понятно? Потому-то я и знаю, что ничем не могу тебе помочь. Пожалуйста! Отпусти меня!» Тебе кажется, что он расплачется в любую минуту — такой у него расстроенный вид.~
@9987 = ~«Ладно. Извини, что потревожил».~
@9988 = ~«Пф. Да мне наплевать, что ты ничего не знаешь. Мне нужны ответы, и я выбрал тебя, чтобы получить их. Иначе я дам тебе в рожу».~
@9989 = ~«Слушай, мне жаль, что я так тебя расстроил. Я могу тебе чем-то помочь? Похоже, ты в беде».~
@9990 = ~Он начинает пятиться, и на мгновение на его лице появляется выражение облегчения. Он беспокойно оглядывается, потом, наконец, поворачивается и убегает.~
@9991 = ~«Кажется, я начинаю понимать значение слова 'чокнутый'».~
@9992 = ~Его глаза мечутся из стороны в сторону, и вдруг он начинает хныкать. Он закрывает лицо руками и, плача, опускается на землю. Непохоже, что ты от него чего-нибудь добьешься.~
@9993 = ~«Кажется, я начинаю понимать значение слова 'чокнутый'».~
@9994 = ~Он начинает пятиться, и на мгновение на его лице появляется выражение облегчения. Его глаза беспокойно бегают, потом фокусируются на тебе. «Ты... ты хочешь мне помочь? Мне, незнакомцу? В чем подвох, пень?!»~
@9995 = ~«Да, я хочу тебе помочь. Никаких подвохов. Просто скажи, что тебе нужно».~
@9996 = ~Он осторожно осматривает тебя с ног до головы, потом оглядывается. Когда он снова поворачивается к тебе, его затравленный взгляд на миг пропадает. «Благодарю тебя. Никто бы не предложил помощь такому как я. Я... Я не думаю, что от меня будет толк... Благодарю тебя... Мне нужно идти».~
@9997 = ~«Понятно. Прощай».~
@9998 = ~Перед тобой устало выглядящий мужчина средних лет. Заметив твое внимание, он делает легкий поклон.~
@9999 = ~«Приветствую».~
@10000 = ~Оставить его в покое.~
@10001 = ~Он избегает твоего взгляда, вместо этого потупившись в землю у твоих ног. «Добрый день, рубака. Чем могу помочь?»~
@10002 = ~«Для начала мог бы смотреть на меня, когда мы разговариваем».~
@10003 = ~«У меня к тебе пара вопросов».~
@10004 = ~«Неважно».~
@10005 = ~Он бросает на тебя взгляд и тут же опускает его к твоим ногам. «Мне, как слуге, не положено смотреть тебе в глаза, рубака».~
@10006 = ~«Хорошо. Знай свое место и не забывай его».~
@10007 = ~«Ну, мне ты не слуга, так что я хочу, чтобы ты смотрел на меня, как на равного».~
@10008 = ~«Как угодно. У меня к тебе вопросы».~
@10009 = ~«Неважно. Прощай».~
@10010 = ~Он кивает, но не поднимает взгляд. «Да, рубака».~
@10011 = ~«Я разыскиваю дэва. Мне сказали, что он в Проклятом. Ты его не видел?»~
@10012 = ~«Расскажи мне о Проклятом».~
@10013 = ~«Какие последние новости?»~
@10014 = ~«Кто здесь главный?»~
@10015 = ~«Неважно».~
@10016 = ~«Я не знаю ни о каком дэва. Даже не могу представить, чтобы он и близко подошел к Проклятому, не говоря уже о том, чтобы зайти в город, — он прерывается, чтобы поразмыслить. — На твоем месте я бы спросил в здании администрации на городской площади. Они должны знать о подобных гостях».~
@10017 = ~«Благодарю. Еще несколько вопросов».~
@10018 = ~«Ты мне очень помог. Прощай».~
@10019 = ~«Тут почти не о чем рассказывать, рубака. Проклятый — привратный город на краю Внешних земель. В нем находятся врата в Карцери; они на городской площади... — он нахмуривает лоб, призадумавшись. — Однако не думаю, что врата все еще открыты. Это связано с предотвращением распространения чумы...»~
@10020 = ~«Чумы?»~
@10021 = ~Тон твоего голоса заставляет его поспешно объясниться. «Да, рубака, но тебе не стоит беспокоиться. Зараженные районы города запечатаны и все находится под контролем».~
@10022 = ~«Э-э... Ладно. Позволь мне спросить кое о чем еще...»~
@10023 = ~«Ты мне очень помог. Прощай».~
@10024 = ~«Новости... Ну, я слышал, что в скором времени будет проведена казнь... кроме этого, больше ничего не могу вспомнить, рубака».~
@10025 = ~«Кого и за что будут казнить?»~
@10026 = ~«Хорошо. Мне нужно спросить тебя еще кое о чем».~
@10027 = ~«Понятно. Спасибо за информацию. Прощай».~
@10028 = ~Он пожимает плечами. «Не знаю, рубака. Не нас с тобой... так что какая разница?»~
@10029 = ~«Пожалуй, никакой. Позволь мне спросить кое о чем еще...»~
@10030 = ~«Ясно. Я должен идти. Прощай».~
@10031 = ~«Бюргер Товус Гильяф. Его можно найти в здании администрации на городской площади».~
@10032 = ~«Понятно. Что ты можешь рассказать мне про Товуса?»~
@10033 = ~«Большое спасибо. Я хочу спросить тебя кое о чем еще».~
@10034 = ~В первый раз он поднимает голову и встречается с тобой взглядом. «Ничего, рубака. Абсолютно ничего. Если у тебя есть вопросы насчет его правления, тебе нужно задать их ему самому». Он опускает взгляд.~
@10035 = ~«Ладно, наверно, так и сделаю. Позволь задать тебе еще один вопрос».~
@10036 = ~«Понятно. Ладно, мне нужно идти. Прощай».~
@10037 = ~Перед тобой мужчина жуликоватого вида. Наблюдая за ним, ты приходишь к выводу, что он присматривается к дому неподалеку.~
@10038 = ~«Приветствую».~
@10039 = ~Оставить его в покое.~
@10040 = ~Он кажется довольно дружелюбным, отвечая на твое приветствие. «И тебе доброго дня». Он разворачивается и начинает удаляться.~
@10041 = ~«Погоди минутку. Я хотел задать тебе вопрос».~
@10042 = ~Пусть уходит.~
@10043 = ~Он останавливается и поворачивается к тебе с приветливой улыбкой. «Конечно, чем могу помочь?» Ты замечаешь, что его руки сложены по бокам в немного неестественном положении. Наметанным взглядом ты определяешь, что он вроде как готов выхватить спрятанное оружие.~
@10044 = ~«Ты только что разглядывал то здание?»~
@10045 = ~«Я ищу одного дэва. Мне сказали, что он в Проклятом».~
@10046 = ~«Неважно».~
@10047 = ~Он смотрит на тебя с некоторым удивлением. «Ну, вообще-то, нет. А что? Там есть что-нибудь интересное?» Он поворачивается и начинает осматривать упомянутое тобой здание.~
@10048 = ~«Брось, я ведь не дурак. Ты разведываешь место перед ограблением!»~
@10049 = ~«Да ну?»~
@10050 = ~«Неважно, я ошибся. И все же у меня к тебе вопрос. Я разыскиваю дэва, который может быть в городе».~
@10051 = ~«Извини, я ошибся. Мне пора».~
@10052 = ~Он смотрит на тебя, оценивая, чего ты стоишь. Затем он делает ловкое движение руками и глядит на тебя невинным взглядом. Взглянув вниз, ты замечаешь блеск монет в его рукаве. «Уверяю тебя, приятель, ты ошибся. Я всего лишь наслаждаюсь прогулкой в этот чудный день».~
@10053 = ~«Да, уверен, что так оно и есть. Извини... приятель».~
@10054 = ~«Нет, я почти уверен, что ты делал кое-то другое».~
@10055 = ~Он делает шаг вперед и по-дружески хлопает тебя по спине. При этом ты ощущаешь, как твой кошелек тяжелеет. «Тогда до свиданья, приятель. До новых встреч».~
@10056 = ~«Прощай».~
@10057 = ~Он мрачно смотрит на тебя. «Тогда мне придется... удвоить усилия, убеждая тебя в обратном. Однако имей в виду, что я больше не буду стараться переубедить тебя». Еще одно ловкое движение — и ты видишь блеск монет в обоих его рукавах.~
@10058 = ~«Пожалуй, да. Я уверен, что ты просто наслаждался прогулкой, как ты и сказал».~
@10059 = ~«Нет, я знаю, что видел».~
@10060 = ~Он делает шаг вперед и по-дружески хлопает тебя по спине. При этом ты ощущаешь, как твой кошелек тяжелеет. «Тогда до свиданья, приятель. До новых встреч».~
@10061 = ~«Прощай».~
@10062 = ~Он неодобрительно смотрит на тебя и делает движение руками. Блеск золота становится блеском стали. «Мне жаль, что мы так и не договорились».~
@10063 = ~«Вот сейчас ты действительно пожалеешь».~
@10064 = ~Он с удивлением смотрит на тебя. «Правда?.. Я нахожу этот факт весьма примечательным. Это место не из тех, в которых можно встретить дэва. Но если это так, тебе следует осведомиться в таверне 'Ворота предателей'. Насколько я понимаю, там торгуют подобными сведениями».~
@10065 = ~«Спасибо, так и сделаю».~
@10066 = ~«Где можно найти это место?»~
@10067 = ~«Извини, приятель, я там не бывал, так что точно не скажу. Однако ты в нужном районе. Просто осмотрись вокруг».~
@10068 = ~«Спасибо и прощай».~
@10069 = ~Жулик выглядит слегка встревоженным, встретив тебя снова. «О, не мой ли это старый приятель? Пришел навестить меня снова? Ценю твою учтивость, но, знаешь ли, я тут пытаюсь работать».~
@10070 = ~«Я здесь за деньгами, а не болтовней».~
@10071 = ~Он мрачно смотрит на тебя; его тон становится крайне серьезным. «Послушай, дружище. Ты меня поймал и, как профессионал профессионалу, я заплатил тебе, чтобы ты меня оставил. Давай закончим на этом и останемся друзьями».~
@10072 = ~«Я разыскиваю дэва. Я слышал, что он где-то в Проклятом».~
@10073 = ~«Извини за беспокойство, просто хотел подойти поздороваться».~
@10074 = ~«Ладно. Тогда мне пора».~
@10075 = ~«Я так не думаю. Подкинь-ка золотишка, или я тебя уложу».~
@10076 = ~«Мне жаль, что мы так и не договорились».~
@10077 = ~«Вот сейчас ты действительно пожалеешь».~
@10078 = ~«Ха! Да тебя заметить не сложнее, чем сиськи у осла! Ох и развелось же любителей в городе! — она поворачивается к тебе. — Не зря ты его заметил. Он разведывает местечко, чтобы обчистить какого-нибудь бедолагу».~
@10079 = ~«Похоже, ты права, Анна. Возможно, нам следует что-нибудь с этим сделать». ~
@10080 = ~Этот неряшливый человек моментально замечает, что привлек твое внимание: через секунду он уже перед тобой, демонстрирует свои «товары». В руках у него длинный шест, на который насажена дюжина освежеванных и приготовленных крыс. Разговаривая с тобой, он без конца указывает на них широкой, покрытой грязью рукой и скалится желтыми кривыми зубами. «Оле, рубака, как делишки? Какие из этих вааасхитительных крысочек приглянулись тебе в этот превосходный день?»~
@10081 = ~КУЛОН ЙЕМЕТА
Вес: 1

Кулон Йемета назван в честь своего создателя, колдуна ушедшей эпохи. Хотя Йемет обладал большим могуществом, время начало брать над ним верх: он начал слабеть умом и телом. Кулон был создан умирающим магом, чтобы послужить ему в качестве вместилища душ, которые Йемет мог бы вытянуть из умирающих смертных и позже использовать для подпитки своей убывающей жизненной силы. В конце концов, Йемет погиб в битве и был полностью уничтожен, а кулон потерялся. Мудрецы говорят, что даже если бы кулон был найден, никому из смертных неизвестен секрет его использования.

Ты уверен, что уже раньше видел этот кулон... может быть, даже носил его.~
@10082 = ~~
@10083 = ~~
@10084 = ~~
@10085 = ~~
@10086 = ~~
@10087 = ~~
@10088 = ~~
@10089 = ~Перед тобой девушка в дешевой одежде, надушенная дешевыми духами, с нарисованной улыбкой на лице. Заметив твое внимание, она улыбается.~
@10090 = ~«Приветствую».~
@10091 = ~Игнорировать ее.~
@10092 = ~Она делает шаг тебе навстречу, кладет одну руку на плечо, а другой обхватывает поясницу. Улыбаясь, она медленно проводит рукой по плечу. «Ты такой сильный, рубака. Мне нравятся сильные парни, они могут взять, что хотят». Внезапно она прижимается к тебе. «Так скажи мне... чего хочешь ты?»~
@10093 = ~«Э-э... Просто ответь на несколько вопросов».~
@10094 = ~«Неважно. Я должен идти».~
@10095 = ~Она смотрит тебе в глаза, улыбка становится еще более чарующей. «Я здесь не для разговоров. Ты уверен в том, чего хочешь?»~
@10096 = ~Эта девушка слишком агрессивна. Что-то здесь не так.~
@10097 = ~«Ну... Возможно, мне стоит немного развлечься».~
@10098 = ~«Ну... Возможно, мне стоит немного развлечься».~
@10099 = ~«Неважно. Мне нужно идти».~
@10100 = ~Тебе кажется, что с этой девушкой что-то не так. Ты резко отталкиваешь ее. Почувствовав рывок в ее сторону, ты смотришь вниз и замечаешь, как она достает *пустую* руку из твоего кошелька. Она пытается поскорее отойти от тебя.~
@10101 = ~Схватить ее.~
@10102 = ~Схватить ее.~
@10103 = ~Позволить ей уйти.~
@10104 = ~Ты ловко ее хватаешь за запястье. Она сопротивляется и отчаянно пытается освободиться. «Отпусти меня, пень, или я позову стражу!»~
@10105 = ~«Давай, кричи. Когда кто-нибудь появится, ты уже будешь мертва».~
@10106 = ~«Давай, кричи. Вряд ли в этом городе кто-нибудь даже обернется».~
@10107 = ~Позволить ей уйти.~
@10108 = ~Внимательно тебя рассмотрев, она прекращает борьбу. «Пожалуйста, отпусти меня. Я не успела тебя обчистить».~
@10109 = ~«Выкладывай все деньги и можешь уйти».~
@10110 = ~«Отлично. Больше не попадайся мне здесь. Понятно?»~
@10111 = ~Она кивает и запускает руку в кошелек. Достав оттуда небольшую горсть монет, она протягивает их тебе. «Прошу, рубака. Мне нечего будет есть, если ты заберешь все звенелки. Пожалуйста, отпусти меня».~
@10112 = ~Взять деньги и отпустить ее.~
@10113 = ~Взять деньги и убить ее.~
@10114 = ~Позволить ей уйти.~
@10115 = ~Ты забираешь монеты. Она продолжает смотреть на тебя, затем поворачивается и медленно уходит прочь.~
@10116 = ~Позволить ей уйти.~
@10117 = ~Ты отпускаешь ее и взмахом руки разрешаешь уйти. Она продолжает смотреть на тебя, затем слабо улыбается. «Спасибо, рубака». Она поворачивается и медленно уходит прочь.~
@10118 = ~Уйти.~
@10119 = ~Ты пытаешься схватить ее за запястье, но она ловко уворачивается от тебя. Отскочив, она готовится убежать.~
@10120 = ~Атаковать ее.~
@10121 = ~Позволить ей уйти.~
@10122 = ~Она выпускает тебя из своей хватки и, улыбаясь, отступает от тебя. «Извини, рубака. Я передумала. Всего хорошего». Она поворачивается и уходит.~
@10123 = ~Позволить ей уйти.~
@10124 = ~Перед тобой женщина в возрасте, одетая в дешевую одежду. Похоже, она изо всех сил старается выглядеть моложе и привлекательнее, чем она есть на самом деле. Рядом с ней ты улавливаешь запах дешевого вина.~
@10125 = ~«Приветствую».~
@10126 = ~Игнорировать ее.~
@10127 = ~Она поворачивается к тебе, ее лицо побагровело от слишком большого количества выпитого. «А, приве-е-ет. Ищешь себе... компанию?» Она улыбается тебе, потом смотрит на тебя так, словно видит тебя впервые. «О-о-о, да на тебе живого места нет. Что... что с тобой случилось?»~
@10128 = ~«Я надеялся задать тебе пару вопросов».~
@10129 = ~«Не твое дело».~
@10130 = ~«Неважно. Прощай».~
@10131 = ~Она наклоняется к тебе и прикладывает ладони к твоей груди. «Никаких... вопросов. У тебя есть звенелки... а у меня есть талант. Моя берлога рядом, за углом. Пойдем».~
@10132 = ~«Я в этом не заинтересован. Мне нужна от тебя кое-какая информация».~
@10133 = ~«Сколько?»~
@10134 = ~«Неважно. Прощай».~
@10135 = ~Она кладет руки на бедра. «По... послушай, пень. Мне нужно сводить концы с концами, сечешь? Ты, кажись, слегка запутался... я что, похожа на мудреца? У меня для тебя только один ответ». Она раскрывает перед тобой объятия.~
@10136 = ~«Неважно. Прощай».~
@10137 = ~«Сколько?»~
@10138 = ~Она улыбается и хихикает. «А-а-а, вот о чем разговор... пять монет — и я могу кричать, но никому не скажу...» Он выжидательно на тебя смотрит.~
@10139 = ~«Прости, но у меня нет денег».~
@10140 = ~«Идем...»~
@10141 = ~«Неважно. Прощай».~
@10142 = ~Она ведет тебя в свою берлогу. Спустя час она возвращается вместе с тобой назад на улицу. «Приходи еще... Тебе понравится». Она улыбается и машет рукой.~
@10143 = ~«Счастливо».~
@10144 = ~Она хмурится. «Эй... грубить-то зачем. Не умеешь быть деликатным — не буду проводить с тобой время. Кыш!» Она отворачивается и уходит.~
@10145 = ~Оставить ее в покое.~
@10146 = ~Перед тобой молодая девушка в дешевом платье. Корсаж определенно затянут сильнее, чем следует, от чего ее огромная грудь буквально вываливается наружу.~
@10147 = ~«Приветствую».~
@10148 = ~Игнорировать ее.~
@10149 = ~Едва взглянув на тебя, она напускает на себя скучающее выражение лица. «На мой вкус, ты немного грубоват. Наверное, тебе стоит уйти, рубака».~
@10150 = ~«О чем это ты?»~
@10151 = ~«Я просто хочу задать пару вопросов».~
@10152 = ~«Э-э-э... Да. Прощай».~
@10153 = ~Она бросает на тебя лукавый взгляд и наклоняется вперед. «Пораскинь мозгами, пень. Каким, по-твоему, делом я занимаюсь? — взглянув на свою грудь, она подмигивает тебе. — Видишь что-нибудь себе по нраву?»~
@10154 = ~«Если ты считаешь, что я не в твоем вкусе, зачем тогда демонстрируешь свой 'товар'...» Тебе никак не удается подобрать подходящее слово.~
@10155 = ~«Я хотел задать тебе пару вопросов».~
@10156 = ~«Да, и во сколько мне это обойдется?»~
@10157 = ~«Вроде нет. Мне пора идти».~
@10158 = ~Хихикнув, она выпрямляется. «Просто немного развлекаюсь, вот и все. Хочешь чего-нибудь?»~
@10159 = ~«Я хотел задать тебе пару вопросов».~
@10160 = ~«Да, и во сколько мне это обойдется?»~
@10161 = ~«Вроде нет. Мне пора идти».~
@10162 = ~Она гневно смотрит на тебя. «Эй! Задвинься, пень. Я лучшее, что ты сможешь найти на улицах!»~
@10163 = ~«Прощай».~
@10164 = ~Она улыбается тебе. «Ну, тогда счастливо».~
@10165 = ~Она вздыхает и скучающе смотрит на тебя. «Что ты хочешь узнать?»~
@10166 = ~«Прощай».~
@10167 = ~«Я ищу одного дэва. Мне сказали, что он в Проклятом».~
@10168 = ~«Какие последние новости?»~
@10169 = ~«Кто здесь главный?»~
@10170 = ~«Что ты можешь сказать о Проклятом?»~
@10171 = ~«Как тебя зовут?»~
@10172 = ~«Ничего. Прощай».~
@10173 = ~Она надувает губки, хмуря брови в задумчивости. Спустя мгновение она озаряется улыбкой. «Да, припоминаю. Он в тюрьме, — она снова хмурится. — Тебе не кажется, что это очень странное место для дэва?»~
@10174 = ~«В тюрьме? Ты уверена?»~
@10175 = ~«Понятно. Можно задать тебе еще один вопрос?»~
@10176 = ~«Ты мне очень помогла. Прощай».~
@10177 = ~Она хмурится. «Конечно, я уверена. Слыхала об этом от одного из стражников. Этот дэва чертовски крепко заперт. Не так давно землекопы расширяли территорию тюрьмы и пробили каменный пузырь — в нем он и оказался. Заковали его очень хорошо».~
@10178 = ~«Хм. Повидаться с ним будет непросто».~
@10179 = ~«Еще один вопрос».~
@10180 = ~«Прощай».~
@10181 = ~Лукаво улыбаясь, она протягивает ладонь. «Звенелки? Звенелки?»~
@10182 = ~Дать ей несколько монет.~
@10183 = ~Ложь: «Извини, у меня нет денег».~
@10184 = ~«Позволь задать тебе еще один вопрос».~
@10185 = ~«Неважно. Прощай».~
@10186 = ~Мило улыбнувшись тебе, она подается вперед, что позволяет тебе увидеть ее грудь во всей красе. «Сходи в бар 'Ворота предателей' и поспрашивай там. Тамошние посетители помогут тебе». Она бросает монеты себе в корсаж.~
@10187 = ~«Спасибо, я так и сделаю. Позволь мне спросить кое о чем еще».~
@10188 = ~Она вздыхает, надув губки. «Наверное, я спятила, и все же я тебе помогу. Сходи в бар 'Ворота предателей' и поспрашивай. Тамошние посетители помогут тебе».~
@10189 = ~«Спасибо, я так и сделаю. Позволь мне спросить кое о чем еще».~
@10190 = ~«Ну... Чуму наконец-то взяли под контроль. Несколько районов запечатали, чтобы не дать ей расползтись. Закрыли даже ворота в Карцери на городской площади». Задумываясь, она умолкает.~
@10191 = ~«Продолжай».~
@10192 = ~«Извини, что перебиваю. Чуму?»~
@10193 = ~«Благодарю за помощь. Прощай».~
@10194 = ~«Дочь Гниющего Копчика пропала. Из-за этого он немного не в духе и теперь ищет какого-нибудь громилу, готового помочь ему разыскать ее».~
@10195 = ~«Продолжай».~
@10196 = ~«Кто такой Гниющий Копчик и где мне его найти?»~
@10197 = ~«Прими мою благодарность. Прощай».~
@10198 = ~«Какой-то бедолага расстанется со своей головой. На сегодня у него назначено свидание с палачом на городской площади. Как отвратительно». Хмурясь, она отводит взгляд.~
@10199 = ~«Продолжай».~
@10200 = ~«А что он натворил?»~
@10201 = ~«Спасибо тебе, красавица. Прощай».~
@10202 = ~Она погружается в раздумья. «Больше ничего не могу вспомнить». Она пожимает плечами.~
@10203 = ~«Похоже, ты весьма хорошо информирована. Я впечатлен».~
@10204 = ~«Если можно, я хотел бы спросить тебе о еще кое о чем».~
@10205 = ~«Я тебе очень признателен. Прощай, красавица».~
@10206 = ~Она наклоняется вперед, соблазнительно улыбаясь и хлопая ресницами. «Просто люди любят со мной пооткровенничать. Даже не знаю почему». Хихикая, она выпрямляется.~
@10207 = ~«Э-э-э... Я и сам не пойму, почему. Так или иначе, я хотел спросить у тебя еще кое о чем».~
@10208 = ~«Прощай».~
@10209 = ~«Да, но ты не волнуйся. Теперь она под контролем — зараженные районы на карантине».~
@10210 = ~«Понятно. Продолжай».~
@10211 = ~«А эта чума случаем не вспыхнула сразу после того, как откопали темницу с дэва?»~
@10212 = ~«Я должен идти. Прощай».~
@10213 = ~«Он хозяин 'Ворот предателей'. Кажется, они на той стороне». Она указывает вниз по улице.~
@10214 = ~«Продолжай».~
@10215 = ~«Спасибо за помощь. Прощай».~
@10216 = ~Хмурясь, она отводит взгляд. Мгновение спустя она пожимает плечами. «Точно не скажу. Никто из моих... контактов не упоминал причину».~
@10217 = ~«Продолжай».~
@10218 = ~«Ты мне очень помогла. Прощай».~
@10219 = ~Она хихикает. «Товус, наверное. Товус Гильяф. Он бывает весьма... эксцентричным, но со мной он всегда мил и щедро платит». Она колеблется, словно размышляя, как ей лучше поступить. «Вообще мне не следует говорить Товусе. Ты можешь найти его в административном здании на городской площади».~
@10220 = ~«Хорошо, еще один вопрос».~
@10221 = ~«Мне пора идти».~
@10222 = ~«Проклятый... — она вздыхает с несчастным видом. — Этот город — клетка для одиноких. Бедолаги, которых ты здесь видел, попадают сюда за вероломство и предательство. Теперь они живут, изо дня в день оглядываясь по сторонам, гадая, кому можно доверять и кого называть другом».~
@10223 = ~«Включая и тебя?»~
@10224 = ~«Интересно. Кажется, мне пора».~
@10225 = ~Она с тоской отводит взгляд. «Я сделала то, что сделала, и теперь сожалею об этом... — она снова поворачивается к тебе. — Вот тебе бесплатный совет: чего бы ты ни натворил в своей жизни, сумей себя простить».~
@10226 = ~«Я запомню это. Можно спросить тебя кое о чем еще?»~
@10227 = ~«Прощай».~
@10228 = ~Она снова окидывает тебя взглядом. «Ну... Если обещаешь не обижать меня и хорошо со мной обращаться... десять медяков».~
@10229 = ~«Соблазнительно... Но сейчас у меня нет на это времени. Можно спросить тебя кое-что еще?»~
@10230 = ~«Прошу прощения, но мне пора. Прощай».~
@10231 = ~Она хмурит брови в раздумьях, потом смотрит куда-то вдаль. Наконец она возвращается к тебе. «Знаешь, я ведь и не думала об этом, но, кажется, ты прав. Чума вспыхнула сразу после того, как его нашли».~
@10232 = ~«Понятно. Продолжай».~
@10233 = ~«Ты мне очень помогла. Прощай».~
@10234 = ~Она мило улыбается тебе. «Меня зовут Шарлин, но друзья зовут меня просто Шар».~
@10235 = ~«Шар — очень милое имя. Позволь мне спросить тебя кое о чем еще».~
@10236 = ~«Ты мне очень помогла. Прощай, Шар».~
@10237 = ~Хранилище Тленных~
@10238 = ~«У тебя мой глаз, верно? Я хочу его выкупить».~
@10239 = ~«Кто ты?»~
@10240 = ~«Что это за место?»~
@10241 = ~«Что ты можешь рассказать о здешних посетителях?»~
@10242 = ~«Я хочу что-нибудь выпить».~
@10243 = ~«Я ищу дневник».~
@10244 = ~«Я ищу Фарода, сборщика».~
@10245 = ~«Снова вернулся? Чего опять?»~
@10246 = ~«Когда я разговаривал с тобой в первый раз, ты сказал 'опять ты'. Что ты имел в виду?»~
@10247 = ~«Ты говорил, что у тебя есть мой глаз. Я бы хотел его вернуть».~
@10248 = ~«Кто ты?»~
@10249 = ~«Что это за место?»~
@10250 = ~«Что ты можешь рассказать о здешних посетителях?»~
@10251 = ~«Я хочу что-нибудь выпить».~
@10252 = ~«У тебя больше не будет проблем с Мочай».~
@10253 = ~«Я хочу что-нибудь выпить».~
@10254 = ~«Я ищу дневник».~
@10255 = ~«Я ищу Фарода, сборщика».~
@10256 = ~«Что ты можешь рассказать о здешних посетителях?»~
@10257 = ~«Не можешь побыстрее? У меня еще куча клиентов».~
@10258 = ~«Когда я разговаривал с тобой в первый раз, ты сказал 'опять ты'. Что ты имел в виду?»~
@10259 = ~«Ты говорил, что у тебя мой глаз. Я бы хотел его выкупить».~
@10260 = ~«Кто ты?»~
@10261 = ~«Что это за место?»~
@10262 = ~«Что ты можешь рассказать о здешних посетителях?»~
@10263 = ~«Я хочу что-нибудь выпить».~
@10264 = ~«Я позаботился о должнике».~
@10265 = ~«Я хочу что-нибудь выпить».~
@10266 = ~«Я ищу дневник».~
@10267 = ~«Я ищу Фарода, сборщика».~
@10268 = ~«Аукционист Гилтспур хочет, чтобы ты повесил этот рекламный листок».~
@10269 = ~«Ну да, 'опять ты'. У тебя, видать, теперь проблемы со слухом? Ты ввалился сюда лет пятнадцать назад, напился в стельку, разнес все заведение и оставил кучку монет, которых не хватило на покрытие убытков. И вот ты выковыриваешь собственный кровоточащий глаз и заявляешь, что заберешь его, как только наскребешь двести монет. С учетом процентов за пятнадцать лет ты должен около пяти сотен. Гони звенелки — получишь свой глаз».~
@10270 = ~«Пятьсот? Это же смешно!»~
@10271 = ~«Пятьсот? Это же смешно!»~
@10272 = ~«Пятьсот? Хорошо. Вот».~
@10273 = ~«У меня нет столько».~
@10274 = ~«Сейчас мне это неинтересно. Лучше ответь на пару вопросов».~
@10275 = ~«Забудь. Прощай».~
@10276 = ~Он в раздумьях умолкает. «Ну хорошо. Вот что скажу. Гони три сотни, и глаз — твой».~
@10277 = ~«По рукам. Вот твои деньги».~
@10278 = ~«Я все еще не могу себе это позволить».~
@10279 = ~«Забудь. Лучше ответь на пару вопросов».~
@10280 = ~«Забудь. Я еще вернусь».~
@10281 = ~«Такова цена. Плати или вали».~
@10282 = ~«Хорошо, я заберу его».~
@10283 = ~«У меня нет столько».~
@10284 = ~«Забудь. Лучше ответь на пару вопросов».~
@10285 = ~«Я свалю. Прощай».~
@10286 = ~«По рукам». Он достает из кармана темную, закупоренную воском бутылку с широким горлышком. Ты слышишь звук булькающей жидкости, сливающийся с тяжелым хлюпаньем. Запах какого-то предохраняющего состава из открытой бутыли вызывает у тебя тошноту. В вязкой жиже плавает глазное яблоко. «Тебе бы лучше побыстрей придумать, что ты будешь с ним делать... теперь он на открытом воздухе. Самое лучшее, что можно сделать — это снова засолить его в кувшине как яйцо. Соображай, рубака... соленое яйцо или как?» ~
@10287 = ~Вытащить свой глаз и поместить на его место старый.~
@10288 = ~Вытащить свой глаз и поместить на его место старый.~
@10289 = ~Вытащить свой глаз и поместить на его место старый.~
@10290 = ~Смотреть как он разлагается.~
@10291 = ~«Ну тогда ты глаз назад не получишь. Уяснил? Возвращайся, когда наберешь звенелок».~
@10292 = ~«Хорошо. В таком случае, ответь на несколько вопросов».~
@10293 = ~«Ладно. Прощай».~
@10294 = ~Немного поколебавшись, ты вырываешь свой глаз из глазницы. Трактирщик услужливо рассекает глазной нерв и направляет твою руку к стоящему на стойке кувшину с жижей. Ты помещаешь глаз в предохраняющий состав, обхватываешь пальцами старый и помещаешь его в пустую глазницу. Спустя мгновение ты чувствуешь, что глазной нерв сам присоединяется к новому глазу... и неожиданно тебя подкашивает вспышка памяти!~
@10295 = ~Впитать ее.~
@10296 = ~Вспышка памяти: Перед тобой расстилается обширная, хаотично меняющаяся пустошь. На тебя надвигается группа человекоподобных стервятников, их грубое оружие готово нанести удар; твой сверкающий клинок крепко сжат в руке...

Вспышка памяти: Тебя окружили три громилы, одетые во вражеские цвета, которых ты не можешь распознать. В их руках длинные кинжалы, обнаженные зубы зловеще сверкают. Ты смотришь на свои покрытые шрамами руки и понимаешь, что очень скоро они покроются кровью...

Вспышка памяти: над/за/под какой-то хаотичной материей к тебе движется какое-то огромное жабообразное существо со ртом, полным зубов. Ты бросаешь дротик в существо сквозь движущуюся материю и пригвождаешь его к невесть откуда взявшемуся каменному постаменту... Ты вспомнил несколько забытых боевых навыков.~
@10297 = ~Задать еще несколько вопросов Баркису.~
@10298 = ~Уйти.~
@10299 = ~Ты запускаешь руку в глазницу. Боль очень сильная, невыносимая, и она неожиданно захлестывает тебя. Ты падаешь на землю, кровоточа своей развороченной глазницей. Ты умираешь.~
@10300 = ~Готово.~
@10301 = ~«Хочешь его вернуть? Цена — пять сотен монет. Если у тебя их нет, ты его не получишь».~
@10302 = ~«Пятьсот? Это же смешно!»~
@10303 = ~«Пятьсот? Это же смешно!»~
@10304 = ~«Пятьсот? Хорошо. Вот».~
@10305 = ~«У меня нет столько».~
@10306 = ~«Сейчас мне это неинтересно. Лучше ответь на пару вопросов».~
@10307 = ~«Забудь. Прощай».~
@10308 = ~«Я? Я — Баркис. Хозяин и хранитель этого заведения».~
@10309 = ~«Что это за место?»~
@10310 = ~«Тогда ты — тот, кто отвечает на вопросы».~
@10311 = ~«Неплохое местечко. Прощай».~
@10312 = ~«Ты что, не заметил вывески у входа? Не увидел горящего над жаровней пня, когда заходил? Это 'Тлеющий труп', рубака, самый лучший кабак в этой части Улья, что делает его одним из лучших во всем Сигиле. Черт, есть места, разукрашенные цветами, как в Районе Леди, есть демонические таверны, рассованные по всему Улью, но ни один из них не сравнится с 'Тлеющим трупом'».~
@10313 = ~«А все-таки, кто этот труп?»~
@10314 = ~«Понятно. Не расскажешь мне еще что-нибудь?»~
@10315 = ~«У каждого своя правда. Прощай».~
@10316 = ~«Он-то? Это Игнус. Он был огненным магом, который выжег часть Улья, за что его и повязали другие маги. Если хочешь узнать о нем больше, иди поговори с Друзиллой у входа».~
@10317 = ~«Хорошо. Но я хочу знать кое о чем еще».~
@10318 = ~«Хорошо, я так и сделаю. Прощай».~
@10319 = ~«Я не вмешиваюсь в жизни тех, кто платит мне свои кровные звенелки, если только они сами об этом не попросят. Итак. Вон там — Кандриан. Путешественник по планам. Он из тех, кто сможет ответить на любой вопрос по планам — он был почти везде. Вон там — Эбб Коленоскрип, старый громила из Гармониума; не стой у него а пути. Еще он — осведомитель. У него хорошее сердце, и он знает Сигил сверху донизу. Тех нечистых зовут Аэтелгрин и Тегарин. Мой тебе совет: не связывайся с ними. Может быть, они и низшие в иерархии нечисти, но все же они — нечистые духи. А вон там — Илквикс — НЕ верь ему — и несколько убийц милосердия, высматривают несчастного бедолагу. Гитцерай Даккон для меня — загадка. Он почти не разговаривает. И вот, кстати — не хочешь заработать бесплатную выпивку?»~
@10320 = ~«Да».~
@10321 = ~«Нет, не хочется. Ты можешь ответить на мои вопросы?»~
@10322 = ~«Там, у дальней стенки, есть выпивоха, прячется в тени. Пытается набраться смелости и улизнуть, не заплатив должок. Я хочу, чтобы ты позаботился о том, чтобы у нее ничего не вышло. Сделаешь — получишь бесплатную выпивку на всю жизнь».~
@10323 = ~«Нет. Я должен идти. Прощай».~
@10324 = ~«Я сделаю это. Но сначала ответь на пару вопросов».~
@10325 = ~«Нет, спасибо. Лучше ответь на пару вопросов».~
@10326 = ~«Я сделаю это. Дам тебе знать, когда закончу».~
@10327 = ~«Нет, спасибо. Прощай».~
@10328 = ~«Чего хочешь? У нас есть обычное пиво за медяк, горькое — за два, медовуха — за четыре. У нас есть вода прямиком со стихийного плана за восемь медяков, арборейское огненное вино с огненными семенами за десять, сердечное вино из Проклятого за восемь, бааторийский виски за двадцать. Чего будешь?»~
@10329 = ~«Пиво».~
@10330 = ~«Пиво».~
@10331 = ~«Горькое».~
@10332 = ~«Горькое».~
@10333 = ~«Медовуху».~
@10334 = ~«Медовуху».~
@10335 = ~«Воду».~
@10336 = ~«Воду».~
@10337 = ~«Огненное вино с семенами».~
@10338 = ~«Огненное вино с семенами».~
@10339 = ~«Хочешь выпить — получай. Вот что у нас есть: пиво, горькое пиво, медовуха, стихийная вода, арборейское огненное вино с огненными семенами, сердечное вино из Проклятого и бааторийский виски. Чего будешь?»~
@10340 = ~«Сердечное вино».~
@10341 = ~«Сердечное вино».~
@10342 = ~«Виски».~
@10343 = ~«Виски».~
@10344 = ~«Информацию».~
@10345 = ~«Ничего. Прощай».~
@10346 = ~«Пиво».~
@10347 = ~«Горькое».~
@10348 = ~«Медовуху».~
@10349 = ~«Воду».~
@10350 = ~«Огненное вино с семенами».~
@10351 = ~«Сердечное вино».~
@10352 = ~«Виски».~
@10353 = ~«Информацию».~
@10354 = ~«Ничего. Прощай».~
@10355 = ~Хозяин хмуро смотрит тебя. «У тебя не хватит на это звенелок. И в долг ты тоже не получишь. Я уже много раз прогорал на этом. Еще что-нибудь?»~
@10356 = ~«Что у тебя из напитков?»~
@10357 = ~«Да. Информацию».~
@10358 = ~«Ничего. Извини».~
@10359 = ~Ты потягиваешь слабый напиток. Вкус не сильно выраженный, но насыщенный, и уж точно содержит алкоголь. Похоже, тебе он больше ничего не даст. «Чего еще, рубака?»~
@10360 = ~«Налей чего-нибудь еще».~
@10361 = ~«Налей чего-нибудь еще».~
@10362 = ~«А, неважно. Ответь мне на пару вопросов».~
@10363 = ~«Ничего».~
@10364 = ~Он уходит назад к бочонку у стены и поворачивает краник. Из него в подставленный стакан льется прозрачнейшая вода, которую ты только видел. Он ставит его перед тобой, и ты делаешь большой глоток. Это чистейшая вещь из тех, что ты пробовал. Прохлада присуща самой воде; ощущение воздушности проходит через твой язык и попадает в живот, где на миг утоляет твои даже самые горячие желания. «Прямо из сердца Стихийного плана воды, — хмыкает бармен. — Любая другая вода по сравнению с этой покажется грязной на вкус».~
@10365 = ~«Налей чего-нибудь еще!»~
@10366 = ~«Это было великолепно. Налей чего-нибудь еще».~
@10367 = ~«На этот раз я бы хотел задать несколько вопросов».~
@10368 = ~«Совершенное ощущение. Спасибо. Прощай».~
@10369 = ~Он приносит тебе стакан с темно-красным вином и пригоршней ярких семян. «Засунь семена в рот и глотни вина, — советует он, — Не удивляйся, когда семена загорятся: они не причинят тебе вреда. Этот вкус ни на что не похож». Он прав. Когда ты кладешь семя в рот, оно смешивается со слюной и сгорает слабым пламенем. Ты гасишь его глотком огненного вина, вкус при этом получается невообразимый. Баркис улыбается. «Еще хочешь?»~
@10370 = ~«Черт, да. Налей чего-нибудь еще».~
@10371 = ~«Продолжим».~
@10372 = ~«Не сейчас, спасибо. Вместо этого я хочу задать тебе несколько вопросов».~
@10373 = ~«Не сейчас. Прощай».~
@10374 = ~Он приносит тебе знаменитое сердечное вино из Проклятого. От букета перехватывает дыхание, само вино густое и ароматное. Послевкусие — выше всех ожиданий. «Сделано из настоящего остролистника, так-то. Хотел бы я знать его секрет, — хозяин кивает на пустой стакан. — Еще хочешь?»~
@10375 = ~«Да, конечно».~
@10376 = ~«Да, конечно».~
@10377 = ~«Нет, но я хотел бы задать несколько вопросов».~
@10378 = ~«Нет, спасибо».~
@10379 = ~Он ставит перед тобой некую бурлящую субстанцию, которая больше похожа на кипящую мочу. При всем при этом до тебя доносится довольно-таки соблазнительный аромат. Вкус, горячий до невозможности, такой же дымный, как и запах. Ощущение того, как напиток прожигает себе путь в твои внутренности, граничит с болью, но даже эта боль приятна. Хозяин смотрит на тебя во все глаза. «Ты все еще стоишь? Большинство не может сделать и половины глотка».~
@10380 = ~«Я в порядке. Я даже ничего не чувствую».~
@10381 = ~«Налей чего-нибудь еще».~
@10382 = ~«Налей чего-нибудь еще».~
@10383 = ~«Я довольно стойкий. Не ответишь на пару вопросов?»~
@10384 = ~«Большинство неспособно на то, на что способен я. Прощай».~
@10385 = ~Глаз разлагается прямо на глазах, растекаясь в вязкую зловонную жижу. Хозяин размахивает руками перед лицом, пытаясь отогнать вонь. «Что за бестолковая трата денег. Еще что-нибудь?»~
@10386 = ~«Верни мне деньги. Сейчас же».~
@10387 = ~«Просто ответь на несколько вопросов».~
@10388 = ~«Нет. Прощай».~
@10389 = ~«Послушай-ка, пень. Если ты решил, что ничего не хочешь делать со своей покупкой, то это вовсе не означает, что она испортилась по моей вине. Тебе зачем-то понадобился глаз, и тебе следовало проделать тот старый трюк с глазом, как раньше. Теперь это уже не моя проблема».~
@10390 = ~«Она станет твоей, если я убью тебя».~
@10391 = ~«Пожалуй, нет. Тогда ответь на мои вопросы».~
@10392 = ~«Быть может, она станет твоей позже. Всего хорошего».~
@10393 = ~«Полагаю, что нет. Прощай».~
@10394 = ~Он криво улыбается. «Ну попробуй».~
@10395 = ~«Забудь. Лучше ответь на пару вопросов».~
@10396 = ~«Забудь».~
@10397 = ~Атаковать его.~
@10398 = ~Хозяин осторожно тебя осматривает, держась за подбородок. «Знаешь, рубака, у некоторых есть природная невосприимчивость к ядам и всему такому. Кое-кто называет выпивку ядом. Если это так, то у тебя хорошие шансы против всяких отравителей».~
@10399 = ~«Хм, а как насчет... Ладно, налей мне еще чего-нибудь».~
@10400 = ~«Хм, а как насчет... Ладно, налей мне еще чего-нибудь».~
@10401 = ~«Это может пригодиться. Не ответишь на мои вопросы?»~
@10402 = ~«Хорошо. Спасибо и прощай».~
@10403 = ~«Дневник? Бумага и слова? Приятель, этого в Улье не так уж много водится. Многие даже с трудом смогут прочитать вывеску над дверью, не то что дневник. Если ты ищешь дневник, то тебе лучше придерживаться какой-нибудь системы, вместо того, чтобы расспрашивать всех подряд».~
@10404 = ~«Спасибо за непрошеный совет. Лучше ответь на другой вопрос».~
@10405 = ~«Ладно. Всего хорошего».~
@10406 = ~Он оборачивается и сплевывает на пол. «Фарода? Ха. С таким же успехом ты можешь повернуться к нему спиной и подождать, пока он не всадит в нее кинжал. Хотя, судя по твоему виду, его тебе уже всадили. Если тебе до смерти хочется найти Фарода — извиняюсь за каламбур — поговори с Эббом Коленоскрипом, он вон там. Он-то должен знать что-нибудь полезное».~
@10407 = ~«Тогда я так и сделаю, но после того, как ты ответишь на мои вопросы».~
@10408 = ~«Эббом? С тем стариком? Спасибо».~
@10409 = ~«Тогда, приятель, у тебя полный доступ к бару... бесплатно. Все, что ты захочешь, в любое время».~
@10410 = ~«Должно быть, у нее был довольно большой должок».~
@10411 = ~«Спасибо. У меня несколько вопросов...»~
@10412 = ~«Я потом к тебе загляну. Прощай».~
@10413 = ~«Ты не знаешь и половины. Хочешь выпить?»~
@10414 = ~«Наливай».~
@10415 = ~«Сейчас мне нужна информация».~
@10416 = ~«Нет. Но я вернусь».~
@10417 = ~«Огненные семена, уже идут!»~
@10418 = ~Этот крепкий румяный юноша, едва взглянув на тебя, неожиданно выпаливает: «Ты! Я слышал о тебе! Ох! Ты арестован! Нет, погоди... ты в очереди на казнь!» Он вырывает свое оружие и готовится замахнуться.~
@10419 = ~Атаковать его.~
@10420 = ~Сбежать.~
@10421 = ~Перед тобой парень, на вид ему — от силы восемнадцать. Похоже, его лицо выдает напряженность. «Помочь тебе, рубака?»~
@10422 = ~«Кто ты?»~
@10423 = ~«Я ищу дневник. Тебе он, случаем, не попадался?»~
@10424 = ~«Я ищу сборщика по имени Фарод. Может, ты видел его или знаешь, где его можно найти?»~
@10425 = ~«Что ты можешь сказать о Вейлоре?»~
@10426 = ~~
@10427 = ~«Кто твои друзья?»~
@10428 = ~«Что ты можешь рассказать об этом месте?»~
@10429 = ~«Что ты делаешь?»~
@10430 = ~«Нет. Прощай».~
@10431 = ~«Опять ты? Что тебе нужно?» Кажется, он нетерпелив и раздражителен.~
@10432 = ~«Ваш убийца еще не появлялся?»~
@10433 = ~«Кто ты?»~
@10434 = ~«Я ищу дневник. Тебе он, случаем, не попадался?»~
@10435 = ~«Я ищу сборщика по имени Фарод. Может, ты видел его или знаешь, где его можно найти?»~
@10436 = ~«Что ты можешь сказать о Вейлоре?»~
@10437 = ~«Кто твои друзья?»~
@10438 = ~«Что ты можешь рассказать об этом месте?»~
@10439 = ~«Что ты делаешь?»~
@10440 = ~«Нет. Прощай».~
@10441 = ~«Я — Калеб, убийца милосердия. Мы с Тарнером и Илсидоном ловим моего первого преступника».~
@10442 = ~«Что ты можешь сказать об убийцах милосердия?»~
@10443 = ~«Понятно. Я хотел бы задать другой вопрос».~
@10444 = ~«Удачи. Прощай».~
@10445 = ~«Дневник? Нет, извини. Я новенький и все еще не освоился. Если увижу — дам тебе знать». Он оглядывает взором бар.~
@10446 = ~«Что ты делаешь?»~
@10447 = ~«Спасибо. Можешь, между тем ответить на другие мои вопросы».~
@10448 = ~«Спасибо. Прощай».~
@10449 = ~«Они следят, чтобы я не наделал глупостей на этом посту. Тарнер — самый старший. Илсидон проверяет, чтобы я делал работу правильно, и поможет, если мне понадобится помощь, — он шумно сглатывает. — Надеюсь, не понадобится».~
@10450 = ~«Ты справишься, я в этом уверен. Сможешь ответить еще на парочку вопросов?»~
@10451 = ~«Да прибудет с тобой удача. Прощай».~
@10452 = ~«Об этом месте? Это 'Тлеющий труп'. Наверное, его так назвали в честь того парня у входа. Это место, где встречаются преступники и всякое отребье. Хотя... здесь водятся рубаки, которые знают, что говорят. Хотя некоторые из них — нечистые, и я не хотел бы связываться с ними. Мне кажется, что они пялятся мне прямо в душу».~
@10453 = ~«Я понял. Ответишь на другие вопросы?» ~
@10454 = ~«Они-то смогут. Прощай».~
@10455 = ~«Ну, я, как убийца милосердия, должен отдавать преступников в руки правосудия, чтобы показать, что я могу справляться со своей работой. Я решил поймать убийцу, поэтому мы порасспрашивали местных, и нам сказали, что он где-то здесь. Хотя его никто и не видел. Если по правде, то я немного нервничаю. Извини, но мне правда нужно следить за посетителями». Он вытягивает шею и окидывает бар взглядом.~
@10456 = ~«Еще несколько вопросов, а потом я уйду».~
@10457 = ~«Хорошо. Всего хорошего».~
@10458 = ~«Нет. Пока нет. Но Тарнер сказал, что это то место, куда обычно приходят преступники. И теперь мы в выжидательной позиции».~
@10459 = ~«Хорошо. Ответь мне на пару вопросов».~
@10460 = ~«Удачи. Прощай».~
@10461 = ~«Ну, они... извини, *я* — мне теперь нужно привыкнуть так говорить! — верю, что Правосудие является самой важной штукой в жизни. Я верю, что без правосудия нет смысла, а без смысла мы просто поубиваем самих себя. Я не хочу убивать себя, поэтому я решил, что в правосудии есть смысл. Если ты хочешь знать больше, то тебе стоит спросить моих напарников или найти наших нанимателей. Они тебе все уши прожужжат!»~
@10462 = ~«Что ты можешь сказать о Вейлоре?»~
@10463 = ~«Наверное, я так и сделаю. Но сперва ответь мне на несколько вопросов, ладно?»~
@10464 = ~«Так и сделаю. Спасибо».~
@10465 = ~«Что ты хочешь знать?»~
@10466 = ~«Ваш убийца еще не появлялся?»~
@10467 = ~«Кто ты?»~
@10468 = ~«Я ищу дневник. Тебе он, случаем, не попадался?»~
@10469 = ~«Я ищу сборщика по имени Фарод. Может, ты видел его или знаешь, где его можно найти?»~
@10470 = ~«Что ты можешь сказать о Вейлоре?»~
@10471 = ~«Кто твои друзья?»~
@10472 = ~«Что ты можешь рассказать об этом месте?»~
@10473 = ~«Что ты делаешь?»~
@10474 = ~«Нет. Прощай».~
@10475 = ~«Не могу сказать, что слышал о нем. Он преступник? Возможно, позже мы разберемся с ним... Спасибо за наводку, гражданин».~
@10476 = ~«Я просто хочу найти его, а не убить. Ты можешь ответить на другие вопросы?»~
@10477 = ~«С удовольствием. Если поймаете — дайте мне знать, прежде чем убьете его. Прощай».~
@10478 = ~«Вейлор? Он вроде один из старых убийц милосердия. Я хочу быть таким же, как он, если смогу. Я слышал, что этот знаток — все равно что бог!»~
@10479 = ~«Уверен, что он тебя здорово вдохновляет. Ты можешь ответить на другие вопросы?»~
@10480 = ~«Понятно. Спасибо».~
@10481 = ~Не говоря ни слова, этот тяжеловооруженный мужчина выхватывает свое оружие и замахивается им на тебя.~
@10482 = ~Атаковать его.~
@10483 = ~Сбежать.~
@10484 = ~Этот огромный мужчина похож на бронированного бегемота. Похоже, у него очень цепкий взгляд — ничто не может ускользнуть от его глаз. И еще он не заинтересован с тобой разговаривать.~
@10485 = ~«Я хотел бы задать тебе пару вопросов».~
@10486 = ~«Привет?»~
@10487 = ~«Что ты можешь сказать о Вейлоре?»~
@10488 = ~«Тогда прощай». ~
@10489 = ~Мужчина смотрит на тебя как на какое-то насекомое, смотрит пристально, изредка моргая. Он отворачивается, не удостоив тебя ответом.~
@10490 = ~«Отвечай, или я вырву у тебя сердце, ты, консервная банка».~
@10491 = ~«Привет?»~
@10492 = ~«Что ты можешь сказать о Вейлоре?»~
@10493 = ~«Тогда прощай. Я найду ответы где-нибудь еще».~
@10494 = ~Ты слышишь нарастающий рык, исходящий из его груди. Он легко выхватывает свое оружие и пялится на тебя с новой заинтересованностью.~
@10495 = ~«Что ты можешь сказать о Вейлоре?»~
@10496 = ~«Если это все, что ты можешь, то прощай».~
@10497 = ~Атаковать его.~
@10498 = ~Неожиданно для тебя немногословный гигант отвечает. Он подается вперед и пригвождает тебя ясным, немигающим взглядом. Его зычный голос грохочет прямо из груди: «Вейлор был самым лучшим из нас. Настоящий убийца милосердия. Справедливость была его госпожой, его жизненной силой. Говорили, что он мог заглянуть в саму душу. Он был настолько предан идеалам, что никогда бы не сдался, даже перед лицом смерти. Много лет назад он исчез портале, преследуя преступника. С тех пор мы его не видели. Теперь он настоящая легенда». Он возвращается на свое кресло и больше на тебя не реагирует.~
@10499 = ~«Ты можешь ответить на другие вопросы?»~
@10500 = ~«Спасибо. Прощай».~
@10501 = ~«Нет». Убийца милосердия даже не смотрит на тебя.~
@10502 = ~«Мне просто нужны ответы на несколько вопросов».~
@10503 = ~«Тогда прощай». ~
@10504 = ~Седоватый убийца милосердия медленно поворачивается к тебе, изучая твое лицо. Неожиданно он взмахивает руками. В них появляется весьма грозное оружие. «Ребята! У нас тут убийца!» Он бросается на тебя.~
@10505 = ~Атаковать его.~
@10506 = ~Сбежать.~
@10507 = ~Перед тобой седоватый, плотный мужчина в шипастых доспехах. Он изучает тебя, медленно осматривая сверху донизу. На секунду он задерживается на твоем лице, словно пытаясь что-то вспомнить. Со вздохом он произносит: «Я могу чем-нибудь тебе помочь, приятель?»~
@10508 = ~«Кто ты?»~
@10509 = ~«Ты знаешь меня?»~
@10510 = ~«Кто твои друзья?»~
@10511 = ~«Я ищу дневник. Тебе ничего такого не попадалось?»~
@10512 = ~«Я ищу сборщика по имени Фарод. Может, ты видел его или знаешь, где можно найти его?»~
@10513 = ~«Ты что-то хочешь от меня?»~
@10514 = ~«Что ты можешь сказать о Вейлоре?»~
@10515 = ~«Расскажи мне об этом месте, если можно».~
@10516 = ~«Нет, не сейчас. Прощай».~
@10517 = ~«Кто ты?»~
@10518 = ~«Ты знаешь меня?»~
@10519 = ~«Кто твои друзья?»~
@10520 = ~«Я ищу дневник. Тебе ничего такого не попадалось?»~
@10521 = ~«Ты знаешь сборщика по имения Фарод? Я ищу его».~
@10522 = ~«Что ты можешь сказать о Вейлоре?»~
@10523 = ~«Расскажи мне об этом месте, если можно».~
@10524 = ~«Нет, не сейчас. Прощай».~
@10525 = ~«Я? Я — Тарнер».~
@10526 = ~«А что это за наряд?»~
@10527 = ~«Кто твои друзья?»~
@10528 = ~«Ты можешь ответить на другие вопросы?»~
@10529 = ~«Спасибо. Хорошего дня».~
@10530 = ~«Я подумал, что да, но тем картинкам уже сотни лет и, скорее всего, подозреваемый уже давно мертв. Хотя, конечно, на планах случаются странные вещи. Так что если ты — тот, о ком я подумал, то, похоже, ты уже искупил свой приговор страданиями».~
@10531 = ~«Расскажи мне об этом субъекте».~
@10532 = ~«Ха. Кто знает? Ты можешь ответить на другие мои вопросы?»~
@10533 = ~«Гораздо больше, чем ты можешь знать. Гораздо больше, чем *я* могу знать. Прощай».~
@10534 = ~«Это Калеб и Илсидон. Калеб — свежее мясо, новичок. Илсидон — мускулы. Я — мозги».~
@10535 = ~«Что вы здесь делаете?»~
@10536 = ~«Новичок? А почему тогда он одет точно так же?»~
@10537 = ~«Понятно. Ответь мне на пару вопросов».~
@10538 = ~«Понятно. Прощай».~
@10539 = ~«На улицах Сигила много чего происходит, приятель. Если этот дневник не является чем-то особенным, шанс того, что я его не видел, достаточно велик».~
@10540 = ~«Хорошо. Ты можешь ответить на другие вопросы?»~
@10541 = ~«Полагаю, это было бы трудно запомнить. Ну, тогда прощай».~
@10542 = ~«Об этом? Это 'Тлеющий труп'. Говорят, что в этом месте полно порталов, хотя на самом деле не больше, чем где-либо в Сигиле. Хорошая дешевая выпивка, и, если не обращать на пьяниц и нечисть, это место не такое уж плохое. Если хочешь узнать о нем побольше, поговори с барменом или еще с кем».~
@10543 = ~«Понятно. Я хотел бы узнать кое о чем еще».~
@10544 = ~«Отлично. Прощай».~
@10545 = ~«Что ты хочешь знать?»~
@10546 = ~«Кто ты?»~
@10547 = ~«Ты знаешь меня?»~
@10548 = ~«Кто твои друзья?»~
@10549 = ~«Я ищу дневник. Тебе ничего такого не попадалось?»~
@10550 = ~«Слышал ли ты когда-нибудь о сборщике по имения Фарод? Я ищу его».~
@10551 = ~«Что ты можешь сказать о Вейлоре?»~
@10552 = ~«Расскажи мне об этом месте, если можно».~
@10553 = ~«На этот раз ничего. Прощай».~
@10554 = ~«Это наша униформа. Мы — Красная Смерть... Убийцы милосердия. Мы люди правосудия. Кто-то совершает преступление, мы предаем его правосудию. Мы тоже можем совершать ошибки. Если хочешь знать больше, поговори с одним из нанимателей».~
@10555 = ~«Логично. Ты можешь ответить на другие вопросы?»~
@10556 = ~«Тогда всего хорошего».~
@10557 = ~«Насколько я знаю, это был чрезвычайно опасный преступник. Было это сотни лет назад. Говорили, что он был необычайной силы, мог голыми руками оторвать бариавру голову. С ним никто не мог справиться. Поговаривали, что когда его окружил патруль Красной Смерти, он сумел сбежать через портал, и с тех пор никто его не видел, — хмурясь, он изучает тебя. — У нас были его изображения. Если убрать все твои шрамы, то ты на него похож. Но маловероятно, что ты — это он».~
@10558 = ~«Похоже, он был мерзким типом. У меня есть еще вопросы...» ~
@10559 = ~«Звучит отвратительно. Прощай».~
@10560 = ~«Ждем преступника. Это будет первый арест для нетерпеливого Калеба... если только тот пень, которого мы ждем, здесь объявится».~
@10561 = ~«Погоди, так вы что-то вроде сил правопорядка? А эта ваша броня — униформа?»~
@10562 = ~«Понятно. Ответь мне на несколько вопросов».~
@10563 = ~«Удачи. Прощай».~
@10564 = ~«Ищешь его, да? Судя по твоему голосу, готов поспорить, не для того, чтобы пропустить с ним стаканчик в таверне. Видишь ли, я знаю старину Фарода. Скользкий тип, и пройдет порядком времени прежде, чем мы сможем пришить ему дело. Проблема в том, что только такой фанатик, как Вейлор, мог вздернуть человека без явных доказательств. Иначе говоря, я не знаю, где этот бедолага, но ты должен знать, что он является подозреваемым, так что лучше с ним не встречаться».~
@10565 = ~«Спасибо за совет. Ты можешь ответить на другой мой вопрос?»~
@10566 = ~«Спасибо за секрет. Прощай».~
@10567 = ~«О Вейлоре? Фанатик — вот кто он. Если он думал, что прав, то ничто не могло его остановить, даже если он мог лишиться при этом жизни. Он был так предан идее справедливости, настоящей справедливости, что, готов поспорить, мог бы убить саму Смерть ради доносчика, который выведет его на преступника. И плевал он на ограничения. Он вдохновлял нас всех».~
@10568 = ~«Вот это настоящая преданность. Можешь ответить другой мой вопрос?»~
@10569 = ~«Держу пари, что он и был таким. Прощай».~
@10570 = ~«Теперь ты на территории Заточек, пень».~
@10571 = ~«Мне уже надоедает ждать его».~
@10572 = ~«Посмотрим-ка здесь... Ничего».~
@10573 = ~«Черт! Снова провал!»~
@10574 = ~«Ничего! Да где же вы?!»~
@10575 = ~«Ты есть глуп!»~
@10576 = ~«Глупцы».~
@10577 = ~«Просто проверяю. Давай двигай».~
@10578 = ~Перед тобой женщина в мантии тленной, держащая в правой руке полупустой стакан. Когда ты проходишь мимо, она подзывает тебя к себе. «Эм, ты. Иди сюда...» Ты замечаешь, что с ней что-то не так... основываясь на наблюдениях за тленными, ты делаешь вывод, что для члена этой фракции она слишком живо выглядит.~
@10579 = ~Подойти к ней.~
@10580 = ~Оставить ее в покое.~
@10581 = ~Оставить ее в покое.~
@10582 = ~Перед тобой тленная. Когда ты проходишь мимо, она подзывает тебя к себе. «Эм, ты. Иди сюда...»~
@10583 = ~Подойти к ней.~
@10584 = ~Оставить ее в покое.~
@10585 = ~Оставить ее в покое.~
@10586 = ~«Эм... чего тебе?»~
@10587 = ~«Баркис говорит, что пора бы уже тебе возвратить должок. Расплатись».~
@10588 = ~«Ты ведь ненастоящая тленная?»~
@10589 = ~«Мне нужны еще деньги, а не то я испорчу твой маскарад с переодеванием в тленных».~
@10590 = ~«Мне нужно больше денег, а не то я испорчу твой маскарад с переодеванием в тленных».~
@10591 = ~«Мне нужны ответы на несколько вопросов».~
@10592 = ~«Ничего».~
@10593 = ~«Что, больно уж хорош, чтобы, эм, тусоваться с тленными, а? Купи мне выпивку, и я отстану».~
@10594 = ~«Без проблем. Вот пять монет. Только оставь меня в покое».~
@10595 = ~«Ты ведь ненастоящая тленная?»~
@10596 = ~«Баркис говорит, что пора бы уже тебе возвратить должок. Расплатись».~
@10597 = ~«Я так не думаю. Хорошего дня».~
@10598 = ~«Эй, рубака... купишь девушке выпивку?»~
@10599 = ~«Ты ведь ненастоящая тленная?»~
@10600 = ~«Баркис говорит, что пора бы уже тебе возвратить должок. Расплатись».~
@10601 = ~«Кто ты?»~
@10602 = ~«Что это за место?»~
@10603 = ~«Расскажи о других здешних посетителях».~
@10604 = ~«Кто этот горящий труп?»~
@10605 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10606 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10607 = ~«Ничего. Прощай».~
@10608 = ~«Спасибо, рубака... да пребудет с тобой Истинная Смерть». Она прячет твои деньги в карман и нервно поглядывает в сторону выхода.~
@10609 = ~«Ответь мне на пару вопросов за мои звенелки».~
@10610 = ~«Всего хорошего».~
@10611 = ~«Что, эм, ты хочешь знать?»~
@10612 = ~«Ты ведь ненастоящая тленная?»~
@10613 = ~«Баркис говорит, что пора бы уже тебе возвратить должок. Расплатись».~
@10614 = ~«Кто ты?»~
@10615 = ~«Что это за место?»~
@10616 = ~«Расскажи о других здешних посетителях».~
@10617 = ~«Кто этот горящий труп?»~
@10618 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10619 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10620 = ~«Мне нужны еще деньги, а не то я испорчу твой маскарад с переодеванием в тленных».~
@10621 = ~«Мне нужно больше денег, а не то я испорчу твой маскарад с переодеванием в тленных».~
@10622 = ~«Ничего. Прощай».~
@10623 = ~Моментально протрезвев, она нервно озирается. «С чего, эм, с чего ты это взял?»~
@10624 = ~«Потому что ты ведешь себя не как трухлявые, и, к тому же, не предлагаешь контракты. На деле ты берешь деньги вместо того, чтобы давать их за тела, которые работают в Морге».~
@10625 = ~«Потому что я сам — тленный».~
@10626 = ~Она тихонько подпрыгивает — нервная обеспокоенность сменяется настоящей тревогой. «И что ты собираешься делать?»~
@10627 = ~«Подойди и расплатись. Сейчас же».~
@10628 = ~«Подойди и расплатись. Сейчас же».~
@10629 = ~«Пока ничего. Ответь мне на пару вопросов».~
@10630 = ~Она издает испуганный писк и начинает сбивчиво объясняться: «Нет, нет, нет-нет-нет. Я не тленная. Я просто нашла эту мантию на улице, а на хорошую одежду денег не было, и еще я слышала, что здесь где-то был вор в одежде тленного, но ты сможешь найти его где-то в юго-западной части Улья. Я видела его, а он меня не заметил. Пожалуйста, не делай мне больно».~
@10631 = ~«Дай мне денег, и я тебя отпущу».~
@10632 = ~«Я не собираюсь этого делать. Просто знай, что играешь ты неубедительно. А теперь ответь на мои вопросы».~
@10633 = ~«Не буду. Пока что. Прощай».~
@10634 = ~«Эм-м... Я не могу себе этого позволить. Может, одолжишь мне десять процентов? Я, эм, отдам их ему и он поймет, что я верну остальное».~
@10635 = ~«Сколько тебе нужно?»~
@10636 = ~«Мне так не кажется. Я благотворительностью не занимаюсь. Есть еще идеи, как тебе с ним расплатиться?»~
@10637 = ~«Подкинь немного монеток на выпивку, а, рубака?»~
@10638 = ~«Ладно. Держи пять монет».~
@10639 = ~«Нет. Лучше ответь мне на пару вопросов».~
@10640 = ~«Нет. Прощай».~
@10641 = ~«Эм, думаю, мне понадобится сто монет на первый взнос».~
@10642 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10643 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10644 = ~«Я одолжу тебе деньги. Вот. Возьми их и расплатись. Сейчас же».~
@10645 = ~«Может, есть другое решение?»~
@10646 = ~«Другой способ расплатиться? Ха, — она печально улыбается. — Ты всегда, эм, можешь убить меня».~
@10647 = ~Отвлечь ее: «Конечно, могу, но... эй, что это там?»~
@10648 = ~«Конечно, могу, но я хотел бы найти другое решение».~
@10649 = ~«Я просто одолжу тебе эти деньги. А теперь иди и расплатись».~
@10650 = ~Ложь: «Я б одолжил тебе денег, но у меня их нет. Ответь, пожалуйста, на пару вопросов».~
@10651 = ~Правда: «Я б одолжил тебе денег, но у меня их нет. Ответь, пожалуйста, на пару вопросов».~
@10652 = ~«Я вернусь с деньгами».~
@10653 = ~«Я вернусь».~
@10654 = ~«Где?» Она озирается, чтобы поглядеть, куда ты указываешь, и с минуту всматривается в ту сторону замутненным выпивкой взглядом. «Я ничего не вижу».~
@10655 = ~Отравить ей выпивку бальзамирующей жидкостью.~
@10656 = ~«Неважно. Можешь ответить на мои вопросы?»~
@10657 = ~«Должно быть, там ничего не было. Забудь об этом. Прощай».~
@10658 = ~В тот момент, когда она оглядывается, ты быстро вливаешь бальзамирующую жидкость в ее полупустой стакан. Жидкость моментально начинает вонять, но, кажется, она ничего не заметила. Она оборачивается назад и одним глотком осушает стакан с отравленной выпивкой. «Эм, что там было? Чего я должна была увидеть?» Внезапно она начинается задыхаться.~
@10659 = ~«Свою смерть. Прощай, Мочай».~
@10660 = ~«Эм... что ты делаешь?» Она подозрительно смотрит на тебя с бутылкой бальзамирующей жидкости наготове.~
@10661 = ~«Просто ставлю бутылку на стол. Купил себе выпивки».~
@10662 = ~«Просто ставлю бутылку на стол. Купил себе выпивки».~
@10663 = ~«Просто ставлю бутылку на стол. Купил себе выпивки».~
@10664 = ~«Да расслабься ты. Я просто роюсь в своих вещах, чтобы вспомнить, что я с собой ношу».~
@10665 = ~«Это тебя не касается».~
@10666 = ~«Ничего. У меня встреча в другом месте. Прощай».~
@10667 = ~Она еще пару мгновений смотрит на тебя, пошатываясь, затем говорит: «Эм, ладно. Ты еще чего-то хотел?»~
@10668 = ~«Да. Несколько ответов».~
@10669 = ~«Нет. Прощай».~
@10670 = ~«Могу дать тебе пятьдесят монет. Пожалуйста... никому не говори».~
@10671 = ~«Посмотрим. А теперь ответь мне еще на несколько вопросов».~
@10672 = ~«Пятьдесят? Мне нужно больше».~
@10673 = ~«Посмотрим. Прощай».~
@10674 = ~«Эм, тебе нужно еще? Я не могу, эм, не могу предложить тебе столько же, сколько и в прошлый раз. Могу только дать, эм, двадцать пять монет».~
@10675 = ~«Мне нужно еще».~
@10676 = ~«Этого хватит... пока. Тем временем, ответь еще на пару вопросов».~
@10677 = ~«Этого должно хватить... пока. Я вернусь».~
@10678 = ~«Ну что ж, эм, очень жаль. Потому что я, эм, больше ничего не могу тебе дать. У меня, эм, просто-напросто нет больше денег».~
@10679 = ~«Очень жаль. Ответь мне на пару вопросов».~
@10680 = ~«Очень жаль. Посмотрим, что из этого выйдет. Прощай».~
@10681 = ~Она глядит на тебя с горечью. «Я не могу. Один, эм, пень обобрал меня до нитки. Мне нужно занять денег или, эм, еще как-то расплатиться с ним».~
@10682 = ~«Сколько тебе нужно?»~
@10683 = ~«Мне так не кажется. Я благотворительностью не занимаюсь. Есть еще идеи, как тебе с ним расплатиться?»~
@10684 = ~Она кладет твои звенелки в карман, бросает короткий взгляд на дверь, как бы взвешивая шансы на побег, тяжело вздыхает, осознав, что шансов никаких, и угрюмо направляется к барной стойке. «Эм, ну типа прими мою благодарность».~
@10685 = ~«Не стоит. Да, и не думай улизнуть через дверь, пока не расплатишься».~
@10686 = ~«Я? Я — Мочай. Мне просто нравится, эм, напиваться здесь и, эмм... — она моментально теряет цепь своих рассуждений. — Я просто кое-кто, понимаешь?»~
@10687 = ~«Понятно. Ответь на другие вопросы».~
@10688 = ~«Понятно. Ну, тогда прощай, Мочай».~
@10689 = ~«Таверна 'Тлеющий труп'. Читать не умеешь? Что, эм, нажрался побольше моего?»~
@10690 = ~«Забудь. Расскажи еще кое о чем».~
@10691 = ~«Забудь об этом. Прощай».~
@10692 = ~«Не знаю. Они — просто, эм, люди. Я с людьми не очень-то много дел имею. Если только они мне выпивку не покупают...» Она с надеждой глядит на тебя.~
@10693 = ~«Ясно. Дай-ка мне еще пару ответов».~
@10694 = ~«Понятно, почему. Прощай».~
@10695 = ~«Он, эм, не труп. Он, эм, какой-то чокнутый колдун. Поспрашивай. Тебе расскажут его историю».~
@10696 = ~«Хорошо. Тогда ответь на другие вопросы».~
@10697 = ~«Прощай».~
@10698 = ~«У меня нет времени на загадочные бормотания. Я ищу дневник. И это срочно. Ты не знаешь, где он может быть?»~
@10699 = ~«Ты — Фарод? Я ищу Фарода, сборщика».~
@10700 = ~«Кто ты?»~
@10701 = ~«Забудь. У меня много дел. Прощай».~
@10702 = ~«И снова здравствуй, путник». Похоже, О не двигался с тех пор, как ты в последний раз с ним разговаривал. «Что тебе от меня нужно?»~
@10703 = ~«Расскажи мне о том божественном алфавите, о котором ты говорил».~
@10704 = ~«Расскажи мне о себе».~
@10705 = ~«Я ищу дневник. И это срочно. Ты не знаешь, где он может быть?»~
@10706 = ~«Ты не видел Фарода, сборщика, или, может, что-нибудь слышал о нем?»~
@10707 = ~«Расскажи мне о посетителях этой таверны».~
@10708 = ~«Ничего. Прощай».~
@10709 = ~Как только он открывает рот, ты снова испытываешь ощущение пустоты — внутри его рта нет ни языка, ни зубов. Такое чувство, что этот человек — какая-то оболочка, окружающая неограниченное пространство. «Я раньше разговаривал с тобой, а ты всегда забывал. Твои бесконечные поиски самого себя всегда заканчиваются амнезией. Ты то приближаешься к истине, то удаляешься. Будем надеяться, что у тебя хватит сил вынести свое существование».~
@10710 = ~«Что ты знаешь обо мне? Откуда ты это знаешь?»~
@10711 = ~«У меня нет времени на безумства. Прощай».~
@10712 = ~«Я знаю, что ты как муха: вылупляешься из своего старого кокона, летаешь вокруг какое-то время, затем натыкаешься на окно истины и гибнешь. Ты жужжишь возле стекла в поисках света, без какого-либо плана, и измождено падаешь вниз, потерпев неудачу. Ты натыкаешься на других, наживаешься на них и движешься дальше, больше о них не заботясь. Я видел, как ты приходил сюда. Я слушал твои слова и смотрел, как ты уходил прочь, нисколько не поумнев. Извлечешь ли ты урок из своих ошибок, ищущий?»~
@10713 = ~«Не думаю, что мне нравится твой тон».~
@10714 = ~«Кто ты?»~
@10715 = ~«Нет, не в этот раз. Прощай».~
@10716 = ~Атаковать его.~
@10717 = ~Хотя на его лице нет улыбки, в его голосе слышится издевка. «Слепо драться — вот каков твой ответ на все проблемы? Быть может, ты не лучше гнуса, или же ты все-таки наберешься разума на каком-то этапе своего жалкого существования?»~
@10718 = ~«Предупреждаю тебя...»~
@10719 = ~«Да кто ты такой, раз говоришь со мной таким тоном?»~
@10720 = ~«Мне это не нужно. Прощай».~
@10721 = ~«Ты бросаешь мне вызов? Мне, воплощенному в реальность звуком, известны слова, которые опустошат тебя, разрушат то малое, что осталось от твоей души, и оставят тебя хныкать на полу. Однако я нахожу, что нет необходимости раскрывать таким, как ты, подобные секреты: я могу попросту сделать свое присутствие невидимым для тебя».~
@10722 = ~Атаковать его.~
@10723 = ~«Так кто ты на самом деле?»~
@10724 = ~«Хватит с меня этой напыщенности. Прощай».~
@10725 = ~«Я — О». Почему-то, когда он произносит свое имя, оно звучит не как один звук, так, словно в нем содержится множество нераскрытых возможностей и нюансов. Ни один человеческий язык неспособен воспроизвести такой звук.~
@10726 = ~«Что это за имя такое?»~
@10727 = ~«Что ты такое?»~
@10728 = ~«Приятно было встретиться с тобой, О. Прощай».~
@10729 = ~«Это мое имя. Это имя частицы бесконечности. Я — буква в божественном алфавите. Понимание меня ведет к пониманию сущности. Я вписан в истинные имена половины всего. Мое существо окружает истину. Я — математичен, органичен, метафизичен.~
@10730 = ~«А мне кажется, что ты совершенно спятил».~
@10731 = ~«И что это означает?»~
@10732 = ~«...верно. Ты можешь ответить на мои вопросы?»~
@10733 = ~«Понятно. Прощай».~
@10734 = ~«Если ты хочешь в это верить. Удачи, путник. Прощай».~
@10735 = ~«Ты можешь ответить на другие вопросы?»~
@10736 = ~«Прощай».~
@10737 = ~«Божественный алфавит вписан в имя всего сущего, начиная с семени в сердцах стихийных планов и заканчивая центром Великого Предела. Я со своими братьями/сестрами, — в твоем уме одно слово перевелось как два, — постигаем все, что было, есть и будет. Мы есть мысль, реальность, представление, невообразимое».~
@10738 = ~«Расскажи мне о Великом Пределе».~
@10739 = ~«А что ты здесь делаешь?»~
@10740 = ~«Это значит, что ты знаешь секреты всего сущего, не так ли?»~
@10741 = ~«Тогда ты сможешь ответить на некоторые мои вопросы».~
@10742 = ~«Мне нужно время, что обдумать это. Прощай».~
@10743 = ~Он не обращает на тебя внимания. Уверенность в том, что он и дальше будет тебя игнорировать, падает на твои плечи тяжелым грузом. Ты даже не знаешь, откуда она появилась.~
@10744 = ~«Тогда прощай». ~
@10745 = ~«Что ты еще хочешь узнать?»~
@10746 = ~«Что ты там говорил про божественный алфавит?»~
@10747 = ~«Я ищу дневник. И это срочно. Ты не знаешь, где он может быть?»~
@10748 = ~«Ты не видел Фарода, сборщика, или, может, что-нибудь слышал о нем?»~
@10749 = ~«Расскажи мне о посетителях этой таверны».~
@10750 = ~«Расскажи мне о себе».~
@10751 = ~«Если подумать — то ничего. Прощай».~
@10752 = ~«Ты не сможешь понять. Никто из смертных не сможет. Это вне пределов понимания даже сил, за исключением самых могущественных из них, а когда они его понимают, то переносятся за пределы понимания смертных. Больше я никак не смогу объяснить. Но, возможно, ты когда-нибудь поймешь».~
@10753 = ~«А что ты здесь делаешь?»~
@10754 = ~«Тогда ответь мне на несколько вопросов».~
@10755 = ~«Понятно. Тогда прощай».~
@10756 = ~«Я знаю, где ты можешь найти его, но не в моих правилах раскрывать подобную информацию. Не бойся, ты НАЙДЕШЬ его, как и человека, которого ищешь».~
@10757 = ~«Ты знаешь, где находится Фарод?» ~
@10758 = ~«Ты знаешь что-нибудь о нем?»~
@10759 = ~«Спасибо. Может ты сможешь ответить на другие вопросы?»~
@10760 = ~«Благодарю. Прощай».~
@10761 = ~«Я знаю, где он. Я могу сказать тебе только одно: он рядом. Ты найдешь его в Улье, под покровом тайны».~
@10762 = ~«Все твои ответы уклончивы. Может, ты ответишь на другие вопросы?»~
@10763 = ~«Тогда мне лучше поискать его. Прощай».~
@10764 = ~«Я знаю, что твое путешествие унесет тебя гораздо дальше поисков дневника — к граням бытия. Ты будешь бороться за свою жизни и за свой дух... и больше я тебе ничего об этом не скажу».~
@10765 = ~«Тогда расскажи мне о другом».~
@10766 = ~«Отлично. Прощай».~
@10767 = ~«Ну, я слежу за отливом и приливом смертных».~
@10768 = ~«И что же ты видишь?»~
@10769 = ~«Вы, смертные, — как осы. Вы строите свои жизни/гнезда из тонких веток, и когда ветер сотрясает ваш дом/жизнь, вы пытаетесь зажалить ветер до смерти. Вместо того чтобы понять свои глупейшие ошибки, извлечь из них уроки и попробовать восстановить тот урон, который вы сами себе нанесли, вы причиняете вред любому, кому не повезло быть рядом с вами во времена боли и отчаяния. Мой совет тебе... и всем смертным: перестаньте быть насекомыми, начните действовать разумно».~
@10770 = ~«Я подумаю об этом. А сейчас ответь на мои вопросы».~
@10771 = ~«Спасибо за совет. Прощай».~
@10772 = ~«Я знаю многое. Без связи с моими братьями/сестрами я — всего лишь буква. Сам по себе я — символ. Вместе мы — язык и сила».~
@10773 = ~«Так значит, ты не знаешь тайн бытия?»~
@10774 = ~«Тогда ты ничего не знаешь. Может быть, ты знаешь ответы на мои вопросы?»~
@10775 = ~«Звучная метафора, многослойная. Прощай».~
@10776 = ~«Я не говорил такого. Даже одна буква сама по себе — могущественная сила. Позволь мне продемонстрировать». Он широко раскрывает рот. Маска его лица разрывается вокруг глаз, рта, носа, раскрывая намек на вечность, которую ты уже ощущал. Ты теряешься в ней, растворяешься в ней... в ее части. Ты возвращаешься к своим мирским чувствам — и осознаешь, что О исчез. Но каким-то образом твое восприятие расширилось. На тебя снизошло просвещение, хотя и не надолго.~
@10777 = ~«Это было... неописуемо».~
@10778 = ~«Посетители у этого места очень разные, хотя и все смертны. И как у всех смертных, их интересы ограничены, с потенциалом расцвести в настоящую Истину. Но могу сказать тебе одно: здесь ты можешь найти компаньона, дорогого твоему сердцу — по крайней мере дорогому настолько, насколько разрешит твое сердце».~
@10779 = ~«Наверное, мне стоило бы обидеться, но я пропущу это мимо ушей. Ответишь на другой вопрос?»~
@10780 = ~«Не думаю, что мне нравится твой тон».~
@10781 = ~«Спасибо. Прощай».~
@10782 = ~«Я ищу дневник. Тебе ничего такого не попадалось?»~
@10783 = ~«Я ищу сборщика по имени Фарод. Ты знаешь что-нибудь о нем?»~
@10784 = ~«Что ты можешь рассказать об этом месте?»~
@10785 = ~«Кто это горит у входа?»~
@10786 = ~«Очевидно, ты не можешь мне помочь. До свидания».~
@10787 = ~«Уж не это ль мой старинный приятель, Сэр Шрам!» Он давит в себе смех или, по крайней мере, геройски пытается это сделать. Будучи пьяным, сделать это тихо весьма затруднительно. «Чего старый Шлепок может сделать для тебя, человек в шрамах?»~
@10788 = ~«Кто ты?»~
@10789 = ~«Я ищу дневник. Кажется, я его где-то забыл».~
@10790 = ~«Что ты можешь рассказать об этом месте?»~
@10791 = ~«Кто это горит у входа?»~
@10792 = ~«Ничего. До свидания».~
@10793 = ~«Я? Я — АНДОР! — он слабо покачивается, стоя на ногах. — Был когда-то адским воякой, но это еще до запоя. Дружки прозвали меня Шлепком, потому что я тогда нехило раздавал затрещины, а теперь меня так зовут, потому что чуть ли не каждая телка шлепает меня по морде, когда я к ней подкатываю».~
@10794 = ~«Здорово. Можешь ответить на пару моих вопросов?»~
@10795 = ~«Все это замечательно... эээ... Андор. Прощай».~
@10796 = ~Он задумывается на секунду. «Ну, раз ты чего-то там потерял в Улье, то, скорее всего, какой-то сборщик его где-то подобрал. Попробуй поищи в Улье еще чуток. Они всяко найдут. Может, и тебе помогут».~
@10797 = ~«Отлично. Мне нужно задать еще несколько вопросов».~
@10798 = ~«Спасибо. Прощай».~
@10799 = ~«Этом? Тлеющий труп. Лучшее место в городе по части выпивки. По крайней мере, пока ты не против выпить с нечистым под боком, или двумя. И если ты не против тех, из Красной смерти. Здесь просто тьма народу. И куча интересных вещей. Просто уйма».~
@10800 = ~«Тогда полагаю, что ты — один из здешних аттракционов. Ответь еще на пару вопросов».~
@10801 = ~«Понятно. Прощай».~
@10802 = ~«Этот? Это Игнус. Старый съехавший маг-простофиля, которому в голову пришла отличнейшая мысль: спалить Сигил. Видал переулок Опасных углов? Его работенка. Кучка волшебников собрались вместе и немного поколдовали над ним, и вот теперь он тут, в таверне, в качестве... м-м-м... талисмана. Мой двоюродный брат был одним из тех волшебников. Не абы какой маг, но ведь сцапал же того пня!»~
@10803 = ~«Отлично, Шлепок. Можешь ответить на пару моих вопросов?»~
@10804 = ~«Спасибо, Шлепок. Прощай».~
@10805 = ~«Чего тебе еще надо?»~
@10806 = ~«Кто ты?»~
@10807 = ~«Я ищу дневник. Тебе ничего такого не попадалось в последнее время?»~
@10808 = ~«Я ищу сборщика по имени Фарод. Ты знаешь что-нибудь о нем?»~
@10809 = ~«Что ты можешь рассказать об этом месте?»~
@10810 = ~«Кто это горит у входа?»~
@10811 = ~«Ничего. До свидания».~
@10812 = ~«Фарод? Звучит знакомо, но... знаешь, как это, когда ты залит выпивкой под самую макушку. Не могу припомнить. Уж извиняй, шрам».~
@10813 = ~«Отлично. В таком случае, ответь еще на несколько вопросов, ладно?»~
@10814 = ~«Отлично. До свидания».~
@10815 = ~«Это было ярко, Игнус, и весьма поспешно. Я хотел поговорить с ней».~
@10816 = ~Эта женщина с темными синяками на лице и руках и отчаянием в глубоко посаженных глазах. Должно быть, раньше она была привлекательной, но эти дни давно прошли. Она медленно оборачивается к тебе. Жизнь лучится из ее тела, в глазах пляшет какой-то сардонический огонек. Ты удивляешься, не обманули ли тебя твои глаза. «Добро пожаловать в Тлеющий труп, человек со шрамами».~
@10817 = ~«Кто ты?»~
@10818 = ~«Я ищу дневник. Ты не знаешь, где я его могу найти?»~
@10819 = ~«Что ты можешь рассказать об этом месте?»~
@10820 = ~«Кто это горит у входа?»~
@10821 = ~«Я ищу сборщика по имени Фарод. Ты видела его или, может быть, слышала о нем?»~
@10822 = ~«Ничего. Хорошего дня».~
@10823 = ~На этот раз Друзилла выглядит чуть поживее: по крайней мере, ты не замечаешь того налета отчаяния, которое ты уловил при первом общении с ней. «И снова привет, путник».~
@10824 = ~«Привет, Друзилла. Я хотел бы задать тебе несколько вопросов».~
@10825 = ~«Привет, Друзилла, и прощай».~
@10826 = ~«Я? Я — Друзилла. А ты, должно быть, бестолочь. Не спрашивай, как я узнала. Это написано у тебя на лбу».~
@10827 = ~«Бестолочь? Я так не думаю».~
@10828 = ~«На лбу, значит. Хорошо. Ответь мне на пару вопросов».~
@10829 = ~«А я и не хочу этого слышать. Особенно от тебя. Всего хорошего».~
@10830 = ~«Дневник? А, конечно. Я ведь слежу за всеми потерянными дневниками. Так, на всякий случай. Вдруг придет в мой любимый бар какой-нибудь тип со шрамами и начнет спрашивать про них. Ты что, спрашиваешь это у всех, кого встречаешь? Что за очаровательная жизнь».~
@10831 = ~«А у тебя язык хорошо работает».~
@10832 = ~«Просто ответь на мои вопросы и забудем об этом».~
@10833 = ~«Готов поспорить, намного лучше твоей».~
@10834 = ~«Этом? Это 'Тлеющий труп', в котором горит человек, но все не умирает. И он будет держать себя в живых до тех пор, пока не придет кто-нибудь и не поможет ему. Неудачники приходят посмотреть на боль человека. Нечисти это нравится. Тем, кому не хочется скучать, тоже сюда приходят... само название отпугивает большинство пней».~
@10835 = ~«А кто это, все-таки?»~
@10836 = ~«Понимаю. Ответь на другие вопросы».~
@10837 = ~«Подходящее название. Прощай».~
@10838 = ~Отчаяние, ранее замеченное тобой на ее лице, снова налетает черной тенью, но она справляется с собой. «Это Игнус, один из величайших магов, когда-либо появлявшихся в этих трущобах, извиняюсь за выражение. Его схватили и открыли в нем канал на план огня, и теперь он — просто дверь туда. Он сохраняет себя живым только лишь одной волей. Если бы кто-нибудь смог потушить его на несколько мгновений, он бы снова вернулся к жизни. Но столько воды ни за что не наберешь».~
@10839 = ~«Как насчет этого графина? Говорят, он бездонный».~
@10840 = ~«Кто-нибудь обязательно что-нибудь придумает. Ах да. Ты можешь ответить на несколько моих вопросов?»~
@10841 = ~«Какая у тебя связь с ним?»~
@10842 = ~«Как это печально. Прощай».~
@10843 = ~«Да, путник. Чего тебе нужно?»~
@10844 = ~«Кто ты?»~
@10845 = ~«Я ищу дневник. Ты не знаешь, где я его могу найти?»~
@10846 = ~«Что ты можешь рассказать об этом месте?»~
@10847 = ~«Я ищу сборщика по имени Фарод. Ты видела его или, может быть, слышала о нем?»~
@10848 = ~«Кто это горит у входа?»~
@10849 = ~«Ничего. Хорошего дня».~
@10850 = ~Она усмехается тебе, ее синяки почти пропадают. «Как скажешь, душка».~
@10851 = ~«А, неважно. Ответь мне на пару вопросов».~
@10852 = ~«Как бы то ни было. Прощай».~
@10853 = ~«Ага, хороший язык для хорошей головы. Я не пустоголовая, как ты мог подумать. У меня есть мозги».~
@10854 = ~«Раз уж ты такая умная, то сумеешь ответить на мои вопросы».~
@10855 = ~«Жаль только, что они не ВНУТРИ тебя. Прощай».~
@10856 = ~«О, да не уж-то? Тебе когда-нибудь приходилось любить живое пламя? Ты когда-нибудь желал навсегда исчезнуть в чужих объятиях, потерять себя в огне страсти? Судя по твоим глазам, ты хотел бы этого, но вот только что-то не везет. Не говори мне об очаровании. Шрамы не привлекательны. Драки не привлекательны. Крутость не привлекательна. ТЫ тоже не привлекателен».~
@10857 = ~«Не думаю, что я должен оправдываться перед тобой».~
@10858 = ~«С чего бы начать? Я — бессмертный, я теряю память каждый раз, когда умираю, мой закадычный друг — летающий череп, некоторые мои переживания заставили бы смертного кричать, пока душа не вылетит через глазницы, и ты мне говоришь, что быть влюбленным в огонь — привлекательно? Это не привлекательно — это просто тупо».~
@10859 = ~«С чего бы начать? Я — бессмертный, я теряю память каждый раз, когда умираю, некоторые мои переживания заставили бы смертного кричать, пока душа не вылетит через глазницы, и ты мне говоришь, что быть влюбленным в огонь — привлекательно? Это не привлекательно — это просто тупо».~
@10860 = ~«Разговор окончен».~
@10861 = ~«Нет, ведь это было бы уже слишком? Пшел прочь. Я не хочу с тобой разговаривать». Она отворачивается от тебя.~
@10862 = ~«Ты еще не видела остального меня».~
@10863 = ~«Прощай».~
@10864 = ~Неожиданно она отскакивает и пристальнее смотрит на тебя. Ее голос дрожит от волнения. «Ты — это он, да? Ты — это он!»~
@10865 = ~«О чем это ты?»~
@10866 = ~«Нет, я не он. Ответь на мои вопросы».~
@10867 = ~«Нет, я не он. Прощай».~
@10868 = ~«Он говорил, что ты придешь! Он говорил, что ты — тот, кто освободит его! Он говорил со мной во сне, и сказал, что ты придешь с океаном воды, чтобы уравновесить его, и он сможет прожечь себе дорогу сквозь Планы! Освободи его! Пожалуйста, спаси его!»~
@10869 = ~«Какая у тебя связь с ним?»~
@10870 = ~«Я подумаю над этим. Но сначала ответь на мои вопросы».~
@10871 = ~«Я подумаю над этим. Прощай».~
@10872 = ~«Я была возлюбленной Игнуса. Мы оба любили пламя, хотя он любил больше, чем я. Но теперь я наблюдаю за его красотой, как он пляшет в сердце огня, и я, Друзилла, люблю их обоих одинаково».~
@10873 = ~«Да ты спятила, верно? Ну хорошо, ответь на мои вопросы».~
@10874 = ~«Ты окончательно съехала с катушек. Прощай».~
@10875 = ~«Когда ты освободишь Игнуса?»~
@10876 = ~«Как только доберусь до него с вот этим. Говорят, что в этом графине бесконечные запасы воды».~
@10877 = ~«Так кто же ты?»~
@10878 = ~«Я ищу дневник. Ты не знаешь, где я его могу найти?»~
@10879 = ~«Я ищу сборщика по имени Фарод. Ты видела его или, может быть, слышала о нем?»~
@10880 = ~«Что ты можешь рассказать об этой таверне?»~
@10881 = ~«Еще раз, где твой тайник?»~
@10882 = ~«Да! Вылей на него, и он будет свободен! Ох, мой Игнус, я жду тебя!» Она на минуту умолкает со страхом в глазах. «А ты знаешь волшебное слово?»~
@10883 = ~«Еще нет».~
@10884 = ~«Да, знаю».~
@10885 = ~«Это тюрьма моей любви. Место, где его жестоко заточили на века. Место, куда я приходила на протяжение десятилетий, чтобы разделить с ним его огненное мучение. Это место, которое заставляет меня жить, невзирая на мои годы и мысли. Я ненавижу это место».~
@10886 = ~«Хорошо. Ответь на другие вопросы».~
@10887 = ~«Понятно. Прощай».~
@10888 = ~Ее голос буквально пульсирует от глубокой боли. «Я была любимой Игнуса, и я его любила. Он любил огонь больше, чем меня, и теперь он сам стал пламенем. Я люблю его, а значит, люблю и пламя... и то, что оно наделало. И теперь я жду, пока оно не потухнет. Я продала все то немногое, что у меня было, чтобы просто быть рядом с ним».~
@10889 = ~«Хорошо. Ответь на другие вопросы».~
@10890 = ~«Понятно. Прощай».~
@10891 = ~«Фарод? — она хихикает. — Король сборщиков? Скорее всего, ты сможешь найти его и его вонючую свору на свалке в дальнем конце Улья. Удачи тебе, если хочешь у него что-то спросить — он хитрый дьявол, вот он кто».~
@10892 = ~«Хорошо. Ответь на другие вопросы».~
@10893 = ~«Понятно. Прощай».~
@10894 = ~«Фарод? — она хихикает. — Король сборщиков? Скорее всего, ты сможешь найти его и его вонючую свору на свалке в дальнем конце Улья. Он хитрый дьявол, вот он кто. Хотя и не настолько хитрый, как мой Игнус».~
@10895 = ~«Хорошо. Ответь на другие вопросы».~
@10896 = ~«Понятно. Прощай».~
@10897 = ~«Не припоминаю, чтобы мне попадались дневники. Не знаю. Наверное, лучше спросить кого-нибудь из сборщиков. Я не знаю!»~
@10898 = ~«Это бесполезно. Ответь на мои вопросы, Друзилла».~
@10899 = ~«Понятно. Прощай».~
@10900 = ~Перед тобой лысеющий мужчина с циничным выражением лица. Он говорит хорошо поставленным голосом, звонко и четко акцентируя каждое слово. «Что тебе нужно, рубака?»~
@10901 = ~«Кто ты?»~
@10902 = ~«Я ищу дневник».~
@10903 = ~«Я ищу приятеля по имени Фарод. Он сборщик. Ты не встречал его или не слыхал о нем?»~
@10904 = ~«Что ты можешь рассказать об этом месте?»~
@10905 = ~«Кто это горит у входа?»~
@10906 = ~«Что ты со своей подругой говорили о Сигиле?»~
@10907 = ~«Ничего. До свидания».~
@10908 = ~«Мы только собирались начать очередную искрометную беседу, — в его голосе слышится сарказм. — Чем могу быть полезен?»~
@10909 = ~«Хотел бы задать тебе еще несколько вопросов».~
@10910 = ~«Ничего. Забудь».~
@10911 = ~«Я — Силаен Железнопалый. Пока ты не успел спросить, я получил это имя благодаря своему идиоту-брату, который уронил пятидесятифунтовый камень мне на ногу и разбил все мои пальцы. Так что теперь у меня пальцы из железа. Все понятно?»~
@10912 = ~«Все. Вроде бы. Ты не мог бы ответить на другие вопросы?»~
@10913 = ~«Да. Прощай».~
@10914 = ~«Не видал. По крайней мере, не припомню ничего такого. Если он не особо ценный, попробуй поискать в мусорных горах на противоположной стороне Улья. Сочувствую твоему положению. Дневник — это очень важная часть личности. Он напоминает о прошлом и помогает строить планы на будущее. Я сам веду личный дневник, и благодаря ему нахожу себя превосходным». В последней фразе слышаться самодовольные нотки.~
@10915 = ~«Без дураков. Ответь на другие вопросы».~
@10916 = ~«В мусорных районах? Спасибо за совет».~
@10917 = ~«Это Тлеющий труп. Я привел сюда свою неопытную пустоголовую кузину-первичницу, чтобы она в полной мере насладилась видом, запахами и звуками красот Сигила. Правда, пока она ими не впечатлена».~
@10918 = ~«Что не очень-то удивительно. Ты можешь рассказать о кое-чем еще?»~
@10919 = ~«Правда? Странно. Хорошего дня, сэр».~
@10920 = ~«Говорят, что этого неудачника зовут Игнусом. Однажды сжег дотла часть Улья, пока люди не собрались не разобрались с ним. Они сделали из него канал в стихийный план Огня, и теперь он корчится здесь на забаву публики. Не очень забавно, но, несомненно, весьма интересно.~
@10921 = ~«Да, несомненно. Ты можешь рассказать о кое-чем еще?»~
@10922 = ~«Да, это так. Прощай».~
@10923 = ~«А. Моя *кузина*, — он делает ударение на этом слове, как бы отмечая, что родственников выбирать не приходится, — прибыла сюда недавно из тихого первичного мира. Мой дядя, прославленный маг, привел ее сюда, чтобы расширить ее взгляды. Она одержима заблуждением, что будто *это* является центром мультивселенной. Она думает, что оно очень важно. Я же жил здесь всю свою жизнь, и знаю другое: это место обзора для сил и планарников, как в парке, где люди наблюдают за белками. Оно неважно, и чем раньше люди поймут это, тем лучше для них же».~
@10924 = ~«Правда? Хм. Стоит услышать ее точку зрения по этому поводу. А пока ответь на другие вопросы».~
@10925 = ~«Очаровательно. Спасибо и хорошего дня».~
@10926 = ~«Что ты хочешь узнать?»~
@10927 = ~«Кто ты?»~
@10928 = ~«Я ищу дневник».~
@10929 = ~«Я ищу сборщика по имени Фарод. Ты видела его или, может быть, слышала о нем?»~
@10930 = ~«Что ты можешь рассказать об этом месте?»~
@10931 = ~«Кто это горит у входа?»~
@10932 = ~«Что ты со своей подругой говорили о Сигиле?»~
@10933 = ~«Ничего. До свидания».~
@10934 = ~«Сборщик? Это не те ли ужасные охотники до трупов? Я не общаюсь с подобными типами. Да и вообще это не мой район. Так что нет, я никогда о нем не слышал».~
@10935 = ~«А какой район ТВОЙ?»~
@10936 = ~«Не очень полезные сведения. Возможно, ты сможешь ответить на другие мои вопросы».~
@10937 = ~«Тогда прощай».~
@10938 = ~«Я живу в районе Леди, вместе со своим дядей. Он гораздо лучше этого, если можно так сказать. Никаких отбросов общества, коих можно наблюдать здесь в изрядном количестве. Нет, этот район ОПРЕДЕЛЕННО можно считать трущобами. Не могу сказать, что мне здесь нравится, но мне сказали, что мне стоит испробовать все грани жизни. Чем я тут и занимаюсь».~
@10939 = ~«Район Леди, значит? Хорошо. Ответь на другие вопросы».~
@10940 = ~«Отлично. Прощай».~
@10941 = ~Перед тобой женщина с отрешенным лицом. Он не очень молода, но и не очень стара. Кажется, на ее лице можно прочесть легкое недоверие. Это выражение говорит о том, что она не верит своим чувствам. Обратив на тебя внимание, она резко, но не грубо спрашивает: «Тебе что-то нужно?»~
@10942 = ~«Кто ты?»~
@10943 = ~«Я ищу дневник».~
@10944 = ~«Я ищу сборщика по имени Фарод. Ты видела его или, может быть, слышала о нем?»~
@10945 = ~«Что ты можешь рассказать об этом месте?»~
@10946 = ~«Кто это горит у входа?»~
@10947 = ~«Что ты со своим другом говорили о Сигиле?»~
@10948 = ~«Ничего. Хорошего дня».~
@10949 = ~«Тебе что-то нужно?»~
@10950 = ~«Ответь на несколько вопросов».~
@10951 = ~«Нет. Прощай».~
@10952 = ~«Я Киарус. Киарус Языкастая. Я здесь со своим кузеном, потому что мой дядя не хочет, чтобы я ходила по Улью одна. Похоже, он считает, что я не смогу постоять за себя. Возможно, он прав. Я не очень хорошо знаю этот город или план. Я не здешняя. Я с Первичного».~
@10953 = ~«Первичного? Что это значит?»~
@10954 = ~«Ты с Первичного?»~
@10955 = ~«Ну что же, может ты все-таки сможешь ответить на мои вопросы».~
@10956 = ~«Тогда, скорее всего, ты не сможешь ответить на мои вопросы. Прощай».~
@10957 = ~«Извини, я недавно в городе. Могу тебя заверить, что я не встречала ничего, что можно принять за дневник — хотя мне сказали, что кто-то может быть дневником для другого существа. Я все еще пытаюсь совладать со здешней философией. Она немного тяжела для восприятия, но мне сказали, что если ее усвоить, все станет намного проще».~
@10958 = ~«Какое облегчение. Я бы хотел задать еще пару вопросов».~
@10959 = ~«Очень надеюсь на это. Прощай».~
@10960 = ~«Это, насколько я знаю, таверна 'Тлеющий труп', названная так в честь того несчастного у входа. По моему мнению, это что-то типа тематического бара, где пена смешивается с кремом, создавая новый, совершенно неаппетитный вкус. Конечно же, мое мнение, существа с Первичного, может быть предубежденным».~
@10961 = ~«Ты с Первичного? Что это значит?»~
@10962 = ~«Ты с Первичного? А что ты тут делаешь?»~
@10963 = ~«Возможно. Некоторые вещи кажутся не тем, чем они на самом деле являются. Ответишь еще на парочку вопросов?»~
@10964 = ~«Возможно. Прощай».~
@10965 = ~«Это Игнус. Когда-то давно — лет сто назад? — он попытался сжечь часть города, и за это был наказан. Он стал живым факелом. Ужасная судьба, но она очень подходит для такого пироманьяка и поджигателя. Насколько мне известно, лучше держать его таким».~
@10966 = ~«Откуда ты так много знаешь об этом месте? Разве ты не первичница?»~
@10967 = ~«Я хотел бы задать тебе еще пару вопросов».~
@10968 = ~«Спасибо. Хорошего дня».~
@10969 = ~«Он мне не друг, это мой кузен. Он сказал, что это не центр мультивселенной, несмотря на то, что оно расположено прямо посреди Внешних земель; несмотря на то, что оно является точкой назначения со всех порталов всего космоса — и при этом второго такого места нет; несмотря на то, что все боги желают завладеть им; несмотря на то, что здесь сосредоточение всевозможных сил. Во вселенной больше нет такого места нет, а он заявляет, что в нем нет ничего особого? Ха!»~
@10970 = ~«Очень интересная точка зрения. Возможно, вы оба правы по-своему?»~
@10971 = ~«Может быть, это так, а может и нет, но мне хотелось задать еще несколько вопросов».~
@10972 = ~«Очень интересно. Мне нужно идти. Прощай».~
@10973 = ~«Задавай. Отвечу, если смогу».~
@10974 = ~«Кто ты?»~
@10975 = ~«Я ищу дневник».~
@10976 = ~«Я ищу сборщика по имени Фарод. Ты видела его или, может быть, слышала о нем?»~
@10977 = ~«Что ты можешь рассказать об этом месте?»~
@10978 = ~«Кто это горит у входа?»~
@10979 = ~«Что ты со своим другом говорили о Сигиле?»~
@10980 = ~«Ничего. Хорошего дня».~
@10981 = ~«Возможно, ты прав, но я нахожу, что подобная относительность выше моего понимания. Либо это место особенное, либо нет. Может быть, планы и держатся на парадоксах, но в этом должен быть хоть какой-то здравый смысл».~
@10982 = ~«Не обязательно... Но в данный момент у меня нет времени спорить об этом. Вместо этого я хотел бы задать еще несколько вопросов».~
@10983 = ~«Я тоже на это надеюсь. Мне нужны ответы. Прощай».~
@10984 = ~Она поднимает голову и недоуменно на тебя смотрит. «Первичный материальный план? Место, где рождаются убеждения, формирующие Внешние планы? Мир? Звезды, луны и все такое прочее? Убеждения и реальность? Уверена, что ты знаешь, что такое Первичный, потому как это неотъемлемая часть планарных знаний».~
@10985 = ~«Я знал это. У меня есть другие вопросы».~
@10986 = ~«О. Ну да. Прощай».~
@10987 = ~«Путешествую. Расширяю кругозор. Первичный — неплохое место для жизни, но он слишком... реальный, что ли. Мой дядя дает всем племянниками и племянницам пожить несколько лет на планах и разрешает остаться, если мы захотим. Я очарована и шокирована. Но, наверное, в этом и есть вся соль планов, верно?»~
@10988 = ~«Насколько я понимаю, да. Тебе хватит знаний, чтобы ответить на некоторые вопросы?»~
@10989 = ~«Да, это так. Удачи. Прощай».~
@10990 = ~«Да. Прощай».~
@10991 = ~«Наш с Силаеном дядя — волшебник, который живет здесь. Он периодически приводит своих родственников на планы, чтобы показать им все красоты и ужасы мультивселенной. Я хотела быть готовой к путешествию, так что я хорошенько подготовилась. Возможно, об этом городе я даже знаю больше, чем мой кузен, который живет тут всю свою жизнь». Она пренебрежительно указывает на стоящего рядом мужчину.~
@10992 = ~«Какой хороший дядя. Могу ли я задать еще несколько вопросов?»~
@10993 = ~«Это просто подарок какой-то. Прощай».~
@10994 = ~«Сборщика? Не думаю, что знакома с этим понятием... — она немного задумывается. — Это не те охотники на трупов? Бедные люди, которые за деньги собирают бесчисленных жертв Улья?»~
@10995 = ~«Да».~
@10996 = ~«Видимо, ты не знаешь его, так что лучше ответь на другие вопросы».~
@10997 = ~«Забудь. Прощай».~
@10998 = ~«Насколько я понимаю, их больше всего в наиболее отдаленных от Морга районах Улья, где жизнь бьет ключом и много насилия. Тебе лучше сконцентрировать свои поиски подальше от дома мертвых».~
@10999 = ~«Возможно, я так и сделаю, но сначала я бы хотел задать тебе другой вопрос».~
@11000 = ~«Хороший совет. Спасибо и прощай».~
@11001 = ~Не подать руки.~
@11002 = ~Рукопожатие у него крепкое. «А теперь я предлагаю свои извинения за недостойное подтрунивание, парень. Надеюсь, не обижаешься; могу ли я купить тебе кружку-другую чего-нибудь, чтобы пригладить взъерошенные перышки?»~
@11003 = ~«Почему бы и нет?»~
@11004 = ~«Нет».~
@11005 = ~Он убирает руку. «Справедливо, вполне справедливо. Прямо здесь и сейчас предлагаю свои извинения за недостойное подтрунивание, парень. Надеюсь, не обижаешься; могу я купить тебе кружку-другую чего-нибудь чтобы пригладить взъерошенные перышки?»~
@11006 = ~«Почему бы и нет?»~
@11007 = ~«Нет».~
@11008 = ~«Так держать, парень! Обожди здесь». Он встает на ноги и направляется к бару. Через мгновение он возвращается назад с парой кружек. «Это тебе, парень. Выпьем!» Сделав большой глоток из своей кружки и затянувшись своей трубкой, он произносит: «Что старина Эбб может сделать для тебя в этот чудесный сигильский денек?»~
@11009 = ~«У меня есть вопросы об это месте».~
@11010 = ~«Ничего. Прощай».~
@11011 = ~«Вполне справедливо, парень, вполне справедливо». Он пыхтит своей трубкой, выдерживая паузу, и произносит: «Что старина Эбб может сделать для тебя в этот чудесный сигильский денек?»~
@11012 = ~«У меня есть вопросы об это месте».~
@11013 = ~«Ничего. Прощай».~
@11014 = ~«Ну, это я уловил, едва взглянув на тебя. В смысле, не похож ты на местного, парень... на вид ты совсем из другого теста, никак не бывалый или абориген! — Эбб издает смешок, и делает очередной глоток. — Итак, чем я могу тебе помочь, парень? Тебе нужно узнать, что за расклад?» Эбб подмигивает.~
@11015 = ~«Кто ты?»~
@11016 = ~«Что ты делаешь?»~
@11017 = ~«Что это за место?»~
@11018 = ~«Да. Расскажи мне, как все устроено в Сигиле и округе».~
@11019 = ~«Нет. Прощай».~
@11020 = ~«Эбб Коленоскрип, Третья ступень Гармониума, ныне в отставке и являюсь голосистым осведомителем, поскольку последние два или три десятка лет мне уже не так просто передвигать ногами! — он посмеивается. — Итак, парень, кто ты и в какие неприятности попал?»~
@11021 = ~«Третья степень Гармониума?»~
@11022 = ~«Что за осведомитель?»~
@11023 = ~«С чего ты взял, что я попал в неприятности?»~
@11024 = ~«Забудь об этом. Прощай».~
@11025 = ~Эбб гордо выпускает дым, его лицо обретает суровые черты. «Да, Третья ступень Гармониума... — он слегка расслабляется. — Хотя я уже много лет не совершал служебный обход. Скрипеть пером — не совсем моя стезя после всех тех потасовок и заварушек, в которых я побывал, поэтому я провожу свое время здесь, в Улье, и помогаю понемногу где могу. Вот ты похож на того, кому следует подсобить... попал в неприятности, парень?»~
@11026 = ~«В каких заварушках и потасовках ты побывал?»~
@11027 = ~«Есть пара проблем».~
@11028 = ~«Есть пара проблем: я проснулся в Морге и, похоже, забыл кто я такой».~
@11029 = ~«Вообще-то это не твое дело. У меня есть несколько вопросов...»~
@11030 = ~«Все не так плохо, как ты думаешь. Прощай».~
@11031 = ~Эбб закатывает глаза. «В стольких, что я уже и не припомню их все, парень! Ну... по крайней мере, *близко* к тому, чтобы всех их и не помнить. Меня слишком надолго занесло на Кровавую войну, а также на ту дьявольски запутанную Войну Лжи на Террасе, слишком много лет я провел на войне Черных Веков... — Эбб начинает загибать пальцы, беззвучно подсчитывая. — Так, потом была еще Трехплановая война, и еще много других; я даже немного поучаствовал в Освободительной Войне Гармониума. О, а под конец я также был в Городском Дозоре Сигила... можно сказать, что это было самым опасным из всего, что я пережил!» Он громко смеется. Упоминание Кровавой войны вызывает у тебя ощущение холодного стального кинжала, вонзающегося в сердце.~
@11032 = ~«Расскажи мне еще о Кровавой войне».~
@11033 = ~«У меня есть другие вопросы...»~
@11034 = ~«Спасибо, Эбб. Прощай».~
@11035 = ~Эбб вздыхает, не замечая твоего волнения. «Да... Кровавая война — самый опасный семейный раздор по эту сторону от первичного начала. Разъяренная толпа нечисти с одной стороны, банда воинствующей нечисти с другой. Это война, зажженная искрой сотворения, и с тех пор они непрерывно рвут друг другу глотки».~
@11036 = ~«Значит, было два вида нечисти, сражающихся друг с другом?»~
@11037 = ~«У меня есть другие вопросы...»~
@11038 = ~«Спасибо. Прощай».~
@11039 = ~«Так точно. Танарри, яростные убийцы, которые заботятся только о себе, и военная машина баатезу, во имя закона и порядка по их инфернальным правилам. Весь кавардак время от времени выплескивается на прилегающие планы, и это делает мультивселенную значительно менее приятным местом для жизни».~
@11040 = ~«Понятно. У меня есть другие вопросы...» ~
@11041 = ~«Понятно. Прощай, Эбб».~
@11042 = ~«О, в общем, надеюсь, это не так серьезно, а пока... я подожду, пока ты сам не решишь, что готов об этом поговорить. Не хочу на тебя давить, нет... иначе это тебе доставит еще больше хлопот, чем все остальное».~
@11043 = ~«У меня есть другие вопросы...»~
@11044 = ~«Спасибо. Прощай».~
@11045 = ~«А? — Эбб моргает, а затем хмурится. — Что ты сказал, парень? Проснулся в Морге... — Эбб внимательно тебя изучает. — О, может быть, они по ошибке приняли тебя за мертвеца из-за всех этих шрамов? — Эбб посмеивается. — Не скажу, что я бы оказался умнее... — Он пыхтит трубкой. — Эти трухлявые... — Он прерывает себя. — Я хочу сказать, эти *тленные*... Трухлявые — слишком грубый термин, чтобы обращаться к этим бледнолицым парням, и я не хочу высказать излишнего неуважения... так вот, у них иногда проницательность и дружелюбие могильных камней, не так ли? Не могу сказать, чтобы они ошибались так сильно, нет, парень».~
@11046 = ~«Именно я это и слышал. У меня есть несколько вопросов...»~
@11047 = ~«Нет. Прощай».~
@11048 = ~«Ну, это хорошо, что ты спросил, поскольку теперь понятно, что ты совсем зелен, и осведомитель — это лучший человек, на которого пустоголовый может наткнуться на улицах Сигила, то я как раз тот, кто тебе нужен, — он прикладывается к кружке. — Осведомители — это дружелюбные городские гиды, которые покажут что и где, дадут небольшую экскурсию по городу... гид, да, гид — это наилучшее их определение. Только я не часто встаю с этого стула по причине возраста, поэтому я просто предлагаю указания, и места, которые ты, возможно, захочешь посетить, путешествуя по нашему старому доброму городу. И даже медяка не возьму».~
@11049 = ~«Почему бесплатно?»~
@11050 = ~«Насколько ты стар?»~
@11051 = ~«Осведомитель, который не может двигаться, не может и устанавливать тарифов, парень. Великие силы, было бы нечестно взимать плату всего лишь за набор слов!»~
@11052 = ~«Насколько ты стар?»~
@11053 = ~«Тогда у меня есть несколько вопросов...»~
@11054 = ~«Верно. Прощай».~
@11055 = ~«Достаточно стар, чтобы мудрить, парень, и слишком стар, чтобы особо расхаживать! — он пыхтит трубкой. — Скажем так, мои лучшие годы позади, и осталось всего несколько железок, заставляющих это сердце продолжать биться».~
@11056 = ~«Каких железок?»~
@11057 = ~«Вполне справедливо. У меня есть несколько вопросов...»~
@11058 = ~«Вполне справедливо. Прощай».~
@11059 = ~«Ладно, парень, менять тему не буду: надеюсь, что когда-нибудь святой братец окажется тут, в баре 'Тлеющий труп', и, возможно, он отпустит мне некоторые личные грехи, чтобы я мог покинуть этот план навеки».~
@11060 = ~«Понятно. У меня есть другие вопросы...» ~
@11061 = ~«Понятно. Прощай».~
@11062 = ~«Парень, ни у кого не бывает столько шрамов, как у тебя, без каких-либо проблем, как от остальных, так и от самого себя! — Эбб смотрит на тебя с притворным упреком. — Ты за кого принимаешь старину Эбба? За слепого?! Ха! Слушай, я, может, уже слегка и поистрепался по углам, но глаза и мозги у меня на месте! Итак, что за беды гложут тебя, доставляя столько неприятностей? Может, я смогу тебе помочь, а?»~
@11063 = ~«У меня есть другие вопросы...»~
@11064 = ~«Пара неприятностей, не более того».~
@11065 = ~«Есть пара проблем: я проснулся в Морге и, похоже, забыл кто я такой».~
@11066 = ~«Пожалуй, нет. Прощай».~
@11067 = ~«Что я делаю? Занятный вопрос, парень. И на что же похоже то, что я делаю... Я убиваю время в приятном окружении, нянчась с кружкой эля, заготовив мешочек милого табачка, и с интересной компанией. По мне, так это прекрасный способ проводить день! А? А?» Эбб, смеясь, хлопает тебя по плечу.~
@11068 = ~«Верно. У меня есть несколько вопросов...»~
@11069 = ~«Конечно. Прощай».~
@11070 = ~«Ты в баре 'Тлеющий труп', парень. Он не так красив, как остальные места, но есть в нем свое домашнее очарование».~
@11071 = ~«Расскажи мне о здешних посетителях».~
@11072 = ~«Что это там за коптящийся труп?»~
@11073 = ~«Что хорошего тут можно выпить?»~
@11074 = ~«У меня есть другие вопросы...»~
@11075 = ~«Прощай».~
@11076 = ~«Ну, есть тут некий О, который утверждает, что он буква, а не человек; несколько убийц милосердия, ждущих появления преступника; пара абишаев в отгуле с Кровавой войны; гитцерай, наблюдающий за тобой издалека — не слишком необычно, я тебе доложу, они те еще рубаки; и Алаис там внизу, пустоголовый, чересчур задирающий нос, если ты понимаешь, о чем я. Если же тебе нужна информация о планах, поговори с Кандрианом Низкородным — он знает чуть ли не больше чем я».~
@11077 = ~«Что это там за коптящийся труп?»~
@11078 = ~«Что хорошего тут можно выпить?»~
@11079 = ~«У меня есть другие вопросы...»~
@11080 = ~«Прощай».~
@11081 = ~«Этот? О, ну это не труп, парень — не мертвец он. Насколько мы можем судить, старина Игнус все еще жив на своей жаровне. По крайней мере, нам так кажется, — Эбб морщит нос. — Кстати, иногда он может чертовски ужасно вонять. Поэтому я не выпускаю изо рта трубку, чтобы его вонь не попала мне в нос». Он смеется.~
@11082 = ~«Как он туда попал?»~
@11083 = ~«У меня есть другие вопросы...»~
@11084 = ~«Ну, некоторые говорят, что у меня бааторийское отношение к выпивке, однако есть напитки, к которому я неравнодушен, а есть некоторые урожаи, до которого мне дела нет. Вообще, одна из моих любимых штучек — это арборейские огненные семена... ты их полощешь во рту, добавляя воздуха, слюны и алкоголя, и можешь дыхнуть огнем, если захочешь. По крайней мере, ощущения именно такие».~
@11085 = ~«Расскажи мне о здешних посетителях».~
@11086 = ~«Что это там за коптящийся труп?»~
@11087 = ~«У меня есть другие вопросы...»~
@11088 = ~«Прощай».~
@11089 = ~Эбб затягивается трубкой, будто обдумывая свою реплику. «Ну, парень, у Игнуса были некоторые проблемы, и довольно некислые способности к магии, что редко можно назвать хорошим сочетанием, если ты понимаешь, о чем я. Он любил... — Эбб пыхтит трубкой, и из нее струится дым. — Ну, любил горящие вещи, вот и начал сжигать места и людей, в общем и целом, создавая кучу неприятностей».~
@11090 = ~«И?»~
@11091 = ~«У меня есть другие вопросы...»~
@11092 = ~«Очень жаль. Прощай».~
@11093 = ~«Ну, большая часть этого происходила в Улье, и я буду первым, кто признает, что Улей — далеко не то место, куда в первую очередь направился Гармониум, чтобы поддерживать законы Сигила... — лицо Эбба приобретает несколько стыдливое выражение. — Наш просчет, поскольку это именно то место, где наше присутствие наиболее необходимо. Итак, по настоянию Леди образовалось некоторое уличное правосудие из сообщества волшебников... кучка гадалок на чайных листах, магов-самоучек и повитух собралась вместе и смогла сплести заклинание, ставшее в некотором роде поэтическим правосудием, — Эбб указывает трубкой на фигуру. — Так что теперь он сидит здесь и горит. Он все еще жив, хотя не думаю, чтобы они это предусмотрели».~
@11094 = ~«Хм. У меня есть несколько вопросов...»~
@11095 = ~«Интересно. Прощай».~
@11096 = ~«Да, парень? Что ты хочешь узнать?»~
@11097 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@11098 = ~«Я потерял дневник».~
@11099 = ~«Кто ты?»~
@11100 = ~«Что это за место?»~
@11101 = ~«Расскажи мне о Сигиле и его округе».~
@11102 = ~«Какие еще места ты можешь порекомендовать?»~
@11103 = ~«Думаю, ничего. Прощай».~
@11104 = ~«Фарод? — Эбб хмурится, достав трубку изо рта. — Ну, парень, что же тебе нужно от такого пня как Фарод?»~
@11105 = ~«Мне кажется, что я его знал».~
@11106 = ~«Мне кажется, что он украл что-то у меня».~
@11107 = ~«Не твое дело. Что ты о нем знаешь?»~
@11108 = ~«Ничего. У меня есть другие вопросы...»~
@11109 = ~«Ничего. Прощай».~
@11110 = ~«Ага, тогда по большей части тебе не повезло. Возможно, кое-что забыть для тебя и к лучшему». Эбб обильно пыхтит трубкой.~
@11111 = ~«Что ты знаешь о нем?»~
@11112 = ~«О, не сомневаюсь, парень, не сомневаюсь, — бурчит Эбб, пожевывая трубку. — Тебе нужно этого алчного паучару загнать в угол. Должно быть, он был одним из Обреченных, если до сих пор этого никому не удалось. Не давай ему спуску, иначе он тебя обжучит, ага?»~
@11113 = ~«Что ты знаешь о нем?»~
@11114 = ~«Ну, я не все знаю о Фароде, но знаю, что его окружает темнота. Если ты решил выследить этого паучару и пригвоздить его к стене, тогда, наверное, тебе можно передать слухи, чтобы ты знал, с кем имеешь дело, — он на мгновение замолкает, чтобы набить трубку. — Фарод не так давно окопался на площади Старьевщиков, собрал свору сборщиков и бандитов, и основал то, что многие называют фракцией сборщиков... этим они и занимаются...»~
@11115 = ~«Где я могу найти его?»~
@11116 = ~«Понятно. У меня есть другие вопросы...» ~
@11117 = ~«Понятно. Прощай».~
@11118 = ~«Ну, парень, если ты ищешь Фарода, что, я тебе доложу, само по себе весьма глупо, то ты сбился с пути. Тебе следует найти площадь Старьевщиков. Говорят, что Фарод устроился где-то там. Даже я, старик, не раз обошедший кольцо, не знаю, где именно. Думаю, Фарод хочет оставаться в тени. Если ты решился найти его, отправляйся на площадь Старьевщиков и попробуй узнать от местных, где скрывается Фарод. Однако будь осторожен: на площади полно тех, кто выпотрошит тебя, как только увидит».~
@11119 = ~~
@11120 = ~«У меня есть другие вопросы...»~
@11121 = ~«Понятно. Прощай».~
@11122 = ~NULL NODE~
@11123 = ~«Хорошо. У меня есть другие вопросы...»~
@11124 = ~«Спасибо. Прощай».~
@11125 = ~«Потерял дневник? Был ли он больше чем просто набор страниц со словами? Если нет, не представляю себе знатока, который обременял бы себя буквами, если они только не особо горячи и пикантны. Тут мало кого интересует учеба и книги. Даже не знаю, где тебе такую вещь искать... — Эбб пыхтит трубкой, а потом щелкает пальцами. — Но знаешь что, парень, если Фарод был тем, кто соскреб тебя с улиц Сигила, возможно, он сможет пролить свет на то, где твои вещи... и, скорее всего, они в его кладовой, если тебя интересует мое мнение. Мертвец не сможет оставить свои вещи себе, когда сборщики наткнутся на его тело».~
@11126 = ~«Расскажи мне о Фароде».~
@11127 = ~«У меня есть другие вопросы...»~
@11128 = ~«Спасибо. Прощай».~
@11129 = ~Эбб громко смеется. «На мелочи не размениваешься, да? Если хочешь знать, что за городом, иди и поговори с Кандрианом Низкородным, он местный путешественник. Что же до остального, ну... Могу рассказать о Леди, дабусах, ключах и порталах, как тут следят за временем, как устроен город... Что ты хочешь узнать?»~
@11130 = ~«Просто ответь на другие вопросы...»~
@11131 = ~«Расскажи мне о Леди».~
@11132 = ~«Расскажи мне о дабусах».~
@11133 = ~«Расскажи мне о времени Сигила».~
@11134 = ~«Расскажи мне о городских районах».~
@11135 = ~«Расскажи мне о ключах и порталах».~
@11136 = ~«Ничего. Прощай».~
@11137 = ~«Что еще ты хотел узнать о Клетке?»~
@11138 = ~«Немногие знают о ней что-либо, парень, и думаю, что те, кто знают хоть что-то, большего не узнают. Она — загадка, и коль уж встретишься с ней... Да уберегут меня силы... она безмолвна и смертоносна. Она не зла, насколько я могу судить, но секреты, свои и Сигила, хранит ревностно. Никто не смог их раскрыть, а если и были такие, то закончили свои дни в лабиринте».~
@11139 = ~«Продолжай».~
@11140 = ~«В лабиринте? Что ты имеешь в виду?»~
@11141 = ~«У меня есть другие вопросы о Сигиле».~
@11142 = ~«У меня есть другие вопросы...»~
@11143 = ~«Спасибо. Прощай».~
@11144 = ~«Скорее всего, ты ее никогда не встретишь, если не сделаешь что-то совсем плохое... Причинить боль множеству людей, убивать дабусов, оспаривать ее правление или поклоняться ей... Как мы поняли, она ненавидит это, а также когда мешают работе дабусов (поскольку это фактически работа Леди)... Если повезет, за тобой придут лишь убийцы милосердия, но если придет она, ты умрешь, как только ее тень падет на тебя».~
@11145 = ~«Что ты имеешь в виду — «в лабиринте»?»~
@11146 = ~«Пожалуйста, продолжай».~
@11147 = ~«У меня есть другие вопросы о Сигиле».~
@11148 = ~«У меня есть другие вопросы...»~
@11149 = ~«Спасибо. Прощай».~
@11150 = ~«Ну, насколько мы можем судить, парень, Леди в Сигиле может почти все. Увеличивать или уменьшать его, создавать новые порталы, закрывать старые, не допускать того, чтобы Кровавая война не ворвалась на улицы, не давать кому-то телепортироваться в город, удерживать силы за его пределами».~
@11151 = ~«Что ты имеешь в виду — «в лабиринте»?»~
@11152 = ~«Кто эти силы?»~
@11153 = ~«У меня есть другие вопросы о Сигиле».~
@11154 = ~«У меня есть другие вопросы...»~
@11155 = ~«Спасибо. Прощай».~
@11156 = ~«Так точно. Иногда знатоки переносятся в место, где они вреда нанести не могут. Понимаешь, Леди берет кусочек Сигила и делает из него небольшой пространственный карман, лабиринт. Она помещает туда тех, кто перечит ее воле, и оставляет их там гнить, — Эбб пышет трубкой. — Вот еще что... от лабиринта не отделаешься, если Леди положит на тебя глаз. Она так или иначе до тебя доберется, как бы ты не увиливал. Ты будешь идти по переулку, или шагнешь в портал, или свернешь с улицы, по которой шел много раз до этого, и вдруг окажешься в месте, которого не узнаешь. Но лабиринты не защищены от побега. Из них всегда есть выход... портал, который Леди там оставляет. Нужно только разгадать, где он и как его использовать».~
@11157 = ~«У меня есть другие вопросы о Сигиле».~
@11158 = ~«У меня есть другие вопросы...»~
@11159 = ~«Спасибо. Прощай».~
@11160 = ~«А, эти смешные парящие существа, говорящие символами? — Эбб смеется. — Тот еще шедевр, да? Дабусы вроде как рабочие и дворники Леди, делающие именно то, чего она хочет, следят, чтобы Сигил не развалился, латают стены, сносят старые здания, строят новые, устанавливают одни порталы, закрывают другие, и тому подобное. Они довольно безобидны, но лучше им не мешать и не убивать их, иначе можно быстро навлечешь на себя гнев Леди».~
@11161 = ~«Расскажи мне о Леди».~
@11162 = ~«У меня есть другие вопросы о Сигиле».~
@11163 = ~«У меня есть другие вопросы...»~
@11164 = ~«Спасибо. Прощай».~
@11165 = ~«Время мы измеряем в Сигиле по яркости неба. Видишь ли, солнца и лун, как в большинстве миров, у нас нет — есть только бесконечное марево, которое то светлеет, то темнеет по регулярному циклу. То, что многие называют полночью, мы зовем антипиком. То, что называют полднем, мы зовем пиком. Видишь ли, все это основано на пике и антипике яркости. Поэтому, когда кто-то говорит что-то типа 'пять часов после пика', именно это они и имеют в виду».~
@11166 = ~«У меня есть другие вопросы о Сигиле».~
@11167 = ~«У меня есть другие вопросы...»~
@11168 = ~«Спасибо. Прощай».~
@11169 = ~«Фух. Дай горло промочить, — он отпивает из кружки. — Город плавает над бесконечным тонким Шпилем. Город обвивает его как обод колеса, только без спиц, соединяющих его со Шпилем. Разделен он на шесть районов, у каждого своя функция. Сейчас ты в Улье. Думаю назначение Улья — быть трущобами по отношению к великолепию самого города! — он смеется. — Фракции — философские клубы или банды, как хочешь — делят управление города между собой».~
@11170 = ~«Ты был во фракции?»~
@11171 = ~«Продолжай».~
@11172 = ~«У меня есть другие вопросы о Сигиле».~
@11173 = ~«У меня есть другие вопросы...»~
@11174 = ~«Спасибо. Прощай».~
@11175 = ~«Город называют перекрестком планов, и Городом Дверей, а также Клеткой. Тут есть порталы всякие разные, как говорят, и все виды бестий приходят сюда торговать, искать пристанище, или чтобы перепрыгнуть в другое место. Ну, это если вкратце, парень; место нужно будет самостоятельно освоить».~
@11176 = ~«Ты что-то говорил про порталы?»~
@11177 = ~«У меня есть другие вопросы о Сигиле».~
@11178 = ~«У меня есть другие вопросы...»~
@11179 = ~«Спасибо. Прощай».~
@11180 = ~«Сигил называют Городом Дверей не просто так, парень... тут кругом порталы. Порталы это... ну, они как двери через мультивселенную, только на двери они не похожи... Они могут представлять собой любое ограниченное пространство... оконная или дверная рама, котловина, картинная рама, днище бочка, пространству между лесами, шкаф... все это может быть порталом, ждущим только правильного ключа, который сможет его открыть, и перенести тебя куда-то в мультивселенной. Что же до ключей...»~
@11181 = ~«Продолжай».~
@11182 = ~«Ага, к каждому порталу нужен ключ, чтобы его открыть. Если порталом может быть любое ограниченное пространство, то ключи могут быть намного разнообразнее... Ими может быть все что угодно: коротенькая мелодия, которую нужно напеть у портала, танец джиги, определенное настроение, кусочек того места, куда хочешь направиться, удерживаемый в руке... и все такое прочее. В молодости я однажды убедил девушку, что поцелуй с мужчиной в определенном месте может открыть портал в Аркадию. Оказалось, я был прав, и мы не раз там бывали. Пожалуй, множество порталов так никогда и не найдут. Остальные можно открыть, узнав о них у людей, и добыв нужный ключ. Найти портал — сложнее всего. Но я тебя предупреждаю, парень. Прыгать по порталам от скуки такому как ты не стоит... как не стоит и шататься по Сигилу в темноте. Лучше бы тебе держаться главных улиц, не бродить в антипик  и следить за собой».~
@11183 = ~«У меня есть другие вопросы о Сигиле».~
@11184 = ~«У меня есть другие вопросы...»~
@11185 = ~«Спасибо. Прощай».~
@11186 = ~Эбб поднимает руку, будто останавливая тебя, и слегка усмехается. «О, погоди-ка, парень — я не какой-то там бывший член фракции... как говорят некоторые — и они правы — коль стал одним из Гармониума — ты на всю жизнь в Гармониуме. Мы — те самые знатоки, кто пытается защитить Сигил от неприятностей. На шпиле не кататься, морды друг другу особо усердно не начищать и по округе не шуметь. Стараемся поддерживать мир, парень, и большую часть времени отлично справляемся со своей работой».~
@11187 = ~«У меня есть другие вопросы о Сигиле».~
@11188 = ~«У меня есть другие вопросы...»~
@11189 = ~«Спасибо. Прощай».~
@11190 = ~«Это всего лишь одно из названий богов, парень. А их тьма-тьмущая разбросана по планам, — Эбб затягивается трубкой. — Хотя они и не могут прийти в Сигил... Леди нашла способ, которым делиться не стала, как держать их на расстоянии. Так она удерживает Сигил от захвата внешними интересами».~
@11191 = ~«Что ты там говорил о заключении в лабиринт?»~
@11192 = ~«У меня есть другие вопросы о Сигиле».~
@11193 = ~«У меня есть другие вопросы...»~
@11194 = ~«Спасибо. Прощай».~
@11195 = ~«Ну... — пыхтя трубкой, Эбб изучает тебя. — Пожалуй, это лучшая берлога, в которую ты мог забрести для начала... судя по твоим татуировкам, ты неравнодушен к украшению своего тела, а в таком случае тут неподалеку есть тату-салон, буквально в двух шагах. И держись подальше от переулка Опасных углов... Не так давно Игнус сжег это место, и с тех пор свора отморозков обосновалась на пепелище».~
@11196 = ~«У меня есть другие вопросы...»~
@11197 = ~«Спасибо. Прощай, Эбб».~
@11198 = ~«Вернулся за добавкой, да? — Эбб потягивается в своем кресле. — Приятно снова тебя видеть, парень».~
@11199 = ~«Приветствую, Эбб. У меня есть вопросы...»~
@11200 = ~«Прощай».~
@11201 = ~Ты видишь широкоплечее коренастое нечто с собачьей головой и четырьмя руками. Одна пара крупных мускулистых рук оканчивается ужасными зазубренными клешнями, которые выглядят так, будто могут вырвать саму душу из сопротивляющейся жертвы. Оно обращается к тебе неожиданно нежным голосом. «О, путешественник! Я вижу, ты привел с собой достойных компаньонов, — оно прерывает речь, чтобы понюхать воздух, — и *восхитительно* пахнущих. Я знал твоего отца, Анна. Он до сих пор батрачит в Бездне».~
@11202 = ~«Всегда пожалуйста. Прощай».~
@11203 = ~Ты видишь широкоплечее коренастое нечто с собачьей головой и четырьмя руками. Одна пара крупных мускулистых рук оканчивается ужасными зазубренными клешнями, которые выглядят так, будто могут вырвать саму душу из сопротивляющейся жертвы. Оно обращается к тебе неожиданно нежным голосом. «О, путешественник! Я вижу, ты привел с собой достойных компаньонов, — оно прерывает речь, чтобы понюхать воздух, — и *восхитительно* пахнущих. Госпожа Грация, ваша мать Красная Пелена будет рада услышать новости о вашем добром здравии».~
@11204 = ~Ты видишь широкоплечее, коренастое нечто с собачьей головой и четырьмя руками. Одна пара крупных мускулистых рук оканчивается ужасными зазубренными клешнями, которые выглядят так, будто могут вырвать саму душу из сопротивляющейся жертвы. Оно обращается к тебе неожиданно нежным голосом. «Разложить имена тех абишаев на слоги было очень, очень приятно. Я благодарю тебя за возможность это сделать».~
@11205 = ~Глабрезу поворачивается к тебе с готовностью, будто старый добрый друг. «О, путешественник! Ты вернулся! Могу ли я чем-нибудь тебе помочь?» Оно насмешливо и непринужденно кланяется Падшей Грации и Анне.~
@11206 = ~«Я бы хотел задать тебе еще вопросы...»~
@11207 = ~«Нет, не в этот раз. Прощай».~
@11208 = ~«Ну конечно! Я всегда очень рад помочь тому, кто может быть ценным другом и союзником!»~
@11209 = ~«Расскажи мне о себе».~
@11210 = ~«Почему ты раньше скрывался под личиной?»~
@11211 = ~«Расскажи мне о посетителях этой таверны».~
@11212 = ~«Баркис хочет, чтобы я нашел решение с долгом Мочай».~
@11213 = ~«Мне больше ничего не нужно. Прощай».~
@11214 = ~Глабрезу поворачивается к тебе с готовностью, будто старый добрый друг. «О, путешественник! Ты вернулся! Могу ли я чем-нибудь тебе помочь?» Оно насмешливо и непринужденно кланяется Анне.~
@11215 = ~«Я бы хотел задать тебе еще вопросы...»~
@11216 = ~«Нет, не в этот раз. Прощай».~
@11217 = ~Глабрезу поворачивается к тебе с готовностью, будто старый добрый друг. «О, путешественник! Ты вернулся! Могу ли я чем-нибудь тебе помочь?» Оно насмешливо и непринужденно кланяется Падшей Грации.~
@11218 = ~«Я бы хотел задать тебе еще вопросы...»~
@11219 = ~«Нет, не в этот раз. Прощай».~
@11220 = ~Глабрезу поворачивается к тебе с готовностью, будто старый добрый друг. «О, путешественник! Ты вернулся! Могу ли я чем-нибудь тебе помочь?»~
@11221 = ~«Я бы хотел задать тебе еще вопросы...»~
@11222 = ~«Нет, не в этот раз. Прощай».~
@11223 = ~«О себе? Я всего лишь обычный глабрезу, танарри — 'демон' для невеж. Здесь я брожу среди смертных и изучаю их образ жизни. Некоторым, кого я посчитаю достойными такой чести, я предлагаю большую силу за жалкие гроши. Тебе бы я сделал такое предложение, но твоя плоть просто пропитана ароматом порядка и дух тоже связан с ним. Его сила выше моей на данный момент, но если ты захочешь испытать эту силу немного позже, — оно улыбается во весь рот, обнажая острые, клыкастые зубы, — то, возможно, мы придем к некоторой договоренности».~
@11224 = ~«Может быть. Расскажи мне больше о танарри».~
@11225 = ~«Может быть. Расскажи мне больше о танарри».~
@11226 = ~«Может быть. У меня есть другие вопросы...»~
@11227 = ~«Может быть. Но не сейчас. Счастливо».~
@11228 = ~«Я скрывался под чужой личиной, потому что это помогает мне шпионить за абишаями, которые теперь мертвы, а еще потому, что малодушные обычно поджимают хвост при одном виде таких могущественных существ, как я. Теперь же пришло время предстать в моем истинном обличье».~
@11229 = ~«Почему сейчас?»~
@11230 = ~«Понятно. У меня были другие вопросы».~
@11231 = ~«Тогда прощай». ~
@11232 = ~«После того как исчезли тошнотворные баатезу, это место стало еще более приемлемым. Аромат жареной плоти, небольшие стычки и маленькие трагедии комбинируются, создавая весьма приятное окружение. Я бы предпочел слышать больше криков, но ведь это не Бездна. Здешние посетители — в большинстве своем маленькие мыслители и мечтатели. О для меня загадка — я не могу понять его силу, но я стараюсь. Что же до других — они меня особо не занимают. Я видел им подобных бессчетные тысячелетия».~
@11233 = ~«Хорошо. Ответь тогда на другие вопросы...»~
@11234 = ~«Тогда прощай». ~
@11235 = ~«Простое решение весьма уместно. Ты можешь ее прирезать, но это может привлечь к тебе нежелательное внимание. Я советую яд».~
@11236 = ~«А если я просто хочу оплатить ее счет и помочь ей выкарабкаться в этот раз?»~
@11237 = ~«Вообще-то у меня нет с собой яда».~
@11238 = ~«Спасибо за совет. Ответь на другие вопросы...»~
@11239 = ~«Спасибо за совет. Прощай».~
@11240 = ~Илквикс кивает в сторону Грации. «Твоя спутница расскажет тебе о них больше». Оно бросает на нее хитрый взгляд, затем продолжает. «Мы хаотичны и горды этим: мы верим в силу личности. Конечно же, сейчас я говорю исключительно за себя, — оно снова иронично улыбается. — Некоторые называют нас злыми, возможно, мы такие и есть. Тем не менее, я верю, что личность ответственна только за себя. Забота о других является слабостью. И наконец, помни вот что: каждый танарри — или демон, как вы, смертные, нас иногда называете, — представляет собой идеологию, выражающую определенное стремление к власти. Теперь пересчитай несметный легион Бездны, и ты познаешь истинную силу нашего влияния на помыслы смертных».~
@11241 = ~«То есть вы не совсем из плоти?»~
@11242 = ~«Понятно. У меня есть другие вопросы...» ~
@11243 = ~«Понятно. Прощай».~
@11244 = ~«Мы хаотичны и горды этим — мы верим в силу личности. Конечно же, сейчас я говорю исключительно за себя, — оно снова иронично улыбается.- Некоторые называют нас злыми, возможно, мы такие и есть. Тем не менее, я верю, что личность ответственна только за себя. Забота о других является слабостью. И наконец, помни вот что: каждый танарри — или демон, как вы, смертные, нас иногда называете, — представляет собой идеологию, выражающую определенное стремление к власти. Теперь пересчитай несметный легион Бездны, и ты познаешь истинную силу нашего влияния на помыслы смертных».~
@11245 = ~«То есть вы не совсем из плоти?»~
@11246 = ~«Понятно. У меня есть другие вопросы...» ~
@11247 = ~«Понятно. Прощай».~
@11248 = ~«Конечно же, мы из плоти — пока остаемся тут, во Внешних Планах. Однако это то место, где все мысли становятся осязаемыми. В действительности мы являемся мыслительным образом. Наша сила растет по мере усиления веры в наше дело в Первичном материальном. Вот почему мы рекрутируем смертных, которые даже не подозревают о нашем присутствии ни сердцем, ни умом».~
@11249 = ~«Это отвратительно. Им должно быть позволено иметь свободу воли и право выбора».~
@11250 = ~«Если они слишком слабы, чтобы противостоять, или если они взывают к тебе, то они заслуживают то, что получают».~
@11251 = ~«Понятно. У меня есть другие вопросы...» ~
@11252 = ~«Понятно. Прощай».~
@11253 = ~«У них есть свобода воли, мясо в шрамах. Если бы они просто сопротивлялись нам, то у нас не было бы даже точки опоры. Из-за своей слабости они обречены. Если бы они становились сильнее, то мы бы ничего бы не добились. Но так как они ничего не делают, то крепнем мы. Такова жизнь, — оно улыбается. — А будь иначе, мы бы все равно сделали по-своему».~
@11254 = ~«У меня есть другие вопросы...»~
@11255 = ~«Спасибо за науку. Прощай».~
@11256 = ~«Потому что настало время, которое я выбрал. У меня есть свои причины, маленький бессмертный, и я не стану их открывать лишь потому, что тебе интересно. Если, конечно, ты не *заставишь* меня...»~
@11257 = ~«Лучше я задам другие вопросы...»~
@11258 = ~«Если ты так настаиваешь. Готовься к смерти».~
@11259 = ~«Если бы ты действительно хотел так поступить, зачем спрашивать совета у нечистого? Ладно тебе. Яд — лучшее решение этой проблемы».~
@11260 = ~«Нет, я думаю, что стоит попробовать другой подход. Ответь мне на другие вопросы...»~
@11261 = ~«Часть проблемы в том, что у меня нет никакого яда».~
@11262 = ~«Я подумаю над этим. Ответь мне на другие вопросы...»~
@11263 = ~«Может быть. Прощай».~
@11264 = ~«У тебя нет яда? Так давай я тебе его дам!» Оно концентрируется на мгновение, и в клешне появляется банка с жидкостью. «Наверное, ты узнаешь бальзамирующую жидкость, которой пользуются тленные, — мурлыкает демон. — Она вызовет безболезненную смерть, если у тебя есть беспокойства на этот счет». Нечистый впихивает в твои руки яд.~
@11265 = ~«Спасибо. У меня есть другие вопросы...»~
@11266 = ~«Спасибо. Прощай».~
@11267 = ~Анна резко отвечает: «Ага, и Бездна для него — самое подходящее местечко, но батрачит он по своей воле. У него был выбор, демон. И это даже больше, чем я могу сказать такому духу, как ты!»~
@11268 = ~Он сдавленно хихикает и закатывает глаза в стиле «ты не поверишь, что со мной произошло», который тебе кажется подозрительно знакомым. «Наконец-то, дружище! Я уж было думал, что мне придется ждать тебя здесь весь день».~
@11269 = ~«Ну как же, да, — он пытливо смотрит на тебя. — По крайней мере, я так думаю. Я... э-э... не могу ничего о тебе вспомнить, но... — он хмурится в раздумье, затем пожимает плечами. — Все равно приятно тебя встретить. Я — Адан. Полагаю, мы — друзья. Отлично! Наверное, мне пригодится побольше таких друзей, как ты... — он смущенно озирается по сторонам. — Раз я не знаю никого из здешних, и уж тем более — как я сюда попал».~
@11270 = ~Ее лицо напрягается, она разрывается гневной репликой: «Ты че, серьезно хочешь мне сказать, что позволишь этому... этому... этому отродью указывать, как тебе жить? Ну так я встану в сторонку и погляжу, как он слопает твою душонку, пень ты тупой!»~
@11271 = ~«Продолжай в том же духе. Илквикс, у меня есть другие вопросы...»~
@11272 = ~«Продолжай в том же духе. Илквикс, у меня есть другие вопросы...»~
@11273 = ~Падшая Грация невозмутимо говорит. «Илквикс, я согласна, что моя мать была бы рада услышать, что я все еще добром здравии, что я все еще продолжаю двигаться в выбранном направлении и что я едина с моими спутниками. Когда вернешься назад в Бездну, будь любезен, доставь это сообщение ради меня? Я уверена, что она щедро наградит того, кто принесет ей столь великолепную новость обо мне». Она кротко улыбается.~
@11274 = ~«Это все воистину очаровательно, но у меня есть другие вопросы...»~
@11275 = ~«Довольно. Прощай, Илквикс».~
@11276 = ~Человек хрипло фыркает. «Имена, имена... кто ты, кто ты... — каждый раз, когда он повторяет это, его голова слегка подергивается. — Имена... опасны, опасны». Он переводит взгляд на землю и ковыряет ногой грязь.~
@11277 = ~«Знать имя или прилипнуть к нему — так или иначе, куча неприятностей, — он снова смотрит на тебя. — Мое имя выдумали, о нем я не просил. Вонючка». Ты снова ощущаешь его зловонное дыхание и запах мочи и экскрементов, который окружает его. «Выдуманное имя, выдуманное имя».~
@11278 = ~«Не мое настоящее имя, ненастоящее, — бормочет Вонючка, при каждом слове *имя* голову его голову передергивает. — Настоящее имя — опасная штука, дает другим силу, — он пристально смотрит на тебя своими огромными глазами и машет тебе пальцем. — Храни свое имя в тайне, храни его при себе, не выдавай его».~
@11279 = ~«Имена — как запахи... по ним тебя можно выследить». Вонючка кашляет, при этом его глаза чуть не выпадают из орбит. Похоже, от кашля его кишечник опорожняется, потому что он громко пукает, как бы подчеркивая свои слова. «Если кому-то известно настоящее имя, это дает ему силу, — он облизывает губы. — Силу причинять *боль*».~
@11280 = ~Глаза Вонючки расширяются; от наблюдения за тем, как выпячиваются его глазные яблоки, тебе становится неуютно. «Тогда ты благословлен, благословлен. Оставайся безымянным, и будешь как призрак над планами, которого нельзя найти, выследить, увидеть, изучить, — он влажно причмокивает. — Имя выбранное, имя придуманное... позволяет другим выследить тебя и причинить тебе боль».~
@11281 = ~Вонючка делает судорожный кивок и чешется. «Пусть имя мое ускользнет единожды, раз, только раз, только раз, — глаза его застилает пелена, как от болезненных воспоминаний, потом он бросает на тебя неловкий взгляд. — Могу я рассказать тебе историю, все так, но должен я увидеть три монетки». При слове *монетки* лицо его расплывается в улыбку, и его зловонное дыхание бьет тебя, словно молот.~
@11282 = ~Вонючка встает в позу, смотрит налево, потом направо, потом на тебя. Его лицо напрягается, затем, отрыгнув, он снова пукает. Запах чуть было не сшибает тебя с ног, но он не замечает этого. «Проклят я! По городу ходил я величаво...» — он неуклюже встает и задирает нос. Затем начинает слоняться взад-вперед, кивая невидимым прохожим. ~
@11283 = ~Вонючка застывает, уперев руки в бока. «Пересеклись пути с негодяем. С виду как тыква, бросается проклятьями!» Далее Вонючка выпячивает живот, чтобы тот казался толстым, приглаживает волосы назад своими грязными ладонями, чтобы выглядеть почти лысым, и начинает барабанить пальцами по своему «толстому» пузу. Затем он начинает слоняться вокруг того места, где должен быть его «напыщенный тип из высшего общества». «Сумасброд с проклятьями — вот он кто», — с презрительной усмешкой Вонючка небрежным жестом швыряет невидимое проклятье в «напыщенного типа».~
@11284 = ~«Узнал мое имя, позволил я ему ускользнуть, все так, получил по полной, по полной получил!» Он снова напыщивается, глубоко вдыхает и продолжает изображать своего типа «из высшего общества». Внезапно он сгибается пополам и ожесточенно испускает газы, потом выдыхает, наполняя воздух омерзительным зловонием. «Проклят зловонием и испражнениями! Пришел сюда, чтобы рассказывать истории, пока все, пока все хорошо. Теперь Вонючка — имя мне, придуманное имя, придуманное имя...»~
@11285 = ~От звука этого имени щеки Вонючки раздуваются, глаза выкатываются, и он неожиданно блюет себе под ноги. Все его тело дрожит, его мучит кашель и рвота... после нескольких долгих минут он вяло кивает и описывает полукруг возле сердца.~
@11286 = ~На миг Вонючка кажется обнадеженным, потом сникает. «Обещания, обещания... — он издает вздох, прерываемый зловонной икотой. — Попробуй, если хочешь, если хочешь...» ~
@11287 = ~Вонючка издает вздох, прерываемый зловонной икотой. «Тогда неважно, неважно...»~
@11288 = ~Когда ты подходишь, Вонючка узнает тебя и начинает яростно кивать, глядя на тебя своими огромными глазами. Вблизи к нему тебе в нос снова ударяет запах мочи и испражнений, окружающий его.~
@11289 = ~«Вопросы, вопросы... — Вонючка сгибается, недоверчиво глядя на тебя своими огромными глазищами. — Ответы, ответы?..»~
@11290 = ~«Могу историю поведать я, все так, но должен я увидеть три монетки». Лицо его расплывается в улыбке, а его зловонное дыхание бьет тебя, словно молот.~
@11291 = ~Он берет медяк, пробует его на зуб, затем, к твоему удивлению, проглатывает его. «Лучший кошелек, лучший кошелек здесь — это пузо, пузо, — он издает зловонную отрыжку. — История, история...» Он причмокивает, почесывая свои грязные лохмотья.~
@11292 = ~«Улей, Улей... историю могу поведать я, историю могу поведать я, все так, но должен я увидеть три монетки». Он причмокивает и хрюкает как кабан.~
@11293 = ~«В сторону шпиля, в сторону шпиля... — он указывает влево, на обугленную улицу вдали. — переулок *Опасных углов*, — он изгибает конечности в извращенной пародии на одно из тех скелетообразных строений. — Не всегда угловатый, не всегда сожженный и обугленный, когда-то оживленный, но не теперь».~
@11294 = ~«Пламя, пожар! — он вскидывает руки и колышет ими, изображая языки пламени. — Улица горела, много дыма, пепел повсюду... в итоге остались только *скелеты* домов, кости мертвых зданий, кости мертвых зданий. Углы... повсюду углы».~
@11295 = ~Он наклоняется вперед, голос его переходит в шепот. И вновь зловоние его тела сшибает тебя как волна. «Теперь опасно там: плохие люди устроили там логово, там логово, — он кивает, затем прерывисто пукает, словно дует в горн. — Вот история о том, как улица стала переулком Опасных Углов».~
@11296 = ~Он описывает полукруг возле сердца. «Это сделал человек. Это сделал зверь. Человек, которым восхищаются даже *нечистые*».~
@11297 = ~«Рассказ о чародее, наполненный безумием, унынием, пламенем, желанием... могу рассказ поведать я, могу рассказ поведать я, все так, но должен я увидеть три монетки, — шепчет он, затем издает звук, напоминающий тебе горящее пламя. — Опасный рассказ, опасный рассказ».~
@11298 = ~«Жил-да-был колдун, не простой маг-самоучка — *могущественный* чародей, — Вонючка благоговейно складывает руки, затем злобно усмехается. — Он сжигал Искусством, а Искусство сжигало его».~
@11299 = ~«Имя ему было Игнус — имя, которое уважали, потом боялись, потом ненавидели, потом преследовали». Вонючка издает клокочущую отрыжку, затем хватает воздух и шипит, очевидно, изображая «Игнуса».~
@11300 = ~«Обучен был Игнус одним из последних великих магов, и как ученик, Игнус знал много, много... и в то же время — ничего, — Вонючка горько качает головой. — В его сердце, угольно-черном сердце, пылал огонь. Он горел, он пылал, в нем просыпался *голод*, — Вонючка хватается за грудь, словно от боли. — И с ним голод просыпался в Игнусе. Он возжелал увидеть, как планы *сгорят*».~
@11301 = ~«Однажды ночью... — Вонючка сгибается и начинает медленно красться в сторону улицы, его лицо перекошено от безумного оскала. — Игнус пришел на улицу, ставший переулком Углов, и выпустил огонь, что был в его глазах и в его сердце», — Вонючка указывает на переулок, затем вскидывает руки, беззвучно крича и смеясь в одно и то же время.~
@11302 = ~«Плоть плавилась как воск, люди — словно свечи, а Игнус все смеялся, смеялся... — Вонючка падает на землю, его тело терзает воображаемая боль. — Зло, зло было содеяно, и не забыто, не забыто, — он встает, потом сгибается, смотрит налево, потом направо, потом начинает бормотать, будто бы тайком обращаясь к кому-то. — Нужно было что-нибудь сделать, сделать...»~
@11303 = ~Он неуклюже встает, в лице его решительность. «Было принято решение о наказании. Все маги-самоучки, повитухи, пересказчики рун, гадалки, всякие там ученики магов... собрались — все те, в ком есть хоть малейший след Искусства, — чтобы покарать Игнуса. По отдельности они как мухи... — он изображает своими гнилыми губами жужжание. — Вместе — опасны, опасны».~
@11304 = ~Он жужжит, потом поднимает руки... «Поймали Игнуса, исполнили его желание... — он вертит руками, как будто плетет заклинание. — Он хотел гореть, и они дали ему это, используя его собственную жажду для подпитки заклинания. Они сделали его тело дверью в план Огня: они намеревались убить его, убить его...»~
@11305 = ~«Не удалось, не удалось... — Вонючка снова выпускает газы, как бы подчеркивая провал магов. — Игнус выжил, Игнус выжил, только заснул; объятый пламенем, пламенем, заснул он — счастливей не был никогда, никогда... — он закрывает глаза, обхватывает себя руками и медленно поворачивается. — Пламя... вечное пламя... — его глаза неожиданно раскрываются. — Однажды он проснется — и тогда, тогда планы *сгорят*!»~
@11306 = ~Вонючка пукает, затем чешет руку. Минуту он раздумывает, потом качает головой. «Не видал, не видал я дневников».~
@11307 = ~Вонючка неожиданно сгибается и косится на тебя. Некоторое время он ходит вокруг тебя, подволакивая ногу, словно он хромой. «Король! Славный рассказ, славный рассказ! Могу поведать я рассказ, но должен я увидеть три монетки...» ~
@11308 = ~Вонючка продолжает сутулиться, смотря на тебя. «Был когда-то уважаемый человек, Фарод. Человек, человек целей и *положения*. Все пошло прахом, прахом, превратилось в дым, — Вонючка прищуривается, затем пукает, наполняя воздух запахом, от которого тебя выворачивает наизнанку. — Превратилось в дым... и зловоние».~
@11309 = ~«Лжец, обманщик, человек, извращающий закон — вот кем был Фарод», — он сгибается, как будто пишет что-то на столе. Некоторое время он «пишет», потом вдруг испуганно останавливается. «Потом, в один прекрасный день, он обнаружил, что обманул самого себя!»~
@11310 = ~«Таким лжецом он стал, что после смерти должен был попасть в ужасное место... — Вонючка горько качает головой, потом снова сгибается и бешено оглядывается по сторонам. — Фарод такого не примет, нет, нет! Он обманывал других — обманет и судьбу!»~
@11311 = ~«Он читал, копался в книгах, советовался с провидцами... — Вонючка, крадучись, отходит назад, подносит руку ко лбу, как бы вглядываясь вдаль. — И они сказали ему, что только в отбросах найдет он то, что позволит ему обмануть свою судьбу, — Вонючка снова пукает, потом разражается зловонным кашлем. — Возможно, они солгали...»~
@11312 = ~Вонючка неуклюже выпрямляется, затем начинает избавляться от воображаемой одежды. С каждой «вещью», которую он выкидывает, он все больше сутулится. «Фарод отбросил свое положение, свои цели, и принял новый титул... — Вонючка останавливается, косясь на тебя. Он хватает свои лохмотья, трясет ими. — И стал Королем Оборванцев! Он правит отбросами, заставляет своих подданным обыскивать все вокруг в поисках того, что ему нужно, — он качает головой. — Он ищет по сей день, по сей день...»~
@11313 = ~Вонючка качает головой. «Он живет среди тряпья и отбросов. Там ты его и найдешь, найдешь...»~
@11314 = ~Вонючка на время прекращает дергаться и почесываться, и смотрит на тебя. «Эта история... эта история ничего не стоит, потому как не имеет ценности, и раз она ее не имеет, то будет она действительно печальной».~
@11315 = ~«Где же начинается такая история?..» Вонючка хрюкает, потом издает зловонную отрыжку, от которой у тебя слезятся глаза. Кажется, он в раздумье.~
@11316 = ~Вонючка кивает, затем внимательно смотрит на тебя и начинает яростно чесаться, как будто хочет наделать себе шрамов. «Мертвый, но не мертвый... нет памяти, нет памяти, нет имени...»~
@11317 = ~Вонючка, казалось бы, загипнотизирован твоими словами. «Да, да, в именах много опасности... наверно... — он умолкает. — Наверно, тот, с кем говорит безымянный, сам является предостережением об опасности имен, — он, похоже, обдумывает это. — Наверно, тому, кто забыл свое имя, повезло?..»~
@11318 = ~Вонючка отрывисто кашляет, затем сплевывает. Плевок зеленый и влажный. После этого он оборачивается к тебе. «Это твой вопрос, твоя история... — говорит он неспешно. — И *ты* должен на него ответить».~
@11319 = ~Вонючка качает головой. «Мой ответ, мой ответ...» Он снова кашляет, изрыгая очередную волну зловония. Он причмокивает, как бы пытаясь убрать этот вкус изо рта. «Вот мой ответ: они оба дураки, но только один из них знает об этом сам».~
@11320 = ~Вонючка обдумывает это, облизывая губы. Он начинает медленно кивать, затем бормочет себе что-то под нос, как бы споря с самим собой. Наконец он оборачивается к тебе. «Это история, история с моралью, которая рассказывает о морали рассказчика... — он кашляет и сплевывает еще один комок мокроты на мостовую. — История, которая объяснится со временем, со временем?..»~
@11321 = ~Вонючка некоторое время чешется, кивая, затем сует руку в складки своей одежды и достает тебе монету. «За такой рассказ — срезанный медяк, — усмехается он. — Не больше, ведь рассказ не закончен».~
@11322 = ~Ты видишь Вонючку... его глаза вернулись к своим обычным размерам, и его больше не мучают те конвульсивные спазмы, которые ты раньше замечал. Он улыбается и выглядит намного чище, чем раньше. ~
@11323 = ~Он изумленно смотрит на тебя. «Все... прошло. Все прошло, вот просто так, — он щелкает пальцами, потом смотрит на себя. — Силы небесные, я... — он смеется. — Я снова чувствую себя *чистым*».~
@11324 = ~«Спасибо, сэр. Я... — он кажется взволнованным. — Мне нечем тебе отплатить, но я у тебя в долгу... — он пожимает плечами. — Если это хоть что-то для тебя значит, — он нахмуривается, затем выпрямляется. — Я поведаю историю о твоей доброте всем, кто будет слушать».~
@11325 = ~«Конечно, конечно! — Вонючка оглядывается. — Хотя я уже нарассказывался на много лет вперед... у тебя есть что-нибудь, на чем можно их записать?»~
@11326 = ~Вонючка берет дневник. «О... — некоторое время он пишет в нем, затем отдает его тебе. — Держи».~
@11327 = ~«Э... Если ты больше не будешь использовать это имя, я... кроме всего прочего, буду благодарен тебе».~
@11328 = ~«Меня зовут... — внезапно он запинается и улыбается. — Нет, пожалуй, на этот раз я оставлю его при себе, — он вежливо кланяется тебе. — Еще раз спасибо, сударь».~
@11329 = ~Оставить оборванца в покое.~
@11330 = ~«Не сегодня. Прощай».~
@11331 = ~«Опасны?»~
@11332 = ~«Неважно. Прощай».~
@11333 = ~«Э... подходящее имя».~
@11334 = ~«А что, это имя тебе вполне подходит».~
@11335 = ~«Это твое настоящее имя?»~
@11336 = ~«Понятно... Прощай».~
@11337 = ~«О чем это ты?»~
@11338 = ~«Понятно... Прощай».~
@11339 = ~«Я не знаю свое настоящее имя».~
@11340 = ~«Понятно... Прощай».~
@11341 = ~«Тебя обидели?»~
@11342 = ~«Понятно... Прощай».~
@11343 = ~«Хорошо. Вот три медяка».~
@11344 = ~Ложь: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11345 = ~Правда: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11346 = ~«Не сегодня. Прощай».~
@11347 = ~Слушать.~
@11348 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11349 = ~«Думаю, я услышал достаточно. Прощай».~
@11350 = ~Перед тобой пухлый низкорослый мужчина со недоуменным выражением лица. Если учесть морщины на его обвисшей коже, выглядит все не так уж и необычно. Он держит быстро пустеющий кувшин эля. Между глотками он обращается к тебе нежным голосом, таким тихим, что ты едва слышишь его слова. «Здравствуй, путешественник. Меня зовут Илквикс. Чем могу помочь?»~
@11351 = ~«Приветствую. Я хотел бы задать тебе несколько вопросов».~
@11352 = ~«Нет. Прощай».~
@11353 = ~Человек с дряблой кожей улыбается тебе. «И снова здравствуй, путешественник. Что Илквикс может сделать для тебя на этот раз?»~
@11354 = ~«Здравствуй, Илквикс. У меня к тебе несколько вопросов».~
@11355 = ~«Ничего. Прощай».~
@11356 = ~«Что ты хочешь узнать, приятель?»~
@11357 = ~«Кто ты вообще такой?»~
@11358 = ~«Кто ты вообще такой?»~
@11359 = ~«Что ты можешь рассказать об этом месте?»~
@11360 = ~«Что ты можешь рассказать о местных посетителях?»~
@11361 = ~«Кто этот горящий мужчина?»~
@11362 = ~«Я пытаюсь найти способ заставить Мочай расплатиться за выпивку. Есть предложения?»~
@11363 = ~«Ничего. Прощай».~
@11364 = ~Слушать.~
@11365 = ~«Я? Я всего лишь скромный человек со слегка пышными поэтическими наклонностями и любовью к сверхъестественному. Жаль, что у меня нет с собой моих запасов, я бы очень, ОЧЕНЬ хотел научить тебя путям силы». Он делает паузу и восхищенно смотрит на Грацию. «И позволь сделать тебе комплимент по поводу выбора спутников. Ты явно из тех, кто знает, что ему нужно. Самый амбициозный из всех мужчин».~
@11366 = ~«Постой-ка... Я *встречал* человека, который тебя проклял. Его зовут Смыслогуб, не так ли?»~
@11367 = ~«Я? Я всего лишь скромный человек со слегка пышными поэтическими наклонностями и любовью к сверхъестественному. Жаль, что у меня нет с собой моих запасов, я бы очень, ОЧЕНЬ хотел научить тебя путям силы. Может быть, в другой раз?»~
@11368 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11369 = ~«Да, мне бы этого хотелось. Но сейчас у меня есть несколько вопросов...»~
@11370 = ~«Я услышал достаточно. Прощай».~
@11371 = ~«Может быть. Прощай».~
@11372 = ~«Понятно... У меня есть другие вопросы...» ~
@11373 = ~«Об этом месте? Тлеющем трупе? Прекрасное заведение с отличным владельцем. Баркис — настоящий джентльмен, старается прочно стоять на ногах. Я считаю, что это самые полезные качества».~
@11374 = ~«Они воодушевляют людей. У меня были другие вопросы...»~
@11375 = ~«Постой-ка... Я *встречал* человека, который тебя проклял. Его зовут Смыслогуб, не так ли?»~
@11376 = ~«Многие с тобой согласятся. Прощай».~
@11377 = ~«В этой таверне много разнообразных посетителей. Я разговаривал почти со всеми и нашел их очаровательными, за исключением тех порождений закона, — он указывает на пару сидящих в углу абишаев. — Они отравляют воздух одним лишь своим присутствием, загрязняя отвратительным зловонием все прекрасное вокруг. Рекомендую поговорить с Баркисом — кажется, ему нужна помощь с одним пустяковым делом. Еще здесь есть некий О — я все еще пытаюсь его осмыслить. Он — *весьма* загадочная личность, надо сказать. Эти персоны вызывают наибольший интерес. Остальные... ну, наверное, я слишком разборчив».~
@11378 = ~«Я услышал достаточно. Прощай».~
@11379 = ~«Почему ты презираешь порождения закона?»~
@11380 = ~«Что случилось после того, как ты встретил... его?»~
@11381 = ~«Может быть. У меня есть другие вопросы...»~
@11382 = ~«Печальный рассказ. У меня есть другие вопросы к тебе...»~
@11383 = ~«Спасибо за уделенное время. Прощай».~
@11384 = ~«Ну, знаешь, он мертв».~
@11385 = ~«Этот? Ха. Это последний неудачник из тех, кто пытается выразить собственную индивидуальность, не имея силы для подкрепления своих желаний. Его зовут Игнус, и он пироманьяк... был пироманьяком. Он сжигал и сжигал, но жег не тех людей, и в итоге сгорел, пытаясь пропустить через себя больше чистой энергии, чем мог контролировать. Теперь ты видишь, что с ним стало. Если хочешь узнать о нем побольше, возможно, несчастная Друзилла сможет тебе помочь».~
@11386 = ~«Знаешь, я, пожалуй, мог бы заставить его снять проклятие».~
@11387 = ~«Понятно. У меня есть другие вопросы...» ~
@11388 = ~«Понятно. Прощай».~
@11389 = ~«Счастливо».~
@11390 = ~Он хохочет, болтая челюстью, которая едва не отваливается. «Ты всегда можешь ее отравить, приятель! Одна такая порция всегда может разрешить почти *любой* конфликт! — он снова смеется. — Конечно же, я шучу». Он подмигивает.~
@11391 = ~«Что случилось после того, как ты встретил... его?»~
@11392 = ~«Ну конечно. У меня есть другие вопросы...»~
@11393 = ~«Ну конечно. Прощай».~
@11394 = ~«А, хороший вопрос, друг мой! Мое отрочество прошло на хаотичной стороне Великого Кольца — ты можешь поговорить на эту тему с Кандрианом Низкородным (самое неправильное имя, какое я слышал). Он считает себя великим путешественником по планам. Но вернемся ко мне. Я много лет жил бок о бок с Хаосом, и теперь нахожу его весьма приемлемым. Я считаю, что пятно закона, которое лежит на тех существах, достойно осуждения и тиранично. Если мне сужден быть раздавленным под чье-либо пятой, то я бы предпочел, чтобы это была личность, а не бездушная машина».~
@11395 = ~Правда: «Более чем согласен».~
@11396 = ~Ложь: «Более чем согласен».~
@11397 = ~Правда: «Я не согласен».~
@11398 = ~Ложь: «Я не согласен».~
@11399 = ~«Многие бы с тобой согласились. У меня есть другие вопросы...»~
@11400 = ~«Многие бы с тобой согласились. Прощай».~
@11401 = ~Илквикс улыбается во весь рот, его жирные щеки едва движутся. «Каждому свое, я считаю. У тебя есть еще вопросы?»~
@11402 = ~«Да».~
@11403 = ~«Нет. Прощай».~
@11404 = ~Сделав небольшой реверанс, Грация отвечает: «Уверена, что твои любезные слова растопят любое сердце, Илквикс. И все же мы должны помнить, что многие люди одновременно больше и меньше, чем они кажутся. Было бы весьма досадно, если бы все мы так быстро разоблачались... пожалуй, даже слишком досадно».~
@11405 = ~«Что ты имеешь в виду, Грация?»~
@11406 = ~«Довольно. Мне нужны ответы на несколько вопросов, Илквикс».~
@11407 = ~«Я лишь хотела сказать, что об опрометчивых словах потом часто жалеют, и что многие обладают чертами и даже достоинствами, о которых никто даже и не подозревает. Слишком многие делают скоропалительные выводы и даже не осознают, что эти выводы обрушатся потом на них самих. Поэтому нам лучше обдумывать свои слова до того, как они раскроют о нас больше, чем мы того хотели».~
@11408 = ~«Понятно... Илквикс, у меня были еще вопросы...»~
@11409 = ~«Хорошо сказано, Грация. Прощай, Илквикс».~
@11410 = ~«Закончим эту беседу. Прощай, Илквикс».~
@11411 = ~«У меня есть другие вопросы к тебе...»~
@11412 = ~«Схожу поговорю с ним сейчас же. Прощай».~
@11413 = ~«У меня есть другие вопросы к тебе...»~
@11414 = ~«Счастливо».~
@11415 = ~«Привет, Вонючка. У меня есть вопросы к тебе...»~
@11416 = ~Оставить Вонючку в покое.~
@11417 = ~«Еще раз, кто ты?»~
@11418 = ~«Что с тобой случилось?»~
@11419 = ~«Я хочу послушать историю».~
@11420 = ~«Что ты можешь рассказать об этом месте?»~
@11421 = ~«Ты не подскажешь, где я могу найти некоего Фарода?»~
@11422 = ~«Что ты можешь еще раз сказать мне о Фароде?»~
@11423 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@11424 = ~«Я встретил проклявшего тебя человека в Городском Фестхолле. Его зовут Смыслогуб».~
@11425 = ~«Счастливо».~
@11426 = ~«Хорошо. Вот три медяка».~
@11427 = ~Ложь: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11428 = ~Правда: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11429 = ~«Не сегодня. Прощай».~
@11430 = ~Подождать, пока он выберет историю.~
@11431 = ~Подождать, пока он выберет историю.~
@11432 = ~Подождать, пока он выберет историю.~
@11433 = ~«Я хотел бы послушать историю о том, как ты был проклят».~
@11434 = ~«Я хотел бы послушать о том, что случилось с переулком Опасных углов». ~
@11435 = ~«Спокойно. Я просто хочу задать тебе несколько вопросов».~
@11436 = ~«От тебя? Ничего».~
@11437 = ~«Судя по твоему поведению, тебе от меня больше ничего не нужно, поэтому я был бы очень рад, если бы ты больше не тревожил меня своим присутствием. Всего хорошего». С надменным видом он отворачивается от тебя.~
@11438 = ~«Послушай, я приношу свои извинения за то, что сказал тебе. Мне просто нужно, чтобы ты ответил на несколько вопросов».~
@11439 = ~«Вот и отлично».~
@11440 = ~«Что сказано — то сказано. Я принял это близко к сердцу. Что ж, по крайней мере, теперь никто не скажет, что я твердолобый. Что ты хотел у меня спросить?»~
@11441 = ~«Еще раз, кто ты?»~
@11442 = ~«Кто посещает эту таверну?»~
@11443 = ~«Что ты можешь рассказать об этом месте?»~
@11444 = ~«Я ищу дневник. Тебе ничего такого не попадалось в последнее время?»~
@11445 = ~«Что-нибудь слышал о сборщике по имени Фарод?»~
@11446 = ~«Я бы хотел извиниться перед тобой».~
@11447 = ~«Я бы хотел извиниться перед тобой».~
@11448 = ~«Ничего. Забудь».~
@11449 = ~Его глаза вспыхивают огнем. «Довольно с меня оскорблений, 'приятель'. Я больше не стану с тобой разговаривать». С чувством задетого собственного достоинства он гордо отворачивается. Никакие льстивые обращения с твоей стороны не заставят его повернуться к тебе снова.~
@11450 = ~Атаковать его.~
@11451 = ~Оставить его в покое.~
@11452 = ~«Единственный, кого я здесь знаю — это Эбб. Я тут недавно, поэтому стараюсь не совать свой нос в чужие дела. У тебя есть ко мне другие вопросы, или я могу продолжить наслаждаться своим одиночеством?»~
@11453 = ~«Я хотел бы послушать рассказ об Игнусе».~
@11454 = ~«Ну, вообще-то, у меня есть еще несколько вопросов к тебе».~
@11455 = ~«Можешь возвращаться к тому, чем занимался».~
@11456 = ~Он тяжело вздыхает, презрительно глядя на тебя. «Тогда покончим с этим, человек со шрамами. Задавай свои вопросы и уходи».~
@11457 = ~«Я хотел бы послушать историю о человеке, который пришел в этот город без имени и без воспоминаний, и поговорил с проклятым рассказчиком, который предупредил его об опасности имен».~
@11458 = ~«Еще раз, кто ты?»~
@11459 = ~«Я хотел бы послушать историю о человеке, который пришел в этот город без имени и без воспоминаний, и поговорил с проклятым рассказчиком, который предупредил его об опасности имен».~
@11460 = ~«Кто посещает эту таверну?»~
@11461 = ~«Что ты можешь рассказать об этом месте?»~
@11462 = ~«Я ищу дневник. Тебе ничего такого не попадалось в последнее время?»~
@11463 = ~«Не сегодня. Прощай».~
@11464 = ~«Что-нибудь слышал о сборщике по имени Фарод?»~
@11465 = ~«Я бы хотел извиниться перед тобой».~
@11466 = ~«Я бы хотел извиниться перед тобой».~
@11467 = ~«Ничего. Забудь».~
@11468 = ~«Хорошо. Вот три медяка».~
@11469 = ~«Это таверна, одно из тех мест, которые напоминают мне дом. Это если не обращать внимания на нечисть в углу и бесконечный парад странностей вокруг меня. По крайней мере, в этом месте есть немного людей, чему я весьма рад».~
@11470 = ~«Ах вот оно что. Ты случаем не невежда?»~
@11471 = ~«Ты ведь первичник, не так ли?»~
@11472 = ~«Могу себе представить. Еще вопрос, если можно».~
@11473 = ~«Могу себе представить. Прощай».~
@11474 = ~«Дневник? И где бы я мог его увидеть? Я здесь совсем недавно, как ты мог ожидать, что я вспомню о каком-то ДНЕВНИКЕ? Ты не только груб и бестактен, но, похоже, еще и глуп».~
@11475 = ~«Давай не переходить на оскорбления, ладно?»~
@11476 = ~«Ты пытаешься меня спровоцировать?»~
@11477 = ~«Это бессмысленно. Прощай».~
@11478 = ~Атаковать его.~
@11479 = ~Ложь: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11480 = ~Правда: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11481 = ~«Не сегодня. Прощай».~
@11482 = ~Слушать.~
@11483 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11484 = ~«Я услышал достаточно. Прощай».~
@11485 = ~Слушать.~
@11486 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11487 = ~«Я услышал достаточно. Прощай».~
@11488 = ~«Как начался пожар?»~
@11489 = ~«У меня есть другие вопросы...»~
@11490 = ~«Понятно... Прощай».~
@11491 = ~«Кто?»~
@11492 = ~«У меня есть другие вопросы...»~
@11493 = ~«Это все, что я хотел узнать. Прощай».~
@11494 = ~«Хорошо. Вот три медяка».~
@11495 = ~Ложь: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11496 = ~Правда: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11497 = ~«Не сегодня. Прощай».~
@11498 = ~Слушать.~
@11499 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11500 = ~«Я услышал достаточно. Прощай».~
@11501 = ~Слушать.~
@11502 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11503 = ~«Я услышал достаточно. Прощай».~
@11504 = ~Слушать.~
@11505 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11506 = ~«Я услышал достаточно. Прощай».~
@11507 = ~Слушать.~
@11508 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11509 = ~«Я услышал достаточно. Прощай».~
@11510 = ~Слушать.~
@11511 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11512 = ~«Я услышал достаточно. Прощай».~
@11513 = ~Слушать.~
@11514 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11515 = ~«Я услышал достаточно. Прощай».~
@11516 = ~Слушать.~
@11517 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11518 = ~«Я услышал достаточно. Прощай».~
@11519 = ~«Какая несчастливая история. У меня к тебе еще несколько вопросов...»~
@11520 = ~«Я услышал достаточно. Прощай».~
@11521 = ~«У меня есть другие вопросы к тебе...»~
@11522 = ~«Тогда неважно. Прощай».~
@11523 = ~«Хорошо. Вот три медяка».~
@11524 = ~«Я же уже сказал, что я здесь недавно, а ты продолжаешь надо мной издеваться. Ясное дело, что я ничего не знаю ни о каких 'сборщиках'. Теперь ты оставишь меня в покое?»~
@11525 = ~«Пока нет. Мне все еще есть к тебе вопросы».~
@11526 = ~«Я бы хотел извиниться перед тобой».~
@11527 = ~«Я хотел бы хоть как-то возместить ущерб».~
@11528 = ~«Несомненно. Всего хорошего».~
@11529 = ~Он выглядит ошарашенным, словно понятие извинения для него совершенно незнакомо. «Ты хочешь... принести извинения?»~
@11530 = ~«Именно так я и сказал».~
@11531 = ~«Хотя нет. Я передумал. Прощай».~
@11532 = ~«Тогда... тогда... в таком случае, я полагаю, что принять твои извинения — дело чести для меня. Хорошо. В ответ я также приношу свои извинения. Давай отринем прошлые обиды и забудем их навсегда».~
@11533 = ~«Хорошо. Не ответишь еще на пару вопросов?»~
@11534 = ~«Отлично. Прощай».~
@11535 = ~«Может быть, я и глупец, но я не настолько глуп, чтобы терпеть от тебя оскорбления и просто так их прощать. Можешь хоть на кол насадиться — мне все равно. Надеюсь, ты заработаешь себе новые шрамы, а может, и немного чести. Всего хорошего, сэр». Он чопорно отворачивается, полностью тебя игнорируя.~
@11536 = ~Атаковать его.~
@11537 = ~Уйти.~
@11538 = ~«Ты дважды оскорбил меня! Больше я не собираюсь этого терпеть. Защищайся!»~
@11539 = ~«Мы можем решить эту проблему...»~
@11540 = ~«Если ты имеешь в виду, из настоящего ли я мира, то да, я — первичник. Я — не очень известный здесь воин. И хоть я и не знаю каждого закоулка на этой новой земле, но я не позволю называть себя 'невеждой', как любят выражаться местные».~
@11541 = ~«Нет, все нормально. Давай забудем все обиды?»~
@11542 = ~«Правда? А я бы назвал».~
@11543 = ~«Отлично. Прощай».~
@11544 = ~Ложь: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11545 = ~«Забудем? Не раньше, чем ты принесешь свои извинения, негодяй, — всем своим видом он показывает, что готов ринуться в бой. — Или продолжать тебя провоцировать?»~
@11546 = ~«Ну хорошо. Я приношу свои извинения».~
@11547 = ~«Извинения? Тебе? Никогда».~
@11548 = ~Правда: «У меня нет с собой столько. Хотя у меня есть еще вопросы...»~
@11549 = ~«Ты простой подлец, слизняк без чувства чести, кусок мяса, лишенный духа, старик со шрамами без надежды на искупление, обреченный влачить жизнь, лишенную всякого намека на человечность. Я закончил с тобой, и теперь ощущаю к тебе только жалость. Всего хорошего, сэр». Он поворачивается к тебе спиной.~
@11550 = ~Атаковать его.~
@11551 = ~Уйти.~
@11552 = ~«Не сегодня. Прощай».~
@11553 = ~«Что за знания ты ищешь?»~
@11554 = ~Слушать.~
@11555 = ~«Кто ты?»~
@11556 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11557 = ~«Кто посетители этой таверны?»~
@11558 = ~«Я услышал достаточно. Прощай».~
@11559 = ~«Кто посещает эту таверну?»~
@11560 = ~Слушать.~
@11561 = ~«Что ты можешь рассказать об этом месте?»~
@11562 = ~«Я ищу дневник. Тебе ничего такого не попадалось в последнее время?»~
@11563 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11564 = ~«Я услышал достаточно. Прощай».~
@11565 = ~Перед тобой подтянутый, мускулистый мужчина. На нем сравнительно простая и неброская одежда, которая разительно выделяется на фоне тех нарядов, которые тебе доводилось видеть в этом городе. Воздух вокруг него словно пронизан надменным высокомерием. На вид он явно не из здешних мест. «Чего тебе нужно?» — спрашивает он.~
@11566 = ~«Кто ты?»~
@11567 = ~Слушать.~
@11568 = ~«Кто посещает эту таверну?»~
@11569 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11570 = ~«Что ты можешь рассказать об этом месте?»~
@11571 = ~«Я ищу дневник. Тебе ничего такого не попадалось в последнее время?»~
@11572 = ~«Я услышал достаточно. Прощай».~
@11573 = ~«Я ищу дневник. Тебе ничего такого не попадалось в последнее время?»~
@11574 = ~«Что-нибудь слышал о сборщике по имени Фарод?»~
@11575 = ~Слушать.~
@11576 = ~«На самом деле, сейчас у меня нет времени на рассказы. У меня есть несколько вопросов...»~
@11577 = ~«Я услышал достаточно. Прощай».~
@11578 = ~«Э... Ты знаешь, где его можно найти?»~
@11579 = ~«У меня есть другие вопросы...»~
@11580 = ~«Ничего. Забудь».~
@11581 = ~«Я услышал достаточно. Прощай».~
@11582 = ~«У меня есть другие вопросы...»~
@11583 = ~«Что-нибудь слышал о сборщике по имени Фарод?»~
@11584 = ~«Я услышал достаточно. Прощай».~
@11585 = ~«Я — Алаис, прославленный воин! Ты наверняка слышал обо мне?»~
@11586 = ~«Тем не менее, я хотел бы ее услышать».~
@11587 = ~«Хорошо. У меня есть другие вопросы...»~
@11588 = ~Ложь: «Да».~
@11589 = ~«Я услышал достаточно. Прощай».~
@11590 = ~Правда: «Нет».~
@11591 = ~«Она начинается с человека, который очнулся в Морге, сочтенный мертвым, но на самом деле мертвы были только его воспоминания».~
@11592 = ~«Наконец-то! Хоть кто-то здесь не полный невежда! Разрешаю тебе купить мне выпить, а потом мы обменяемся историями! Я попотчую тебя одним из последних моих приключений, в котором я попал в этот удивительный и тревожный город».~
@11593 = ~«Хорошо. У меня есть другие вопросы...»~
@11594 = ~«Жду с нетерпением. Но сперва не мог бы ты ответить на несколько вопросов?»~
@11595 = ~«Откуда ты пришел? КАК ты попал сюда?»~
@11596 = ~«Я услышал достаточно. Прощай».~
@11597 = ~«Может, позже. Прощай».~
@11598 = ~«Он совершает побег из Морга, попадает в Улей и заводит разговор с человеком, который однажды позволил своему настоящему имени ускользнуть и пожалел об этом».~
@11599 = ~«Хорошо. У меня есть другие вопросы...»~
@11600 = ~«Я услышал достаточно. Прощай».~
@11601 = ~«Вот как? Что лучше: страдать от правды со всеми ее последствиями или оставаться в неведении? Кому из этих людей лучше?» ~
@11602 = ~«Хорошо. У меня есть другие вопросы...»~
@11603 = ~«Я услышал достаточно. Прощай».~
@11604 = ~«Я хочу услышать твой ответ».~
@11605 = ~«Лучше быть человеком, знающим свое истинное имя, поскольку он знает себя, и потому он более сильный».~
@11606 = ~«Как? Как такое может быть, что никто в этом городе не слышал обо мне и моих подвигах? Увы... Я снова должен показать себя в деле. И отсюда моя слава вновь разойдется по всему миру».~
@11607 = ~«Лучше быть человеком, забывшим свое истинное имя, ведь он защищен от тех, кто хочет причинить ему боль, включая себя самого. Человека с именем можно выследить. Безымянный же не оставляет за собой следа».~
@11608 = ~«Из *какого* мира ты пришел?»~
@11609 = ~«Уверен, что так и будет. Ты можешь ответить на другие вопросы?»~
@11610 = ~«Неважно. У меня есть другие вопросы...»~
@11611 = ~«Я услышал достаточно. Прощай».~
@11612 = ~«Мы все иногда сталкиваемся с разочарованиями. Прощай».~
@11613 = ~«Хорошо. У меня есть другие вопросы...»~
@11614 = ~«Я услышал достаточно. Прощай».~
@11615 = ~Правда: «Возможно. Чему быть — того не миновать, и, может статься, этот рассказ не содержит ответа».~
@11616 = ~Правда: «Ответ должен быть, и у каждой истории есть конец. Я отказываюсь принимать любые другие варианты».~
@11617 = ~Правда: «Я не знаю. Это не мне решать».~
@11618 = ~«Справедливая цена. Что ж, очень хорошо. Возможно, ты ответишь мне еще на пару вопросов...»~
@11619 = ~«Счастливо».~
@11620 = ~«Привет, Вонючка. У меня есть вопросы к тебе...»~
@11621 = ~Оставить Вонючку в покое.~
@11622 = ~«Рад слышать это. Джамбл не хотел снимать проклятье, но я его заставил».~
@11623 = ~«Рад слышать, что тебе уже лучше».~
@11624 = ~«Рад слышать это. Джамбл не хотел снимать проклятье, но я его заставил».~
@11625 = ~«Рад слышать, что тебе уже лучше».~
@11626 = ~«Собственно, а у тебя есть истории, которые ты мне еще не рассказывал? Этого было бы достаточно...»~
@11627 = ~«Спасибо, Вонючка. Был рад помочь тебе».~
@11628 = ~«У меня с собой дневник».~
@11629 = ~«Я из города Алиберн на реке Тейм. Слыхал о его красоте и чудесах? А, неважно... Это место окутано мраком невежества, когда дело доходит до великолепия настоящих городов. Жители этого города сказали мне, что мой мир называется 'первичным', вот только я не понимаю — первичным для чего?»~
@11630 = ~«Спасибо, Вонючка».~
@11631 = ~~
@11632 = ~«Отлично. Как же мне тебя называть?»~
@11633 = ~~
@11634 = ~«Вполне справедливо. Прощай».~
@11635 = ~~
@11636 = ~«Счастливо».~
@11637 = ~Побагровев от злости, он судорожно нащупывает эфес своего меча. «Значит, невежда? Твои слова оскорбили меня, сударь. Прощай, и надеюсь, что наши пути больше никогда не пересекутся». Преисполненный яростью и гордыней, он отворачивается от тебя.~
@11638 = ~«Я просто хочу задать тебе несколько вопросов».~
@11639 = ~«Тогда прощай». ~
@11640 = ~«Я общался только со старым Эббом Коленоскрипом, который рассказал мне об устройстве города и 'полянах'. Должно быть, заклинание моего врага перебросило нас через весь мир, потому что, насколько мне известно, на прежнем месте никаких полян не было».~
@11641 = ~«Нет-нет... не поляны, а планы, уровни бытия. Это планы представлений, мыслей и убеждений. Это не обычные прерии или лужайки, а другие измерения».~
@11642 = ~«Нет-нет... не поляны, а планы, уровни бытия. Это планы представлений, мыслей и убеждений. Это не обычные прерии или лужайки, а другие измерения».~
@11643 = ~«Ясно. Ты невежда».~
@11644 = ~«Э-э. Ну да, верно. Послушай, у меня есть еще вопросы».~
@11645 = ~«Ты оказался далеко от своего дома. Желаю удачи. Прощай».~
@11646 = ~На его лице возникает выражение смущения. «Теперь... теперь я понимаю. Слова старика начинают обретать смысл... Прошу прощения. Мне нужно обдумать это. Прощай».~
@11647 = ~«Прощай».~
@11648 = ~«Не знаю. Когда я прибыл сюда, я понял, что мне нужно место, где можно было бы перевести дух. Представь себе мое потрясение, когда я обнаружил, что в этой части мира даже обычная таверна населена чудаками и безумцами. Я определенно попал в сумасшедший дом!»~
@11649 = ~«Откуда ты?»~
@11650 = ~«Временами здесь все таким кажется. Я бы хотел задать тебе еще пару вопросов».~
@11651 = ~«Так и есть. Прощай».~
@11652 = ~«Боюсь, что меня не интересуют подобные вещи. Я стараюсь сориентироваться в незнакомой обстановке, и в попытке это сделать уделять много внимания мелочам, но, должен признать, никаких дневников я не искал».~
@11653 = ~«Ну хорошо. Ответь мне на другие вопросы».~
@11654 = ~«Хорошо. Спасибо за уделенное время».~
@11655 = ~«Фарод? Сборщик? Это имя и понятие мне незнакомы, но если бы я их услышал в каком-нибудь контексте, я бы их запомнил. Твое лицо я определенно запомню. Его уж точно не забудешь».~
@11656 = ~«Спасибо. Еще пара вопросов, хорошо?»~
@11657 = ~«Спасибо. Прощай».~
@11658 = ~«Ничего. Забудь».~
@11659 = ~~
@11660 = ~«Просто ответь на другие вопросы...»~
@11661 = ~«Расскажи мне о Леди».~
@11662 = ~«Расскажи мне о дабусах».~
@11663 = ~«Расскажи мне о времени Сигила».~
@11664 = ~«Расскажи мне о городских районах».~
@11665 = ~«Расскажи мне о ключах и порталах».~
@11666 = ~«Ничего. Прощай».~
@11667 = ~Она напряженно улыбается. «Да, нечисть, мы тут, оказывается, верим в *реальную* свободу. Никто не запретит мне говорить то, что я думаю». Илквикс на мгновение презрительно усмехается, однако тут же надевает свою учтивую маску.~
@11668 = ~«Продолжай в том же духе. Илквикс, у меня есть другие вопросы...»~
@11669 = ~«Продолжай в том же духе. Илквикс, у меня есть другие вопросы...»~
@11670 = ~Сбежать.~
@11671 = ~Мужчина озирается на голос, его вялость пропадает... в глаза вспыхивают два огонька. «Какого черта ты ввалился в мой дом? — глаза сужаются, челюсть стиснута. — Проваливай! Или я верну тебя обратно в твою могилу!»~
@11672 = ~«Какого черта ты цеплялся к моей жене?! Тут тебе не притон для любителей поразвлечься со шлюхами... оставь-ка ее в покое и проваливай из моего дома подобру-поздорову, пока в книге мертвых не появилось новое имя!»~
@11673 = ~Лицо мужчины наливается кровью, он начинает кричать. «Ты че, тупой?! — рыкнув, он плюет тебе под ноги. — *Ты вонючая плешивая псина! Проваливай, или даже силы не спасут твою шкуру!*»~
@11674 = ~Мужчина цедит тебе в спину: «Только попробуй еще раз нарисоваться у меня в дверях, вонючий ублюдок».~
@11675 = ~Перед тобой Ангар: лучше ему с прошлого раза явно не стало. Ты снова подходишь к нему, он медленно меняется в лице. «Опять ты! Что, чумная псина, С ПЕРВОГО раза не дошло?! Вон из моего дома, или я, да помогут мне силы, зарублю тебя на месте!»~
@11676 = ~Кровь схлынивает с лица Ангиара при одном только виде контракта. Лишь на мгновение потеряв дар речи, он вновь разъяряется. «Где ты его достал?! Во имя сил, тебе лучше сознаться...»~
@11677 = ~Ангиар что-то бормочет, после чего его ярость находит новую мишень. «Я... я *убью* ее! Я...»~
@11678 = ~«Да как ты... как ты *посмел*... грозить мне... в моем *собственном* доме?.. — перед тем как взорваться, он делает глубокий вдох. — Вали отсюда, будь ты проклят! И свою чертову бумажку захвати!»~
@11679 = ~«Она нарушила слово, данное мне, ее *мужу*! — Ангиар стискивает кулаки и сердито смотрит на тебя. — Сказал же я ей: никому не говори — и вот узнаю, что она проболталась первому же незнакомцу, вошедшему в дом!»~
@11680 = ~Ярость Ангиара пропадает, он начинает ворчать. «Что сделано, то сделано... — глядя на тебя с недоверием, он кивает на контракт. — Что ты собираешься делать с этой бумажкой?»~
@11681 = ~Ангиар не может оторвать взгляда от контракта. «Зачем ты принес его мне? — недоверчиво спрашивает он. — Чтобы перепродать?»~
@11682 = ~Ты рвешь пергамент. Ангиар обреченно наблюдает за тем, как клочки бумаги падают на землю. Он вздрагивает, затем выпрямляется, словно с его плеч сваливается огромная тяжесть. «Ты...» Он собирается поблагодарить тебя, но прерывает себя и бросает на тебя подозрительный взгляд. «Ничего не бывает бесплатно. Только не в Улье, рубака».~
@11683 = ~Ярость Ангиара куда-то пропадает. Похоже, он жутко устал от борьбы за свое счастье. «Я... я... должно быть, молился правильной силе последние полмесяца, — он вздыхает. — Спасибо тебе, рубака... если для тебя это хоть что-то значит».~
@11684 = ~«Я уже продал свою жизнь и больше не собираюсь ею торговать. Особенно с ходячим трупом, — в сердцах произносит он. — Проваливай из моего дома, или откинешься во второй раз!»~
@11685 = ~Ангиар кивает: «Задавай свои вопросы».~
@11686 = ~Ангиар кивает. «Ага, мне знакомо это имя, только его владелец мне не очень нравится».~
@11687 = ~Он хмурится. «Он один из сборщиков; тень у него длинная: куча мальчиков на побегушках. Он хоть и не король, но лучше с ним вообще не связываться».~
@11688 = ~«Падальщики, шакалы, гиены... грязные пни, у которых нет ни капли достоинства. Почти все они живут на площади Старьевщиков. Собирают жмуриков, вытряхивают с них все, что может стоить звенелок, а потом продают их в Морге трухлявым».~
@11689 = ~«Трухлявые платят за тела. Это помогает держать улицы в чистоте, когда дождя недостаточно».~
@11690 = ~«Уж лучше тебе этого не говорить... — он хмурится еще сильнее. — Одному моему родственнику пару месяцев назад подфартило, и он выведал небольшой секрет о старом Фароде. По слухам, берлога Фарода захоронена где-то прямо *под* площадью Старьевщиков. Чтобы попасть туда, нужно прыгнуть в портал, который открывается, когда ты держишь в руке какой-нибудь мусор».~
@11691 = ~«В паре кварталов отсюда... иди на запад от ворот Морга, пока не увидишь мусор и кучи тряпья повсюду. Только будь там осторожнее... Сборщики не всегда ждут, когда тело умрет само, понимаешь?»~
@11692 = ~«Наверное, смутил вид богатств и роскоши вокруг... — он фыркает. — А у нас только дырка в кармане. Да и звенелки были нужны. Я продал тело трухлявым, это было гораздо лучше, чем любая из здешних работ. Тогда я об этом не очень заботился...»~
@11693 = ~«Просто... — перед тем как продолжить, он вздыхает. — Полмесяца назад я увидел одного зомби... из тех, что работают на трухлявых. Он потряс меня до глубины души. Я понял, что сделал ошибку... Я не хотел становиться таким после смерти».~
@11694 = ~Лицо Ангиара наливается кровью. «Мне не нужны твои поучения! Черт, да как ты *смеешь* читать мне нотации прямо у меня дома? Я не просил тебя доставать эту чертову бумажку! Я тебе *ничего* не должен, так что вон! Вон отсюда! Не хочу тебя больше видеть!»~
@11695 = ~Не успеваешь ты раскрыть рот, как в затылке возникает ощущение покалывания... ты вдруг осознаешь, что Ангиар вряд ли спокойно воспримет твои поучения.~
@11696 = ~Ангиар нехотя кивает: «Ну да...»~
@11697 = ~Перед тобой Ангиар. Он выглядит гораздо лучше, чем в прошлый раз: на лице снова румянец, взгляд перестал быть затравленным. Завидев тебя, он медленно поворачивается и фыркает. «Пф... уж не сам ли ангел-хранитель всех умалишенных типа меня пожаловал... — он усмехается. — Что я могу сделать для тебя?»~
@11698 = ~Ангиар кивает: «Это самое малое, что я могу сделать. Скажу жене, чтобы она принесла одеяло...»~
@11699 = ~Ангиар хмуро качает головой. «Никогда не видел ничего подобного, рубака».~
@11700 = ~«Я уже однажды продал свою жизнь и больше не собираюсь это делать, — он качает головой. — Давай рассчитаемся прямо сейчас».~
@11701 = ~Оставить его в раздумьях.~
@11702 = ~«Я поговорил с твоей женой. Думаю, я смогу тебе помочь с...»~
@11703 = ~«Я поговорил с твоей женой. Думаю, я смогу тебе помочь с...»~
@11704 = ~«Давай, попробуй, раз силенки есть...»~
@11705 = ~«*Никто* не смеет так со мной разговаривать... Возьми свои слова обратно, или этот дом превратится в гробницу».~
@11706 = ~Показать ему контракт тленных.~
@11707 = ~«Успокойся. У меня есть несколько вопросов...»~
@11708 = ~«Тогда прощай». ~
@11709 = ~«Давай, попробуй, раз силенки есть...»~
@11710 = ~«*Никто* не смеет так со мной разговаривать... Возьми свои слова обратно, или этот дом превратится в гробницу».~
@11711 = ~Показать ему контракт тленных.~
@11712 = ~«Успокойся. У меня есть несколько вопросов...»~
@11713 = ~«Тогда прощай». ~
@11714 = ~«Давай, попробуй, раз силенки есть...»~
@11715 = ~«Тогда прощай». ~
@11716 = ~«Ну все. Считай, что на свою могилу ты уже заработал...»~
@11717 = ~Уйти не говоря ни слова.~
@11718 = ~«Я поговорил с твоей женой. Думаю, я смогу тебе помочь с...»~
@11719 = ~«Я поговорил с твоей женой. Думаю, я смогу тебе помочь с...»~
@11720 = ~«Давай, попробуй, раз силенки есть...»~
@11721 = ~«*Никто* не смеет так со мной разговаривать... Возьми свои слова обратно, или этот дом превратится в гробницу».~
@11722 = ~Показать ему контракт тленных.~
@11723 = ~«Успокойся. У меня есть несколько вопросов...»~
@11724 = ~«Тогда прощай». ~
@11725 = ~«Твоя жена сказала мне, где он. Она беспокоилась о тебе».~
@11726 = ~«Твоя жена сказала мне, где он. Она беспокоилась о тебе».~
@11727 = ~«Я взял его у одного тленного по имени Мортай. На нем было твое имя».~
@11728 = ~Порвать контракт.~
@11729 = ~«Ты *не тронешь* ее, для твоего же блага».~
@11730 = ~«Делай, что хочешь, но сначала давай займемся делом. Что ты дашь мне в обмен на контракт?»~
@11731 = ~«Она сказала мне, потому что беспокоилась о тебе... а твоя первая реакция — *наказать* ее за заботу о тебе?»~
@11732 = ~Порвать контракт.~
@11733 = ~«Почему бы тебе не *выдворить* меня, если силенок хватает...»~
@11734 = ~«Погоди-ка! Она рассказала мне это, потому что беспокоилась о тебе... и твоя первая реакция — *наказать* ее за заботу о тебе?»~
@11735 = ~«Она нарушила свое обещание, потому что любит тебя. Иногда законы и клятвы должны уступать более важным вещам».~
@11736 = ~«У тебя есть причины злиться. Она не должна была давать обещания, если не собиралась выполнять его. Терпеть не могу клятвоотступников, но теперь это дело прошлого».~
@11737 = ~«У тебя есть причины злиться. Она не должна была давать обещания, если не собиралась выполнять его. Терпеть не могу клятвоотступников, но теперь это дело прошлого».~
@11738 = ~«Ну да, она так поступила, и тебе придется смириться с этим. Здесь больше нечего сказать».~
@11739 = ~«Я надеялся, что ты заплатишь за него, раз уж ты выручил за него деньги».~
@11740 = ~Порвать контракт.~
@11741 = ~Порвать контракт.~
@11742 = ~«Я надеялся, что ты заплатишь за него, раз уж ты выручил за него деньги».~
@11743 = ~«Считай, что это бесплатно. И будь готов к тому, что пока я в Улье, изменится еще немало правил».~
@11744 = ~«В будущем мне может понадобиться некоторая помощь. Ты поможешь мне?»~
@11745 = ~«Ну, если ты ощущаешь необходимость отплатить мне, ты бы мог ответить на несколько вопросов...»~
@11746 = ~«Тогда подумай над тем, как ты можешь мне отплатить... А пока прощай».~
@11747 = ~«Ну вообще-то, ты можешь помочь мне... У меня есть несколько вопросов...»~
@11748 = ~«Просто не делай так больше... В следующий раз меня рядом может не быть».~
@11749 = ~«Это многое для меня значит. Береги себя, Ангиар».~
@11750 = ~Порвать контракт.~
@11751 = ~«Хочешь убить меня? Давай, попробуй...»~
@11752 = ~«Хорошо. Я оставлю этот контракт себе... ведь когда ты умрешь, он будет еще в силе. Прощай, Ангиар».~
@11753 = ~«Могу я спросить, почему ты подписал контракт с тленными?»~
@11754 = ~«Я разыскиваю человека по имени Фарод. Ты не знаешь, где его можно найти?»~
@11755 = ~«Я потерял свой дневник. Тебе ничего такого не попадалось?»~
@11756 = ~«Ты не против, если я передохну у тебя?»~
@11757 = ~«Неважно. Прощай».~
@11758 = ~«Что ты можешь рассказать о нем?»~
@11759 = ~«У меня есть другие вопросы...»~
@11760 = ~«Неважно. Прощай».~
@11761 = ~«Сборщиков?»~
@11762 = ~«Ты знаешь, где его можно найти?»~
@11763 = ~«Ты знаешь, где его можно найти?»~
@11764 = ~«У меня есть другие вопросы...»~
@11765 = ~«Понятно. Спасибо за информацию. Прощай».~
@11766 = ~«А зачем они это делают?»~
@11767 = ~«Так значит, Фарод — один из этих сборщиков? Ты знаешь, где его найти?»~
@11768 = ~«Где я могу найти этого Фарода?»~
@11769 = ~«У меня есть другие вопросы...»~
@11770 = ~«Понятно. Прощай».~
@11771 = ~«Так значит, Фарод — один из этих сборщиков? Ты знаешь, где его найти?»~
@11772 = ~«Где я могу найти этого Фарода?»~
@11773 = ~«У меня есть другие вопросы...»~
@11774 = ~«Понятно. Прощай».~
@11775 = ~«Где находится площадь Старьевщиков?»~
@11776 = ~«У меня есть другие вопросы...»~
@11777 = ~«Понятно. Прощай».~
@11778 = ~«У меня есть другие вопросы...»~
@11779 = ~ «Спасибо за информацию. Прощай».~
@11780 = ~«И почему ты передумал?»~
@11781 = ~«Понятно. У меня есть другие вопросы...» ~
@11782 = ~«Мне было просто любопытно. Прощай, Ангиар».~
@11783 = ~«Тогда тебе не стоило подписывать контракт».~
@11784 = ~«Тогда тебе не стоило подписывать контракт».~
@11785 = ~«Мы все делаем ошибки».~
@11786 = ~«Понятно. У меня есть другие вопросы...» ~
@11787 = ~«Мне было просто любопытно. Прощай, Ангиар».~
@11788 = ~«Почему бы тебе не *выдворить* меня, если силенок хватает...»~
@11789 = ~«Тогда прощай». ~
@11790 = ~«Тогда тебе не стоило подписывать контракт, Ангиар».~
@11791 = ~«Мы все делаем ошибки».~
@11792 = ~«У меня есть другие вопросы...»~
@11793 = ~«Мне было просто любопытно. Прощай, Ангиар».~
@11794 = ~«У меня есть другие вопросы...»~
@11795 = ~«Мне было просто любопытно. Прощай, Ангиар».~
@11796 = ~«У меня есть несколько вопросов...» ~
@11797 = ~«Просто хотел узнать, как у тебя дела, Ангиар. Прощай».~
@11798 = ~«Спасибо...»~
@11799 = ~«Нет, не сейчас. У меня есть несколько вопросов...»~
@11800 = ~«Нет, не сейчас. Я приду, когда мне нужно будет отдохнуть. Прощай».~
@11801 = ~«Возможно, ты сможешь ответить на другие вопросы...»~
@11802 = ~«Все равно спасибо. Прощай».~
@11803 = ~«Ну, если ты ощущаешь необходимость отплатить мне, ты бы мог ответить на несколько вопросов...»~
@11804 = ~«Я мог бы воспользоваться этим местом для отдыха».~
@11805 = ~«Не за что рассчитываться, Ангиар — считай, что это бесплатно. Прощай».~
@11806 = ~«Тебе... тебе лучше убраться отсюда, пока я не позвала своего мужа. Уж он-то не будет столь любезным, показывая выход из нашего дома».~
@11807 = ~Она с тревогой смотрит на своего мужа. «У меня... у меня нет времени, странник. Не беспокой меня подобными вещами».~
@11808 = ~Она бледнеет, ее глаза полны страха. Но перед тем, как ты смог задать ей вопрос, она глубоко вздыхает и начинает громко кричать!~
@11809 = ~«С мной? — она удивлена. — Ох... да, да, все хорошо». Она понижает голос. «Тебе лучше уйти. Мой муж в последнее время сам не свой... тебе лучше не провоцировать его своим присутствием».~
@11810 = ~«В последнее время он сам не в себе, наверное, простудился...» Она слабо и неуверенно пожимает плечами.~
@11811 = ~«Мне кажется... Мне кажется, что он сделал что-то, о чем сейчас жалеет, — тревога на ее лице сменяется унынием. — Мне кажется, он подписал Контракт Смерти. Я даже не могу представить, что заставило его пойти на такой глупый поступок!»~
@11812 = ~Она останавливает тебя. «Пожалуйста, не говори никому того, что я тебе сказала, особенно моему мужу... — она очень напугана. — Обещай мне».~
@11813 = ~Похоже, это ее успокоило... но только слегка. «Тогда прощай».~
@11814 = ~В ее лице стало еще больше отчаяния. «Я... я не должна была тебе *ничего* говорить... — она начинает плакать. — Я такая же дура, как и он!»~
@11815 = ~«У моего мужа страшный характер... и он заставил меня пообещать ничего не говорит о том, что с ним произошло... — она снова смотрит на тебя. — Ты *должен* молчать об этом».~
@11816 = ~Она вздыхает. «Все же, я...»~
@11817 = ~«У трухлявых... у тленных... эти контракты дают им право на тело умершего».~
@11818 = ~«Они поднимают его своим темным колдунством, превращая его в ходячего мертвеца, и заставляют работать на них до тех пор, — она безнадежно смотрит на своего мужа, — пока он целиком не сгниет».~
@11819 = ~«Он решил принести в дом больше звенелок, чем обычно. Он такой гордый... но я думаю, что этим он только навредил себе».~
@11820 = ~«Самое ужасное в этом контракте — его сущность изменилась... он стал угрюмым и неразговорчивым, теперь он не может найти себе хорошую работу. Словно тень Леди над ним нависла...» Она вздыхает.~
@11821 = ~Она с тревогой смотрит на своего мужа. «У меня... у меня нет времени, странник. Мне нужно заняться уборкой...»~
@11822 = ~Удивленно взглянув на тебя, она вздыхает. «Я *пыталась*! Я разговаривала с тем тленным, который подписал контракт, он такой холодный и неприступный, как все тленные! Он даже прочел мне нотацию, что я не имею права помогать ему! — ее губы превращаются тонкую линию, напоминая лицо тленного. — Он такой бессердечный».~
@11823 = ~«Не могу отказаться от такого жеста, — ее благодарность тут же сменяется озабоченностью. — Только не говори ему ничего, прошу тебя. У моего мужа грозный нрав, если он узнает...» Она содрогается.~
@11824 = ~«Трухлявые называют его Сводящим-в-могилу... Я не знаю его имени. У него есть столик в баре тленных в Улье... 'Собиратели пыли' — вроде так он называется. Скорее всего, ты найдешь его там: он будет как всегда пытаться заключить с кем-то сделку».~
@11825 = ~«Выйди на улицу дойди до мемориального камня, а потом иди на юго-запад... Попадешь прямо на него. У входа будет стоять один из этих, — она кривится от отвращения, — ходячих трупов».~
@11826 = ~«Спасибо тебе, незнакомец... Я ценю твою помощь».~
@11827 = ~«Тогда молчи, пока не будет о чем говорить».~
@11828 = ~«Умер?! — она оцепенела от ужаса. — Но контракт... теперь не получится...»~
@11829 = ~Она умолкает. Взглянув на своего мужа, она поворачивается к тебе. «Теперь уже ничего не поделаешь, — ее голос лишен всяческих эмоций. — Пожалуйста, уходи».~
@11830 = ~Жена Ангиара сильно напугана. «Тебе... тебе лучше убраться отсюда, пока я не позвала своего мужа. Уж он-то не будет столь любезным, показывая выход из нашего дома».~
@11831 = ~Жена Ангиара с надеждой смотрит на тебя. «У тебя получилось?..»~
@11832 = ~Жена Ангиара приветливо тебе улыбается: «Здравствуй, уважаемый сэр. Чем могу тебе помочь?»~
@11833 = ~Она облеченно вздыхает, ее глаза наполняются слезами. «Ох, мои силы... ты, наверное, переодетый дэва, раз сделал это ради тех, кого почти не знаешь...»~
@11834 = ~«Нет... нет, когда покажешь мужу контракт, скажи, что получил контракт для него, только не говори как... Я буду тебе очень признательна».~
@11835 = ~Она с опаской смотрит на тебя. «У меня есть деньги, немного монет... тебя это устроит?»~
@11836 = ~Из складок своего платья она достает пригоршню медных монет. Грустно на них взглянув, она протягивает их тебе: «Это гораздо меньше, чем стоит душа моего мужа».~
@11837 = ~«Нет... нет, когда покажешь мужу контракт, скажи, что получил контракт для него, только не говори как... Я буду тебе очень признательна».~
@11838 = ~«У меня... у меня больше ничего нет, — она напугана. — Правда, сэр, больше ничего. Иначе бы мой муж не подписывал бы тогда Контракт Смерти...»~
@11839 = ~Она бледнеет, ее глаза полны страха. Перед тем, как ты смог что-то сделать, она глубоко вздыхает и начинает громко кричать!~
@11840 = ~Жена Ангиара поворачивается к тебе, бросив обеспокоенный взгляд на своего мужа. «Спасибо, что достал этот контракт, но теперь ты разозлил моего мужа, — она со страхом смотрит на Ангиара. — Тебе лучше уйти».~
@11841 = ~Жена Ангиара с надеждой смотрит на тебя. «Ты достал его?..»~
@11842 = ~«Трухлявые называют его Сводящим-в-могилу... Я не знаю его имени. У него есть столик в баре тленных в Улье... 'Собиратели пыли' — вроде так он называется. Скорее всего, ты найдешь его там: он будет как всегда пытаться заключить с кем-то сделку».~
@11843 = ~«Выйди на улицу дойди до мемориального камня, а потом иди на юго-запад... Попадешь прямо на него. У входа будет стоять один из этих, — она кривится от отвращения, — ходячих трупов».~
@11844 = ~Оставить женщину в покое.~
@11845 = ~«Если бы ты собиралась позвать его, то уже бы давно это сделала бы. У меня есть несколько вопросов к тебе...»~
@11846 = ~«Только попробуй позвать своего мужа, и вы оба трупы. А теперь ответь мои вопросы».~
@11847 = ~«Успокойся. Я просто хочу задать несколько вопросов...»~
@11848 = ~«Прощай».~
@11849 = ~«Прошу прощения... с тобой все в порядке?»~
@11850 = ~«Ну так отложи свои дела. У меня есть вопросы...»~
@11851 = ~«Тогда прощай. Прошу прощения за беспокойство».~
@11852 = ~«Проклятье...»~
@11853 = ~«Я говорил с ним... Кажется, у него проблемы? Что с ним не так?»~
@11854 = ~«Что с ним не так?»~
@11855 = ~«Тогда лучше не провоцировать его, ни мне, ни тебе. У меня есть вопросы...»~
@11856 = ~«Тогда прощай. Прошу прощения за беспокойство».~
@11857 = ~«Что на самом деле с ним не так?»~
@11858 = ~«Если ты мне скажешь, что с ним не так, то, может быть, я смогу помочь».~
@11859 = ~«Тогда прощай. Прошу прощения за беспокойство».~
@11860 = ~«Контракт Смерти?»~
@11861 = ~«Понятно... Похоже, ты взваливаешь на себя чужие проблемы. Прощай».~
@11862 = ~«Зачем?»~
@11863 = ~Ложь: «Обещаю, что я не скажу никому».~
@11864 = ~Клятва: «Обещаю, что я не скажу никому».~
@11865 = ~«Я не могу давать никаких обещаний. Прощай».~
@11866 = ~«Прощай».~
@11867 = ~«Почему это должно быть в тайне?»~
@11868 = ~«Ты права. Тебе не следовало ничего говорить мне. Прощай».~
@11869 = ~Уйти.~
@11870 = ~«Ты не должна была говорить мне... Обещания надо выполнять, иначе не будет никакого доверия между людьми. Тебе не нужно было давать подобного обещания».~
@11871 = ~«Обещание, данное под угрозами, не может быть обещанием. Тебе не нужно бояться нарушить его».~
@11872 = ~«Обещания созданы для того, чтобы их нарушать. Они — ничто по сравнению с благополучием человека».~
@11873 = ~Ложь: «Обещаю, что я не скажу никому».~
@11874 = ~Клятва: «Обещаю, что я не скажу никому».~
@11875 = ~«Я не могу давать никаких обещаний. Прощай».~
@11876 = ~«Послушай, возможно, я смогу с этим помочь... где тот Контракт Смерти, о котором ты говорила?»~
@11877 = ~Ложь: «Неважно. Обещаю, что я не скажу никому».~
@11878 = ~Клятва: «Неважно. Обещаю, что я не скажу никому».~
@11879 = ~«Нам больше не о чем говорить. Прощай».~
@11880 = ~«Что тленные делают с телом после смерти?»~
@11881 = ~«Понятно... Прощай».~
@11882 = ~«Зачем твой муж подписался под всем этим?»~
@11883 = ~«Тело твоему мужу после смерти не понадобится. В чем проблема?»~
@11884 = ~«Похоже, ты взваливаешь на себя чужие проблемы. Прощай».~
@11885 = ~«Как неудачно сложилось. У меня есть другие вопросы к тебе...»~
@11886 = ~«А можно отменить контракт?»~
@11887 = ~«Тело твоему мужу после смерти не понадобится. В чем проблема?»~
@11888 = ~«Похоже, ты взваливаешь на себя чужие проблемы. Прощай».~
@11889 = ~«Как неудачно сложилось. У меня есть другие вопросы к тебе...»~
@11890 = ~«А можно отменить контракт?»~
@11891 = ~«Зачем твой муж подписался под всем этим?»~
@11892 = ~«Похоже, ты взваливаешь на себя чужие проблемы. Прощай».~
@11893 = ~«Ну так отложи свои дела. У меня есть вопросы...»~
@11894 = ~«Тогда прощай. Прошу прощения за беспокойство».~
@11895 = ~«Я посмотрю, что можно сделать. Кто тот тленный, с которым твой муж подписал контракт?»~
@11896 = ~«Как неудачно сложилось. У меня есть другие вопросы к тебе...»~
@11897 = ~«Похоже, ты взваливаешь на себя чужие проблемы. Прощай».~
@11898 = ~Ложь: «Обещаю, что твой муж ничего не узнает».~
@11899 = ~Клятва: «Обещаю, что твой муж ничего не узнает».~
@11900 = ~«Я не могу ничего обещать. Посмотрим, как получится».~
@11901 = ~~
@11902 = ~«А, так это Мортай? Он умер».~
@11903 = ~«Тогда нужно его разыскать. Где находится Бар собирателей пыли?»~
@11904 = ~«Контракт твоего мужа у меня».~
@11905 = ~«Хорошо. Посмотрим, что я смогу сделать».~
@11906 = ~«Нет проблем. Пойду, попробую отменить контракт твоего мужа».~
@11907 = ~«Хорошо. Пойду, попробую отменить контракт твоего мужа».~
@11908 = ~«Да, это проблема».~
@11909 = ~«Не бойся. Контракт у меня».~
@11910 = ~«Сначала у меня есть несколько вопросов...»~
@11911 = ~«Прощай».~
@11912 = ~«Что за Контракт Смерти, который подписал твой муж?»~
@11913 = ~«Если бы ты собиралась позвать его, то уже бы давно это сделала бы. У меня есть несколько вопросов к тебе».~
@11914 = ~«Только попробуй позвать своего мужа, и вы оба трупы. А теперь ответь мои вопросы».~
@11915 = ~«Успокойся. Я просто хочу задать несколько вопросов...»~
@11916 = ~«Да, я смог забрать контракт у Мортая. Вот он».~
@11917 = ~«Прощай».~
@11918 = ~«Пока нет. Кто был тот человек, с которым твой муж подписал контракт?»~
@11919 = ~«Я все еще ищу его. Прощай».~
@11920 = ~«Я бы хотел отдохнуть здесь».~
@11921 = ~«У меня почти не осталось припасов... ты мне не поможешь?»~
@11922 = ~«Просто хотел узнать, как у вас дела. Прощай».~
@11923 = ~Отдать ей контракт.~
@11924 = ~«Я сделал это не за просто так. Мне нужно что-нибудь в обмен».~
@11925 = ~«Хорошо. Я покажу ему контракт».~
@11926 = ~«Я сделал это не за просто так. Мне нужно что-нибудь в обмен».~
@11927 = ~«Да».~
@11928 = ~«Нескольких монет недостаточно. Что еще у тебя есть?»~
@11929 = ~«Для начала неплохо. А еще что у тебя есть?»~
@11930 = ~«Отлично. Вот контракт».~
@11931 = ~«Хорошо. Я покажу ему контракт».~
@11932 = ~«Не *лги* мне, женщина. Что еще у тебя есть?»~
@11933 = ~«Неважно. Вот контракт».~
@11934 = ~«Проклятье...»~
@11935 = ~«Хорошо. Прошу прощения за беспокойство».~
@11936 = ~«Пока нет. Я вернусь, когда он у меня будет».~
@11937 = ~«А, так это Мортай? Он умер».~
@11938 = ~«Тогда нужно его разыскать. Где находится Бар собирателей пыли?»~
@11939 = ~«Контракт твоего мужа у меня».~
@11940 = ~«Хорошо. Посмотрим, что я смогу сделать».~
@11941 = ~~
@11942 = ~~
@11943 = ~~
@11944 = ~~
@11945 = ~~
@11946 = ~Морт подлетает. «О чем речь, шеф?»~
@11947 = ~Морт глядит на твою ладонь. «Ух-х-х». Кажется, его покоробило. «Вот уж мелкие уродцы, а?»~
@11948 = ~«Задвинься, — Морт вздрагивает. — А ты бы хотел, чтобы они оказались в *тебе*?»~
@11949 = ~«Лучше этим мелким засранцам не приближаться ко мне, иначе я... — Морт умолкает. — Знаешь, я понятия не имею, чем угрожать зубам».~
@11950 = ~Схватка длится не долго. Ты ловишь Морта в захват — единственное движение, которое ты можешь сделать — и, пока он, кусаясь, пытается освободиться, зубы спрыгивают с твоей руки и налетают на его челюсть. Морт воет, а зубы Ингресс быстро выкорчевывают его старые зубы и прыгают в открывшиеся полости.~
@11951 = ~Морт продолжает выть. Зубы начинают обустраиваться и пускать корни с жутким хрустом.~
@11952 = ~Кажется, Морт тебя не слышит... Он продолжает выть, затем вдруг начинает клацать зубами. Ему удается трижды сильно клацнуть, прежде чем верхние зубы сцепляются с нижними и не дают ему открыть рот.~
@11953 = ~Морт что-то тебе бормочет, его глаза широко раскрыты.~
@11954 = ~Внезапно зубы расцепляются, и Морт делает глубокий вздох. «Я *убью* тебя за это, — говорит он. — Это было нечестно».~
@11955 = ~Морт пробует двигать челюстью. «Странно. Но неплохо, — внезапно зубы превращаются в клыки. — О-о-о! Они меняются!» Они превращаются в нормальные зубы, потом в клики, потом обратно... «Думаю, они мне понравятся».~
@11956 = ~«О, я все еще зол на тебя», — отвечает Морт. Он ухмыляется, его зубы снова превращаются в клыки. «Погоди мне».~
@11957 = ~«Что там?» Морт подлетает ближе и смотрит тебе на ладонь. «Эй... Кажется, они что-то замышляют, так ведь?»~
@11958 = ~То, что происходит дальше, трудно описать... и больно смотреть. Не успеваешь ты закрыть ладонь, как зубы спрыгивают с твоей руки и налетают на его челюсть. Морт воет, а зубы Ингресс быстро выкорчевывают его старые зубы и прыгают в открывшиеся полости.~
@11959 = ~Внезапно зубы расцепляются, и Морт делает глубокий вздох. «Я *убью* тебя за это! Ты все спланировал! Я знаю!»~
@11960 = ~~
@11961 = ~~
@11962 = ~~
@11963 = ~~
@11964 = ~~
@11965 = ~~
@11966 = ~~
@11967 = ~~
@11968 = ~~
@11969 = ~~
@11970 = ~~
@11971 = ~~
@11972 = ~~
@11973 = ~~
@11974 = ~«Видишь эти зубы?»~
@11975 = ~«Ничего, неважно».~
@11976 = ~«Ладно тебе, Морт, кажется, ты им нравишься. Посмотри, как они на тебя смотрят».~
@11977 = ~Схватить Морта, сунуть зубы ему в рот.~
@11978 = ~«Тогда неважно».~
@11979 = ~Осмотреть зубы.~
@11980 = ~Схватить Морта, сунуть зубы ему в рот.~
@11981 = ~«Тогда неважно».~
@11982 = ~«Ну вот, Морт. Ведь было не так плохо?»~
@11983 = ~«Морт? С тобой все в порядке?»~
@11984 = ~«Ух ты».~
@11985 = ~«Значит... они тебе нравятся?»~
@11986 = ~«Морт, ты в порядке?»~
@11987 = ~«Как они тебе?»~
@11988 = ~«Извини, Морт. Я не желал тебе зла».~
@11989 = ~«Вот видишь? Разве я не был прав?»~
@11990 = ~«Э... месть еще никому не помогала, Морт... Э, пошли».~
@11991 = ~«Поблагодаришь меня позже. Вот увидишь».~
@11992 = ~«Точно замышляют, так...»~
@11993 = ~«Морт!»~
@11994 = ~«Слушай, я этого не хотел... Я даже предупредил тебя. Э... как они тебе?»~
@11995 = ~КИНЖАЛ АДАНА
Урон: 2-5 колющий
Магический урон: +1
THAC0: +1
Скорость: 1
Вес: 0
Специализация: клинковые
Не используется жрецами

Это подарок, полученный тобой на прощание от Адана в баре «Тлеющий труп». Это непримечательный металлический кинжал с позолоченной рукоятью. Трудно ощутить его баланс — он почти невесом. Клинок кинжала сделан из какого-то странного металла, который переливается серебром, бронзой и золотом, когда ты его рассматриваешь.~
@11996 = ~Это «негативный символ», плоский черный диск, с виду совершенно бесплотный. Если перевернуть его, оказывается, что у него нет третьего измерения — этот предмет вообще не имеет толщины. Он защищает тебя и твою группу от урона существ, состоящих из негативной сущности, но не делает тебя неуязвимым к нему.~
@11997 = ~ВИТОЕ КОЛЬЦО
Особенность: +1 к Классу Брони
Вес: 0

Это кольцо выглядит как три кольца, переплетенные одно вокруг другого. От одного только взгляда на него у тебя голова идет кругом.~
@11998 = ~МЕШОЧЕК С ЗУБАМИ
Вес: 2

В это небольшом кожаном мешочке лежат разные зубы, начиная с человеческих коренных зубов и заканчивая демоническими клыками. Если их потрясти, то они гремят как маракасы.~
@11999 = ~КРЫСИНЫЙ АМУЛЕТ
Вызывает: «Замешательство»
Особенности:
   +2 к Классу Брони
   +1 к Силе
   +1 к Телосложению
   -2 к Мудрости
Вес: 0
Используется только хаотами

Этот странный амулет из переплетенных крысиных хвостов был сделан Лающим Дикарем, и в него впиталось немного его хаотичного духа. Надетый, он помогает игнорировать физические атаки и дает безумный прилив сил и энергии (однако в той же мере снижает мудрость носящего амулет). Если взять его в руку, он также может быть использован для приведения в замешательство окружающих на ограниченное время. Этот предмет могут использовать только хаоситеки.~
@12000 = ~КОЛЬЦО АДАНА
Вес: 0

Это подарок, полученный тобой на прощанье от Адана в баре «Тлеющий труп». Непримечательное металлическое кольцо, с виду очень тяжелое и массивное, тем не менее оно почти невесомо. Когда ты его рассматриваешь, кольцо переливается серебром, бронзой и золотом.~
@12001 = ~ФАЛЬШИВЫЙ КОНТРАКТ СМЕРТИ
Вес: 0

Этот поддельный «Контракт Смерти» похож на обычный Контракт Смерти тленных, однако мелкий судорожный почерк в нем скрывает тот факт, что подписавшийся в нем на самом деле вовсе не передавал тленным право на свое тело после смерти... по существу, в нем написано, что любой подписавший его тленный платит подписавшему контракт только лишь за его подпись.~
@12002 = ~КОНТРАКТ СМЕРТИ МЕДНОГЛАЗОГО
Вес: 0

Ты получил этот незаполненный контракт у Медноглазого; от него исходит слабый металлический запах. Из того, что ты разобрал в тексте, написанном мелким сжатым почерком, следует, что данный документ является контрактом между двумя сторонами: фракцией Тленных и пока еще неуказанной личностью. В обмен на тридцать медяков подписавший этот контракт передает права на свой труп тленным, предположительно, для использования его в качестве рабочего Морга.~
@12003 = ~«У меня есть кое-какие вопросы...» ~
@12004 = ~«Я ошибся... Я тебя перепутал кое с кем. Прощай».~
@12005 = ~Медноглазый хранит молчание.~
@12006 = ~«Это твой последний шанс. Верни мне контракт или ты пожалеешь об этом».~
@12007 = ~«Э-э... неважно. Прощай».~
@12008 = ~«Я передумал. Прощай».~
@12009 = ~«Прощай».~
@12010 = ~Тебя вновь поражает иллюзорная сущность этого человека. И вновь ты не можешь отвести взгляд от его бледно-голубых глаз. «Ну как, продвинулся в своих поисках?»~
@12011 = ~«Пока нет. У меня есть вопросы».~
@12012 = ~«Еще нет. Прощай».~
@12013 = ~Перед тобой расплывчатый образ мужчины с мягким отстраненным взглядом. Он облачен в кожаную одежду, с которой свисают различные инструменты и приспособления: веревки, крючья, трутницы, пустые пузырьки. Он выглядит наполовину отсутствующим — в буквальном смысле. Есть в нем нечто иллюзорное, как будто часть его сущности вытянули из него. Он фокусирует на тебе свой взгляд, неожиданно четкий и решительный. «Приветствую тебя, о искатель».~
@12014 = ~«Приветствую».~
@12015 = ~«Прощай».~
@12016 = ~Тебя вновь поражает иллюзорная сущность этого человека. И вновь ты не можешь отвести взгляд от его бледно-голубых глаз. «Ну как, продвинулся в своих поисках?»~
@12017 = ~«Пока нет. У меня есть вопросы».~
@12018 = ~«Еще нет. Прощай».~
@12019 = ~Он осторожно ставит свою кружку на стол и полностью сосредотачивается на тебе. «Я бывал в самых дальних уголках мультивселенной и вернулся, чтобы рассказывать истории. Я ходил по телам мертвых богов и переплетенным лунным лучам Астрала во главе тысячи кричащих рыцарей гитьянки. Я достигал граней реальности и наблюдал, как моя сущность разбивается на осколки. Что я могу сделать для тебя?»~
@12020 = ~«У меня есть вопросы...»~
@12021 = ~«Ничего. Прощай».~
@12022 = ~«Возможно, у меня найдутся для тебя ответы. Спрашивай, и я тебе отвечу».~
@12023 = ~«Я встретил женщину по имени Ингресс с *очень* плохими зубами. Она сказала, что пришла из другого мира через портал, который открылся возле двух скрещенных деревьев от напевания какой-то мелодии. Ты можешь помочь ей попасть домой?»~
@12024 = ~«Кто ты?»~
@12025 = ~«Чем ты занимаешься?»~
@12026 = ~«Что это за место?»~
@12027 = ~«Я ищу дневник, который потерял».~
@12028 = ~«Ты знаешь сборщика по имени Фарод?»~
@12029 = ~«Забудь об этом. Прощай».~
@12030 = ~Немного поразмыслив, он отвечает: «Мне известен портал, о котором ты говоришь, хотя я не проходил через него вот уже тридцать лет. Я доставлю ее домой, искатель. Скажи ей, чтобы ждала моего прибытия, потом приходи ко мне. Посмотрим, что из этого получится».~
@12031 = ~«Спасибо. У меня есть еще несколько вопросов...»~
@12032 = ~«Спасибо. Прощай».~
@12033 = ~«Я — Кандриан Низкородный, путешественник, мечтатель, рассказчик и так далее».~
@12034 = ~«Так ты путешественник? Расскажи мне о Планах».~
@12035 = ~«У меня есть другие вопросы...»~
@12036 = ~«Спасибо. Прощай».~
@12037 = ~«Я устал, искатель, я так устал... Только что вернулся из небытия. Я отвечу на твои вопросы насколько могу, но не обещаю, что ты удовлетворишься моими ответами. О чем ты хочешь узнать? О Внешних планах, Первичном материальном или же о Внутренних планах?»~
@12038 = ~«А как между ними разница?»~
@12039 = ~«Расскажи мне о Внешних планах».~
@12040 = ~«Расскажи мне о Внутренних планах».~
@12041 = ~«Расскажи мне о Первичном материальном».~
@12042 = ~«Только что из небытия? Что ты имеешь в виду?»~
@12043 = ~«Ни о чем. Но у меня есть другие вопросы...»~
@12044 = ~«Ни о чем. Прощай».~
@12045 = ~«Ты хочешь узнать о планах? Спрашивай, я отвечу, насколько смогу. Ты хотел бы послушать про Внешние планы, про Первичный материальный или про Внутренние планы?»~
@12046 = ~«А как между ними разница?»~
@12047 = ~«Расскажи мне о Внешних планах».~
@12048 = ~«Расскажи мне о Внутренних планах».~
@12049 = ~«Расскажи мне о Первичном материальном».~
@12050 = ~«А что ты имел в виду, когда что-то говорил про 'небытие'?»~
@12051 = ~«Ни о чем. Но у меня есть другие вопросы...»~
@12052 = ~«Ни о чем. Прощай».~
@12053 = ~«Разница в самой сущности, искатель. Внутренние планы — это материя, субстанция, истинное вещество. Они — строительные материалы мультивселенной, поскольку именно из них берет начало вера в стихии. Внутренние планы проходят сквозь Эфирный план — некоторые называют его планом возможностей, планом, который превращает стихии в миры смертных. Проходя через Эфирный план, они достигают Первичного материального, в котором существует все многообразие смертных, монстров, мифов и машин. Там рождаются убеждения, там рождаются души — основа Внешних планов. Когда смертный умирает, он попадает на Астральный план, не-место, состоящее из мыслей и самой ментальной энергии. Это место для всего и ничего одновременно — чистейший парадокс. Этот план отсеивает души перед Великим кольцом. Ты успеваешь за мыслью?»~
@12054 = ~«Да. Продолжай».~
@12055 = ~«Не очень».~
@12056 = ~«Отвлечемся от этой темы. У меня есть другие вопросы...»~
@12057 = ~«Вернемся к этому в другой раз. Прощай».~
@12058 = ~«Так... Внешние планы... С чего бы начать? Тебе известно о главных правилах планов, на которых зиждятся все остальные? Ты знаешь структуру Внешних планов? Тебе известно о Внешнем кольце и его представлении в наших душах? Все это связано между собой, так что лучше начать с самого начала».~
@12059 = ~«Расскажи мне о главных правилах».~
@12060 = ~«Расскажи мне о структуре планов».~
@12061 = ~«Расскажи мне о Великом кольце и его представлениях».~
@12062 = ~«Расскажи мне об отдельных планах».~
@12063 = ~«Лучше расскажи мне о Внутренних Планах».~
@12064 = ~«Расскажи мне лучше о Первичном материальном плане».~
@12065 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@12066 = ~«Возможно, нам стоит поговорить об этом в другой раз. Прощай».~
@12067 = ~«Отдай мне все, что у тебя есть, ворюга, и я тебя отпущу».~
@12068 = ~«Стражу? Ага, давай, зови. Уверен, что здесь их — *как грязи*».~
@12069 = ~Атаковать его.~
@12070 = ~Позволить ему уйти.~
@12071 = ~«Проклятье...»~
@12072 = ~«Проклятье...»~
@12073 = ~«Меня предупредили, что кто-то вроде тебя под видом тленного обчищает карманы».~
@12074 = ~«Тебя выдало совершенное незнание основ философии тленных. Тебе следовало бы побольше изучить ее перед тем, как разводить кого-то умнее тебя. А теперь у меня есть к тебе вопросы...»~
@12075 = ~«Тебе бы поработать над своими воровскими навыками. А теперь у меня есть к тебе несколько вопросов...»~
@12076 = ~«Попробуй сам догадаться. А теперь у меня есть к тебе несколько вопросов...»~
@12077 = ~«Ты не доживешь до того, чтобы выяснить это. Готовься к смерти».~
@12078 = ~«Что ты делаешь в этом наряде тленного?»~
@12079 = ~«Я ищу кое-кого по имени Фарод. Знаешь такого?»~
@12080 = ~«Я ищу дневник».~
@12081 = ~Правда: «Отдай мне все, что у тебя есть, или я убью тебя».~
@12082 = ~Блеф: «Отдай мне все, что у тебя есть, или я убью тебя».~
@12083 = ~Правда: «А теперь... отдай мне *все*, что у тебя есть, или я убью тебя».~
@12084 = ~Блеф: «А теперь... отдай мне *все*, что у тебя есть, или я убью тебя».~
@12085 = ~«Мой вопрос: сколько секунд мне понадобится, чтобы убить тебя... приготовься умереть».~
@12086 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12087 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12088 = ~«Интересно. У меня есть другие вопросы...»~
@12089 = ~«Это все, что я хотел узнать. Приготовься к смерти».~
@12090 = ~«Понятно. Значит, так, Осыпанный-Пеплом: больше здесь не появляйся. Если увижу — прирежу. А теперь проваливай».~
@12091 = ~«Ага, очень умно. Значит так, больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12092 = ~Блеф: «Теперь ты уже не косишь под дурачка — ты и *есть* дурак. Давай все, что у тебя есть, или сборщики найдут новое тело на улице».~
@12093 = ~Правда: «Теперь ты уже не косишь под дурачка — ты и *есть* дурак. Давай все, что у тебя есть, или сборщики найдут новое тело на улице».~
@12094 = ~«Неправильный ответ. Готовься к смерти».~
@12095 = ~«Что, правда? Тогда давай-ка тебя немного потрясем и посмотрим, так ли это».~
@12096 = ~«И это все? Лучше тебе иметь что-нибудь получше для меня, Осыпанный-Пеплом, иначе вмиг подружишься со своей смертью».~
@12097 = ~«Вот и хорошо. А теперь у меня есть к тебе вопросы...»~
@12098 = ~«Это все, что я хотел. Готовься к смерти».~
@12099 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12100 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12101 = ~«Вот и хорошо. А теперь у меня есть к тебе вопросы...»~
@12102 = ~«Что, правда? Тогда давай-ка тебя немного потрясем и посмотрим, так ли это».~
@12103 = ~«Неправильный ответ. Готовься к смерти».~
@12104 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12105 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12106 = ~«Ну хорошо...»~
@12107 = ~«Ну хорошо, у меня есть другие вопросы...»~
@12108 = ~«Это все, что я хотел узнать. Приготовься к смерти».~
@12109 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12110 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12111 = ~«Кто он такой?»~
@12112 = ~«Неважно. У меня есть другие вопросы...»~
@12113 = ~«Забудь. Готовься к смерти».~
@12114 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12115 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12116 = ~«Нет».~
@12117 = ~Клятва: «Даю слово, что я отпущу тебя... если ты ответишь на мой вопрос».~
@12118 = ~Правда: «Да».~
@12119 = ~Ложь: «Да».~
@12120 = ~Правда: «Я оставлю тебя *в живых*, если ты скажешь».~
@12121 = ~Блеф: «Я оставлю тебя *в живых*, если ты скажешь».~
@12122 = ~Клятва: «Хорошо. Даю слово, что я отпущу тебя... если ты ответишь на мой вопрос».~
@12123 = ~Правда: «Хорошо, я отпущу тебя».~
@12124 = ~Ложь: «Хорошо, я отпущу тебя».~
@12125 = ~Правда: «Я оставлю тебя *в живых*, если ты скажешь».~
@12126 = ~Блеф: «Я оставлю тебя *в живых*, если ты скажешь».~
@12127 = ~«Неправильный ответ. Готовься к смерти».~
@12128 = ~«Где я могу найти его?»~
@12129 = ~«Нет. У меня есть другие вопросы к тебе...»~
@12130 = ~«Нет. У меня есть другие вопросы к тебе...»~
@12131 = ~«Это все, что я хотел узнать. Готовься к смерти».~
@12132 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12133 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12134 = ~«А *ты* говорил, что ты — тленный. А теперь насчет моих вопросов...»~
@12135 = ~«Да, я много чего говорил, и теперь мне надоело с тобой разговаривать. Готовься к смерти».~
@12136 = ~«Проваливай отсюда. Еще раз увижу — прирежу».~
@12137 = ~«А теперь уходи. И больше даже и *не вздумай* проворачивать свои аферы с кем-нибудь в Сигиле. Все понятно?»~
@12138 = ~«Приветствую».~
@12139 = ~«Приветствую».~
@12140 = ~Пройти мимо.~
@12141 = ~«Знаешь, тут ходят слухи о карманном воре, который наряжается как тленный. Ты случайно его не знаешь?»~
@12142 = ~«А, бар тленных? Он рядом с Моргом. Иди от главных ворот Морга строго на юго-запад. Ты его не пропустишь».~
@12143 = ~«Я слыхал о нем. Я помогу тебе... в обмен на награду».~
@12144 = ~«Я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@12145 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... в обмен на награду».~
@12146 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@12147 = ~«Я не могу помочь тебе. Прощай».~
@12148 = ~«Я не могу помочь тебе. Прощай».~
@12149 = ~«Советую тебе поторопиться».~
@12150 = ~«Знаешь, тут ходят слухи о карманном воре, который наряжается как тленный. Ты случайно его не знаешь?»~
@12151 = ~«Секты? Ты, наверное, имел в виду фракции?»~
@12152 = ~«Секты? Ты ведь тленный. Наверное, ты имел в виду фракции?»~
@12153 = ~«А, бар тленных? Он рядом с Моргом. Иди от главных ворот Морга строго на юго-запад. Ты его не пропустишь».~
@12154 = ~«Я слыхал о нем. Я помогу тебе... в обмен на награду».~
@12155 = ~«Я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@12156 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... в обмен на награду».~
@12157 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@12158 = ~«Я не могу помочь тебе. Прощай».~
@12159 = ~«Я не могу помочь тебе. Прощай».~
@12160 = ~«Внутренние планы — это субстанция. Они создают материю. Они ведут на Первичный материальный план, в котором существуют жизнь и смерть, и рождаются мысли. Первичный ведет на Внешние планы, где убеждения становятся осязаемыми, а мысли приобретают форму. Так понятней?»~
@12161 = ~«Я все еще не понимаю».~
@12162 = ~«Да. Продолжай».~
@12163 = ~«Лучше ответь на другие мои вопросы...»~
@12164 = ~«Мне пора идти. Прощай».~
@12165 = ~«К сожалению, я объяснял доступно, насколько мог. Запомни хотя бы это: место, на котором ты стоишь, — ненастоящая материя, оно создано силой убеждений Первичного и Внешних планов. Можно изменить убеждения, что станет причиной изменений этого места. Его можно менять одной лишь силой разума».~
@12166 = ~«Хорошо. Теперь расскажи мне о планах».~
@12167 = ~«У меня есть другие вопросы...»~
@12168 = ~«Я должен идти. Прощай».~
@12169 = ~«Есть три правила, о которых ты должен помнить. Первое — Правило трех: если видишь две вещи — поищи третью. Второе — Правило центра мультивселенной: космос настолько огромен, искатель, что в каком бы месте ты ни оказался, его можно принять за центр. Некоторые называют центром Сигил — и они по-своему правы. Но в равной степени окажутся правы и те, кто назовет центром бесконечные пустоты Геенны. У мультивселенной нет края, поэтому у нее нет и центра. Третье правило — Правило единства колец: все вещи образуют кольца. У колец нет ни начала, ни конца: великое кольцо Внешних планов, Сигил в форме кольца, кольцо стихийных планов — даже силы думают кольцами; круги, круги, и еще раз круги».~
@12170 = ~«Теперь расскажи мне о структуре планов».~
@12171 = ~«У меня есть другие вопросы...»~
@12172 = ~«Мы вернемся к этому в другой раз. Прощай».~
@12173 = ~«Внешние планы созданы убеждениями, идеями и верой. Свою воображаемую форму они приобретают на Первичном материальном плане; образуясь из накопленных убеждений, они принимают поражающие воображение формы. Планы создаются убеждениями, убеждения здесь — сила. Измени их — и ты сможешь изменить саму суть реальности. Рожденные здесь существа, планорожденные, вроде нечистых или небожителей — действительно рождены благодаря мыслям и идеям смертных. Каждый из них символизирует какой-нибудь идеал, и чем он сильнее, тем сильнее существо. Таким образом, существо, символизирующее любовь, — одно из самых могущественных».~
@12174 = ~«Продолжай».~
@12175 = ~«У меня есть другие вопросы...»~
@12176 = ~«Мы обсудим это позже. Прощай».~
@12177 = ~«Вот почему силы — некоторые называют их богами — живут именно здесь. Именно сюда к ним попадает вера, здесь они наиболее могущественны и сильны. Их владения — продолжение их самих, проявление их божественной сущности — доверху заполнены убеждением».~
@12178 = ~«Так значит, основа планов — это убеждения? Расскажи мне теперь о Великом кольце».~
@12179 = ~«Расскажи мне о Внутренних планах».~
@12180 = ~«Расскажи мне о Первичном материальном плане».~
@12181 = ~«У меня есть другие вопросы...»~
@12182 = ~«На сегодня хватит. Прощай».~
@12183 = ~«Мы, свободное общество путешественников по планам, установили, что бесконечные Внешние планы образуют кольцо вокруг плана абсолютной нейтральности — Внешних земель. Шпиль, на котором находится Сигил, является их центром. Чем дальше ты удаляешься от Шпиля, тем меньше будет нейтральность, до тех пор, пока она не превратится в соседний план. Каждый из планов, соприкасающихся со Внешними землями, переходит в упорядоченность или хаос, добро или зло. Великий путь обозначает границу между Внешними землями и привратными городами, в которых имеются врата на эти планы. За привратными городами лежит Глушь, отсутствующая на картах территория с неизвестной историей, в которой теряются идеи. В Глуши таится большая опасность».~
@12184 = ~«Продолжай».~
@12185 = ~«Давай вернемся на несколько шагов назад, к началу. Расскажи мне о планах вообще».~
@12186 = ~«У меня есть другие вопросы...»~
@12187 = ~«Ни о чем. Прощай».~
@12188 = ~«Какие планы тебя интересуют?»~
@12189 = ~«Верхние планы».~
@12190 = ~«Нижние планы».~
@12191 = ~«Пограничные планы».~
@12192 = ~«Внешние земли».~
@12193 = ~«Давай вернемся на несколько шагов назад, к началу. Расскажи мне о планах вообще».~
@12194 = ~«У меня есть другие вопросы...»~
@12195 = ~«Ни о чем. Прощай».~
@12196 = ~«Верхние планы делятся на нейтральные, законопослушные и хаотичные. Какие именно тебя интересуют?»~
@12197 = ~«Нейтральные планы».~
@12198 = ~«Законопослушные планы».~
@12199 = ~«Хаотичные планы».~
@12200 = ~«Давай вернемся на несколько шагов назад, к началу. Расскажи мне о планах вообще».~
@12201 = ~«Расскажи мне побольше о планах Великого кольца».~
@12202 = ~«У меня есть другие вопросы...»~
@12203 = ~«Ни о чем. Прощай».~
@12204 = ~«Внешние планы отличаются не содержанием, а моралью. Мы делим планы на три группы: Верхние планы добра, Нижние планы зла и Пограничные планы нейтральности. Они, в свою очередь, делятся на планы Порядка и Хаоса, со Внешними землями посередине. Какие именно тебя интересуют?»~
@12205 = ~«Верхние планы».~
@12206 = ~«Нижние планы».~
@12207 = ~«Пограничные планы».~
@12208 = ~«Внешние земли».~
@12209 = ~«Давай вернемся на несколько шагов назад, к началу. Расскажи мне о планах вообще».~
@12210 = ~«У меня есть другие вопросы...»~
@12211 = ~«Ни о чем. Прощай».~
@12212 = ~«Верхние нейтральные планы включают в себя Звериные земли, место нейтральности и доброты, правда, с небольшим налетом хаоса; здесь правят животные в вечном полудне и вечной ночи. Также сюда можно отнести Байтопию, двойной рай промышленности и труда, где все работают во имя всеобщего блага. И, наконец, это Элизиум, прекраснейший план добра и спокойствия. Жаль, что сейчас я не могу насладится его восстанавливающим действием. О чем еще ты хотел бы услышать?»~
@12213 = ~«Расскажи мне об остальных Верхних планах».~
@12214 = ~«Расскажи мне побольше о планах Великого кольца».~
@12215 = ~«У меня есть другие вопросы...»~
@12216 = ~«Ничего. Прощай».~
@12217 = ~Кандриан едва заметно вздрагивает. «Я не знаток по части планов закона, — сказал он, — все эти их предельно структурированные природные закономерности немного пугают меня. Я стараюсь держаться от них подальше, поскольку ценю свою индивидуальность больше тех знаний, которые они могут мне дать. В эти планы входят строго регламентированная Аркадия, ближайший из добрых планов, соприкасающийся с нерушимым порядком Механуса, и Небесная гора, родной дом архонов и остров в Серебряном море».~
@12218 = ~«Расскажи мне об остальных Верхних планах».~
@12219 = ~«Расскажи мне побольше о планах Великого кольца».~
@12220 = ~«У меня есть другие вопросы...»~
@12221 = ~«Спасибо. Прощай».~
@12222 = ~«На этих планах я чувствую себя как дома, хотя от Асгарда я стараюсь держаться подальше: бесконечные битвы и испытания характера среди плавучих островов не совсем в моем вкусе. А вот Арборея... — он вздыхает. — Горы самые высокие, воздух самый чистый, реки самые прозрачные, а дичь — самая крупная. Настоящий рай, место, где чувства всегда яркие, а вино никогда не иссякает. Как только я наберусь сил — как только мы разберемся с Внешними планами, спроси меня о Внутренних, я расскажу о своем путешествии, — я обязательно вернусь в домик с полянкой на Арборее и немного отдохну».~
@12223 = ~«Расскажи мне об остальных Верхних планах».~
@12224 = ~«Расскажи мне побольше о планах Великого кольца».~
@12225 = ~«У меня есть другие вопросы...»~
@12226 = ~«Ничего. Прощай».~
@12227 = ~«Нижние планы, как и Верхние, делятся на нейтральные, законопослушные и хаотичные. Каждый из них отличается своим набором ужасов и кошмаров, которые по-разному влияют на дух путешественника, но всех их лучше избегать. Какие именно планы тебя интересуют?»~
@12228 = ~«Нейтральные планы».~
@12229 = ~«Законопослушные планы».~
@12230 = ~«Законопослушные планы».~
@12231 = ~«Хаотичные планы».~
@12232 = ~«Хаотичные планы».~
@12233 = ~«Расскажи мне побольше о планах Великого кольца».~
@12234 = ~«У меня есть другие вопросы...»~
@12235 = ~«Ничего. Прощай».~
@12236 = ~«Значит, нейтральные? Они ужасны, и понять их нелегко. А еще они гораздо более вероломны, чем можно было бы себе представить. Возьмем, к примеру, Геенну. Четыре дремлющих вулкана, парящих в бесконечной пустоте, и каждый из них по-своему *жив*, и каждый из них жаждет заполучить твою душу любым путем. Остается только заселить их юголотами — как по мне, самой скверной нечистью — и мы получим полную картинку. Еще есть план абсолютного зла — по крайней мере, так его называют — Серая пустошь, не-место, которое высасывает из твоего тела и духа весь цвет, воруя у тебя даже само безразличие. Это место самых ужасных битв, происходящих на тамошней войне. Лучше об этом не продолжать... А еще есть хаотичный Карцери...»~
@12237 = ~«Расскажи мне о войне».~
@12238 = ~«Расскажи мне о Карцери».~
@12239 = ~«Расскажи мне об остальных Нижних планах».~
@12240 = ~«Расскажи мне побольше о планах Великого кольца».~
@12241 = ~«У меня есть другие вопросы...»~
@12242 = ~«Это все, что я хотел узнать. Прощай».~
@12243 = ~«А, Кровавая война». При этих словах твоя кровь стынет в жилах. Низкородный продолжает предаваться воспоминаниям, похоже, не заметив этого. «Две армии демонов беспорядочно сталкиваются по всем Нижним планам, бездумно сея смерть во имя закона или хаоса. Они, несомненно, возвеличивают ее, но, в конечном счете, все это делается из ненависти и ради глупых стремлений, которые никому не на пользу, и слишком многим во вред».~
@12244 = ~«Расскажи мне о Карцери».~
@12245 = ~«Расскажи мне об остальных Нижних планах».~
@12246 = ~«Расскажи мне побольше о планах Великого кольца».~
@12247 = ~«У меня есть другие вопросы...»~
@12248 = ~«Это все, что я хотел узнать. Прощай».~
@12249 = ~«А, Карцери, со своими ядовитыми джунглями, кислотными болотами, губительными водами, похожими на нити гнилого бисера, опоясывающие друг друга… — он прерывается и внимательно смотрит на тебя, вновь пригвоздив тебя своим взглядом. — Запомни вот что, искатель: Карцери — это тюрьма, дом гехрелетов, одного из самых опасных типов нечисти. Сила тюрьмы — в силе ее тюремщика. Он силен настолько, насколько ему позволяет узник. Убей тюремщика, и мертвый сможет сбежать из Красной тюрьмы. Другого выхода оттуда практически нет; ворота перед тобой захлопываются и наблюдают, как ты проваливаешься в бескрайнее пространство между сферами. Берегись Карцери, путник: его оковы могут оказаться сильнее плоти».~
@12250 = ~«Расскажи мне о войне».~
@12251 = ~«Расскажи мне об остальных Нижних планах».~
@12252 = ~«Расскажи мне побольше о планах Великого кольца».~
@12253 = ~«У меня есть другие вопросы...»~
@12254 = ~«Это все, что я хотел узнать. Прощай».~
@12255 = ~«Несмотря на то, что я ненавижу порядок законопослушных Верхних планов,  в них по крайней мере есть частичка добра. А вот их нижнеплановый эквивалент... Ахерон — это сталкивающиеся кубы, на которых происходят бесконечные битвы копошащихся душ умерших существ. Баатор... — он невольно вздрагивает. — От Баатора лучше держаться подальше. Тамошние демоны — чистое воплощение развращенной, коррумпированной и бездушной машины порядка. Все плохое, что встречается в бюрократизме и законе, исходит от Баатора и расползается по душам смертных. Хотя там можно найти кое-какие полезные сведения, они вряд ли стоят того, чтобы быть духовно изнасилованными этим планом».~
@12256 = ~«Расскажи мне об остальных Нижних планах».~
@12257 = ~«Расскажи мне побольше о планах Великого кольца».~
@12258 = ~«У меня есть другие вопросы...»~
@12259 = ~«Это все, что я хотел узнать. Прощай».~
@12260 = ~«Несмотря на то, что я ненавижу порядок законопослушных Верхних планов,  в них по крайней мере есть частичка добра. А вот их нижнеплановый эквивалент... Ахерон — это сталкивающиеся кубы, на которых происходят бесконечные битвы копошащихся душ умерших существ. Баатор... — он невольно вздрагивает. — От Баатора лучше держаться подальше. Тамошние демоны — типа вон тех баатезу в углу — чистое воплощение развращенной, коррумпированной и бездушной машины порядка. Хочешь знать больше — поговори с ними, только запомни: все плохое, что встречается в бюрократизме и законе, исходит от Баатора и расползается по душам смертных. Хотя там можно найти кое-какие полезные сведения, они вряд ли стоят того, чтобы быть духовно изнасилованными этим планом».~
@12261 = ~«Расскажи мне об остальных Нижних планах».~
@12262 = ~«Расскажи мне побольше о планах Великого кольца».~
@12263 = ~«У меня есть другие вопросы...»~
@12264 = ~«Это все, что я хотел узнать. Прощай».~
@12265 = ~«Приношу свои извинения твоей спутнице, — он кланяется в сторону Падшей Грации, — но Бездна — не то место, которое стоило бы посещать. Если в Бааторе все упорядочено, то Бездна полна хаоса и перемен, и в них нет ничего приятного. А когда там становится относительно нормально, вот тут уже следует проявить максимальную бдительность. Там живут танарри, которых большинство первичников называют 'демонами', и это название дано им неспроста. Они — мои извинения, — Грация кивает в ответ, — непредсказуемы и коварны, а тех, кому можно доверять, можно пересчитать по пальцам. Еще раз прошу прощения, госпожа Грация, но вы, как я мог убедиться, — одна из тех немногих, кому можно доверять».~
@12266 = ~«Расскажи мне об остальных Нижних планах».~
@12267 = ~«Расскажи мне побольше о планах Великого кольца».~
@12268 = ~«У меня есть другие вопросы...»~
@12269 = ~«Это все, что я хотел узнать. Прощай».~
@12270 = ~«Бездна — не то место, которое стоило бы посещать. Если в Бааторе все упорядочено, то Бездна полна хаоса и перемен, и в них нет ничего приятного. А когда там становится относительно нормально, то тут уже следует проявить максимальную бдительность. Потому что там живут танарри, которых большинство первичников называют 'демонами', и это название дано им неспроста. Они непредсказуемы и коварны, тех, кому можно доверять, можно пересчитать по пальцам. Тем немногим, которым я бы доверился, я до сих пор не доверяю до конца: они — порождения хаоса и воплощения зла, и даже если у них приветливые лица — кто знает, может, это часть какого-то большого заговора?»~
@12271 = ~«Расскажи мне об остальных Нижних планах».~
@12272 = ~«Расскажи мне побольше о планах Великого кольца».~
@12273 = ~«У меня есть другие вопросы...»~
@12274 = ~«Это все, что я хотел узнать. Прощай».~
@12275 = ~«Я могу вспомнить о двух пограничных планах, и они — полные противоположности. Один из них — Механус, сама суть законопослушности, место, где в огромной машине, которой и является сам план, формируются, переплетаются и оттачиваются убеждения. Некоторые считают, что шестеренки Механуса приводят в движение Планы. Второй план — Лимбо, трясина хаоса, не поддающаяся никаким законам. И как только кому-то начинает казаться, что он разобрался в нем, Лимбо отвечает и меняется вокруг него. Или не меняется. Точно сказать нельзя. Кстати, не так давно я бывал на Лимбо...»~
@12276 = ~«Расскажи о своем путешествии».~
@12277 = ~«Расскажи о своем путешествии».~
@12278 = ~«Расскажи мне побольше о планах Великого кольца».~
@12279 = ~«У меня есть другие вопросы...»~
@12280 = ~Закрыв глаза, он погружается в воспоминания: «Со мной был гитцерай-проводник, анарх, который усилием воли мог придавать форму иррациональной материи плана. На нас нападали слаади, хаотичные существа, считающие этот план своим домом. Их было больше, чем обычно, хотя кто знает, что в Лимбо можно назвать 'обычным'... но я отвлекся. Посреди всего этого хаоса мы наткнулись на несколько огромных металлических соединенных между собой кубов, похожих на какую-то клетку-головоломку. Сами мы не могли сформировать бы это, осознанно или нет. И мы не нашли способа попасть внутрь. Это было похоже... похоже на оплот порядка в окружении хаоса, на зерно законопослушности. Другого объяснения я найти не могу».~
@12281 = ~«Расскажи мне побольше о планах Великого кольца».~
@12282 = ~«У меня есть другие вопросы...»~
@12283 = ~«Это все, что я хотел узнать. Прощай».~
@12284 = ~«Внешние земли абсолютно нейтральны. Из всех Внешних планов это, пожалуй, это лучшее место для путешествия за пределы Сигила, если ты не хочешь, чтобы мораль плана проникла в твое сердце. Во Внешних землях все уравновешивается — как и положено для плана, находящегося в центре Внешних планов. Повсюду разбросаны владения Сил, полно привратных городов, граничащих с остальными Внешними планами. Обычно привратные города отражают философию плана, с которым они они граничат. И если в городе не будет соблюдаться баланс убеждений, то он попросту сползет на соседний план. Это плохой исход событий, потому что мало кто в городе действительно *хочет* подобных изменений. Но довольно о Внешних землях. О чем еще ты хотел бы узнать?»~
@12285 = ~«Давай вернемся на несколько шагов назад, к началу. Расскажи мне о планах вообще».~
@12286 = ~«Расскажи мне побольше о планах Великого кольца».~
@12287 = ~«У меня есть другие вопросы...»~
@12288 = ~«Это все, что я хотел узнать. Прощай».~
@12289 = ~Он тяжело вздыхает, словно вопрос напомнил ему о его смертельной усталости. «Представь, что Внутренние планы — это шар. Наверху будет Позитивный материальный план. А внизу — Негативный, — он делает паузу. — Напомни мне потом рассказать про Негативный, — в его глазах видна тень какого-то сокровенного ужаса. — Из их взаимодействия рождаются бытие и небытие, смерть и жизнь, действительность и ничто. Из них образуются основные стихийные планы — Огненный, Водный, Воздушный и Земной — и парастихийные, которые лежат между четырьмя основными. Также есть квазистихийные планы, которые образуются от соприкосновения четырех стихий с Позитивным и Негативным».~
@12290 = ~«Расскажи мне о Негативном материальном плане».~
@12291 = ~«Расскажи мне об остальных планах».~
@12292 = ~«У меня есть другие вопросы...»~
@12293 = ~«Это все, что я хотел узнать. Прощай».~
@12294 = ~Его взгляд затуманивается. «Я направился на Внутренние планы, чтобы найти свою истинную сущность. Я совершил ошибку, посетив Негативный материальный план в попытке понять стремление тела к угасанию, а также цикл жизни и смерти. Я думал, что буду магически защищен от вредных эффектов плана, но я оказался неправ. Тьма бесконечного небытия окружила меня, и я оказался осажден тенями, рыскающими в поисках моей души. На время — на бесконечно долгое время — я сбился с пути и почти потерял свою сущность. Я почувствовал, как она почти покинула меня, и даже сейчас чувствую себя наполовину отсутствующим. Я больше никогда туда не вернусь».~
@12295 = ~«Как тебе удалось выжить?»~
@12296 = ~«Как тебе удалось выжить?»~
@12297 = ~«Тогда расскажи мне о других планах».~
@12298 = ~«У меня есть другие вопросы...»~
@12299 = ~«Понятно. Прощай».~
@12300 = ~«Как мне удалось выжить? — он напряженно улыбается. — С помощью кусочка небытия, которое сдерживало другое небытие. Знаешь, небытие может остановить только небытие, так что я взял его в руку, и оно меня защитило. Ты случайно не собираешься попасть в полное небытие? В тебе чувствуется какое-то безрассудство, поэтому я сделаю тебе небольшой подарок. Держи это в руке, когда на тебя будут наседать тени. Оно защитит тебя и твоих самых близких друзей. Хе». Он протягивает тебе небольшой черный знак, который, казалось бы, вообще не имеет размеров.~
@12301 = ~«Спасибо. Расскажи мне еще о планах».~
@12302 = ~«У меня есть еще вопросы...» ~
@12303 = ~«Спасибо. Прощай».~
@12304 = ~«Я воспользовался тем знаком, который дал тебе. Он спас мне жизнь. Без него я бы исчез навсегда».~
@12305 = ~«Расскажи мне еще о планах».~
@12306 = ~«У меня есть еще вопросы...» ~
@12307 = ~«Спасибо. Прощай».~
@12308 = ~«Если хочешь узнать о Первичном, лучше побывай на нем сам. Безграничных миров этого плана, как и самих планов, просто не счесть, однако я не могу обобщить их. Достаточно будет сказать, что они — колыбель Внешних планов и потомки Внутренних, и в них таятся безграничные возможности».~
@12309 = ~«Расскажи мне еще о планах».~
@12310 = ~«У меня есть еще вопросы...» ~
@12311 = ~«Спасибо. Прощай».~
@12312 = ~«Я? Я только что вернулся из небытия, и теперь пытаюсь восстановить свою сущность, пока она не ускользнула от меня окончательно».~
@12313 = ~«Небытие? Что ты имеешь в виду?»~
@12314 = ~«Понятно. У меня есть другие вопросы...» ~
@12315 = ~«Понятно. Прощай».~
@12316 = ~«Если только космос не сдвинулся или нас не скрутило в Лабиринты, я бы сказал, что мы находимся в таверне 'Тлеющий труп'».~
@12317 = ~«Что ты можешь рассказать о здешних завсегдатаях?»~
@12318 = ~«Лабиринты? Что ты имеешь в виду?»~
@12319 = ~«У меня есть другие вопросы...»~
@12320 = ~«Прощай».~
@12321 = ~«Здесь я ни во что не вмешиваюсь, искатель: я и так провожу слишком много времени, во что-нибудь встревая. Поговори с хозяином, если хочешь узнать побольше о его клиентах».~
@12322 = ~«У меня есть другие вопросы...»~
@12323 = ~«Прощай».~
@12324 = ~«Ну да, Лабиринты. Место, куда Леди сбрасывает неугодных, — произнося 'Леди', он делает небольшой полукруг над своим сердцем. — Если хочешь узнать побольше о Леди и городе, поищи осведомителя или какого-нибудь гида».~
@12325 = ~«Хорошо. У меня есть другие вопросы...»~
@12326 = ~«Отлично. Прощай».~
@12327 = ~«Извини, но последнее время я не видел никаких дневников, кроме своего собственного, да и тот сгинул в небытие».~
@12328 = ~«Неважно. У меня есть другие вопросы...»~
@12329 = ~«Прощай».~
@12330 = ~«Фарод дорос до сборщика? Когда это случилось? В прошлый раз он был всего лишь назойливым пареньком в одном из верхних районов. Ха. Некоторых время ДЕЙСТВИТЕЛЬНО меняет. Нет, искатель, готов поспорить, что Фарода я больше не знаю».~
@12331 = ~«Хорошо. У меня есть другие вопросы...»~
@12332 = ~«Отлично. Прощай».~
@12333 = ~«Это все, что я хотел узнать. Прощай».~
@12334 = ~«У меня есть несколько вопросов...» ~
@12335 = ~«Неважно. Прощай».~
@12336 = ~«Я лишь хотел задать пару вопросов...»~
@12337 = ~«Тогда прощай». ~
@12338 = ~Атаковать его, пока он отходит.~
@12339 = ~Атаковать его, пока он отходит.~
@12340 = ~Позволить ему уйти.~
@12341 = ~Туловище этого существа — смесь человека и барана. Его голова также сочетает в себе человечьи и бараньи черты: у него широкий плоский нос, козлиные уши и закрученные рога. На его грязной шерсти выстрижены замысловатые узоры, а с его пояса-сбруи свисает огромная алебарда с четырьмя лезвиями. Похоже, он тебя не замечает.~
@12342 = ~«Мы снова встрэтилис, странник. Ты чэго-то от мэня хотель?»~
@12343 = ~«Тогда прощай». ~
@12344 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого не хватает зуба с правой стороны. Заметив Падшую Грацию рядом с тобой, он скрежещет зубами, шипя: «Убери этого червя с Бездны, тогда и поговорим. Иначе мы ничего не скажем». Он смачно сплевывает.~
@12345 = ~«Тогда прощай». ~
@12346 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого не хватает зуба с правой стороны. «А, Тегарин, — говорит он, — наш старый приятель вернулся, чтобы нанести нам визит».~
@12347 = ~Абишай пятится при твоем приближении. «Убери своих хаотических крыс от нас, — он указывает на Падшую Грацию и Анну, — тогда и поговорим. А до тех пор нам не о чем говорить».~
@12348 = ~«Тогда прощай». ~
@12349 = ~Абишай пятится при твоем приближении. «Убери свою хаотическую крысу от нас, — он указывает на Анну, — тогда и поговорим. А до тех пор нам не о чем говорить».~
@12350 = ~«Тогда прощай». ~
@12351 = ~Абишай пятится при твоем приближении. «Убери свою хаотическую крысу от нас, — он указывает на Падшую Грацию, — тогда и поговорим. А до тех пор нам не о чем говорить».~
@12352 = ~«Тогда прощай». ~
@12353 = ~«Вернулся, транжира?» Нечистый улыбается тебе, шипя и изрыгая тошнотворные испарения из уголков рта. «К тебе уже вернулась память, старый приятель?»~
@12354 = ~«О чем это ты?»~
@12355 = ~«У меня есть несколько вопросов...» ~
@12356 = ~«Прощай».~
@12357 = ~«Еще вопросы? Возможно, у нас есть ответы. Мы определенно стремимся помочь тебе, старый приятель».~
@12358 = ~«Кто вы?»~
@12359 = ~«Чем вы занимаетесь?»~
@12360 = ~«Что это за место?»~
@12361 = ~«Расскажите мне о нечисти».~
@12362 = ~«Вы знаете сборщика по имени Фарод?»~
@12363 = ~«Я ищу дневник».~
@12364 = ~«Вы знаете сборщика, который ведет дела с нечистыми?»~
@12365 = ~«Я тоже весьма огорчен, Тегарин. Хотя и могу легко пережить это. В конце концов, прошло много столетий, а мы хорошо знаем, что время неумолимо к разуму смертных».~
@12366 = ~Аэтелгрин, не обращая на тебя внимания, отвечает своему товарищу: «И снова, Тегарин, ты ухватил самую суть дела. Хотя лучше не стоит упоминать, за что ты получил прозвище Трижды Проклятый».~
@12367 = ~«У меня есть другие вопросы...»~
@12368 = ~«У меня есть другие вопросы...»~
@12369 = ~«Ух ты, что я вижу — маленький летающий череп? Какой вокруг тебя приятный запах бааторийского разложения, дорогуша. Возможно, нам стоит обсудить это... позже, — абишай возвращается к тебе. — Итак... ты говорил, что у тебя есть вопросы?»~
@12370 = ~«Кто вы?»~
@12371 = ~«Чем вы занимаетесь?»~
@12372 = ~«Что это за место?»~
@12373 = ~«Расскажите мне о нечисти».~
@12374 = ~«Вы знаете сборщика по имени Фарод?»~
@12375 = ~«Я ищу дневник».~
@12376 = ~«Вы знаете сборщика, который ведет дела с нечистыми?»~
@12377 = ~«Что мы делаем? Как, разве это не понятно, старый приятель? Мы оставили наш любимый пост, чтобы посвятить себя так необходимому нам отдыху и по возможности завербовать кого-нибудь в наши прославленные ряды. Наши предводители, вне всякого сомнения, полностью поддерживают наше присутствие здесь».~
@12378 = ~«Как мы знаем, есть две разновидности нечисти — правильные и неправильные. Мы, баатезу, из тех, кто правильные. А те проклятые, ненавистные с другой стороны — хаотичные танарри — неправильны и должны быть уничтожены».~
@12379 = ~«Я не веду дневников, приятель, и тебе не советую. Спроси моего дорогого товарища Тегарина почему — и ты получишь объяснение».~
@12380 = ~«Хорошо. Тегарин, почему я не должен вести дневник?»~
@12381 = ~«Может, позже. У меня есть другие вопросы...»~
@12382 = ~«Может, позже. Прощай».~
@12383 = ~«Ты! Я же сказаль тэбэ никохда, *никохда* мнэ болше нэ попадаца на путы! Кх оружию, двухногий...»~
@12384 = ~Он поворачивается к тебе с пугающей скоростью, его темные глаза с подозрением смотрят на тебя. Голос у него низкий и рокочущий, не совсем похожий на человеческий, с сильным акцентом. «Чего тэбэ, двухногий?..» Его рука тянется к алебарде.~
@12385 = ~Кажется, он успокоился: его рука удаляется от оружия. Однако он все еще держится от тебя на некотором расстоянии...~
@12386 = ~«Што ты хочешь знат от мэня?»~
@12387 = ~В мгновение ока он выхватывает алебарду из сбруи и заносит ее для удара. «Прэждэ чем мы скрэстим рога, я хотель бы знат, почэму ты нападаешь на мэня, двухногий». Он высекает подковами яркие искры из брусчатки, перенося свой вес то на передние, то на задние ноги.~
@12388 = ~Он немного опускает алебарду и издает облегченный вздох. «Тогда харашо, пожалюй, нам нэ нужно так спешит проливат друг другу кров. Што ты от мэня хотель?»~
@12389 = ~Морт шепчет тебе: «Босс, не нравится мне это. Они не должны здесь находиться. На Кровавой войне небожители так просто нечисти отпуска не дают. Им что-то *нужно*. Будь осторожен». Тем временем Тегарин продолжает отвечать своему спутнику...~
@12390 = ~«ШТО? Нэт, двухногий, это *ты* ко *мнэ* подошоль. Я нэ откажу тэбэ в драке, эсли ты этого хочешь, но ты нэ потэряешь чэсти, отступив сэчас...»~
@12391 = ~«ШТО? — твое обвинение кажется ему немыслимым. — Нэт, двухногий, это *ты* ко *мнэ* подошоль. Я нэ откажу тэбэ в драке, эсли ты этого хочешь, но ты нэ потэряешь чэсти, отступив сэчас...»~
@12392 = ~«А, снова ты, двухногий. Што тэпэр?»~
@12393 = ~«Харашо, ты, жующая говно, покхромсаная обэзяна с бусами на башкхе! Эсли выживешь в бою, тэбэ лютше *никохда* болше не попадаца мне на путы!» Он цокает копытами по мостовой, готовясь к атаке.~
@12394 = ~Он некоторое время молчит, как бы ожидая от тебя чего-то еще. «А... што с городом?»~
@12395 = ~«Ну, это пэрэкросток, двухногий. Тэбэ вэд дольжно быт извэстно, што всэ путы прокходят чэрэз Сигиль?»~
@12396 = ~«Тогда прощай». ~
@12397 = ~«Тогда прощай». ~
@12398 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого небольшой шрам под левым глазом. Заметив Падшую Грацию рядом с тобой, он скрежещет зубами, шипя: «Убери своего червя с Бездны, тогда и поговорим. Иначе мы ничего не скажем». Он смачно сплевывает.~
@12399 = ~«Тогда прощай». ~
@12400 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого небольшой шрам под левым глазом. «Приветствую, старый товарищ. Я неподдельно рад снова тебя видеть».~
@12401 = ~«Снова?»~
@12402 = ~Абишай пятится назад при твоем приближении. «Убери от нас своих хаотических крыс, — он указывает на Падшую Грацию и Анну, — тогда и поговорим. А до тех пор нам не о чем говорить».~
@12403 = ~«Тогда прощай». ~
@12404 = ~Абишай пятится назад при твоем приближении. «Убери от нас свою хаотическую крысу, — он указывает на Анну, — тогда и поговорим. А до тех пор нам не о чем говорить».~
@12405 = ~«Тогда прощай». ~
@12406 = ~Абишай пятится назад при твоем приближении. «Убери от нас свою хаотическую крысу, — он указывает на Падшую Грацию, — тогда и поговорим. А до тех пор нам не о чем говорить».~
@12407 = ~«Тогда прощай». ~
@12408 = ~«Вернулся, транжира? — с шипением улыбается тебе нечистый, изрыгая тошнотворные испарения из уголков рта. — Вернулись ли твои воспоминания к тебе, старый приятель?»~
@12409 = ~«О чем это ты?»~
@12410 = ~«Именно так, Аэтелгрин, именно так. Однако глаза его утратили былой блеск. Как полагаешь, что привело его снова к нам? ЧТО привело тебя к нам, друг?»~
@12411 = ~«Кто вы?»~
@12412 = ~«Чем вы занимаетесь?»~
@12413 = ~«Что это за место?»~
@12414 = ~«Расскажите мне о нечисти».~
@12415 = ~«Вы знаете сборщика по имени Фарод?»~
@12416 = ~«Я ищу дневник».~
@12417 = ~«Ничего. Прощай».~
@12418 = ~«Ах, Аэтелгрин, время украло память у нашего приятеля! Ты ведь и правда нас не помнишь? Я очень этим опечален».~
@12419 = ~«Но...»~
@12420 = ~«Я имею в виду, уважаемый, что время, наш старый враг, сумело подло вывести тебя из строя. Оно разграбило твою память и украло твои воспоминания. Если ты не узнаешь нас, то это потому, что ты стал жертвой одной из слабостей смертных. Мы — твои старые приятели, очень старые. Что мы можем сделать для тебя?» ~
@12421 = ~«У меня есть несколько вопросов...» ~
@12422 = ~«Ах, хорошо сказано. Старый приятель, мы — два абишая, которые покинули свой пост на Бааторе. Я — Тегарин Трижды Проклятый, названный так за способность изворачиваться в любой ситуации. А это Аэтелгрин, у которого нет особого имени, хотя не из-за недостатка усердия».~
@12423 = ~«Ничего. Прощай».~
@12424 = ~«Недостатка усердия? Что ты имеешь в виду?»~
@12425 = ~Тегарин, в свою очередь игнорируя тебя, отвечает товарищу. «И снова повторюсь, что упоминать при удобном случае — лучше, чем не упоминать вовсе, — абишай поворачивается к тебе. — Старый приятель, будет ли это ответом на твой вопрос о наших прозвищах?»~
@12426 = ~«Думаю, да. У меня есть другие вопросы...»~
@12427 = ~«Думаю, да. Прощай».~
@12428 = ~«Непосредственно в данный момент мы развлекаемся в этом... замечательном... заведении. И, конечно же, мы рады возвращению нашего старого приятеля. Однако зловонные сквозняки, которые иногда задувают в двери запах добра, несколько нас уязвляют, физически, психически и духовно ослабляя нас. К счастью, воздух в этом районе несет восхитительный привкус боли и страданий. Не так ли?» Нечистый снова широко улыбается тебе.~
@12429 = ~«У меня есть другие вопросы».~
@12430 = ~«В самом деле. Прощай».~
@12431 = ~«Это таверна 'Тлеющий труп', одна из многих замечательных таверн вашей расы, которые привлекают внимание к этому городу: поэтическое правосудие над горящим парнем у входа в заведение придает ему поистине замечательный шарм. Ты хотел спросить что-то еще?»~
@12432 = ~«Да, у меня есть еще вопросы...»~
@12433 = ~«Нет. Прощай».~
@12434 = ~«Мы считаем, что танарри полностью ответственны за разжигание Кровавой войны! Не будь их, мы бы смогли мирно заселить Нижние планы, и нам всем не пришлось бы отвлекаться на эту несчастную войну, не было бы этих... несчастных... внешних воздействий на другие планы, которые возникают из-за интересов всех этих словоблудных доброходов-добряков. Это танарри следует винить в нынешнем плачевном состоянии мультивселенной».~
@12435 = ~«Это не совсем то, о чем я спросил. Я хотел узнать разницу между вами и ними».~
@12436 = ~«Понятно. У меня есть другие вопросы...» ~
@12437 = ~«Понятно. Прощай».~
@12438 = ~Нечистый, умолкнув на минуту, озаряется. «Ах, да. Видишь ли, мы представляем закон и порядок. Те, кто нарушают закон, должны быть наказаны. Если у нас не будет закона, у нас будет анархия. Ты, несомненно, видишь, что сделала с Бездной анархия: она просто набита необъяснимыми ужасами. Любые нарушения со стороны баатезу могут быть объяснены ответными действиями на растущие волны хаоса, вызываемого танарри. Мы никому не хотим вреда — мы всего лишь предпочитаем знать, где находятся границы».~
@12439 = ~«Понятно. У меня есть другие вопросы...» ~
@12440 = ~«Понятно. Прощай».~
@12441 = ~«Фарод? Где-то я слышал это имя. Он, случаем, не мудрец? Может, некромант? Или предсказатель по хламу? Я слышал о нем, мой друг, но никогда не довольствовался его обществом. Возможно, один из здешних... посетителей... сможет тебе помочь».~
@12442 = ~«Может быть. У меня есть другие вопросы...»~
@12443 = ~«Возможно. Прощай».~
@12444 = ~«Потому что, приятель, очень легко совершить ошибку, оставив истинные слова потомкам. Тому, кому ты прежде верил, — и тут он бросает ядовитый взгляд на Аэтелгрина, — будет гораздо легче найти и использовать их против тебя. Право же, это даже может привести к действиям, равносильным невыполнению обязательств... потеря или утрата дневника может стоить тебе существования».~
@12445 = ~«Понятно. У меня есть другие вопросы...» ~
@12446 = ~«Понятно. У меня были вопросы...»~
@12447 = ~«Понятно. Прощай».~
@12448 = ~«Понятно. Прощай».~
@12449 = ~«Шеф, я более чем уверен, что эти пни — не самые большие шишки. Мне кажется, что они сбежали и теперь ищут какой-нибудь способ повысить свой статус в Бааторе. Тебе не стоит разговаривать с ними, шеф... непонятно, в какую игру они играют, а тебя они могут поджарить... буквально».~
@12450 = ~«Хорошо, Морт. Я задам еще парочку вопросов этим двум...»~
@12451 = ~«Хорошо, Морт. С этими я закончил».~
@12452 = ~«Гдэ? М-м... — он задумчиво смотрит вверх, пощипывая бородку, — во Внэшных зэмлях, цэнтрэ планов. Но поскоку можьно добратса суда отовсуду, Сигиль накходится в больче чем одном мэстэ. Понимаишь?»~
@12453 = ~На миг он кажется грустным. «Это мэсто... бэдное и грязное... тут полно нэдружелюбных, иногда и отчаянных людэй. Нэ лючее место для гостюющего бариавра, двухногий, — он пожимает плечами. — Но у мэня здэс дэла, и поэтому я здэс».~
@12454 = ~Бариавр, смеясь, качает головой. «Нэт-нэт, двухногий... бариавры здэс жит нэ могут».~
@12455 = ~«В другой раз, двухногий. Эсли встрэтимся... в боле вэсэлом мэстэ, я всо тэбэ расскажу».~
@12456 = ~«С равнын Аскхарда, двухногий. Там мой дом». Он улыбается в раздумии, как бы согретый теплыми воспоминаниями.~
@12457 = ~Он с любопытством глядит на тебя. «Што конкрэтно ты хочешь знат о них?»~
@12458 = ~«Нэ думаю, что здэс найдэтся что-нибуд харошее, двухногий. Может, тэбэ стоит заглянут в кхакой-нибуд другой район».~
@12459 = ~Он хмурится. «Сомнэваюс, што здэс найдэтса кхакая-нибуд чэстная работа... вот чего в Уле много, так это нэприятностэй».~
@12460 = ~«Я здэс мало кхого знаю, двухногий... и этого 'Фарода' срэды них нэт. Твой приятэль?»~
@12461 = ~Он качает головой. «Нэт, двухногий, нычего такого».~
@12462 = ~«Лэди? — он оглядывается, как бы проверяя, чтобы никто не подслушал. — Я только знаю, што она правит этим мэстом, всэм Сигилем, и што мэстные считают дурным знаком говорит о нэй».~
@12463 = ~Он выглядит немного раздраженным. «Да, я такх и сказаль. 'Путы'».~
@12464 = ~Его темные глаза прищуриваются, в них появляется подозрительность и недовольство. «Я сказаль то, што сказаль. Может, люче *тэбэ* попробоват говорит на *моем* языкэ, двухногий...»~
@12465 = ~Фыкрая от отвращения, он тянется к оружию... затем берет себя в руки. «Больше никохда нэ попадайся мнэ на... ПУТЫ... сутший кабан, нэ то я тэбя убью». Он отворачивается от тебя.~
@12466 = ~Морт подлетает поближе и шепчет тебе на ухо: «Он *прав*, шеф... Не знаю, что вас так взбесило...»~
@12467 = ~«Да, да! То что надо!»~
@12468 = ~*Нюхает* «Хм! Ничего!»~
@12469 = ~«Приветствую...»~
@12470 = ~Оставить его в покое.~
@12471 = ~«У меня есть несколько вопросов...»~
@12472 = ~«Нет, неважно. Прощай».~
@12473 = ~«Но...»~
@12474 = ~Защищаться.~
@12475 = ~«Только поговорить с тобой. У меня есть несколько вопросов...»~
@12476 = ~«Если ты нарываешься на драку — ты ее получишь...»~
@12477 = ~«Ничего, неважно. Прощай».~
@12478 = ~«Почему ты относишься ко мне с таким подозрением?»~
@12479 = ~«Расскажи мне об этом городе».~
@12480 = ~«Расскажи мне про эти трущобы».~
@12481 = ~«Что ты можешь сказать о Леди Боли?»~
@12482 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@12483 = ~«Я потерял дневник. Тебе ничего такого не попадалось? Или, может, ты знаешь, где его можно найти?»~
@12484 = ~«На самом деле, ничего. Прощай».~
@12485 = ~«Я не хотел...»~
@12486 = ~«Я? Это *ты* угрожал *мне*».~
@12487 = ~«Я? Это *ты* угрожал *мне*».~
@12488 = ~«Ты оскорбил меня, четвероногий козлозадый дурак!»~
@12489 = ~«Потому что мне так *нравится*...»~
@12490 = ~Отвернуться и уйти прочь.~
@12491 = ~Убежать.~
@12492 = ~«Я бы хотел задать несколько вопросов...»~
@12493 = ~«Я передумал. Лучше я пущу тебе кровь...»~
@12494 = ~«Хорошо... Я всего лишь хотел задать вопрос...»~
@12495 = ~«Э, нет... это все *ты*, и ты об этом пожалеешь!»~
@12496 = ~«Тогда забудь об этом. Прощай».~
@12497 = ~«У меня есть несколько вопросов...»~
@12498 = ~«Ничего... Прощай».~
@12499 = ~Защищаться.~
@12500 = ~Убежать.~
@12501 = ~«Что это за место?»~
@12502 = ~«Где именно он находится?»~
@12503 = ~«Не обращай внимания. Позволь мне спросить кое о чем еще».~
@12504 = ~«Забудь, что я спрашивал, это неважно. Прощай».~
@12505 = ~«'Путы'?.. Ты хотел сказать 'пути'?»~
@12506 = ~«Ага, понятно... а где именно находится Сигил?»~
@12507 = ~«Позволь мне спросить еще кое о чем».~
@12508 = ~«Это все, что я хотел узнать. Прощай».~
@12509 = ~«Думаю, да. И все же, *что* это за место?»~
@12510 = ~«Да. Позволь спросить тебя кое о чем еще».~
@12511 = ~«Да. Это все, что было мне нужно. Прощай».~
@12512 = ~«Гостящего? Ты здесь не живешь?»~
@12513 = ~«Дела? Зачем ты здесь?»~
@12514 = ~«Понятно. У меня к тебе еще один вопрос».~
@12515 = ~«Тогда позволю тебе вернуться к твоим делам. Прощай».~
@12516 = ~«Откуда ты?»~
@12517 = ~«Что за дела у тебя здесь?»~
@12518 = ~«Понятно. У меня к тебе еще один вопрос».~
@12519 = ~«Тогда позволю тебе вернуться к твоим делам. Прощай».~
@12520 = ~«Ты упоминал, что гостишь здесь. Ты здесь не живешь?»~
@12521 = ~«Тогда позволь мне спросить кое о чем еще...»~
@12522 = ~«Тогда до следующего раза. Прощай».~
@12523 = ~«Что за дела у тебя здесь?»~
@12524 = ~«У меня к тебе еще один вопрос...»~
@12525 = ~«Это все, что я хотел узнать. Прощай».~
@12526 = ~«Я ищу местечко, где можно было бы развлечься».~
@12527 = ~«Я ищу местечко, где можно было бы развлечься».~
@12528 = ~«Я ищу работу».~
@12529 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@12530 = ~«Я потерял дневник. Тебе ничего такого не попадалось? Или, может, ты знаешь, где его можно найти?»~
@12531 = ~«Вообще-то, ничего. У меня есть другие вопросы...»~
@12532 = ~«Если подумать, то ничего. Прощай».~
@12533 = ~«Что, если я ищу работу?»~
@12534 = ~«У меня есть другие вопросы...»~
@12535 = ~«Как насчет места, где можно было бы развлечься?»~
@12536 = ~«Как насчет места, где можно было бы развлечься?»~
@12537 = ~«По правде говоря, я даже не знаю. Позволь спросить еще кое о чем...»~
@12538 = ~«Возможно, я не уверен. Прощай».~
@12539 = ~«Хм. У меня еще один вопрос...»~
@12540 = ~«Хорошо, тогда прощай».~
@12541 = ~«Ясно. Скажи мне еще кое-что...»~
@12542 = ~«Спасибо. Это все, что я хотел знать. Прощай».~
@12543 = ~«Нет... ты снова ошибся. 'Пути', а не 'путы'».~
@12544 = ~«Понятно. А где именно находится Сигил?»~
@12545 = ~«Ясно. Позволь мне спросить кое о чем еще...»~
@12546 = ~«Хорошо. Это все, что я хотел узнать. Прощай».~
@12547 = ~«О, не вопрос: Иа-иа-иа! Бее-бе-бе!»~
@12548 = ~«Ты прав, я извиняюсь. Позволь задать тебе вопрос».~
@12549 = ~«Как скажешь, четвероногий. Прощай».~
@12550 = ~«Ты прав, прошу прощения. Счастливо».~
@12551 = ~Пусть уходит.~
@12552 = ~Атаковать его, пока он отходит.~
@12553 = ~«Хорошо... Я только хотел задать вопрос...»~
@12554 = ~«Умолкни, ноющий череп! А ты, козлик, сдохни...»~
@12555 = ~«Э, нет... это все *ты*, и ты об этом пожалеешь...»~
@12556 = ~«Тогда забудь об этом. Прощай».~
@12557 = ~«Тогда, может, ты скажешь мне еще кое-что...»~
@12558 = ~«Может, ты и прав. Прощай».~
@12559 = ~«Говоришь, другой район? Возможно. Прощай».~
@12560 = ~«Оле, рубака, рад встрече. Истосковался по вкусным крысочкам Кредена, а?»~
@12561 = ~Каждая крыса освежевана и выпотрошена, лапки и хвосты удалены. Они свисают с шеста на вдетых в шею крючках. Осматривая их, ты понимаешь, что с их головами что-то не так: из каждого черепа выступает покрытый завитушками костный нарост, что придает ему сходство с мозгом.~
@12562 = ~Похоже, его это ничуть не смутило: он даже подмигнул тебе, весело улыбаясь. «Вот что я тебя скажу, рубака: ты даже не представляешь, от чего отказываешься! Если передумаешь — я буду здесь». Он возвращается к продаже крыс прохожим.~
@12563 = ~«Хорошо, рубака, очень хорошо! Какую хошь? — перечисляя, он указывает на каждую грязным пальцем. — У меня есть печеные, пряные, вареные и жареные! Все свежее, все высшего сорта... и всего лишь три медяка за пару!»~
@12564 = ~Ты протягиваешь свои медяки, а он одним ловким движением деревянного шампура протыкает пару печеных крыс, снимает их с крюков и кладет в твою руку. «Приятного аппетита, рубака!»~
@12565 = ~Ты протягиваешь свои медяки, а он одним ловким движением деревянного шампура протыкает пару пряных крыс, снимает их с крюков и кладет в твою руку. «Приятного аппетита, рубака!»~
@12566 = ~Ты протягиваешь свои медяки, а он одним ловким движением деревянного шампура протыкает пару вареных крыс, снимает их с крюков и кладет в твою руку. «Приятного аппетита, рубака!»~
@12567 = ~Ты протягиваешь свои медяки, а он одним ловким движением деревянного шампура протыкает пару жареных крыс, снимает их с крюков и кладет в твою руку. «Приятного аппетита, рубака!»~
@12568 = ~Мясо крысы очень нежное и сочное; оно легко отделяется от костей и буквально тает у тебя во рту. Оно немного жирновато и очень питательно, напоминает какое-то... другое мясо, которое ты уже пробовал. Мужчина выжидающе смотрит на тебя. «Ну как, нравится? Может, еще хошь?~
@12569 = ~Крысиное мясо приятно пахнет и имеет довольно пикантный вкус: очевидно, перед приготовлением его хорошо замариновали какой-то смесью трав. Оно немного жирновато и очень питательно, напоминает  какое-то... другое мясо, которое ты уже пробовал. Мужчина выжидающе смотрит на тебя. «Ну как, нравится? Может, еще хошь?»~
@12570 = ~Крысиное мясо, приготовленное этим способом, несколько жестковато и безвкусно, и напоминает  какое-то... другое мясо, которое ты уже пробовал. Будь оно приготовлено по-другому, вкус был бы намного лучше. Ты не можешь себе представить, *кому* могло взбрести в голову варить мясо. Мужчина выжидающе смотрит на тебя. «Ну как, нравится? Может, еще хошь?»~
@12571 = ~Снаружи мясо зажарено до хрустящей корочки, но внутри оно сочное и нежное. Оно немного жирновато и очень питательно, напоминает какое-то... другое мясо, которое ты уже пробовал. Мужчина выжидающе смотрит на тебя. «Ну как, нравится? Может, еще хошь?»~
@12572 = ~Он искренне удивляется. «Печально слышать это, рубака. Хорошего дня». Он готов уйти.~
@12573 = ~Небрежным движением плеча он толкает крысиный шест. «Шо за вопрос, рубака?»~
@12574 = ~«Шо? Эти? — он потряхивает шестом, заставляя освежеванных крыс танцевать жуткую джигу. — Я поймал их самолично... в подвалах и переулках Улья».~
@12575 = ~Он бросает взгляд назад. «Это Управление по борьбе с вредителями и заболеваниями. Там я продаю крысиные хвосты, потом готовлю этих мелких паразитов и продаю их».~
@12576 = ~«Все верно, рубака! В Управлении по борьбе с вредителями и заболеваниями сидит пень по имени Лорт, который платит за них награду. По медяку за голову... э-э, за хвост, то есть. Только они должны быть мозгогрызунами... не какими-то обычными крысами».~
@12577 = ~«Его зовут Финеас. Финеас Лорт. Кажется, раньше он был крупной шишкой, но потом его опустили недоброжелатели, и теперь он застрял здесь, в самой жопе Сигила. Этот пень сидит там сутки напролет, ждет, пока ему не принесут хвосты в обмен за награду. А знаешь, что самое интересное? У бедолаги, походу, аллергия на крыс: у него постоянно какая-то сыпь! Хо-хо! Хвала Силам, что я  — не тот чудак».~
@12578 = ~«Ну, он без меры болтливый: может часами трясти черепушкой насчет того, какой он умный и все такое. Наверное, кому-то это не понравилось». Он пожимает плечами.~
@12579 = ~«Шо, я? Я — Креден, еще кличут Кредо — Палач-всех-крыс!» Он напыщенно улыбается, демонстрируя ряды пожелтевших сломанных кривых зубов.~
@12580 = ~«Таки да, рубака, мозгогрызунов. Грязные твари. Вот возьмем обычных крыс — они просто жрут и размножаются, разносят всякую заразу и так далее... в общем, досаждают, но не сильно. А вот *черепные* крысы, или мозгогрызуны, на которых охочусь *я*, вот они — настоящая проблема. Если этих сволочей наберется слишком много, то они начинают умнеть прямо на глазах... иногда даже *слишком сильно* умнеть».~
@12581 = ~Он громко гогочет; изо рта у него разит луком. «Да я настоящий эксперт в этом деле! Шо за вопрос, рубака?»~
@12582 = ~«Точно, так и есть! Если бы я наткнулся на штук сорок — бежал бы *со всех ног*... — он щелкает пальцами, чтобы подчеркнуть свои слова. — Еще как улепетывал! Соберется их столько в кучу, и... ну, и умными становятся, прям как человек!»~
@12583 = ~«Мой тебе совет, рубака... Если захочешь ловить мозгогрызунов, ограничивайся небольшими стаями. С дюжину, не больше. Но вот что я тебе скажу...» Он делает шаг вперед. Обдавая тебя зловонием изо рта, он шепотом произносит: «Если их будет больше... больше пары дюжин... беги так, будто ты попал в тени Леди!» Он отступает назад.~
@12584 = ~«Колдовство, рубака... колдовство! Если наберешь этой мелкой нечисти в достаточном количестве, они получают много всяких странных способностей! От них у вояк мозги вытекают прямо через ухи! Просто жуть... Я тебе вот что скажу: это все неправильно. Именно поэтому Сигил так хочет от них избавиться... награды и все такое».~
@12585 = ~«Ты про Сигил? Шо ты хочешь знать за Клетку, рубака?»~
@12586 = ~«Ну да, Сигил... Клетка... Шо ты хочешь знать, рубака?»~
@12587 = ~Он качает головой и смеется, раскачивая висящих на шесте мертвых вредителей. «Понимаешь, рубака, здесь куча дверей. Некоторые называют Сигил 'Городом Дверей'... волшебных дверей; они повсюду... и ведут куда угодно. В самом деле, *куда угодно*! Но весь фокус в том, что... они все заперты! Так что это скорее Клетка... ты можешь попасть сюда и выбраться отсюда только с правильным ключом».~
@12588 = ~«Хо-хо! Да тебе подавай все и сразу! Ну, если в двух словах: в Клетке полно дверей. Эти двери повсюду, по всему Сигилу... но видеть их, покуда у тебя нет правильного ключа, ты не можешь. У каждой двери свой собственный ключ. Один ключ может быть и в самом деле ключом, сечешь? А вот другой может быть... скажем... вареной крысой! Или джигой, которую ты вытанцовываешь перед дверью. Как только у тебя появится подходящий ключ, ты сможешь войти и попасть куда угодно».~
@12589 = ~Крысолов бросает чудаковатый взгляд на Морта, парящего позади тебя. «Рубаке стоит спросить у своего мимира обо всех этих таинствах...»~
@12590 = ~Крысолов смущенно глядит на вас обоих, почесывая голову, и вдруг понимает, что снова оказался в центре внимания. Он отгоняет озадаченное выражение и вновь принимает самодовольный вид.~
@12591 = ~Он хмурится, прокручивая ответ у себя в голове. «Ну, если у тебя есть ключ, скорее всего, что ты уже знаешь, куда ведет дверь. А если ты, скажем, открыл дверь случайно — просто будь там поосторожнее. Можно, конечно, попробовать засунуть туда голову и осмотреться... но некоторые двери сразу же тебя засасывают! Ты можешь очутиться в какой-нибудь грязной дыре, попомни мои слова, рубака».~
@12592 = ~Он пожимает плечами, в очередной раз покачивая шест с висящими на нем крысами. «Ну, надо просто спросить правильного человека, который знает секрет этой штуковины. Знаешь, одни двери стоят на месте, другие — двигаются... если их всех отслеживать, можно умом тронуться. Сам-то я ими не пользуюсь, так что в этом деле я не тебе помощник».~
@12593 = ~Он немного озадачен. «Улей, что ли? Шо ты хочешь за него узнать, рубака?»~
@12594 = ~«Мой любимый дом и место для бизнеса! Шо ты хочешь за него знать, рубака?»~
@12595 = ~«Хм-м... — крысолов почесывает подбородок, оставляя на нем маслянистые пятна. — Насчет этого есть куча историй... насколько я знаю, где-то здесь есть нагромождение домов, такая себе непроходимая свалка из лачуг и руин, которые служат чем-то вроде места для сходок. Их называют Ульем — оттуда-то и пошло название этих трущоб... всего этого района».~
@12596 = ~Его дружелюбие сменятся хмурым взглядом: «Для всяких смутьянов. Если тебе удастся разыскать это место, мой тебе совет: держись от него подальше. И нечего об этом больше говорить». В завершение он сморкается, и его хмурость исчезает.~
@12597 = ~«Я не уверен, шо ты считаешь интересным, рубака. Дай мне знать: быть может, старина Креден направит тебе куда следует».~
@12598 = ~«Есть парочка не особо опасных мест, шобы напиться... Бар собирателей пыли и Тлеющий труп. В другие места лучше не соваться, рубака».~
@12599 = ~Перед тем как дать ответ, он на секунду задумывается. «Ну, знаешь, рубака... дела здесь плохи. Жизнь тяжелая. Это место без будущего, и здесь полно отчаянных людей. Скажем так: некоторые пойдут на шо-угодно, абы свести концы с концами. И плевать они хотели на пней вокруг себя. В Улье легко потеряться».~
@12600 = ~«Ха... а где его нет, рубака? Сигил простирается повсюду... реально повсюду... нет такого места, где его нету. Не знаю, существует ли он где-нибудь в обычном понимании этого слова... в определенном месте, то есть. Хотя большинство знатоков тебе скажет, шо он находится во Внешних землях».~
@12601 = ~«Ага, именно так, рубака. Это такой себе 'Центр Планов', в котором и находится Сигил. Только тут есть небольшая закавыка: если ты в Сигиле, то выйти наружу без магической двери уже не сможешь. Нет 'нормального' способа выбраться отсюдова во Внешние земли».~
@12602 = ~«Ага. А если ты снаружи... во Внешних землях... то обратно в Сигил ты не попадешь. Там только бесконечный каменный шпиль, который теряется в облаках прямо посреди Внешних земель, а Сигил вроде как вертится на его верхушке!»~
@12603 = ~Он кивает. «А теперь скажи мне, рубака: если ты не можешь просто так выйти из Сигила во Внешние земли или из Внешних земель в Сигил, то кто скажет, что он где-либо физически существует? — он проницательно кивает, наслаждаясь своей маленькой дилеммой. — По мне, так Сигил находится во всех планах, везде и нигде одновременно».~
@12604 = ~«Ага, рубака, двери. Если коротко: в Клетке полно дверей. Они повсюду, по всему Сигилу... но тебе их не разглядеть до тех пор, пока у тебя не будет подходящего ключа. У каждой двери есть свой ключ, и у каждой он разный. Получив подходящий ключ, ты сможешь войти в дверь и попасть туда, куда она ведет».~
@12605 = ~«На самом деле, работы в Улье не так чтобы много... большинство народу занято поиском еды и выживанием. Можешь собирать жмуриков, как сборщики... или охотиться на мозгогрызунов за награду».~
@12606 = ~«Он кивает. «Пни, которые собирают трупы и тащат их в Морг. Кажись, тленные дают им по медяку за жмурика. Сборщики этим зарабатывают на жизнь: обычно они обирают свежего покойника, а потом продают его. Я слыхал, — он понижает голос, быстро озираясь, — будто кое-кто из них помогает пням потеряться, ну ты понял. Мерзавцы — вот они кто».~
@12607 = ~«Я пытаюсь, рубака. Кажись, это все мой бизнес... многие из здешних косятся на меня, да и вообще, злые они все, и все же я хочу, чтобы каждый рубака знал, что у Кредена всегда найдется теплая улыбка и горячая, только что приготовленная крысочка!» Он подмигивает тебе.~
@12608 = ~«Ага, Госпожа Сигила. Рубака, я про Леди не болтаю... и тебе не стоит о ней расспрашивать. Не к добру это». Он изображает полукруг перед своей грудью.~
@12609 = ~Он выглядит удивленным. «Фарод? Зачем рубаке искать такого как он?»~
@12610 = ~«Он — главарь банды сборщиков, вот он кто... Без конца перемещается, видать, старается не нарываться на неприятности. Околачивается он где-то на площади Старьевщиков. Коварный тип этот Фарод. Рубаке следует быть поосторожнее рядом с ним».~
@12611 = ~Креден хмурится. «Все верно, рубака: где может быть этот тип, меня не касается».~
@12612 = ~«Извини, рубака... не могу сказать, чтобы мне что-то такое попадалось».~
@12613 = ~«Конечно, рубака. Бар собирателей пыли находится прямо перед Моргом, а Тлеющий труп — на востоке отсюда».~
@12614 = ~«Ага, рубака... потеряться. В книге мертвых».~
@12615 = ~«Точно, рубака... потеряться. В книге мертвых».~
@12616 = ~«Я покажу тебе, рубака — дай-ка мне карту». Он указывает тебе на место, оставляя большой жирный отпечаток пальца.~
@12617 = ~Он трогает тебя за руку. «Вижу, ты уходишь, рубака. Пока ты не ушел, не хошь попробовать вкусненьких, вааасхитительных крысочек? На дорожку, так сказать».~
@12618 = ~«Оле, рубака, рад снова видеть тебя. Ну как, передумал? Вернулся за одной из вааасхитительных крысочек Кредена?» Он призывно потряхивает шестом с крысами.~
@12619 = ~«Оле, рубака, рад снова видеть тебя. Я могу убедить тебя попробовать еще одну из моих вааасхитительных крысочек? Знаю, в прошлый раз тебе не понравилось, но, может, у Кредена найдется более подходящий вкус...»~
@12620 = ~«Теперь на этот вопрос не так уж и просто ответить, рубака... видишь ли, в последнее время эти сволочи стали редко встречаться. Раньше я ловил их в темных улицах и подвалах с помощью мышеловок, но, видать, уж слишком много их выловил. Тебе стоит попробовать на площади Старьевщиков: крысам очень нравятся тамошние мусорные кучи».~
@12621 = ~Морт пытается отстраниться под общим взглядом. «Что? Что?» Тебе кажется, что будь у него губы, то он бы сейчас невинно посвистывал.~
@12622 = ~«Ну, я скажу, что мы должны выслушать этого мужчину. Правильно?» Морт поворачивается к ловцу крыс и окидывает его тяжелым взглядом.~
@12623 = ~Морт смущенно закатывает глаза. «Это... говорящая энциклопедия. Не то, чтобы я этим гордился. А теперь давай выслушаем этого приятеля, хорошо?»~
@12624 = ~«Да ладно, шеф... зачем мне тебя отвлекать? Я сказал тебе все полезное, что знаю *сам*. Пусть лучше этот пень выскажется по этой теме».~
@12625 = ~«Точно, шеф! То, что надо!»~
@12626 = ~«Умереть, шеф... умереть».~
@12627 = ~«Умереть, шеф... умереть».~
@12628 = ~Осмотреть «крысочек».~
@12629 = ~«Да я лучше съем тухлятину».~
@12630 = ~«Какие... 'крысочки' у тебя есть?»~
@12631 = ~«Нет, не сейчас... У меня к тебе вопрос...»~
@12632 = ~«Что-то не хочется, спасибо. Прощай».~
@12633 = ~«Почему бы и нет... какие у тебя есть?»~
@12634 = ~«Да лучше я съем свои потроха, чем эту мерзость!»~
@12635 = ~«Нет, не сейчас. Но у меня есть несколько вопросов...»~
@12636 = ~«Нет, спасибо. Прощай».~
@12637 = ~«Какие странные крысы».~
@12638 = ~«Пожалуй, возьму одну».~
@12639 = ~«Я не ем всякую гадость».~
@12640 = ~«Нет, спасибо. Лучше я задам тебе вопрос...»~
@12641 = ~«Нет, спасибо, я не хочу крысу. Прощай».~
@12642 = ~«Мозгогрызунов?»~
@12643 = ~«Я попробую одну».~
@12644 = ~«Как отвратительно. Я лучше съем тухлятину, чем эту гадость».~
@12645 = ~«Интересно. У меня к тебе вопрос...»~
@12646 = ~«Это все, что я хотел услышать. Прощай».~
@12647 = ~«Печеную».~
@12648 = ~«Пряную».~
@12649 = ~«Вареную».~
@12650 = ~«Жареную».~
@12651 = ~«Высшего сорта? Сомневаюсь. Кто вообще будет есть эти отбросы?»~
@12652 = ~«У меня не хватает денег... лучше я задам тебе пару вопросов...»~
@12653 = ~«У меня не хватает денег... Прощай».~
@12654 = ~«Пожалуй, лучше я откажусь. Но у меня есть вопрос...»~
@12655 = ~«Если подумать, я не настолько голоден. Прощай».~
@12656 = ~Съесть «крысочку».~
@12657 = ~С отвращением выбросить ее.~
@12658 = ~Съесть «крысочку».~
@12659 = ~С отвращением выбросить ее.~
@12660 = ~Съесть «крысочку».~
@12661 = ~С отвращением выбросить ее.~
@12662 = ~Съесть «крысочку».~
@12663 = ~С отвращением выбросить ее.~
@12664 = ~«Было очень вкусно. У меня к тебе вопрос...»~
@12665 = ~«Хорошо, дай мне еще одну».~
@12666 = ~«Нет, вкус просто отвратительный».~
@12667 = ~«Нет, больше не нужно. Прощай».~
@12668 = ~«Было очень вкусно. У меня к тебе вопрос...»~
