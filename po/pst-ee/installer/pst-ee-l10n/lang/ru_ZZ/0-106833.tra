@16145 = ~Попытаться вспомнить.~
@16146 = ~Подавить воспоминание.~
@16147 = ~«Постой, у меня есть несколько вопросов...»~
@16148 = ~Позволить ему уйти.~
@16149 = ~«Можешь больше не кривляться. Я знаю кто ты, приятель».~
@16150 = ~«Довольно болтовни... Я просто прирежу тебя и заберу его».~
@16151 = ~«Неважно. Прощай».~
@16152 = ~«Зачем ты здесь находишься?»~
@16153 = ~«Расскажи мне свою легенду еще раз».~
@16154 = ~«Расскажи мне о своем кулоне».~
@16155 = ~«Кто этот повеса, что стоит рядом с тобой дни напролет?»~
@16156 = ~«Кто был тот повеса, что стоял рядом с тобой дни напролет?»~
@16157 = ~«Неважно, просто отдай мне кулон».~
@16158 = ~«Неважно, просто отдай мне кулон».~
@16159 = ~«Неважно. Прощай».~
@16160 = ~«Потому что мне обещали силу в обмен на него».~
@16161 = ~«Потому что ты обращаешься с ним неправильно».~
@16162 = ~«Это тебя не касается».~
@16163 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16164 = ~«Твой кулон пока не имеет значения. У меня есть несколько вопросов...»~
@16165 = ~«Забудь, оставь кулон у себя. Прощай».~
@16166 = ~«Хуже того, что делаешь ты, он сделать не сможет».~
@16167 = ~«В обмен на него я получу силу от двух демонов».~
@16168 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16169 = ~«Твой кулон пока не имеет значения. У меня есть несколько вопросов...»~
@16170 = ~«Забудь, оставь кулон у себя. Прощай».~
@16171 = ~«Например?»~
@16172 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16173 = ~«Твой кулон пока не имеет значения. У меня есть несколько вопросов...»~
@16174 = ~«Забудь, оставь кулон у себя. Прощай».~
@16175 = ~«Потому что мне обещали силу в обмен на него».~
@16176 = ~«Потому что ты обращаешься с ним неправильно».~
@16177 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16178 = ~«Твой кулон пока не имеет значения. У меня есть несколько вопросов...»~
@16179 = ~«Забудь, оставь кулон у себя. Прощай».~
@16180 = ~«Силу мне предложила пара демонов, но я не уверен, какого рода она будет».~
@16181 = ~«Так значит, у тебя ко мне предложение?»~
@16182 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16183 = ~«Забудь, оставь кулон у себя. Прощай».~
@16184 = ~«У меня есть другие вопросы...»~
@16185 = ~«Это все, что я хотел узнать. Прощай».~
@16186 = ~«У меня есть другие вопросы...»~
@16187 = ~«Это все, что я хотел узнать. Прощай».~
@16188 = ~«Да, сейчас его подпишу».~
@16189 = ~«Нет... Я просто прирежу тебя и заберу кулон».~
@16190 = ~«Забудь про контракт, оставь кулон у себя. Прощай».~
@16191 = ~Продолжить...~
@16192 = ~Продолжить...~
@16193 = ~Продолжить...~
@16194 = ~Продолжить...~
@16195 = ~«Приветствую...»~
@16196 = ~Атаковать его.~
@16197 = ~Оставить «его» в покое.~
@16198 = ~«Приветствую...»~
@16199 = ~Жар вокруг этого... существа... просто невероятный. К твоему удивлению, железная решетка, над которой оно парит, вся закоптилась и прогнулась от жары. Сперва ты решил, что жар исходит от решетки... но теперь ты понимаешь, что его излучает само существо. Ты наблюдаешь, как с корчащегося тела срываются хлопья пепла и медленно взмывают к потолку.~
@16200 = ~Осмотреть тлеющий труп.~
@16201 = ~«Хм-м. Интересно, поможет ли тут Графин бесконечной воды?..»~
@16202 = ~Ты наклоняешь графин над решеткой и начинаешь лить. Из него вытекает тонкая струйка голубой как лед воды и касается пламени решетки, вызвав резкое шипение и столб пара... Как бы в ответ на этот вызов графин *бросается* вперед, падает на решетку и разбивается!~
@16203 = ~Из решетки вырываются шипящие облака пара и яростный треск, который укутывает тебя и вынуждает прикрыть уши и отвернуться... Слышится крик, хихиканье, ужасный шум сотен горящих домов, кричащих людей; их крики перекрываются ревом пламени и горящей плоти...~
@16204 = ~Закрыв уши руками, чтобы оградиться от звука, ты чувствуешь на ладонях что-то липкое, вроде плавленного сыра или свечного воска... Твои уши кровоточат от звука! Ты отводишь руки и видишь, что они покрыты кусочками оплавленной плоти и сгустками крови...~
@16205 = ~Ты уже собираешься бежать из бара, лишь бы убраться от этого звука, как вдруг все умолкает; остается только неровное потрескивание, исходящее от решетки. Ты оборачиваешься: на решетке лежит Графин бесконечной воды. От него остались только осколки и пар. Над ним нависает существо; языки пламени все еще укутывают его тело. Оно пристально смотрит на тебя, его глаза мерцают как два факела...~
@16206 = ~По лицу существа проходит трещина, от его челюсти отделяется обугленная плоть, давая ему возможность говорить. «*Да-а-а...*» Его голос с треском, горением, ревом вырывается из груди. С каждым словом из его рта вылетают хлопья пепла и золы и кружат в воздухе. Тебе едва удается смотреть на это существо: трудно выдержать сияние, окружающее его.~ [IGN116]
@16207 = ~«*Да-а-а...*» Существо подлетает к тебе, воздух дрожит от окружающего его жара. *»Долго я ссспал... сссны про огонь...*» Будто вторя ему, в его глотке вспыхивает огонь, из-за почерневших зубов вырывается язык пламени. «*Я твой... пока ссссмерть не придет к нам обоим...*»~ [IGN004C]
@16208 = ~Когда ты подходишь, существо шипит, воздух дрожит от жара вокруг него. «*Долго я ссспал... сссны об огне...*»~ [IGN004B]
@16209 = ~Будто вторя ему, в его глотке вспыхивает огонь, из почерневших зубов вырывается язык пламени. «*Я твой... пока ссссмерть не придет к нам обоим...*»~ [IGN248]
@16210 = ~Оставить существо в покое.~
@16211 = ~~
@16212 = ~Осмотреть существо.~
@16213 = ~«Хм-м. Интересно, поможет ли тут Графин бесконечной воды?..»~
@16214 = ~Оставить существо в покое.~
@16215 = ~«Приветствую...»~
@16216 = ~«Хм-м. Интересно, поможет ли тут Графин бесконечной воды?..»~
@16217 = ~Оставить существо в покое.~
@16218 = ~«Какого черта?..»~
@16219 = ~Прикрыть уши, чтобы избавиться от звука.~
@16220 = ~Попытаться убраться из бара.~
@16221 = ~«Я *знаю* тебя...»~
@16222 = ~«Игнус...»~
@16223 = ~«Здравствуй, Игнус... Ты пойдешь со мной?»~
@16224 = ~«Что это за проект?»~
@16225 = ~Этот высокий и худощавый мужчина прочесывает взглядом землю под ногами. Время от времени он прерывается и становится на колени, будто пытается отыскать что-то в мусоре. Несмотря на свое необычное долговязое телосложение, он весьма шустрый и гибкий.~
@16226 = ~Когда ты обращаешься к нему, он оборачивается и пригибается... хотя ты и не можешь определить, собирается ли он прыгнуть на тебя или еще куда-нибудь. «Чего? Говори, только быстро...»~
@16227 = ~«Ответов у меня нету. Отвали!» Только сейчас ты не замечаешь, что в руке у него длинный изогнутый кинжал.~
@16228 = ~«Вот как? — он смотрит на тебя искоса, потом сплевывает на землю возле себя. — И откуда ж мне это знать, а?»~
@16229 = ~«Что именно ты не догнал, пень? Пф! А теперь слушай сюда внимательно: откуда мне знать, что ты пришел только 'задавать вопросы'. Что, если это вопросы, на которые я не хочу отвечать, а? Ты меня схватишь, пытать будешь? М-м?»~
@16230 = ~«Нет. Без шансов. Иди, надоедай кому-нибудь другому».~
@16231 = ~«А что? Крыс тебя напугал? Ты что, испугался, пень?»~
@16232 = ~«Хе-хе! Оно по тебе и видно. Ладно, чего ты от меня хочешь?»~
@16233 = ~«Ну, тогда сам виноват. Уйди и оставь меня в покое».~
@16234 = ~Когда ты отворачиваешься, чтоб уйти, он окликает тебя: «Эй! Погоди минутку...»~
@16235 = ~Он выпрямляется и достает оружие. «Кто тебя подослал? Зачем ты здесь?»~
@16236 = ~Он еще раз сплевывает. «Пф. Тогда исчезни».~
@16237 = ~«Хм-м...» Он глядит на тебя искоса, долго и напряженно. После неловкой паузы он произносит: «Хорошо. Чего ты от меня хотел?»~
@16238 = ~«Тогда вперед, задавай свои вопросы».~
@16239 = ~«Я Крыс. А ты кто такой?»~
@16240 = ~Он хмуро глядит на тебя. «Ну да, конечно».~
@16241 = ~Крыс ухмыляется. «Ну конечно, как это я не догадался. И от чего же это, а?»~
@16242 = ~Крыс поднимает брови. «Что, правда? Слишком странно, чтобы быть правдой... Хе. А что случилось? Кто-то врезал тебе по твоей раскромсанной черепушке?»~
@16243 = ~«О-о? Пф. Этот разговор мне сразу показался плохой идеей. Отвали. Больше нам не о чем говорить».~
@16244 = ~Он обрывает тебя на полуслове: «Нет! Не хочу даже слышать. Исчезни». Он отворачивается от тебя и снова начинает что-то искать.~
@16245 = ~«Хе! Ты что, пень, уже забыл? Крыс!»~
@16246 = ~«Ничто из того, что тебе следует знать».~
@16247 = ~«Нет, вообще-то я охо... — внезапно он запинается и подозрительно смотрит на тебя. — А *тебе* какое дело, а?»~
@16248 = ~«Хм. Ну, а я охочусь за черепными крысами».~
@16249 = ~«Не за простыми крысами, улавливаешь?.. За черепными. За них платят. Ты что, не знал? По монете за каждый принесенный хвост».~
@16250 = ~«А? Потому что они не обычные крысы; они намного опасней для всяких пней. Чем их больше собирается, тем они умней... настолько, что могут колдовать как маги. Улей — да что там, весь Сигил — и так опасен, без всех этих стай смышленых крысок, колдующих и снующих туда-сюда!»~
@16251 = ~«А что? Собираешься сам ловить крыс?»~
@16252 = ~«Только здесь этим не занимайся, пень! Они и так попадаются достаточно редко, чтобы еще один пень пришел сюда и рыскал по моим охотничьим угодьям».~
@16253 = ~«Не-а, на знаю. Может, слишком много на них охотились. Я не единственный крысолов в Сигиле, знаешь ли. Один я только здесь, на площади Старьевщиков».~
@16254 = ~«Хм, — он некоторое время недоверчиво глядит на тебя, затем вздыхает. — Не знаю даже, зачем я тебе все это рассказываю. Иди на восток с площади, потом на юг. Это будет на юге от рынка. Только не лови крыс здесь — их и так мало для одного крысолова!»~
@16255 = ~«Хм. Ну, за просто так я не стану все выкладывать. Сперва скажи, что ты здесь делаешь».~
@16256 = ~«А? Эй, брось ты это, пень, придумай что-нибудь получше. Ври, если нужно... да только уже не надо!» Он закатывает глаза, горько смеясь.~
@16257 = ~«Вот как, значит? Хм... — он наклоняется к тебе и понижает тон. — Он неподалеку, знаешь ли. Зачем ты его ищешь, а? Он тебе друг? Или враг?»~
@16258 = ~«Вот как? Что ж, ты оказался там, где надо. Все, что тебе нужно, — это продолжить смотреть по сторонам. Он довольно таки скрытный, но ты определенно найдешь его здесь, на площади Старьевщиков. Рано или поздно ты на него наткнешься».~
@16259 = ~«Разве? — Крыс внимательно на тебя смотрит. — Хм. Значит, хочешь на него работать? Не похоже, что ты для этого годишься. Ну, неважно... ты оказался там, где надо. Все, что тебе нужно, — это продолжить смотреть по сторонам. Он довольно таки скрытный, но ты определенно найдешь его здесь, на площади Старьевщиков. Рано или поздно ты на него наткнешься».~
@16260 = ~Он морщится, потом качает головой, хихикая. «Хе! Не стал бы рубака вроде тебя искать меня! Не уверен, что Фарод будет рад, если я расскажу такому, как ты, вояке, где он. Это может обернуться для Крыса неприятностями...»~
@16261 = ~«К черту все! Хе... Не спрашивай, почему, но я тебе верю, — он прерывается, чтобы плюнуть через плечо. — Не заставляй меня пожалеть об этом, пень! Все, что тебе нужно, — это продолжить смотреть по сторонам. Он довольно таки скрытный, но ты определенно найдешь его здесь, на площади Старьевщиков. Рано или поздно ты на него наткнешься».~
@16262 = ~Он с сожалением качает головой. «Прости, но этому не бывать. И все же он неподалеку. Рано или поздно ты сам его найдешь».~
@16263 = ~Он с презрением смотрит на тебя и плюет тебе под ноги. «Пф. И это после того, как ты дал слово не трогать меня. Этот разговор мне сразу показался плохой идеей. Отвали. Больше нам не о чем говорить».~
@16264 = ~Он раздраженно качает головой. «Разве мы это уже не проходили?  Все, что тебе нужно, — это продолжать искать его здесь. Он довольно таки скрытный, но ты определенно найдешь его здесь, на площади Старьевщиков... Иди и найди этого бедолагу, а то еще забудешь и снова будешь меня доставать этим!»~
@16265 = ~Крыс мрачнеет. «Как я уже говорил, я не стану тебе это рассказывать. Он довольно близко. Найди его сам».~
@16266 = ~«Если потерял его здесь, тогда удачи тебе в поисках во всем этом хламе. Уверен, что в этом я тебе не помощник».~
@16267 = ~«Что ты хочешь узнать? У Крыса, может, и найдется парочка ответов».~
@16268 = ~«Значит, работу? В Улье работы немного. По крайней мере, честной. Если отчаешься — можно стать сборщиком... Лично я бы просто поискал в другом районе. Лучше всего — в Нижнем».~
@16269 = ~«Это просто. Ты должен... хм, нет. По правде говоря, дорога, по которой я ходил туда, теперь вся перепутана... эти дабусы все там перекурочили. Теперь не знаю, как туда добраться».~
@16270 = ~«Ага. Сборщики приносят сигильских жмуриков... в основном, из Улья... в Морг. Трухлявые — тленные — платят за трупы. Заботятся, чтобы здесь не стало еще хуже».~
@16271 = ~«Ты что, правда такая бестолочь? Уу! Дабусы — это слуги Леди Боли, госпожи Сигила. Даже не думай спрашивать о ней: говорить о ней — дурной знак».~
@16272 = ~Крыс вскидывает руки, будто останавливая тебя: «Э, нет! Даже не думай об этом... не здесь, по крайней мере! Тут и для меня мало осталось; мне кажется, их почти всех уже выловили. Так что найди себе другое место, если хочешь заняться этим делом».~
@16273 = ~«Не знаю, что именно ты ищешь, но я бы искал где угодно, только не здесь. В этой части Сигила даже от 'дамочек' могут быть неприятности, если ты понимаешь, о чем я».~
@16274 = ~«Э... Тогда неважно».~
@16275 = ~«В общем-то — ни на что... просто здесь никогда не знаешь, с какой стороны придет беда. Так что просто почаще оглядывайся и подбирай слова, когда с кем-нибудь говоришь. Если будешь трясти черепушкой не с тем рубакой, можно мигом попасть в книгу мертвых... или чего хуже».~
@16276 = ~Он серьезно кивает. «Конечно. Только не говори, что не можешь придумать ничего хуже смерти...»~
@16277 = ~«Много на что. Скажу только, что есть тут кое-кто, на кого действительно стоит посмотреть... бродит по Улью такой себе мажор. С виду не скажешь, что он вояка, но парень — прирожденный воин. Точно, как Сигил круглый».~
@16278 = ~«Погоди, пень, я еще не закончил. Я собирался сказать: дело не столько в мажоре, сколько в грязном сборщике, который следует за ним по пятам, улавливаешь? Говорю тебе, этот сборщик делает с жертвами мажора нечто большее, чем просто таскает их в Морг».~
@16279 = ~«Ага, это которые носят сигильских мертвецов — в основном, из Улья — в Морг за звенелки».~
@16280 = ~«Хм... Слушай, я вижу, ты заинтересовался, и это не обычные слухи, если ты меня понял, — это страшная тайна. Прежде чем рассказать тебе остальное, я попрошу об услуге».~
@16281 = ~«Чудно, чудно. Я тут поспорил со своим дружбаном... по правде говоря, это вроде как соревнование. Все, что тебе нужно знать, так это то, что мне нужно как можно больше крысиных хвостов. И заметь, не обычных, а от черепных крыс... мозгогрызунов. Достань мне пять таких хвостов, и я расскажу тебе все о грязном сборщике и кровавом мажоре».~
@16282 = ~«Верно. Они не такие, как обычные крысы — они намного опасней для всяких там пней. Чем их больше собирается, тем они умней... даже могут устраивать засады и колдовать как маги. Просто поберегись, пока будешь добывать хвосты!»~
@16283 = ~«Ладно. Что-нибудь еще?»~
@16284 = ~«Как угодно. Ты знаешь, что мне принести, если хочешь узнать секрет этой парочки. Что-то еще от меня нужно?»~
@16285 = ~«Я не хочу тебя видеть. Больше ни слова тебе не скажу».~
@16286 = ~«Нет, пень, ты слишком далеко зашел. Ты врал и даже угрожал мне... отвали».~
@16287 = ~«Пф, — он задумывается на миг, потом плюет через плечо. — Хотел бы я иметь побольше вторых шансов. И тебе не откажу. Только на этот раз, пень, следи за своим языком...»~
@16288 = ~«Ну уж нет, пень, я тебе дал второй шанс. Отвали».~
@16289 = ~Когда ты подходишь, Крыс поднимает голову. «М-м?»~
@16290 = ~Когда ты подходишь, Крыс поднимает голову. «Рад встрече. Ну что, достал мне те хвосты?»~
@16291 = ~Он берет хвосты и бросает их в кожаный кошелек, при этом посмеиваясь. «Этого вполне хватит! Я многим тебе обязан».~
@16292 = ~«Конечно, конечно. Когда я впервые увидел того мажора, я подумал: что-то здесь не так. Одно дело — проводить дуэли в Улье, чтобы не привлекать внимания, но он здесь уже давно... даже ночует в Улье, а не катается на карете, или на чем там полагается ему кататься».~
@16293 = ~«Ага, внимания закона. Убийц милосердия и тому подобных. Они патрулируют улицы Сигила — по крайней мере, часть улиц — и сохраняют 'порядок', — он кривится. — Они держатся подальше от более бедных районов города, вроде Улья».~
@16294 = ~«Что ж, когда-то давно я поклялся больше не красть — не спрашивай, почему, — но это было уж слишком просто, слишком. Однажды поздно ночью, около антипика, я прокрался к заднему двору той вшивой гостиницы, где он обосновался, и угадай, кого я увидел в окне его комнаты? Того самого сборщика!»~
@16295 = ~«Это стало вдвойне подозрительнее. Любопытство старого Крыса взяло надо мной верх, и я стал следить за тем сборщиком. Он никогда не спит и не ест... когда мажор не занят делом, он просто сидит в самом темном переулке, который может найти, и смотрит в пустоту».~
@16296 = ~«А вот самое интересное. Однажды темной ночью, когда я лежал на крыше над переулком, где сидел сборщик, угадай, кто к нему пришел?»~
@16297 = ~«Нет! *Нечисть*!»~
@16298 = ~«Нечисть, вне всякого сомнения. Красивая, с крыльями, как у ангела, и губами, как... как... то есть, она была прекрасной. И все же она точно была нечистью — обольстительницей, баатезу, которых мы зовем эриниями там, откуда я родом».~
@16299 = ~«Я отдал бы почти все, лишь бы подслушать, о чем они там говорили, но на мою долю и так выпало немало бед, чтобы привлекать внимание нечисти. Все, что я знаю, так это что они немного поговорили, потом нечисть рассмеялась — грубо так, насмешливо — и ушла, а сборщик рычал и шипел ей вслед!»~
@16300 = ~«Хе! Ну так пойди и сам на них посмотри, если мне не веришь! Только не испытывай судьбу: тот мажор — серьезный вояка, и любой, кто устраивает с ним дуэль или надоедает сборщику, быстро попадает в книгу мертвых».~
@16301 = ~«Ничего ты не понял, бедолага ты пустоголовый! Никакой он не сборщик! Хе... если когда-нибудь будешь говорить с нечистым... только с баатезу, а не с одним из тех чокнутых танарри... почему бы тебе об этом не спросить? Никогда не знаешь, чего тут можно выяснить».~
@16302 = ~«Ничего ты не понял, бедолага ты пустоголовый! Никакой он не сборщик! Хе... если когда-нибудь будешь говорить с нечистым... только с баатезу, а не с одним из тех чокнутых... — он запинается, заметив Падшую Грацию. — Э, то есть, более своевольных танарри... почему бы тебе об этом не спросить? Никогда не знаешь, чего тут можно выяснить».~
@16303 = ~«Я уже говорил тебе, что мне нужно за тот секрет: пять крысиных хвостов.  И заметь, не обычных, а от черепных крыс... мозгогрызунов. Достань мне пять хвостов, и я расскажу тебе все о грязном сборщике и кровавом мажоре».~
@16304 = ~Когда ты подходишь, Крыс поднимает голову. «М-м?»~
@16305 = ~«Приветствую...»~
@16306 = ~Оставить его в покое.~
@16307 = ~«У меня есть несколько вопросов...» ~
@16308 = ~«Ничего, неважно. Прощай».~
@16309 = ~«С тебя не убудет, если поговоришь со мной...»~
@16310 = ~«Ты мне угрожаешь?»~
@16311 = ~«Прощай».~
@16312 = ~«Не понял».~
@16313 = ~«Тебе просто придется поверить мне».~
@16314 = ~«Неважно. Прощай».~
@16315 = ~«Просто поговори со мной. У меня всего лишь пара вопросов...»~
@16316 = ~Клятва: «Я не причиню тебе вреда. Даю тебе слово».~
@16317 = ~Ложь: «Я не причиню тебе вреда. Даю тебе слово».~
@16318 = ~«Забудь, что я спрашивал. Прощай».~
@16319 = ~Уйти.~
@16320 = ~«Нет».~
@16321 = ~«Да».~
@16322 = ~«Забудь. Прощай».~
@16323 = ~«Как я уже говорил, у меня есть вопросы...»~
@16324 = ~«Ничего, неважно. Прощай».~
@16325 = ~Уйти.~
@16326 = ~«Да?»~
@16327 = ~Игнорировать его и пройти мимо.~
@16328 = ~«Никто меня не подсылал. Я здесь по собственной воле».~
@16329 = ~«С чего ты взял, что меня кто-то подослал?»~
@16330 = ~«О чем это ты?»~
@16331 = ~«Это тебя не касается».~
@16332 = ~Уйти.~
@16333 = ~«Как я уже говорил, у меня есть вопросы...»~
@16334 = ~«Ничего, неважно. Прощай».~
@16335 = ~«Кто ты?»~
@16336 = ~«Еще раз, кто ты?»~
@16337 = ~«Что ты здесь делаешь?»~
@16338 = ~«Что ты можешь рассказать об этом месте?»~
@16339 = ~«Расскажи мне еще раз о сборщике и мажоре».~
@16340 = ~«Я ищу кое-кого по имени Фарод».~
@16341 = ~«Я ищу кое-кого по имени Фарод».~
@16342 = ~«Я ищу кое-кого по имени Фарод».~
@16343 = ~«Я ищу потерянный дневник».~
@16344 = ~«Неважно. Прощай».~
@16345 = ~Ложь: «Я, э... Адан».~
@16346 = ~«У меня нет имени».~
@16347 = ~«Я... не знаю». ~
@16348 = ~«Это тебя не касается».~
@16349 = ~«У меня есть другие вопросы...»~
@16350 = ~«Да, это я. Прощай».~
@16351 = ~Ложь: «Ладно... Я, э, Адан».~
@16352 = ~«Потому что я не могу вспомнить».~
@16353 = ~«Это тебя не касается».~
@16354 = ~«Что-то вроде того. У меня есть другие вопросы...»~
@16355 = ~«Это длинная история. Может, в другой раз. Прощай».~
@16356 = ~«У меня есть другие вопросы...»~
@16357 = ~«Тогда прощай». ~
@16358 = ~Уйти.~
@16359 = ~«У меня есть другие вопросы...»~
@16360 = ~«Это все, что я хотел узнать. Прощай».~
@16361 = ~«Похоже, ты что-то ищешь».~
@16362 = ~«Позволь мне спросить еще кое о чем...»~
@16363 = ~«Тогда прощай». ~
@16364 = ~«Мне просто любопытно».~
@16365 = ~Правда: «Мне интересно, могу ли я чем-то помочь».~
@16366 = ~Ложь: «Мне интересно, могу ли я чем-то помочь».~
@16367 = ~«Никакое. У меня еще вопросы...»~
@16368 = ~«Вообще-то, никакое. Прощай».~
@16369 = ~«Почему ты охотишься за крысами?»~
@16370 = ~«У меня есть другие вопросы...»~
@16371 = ~«Это все, что я хотел узнать. Прощай».~
@16372 = ~«Почему за них платят?»~
@16373 = ~«Куда ты относишь хвосты?»~
@16374 = ~«Интересно. У меня есть другие вопросы...»~
@16375 = ~«Это все, что я хотел узнать. Прощай».~
@16376 = ~«Куда ты относишь хвосты?»~
@16377 = ~«У меня есть другие вопросы...»~
@16378 = ~«Это все, что я хотел узнать. Прощай».~
@16379 = ~«Да».~
@16380 = ~«Может быть».~
@16381 = ~«Нет, мне просто любопытно».~
@16382 = ~«Значит, в последнее время они редко попадаются? Ты знаешь, почему?»~
@16383 = ~«Я тоже хотел бы знать».~
@16384 = ~«У меня есть другие вопросы...»~
@16385 = ~«Прощай».~
@16386 = ~«Интересно. У меня есть другие вопросы...»~
@16387 = ~«Это все, что я хотел узнать. Прощай».~
@16388 = ~«Разве? Не знаешь, почему?»~
@16389 = ~«Спасибо. У меня есть другие вопросы...»~
@16390 = ~«Спасибо, как-нибудь туда загляну. Прощай».~
@16391 = ~«Я разыскиваю человека по имени Фарод».~
@16392 = ~«Я ищу потерянный дневник».~
@16393 = ~«Я и сам не знаю. Просто брожу здесь».~
@16394 = ~«Не думаю, что это тебя касается».~
@16395 = ~«Забудь, что я спрашивал. Прощай».~
@16396 = ~«Я разыскиваю человека по имени Фарод».~
@16397 = ~«Я ищу потерянный дневник».~
@16398 = ~«Как я уже сказал, я просто брожу здесь».~
@16399 = ~Придумать что-нибудь.~
@16400 = ~«Забудь, что я спрашивал. Прощай».~
@16401 = ~«У него есть кое-какие нужные мне сведения».~
@16402 = ~Ложь: «Он мой друг».~
@16403 = ~Ложь: «Враг».~
@16404 = ~«Не думаю, что это тебя касается».~
@16405 = ~«Неважно. Прощай».~
@16406 = ~«Спасибо. У меня есть другие вопросы...»~
@16407 = ~«Тогда пойду, поищу его. Прощай».~
@16408 = ~«Спасибо. У меня есть другие вопросы...»~
@16409 = ~«Тогда пойду, поищу его. Прощай».~
@16410 = ~Клятва: «Клянусь, что не стану упоминать твое имя».~
@16411 = ~Клятва: «Клянусь, что не стану упоминать твое имя».~
@16412 = ~Ложь: «Клянусь, что не стану упоминать твое имя».~
@16413 = ~Правда: «Скажи, что тебе известно, или разделишь его участь».~
@16414 = ~Правда: «Скажи, что тебе известно, или разделишь его участь».~
