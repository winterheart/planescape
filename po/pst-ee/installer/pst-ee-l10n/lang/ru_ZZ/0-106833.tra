@38311 = ~«Что? Что ты знаешь о ней?»~
@38312 = ~«Ты можешь говорить?»~
@38313 = ~«Могу ли я спросить, почему ты не можешь говорить?»~
@38314 = ~«Тогда прощай» .~
@38315 = ~«Ты молчишь из-за того, что тебе разбили сердце?»~
@38316 = ~«Ты знаешь слово, которое погубит мультивселенную, если его произнести?»~
@38317 = ~«Твои чувства ранены? Из-за этого ты не разговариваешь?»~
