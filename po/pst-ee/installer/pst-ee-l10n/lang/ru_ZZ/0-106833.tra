@8812 = ~Глотка хаоса~
@8813 = ~Орудие Механуса~
@8814 = ~Убивающее слово силы~
@8815 = ~Последнее слово~
@8816 = ~Стигийская ледяная буря~
@8817 = ~Ярость Бездны~
@8818 = ~Буря цепных молний~
@8819 = ~Руна мучений~
@8820 = ~Благословение~
@8821 = ~Исцеление легких ран~
@8822 = ~Проклятие~
@8823 = ~Обнаружение зла~
@8824 = ~Ореол малого откровения~
@8825 = ~Помощь~
@8826 = ~Исцеление средних ран~
@8827 = ~Удержание человека~
@8828 = ~Духовный молот~
@8829 = ~Вызов молнии~
@8830 = ~Хождение по огню~
@8831 = ~Молитва~
@8832 = ~Разговор с мертвым~
@8833 = ~Желание прозреть~
@8834 = ~Исцеление серьезных ран~
@8835 = ~Исцеление критических ран~
@8836 = ~Лечение~
@8837 = ~«Неважно. Извини, что побеспокоил тебя».~
@8838 = ~«Похоже, тебе не очень-то по душе эти фракции».~
@8839 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8840 = ~«Неважно. Извини, что побеспокоил тебя».~
@8841 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8842 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8843 = ~«Что ты имеешь в виду?»~
@8844 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8845 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8846 = ~«Почему ты называешь этот город клеткой?»~
@8847 = ~«В другое место? Какое, например?»~
@8848 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8849 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8850 = ~«С закрытыми дверями?»~
@8851 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8852 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8853 = ~«Где находятся эти двери?»~
@8854 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8855 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8856 = ~«Не понимаю».~
@8857 = ~«В другое место? Какое, например?»~
@8858 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8859 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8860 = ~«Куда ведут те двери, о которых ты говоришь?»~
@8861 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8862 = ~«В таком случае, это неважно. Извини, что побеспокоил тебя».~
@8863 = ~«Не понимаю».~
@8864 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8865 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8866 = ~«Я ищу работу».~
@8867 = ~«Неважно. У меня есть другие... конкретные... вопросы о городе...»~
@8868 = ~«Неважно. Извини, что побеспокоил тебя».~
@8869 = ~«Награда за крыс?»~
@8870 = ~«Награда за крыс?»~
@8871 = ~«Собирать мертвецов?»~
@8872 = ~«Понятно. У меня есть другие... конкретные... вопросы о городе...»~
@8873 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8874 = ~«А что это за та работа, о которой ты говорил? Собирание мертвых?»~
@8875 = ~«А что это за та работа, о которой ты говорил? Собирание мертвых?»~
@8876 = ~«Понятно. У меня есть другие... конкретные... вопросы о городе...»~
