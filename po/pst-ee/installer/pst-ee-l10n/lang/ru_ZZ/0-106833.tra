@16018 = ~«У меня есть другие вопросы...»~
@16019 = ~«Это все, что я хотел узнать. Прощай».~
@16020 = ~«Кто создал этот кулон?»~
@16021 = ~«Как Йемет потерял кулон?»~
@16022 = ~«Кулон может увеличить чью-то силу?»~
