@33646 = ~«Тогда прощай». ~
@33647 = ~«Жестоко избив вас обоих, если придется».~
@33648 = ~«Жестоко избив вас обоих, если придется».~
@33649 = ~Клинковое оружие~
@33650 = ~«Жестоко избив вас обоих, если придется».~
@33651 = ~Молот~
@33652 = ~«Жестоко избив вас обоих, если придется».~
@33653 = ~Дубинка~
@33654 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33655 = ~Лук~
@33656 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33657 = ~законопослушно доброе

Законопослушно добрые персонажи твердо верят в порядок и улучшение жизни других. Однако смысл «улучшения жизни» может трактоваться по-разному.~
@33658 = ~«Да я и не собирался. Прощай».~
@33659 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33660 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33661 = ~«Отлично... Прощай».~
@33662 = ~«Прекратите драться, иначе я жестоко изобью вас обоих».~
@33663 = ~«Прекратите драться, иначе я жестоко изобью вас обоих».~
@33664 = ~«Прекратите драться, иначе я жестоко изобью вас обоих».~
@33665 = ~«Прекратите драться, иначе я жестоко изобью вас обоих».~
@33666 = ~«Отлично... Прощай».~
@33667 = ~«Рад, что ты подходишь к проблеме с этой стороны. Прощай».~
@33668 = ~«Рад, что ты подходишь к проблеме с этой стороны. Прощай».~
@33669 = ~«Спасибо. Прощай».~
@33670 = ~Ленивой походкой к тебе подходит крикливый и чумазый тип и коротко кивает. «Приветствую, рубака! Всего за один медяк ты можешь воспользоваться моими услугами осведомителя! Куда ты хочешь попасть?»~
@33671 = ~Крикливый и чумазый тип быстро замечает, что он привлек твое внимание. «Приятно увидеться, рубака! Всего за один медяк ты можешь воспользоваться моими услугами осведомителя! Куда ты хочешь попасть?»~
@33672 = ~Мужчина удивлено поднимает брови, а затем пожимает плечами. «Проводник, рубака... Я могу указать на места, которые ты хочешь найти в этой части Улья».~
@33673 = ~Мужчина сжимает монету и кивает «В этой части Улья есть ворота, ведущие на восток, север и юго-запад. Среди примечательных мест можно отметить ночлежку, где притомившийся знаток может немного отдохнуть».~
@33674 = ~«Прямо посреди этого района, рубака... длинное узкое здание со входом с юго-востока. Неплохая берлога на ночь, если ты измотан».~
@33675 = ~«Они ведут на площадь Старьевщиков, рубака... пристанище всех сборщиков».~
@33676 = ~«В другую часть Улья, рубака. Там находится Морг, а еще — Бар Собирателей Пыли, там обычно сидят тленные. Там же есть мавзолей и, конечно же, Мемориал тленных».~
@33677 = ~«В еще одну часть Улья, рубака. Там находится Управление по борьбе с вредителями и болезнями и большой рынок».~
@33678 = ~«Что за осведомитель?»~
@33679 = ~«Конечно... вот медяк».~
@33680 = ~«Больше ничего. Прощай».~
@33681 = ~«Что за осведомитель?»~
@33682 = ~«Конечно... вот медяк».~
@33683 = ~«Больше ничего. Прощай».~
@33684 = ~«Хорошо... вот медяк».~
@33685 = ~«Сейчас мне это не нужно, спасибо. Прощай».~
@33686 = ~«Где находится Ночлежка?»~
@33687 = ~«Куда ведут северные ворота?»~
@33688 = ~«Куда ведут восточные ворота?»~
@33689 = ~«Куда ведут юго-западные ворота?»~
@33690 = ~«Это все, что я хотел узнать. Прощай».~
