@13555 = ~«Если можно, я бы хотел на него взглянуть».~
@13556 = ~«Не совсем. Я хотел бы отменить этот контракт».~
@13557 = ~«Ты хранишь контракты здесь, в этом заведении?»~
@13558 = ~«Нет, не сейчас. У меня есть несколько вопросов...»~
@13559 = ~«Я просто проверяю, что это ты подписал с ним контракт. Забудь».~
@13560 = ~«Я хотел бы выкупить этот контракт».~
@13561 = ~«Этот контракт при тебе?»~
@13562 = ~«Могу ли я еще раз взглянуть на контракт Ангиара?»~
@13563 = ~«Ладно, неважно. У меня есть другие вопросы...»~
@13564 = ~«Я просто интересовался. Прощай».~
@13565 = ~«Контракт разрушает ему жизнь».~
@13566 = ~«Контракт разрушает ему жизнь. Из-за него он пришел в уныние... Скорее всего, из-за таких сильных переживаний он никогда не сможет достичь Истинной Смерти».~
@13567 = ~«Есть ли хоть какой-нибудь способ выкупить контракт у тебя?»~
@13568 = ~Блеф: «Советую тебе немедленно отдать контракт, или я прикончу тебя на месте».~
@13569 = ~Правда: «Советую тебе немедленно отдать контракт, или я прикончу тебя на месте».~
