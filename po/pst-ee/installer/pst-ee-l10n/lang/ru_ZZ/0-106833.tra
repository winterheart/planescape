@16071 = ~«Это все, что я хотел узнать на данный момент. Прощай».~
@16072 = ~«Так значит, кулон — это...»~
@16073 = ~Правда: «Интересная история. А теперь отдай безделушку или умри».~
@16074 = ~Блеф: «Интересная история. А теперь отдай безделушку или умри».~
@16075 = ~«Понятно. Однако, все же я вынужден забрать кулон».~
@16076 = ~«Этот кулон пока не имеет значения. У меня есть несколько вопросов...»~
@16077 = ~«Тогда пусть кулон побудет у тебя. Прощай».~
@16078 = ~«Почему это меня должно беспокоить?»~
@16079 = ~Атаковать его.~
@16080 = ~«Забудь, оставь кулон у себя. Прощай».~
@16081 = ~«Ты мне угрожаешь?»~
@16082 = ~«Нет, а какая вторая причина?»~
@16083 = ~«Ты блефуешь. Я знаю, что твое проклятие сделало тебя слабой».~
@16084 = ~Напасть на него, прежде чем он вымолвит хоть слово.~
@16085 = ~«Забудь, оставь кулон у себя. Прощай».~
@16086 = ~«Может, и будет. Мне обещали силу в обмен на него».~
@16087 = ~«А что ты тогда можешь предложить мне?»~
@16088 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16089 = ~«Забудь, оставь кулон у себя. Прощай».~
@16090 = ~«Парой демонов, но я не уверен, какого рода силу».~
@16091 = ~«Это тебя не касается».~
@16092 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
