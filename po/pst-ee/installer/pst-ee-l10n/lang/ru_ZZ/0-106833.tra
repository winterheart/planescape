@38357 = ~«Тогда мне лучше спросить кого-нибудь другого. Счастливо».~
@38358 = ~«Тогда я поищу что-нибудь, что вернет тебе голос. Прощай, Экко».~
@38359 = ~«Тогда договорились: я поищу что-нибудь, что вернет тебе голос. Прощай».~
@38360 = ~«У меня есть несколько вопросов...» ~
@38361 = ~«Экко, я просто проходил мимо. Прощай».~
@38362 = ~«Я достал для тебя язык нечистого...»~
@38363 = ~~
@38364 = ~«Я еще не нашел способ вернуть тебе голос. Вернусь, когда найду».~
@38365 = ~~
@38366 = ~~
@38367 = ~~
@38368 = ~«В таком случае, позволь мне спросить кое о чем еще...»~
@38369 = ~«Это все, что я хотел узнать. Прощай».~
@38370 = ~«У меня есть другие вопросы...»~
@38371 = ~«А теперь я должен идти, прощай».~
@38372 = ~«Мне сказали, что как только ты положишь его в рот, к тебе вернется способность разговаривать».~
@38373 = ~«Ты в порядке?»~
@38374 = ~Подождать, пока она ответит.~
@38375 = ~«А?»~
@38376 = ~«Должно быть... это из-за языка нечистого...»~
@38377 = ~«Я попытаюсь исправить это дело: возможно, у Вришики есть что-нибудь еще, что может помочь тебе. Прощай».~
@38378 = ~«Ну, теперь ты можешь говорить... вроде как... так где же моя награда?»~
@38379 = ~«Полагаю, я не получу вознаграждение, пока не доведу дело до конца. Я вернусь... быть может, у Вришики есть что-нибудь еще, что сможет тебе помочь. Прощай».~
@38380 = ~«Полагаю, я не получу вознаграждение, пока не доведу дело до конца. Я вернусь... быть может, у Вришики есть что-нибудь еще, что сможет тебе помочь. Прощай».~
@38381 = ~«Я принес тебе эти слезы дэва... они должны успокоить твой язык».~
@38382 = ~«Экко... Я нашел то, что тебе поможет... это слезы дэва из антикварного магазина Вришики. Вот только они недешевые...»~
@38383 = ~«Я пока что не нашел способа помочь тебе... Я вернусь, как только найду».~
@38384 = ~«Был рад помочь. Прощай, Экко».~
@38385 = ~«Был рад помочь. Прощай, Экко».~
@38386 = ~«Рад был помочь... вот только слезы дэва обошлись мне недешево...»~
@38387 = ~«Пожалуйста... и забудь о награде, Экко. Я рад, что смог тебе помочь».~
@38388 = ~«Пожалуйста... и забудь о награде, Экко. Я рад, что смог тебе помочь».~
@38389 = ~«Да не за что... как там на счет моей награды...»~
@38390 = ~«Да... этого будет достаточно. Я вернусь, когда раздобуду слезы, Экко».~
@38391 = ~«Прощай, Экко».~
@38392 = ~«Спасибо, Экко. Прощай».~
@38393 = ~«Спасибо, Экко. Прощай».~
@38394 = ~«Постой... этого достаточно для вознаграждения, но как на счет стоимости слез дэва? Знаешь ли, я заплатил за них девятьсот девяносто девять монет».~
@38395 = ~«Спасибо. Прощай».~
@38396 = ~«Спасибо. Прощай».~
@38397 = ~«Привет, Экко... У меня есть пара вопросов...»~
@38398 = ~«Рад встрече, Экко. Я просто проходил мимо. Прощай».~
@38399 = ~«У меня есть несколько вопросов...» ~
@38400 = ~«Я просто проходил мимо. Прощай, Экко».~
