@35730 = ~Элис~
@35731 = ~Заклинание не может быть произнесено [Dak'kon]~ [DAK052]
@35732 = ~Заклинание не может быть произнесено [Fall-From-Grace]~ [FFG283]
@35733 = ~Заклинание не может быть произнесено [Nordom]~
@35734 = ~Долговая расписка~
@35735 = ~Заклинание не может быть произнесено [Ignus]~ [IGN201]
