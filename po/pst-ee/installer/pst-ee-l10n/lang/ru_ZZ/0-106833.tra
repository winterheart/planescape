@35459 = ~Скелет не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35460 = ~Этот скелет довольно стар: кожаные ремешки потрескались и истерлись от времени. На лбу с особым искусством вырезано слово «ПОКАЙСЯ»; более грубая рука уже позднее высекла на обоих висках число «996».~
@35461 = ~«Прошу прощения, ты не видал поблизости других скелетов?»~
@35462 = ~Скелет не реагирует.~
@35463 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@35464 = ~«Хм-м. Интересно, что подумает этот седобородый, если *я* возьму взаймы его тело...»~
@35465 = ~«Седобородый?»~
@35466 = ~«Седобородый... ну знаешь, старикашка, старичье, рухлядь... старый».~
@35467 = ~«Ну, не думаю, что у него есть хоть один аргумент против. Почему бы и не взять его тело?»~
@35468 = ~Морт изучает скелет, но затем качает головой. «Не... Мне нужно что-нибудь посвежее. И что-нибудь чуть более величественней... а этот какой-то весь скрипучий и в трещинах».~
@35469 = ~«А ты, значит, нет?»~
@35470 = ~«Ох, да ты просто кладезь хохм, — Морт свирепо смотрит на тебя. — Да и вообще. НА СЕБЯ посмотри. Зеркала молят о пощаде, когда ты проходишь мимо них».~
@35471 = ~«Да? Зато у *меня* все при себе».~
@35472 = ~Морт фыркает. Тебе совершенно непонятно, как это ему удалось без легких.~
@35473 = ~«Позволь мне сказать, Морт. Нет ничего лучше, чем ходить, размахивать руками, вдыхать свежий воздух через полные легкие. Иметь тело — это ОЧЕНЬ приятно».~
@35474 = ~«Да будет тебе известно, что помощь тебе в побеге из препараторской только что добавлена в растущий список моих сожалений, — Морт снова фыркает. — Надо было оставить тебя там гнить... подольше, то есть».~
@35475 = ~«Очень приятно это слышать. Идем».~
@35476 = ~«Идем».~
@35477 = ~«Идем».~
@35478 = ~«Ладно. Идем».~
@35479 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@35480 = ~«Не думаю, что он имеет что-то против».~
@35481 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@35482 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@35483 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@35484 = ~«Прошу прощения, ты не видал поблизости других скелетов?»~
@35485 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать: не похоже, что у тебя есть что скрывать».~
@35486 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать: не похоже, что у тебя есть что скрывать».~
@35487 = ~Использовать на скелете свою способность «История костей».~
@35488 = ~Скелет не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35489 = ~Оставить скелет в покое.~
@35490 = ~Оставить скелет в покое.~
@35491 = ~Оставить скелет в покое.~
@35492 = ~Внимательно осмотреть скелет.~
@35493 = ~Кто-то позаботился о том, чтобы связать кости скелета кожаными ремнями, обвивающими тело на манер, напоминающий мускулы и сухожилия. Ремни привязаны к железными скобам, вбитым в суставы скелета. Кажется, этот скелет довольно долго служил: кости растрескались, многочисленные трещины на них залиты вонючим клеем.~
@35494 = ~Попробовать вытащить скобы из суставов скелета.~
@35495 = ~«Эй, шеф. Это уже вандализм. Эти скобы — возможно, единственное, что не дает рассыпаться этому мешку с костями. Знаешь, с такими приятелями некромантия чудес не творит».~
@35496 = ~«И что?»~
@35497 = ~«Да нет, ничего». Морт делает странный жест. Тебе это кажется похожим на пожимание плечами. «Просто не был уверен, что ты это знаешь. Валяй, можешь попробовать».~
@35498 = ~Попробовать вытащить скобы из суставов скелета.~
@35499 = ~Ты тянешь за железные скобы, но тебе не хватает сил, чтобы вытащить их. Они накрепко забиты.~
@35500 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хммм. Я еще вернусь, Костяшка».~
@35501 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хммм. Я еще вернусь, Костяшка».~
@35502 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хммм. Я еще вернусь, Костяшка».~
@35503 = ~Оставить скелет в покое.~
@35504 = ~Оставить скелет в покое.~
@35505 = ~Оставить скелет в покое.~
@35506 = ~Попробовать вытащить скобы из суставов скелета.~
@35507 = ~Ты тянешь за железные скобы изо всех сил, и через несколько мгновений вырываешь их из суставов. Скелет разваливается, некоторые из его костей продолжают шевелиться.~
@35508 = ~«Прости, Костяшка...»~
@35509 = ~Попробовать вытащить скобы из суставов скелета.~
@35510 = ~С помощью ломика ты вырываешь скобы из суставов. Скелет разваливается, хотя некоторые кости продолжают шевелиться.~
@35511 = ~«Прости, Костяшка...»~
@35512 = ~«Неважно, может быть, в другой раз».~
@35513 = ~«Неважно, может быть, в другой раз».~
@35514 = ~«О... Я не хотел ему навредить».~
@35515 = ~«Ну, тогда ладно. Может, в другой раз».~
@35516 = ~Попробовать вытащить скобы из суставов скелета.~
@35517 = ~Попробовать вытащить скобы из суставов скелета.~
@35518 = ~Попробовать вытащить скобы из суставов скелета.~
@35519 = ~«Не против, если я возьму немного ремешков и скоб?»~
@35520 = ~«Не против, если я возьму немного ремешков и скоб?»~
@35521 = ~«Не против, если я возьму немного ремешков и скоб?»~
@35522 = ~Оставить скелет в покое.~
@35523 = ~Оставить скелет в покое.~
@35524 = ~Оставить скелет в покое.~
@35525 = ~Попробовать вытащить скобы из суставов скелета.~
@35526 = ~Попробовать вытащить скобы из суставов скелета.~
@35527 = ~Попробовать вытащить скобы из суставов скелета.~
@35528 = ~Попробовать вытащить скобы из суставов скелета.~
@35529 = ~Попробовать вытащить скобы из суставов скелета.~
@35530 = ~Попробовать вытащить скобы из суставов скелета.~
@35531 = ~Попробовать вытащить скобы из суставов скелета.~
@35532 = ~«Как насчет этого скелета, Морт? Пойдет такое тело?»~
@35533 = ~Оставить скелет в покое.~
@35534 = ~Оставить скелет в покое.~
@35535 = ~Оставить скелет в покое.~
@35536 = ~Скелет не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35537 = ~Похоже, этот скелет попал в какой-то серьезный переплет: либо он участвовал в битве, либо упал через несколько лестничных пролетов. Обе руки и ноги переломаны и собраны вновь с помощью кожаных ремней и тонких железных реек. На лбу высечен номер «863»... но сзади череп имеет открытую пустую полость. ~
@35538 = ~«Извини, что забрал пергамент. Все равно ты вряд ли доставил бы его в ближайшее время».~
@35539 = ~Скелет не отвечает.~
