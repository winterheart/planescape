@24883 = ~«Буду знать. Я хочу задать ему другой вопрос...»~
@24884 = ~«Думаю, нашим путям суждено пересечься. Прощай».~
@24885 = ~«Что за татуировки?»~
@24886 = ~«Что за татуировки?»~
@24887 = ~«Что за татуировки?»~
@24888 = ~«Я хочу задать ему другой вопрос...»~
@24889 = ~«Это все, что я желал узнать. Прощай».~
@24890 = ~«Хорошо... Я хотел бы посмотреть на все татуировки, которые у него есть».~
@24891 = ~«Я хочу задать ему другой вопрос...»~
@24892 = ~«Это все, что я желал узнать. Прощай».~
@24893 = ~«Что он может рассказать о них?»~
@24894 = ~«Что он может рассказать о них?»~
@24895 = ~«Что он может рассказать о них?»~
@24896 = ~«Я хочу задать ему другой вопрос...»~
@24897 = ~«Это все, что я желал узнать. Прощай».~
@24898 = ~«Что это за символ на моем плече?»~
@24899 = ~«Что это за символ на моем плече?»~
@24900 = ~«Что это за символ на моем плече?»~
@24901 = ~«Я хочу задать ему другой вопрос...»~
@24902 = ~«Это все, что я желал узнать. Прощай».~
@24903 = ~«Эй, шеф... Ты в порядке? Я думал, что ты дал дуба».~
@24904 = ~«Чт?.. Ты кто?»~
@24905 = ~«Морт, я уверен, что у тебя найдется еще тысяча умных мыслей, но мне нужно, чтобы ты заткнулся и присоединился ко мне НЕМЕДЛЕННО».~
@24906 = ~«Э... кто я? А как насчет *тебя* для начала? Кто ты?»~
@24907 = ~«Я... не знаю. Не могу вспомнить».~
@24908 = ~«Я *первый* спросил тебя, череп».~
@24909 = ~«Ты не можешь вспомнить свое *имя*? Хе. Что ж, в следующий раз, когда будешь кутить ночью в городе, не налегай на выпивку. Зовут Мортом. Я тоже здесь заперт».~
@24910 = ~«Заперт?»~
@24911 = ~«Ага, а я спросил тебя *вторым*. Как твое имя?»~
@24912 = ~«Я... не знаю. Не могу вспомнить».~
@24913 = ~«Ты первый, череп. В последний раз спрашиваю».~
@24914 = ~«Пф-ф... да ты натянут как струна. Ну хорошо, пусть *я* буду хорошим парнем. Зовут Мортом. А кто ты?»~
@24915 = ~«Я... не знаю. Не могу вспомнить».~
@24916 = ~«Ага, и поскольку ты еще не успел размять ноги, вот тебе новость: я перепробовал все двери, и эта комната заперта крепче пояса целомудрия».~
@24917 = ~«Мы заперты... где? Что это за место?»~
@24918 = ~«Оно называется 'Моргом'... это такое большое черное здание с чарующей архитектурой беременной паучихи».~
@24919 = ~«Морг? Постой... я умер?»~
@24920 = ~«Не похоже. Хотя на тебе куча шрамов... выглядит так, словно какой-то пень изрисовал тебя всего ножом. Еще одна причина свалить отсюда побыстрее, пока тот, кто изрезал тебя, не вернулся назад и не завершил свою работу».~
@24921 = ~«И как мы выберемся отсюда?»~
@24922 = ~«Ну, если все двери заперты, значит, нам понадобится ключ. Есть шанс, что он есть у одного из ходячих трупов в этой комнате».~
@24923 = ~«Ходячих трупов?»~
@24924 = ~«Ага, хранители Морга используют мертвые тела в качестве дешевой рабочей силы. Трупы тупые как пробка, они безвредны и не будут атаковать до тех пор, пока ты не нападешь первым».~
@24925 = ~«А есть какой-нибудь другой способ? Я не хочу никого убивать из-за какого-то ключа».~
@24926 = ~«Так значит, я должен напасть на одного из этих трупов и забрать у него ключ?»~
@24927 = ~«Погоди, ты что, думаешь, что причинишь им боль? Они уже МЕРТВЫ. Но если тебе нужна мотивация, то пожалуйста: если ты убьешь их, то по крайней мере они отдохнут до того, как хранители поднимут их снова на работу».~
@24928 = ~«Ну хорошо... Я собью одного из них и заберу ключ».~
@24929 = ~«Хорошо, но перед этим неплохо бы вооружиться. Кажется, здесь где-то на полках есть скальпель».

^NПРИМЕЧАНИЕ: Обыщите полки в комнате, чтобы найти оружие, с которым можно напасть на зомби.^-~
@24930 = ~«Ладно, я поищу его».~
@24931 = ~«И последнее: эти трупы медлительны, но их удар — все равно что поцелуй тарана. Если они начнут доставать тебя, помни, что ты можешь БЕГАТЬ, а они — нет. Используй это, чтобы держаться на дистанции, если тебе нужно восстановиться».

^NПРИМЕЧАНИЕ: Если вы в опасности или при смерти, используйте бег, чтобы держать дистанцию с зомби, пока восстанавливаетесь.^-~
@24932 = ~«Хорошо. Спасибо за совет».~
@24933 = ~Я начал записывать происходящее со мной, чтобы прочистить голову, в надежде на то, что я смогу разобраться в том, что происходит. Я очнулся в месте под названием «Морг»... действительно похоже на морг. Я не знаю, кто я, что я здесь делаю и как я сюда попал. Первый, на кого я наткнулся, очнувшись, был тараторящий череп по имени Морт. Он сказал, что мы заперты и что у одного из ковыляющих по комнате трупов должен быть ключ. Он предложил мне поискать на полках скальпель, а потом тыкать им в мертвецов, пока те не «умрут».~
