@35093 = ~«Да-да-да, как пожелаешь. Если бы ты был настолько долго мертв, как я, ты бы улавливал сигналы. Для тебя они, наверно, слишком ТОНКИЕ, чтобы их уловить, но именно поэтому я буду проводить ночи напролет с сочной свежеумершей крошкой, а ты будешь бегать вокруг с воплями 'А?' 'Чего здесь творится?' 'Куда пропала моя па-па-память?'»~
@35094 = ~«Как знаешь, Морт. Идем».~
@35095 = ~«По-моему, тебе стоит время от времени отключать свое воображение».~
@35096 = ~«Как знаешь, Морт. Идем».~
@35097 = ~«Ты имеешь в виду этот бессмысленный пустой могильный взгляд?»~
@35098 = ~«Тогда прощай». ~
@35099 = ~«Тогда прощай». ~
@35100 = ~«Э... Красивая коса».~
@35101 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@35102 = ~Использовать на трупе свою способность «История костей».~
@35103 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35104 = ~«Тогда прощай». ~
@35105 = ~«Тогда прощай». ~
@35106 = ~«Тогда прощай». ~
@35107 = ~«Было приятно с тобой поболтать. Прощай».~
@35108 = ~Оставить труп в покое.~
@35109 = ~«Было приятно с тобой поболтать. Прощай».~
@35110 = ~Оставить труп в покое.~
@35111 = ~«Было приятно с тобой поболтать. Прощай».~
@35112 = ~Оставить труп в покое.~
@35113 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35114 = ~От этого трупа женщины истончается особенно сильный запах формальдегида... пахнет так, как будто ее обработали совсем недавно, и неспроста: труп находится на последней стадии разложения. У нее нет челюсти, часть мяса отвалилась от черепа, обнажая номер «1072», выбитый на кости.~
@35115 = ~«Кажется, у нее бывали деньки и получше...»~
@35116 = ~Труп не отвечает на твой голос. Возможно, это связано с отсутствием челюсти. Или ей просто нечего сказать.~
@35117 = ~«Тогда прощай». ~
@35118 = ~«Пссст. Видел, как она посмотрела на меня? А? Ты видел это? Как она огибала взглядом кривую моей затылочной кости?»~
@35119 = ~«О чем это ты *толкуешь*?»~
@35120 = ~«Чт... да ты что, ОСЛЕП?! Она меня изучала! Она бесстыдно меня ХОТЕЛА!»~
@35121 = ~«Скорее хотела, чтобы ты *исчез*. Да она была слишком занята МНОЙ, чтобы отвлекаться на какую-то болтающуюся голову с большим ртом».~
@35122 = ~«Тобой? Ага, конечно! Уж поверь мне, крошкам из могил нет дела до 'мускулатуры', 'у меня великолепное тело' и 'я весь в шрамах и круто выгляжу'. Им нужны парни с ДУШОЙ. Типа меня, шеф. А трупов вроде ТЕБЯ повсюду навалом, как грязи».~
@35123 = ~«Как знаешь, Морт. Идем».~
@35124 = ~«По-моему, у тебя слишком богатое воображение. Она зомби. Труп. Мертвая. Скорее всего, она тебя даже не заметила».~
@35125 = ~«Да-да-да, как пожелаешь. Если бы ты был настолько долго мертв, как я, ты бы улавливал сигналы. Для тебя они, наверно, слишком ТОНКИЕ, чтобы их уловить, но именно поэтому я буду проводить ночи напролет с сочной свежеумершей крошкой, а ты будешь бегать вокруг с воплями 'А?' 'Чего здесь творится?' 'Куда пропала моя па-па-память?'»~
@35126 = ~«Как знаешь, Морт. Идем».~
@35127 = ~«По-моему, тебе стоит время от времени отключать свое воображение».~
@35128 = ~«Как знаешь, Морт. Идем».~
@35129 = ~«Ты имеешь в виду этот бессмысленный пустой могильный взгляд?»~
@35130 = ~«Тогда прощай». ~
