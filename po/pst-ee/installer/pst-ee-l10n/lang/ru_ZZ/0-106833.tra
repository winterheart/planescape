@38531 = ~«Кругом одни ссклепы, и мы защищаем их обитателей... Я ничего тебе не сскажу».~
@38532 = ~«Для меня очень важно найти его».~
@38533 = ~Лидер упырей окидывает тебя холодным оценивающим взглядом. «Ищи на юго-восстоке. Не бесспокой других обитателей этих ссклепов, иначе *пожалеешшь*».~
@38534 = ~«Спасибо. У меня еще несколько вопросов...»~
@38535 = ~«Спасибо. Прощай».~
@38536 = ~«Для меня очень важно найти его».~
@38537 = ~Лидер упырей окидывает тебя взглядом, в ее глазах загорается пламя. «Мне вссе *РАВНО*, нассколько это для тебя важно, мяссная тварь. Я ничего тебе не *ССКАЖУ*».~
@38538 = ~«Ладно, ладно. Тогда ответь на еще на пару вопросов».~
@38539 = ~«Говори или умрешь».~
@38540 = ~«Что ж, спасибо за уделенное время. Прощай».~
@38541 = ~«Хорошо. Ответь тогда еще на пару моих вопросов...»~
@38542 = ~«Хорошо, тогда прощай».~
@38543 = ~«Я просто тут бродил».~
@38544 = ~«Это... плохое мессто для прогулок. Здессь много опассностей. Мы обозначили тотемами безопассные пределы... не перессекай их, и будешшь в безопассности. Опассайся здешшних обитателей — они смертельно опассны, и посстоянно прибавляют в чиссле».~
@38545 = ~«Что еще за обитатели?»~
@38546 = ~«Это мессто кишшит... трокопотоками, белыми рогатыми сущесствами с безмерными аппетитами и жесстоким нравом. Еще здессь поселилоссь много варгулий, и их количесство расстет за счет глупцов, которые забираютсся так далеко в катакомбы».~
@38547 = ~«Понятно... может, ответишь еще на пару вопросов?»~
@38548 = ~«Спасибо за совет. Прощай».~
@38549 = ~«Спасибо. У меня еще несколько вопросов...»~
@38550 = ~«Спасибо. Прощай».~
@38551 = ~«Я не знаю». ~
@38552 = ~«Не знаешшь? Не знаешшь? Пожалуй... тебе лучшше уйти. Это мессто... опассно... для мяссных тварей».~
@38553 = ~«Опасно? Чем опасно?»~
@38554 = ~«У меня всего лишь несколько вопросов...»~
@38555 = ~«Спасибо. Прощай».~
@38556 = ~«Я ищу бронзовый шар».~
@38557 = ~«Я ищу графин с водой».~
@38558 = ~«Я ищу склеп, в котором много ловушек».~
@38559 = ~«Забудь. Прощай».~
@38560 = ~«Спасибо. Прощай».~
@38561 = ~«Я ищу графин с водой».~
@38562 = ~«Я ищу склеп, в котором много ловушек».~
@38563 = ~«Я просто тут бродил».~
@38564 = ~«Я не знаю». ~
@38565 = ~«Что это за место?»~
@38566 = ~«Нет, спасибо. Прощай».~
@38567 = ~«Ты вернулсся, да? Чего ты хочешшь?»~
@38568 = ~«Я хотел задать пару вопросов...»~
@38569 = ~«Ничего. Прощай».~
@38570 = ~Очки:~
@38571 = ~Скрытность:~
@38572 = ~Обнаружение ловушек:~
@38573 = ~«Сссс... мясссная тварь... трокопотока не пуссскает нас к сокровищами, да? Троко должен сссдохнуть. Тебе — сокровища, нам — тело. Ладно?»~
@38574 = ~Воровство:~
@38575 = ~Взлом:~
@38576 = ~СПАСБРОСКИ~
@38577 = ~от смерти:~
@38578 = ~от жезлов:~
@38579 = ~от полиморфизма:~
@38580 = ~от атак дыханием:~
@38581 = ~от заклинаний:~
@38582 = ~Класс брони:~
@38583 = ~Текущие очки жизни:~
@38584 = ~Максимальные очки жизни:~
@38585 = ~Текущие задания~
@38586 = ~Здесь слишком опасно, чтобы отдыхать.~
@38587 = ~Ты должен получить разрешение, чтобы отдыхать здесь.~
@38588 = ~«Что это за существо?»~
@38589 = ~«Конечно».~
@38590 = ~«Я так не думаю».~
@38591 = ~«Что с твоим другом?»~
@38592 = ~«Это трокопотока. Белый. Ссс рогами. Грязный. Троко ессст мясссо. Нашшш враг. Убей его, ладно?»~
@38593 = ~«Что с твоим другом?»~
@38594 = ~«Я убью его».~
@38595 = ~«Сам этим занимайся».~
@38596 = ~«Да... хорошо. Ты берешшшь сокровища на трупе. Мы берем мясссо. Давай! Прикончи его!»~
@38597 = ~«Я пошел».~
@38598 = ~«Ссссс... бесссполезная мясссная тварь. Убирайся!»~
@38599 = ~«Хорошо».~
@38600 = ~«Ха-ха... да он труссс. Испугалссся троко. Ха-ха. Убей его для нассс, ладно?»~
@38601 = ~«Так что же это такое?»~
@38602 = ~«Хорошо. Я убью его».~
@38603 = ~«Нет, я так не думаю».~
@38604 = ~«Ха-ха... да он труссс. Испугалссся троко. Ха-ха. Убей его для нассс, ладно?»~
@38605 = ~«Тогда я пошел».~
@38606 = ~«Он мертв... из-за тебя! Он мертв! Умри, мясссо!» Упырь нападает на тебя!~
@38607 = ~Сражаться.~
@38608 = ~Сбежать.~
@38609 = ~«Он мертв... из-за тебя! Он мертв! Умри, мясссо!» Упырь нападает на тебя!~
@38610 = ~Сражаться.~
@38611 = ~Сбежать.~
@38612 = ~«Сссс... троко мертв... ты берешшшь сокровище, мы — мяссссо, ладно?»~
@38613 = ~«Что это за тварь?»~
@38614 = ~«По рукам».~
@38615 = ~«Нет, сперва ты умрешь».~
@38616 = ~«Это трокопотока. Белый. Ссс рогами. Грязный. Троко ессст мясссо. Нашшш враг. Невкусссный. Теперь мертвый. Спассссибо, мясссная тварь».~
@38617 = ~«Не за что. Прощай».~
@38618 = ~«Тогда забирай и уходи... нам нужно есссть».~
@38619 = ~«Прощай».~
@38620 = ~«Снова вернулась, мясссная тварь? Забирай ссвои монеты и уходи».~
@38621 = ~«Отлично. Прощай».~
@38622 = ~«Убей для нассс троко, да, и забирай его деньги. Нам доссстанется его еда. Нравитсся, а?»~
@38623 = ~«Что это за существо?»~
@38624 = ~«Трокопотока? Нравитссся? А нам — нет... ссстрашный и злой зверь. Мы им не нравимсся. Этот... охраняет труп, который нам нужен. Убьешшшь его?»~
@38625 = ~«Что с твоим другом?»~
@38626 = ~«Не друг! Хвассстун! Хвассстливый упырь! Ничего не боюсссь, говорит! Видел, чтобы он подходил к троко? Нет! Он труссс! Убей троко и покажи, кто тут сссмелый!»~
@38627 = ~«Так что же это такое?»~
@38628 = ~«Хорошо, я убью его».~
@38629 = ~«Ссссс... бесссполезное мясо! Уходи!»~
@38630 = ~«Хорошо».~
@38631 = ~«Нет, я так не думаю».~
@38632 = ~«Я убью его».~
@38633 = ~«Ссспасибо... заберешшшь деньги, когда он умрет».~
@38634 = ~«Вот это — план».~
@38635 = ~«Сам этим занимайся».~
@38636 = ~«Конечно».~
@38637 = ~«Я так не думаю».~
@38638 = ~«Что с твоим другом?»~
@38639 = ~«Почему не убиваешшшь троко? Троко должен сссдохнуть! Убей его!»~
@38640 = ~«Тогда я пошел».~
@38641 = ~«Зачем... зачем ты вернулосссь, глупое мясссо? Умри-и-и!» Жуткая тварь накидывается на тебя!~
@38642 = ~Сражаться.~
@38643 = ~Сбежать.~
@38644 = ~«Зачем... зачем ты вернулосссь, глупое мясссо? Умри-и-и!» Жуткая тварь накидывается на тебя!~
@38645 = ~Сражаться.~
@38646 = ~Сбежать.~
@38647 = ~«Ты за своим сссокровищем, да? Забирай и уходи, мясссная тварь».~
@38648 = ~«Что это за тварь?»~
@38649 = ~«Трокопотока? Нравитссся? А нам — нет... ссстрашный и злой зверь. Мы им не нравимссся. Он уже мертвый, да?»~
@38650 = ~«Не за что. Прощай».~
@38651 = ~«По рукам».~
@38652 = ~«Нет, сперва ты умрешь».~
@38653 = ~«Тогда забирай и уходи... нам нужно есссть».~
@38654 = ~«Прощай».~
@38655 = ~«Кто вы?»~
@38656 = ~«Кто вы?»~
@38657 = ~«Кто вы?»~
@38658 = ~«Что это за место?»~
@38659 = ~«Что это за место?»~
@38660 = ~«Что это за место?»~
@38661 = ~«Что это за место?»~
@38662 = ~«Я подумал, что вам было бы интересно узнать, Безмолвный король — всего лишь мертвый скелет. Он бессилен».~
@38663 = ~«Я подумал, что вам было бы интересно узнать, Безмолвный король — всего лишь мертвый скелет. Он бессилен».~
@38664 = ~Блеф: «Я подумал, что вам было бы интересно узнать, что Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе трупы уничтожат вас».~
@38665 = ~«Я пришел увидеться с тобой, Многоединый».~
@38666 = ~«Я попал сюда случайно».~
@38667 = ~«Если вы можете читать мои мысли, зачем мне рассказывать о моих целях?»~
@38668 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ЧТО ТЫ ДЕЛАЕШЬ ЗДЕСЬ, ТАК ДАЛЕКО ОТ СВЕТЛЫХ ЛЮДСКИХ КОРИДОРОВ?»~
@38669 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ЧТО ТЫ ДЕЛАЕШЬ ЗДЕСЬ, ТАК ДАЛЕКО ОТ СВЕТЛЫХ ЛЮДСКИХ КОРИДОРОВ?»~
@38670 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ЧТО ТЫ ДЕЛАЕШЬ ЗДЕСЬ, ТАК ДАЛЕКО ОТ СВЕТЛЫХ ЛЮДСКИХ КОРИДОРОВ?»~
@38671 = ~«МЫ ГЛАЗА В ТЕМНОТЕ. МЫ МНОЖЕСТВО, МЫСЛЯЩЕЕ КАК ОДИН. МЫ НЕ ОТВЕЧАЕМ НА ТВОИ ВОПРОСЫ. ТЫ ОТВЕТИШЬ НА НАШИ. ГОВОРИ, ЧТО У ТЕБЯ НА УМЕ, И ПОМНИ, ЧТО МЫ СЛЫШИМ, КОГДА ТЫ ЛЖЕШЬ. ЧТО ТЫ ДЕЛАЕШЬ ЗДЕСЬ, ТАК ДАЛЕКО ОТ СВЕТЛЫХ ЛЮДСКИХ КОРИДОРОВ?»~
@38672 = ~«Я подумал, что вам было бы интересно узнать, Безмолвный король — всего лишь мертвый скелет. Он бессилен».~
@38673 = ~«Я подумал, что вам было бы интересно узнать, Безмолвный король — всего лишь мертвый скелет. Он бессилен».~
@38674 = ~Блеф: «Я подумал, что вам будет интересно узнать, что Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе трупы уничтожат вас».~
@38675 = ~«Я пришел увидеться с тобой, Многоединый».~
@38676 = ~«Я попал сюда случайно».~
@38677 = ~«Если вы можете читать мои мысли, зачем мне рассказывать о моих целях?»~
@38678 = ~Голоса в твоей голове, хотя они и беззвучны, звучат просто оглушительно: «МЫ ПРИКАЗЫВАЕМ ТЕМ, КТО С ТОБОЙ, ЗАМОЛКНУТЬ. ТЫ В ЛОГОВЕ МЫСЛИ, ГДЕ ПРАВИТ МНОГОЕДИНЫЙ. ГОВОРИ, ЧТО У ТЕБЯ НА УМЕ, И ПОМНИ, ЧТО МЫ СЛЫШИМ ТВОЮ ЛОЖЬ. ЧЕГО ТЕБЕ НУЖНО В ЭТИХ ТЕМНЫХ ТОННЕЛЯХ?»~
@38679 = ~«Я подумал, что вам будет интересно узнать, что Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@38680 = ~«Я подумал, что вам было бы интересно узнать, Безмолвный король — всего лишь мертвый скелет. Он бессилен».~
@38681 = ~Блеф: «Я подумал, что вам будет интересно узнать, что Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе трупы уничтожат вас».~
@38682 = ~«Я пришел увидеться с тобой, Многоединый».~
@38683 = ~«Я попал сюда случайно».~
@38684 = ~«Если вы можете читать мои мысли, зачем мне рассказывать о моих целях?»~
@38685 = ~«СЧИТАЙ, ЧТО МЕРТВЕЦЫ УЖЕ МЕРТВЫ. ИХ БЕСПОМОЩНЫЙ КОРОЛЬ БОЛЬШЕ НЕ СТОИТ У НАС НА ПУТИ. ТЫ ОКАЗАЛСЯ ПОЛЕЗНЫМ. ЗА ЭТИ СВЕДЕНИЯ МЫ РАЗРУШИМ ПРЕГРАДЫ В ТВОЕМ РАЗУМЕ И РАСКРОЕМ ТЕБЯ СЕБЕ САМОГО. ПРИГОТОВЬСЯ К ОТКРОВЕНИЮ».~
@38686 = ~«Подождите! Не сейчас!»~
@38687 = ~«Я готов».~
@38688 = ~~
@38689 = ~~
@38690 = ~«ТЫ ОСМЕЛИЛСЯ ПОКАЗАТЬСЯ ЗДЕСЬ СНОВА? ДВУНОГИЙ, ТЫ БЕЗРАССУДЕН. ГОТОВЬСЯ».~
@38691 = ~Сражаться.~
@38692 = ~«РАССКАЖИ НАМ, ЧТО ТЫ ЗНАЕШЬ, ДВУНОГИЙ».~
@38693 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@38694 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@38695 = ~Блеф: «Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе трупы уничтожат вас».~
@38696 = ~«Пока мне нечего сказать».~
@38697 = ~«УПЫРИ СЛИШКОМ СИЛЬНЫ, ДАЖЕ ДЛЯ МОИХ СЛУГ-КРЫСООБОРОТНЕЙ. ТВОЯ МИССИЯ ПРОВАЛЕНА. ТВОИ УСЛУГИ БОЛЬШЕ НЕ НУЖНЫ. УХОДИ СЕЙЧАС ЖЕ, ИЛИ ПОСТРАДАЕШЬ».~
@38698 = ~«И что, вы хотите вот просто так от меня избавиться?»~
@38699 = ~«Тогда прощайте». ~
@38700 = ~Перед тобой тощий мужчина в рваной одежде, с носом крючком и двумя обломанными рогами, выступающими изо лба. Он шатается из стороны в сторону, что-то бормоча себе под нос... от него воняет рассолом, блевотиной и дешевым вином.[Be sure to put in placeholder 2]~
@38701 = ~«Приветствую».~
@38702 = ~«Ты ведь Джелай? Если да, то Крэддок хочет, чтобы ты вернулся назад на рынок».~
@38703 = ~Пройти мимо.~
@38704 = ~«А?» Мужчина рассеянно на тебя косится. «Что надо?»~
@38705 = ~«Ты ведь Джелай? Если да, то Крэддок хочет, чтобы ты вернулся назад на рынок».~
@38706 = ~«Неважно. Извини за беспокойство».~
