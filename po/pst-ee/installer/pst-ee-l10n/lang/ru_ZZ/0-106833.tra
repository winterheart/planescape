@25492 = ~Этот мужчина облачен в грязную рваную бурую мантию. Его лицо скрыто длинным капюшоном.~
@25493 = ~«Приветствую...»~
@25494 = ~Его глаза, скрытые капюшоном, сужаются, он делает шаг назад. «Чего надо?»~
@25495 = ~«Чем ты занимаешься?»~
@25496 = ~«Ищу эти чертовы тела — вот чем я занимаюсь. Только похоже, что силы смерти сложили свои манатки и свалили с планов, а люди без них не мрут и все такое, — его глаза внезапно сверкают. — А вот в прошлом месяце была чума, славное было время... вонь от трупов до самых небес, а еще много звенелок».~
@25497 = ~«Зачем ты ищешь тела?»~
@25498 = ~Он удивлен. «Ну, тащишь этих паршивцев в Морг. Там болтаешь с трухлявыми, торгуешься немного, а потом получаешь немного звенелок».~
@25499 = ~«А почему тленные покупают мертвецов?»~
@25500 = ~«Они собирают мертвых... это их работа. Они платят нам за то, что мы прочесываем улицы и привозим им все найденные тела. Потом они следят за тем, чтобы тело чувака было похоронено или сожжено. Для них это все серьезно — это все их чокнутая философия, но для меня это просто еще немного звенелок». Он подмигивает.~
@25501 = ~«Что это за место?»~
@25502 = ~Он хмурится «Ты, как пить дать, в Улье. Откуда ты, рубака? С Первичного, что ли?»~
@25503 = ~«Нет. Для чего ты ищешь тела?»~
@25504 = ~«Нет. У меня есть вопросы...»~
@25505 = ~Он вскидывает бровь. «Тогда вот что: скажи-ка, чего ты там хотел узнать и насколько сильно?»~
@25506 = ~«О чем это ты?»~
@25507 = ~«Оглянись, рубака... Я получаю не так много звенелок, чтобы просвещать кого-то за просто так. Хочешь поболтать — гони монету».~
@25508 = ~Дать ему пару монет.~
@25509 = ~Он фыркает. «Даже трухлявые платят больше тебя, рубака. Должно быть, ты и знать ничего не хочешь».~
@25510 = ~Бросить ему пять медяков.~
@25511 = ~Он рассматривает монеты, лежащие у него в руке. «Э-э, — он ловко прячет их в карман. — Спрашивай».~
@25512 = ~«Расскажи мне о сборщиках».~
@25513 = ~«Я... мы... зарабатываем на жизнь, убирая жмуриков с улиц Сигила и оттаскивая их жирные тушки в Морг. Не самый лучший способ сводить концы с концами, но только поначалу. Это все, что ты хотел узнать, рубака?» Он странно на тебя смотрит.~
@25514 = ~«Я разыскиваю мужчину по имени Фарод».~
@25515 = ~Внезапно он сужает глаза. «Фарод... а что насчет него?»~
@25516 = ~«Ты как-то насторожился... почему?»~
@25517 = ~«Фарод, тьфу! — он сплевывает, презрительно усмехнувшись. — Понимаешь, площадь Старьевщиков — это территория Могильника, моего босса. Фарод и его псы пытались нас оттуда выгнать. Мы их победили, и теперь они где-то прячутся. Иногда мы ловим на площади кого-нибудь из его дружков. Обычно мы превращаем бедолагу в быстрый способ получить звенелки в Морге. Чертовы неудачники».~
@25518 = ~«Расскажи мне о Могильнике».~
@25519 = ~«Он мой босс... покрывает тенью все делишки сборщиков. Я бы на твоем месте держался от него подальше, разве что ты *в самом деле* хочешь с ним поговорить... Я сам его ни разу не видел».~
@25520 = ~«Ты знаешь, где находится Фарод?»~
@25521 = ~«Я знаю, где этой крысы нет... его нет там, где тусуются все сборщики — на площади Старьевщиков, но говорят, что он где-то совсем рядом».~
@25522 = ~«А другие сборщики так же думают о Фароде?»~
@25523 = ~«Расскажи мне о сборщиках».~
@25524 = ~«Еще я ищу потерянный дневник».~
@25525 = ~Он недоуменно качает головой.~
@25526 = ~«Расскажи мне о сборщиках».~
@25527 = ~«Еще я разыскиваю мужчину по имени Фарод».~
@25528 = ~«Ты знаешь что-нибудь о Меббет?»~
@25529 = ~«Повивальная бабка? Добрая женщина, дело говорю. Помогает, если вдруг прихвораешь или типа того. Если хочешь ее повидать, то она живет в лачуге наверху».~
@25530 = ~«Расскажи мне о сборщиках».~
@25531 = ~«Я разыскиваю мужчину по имени Фарод».~
@25532 = ~«Я ищу потерянный дневник».~
@25533 = ~«Это все, что я хотел узнать. Прощай».~
@25534 = ~«Береги себя, рубака. Если найду твой труп на улице — буду обращаться с ним бережно».~
@25535 = ~Уйти.~
@25536 = ~«Тогда прощай». ~
@25537 = ~«Ты знаешь что-нибудь о Меббет?»~
@25538 = ~«Это все, что я хотел узнать. Прощай».~
@25539 = ~«Расскажи мне о сборщиках».~
@25540 = ~«Еще я ищу потерянный дневник».~
@25541 = ~«Ты знаешь что-нибудь о Меббет?»~
@25542 = ~«Это все, что я хотел узнать. Прощай».~
@25543 = ~«Ты знаешь, где находится Фарод?»~
@25544 = ~«Расскажи мне о сборщиках».~
@25545 = ~«Еще я ищу потерянный дневник».~
@25546 = ~«Ты знаешь что-нибудь о Меббет?»~
@25547 = ~«Это все, что я хотел узнать. Прощай».~
@25548 = ~«Ты знаешь, где он находится?»~
@25549 = ~«Расскажи мне о сборщиках».~
@25550 = ~«Еще я ищу потерянный дневник».~
@25551 = ~«Ты знаешь что-нибудь о Меббет?»~
@25552 = ~«Это все, что я хотел узнать. Прощай».~
@25553 = ~«Я ищу потерянный дневник».~
@25554 = ~«Ты знаешь что-нибудь о Меббет?»~
@25555 = ~«Это все, что я хотел узнать. Прощай».~
@25556 = ~«Я разыскиваю мужчину по имени Фарод».~
@25557 = ~«Я ищу потерянный дневник».~
@25558 = ~«Ты знаешь что-нибудь о Меббет?»~
@25559 = ~«Неважно. Прощай».~
@25560 = ~Бросить десять медяков в его ладонь.~
@25561 = ~«Задавай свои вопросы. Не скажу, что все знаю, но попробую ответить».~
@25562 = ~«Расскажи мне о сборщиках».~
@25563 = ~«Я разыскиваю мужчину по имени Фарод».~
@25564 = ~«Я ищу потерянный дневник».~
@25565 = ~«Ты знаешь что-нибудь о Меббет?»~
@25566 = ~«Неважно. Прощай».~
@25567 = ~«Ты ничего не получишь, и все равно ответишь на мои вопросы».~
@25568 = ~«Я ничего не знаю, вояка, и советую поискать ответы где-нибудь еще».~
@25569 = ~Схватить его и встряхнуть.~
@25570 = ~Дать ему пару монет.~
@25571 = ~Бросить ему пять медяков.~
@25572 = ~Бросить десять медяков в его ладонь.~
@25573 = ~«Тогда неважно. Прощай».~
@25574 = ~«Тогда неважно. Прощай».~
@25575 = ~Бросить ему пять медяков.~
@25576 = ~Бросить десять медяков в его ладонь.~
@25577 = ~«Ты ничего не получишь, и все равно ответишь на мои вопросы».~
@25578 = ~«Тогда неважно. Прощай».~
@25579 = ~«Расскажи мне о сборщиках».~
@25580 = ~«Я разыскиваю мужчину по имени Фарод».~
@25581 = ~«Я ищу потерянный дневник».~
@25582 = ~«Ты знаешь что-нибудь о Меббет?»~
@25583 = ~«Неважно. Прощай».~
@25584 = ~«Нет. Это все, что я хотел узнать. Прощай».~
@25585 = ~«У меня есть несколько вопросов...» ~
@25586 = ~«Это все, что я хотел узнать. Прощай».~
@25587 = ~«Что это за место?»~
@25588 = ~«У меня есть несколько вопросов...» ~
@25589 = ~«Это все, что я хотел узнать. Прощай».~
@25590 = ~«Что это за место?»~
@25591 = ~«У меня есть несколько вопросов...» ~
@25592 = ~«Это все, что я хотел узнать. Прощай».~
@25593 = ~«Что это за место?»~
@25594 = ~«У меня есть несколько вопросов...» ~
@25595 = ~«Ничего. Прощай».~
@25596 = ~Оставить его в покое.~
@25597 = ~Мужчина отступает назад, подозрительно оглядывая тебя из глубины своего капюшона. «Опять? Чего тебе надо?»~
@25598 = ~«Чем ты занимаешься?»~
@25599 = ~«Что это за место?»~
@25600 = ~«У меня есть несколько вопросов...» ~
@25601 = ~«Ничего. Прощай».~
@25602 = ~Люк, ведущий в Погребенную деревню~
@25603 = ~Лестница, ведущая из Погребенной деревни~
@25604 = ~Дом Марты-швеи~
@25605 = ~Ворота в Катакомбы плачущих камней~
@25606 = ~Дом Охо-болвана~
@25607 = ~Вход во двор Фарода~
@25608 = ~Портал в убежище Фарода~
@25609 = ~В Склеп объятий~
@25610 = ~В Разрушенный склеп~
@25611 = ~В Логово Мысли~
@25612 = ~В катакомбы Затопленных Народов~
@25613 = ~В Мозаичный склеп~
@25614 = ~В Разделенный склеп~
@25615 = ~Назад в Катакомбы плачущих камней~
@25616 = ~Люк, ведущий в подвал~
@25617 = ~Лестница, ведущая на верхний уровень Разделенного склепа~
@25618 = ~В катакомбы Затопленных Народов~
@25619 = ~Покои Тухлой Мери~
@25620 = ~Затененный альков~
@25621 = ~Часовня~
@25622 = ~Покои Соэго~
@25623 = ~Передняя тронного зала Безмолвного Короля.~
@25624 = ~К коллективу черепных крыс~
@25625 = ~Назад в Логово Мысли~
@25626 = ~Назад в катакомбы Мертвых Народов~
@25627 = ~Запечатанный проход~
@25628 = ~«ВЗЯТЬ ЕГО!»~
@25629 = ~Портной~
@25630 = ~Бордель утоления интеллектуальной страсти~
@25631 = ~К Подсигилью~
@25632 = ~Ты видишь гибрид человека и крысы. В его красных глазах виден коварный блеск. Из его пасти доносится вкрадчивый голос: «Итак, двуногий добровольно пришел в залы Многоединого. Чего же ты хочешь, человек, и куда ты собрался идти? Подойди и скажи Мантуоку правду».~
@25633 = ~Дом адвоката~
@25634 = ~«Нет, двуногий, ты не уходишь. А теперь ответь на мой вопрос: чего ты хочешь и куда направляешься?»~
@25635 = ~Художественная галерея~
@25636 = ~Антикварная лавка~
@25637 = ~«Ах, деревня. Напомни мне... мусорщики, да? Пришел порыться в мусоре?»~
@25638 = ~«Значит, ничего ценного, двуногий? Единственное испражнение, которое я вижу здесь — это ТЫ. Однако, боюсь, придется нам привыкнуть к этой вони: ты больше никогда не увидишь дневной свет».~
@25639 = ~«Тогда твой ответ вынуждает Мантуока спросить: зачем ты здесь? Неправильный поворот, неверный шаг, стечение обстоятельств, так? Ты искал меня или Многоединого? Или, может, ты просто не знаешь, почему ты здесь? Объясни мне это сейчас же».~
@25640 = ~«Значит, стечение обстоятельств? Для тебя все сложилось бы намного лучше, если бы ты не совершил ошибку и не пришел сюда».~
@25641 = ~Аптека~
@25642 = ~«Говори, двуногий, и я передам твое послание Многоединому».~
@25643 = ~Городской Фестхолл~
@25644 = ~Фойе Фестхолла~
@25645 = ~Мантуок наклоняется, повернув к тебе ухо.~
@25646 = ~Он ухмыляется. «Вот как. У тебя будет время пересмотреть свой ответ, много времени». Он поднимает руки, из его пальцев струится дым.~
@25647 = ~«Значит, ты действительно не знаешь? Ясно, что ты зашел сюда по ошибке. Ты не уйдешь отсюда». Он поднимает руки, из его пальцев струится дым.~
@25648 = ~Тренировочный зал воинов~
@25649 = ~Тренировочный зал воров~
@25650 = ~Он умолкает. Его хвост мотается из стороны в сторону. Некоторое время он пристально на тебя смотрит. «Мои уши не обманывают меня, и ты сказал, что Безмолвный Король — всего лишь блеф мертвяков? Да, так и есть, — он бросает на тебя взгляд, а когда поворачивается, в его глазах горит торжество. — Скоро трупы станут по-настоящему мертвыми, и мы до отвала наедимся их мясом, — внезапно он с подозрением смотрит на тебя, — если только это не уловка. Значит, ты поговоришь с Многоединым?»~
@25651 = ~Тренировочный зал магов~
@25652 = ~«Да. Запомни: они уже знают, что ты им скажешь. Прощай. Мы еще увидимся».~
@25653 = ~Коридор, ведущий к спальным комнатам~
@25654 = ~Мантуок шипит: «Он слишком силен? Ты видел доказательство его мощи? Тьфу! Многоединый услышит об этом из твоих уст. Ты расскажешь эти скверные новости сам! Идем со мной».~
@25655 = ~«Это была не просьба». Он поднимает руки, из его пальцев струится дым. На миг все окутывается тьмой.~
@25656 = ~«Пришел ко *мне*? И кто же послал тебя с этим дурацким поручением?»~
@25657 = ~Он умолкает, как бы оценивая тебя. «А почему жрец тлена и пепла не пользуется обычным способом? Почему Соэго Брат-крыс не использует курьеров? Тьфу. Неважно. Рассказывай, и покончим с этим».~
@25658 = ~Крысооборотень яростно махает хвостом. «Хорошо. Ты поговоришь с Многоединым. Не лги, двуногий, поскольку они могут прочесть твои мысли так же легко, как и услышать твой голос».~
@25659 = ~«Твой язык страдает от избытка лжи и похвалы — это признак мошенника. Говори прямо, или пожалеешь. Зачем ты здесь и что ты ищешь? Может, стечение обстоятельств привело тебя к моей двери? Какие у тебя здесь дела?»~
@25660 = ~«И зачем? Какое у тебя дело к Многоединому?»~
@25661 = ~Он открывает рот и выдает поток брани, но потом его взгляд устремляется вдаль, а голова склоняется набок, как будто он слушает чье-то послание. Когда его взгляд снова фокусируется на тебе, он выплевывает: «Лучше бы твои новости стоили того, чтобы услышать их, двуногий, иначе страдания твои войдут в легенды».~
@25662 = ~«Я голос Многоединого! Ты мне расскажешь о своих делах! — его голос стихает и становится вкрадчивым. — Ты скажешь мне, или у тебя будут... неприятности, ясссно?»~
@25663 = ~От этого Мантуок подпрыгивает и шипит. «Мерзкий, мерзкий человек. Угрожает Мантуоку. Не уважаешь Мантуока. Плюет на его долг. Говорит Мантуоку колкие угрозы. Сегодня ты не завел себе друзей, человек. Иди к Многоединому и рассказывай, с чем пришел».~
@25664 = ~~
@25665 = ~«Я уже собирался уходить».~
@25666 = ~«Я пришел из Погребенной деревни, и просто тут осматривался».~
@25667 = ~«Я пришел к тебе».~
@25668 = ~«То, откуда я и куда иду — мое личное дело».~
@25669 = ~«*Что* ты такое?»~
@25670 = ~«Я пришел из Погребенной деревни, и просто тут разведывал».~
@25671 = ~«То, откуда я и куда иду — мое личное дело».~
@25672 = ~«*Что* ты такое?»~
@25673 = ~«Я сказал, что уже ухожу. Прощай».~
@25674 = ~«Да, но в этом ночном горшке и порыться-то негде».~
@25675 = ~«Нет».~
@25676 = ~«Что ты имеешь в виду?»~
@25677 = ~«Ты мне угрожаешь?»~
@25678 = ~«Думаю, да».~
@25679 = ~«Это было стечение обстоятельств».~
@25680 = ~«Я ищу Многоединого».~
@25681 = ~«Кто такой Многоединый?»~
@25682 = ~«Я пришел к тебе».~
@25683 = ~«Думаю, что здесь мне делать нечего».~
@25684 = ~«О чем это ты?»~
@25685 = ~«Я исправлю это и уйду...»~
@25686 = ~«Хорошо».~
@25687 = ~«Я так не думаю».~
@25688 = ~Атаковать его.~
@25689 = ~«Тут не о чем рассказывать».~
@25690 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@25691 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@25692 = ~«Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе мертвецы уничтожат вас».~
@25693 = ~«Что за?..»~
@25694 = ~«Значит, ты действительно не знаешь? Ясно, что ты зашел сюда по ошибке. Ты не уйдешь отсюда». Он поднимает руки, между его пальцами играют искры.~
@25695 = ~«Мы могли бы обсудить это...»~
@25696 = ~«Что ты делаешь?»~
@25697 = ~«О, теперь я могу поговорить с Многоединым?»~
@25698 = ~«Тогда прощай». ~
@25699 = ~«Я так не думаю».~
@25700 = ~«Пошли».~
@25701 = ~«Что за?..»~
@25702 = ~«Соэго».~
@25703 = ~«Никто».~
@25704 = ~«Никто. Просто я подумал, что ты тут главный».~
@25705 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@25706 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@25707 = ~«Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе мертвецы уничтожат вас».~
@25708 = ~«Он сказал, что я должен передать это Многоединому лично».~
@25709 = ~«На самом деле, нет никакого сообщения».~
@25710 = ~«Я запомню это».~
@25711 = ~«Это было стечение обстоятельств».~
@25712 = ~«Я ищу Многоединого».~
@25713 = ~«Кто такой Многоединый?»~
@25714 = ~«Думаю, что здесь мне делать нечего».~
@25715 = ~«Я принес новости».~
@25716 = ~«Мои дела тебя не касаются».~
@25717 = ~«Ничего особенного».~
@25718 = ~«Избавь меня от своих угроз. Пошли».~
@25719 = ~«Если ты попробуешь причинить мне вред, Мантуок, Многоединый заставит тебя пожалеть об этом».~
@25720 = ~«Вообще-то, здесь у меня нет дел».~
@25721 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@25722 = ~«Безмолвный Король — всего лишь мертвый скелет. Он бессилен».~
@25723 = ~«Безмолвный Король слишком силен, чтобы нападать на него. Держитесь подальше от Мертвых Народов, иначе мертвецы уничтожат вас».~
@25724 = ~«Спасибо. Ты мне очень помог».~
@25725 = ~Западный лекционный зал~
@25726 = ~Восточный лекционный зал~
@25727 = ~Назад через фойе Фестхолла~
@25728 = ~Стойка регистрации~
@25729 = ~Твоя старая комната~
@25730 = ~Назад в Чиновничий район~
@25731 = ~Раздевалка~
@25732 = ~Задняя комната аптеки~
@25733 = ~«Приветствую...»~
@25734 = ~Позволить ему уйти.~
@25735 = ~Он останавливается и окидывает тебя взглядом. Кажется, твой внешний вид слегка ошеломил его. «Мы... э... знакомы, сэр?»~
@25736 = ~«Нет, но у меня есть несколько вопросов...»~
@25737 = ~«Что-то не так с моим внешним видом?»~
@25738 = ~«Нет. Прощай».~
@25739 = ~«У меня действительно нет времени, сэр: я кое-куда направляюсь. Так что, если вы не возражаете...»~
@25740 = ~«Всего один вопрос?»~
@25741 = ~«Всего один вопрос?»~
@25742 = ~«Я *возражаю*. А теперь отвечай на вопросы...»~
@25743 = ~«Тогда прощай». ~
@25744 = ~Он закусывает губу и кивает. «Не могу вам в этом отказать. Но умоляю, спрашивайте побыстрее!»~
@25745 = ~«Что это за место?»~
@25746 = ~«Здесь есть что-нибудь интересное?»~
@25747 = ~«Где можно найти работу здесь?»~
@25748 = ~«Мне нужно попасть в одно место...»~
@25749 = ~«Ты знаешь что-нибудь о Равель Заморочке?»~
@25750 = ~«Ничего, неважно. Прощай».~
@25751 = ~Она поднимает брови от удивления. «Это Чиновничий район, сэр. Может, вы... заблудились? О, не берите в голову. Мне нужно идти! Счастливо...»~
@25752 = ~«Погоди... У меня еще вопросы...»~
@25753 = ~«Прощай».~
@25754 = ~«У меня есть время только на один вопрос, сэр. Возможно, вы найдете кого-нибудь более свободного в одном из уличных кафе. А теперь прощайте...»~
@25755 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@25756 = ~«Тогда прощай». ~
@25757 = ~«Сэр! В текущий момент у меня нет ни времени, ни желания отвлекаться! Оставьте меня, иначе я буду вынужден звать на помощь!»~
@25758 = ~«Сомневаюсь, что кто-нибудь успеет тебя спасти».~
@25759 = ~«Ты не станешь никого звать, если тебе дорога твоя жизнь».~
@25760 = ~«Прошу прощения. Счастливо».~
@25761 = ~«Тогда прощай». ~
@25762 = ~Он начинает пятиться, зовя на помощь: «Стража! Стража!»~
@25763 = ~Напасть на него.~
@25764 = ~Попытаться уйти до того, как кто-нибудь подоспеет.~
@25765 = ~«В Чиновничьем районе есть чего посмотреть, сэр... а уж особенно в этой его части! Конечно же, Городской Фестхолл, художественная галерея и Бордель утоления интеллектуальной страсти...» Он радостно вздыхает, задумавшись.~
@25766 = ~«Что-нибудь еще?»~
@25767 = ~Он на мгновение задумывается. «Хм-м. Ну, здесь есть мастерская портного, аптека, дом адвоката. А, и еще катакомбы под районом. А также тот странный антикварный магазинчик, — он пожимает плечами. — Как по мне, то более чем достаточно, чтобы занять кого угодно. Удачи вам, и прощайте!»~
@25768 = ~«У меня вопрос насчет одного из упомянутых тобой мест...»~
@25769 = ~«Позволь мне спросить еще кое о чем...»~
@25770 = ~«Спасибо за уделенное время. Прощай».~
@25771 = ~На миг он задумывается. «Можете спросить в аптеке. Или у адвоката. И, конечно же, в Фестхолле... у них должна найтись случайная работа. Удачи вам, сэр... Прощайте».~
@25772 = ~«У меня вопрос насчет одного из упомянутых тобой мест...»~
@25773 = ~«Позволь мне спросить еще кое о чем...»~
@25774 = ~«Спасибо за уделенное время. Прощай».~
@25775 = ~«И что за место вы ищите?»~
@25776 = ~«Дом адвоката».~
@25777 = ~«Аптека».~
@25778 = ~«Художественная галерея».~
@25779 = ~«Бордель».~
@25780 = ~«Катакомбы под районом».~
@25781 = ~«Городской Фестхолл».~
@25782 = ~«Антикварный магазин».~
@25783 = ~«Мастерская портного».~
@25784 = ~«Ничего, неважно. Прощай».~
@25785 = ~«Дом Яниса находится на юге от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Он будет на восточной стороне дороги».~
@25786 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25787 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25788 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к востоку от дороги. Ее фасад смотрит на юг и у нее три витражных окна».~
@25789 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25790 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25791 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к западу от дороги. Ее фасад обращен на юг, а черепица на крыше привалена крупными камнями».~
@25792 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25793 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25794 = ~«Значит, Бордель утоления интеллектуальной страсти? — он понимающе улыбается. — Прямо на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это большое круглое здание, вход с юга».~
@25795 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25796 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25797 = ~Он хмурится. «Хм. Все, что я знаю, так это то, что туда есть несколько входов... И еще кое-что. Должен вас предупредить, что ничто не выходит из катакомб... включая тех, кто туда зашел».~
@25798 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25799 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25800 = ~«Найти Фестхолл легче всего, сэр. Это огромное здание в северо-восточной части этой части района».~
@25801 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25802 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25803 = ~«Никогда там не был, но знаю, где его найти. Он здесь, в юго-восточной части. Необычное здание, к нему ведет широкая лестница. Сложно пропустить».~
@25804 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25805 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25806 = ~«Мастерская портного Гонсалвиса находится на северо-востоке от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это длинное здание, вход — с юга».~
@25807 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25808 = ~«Понятно. Спасибо за уделенное время. Прощайте».~
@25809 = ~Она качает головой. «Возможно, вы найдете кого-нибудь более свободного в одном из уличных кафе, сэр. А теперь прощайте...»~
@25810 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@25811 = ~«Тогда прощай». ~
@25812 = ~«Что?» Кажется, некоторое время он пребывает в растерянности... но потом взгляд его проясняется, как будто он вдруг что-то вспомнил. «А! Ночная ведьма, да? Я помню сказки, которые слышал о ней в детстве...»~
@25813 = ~«Сказки?»~
@25814 = ~«Понятно. Позволь мне спросить кое о чем еще...»~
@25815 = ~«Спасибо, это все, что я хотел узнать. Прощай».~
@25816 = ~Он кивает. «Да. Разве она не миф? Ведьма, которая пыталась разрушить Сигил? — внезапно он нахмуривается. — Мне правда нужно идти, сэр... Прощайте».~
@25817 = ~«Постой. У меня есть еще вопрос...»~
@25818 = ~«Спасибо за уделенное время. Прощай».~
@25819 = ~«Нет, сэр, нисколько! — человек нервно смеется. — Ну... э... — он указывает на твой обнаженный, покрытый шрамами торс. — Возможно, у вас *немного* ... скажем так... 'свирепый' вид, по сравнению с обычными жителями этого района, разве нет? Без обид, сэр».~
@25820 = ~«Нисколько. У меня есть несколько вопросов...»~
@25821 = ~«У меня все. Прощай».~
@25822 = ~«Рад вас снова видеть, сэр. Извините, но я немного спешу. Прощайте...»~
@25823 = ~«Постой. У меня есть несколько вопросов...»~
@25824 = ~«Прощай».~
@25825 = ~«Как я уже говорил, я ужасно спешу. Возможно, вы найдете кого-нибудь более свободного в одном из уличных кафе, сэр. А теперь прощайте...»~
@25826 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@25827 = ~«Тогда прощай». ~
@25828 = ~«Сссс... это начччинает надоедать...»~
@25829 = ~«Новый дом, новое логово... новое мяссссо...»~
@25830 = ~«Будь... наччччеку».~
@25831 = ~«Будьте бдительны, упыри...»~
@25832 = ~::Рычание::~
@25833 = ~«Чччто охраняет это сущщщество? Разберитесссссь».~
@25834 = ~Кто-то умер~
@25835 = ~Этот тест~
@25836 = ~«Дааа...»~
@25837 = ~«Ты... боишшшься этого сущщщества? Ха-ха!»~
@25838 = ~«Вперед! Пройди мимо твари!»~
@25839 = ~«Я попытаюссссь. Это будет... быссстро».~
@25840 = ~«Ха-ха! Труссс!»~
@25841 = ~«Тупая тварь».~
@25842 = ~Эта опрятная, хорошо одетая женщина определенно куда-то направляется.~
@25843 = ~«Приветствую...»~
@25844 = ~Она останавливается, чтобы поглядеть на тебя, и ее глаза тут же расширяются. Она оглядывается в поисках того, к тому ты обращался, затем натянуто улыбается. «Извините, но... мы знакомы?»~
@25845 = ~«Нет, но у меня есть несколько вопросов...»~
@25846 = ~«Я кое-куда спешу, сэр, и у меня осталось мало времени, чтобы туда добраться, — она отступает назад. — Так что если вы не возражаете...»~
@25847 = ~«Всего один вопрос?»~
@25848 = ~Она закусывает губу и кивает. «Хорошо, сэр. Но поспешите с вопросом... у меня времени в обрез!»~
@25849 = ~«Что это за место?»~
@25850 = ~Она поднимает брови от удивления. «Это Чиновничий район, сэр. Вы заблудились? Ах, не берите в голову. Мне нужно идти! Счастливо...»~
@25851 = ~«Постой... У меня есть еще вопрос...»~
@25852 = ~«Я согласилась на один вопрос, сэр. Будьте так любезны учесть это и дать мне уйти, хорошо? Возможно, вы найдете кого-нибудь более свободного в одном из уличных кафе».~
@25853 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@25854 = ~Ее глаза сужаются. «Возможно, там, откуда вы пришли, ваша пугающая внешность и грубые внешние манеры считаются за норму, но в этой части порядочного Сигила царит порядок. А теперь оставьте меня, 'сэр', иначе я буду вынуждена позвать на помощь!»~
@25855 = ~«Сомневаюсь, что кто-нибудь успеет тебя спасти».~
@25856 = ~Она начинает пятиться, зовя на помощь: «Стража! Стража!»~
@25857 = ~Напасть на нее.~
@25858 = ~Попытаться уйти до того, как кто-нибудь подоспеет.~
@25859 = ~«Ты никого не будешь звать, если тебе дорога твоя жизнь».~
@25860 = ~«Прошу прощения. Прощай».~
@25861 = ~«Тогда прощай». ~
@25862 = ~«Тогда прощай». ~
@25863 = ~«Прощай».~
@25864 = ~«Здесь есть что-нибудь интересное?»~
@25865 = ~«Еще бы, сэр! Особенно в этой части Чиновничьего района, где находится Городской Фестхолл. А также художественная галерея».~
@25866 = ~«Что-нибудь еще?»~
@25867 = ~Она на мгновение задумывается. «Хм-м. Ну, здесь есть мастерская портного, аптека, дом адвоката и бордель 'утоления интеллектуальной страсти'. А, и еще катакомбы под районом. А также тот странный антикварный магазинчик».~
@25868 = ~«У меня вопрос насчет одного из упомянутых тобой мест...»~
@25869 = ~«Позволь мне спросить еще кое о чем...»~
@25870 = ~«Спасибо за уделенное время. Прощай».~
@25871 = ~«Где здесь можно найти работу?»~
@25872 = ~Она на миг задумывается. «Вы могли бы поискать в Фестхолле... у них должно быть что-нибудь для вас. Еще можете попробовать спросить у адвоката и в аптеке. А мне уже нужно идти... Прощайте».~
@25873 = ~«У меня вопрос насчет одного из упомянутых тобой мест...»~
@25874 = ~«Позволь мне спросить еще кое о чем...»~
@25875 = ~«Спасибо за уделенное время. Прощай».~
@25876 = ~«Мне нужно попасть в одно место...»~
@25877 = ~«Что вы ищете, сэр?»~
@25878 = ~«Дом адвоката».~
@25879 = ~«Дом Яниса находится на юге от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Он будет на восточной стороне дороги».~
@25880 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25881 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25882 = ~«Аптека».~
@25883 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к востоку от дороги. У нее фасад с южной стороны и три витражных окна».~
@25884 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25885 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25886 = ~«Художественная галерея».~
@25887 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к западу от дороги. Ее фасад обращен на юг, а черепица на крыше привалена крупными камнями».~
@25888 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25889 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25890 = ~«Бордель».~
@25891 = ~Она подчеркнуто хмурится, покачивая головой: «Он прямо на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это большое круглое здание, вход находится на юге».~
@25892 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25893 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25894 = ~«Катакомбы под районом».~
@25895 = ~Она хмурится. «Те входы все еще открыты? Раз так, тогда они должны охраняться... говорят, в этих катакомбах довольно опасно. Я не знаю, как именно в них попасть, сэр».~
@25896 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25897 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25898 = ~«Городской Фестхолл».~
@25899 = ~«Найти Фестхолл легче всего, сэр. Это огромное здание в северо-восточной части этого района».~
@25900 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25901 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25902 = ~«Антикварный магазин».~
@25903 = ~«Он находится здесь, в юго-восточной части. Необычное здание, к нему ведет широкая лестница. Никогда сама туда не ходила... От него мне становится не по себе».~
@25904 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25905 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25906 = ~«Мастерская портного».~
@25907 = ~«Мастерская портного находится на северо-востоке от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это длинное здание, вход — с юга».~
@25908 = ~«Спасибо. Позвольте мне спросить еще кое о чем...»~
@25909 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@25910 = ~«Ничего, неважно. Прощай».~
@25911 = ~«Ты знаешь что-нибудь о Равель Заморочке?»~
@25912 = ~Она качает головой. «Очень жаль... Возможно, вы найдете кого-нибудь более свободного в одном из уличных кафе, сэр. А теперь прощайте...»~
@25913 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@25914 = ~«Ночная ведьма Равель? В детстве мои родители рассказывали мне о ней сказки... страшные истории».~
@25915 = ~«Сказки?»~
@25916 = ~«Ясно. Позволь мне спросить кое о чем еще...»~
@25917 = ~«Тогда прощай». ~
@25918 = ~«Спасибо, это все, что я хотел узнать. Прощай».~
@25919 = ~«Ничего, неважно. Прощай».~
@25920 = ~«Всего один вопрос?»~
@25921 = ~Она кивает. «Да. Про злую ведьму, которая пыталась разрушить Сигил. В них говорилось о том, что если я буду слишком громко плакать, она придет ко мне и заберет меня в то ужасное место, куда ее изгнали, — внезапно она нахмуривается. — Мне и вправду нужно идти, сэр... Прощайте».~
@25922 = ~«Погоди. У меня есть другой вопрос...»~
@25923 = ~«Спасибо за уделенное время. Прощай».~
@25924 = ~«Я *возражаю*. А теперь отвечай на вопросы...»~
@25925 = ~«Тогда прощай». ~
@25926 = ~«Что-то не так с моим внешним видом?»~
@25927 = ~«Нет-нет... нисколько! — женщина нервно смеется. — Ну, может... — она указывает на твой обнаженный, покрытый шрамами торс. — У вас *немного* ... э... 'свирепый' вид, по сравнению с обычными обитателями этого района, разве нет? Прошу, не обижайтесь из-за моих слов, сэр».~
@25928 = ~«Нисколько. У меня есть несколько вопросов...»~
@25929 = ~«У меня все. Прощай».~
@25930 = ~«Нет. Прощай».~
@25931 = ~Позволить ему уйти.~
@25932 = ~Женщина вежливо кивает в знак приветствия. «Здравствуйте и прощайте... извините, сэр, но я немного спешу».~
@25933 = ~«Постой. У меня есть несколько вопросов...»~
@25934 = ~«Как я уже сказала, сэр, я очень спешу. Возможно, вы найдете кого-нибудь более свободного в одном из уличных кафе. А теперь прощайте...»~
@25935 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@25936 = ~«Тогда прощай». ~
@25937 = ~«Прощай».~
@25938 = ~«Приветствую...»~
@25939 = ~«Приветствую...»~
@25940 = ~Позволить ей уйти.~
@25941 = ~Она останавливается, чтобы поглядеть на тебя, и ее глаза тут же расширяются. Она оглядывается в поисках того, к тому ты обратился, затем натянуто улыбается. «Извините, но мы... — внезапно она замечает Морта. — О! Какой хорошенький мимир!»~
@25942 = ~«Мимир?»~
@25943 = ~«Правда, симпатичный? Ему так нравится, когда ему чешут макушку».~
@25944 = ~«Я бы не советовал его трогать — может укусить».~
@25945 = ~«Да-да. У меня есть несколько вопросов...»~
@25946 = ~«Что-то не так с моим внешним видом?»~
@25947 = ~«Нет. Прощай».~
@25948 = ~Женщина улыбается: «Как мило! Он еще и разговаривает сам!»~
@25949 = ~~
@25950 = ~«Нет, никто из тех, кого я видела, — качает она головой, — они же всего лишь предметы, разве не...»~
@25951 = ~~
@25952 = ~«Несомненно, может так и есть», — пожимает плечами женщина.~
@25953 = ~«У меня есть несколько вопросов...» ~
@25954 = ~«Я должен идти. Прощай».~
@25955 = ~«Правда? — все еще улыбаясь, подозрительно спрашивает она. — Должно быть, вы шутите, сэр! Это же мимир...»~
@25956 = ~«То есть? Разве они этого не любят?»~
@25957 = ~«Нет, это правда. Попробуй».~
@25958 = ~«Забудь о нем. У меня есть другие вопросы...»~
@25959 = ~Она протягивает руку и осторожно гладит Морта... который, широко улыбаясь и постоянно тебе подмигивая, все время тычется носом ей в руку. Она натянуто смеется: «Как странно!»~
@25960 = ~«Да... что ж, у меня есть несколько вопросов...»~
@25961 = ~«Это все? Прощай».~
@25962 = ~«Это типа говорящей энциклопедии, шеф. На самом деле, мне не хочется об этом говорить».~
@25963 = ~~
@25964 = ~Морт, многозначительно водя бровями, направляется к женщине. «А еще я могу...»~
@25965 = ~«Хватит, Морт».~
@25966 = ~«Да-да. Хорошо, — Морт закатывает глаза и начинает ворчать. — Тогда уж лучше быть *мертвым*...»~
@25967 = ~«Постой... ты сказала 'разговаривает сам'? А разве обычно они не разговаривают?»~
@25968 = ~«У меня есть несколько вопросов к этой женщине...»~
@25969 = ~Оставить женщину в покое.~
@25970 = ~Морт перебивает ее: «Понимаешь, шеф, есть много признаков *качественного* мимира. Некоторые — например, я — намного лучше других. Более... э-э... 'самосознательные', говоря научным языком».~
@25971 = ~«Хм-м».~
@25972 = ~«Понятно».~
@25973 = ~«Эй! Я всего лишь пытаюсь немного развлечься, шеф!»~
@25974 = ~~
@25975 = ~«Что... что эта тварь сделала с нами?»~
@25976 = ~«Ты был в арсенале?»~
@25977 = ~«Да, я знаю. Интересно, чем он занимается?»~
@25978 = ~«Он здесь уже много времени!»~
@25979 = ~«Говорят, ночью будет дождь».~
@25980 = ~«Эй, ты! Стой!»~
@25981 = ~«Поскорее бы закончилась моя смена».~
@25982 = ~«Интересно, что его беспокоит?»~
@25983 = ~«Нет, но слышал, что там трудятся над какой-то машиной».~
@25984 = ~::Зевает:: «Вздремну-ка я немного».~
@25985 = ~«Смотри, чтобы фрактор тебя не застукал».~
@25986 = ~«Когда пришел Сандоз, он был сильно чем-то озабочен».~
@25987 = ~Старый поэт~
@25988 = ~«Оправдатель»~
@25989 = ~Раненная трокопотока~
@25990 = ~Сев-Тай~
@25991 = ~Плакальщик Эс-Аннона~
@25992 = ~Каждый дюйм кожи этого человека покрыт паутиной черных линий; выглядит так, будто какой-то художник изрисовал каждую складку его кожи чернильным пером. В итоге его лицо, даже когда оно не выражает никаких эмоций, кажется хмурым. ~
@25993 = ~«Приветствую».~
@25994 = ~Оставить изрисованного человека в покое.~
@25995 = ~Лицо женщины разбито, а она вся покрыта шрамами, оставленными от укусов и царапин. Она уставилась пустым взглядом в стену монумента с именами, держа в руках обрывки различного тряпья.~
@25996 = ~«Приветствую».~
@25997 = ~Оставить женщину в покое.~
@25998 = ~Этот небольшой, жилистый головорез закутан в черно-красные лохмотья. При твоем приближении он таращится на тебя.~
@25999 = ~Мужчина не отвечает, продолжая таращиться на тебя. Не похоже, что он — главарь этой небольшой банды.~
@26000 = ~«Тогда прощай». ~
@26001 = ~«Приветствую».~
@26002 = ~Оставить головореза в покое. ~
@26003 = ~Этот крупный головорез закутан в красно-черные лохмотья. Он выглядит так, словно сделан целиком из мускулов. Когда ты подходишь, он бросает на тебя свирепый взгляд.~
@26004 = ~«Приветствую».~
@26005 = ~Оставить головореза в покое.~
@26006 = ~Потоки слез прорыли борозды на покрытом пылью лице этого человека. С виду он то ли монах, то ли какой-то праведник, однако грязь, покрывающая его тело, практически не оставляет возможности определить, кто он такой. Он напевает и качает головой взад-вперед — что-то вроде ритуала.~
@26007 = ~«Приветствую».~
@26008 = ~Оставить праведника в покое.~
@26009 = ~Золотое кольцо~
@26010 = ~Бронзовый браслет~
@26011 = ~Потускневший серебряный браслет~
@26012 = ~Серебряный браслет~
@26013 = ~Золотой браслет~
@26014 = ~Клинок Бессмертного~
@26015 = ~Клинок Энтропии~
@26016 = ~Маскировка под богочеловека~
@26017 = ~Костюм тленного~
@26018 = ~Костюм богочеловека~
@26019 = ~Палица~
@26020 = ~Сыр~
@26021 = ~Седой локон Равель~
@26022 = ~Семя с черными шипами~
@26023 = ~Серьга Одноухого~
@26024 = ~Медная серьга~
@26025 = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

На поверхности этой простой серебряной серьги есть следы узоров, но ты не можешь их как следует разглядеть.~
@26026 = ~ЗОЛОТАЯ СЕРЬГА
Вес: 

Этот простенькая золотая серьга, скорее всего, когда-то висела на ухе благородной персоны.~
@26027 = ~БРОНЗОВОЕ КОЛЬЦО
Вес: 0

Кажется, в прошлом это неприметное бронзовое кольцо было в чьем-то носу. Несмотря на вмятины и царапины, за него можно получить пару монет у местного торговца.~
@26028 = ~СЕРЕБРЯНОЕ КОЛЬЦО
Вес: 0

Простое кольцо из серебра без каких-либо украшений; возможно, раньше оно было обручальным. Вне зависимости от прошлого предназначения, местный торговец может заплатить за него несколько монет.~
@26029 = ~ЗОЛОТОЕ КОЛЬЦО
Вес: 0

На внешней поверхности этого золотого кольца имеется несколько гравировок, но ты не можешь понять их значения. Каким бы ни было его предназначение в прошлом, за него точно можно получить порядочно монет у местного торговца.~
@26030 = ~БРОНЗОВЫЙ БРАСЛЕТ
Вес: 0

Это массивный бронзовый браслет, тяжелый, простой и неинтересный. Возможно, его можно продать местному торговцу за пару монет.~
@26031 = ~ПОТУСКНЕВШИЙ СЕРЕБРЯНЫЙ БРАСЛЕТ
Вес: 1

На этом потускневшем серебряном браслете множество вмятин и царапин. Он не выглядит старым, но им, похоже, много пользовались. Несмотря на его внешний вид, за него можно выторговать пару монет у местного торговца.~
@26032 = ~СЕРЕБРЯНЫЙ БРАСЛЕТ
Вес: 1

Легкий браслет из чистого серебра с красивыми узорами на поверхности. За него местный торговец выложит неплохую сумму.~
@26033 = ~ЗОЛОТОЙ БРАСЛЕТ
Вес: 0

Хотя этот браслет из превосходного золота, на нем нет никаких украшений или гравировок. Несмотря на простоту, за него наверняка можно получить хорошую цену у местного торговца.~
@26034 = ~КЛИНОК БЕССМЕРТНОГО
(уникальное, артефакт)
Урон: 2-3 колющий
Магический урон: +1
THAC0: +1
Скорость: 1
Вес: 0
Специализация: клинковые
Не используется жрецами

Этот странный клинок был выкован железным големом с использованием капли твоей крови. Это ужасного вида оружие повторяет своей формой один из символов на твоей левой руке. Черные прожилки расползаются по поверхности металла, а лезвие выглядит настолько тупым, словно не смогло бы разрезать даже теплое масло. Когда ты держишь клинок, он слегка пульсирует, подобно сердцу. Голем заявил, что этот «клинок» сможет убить даже тебя — при условии, что он будет использован в месте, отрезанном от остальных планов.~
@26035 = ~КЛИНОК ЭНТРОПИИ
Урон: 3-23 колющий
Магический урон: +2
THAC0: +3
Скорость: 7
Вес: 7
Специализация: клинковые
Не используется жрецами

Ты получил этот странный предмет после того, как отдал Куб-Модрон железному голему в Осадной башне. Он похож на маленький кинжал, но когда ты его осматриваешь, то замечаешь, что поверхность его волнуется и искажается, словно пытается освободится от своей формы.

Кажется, клинок сделан из железа, серебра и множества других металлов. Временами они смешиваются, а иногда погружаются внутрь клинка, чтобы уже через несколько минут вновь покрыть его поверхность.~
@26036 = ~МАСКИРОВКА ПОД БОГОЧЕЛОВЕКА
Вес: 5

Этот набор из простой прочной одежды и рабочих сапог составляет типичный рабочий костюм члена фракции Боголюдей.~
@26037 = ~КОСТЮМ ТЛЕННОГО
Вес: 5

Это мастерски выполненная копия мрачных черных одеяний, которые обычно носят члены фракции Тленных. Однако, в отличие от настоящей одежды тленного, сделана она из добротной ткани и имеет шелковую окантовку.~
@26038 = ~КОСТЮМ БОГОЧЕЛОВЕКА
Вес: 5

Это мастерски выполненная копия простой прочной одежды и рабочих сапог, которые составляют типичный рабочий костюм богочеловека. Однако, в отличие от настоящей одежды богочеловека, сделана она из добротной ткани и имеет шелковую окантовку.~
@26039 = ~ОПРАВДАТЕЛЬ
Урон: 3-12 дробящий
Магический урон: +2
Особенность: повышает восстановление здоровья
THAC0: +2
Скорость: 2
Вес: 2
Специализация: дубины
Используется только бойцами

Эта палица во многом похожа на остальные — шипастый шар на деревянной рукоятке, обтянутой кожаными ремнями, которые предотвращают ее выскальзывание в пылу битвы. Основное ее отличие —  выжженный кислотой на верхушке оружия Глаз, стилизованный символ бога Гора.

Это оружие — Оправдатель, палица, созданная в городе Гелиополисе на плане Аркадия, чтобы помогать последователям добра и наказывать последователей зла. Если нужно, она может лечить своего владельца, и будет предлагать свое мнение по различным вопросам.~
@26040 = ~СЫР
Вес: 0

Это кусок сыра.~
@26041 = ~ОТРАВЛЕННЫЙ СЫР
Вес: 0

Этот сыр был отравлен сильнодействующим ядом.~
@26042 = ~СЕМЯ С ЧЕРНЫМИ ШИПАМИ
Вызывает: «Проклятье черных шипов»
Позволяет скопировать «Проклятье черных шипов» в книгу заклинаний
Дальность: 30 футов
Длительность: мгновенно
Скорость: 2
Область действия: 1 существо
Спасбросок: отсутствует
Вес: 0

Эти злобные семена содержат в себе частицу лабиринта черных шипов. Их сила высвобождается, если швырнуть семена на землю перед противником. Как только семя касается земли, из него прорастают покрытые черными шипами ветви, которые жадно набрасываются на тело жертвы. Каждое семя содержит в себе лишь одно такое проклятье.~
@26043 = ~ОБСИДИАНОВАЯ СЕРЬГА
Специальное: +10 % к навыку Скрытности
Вес: 0
Используется только ворами

Это маленькая серьга сделана из отполированного обсидиана. Несмотря на гладкую поверхность, она совершенно не отражает свет.
Черный камень серьги, часто упоминаемый как «лучший друг жулика», обладает магической способностью поглощать свет, благодаря чему становится легче передвигаться в тени незамеченным.~
@26044 = ~СЕДОЙ ЛОКОН РАВЕЛЬ
Вес: 0

Это один из длинных седых локонов Равель; он настолько стар, что кажется, будто ее седые волосы стали еще светлее обычного. Он, должно быть, пару футов в длину... вдобавок, еще и жесткий.~
@26045 = ~МЕДНАЯ СЕРЬГА
Вес: 0

Похоже, это неприметное медное колечко стало жертвой страстного любовника... или того, кто обожает есть металл... с одной стороны оно погнуто, а с другой есть следы зубов.~
@26046 = ~Бронзовый браслет~
@26047 = ~Потускневший серебряный браслет~
@26048 = ~Серебряный браслет~
@26049 = ~Золотой браслет~
@26050 = ~Клинок Бессмертного~
@26051 = ~Клинок Энтропии~
@26052 = ~Маскировка под богочеловека~
@26053 = ~Костюм тленного~
@26054 = ~Костюм богочеловека~
@26055 = ~Зертские доспехи Даккона~
@26056 = ~«Оправдатель»~
@26057 = ~Сыр~
@26058 = ~Семя с черными шипами~
@26059 = ~Обсидиановая серьга~
@26060 = ~Седой локон Равель~
@26061 = ~Серебряное кольцо~
@26062 = ~БРОНЗОВЫЙ БРАСЛЕТ
Вес: 0

Это массивный бронзовый браслет, тяжелый, простой и неинтересный. Возможно, его можно продать местному торговцу за пару монет.~
@26063 = ~ПОТУСКНЕВШИЙ СЕРЕБРЯНЫЙ БРАСЛЕТ
Вес: 1

На этом потускневшем серебряном браслете множество вмятин и царапин. Он не выглядит старым, но им, похоже, много пользовались. Несмотря на его внешний вид, за него можно выторговать пару монет у местного торговца.~
@26064 = ~СЕРЕБРЯНЫЙ БРАСЛЕТ
Вес: 1

Легкий браслет из чистого серебра с красивыми узорами на поверхности. За него местный торговец выложит неплохую сумму.~
@26065 = ~ЗОЛОТОЙ БРАСЛЕТ
Вес: 0

Хотя этот браслет из превосходного золота, на нем нет никаких украшений или гравировок. Несмотря на простоту, за него наверняка можно получить хорошую цену у местного торговца.~
@26066 = ~КЛИНОК БЕССМЕРТНОГО
(уникальное, артефакт)
Урон: 2-3 колющий
Скорость: 1
Вес: 0
Специализация: клинковые
Не используется жрецами

Этот странный клинок был выкован железным големом с использованием капли твоей крови. Это ужасного вида оружие повторяет своей формой один из символов на твоей левой руке. Черные прожилки расползаются по поверхности металла, а лезвие выглядит настолько тупым, словно не смогло бы разрезать даже теплое масло. Когда ты держишь клинок, он слегка пульсирует, подобно сердцу. Голем заявил, что этот «клинок» сможет убить даже тебя — при условии, что он будет использован в месте, отрезанном от остальных планов.~
@26067 = ~КЛИНОК ЭНТРОПИИ
Урон: 3-23 колющий
Магический урон: +2
THAC0: +3
Скорость: 1
Вес: 1
Специализация: клинковые
Не используется жрецами

Ты получил этот странный предмет после того, как отдал Куб-Модрон железному голему в Осадной башне. Он похож на маленький кинжал, но когда ты его осматриваешь, то замечаешь, что поверхность его волнуется и искажается, словно пытается освободится от своей формы.

Кажется, клинок сделан из железа, серебра и множества других металлов. Временами они смешиваются, а иногда погружаются внутрь клинка, чтобы уже через несколько минут вновь покрыть его поверхность.~
@26068 = ~Это рулон бинтов, полезный для перевязывания легких ран. При использовании они восстанавливают 3 очка жизни.~
@26069 = ~МАСКИРОВКА ПОД БОГОЧЕЛОВЕКА
Вес: 5

Этот набор из простой прочной одежды и рабочих сапог составляет типичный рабочий костюм члена фракции Боголюдей.~
@26070 = ~КОСТЮМ ТЛЕННОГО
Вес: 5

Это мастерски выполненная копия мрачных черных одеяний, которые обычно носят члены фракции Тленных. Однако, в отличие от настоящей одежды тленного, сделана она из добротной ткани и имеет шелковую окантовку.~
@26071 = ~КОСТЮМ БОГОЧЕЛОВЕКА
Вес: 5

Это мастерски выполненная копия простой прочной одежды и рабочих сапог, которые составляют типичный рабочий костюм богочеловека. Однако, в отличие от настоящей одежды богочеловека, сделана она из добротной ткани и имеет шелковую окантовку.~
@26072 = ~ПАЛИЦА
Урон: 3-12 дробящий
Скорость: 2
Вес: 2
Специализация: дубины
Используется только бойцами

Эта палица во многом похожа на остальные — шипастый шар на деревянной рукоятке, обтянутой кожаными ремнями, которые предотвращают ее выскальзывание в пылу битвы. Основное ее отличие —  выжженный кислотой на верхушке оружия Глаз, стилизованный символ бога Гора.~
@26073 = ~СЫР
Вес: 0

Это кусок сыра.~
@26074 = ~СЕДОЙ ЛОКОН РАВЕЛЬ
Вес: 0

Это один из длинных седых локонов Равель; он настолько стар, что кажется, будто ее седые волосы стали еще светлее обычного. Он, должно быть, пару футов в длину... вдобавок, еще и жесткий.~
@26075 = ~Это маленькое черное семя покрыто рядами мелких шипов, торчащих из его поверхности. ~
@26076 = ~СЕРЬГА ОДНОУХОГО
Вес: 0
Используется только ворами

Это маленькая серьга сделана из отполированного обсидиана. Несмотря на гладкую поверхность, она совершенно не отражает свет.~
@26077 = ~НЕБОЛЬШАЯ СТАЛЬНАЯ ВИЛКА
Урон: 1-2 колющий
Скорость: 2
Вес: 1
Специализация: клинковые
Не используется жрецами

Эта вилка — уж точно нетипичный образец столового прибора. Ее стальной конец поцарапан и слегка погнут, а зубцы покрыты грязью.~
@26078 = ~ВЕТВЬ ЧЕРНЫХ ШИПОВ
Вес: 1

Эта изогнутая ветка на самом деле состоит из трех черных ветвей, плотно переплетенных между. Ветки похожи на те, которые ты видел лабиринте Равель, но на них отсутствуют черные шипы, которыми там покрыты все деревья.~
@26079 = ~ОЖЕРЕЛЬЕ ЧЕРНЫХ ШИПОВ
Вес: 0

Это связка черных колючих семян, нанизанных на один из длинных седых локонов Равель. Похоже, это какой-то амулет, но ты не знаешь, что он делает и как им пользоваться.~
@26080 = ~КЛЮЧ К ХРАНИЛИЩУ ЯНИСА
Вес: 0

Этот толстый металлический ключ, по всей видимости, может отпереть хранилище в офисе адвоката. ~
@26081 = ~ЗОЛОТОЙ СЛИТОК
Вес: 15

Это золотой слиток. Он весит с тонну, и если он стоит столько же золота, сколько весит сам...~
@26082 = ~КАМЕННАЯ ПИРАМИДА
Вес: 7

Это небольшая каменная пирамидка необычайно тяжела. Кажется, он сделана из гранита.~
@26083 = ~СВИТОК ЛЕЧЕНИЯ
Особенность: лечит 33 Очка Жизни
Вес: 0

Этот свиток из тончайшего пергамента — часть наследства Дейонарры. Он аккуратно свернут и перевязан красной лентой. Если развязать ее, лечащая магия, заключенная в свитке, освобождается.

Свиток излечит даже самые тяжелые раны. После использования он превращается в пыль.~
@26084 = ~УДАР ТРИГИТА
Урон: 2-16 дробящий
Вес: 0
Скрорсть: 5
Специализация:
Используется только тригитом

Это основная дробящая атака тригита. У нее средняя скорость, и она наносит много урона.~
@26085 = ~СЕРЕБРЯНОЕ КОЛЬЦО
Вес: 0

Простое кольцо из серебра без каких-либо украшений; возможно, раньше оно было обручальным. Вне зависимости от прошлого предназначения, местный торговец может заплатить за него несколько монет.~
@26086 = ~«На сегодня имен нет. Прощай».~
@26087 = ~Я встретил призрак женщины по имени Дейонарра, и она предсказала мне, что я столкнусь с тремя врагами, но «ни один из них не был бы мне ровней в период полного расцвета моих сил». Они — тени зла, добра и нейтральности, которых породили и извратили законы планов. Она сказала, что я попаду в тюрьму, построенную из «сожалений и скорби», где «даже тени теряют рассудок». Там меня попросят принести ужасную жертву... чтобы обрести покой, я должен «уничтожить то, что удерживает меня в живых, и отринуть свое бессмертие».~
@26088 = ~Железный голем выковал оружие, которое, по его словам, может убить меня... но им следует воспользоваться в подходящем месте, в оболочке, где я был бы отрезан от планов. Я спросил его, где мне найти такое место, и он ответил, что не знает.~
@26089 = ~Когда я отправился в Крепость из осадной башни, голем попросил меня помочь ему выбраться из тюрьмы и продолжить свой энтропический поход по планам. Я отказался; его назначение — служить МНЕ, а не воевать на планах за какие-то дурацкие идеалы. Он выбросил меня из осадной башни, и мне навеки запрещено переступать ее порог.~
@26090 = ~Когда я отправился в Крепость из осадной башни, голем попросил меня помочь ему выбраться из тюрьмы и продолжить свой энтропический поход по планам. Я отказался. Он выбросил меня из осадной башни, и мне навеки запрещено переступать ее порог. Небольшая цена за избавление планов от страданий.~
@26091 = ~Я отдал голему Куб-Модрон, а потом наступила тьма. Не знаю, что случилось, но осадная башня все еще на месте. У меня странное чувство, что я больше не смогу войти в нее снова. И все же он оставил мне необычное оружие...~
@26092 = ~Когда я отправился в Крепость из осадной башни, голем попросил меня помочь ему выбраться из тюрьмы и продолжить свой энтропический поход по планам. Я отказался; его назначение — служить МНЕ, а не воевать на планах за какие-то дурацкие идеалы. Он выбросил меня из осадной башни, и мне навеки запрещено переступать ее порог.~
@26093 = ~Когда я отправился в Крепость из осадной башни, голем попросил меня помочь ему выбраться из тюрьмы и продолжить свой энтропический поход по планам. Я отказался. Он выбросил меня из осадной башни, и мне навеки запрещено переступать ее порог. Небольшая цена за избавление планов от страданий.~
@26094 = ~Я отдал голему Куб-Модрон, а потом наступила тьма. Не знаю, что случилось, но осадная башня все еще на месте. У меня странное чувство, что я больше не смогу войти в нее снова. И все же он оставил мне необычное оружие...~
@26095 = ~Голем дал мне совет насчет врага, который нападает из теней... он сказал, что тот факт, что он не вступает или не может вступить со мной в открытый бой, является его слабым местом, которым мне нужно воспользоваться. Он посоветовал мне не сражаться с врагом по его правилам, а, напротив, вовлечь его в бой. Он сказал, что если существует причина, по которой мой враг не сражается со мной в открытую, мне следует выяснить ее и использовать.~
@26096 = ~Голем знал о Крепости сожалений... он сказал, что через ее стены не может пробиться даже осадная башня. Он сказал, это памятник, забывший себя и теперь медленно умирающий на «Негативном материальном плане».~
@26097 = ~Голем попросил меня принести ему планарный куб, чтобы помочь вызволит его осадную башню. Он отказался выслушивать мои вопросы и требования, пока я не принесу ему куб.~
@26098 = ~Я повстречался со странной женщиной, Сев-Тай, у мемориала тленных, рядом с Моргом. Она оплакивала смерть трех сестер, убитых группой хаоситов, именующейся Голодными Псами Лающими. Она попросила меня убить троих членов этой группы, и я согласился. Она сказала, что их можно найти за южными воротами, в квартале Улья к югу от мемориала.~
@26099 = ~Я повстречался со странной женщиной, Сев-Тай, у мемориала тленных, рядом с Моргом. Она оплакивала смерть трех сестер, убитых группой хаоситов, именующейся Голодными Псами Лающими. Она попросила меня убить троих членов этой группы, и я согласился. Она сказала, что их можно найти за южными воротами, в квартале Улья к югу от мемориала, полном блудницами и пьяницами.~
@26100 = ~Я вернулся к Сев-Тай и сказал ей, что убил Голодных Псов. Клыкастая девка была настолько смятенной и одержимой верой в их смерть, что она на самом деле посчитала, что я выполнил ее просьбу. Дура... по крайней мере, у нее была вещичка на несколько монет.~
@26101 = ~Я повстречался со странной женщиной, Сев-Тай, у мемориала тленных, рядом с Моргом. Она оплакивала смерть трех сестер, убитых группой хаоситов, именующейся Лающими Голодными Псами. Она попросила меня убить троих членов этой группы, и я согласился... дело в том, что я уже повстречал тех обитателей Улья, о которых она говорила, так что я выполнил ее просьбу до того, как она меня попросила.~
@26102 = ~Голем дал мне совет насчет врага, который нападает из теней... он сказал, что тот факт, что враг не вступает со мной в открытый бой, является его слабым местом, которым мне нужно воспользоваться. Он посоветовал мне не сражаться с врагом по его правилам, а, напротив, вовлечь его в бой.~
@26103 = ~Я получил от голема клетку снов. Я отнесу ее Зандеру; посмотрим, сможет ли он извлечь из нее пользу.~
@26104 = ~Голем сказал, что Равель пыталась разделить Сигил, и что «порядок» наказал ее, поместив в клетку. Однако он не знает, где эта клетка.~
@26105 = ~Очевидно, эта осадная башня способна пробивать стены между планами, действуя, как настоящая осадная башня, только в межпространственном смысле. Вторгающийся легион готовится с одной стороны планарной стены, ожидая, пока осадная башня не опустит свой мост и не проделает дыру в целевой план, а потом устремляется туда прямо через башню. Осадная башня становится грубым подобием двери, с помощью которой вторгающаяся армия может напасть на этот план. Представляю, сколько ущерба планам она наносит, пробивая все эти дыры в мультивселенной...~
@26106 = ~Очевидно, эта осадная башня способна пробивать стены между планами, действуя, как настоящая осадная башня, только в межпространственном смысле. Вторгающийся легион готовится с одной стороны планарной стены, ожидая, пока осадная башня не опустит свой мост и не проделает дыру в целевой план, а потом устремляется туда прямо через башню. Осадная башня становится грубым подобием двери, с помощью которой вторгающаяся армия может напасть на этот план. Представляю, сколько ущерба планам она наносит, пробивая все эти дыры в мультивселенной...~
@26107 = ~Голем в осадной башне утверждает, что его враг — сама мультивселенная... и что поэтому он трудится в кузнице. Он пытается создать оружие, которым можно уничтожить мультивселенную.~
@26108 = ~Имя города Эс-Аннона было высечено в мемориале тленных у Морга. Теперь я должен вернуться и сообщить плакальщику Эс-Аннона, что он избавлен от бремени напоминания.~
@26109 = ~«Извини за беспокойство. Прощай».~
@26110 = ~Этот пожилой, хорошо одетый джентльмен, несомненно, куда-то направляется.~
@26111 = ~«Приветствую...»~
@26112 = ~Он ненадолго останавливается, чтобы посмотреть в твою сторону. Завидев тебя, он хмурится и поднимает бровь. Наконец, он смотрит тебе в глаза. «М-м-м?»~
@26113 = ~«У меня есть несколько вопросов...» ~
@26114 = ~Он отвечает резким, чуть снисходительным тоном: «Как жаль... правда. У меня нет времени на ваши вопросы. Прощайте».~
@26115 = ~«Всего один вопрос!»~
@26116 = ~Он слегка ухмыляется. «Ха! Ну, раз так... задавайте свой 'вопрос'. И побыстрее!»~
@26117 = ~«Что это за место?»~
@26118 = ~«Я должен был догадаться, что вы заблудились. Вы находитесь в Чиновничьем районе, 'сэр'. Если хотите вернуться в Нижний район, или откуда вы там пришли, то ворота находятся в северо-западной части этого района. Прощайте».~
@26119 = ~«Постой... У меня еще вопрос...»~
@26120 = ~«Больше никаких вопросов. Если вам это так нужно — надоедайте кому-нибудь другому. Прощайте».~
@26121 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@26122 = ~Он раздувается, смотрит тебе в глаза и кричит: «Я *не буду* отвечать больше ни на какие вопросы! Прочь с дороги, хам, не то я позову парочку офицеров Гармонимума, чтобы они выдворили ваш искромсанный зад из района!»~
@26123 = ~«Сомневаюсь, что кто-нибудь успеет спасти тебя».~
@26124 = ~«Стража! Стража!» Человек начинает пятиться.~
@26125 = ~Напасть на него.~
@26126 = ~Попытаться уйти до того, как кто-нибудь подоспеет.~
@26127 = ~«Ты никого не станешь звать, если тебе дорога твоя шкура».~
@26128 = ~«Извини. Прощай».~
@26129 = ~«Тогда прощай».~
@26130 = ~«Тогда прощай».~
@26131 = ~«Прощай».~
@26132 = ~«Здесь есть что-нибудь интересное?»~
@26133 = ~Он закатывает глаза. «Я что, похож на зазывалу, сэр? У меня есть дела!» Он пару секунд что-то ворчит, потом продолжает: «Направлятесь в Городской Фестхолл. Может, там вы найдете что-нибудь интересное».~
@26134 = ~«Что-нибудь еще?»~
@26135 = ~«Нет, — кажется, он что-то обдумывает. — Ну... возможно. Не уверен, придется ли вам по душе это место, однако можете посетить Бордель... утоления интеллектуальной страсти».~
@26136 = ~«Расскажи мне про этот бордель».~
@26137 = ~«Позволь мне спросить еще кое о чем...»~
@26138 = ~«Спасибо за уделенное время. Прощай».~
@26139 = ~«Где здесь можно найти работу?»~
@26140 = ~Он кажется удивленным. «Ищете честную работу? Похвально. Спросите в аптеке. Или у адвоката. Каждый должен чем-то заниматься, ну, знаете ли, делать что-нибудь полезное для общества».~
@26141 = ~«У меня вопрос насчет одного из мест, которые ты упоминал...»~
@26142 = ~«Позволь мне спросить еще кое о чем...»~
@26143 = ~«Спасибо за уделенное время. Прощай».~
@26144 = ~«Мне нужно попасть в одно место...»~
@26145 = ~«Куда? Выкладывайте!»~
@26146 = ~«В дом адвоката».~
@26147 = ~«Ищете офис адвоката? Хм-м. Идите на юг от ворот в Нижний район. Он будет на восточной стороне дороги».~
@26148 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26149 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26150 = ~«В аптеку».~
@26151 = ~«Направляйтесь по дороге, которая идет на восток от ворот в Нижний район. На перекрестке сворачивайте на юг... Там ее и найдете, к востоку от дороги. Она стоит фасадом на юг, и у нее три витражных окна».~
@26152 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26153 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26154 = ~«В галерею».~
@26155 = ~«Направляйтесь по дороге, которая идет на восток от ворот в Нижний район. На перекрестке идите на юг... Там ее и найдете, к западу от дороги. Она стоит фасадом на юг, черепица на ее крыше привалена крупными камнями».~
@26156 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26157 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26158 = ~«В Бордель».~
@26159 = ~«Это прямо на восток от ворот в Нижний район. Большое круглое здание со входом на юге».~
@26160 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26161 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26162 = ~«В катакомбы под районом».~
@26163 = ~«Туда есть два входа: один между лавкой портного и Фестхоллом, на восток от ворот в Нижний район, а другой — на юге от ворот».~
@26164 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26165 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26166 = ~«В Городской Фестхолл».~
@26167 = ~«Фестхолл — это огромное здание в северо-восточной части этого района. Нужно быть либо болваном, либо слепым, чтобы пропустить его».~
@26168 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26169 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26170 = ~«В антикварный магазин».~
@26171 = ~«Хм-м. Я слышал, что там есть женщина, такая себе поставщица товаров, продающая вещи с других планов... в основном, с Нижних. Если это то, что вам нужно, то ее магазин в юго-западной части этого района. К нему ведет широкая лестница».~
@26172 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26173 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26174 = ~«К портному».~
@26175 = ~«Идите на северо-восток от ворот в Нижний район. Это длинное здание со входом на юге».~
@26176 = ~«Спасибо. Позволь мне спросить еще кое о чем...»~
@26177 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@26178 = ~«Ничего, неважно. Прощай».~
@26179 = ~«Ты что-нибудь знаешь про Равель Заморочку?»~
@26180 = ~Он качает головой, отмахиваясь от тебя. «Если вам это так нужно — надоедайте кому-нибудь другому. Прощайте».~
@26181 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@26182 = ~Он на пару секунд умолкает. «Мне известно немногое. Только то, что я вычитал в книгах, упоминавших ее между делом».~
@26183 = ~«Что было написано о ней в тех книгах?»~
@26184 = ~«Ясно. Позволь мне спросить кое о чем еще...»~
@26185 = ~«Тогда прощай».~
@26186 = ~«Спасибо, это все, что я хотел узнать. Прощай».~
@26187 = ~«Ничего, неважно. Прощай».~
@26188 = ~«Всего один вопрос!»~
@26189 = ~«Только то, что она — воплощение зла. Многие считают ее мифом, но ее существование было задокументировано. Не слишком подробно, и все же задокументировано. Что касается ее судьбы после попытки уничтожить Сигил... кажется, она была изгнана в один из лабиринтов Леди Боли».~
@26190 = ~«Расскажи мне о Леди Боли».~
@26191 = ~«Можно как-нибудь попасть в эти лабиринты?»~
@26192 = ~«Тогда ты *найдешь* время. А теперь отвечай на мои вопросы...»~
@26193 = ~«Тогда прощай».~
@26194 = ~«У меня есть другие вопросы...»~
@26195 = ~«Поглядите на себя! Вы... вы... почти что голый, весь в шрамах, бродите по улицам Сигила и пристаете к горожанам... а что, я видал и нечистых с более порядочной внешностью и лучшими манерами. Не хочу вас обижать, но и не откажу вам в честном ответе».~
@26196 = ~«Полагаю, как раз это я и спрашивал. У меня еще вопросы...»~
@26197 = ~«Мне больше ничего не нужно. Прощай».~
@26198 = ~«Что-то не так в моей внешности?»~
@26199 = ~Позволить ему уйти.~
@26200 = ~«Опять вы! Сейчас у меня нет времени ни на какие вопросы. Прощайте!»~
@26201 = ~«Постой. У меня есть несколько вопросов...»~
@26202 = ~«Нет. Никаких вопросов. Мне нужно идти, и ничье любопытство меня не задержит. Если вам это так нужно — надоедайте кому-нибудь другому. Прощайте».~
@26203 = ~«Ни с места. Стой здесь и отвечай на мои вопросы».~
@26204 = ~«Тогда прощай».~
@26205 = ~«Прощай».~
@26206 = ~«Нет. Прощай».~
@26207 = ~«Спасибо за уделенное время. Прощай».~
@26208 = ~За окном находится небольшой огороженный дворик.~
@26209 = ~Заглянув в трещину в ставне, ты видишь что-то, похожее на швейную мастерскую.~
@26210 = ~Гигантский железный голем все еще работает в своей кузнице. Искры, пепел и шипящие облака вырываются из-под мостика.~
@26211 = ~СПРАШИВАЙ.~
@26212 = ~Со скрежетом металла о металл гигант поворачивается к тебе. Неожиданно ты осознаешь, что голем встроен в осадную башню: балки, трубы и огромные крепления идут от нижней части его туловища к стенам, а ниже оно переходит в кузницу.~
@26213 = ~Я ЖЕЛЕЗО, КОТОРОМУ ДАНО ПРЕДНАЗНАЧЕНИЕ.~
@26214 = ~Я КУЮ ОРУДИЯ, КОТОРЫМИ БУДЕТ УНИЧТОЖЕНА МУЛЬТИВСЕЛЕННАЯ.~
@26215 = ~МЕТАЛЛ — КАК ПЛОТЬ. И ТО, И ДРУГОЕ НЕСЕТ В СЕБЕ ПОТЕНЦИАЛ. ЕСЛИ НАГРЕТЬ ЕГО ПОД ДАВЛЕНИЕМ, ПОТЕНЦИАЛ ПРОЯВЛЯЕТ СЕБЯ. МОЯ ЦЕЛЬ — РАСКРЫТЬ ЭТОТ ПОТЕНЦИАЛ. ВЫРАЗИТЬ ЕГО.~
@26216 = ~ЖЕЛЕЗО МОЕГО ТЕЛА КОГДА-ТО БЫЛО ВСЕГО ЛИШЬ МАЛЫМ ВЫРАЖЕНИЕМ БОЛИ: КЛИНКАМИ, КОПЬЯМИ, ТОПОРАМИ, НАКОНЕЧНИКАМИ СТРЕЛ, ЗАКЛЕПКАМИ В КАТАПУЛЬТАХ. ИЗ ЭТИХ ОРУДИЙ ВОЙНЫ БЫЛ СДЕЛАН Я.~
@26217 = ~ТЕ МАЛЫЕ ВЫРАЖЕНИЯ БОЛИ БЫЛИ РАСПЛАВЛЕНЫ, ЧТОБЫ СОЗДАТЬ ЭТО ТЕЛО. МОЙ ПОТЕНЦИАЛ РАСКРЫЛСЯ. ТЕПЕРЬ МОЕ ПРЕДНАЗНАЧЕНИЕ — РАСКРЫВАТЬ ПОТЕНЦИАЛ В ДРУГИХ МЕТАЛЛАХ.~
@26218 = ~ЭНТРОПИЯ ПОДНЯЛА МЕНЯ С ПЛАНАРНЫХ ПОЛЕЙ БРАНИ.~
@26219 = ~Я КУЮ ИХ ВО ИМЯ ЭНТРОПИИ. ОНИ — БОЛЬ, КОТОРАЯ СТРЕМИТСЯ ВЫРАЗИТЬ СЕБЯ.~
@26220 = ~ЗА ПРЕДЕЛАМИ ЭТОЙ БАШНИ ПОРЯДОК СОБИРАЕТ СВОИ ВОЙСКА. МУЛЬТИВСЕЛЕННАЯ ЗАЛЕЧИВАЕТ РАНЫ. СО ВРЕМЕНЕМ ЕЕ СИЛА МОЖЕТ СРАВНЯТЬСЯ С ЭНТРОПИЕЙ.~
@26221 = ~Этот зловещий с виду проход ведет в подземелья.~
@26222 = ~МУЛЬТИВСЕЛЕННАЯ ДЫШИТ. ОНА РАСТЕТ. ОНА ПРИХОДИТ В ЗАСТОЙ. ОНА КУЕТ ЦЕПИ ВОКРУГ ПЛАНОВ, ЗВЕНО ЗА ЗВЕНОМ. СО ВРЕМЕНЕМ ДАЖЕ ЭНТРОПИЯ МОЖЕТ БЫТЬ ЗАКОВАНА.~
@26223 = ~ЕСЛИ ЧТО-ТО ПРЕДОТВРАЩАЕТ СВОЕ УНИЧТОЖЕНИЕ, ОНО ПОПРОСТУ УМИРАЕТ ДРУГОЙ СМЕРТЬЮ.~
@26224 = ~У ВСЕХ ВЕЩЕЙ ПРИЧИНА УПАДКА ОДНА И ТА ЖЕ. ВОЙНА НЕОБХОДИМА. СМЕРТЬ НЕОБХОДИМА. УПАДОК НЕОБХОДИМ.~
@26225 = ~НЕТ ПРЕДЕЛОВ. ПРЕДЕЛЫ — ЭТО ОДНО ИЗ ЗВЕНЬЕВ В ЦЕПИ ПОРЯДКА. ПРЕДЕЛЫ ДОЛЖНЫ БЫТЬ УНИЧТОЖЕНЫ.~
@26226 = ~ВСЕ ДОЛЖНО ПАСТЬ ОТ КЛИНКА ЭНТРОПИИ. БЛИЗИТСЯ ВРЕМЯ, КОГДА БУДЕТ НЕОБХОДИМО ПРОБИТЬ СТЕНЫ МИРОЗДАНИЯ. ПОРЯДОК БУДЕТ ПРЕДАН МЕЧУ. ЕГО ЦЕПИ БУДУТ РАЗОРВАНЫ. МУЛЬТИВСЕЛЕННАЯ БУДЕТ УНИЧТОЖЕНА.~
@26227 = ~ЭТА БАШНЯ — ОСАДНАЯ МАШИНА. ОНА СОЗДАНА ДЛЯ ТОГО, ЧТОБЫ ПРОБИВАТЬ СТЕНЫ МЕЖДУ ПЛАНАМИ.~
@26228 = ~БАШНЯ ЗАСТРЯЛА В ЭТОМ ГОРОДЕ. ЭТОТ ГОРОД — КЛЕТКА, КОТОРУЮ ОНА НЕ МОЖЕТ ПРОБИТЬ.~
@26229 = ~КОГДА-ТО БАШНЯ ОСАЖДАЛА ПЛАНЫ. КАК Я СЮДА ПОПАЛ, МНЕ НЕИЗВЕСТНО. КАК МНЕ ОТСЮДА ВЫБРАТЬСЯ, Я НЕ ЗНАЮ.~
@26230 = ~БАШНЯ УКРЕПЛЯЕТСЯ НА ПЛАНЕ. КОГДА ЕЕ МОСТ ОПУСКАЕТСЯ, В МУЛЬТИВСЕЛЕННОЙ ОБРАЗУЕТСЯ РАНА. ИЗ ОДНОГО ПЛАНА НА ДРУГОЙ ЧЕРЕЗ БАШНЮ МОГУТ ПРОЙТИ ЦЕЛЫЕ ЛЕГИОНЫ. КОГДА ПЛАН ПОСЛУЖИТ ЦЕЛЯМ ЭНТРОПИИ, БАШНЯ СНОВА УКРЕПЛЯЕТСЯ.~
@26231 = ~ЭНТРОПИЯ УНИЧТОЖИЛА ИХ.~
@26232 = ~ЭНТРОПИЯ УНИЧТОЖИЛА ИХ.~
@26233 = ~ЭТО ВОЙНА, В КОТОРОЙ БУДУТ УНИЧТОЖЕНЫ ПЛАНЫ.~
@26234 = ~НА ПРОТЯЖЕНИИ ЖИЗНЕЙ МНОГИХ МЕТАЛЛОВ.~
@26235 = ~ДА. ИМЕННО В ЭТОЙ КУЗНИЦЕ БЫЛИ СОЗДАНЫ СВИСТЯЩИЕ СНАРЯДЫ, КОТОРЫЕ РАЗРЫВАЛИ ДЫМЯЩЕЕСЯ НЕБО АВЕРНУСА, СТОЛЬ ОСТРЫЕ, ЧТО САМ ВЕТЕР ИСПЫТЫВАЛ МУЧЕНИЯ.~
@26236 = ~НОЧНАЯ ВЕДЬМА ХОТЕЛА РАЗДЕЛИТЬ ЭТОТ ГОРОД. ЕЕ ВЕЛИЧАЙШИЕ ДЕЛА БЫЛИ СВЯЗАНЫ С РАЗРУШЕНИЕМ. ОНА ШЛА ДОРОГОЙ ЭНТРОПИИ.~
@26237 = ~ПОРЯДОК ЗАКОВАЛ ЕЕ. ОНА БЫЛА БРОШЕНА В КЛЕТКУ.~
@26238 = ~ЕЕ ТЕМНИЦА МНЕ НЕИЗВЕСТНА.~
@26239 = ~ЭТО МЕСТО ТЕНЕЙ. КРЕПОСТЬ, КОТОРУЮ НЕ МОЖЕТ ПРОБИТЬ ДАЖЕ ЭТА БАШНЯ.~
@26240 = ~ЭТО ПАМЯТНИК, ЗАБЫВШИЙ СЕБЯ. ТЕПЕРЬ ОН УГАСАЕТ ВО ТЬМЕ, МЕДЛЕННО УМИРАЯ В НЕБЕСАХ НЕГАТИВНОГО МАТЕРИАЛЬНОГО ПЛАНА.~
@26241 = ~НЕТ.~
@26242 = ~У МЕНЯ ЕСТЬ ТАКОЙ ПРЕДМЕТ. ДАВНЫМ-ДАВНО КО МНЕ ПРИШЕЛ ЗОДЧИЙ СНОВ. ОН ПООБЕЩАЛ МНЕ, ЧТО МОЕ ЗАТОЧЕНИЕ В ЭТОМ ГОРОДЕ ПОДОЙДЕТ К КОНЦУ, КОГДА Я ОТДАМ КЛЕТКУ.~
@26243 = ~ДА. ВОЗЬМИ ЭТУ КЛЕТКУ И ПОГУБИ ТЕХ, КТО СОЗДАЕТ ЭТИ ГРАНИЦЫ.~
@26244 = ~БЕССМЕРТИЕ — ВСЕГО ЛИШЬ СЛОВО. ВСЕ СУЩЕЕ МОЖЕТ УМЕРЕТЬ.~
@26245 = ~У КАЖДОГО ЖИВОГО СУЩЕСТВА ЕСТЬ ОРУЖИЕ, ПЕРЕД КОТОРЫМ ОНО БЕЗЗАЩИТНО. ВРЕМЯ. БОЛЕЗНЬ. ЖЕЛЕЗО. ВИНА.~
@26246 = ~ЧТОБЫ ВЫКОВАТЬ ТАКОЕ ОРУЖИЕ, НУЖНО ЗНАТЬ ВРАГА.~
@26247 = ~НАЧНИ С ЧАСТИЦЫ ВРАГА. КАПЛИ КРОВИ. КРИСТАЛЛИЗОВАННОЙ МЫСЛИ. ОДНОЙ ИЗ ЕГО НАДЕЖД. ВСЕ ЭТИ ВЕЩИ ПОКАЖУТ, КАК ОН МОЖЕТ УМЕРЕТЬ.~
@26248 = ~ТОГДА ЭТО И ЕСТЬ ЧАСТИЦА ВРАГА, КОТОРОЙ ТЫ ДОЛЖЕН ВОСПОЛЬЗОВАТЬСЯ.~
@26249 = ~ДЕЙСТВИЯ ТВОЕГО ВРАГА ГОВОРЯТ ТЕБЕ О МНОГОМ. ТВОЙ ВРАГ НЕ ХОЧЕТ ВСТУПАТЬ С ТОБОЙ В ОТКРЫТЫЙ БОЙ. ЭТО ЕГО СЛАБОЕ МЕСТО.~
@26250 = ~ВЕРОЯТНОСТИ ЭТИ РАВНОЦЕННЫ. КАЖДАЯ ИЗ НИХ ОТКРЫВАЕТ СЛАБОЕ МЕСТО.~
@26251 = ~ДЕЙСТВИЯ ТВОЕГО ВРАГА ГОВОРЯТ ТЕБЕ, ЧТО ТВОЙ ВРАГ НЕ ХОЧЕТ ВСТУПАТЬ С ТОБОЙ В ОТКРЫТЫЙ БОЙ. ЭТО ЕГО СЛАБОЕ МЕСТО.~
@26252 = ~ВСТРЕТЬСЯ СО СВОИМ ВРАГОМ В ОТКРЫТОМ БОЮ. ВТЯНИ ЕГО В СХВАТКУ.~
@26253 = ~ЕСЛИ ВРАГ НЕ ХОЧЕТ СРАЖАТЬСЯ С ТОБОЙ В ОТКРЫТУЮ, ДЕЙСТВУЙ ВОПРЕКИ ЕГО ЖЕЛАНИЯМ. ВТЯНИ ЕГО В БОЙ.~
@26254 = ~ЕСЛИ ОН НЕ МОЖЕТ СРАЖАТЬСЯ С ТОБОЙ В ОТКРЫТОМ БОЮ, НАЙДИ ПРИЧИНУ. ОНА РАСКРОЕТ ТЕБЕ ЕГО СЛАБОЕ МЕСТО.~
@26255 = ~ДА.~
@26256 = ~МНЕ БУДЕТ НУЖНА КАПЛЯ ТВОЕЙ КРОВИ. ЭТО ВСЕ.~
@26257 = ~ИНСТРУМЕНТ ТВОЕГО УНИЧТОЖЕНИЯ ВЫКОВАН И ОБУЧЕН. ЭТОГО НЕДОСТАТОЧНО.~
@26258 = ~МАГИЯ, ЗАСТАВЛЯЮЩАЯ ТВОЕ СЕРДЦЕ БИТЬСЯ И ЗАЛЕЧИВАЮЩАЯ ТВОИ РАНЫ, СИЛЬНА. ТЫ ДОЛЖЕН ПОГРУЗИТЬ КЛИНОК В СВОЕ ТЕЛО, ТОЛЬКО БУДУЧИ ВНУТРИ ОБОЛОЧКИ, В КОТОРОЙ ТЫ БУДЕШЬ ОТРЕЗАН ОТ ПЛАНОВ.~
@26259 = ~ПРИЧИНА МНЕ НЕИЗВЕСТНА. И ВСЕ ЖЕ ЭТО МЕСТО И ЭТО ОРУЖИЕ НЕОБХОДИМЫ ДЛЯ ТВОЕГО УНИЧТОЖЕНИЯ.~
@26260 = ~ЭТО МНЕ НЕИЗВЕСТНО.~
@26261 = ~ПОСТОЙ. ПЕРЕД ТВОИМ УХОДОМ НУЖНО, ЧТОБЫ ТЫ КОЕ-ЧТО СДЕЛАЛ.~
@26262 = ~РАСКРОЙ ЭТУ ТЮРЬМУ. ОСВОБОДИ МЕНЯ. МОЕ ПРЕДНАЗНАЧЕНИЕ НЕ МОЖЕТ БЫТЬ ВЫПОЛНЕНО В ЭТОЙ КЛЕТКЕ.~
@26263 = ~ОБЪЯСНИ.~
@26264 = ~ИМЕННО ПОЭТОМУ МЕНЯ НУЖНО ОСВОБОДИТЬ. МУЛЬТИВСЕЛЕННАЯ СОБИРАЕТ СВОИ АРМИИ. ОНА ЗАЛЕЧИВАЕТ РАНЫ. СО ВРЕМЕНЕМ ОНА МОЖЕТ СРАВНЯТЬСЯ С ЭНТРОПИЕЙ. ЭТОГО НЕ ДОЛЖНО СЛУЧИТЬСЯ.~
@26265 = ~СЛУШАЙ. ТЫ СЛЫШИШЬ?~
@26266 = ~ЗВУК МЕТАЛЛА, ОСТАВЛЕННОГО БЕЗ УХОДА. РЖАВЧИНА. ОРУЖИЕ БЕЗ ВЫРАЖЕНИЯ. ОБЕСКРОВЛЕННОЕ НА ПЛАНАРНЫХ ПОЛЯХ БРАНИ. ОНО СТРАДАЕТ. ОСВОБОДИ МЕНЯ. ОСВОБОДИ ЕГО.~
@26267 = ~ПОРЯДОК ЗАКОВАЛ ТЕБЯ В ЦЕПИ. ТЫ — МОЙ ВРАГ, И ВРАГ ВСЕМУ, ЧТО УМИРАЕТ. ТЫ НЕ БУДЕШЬ ДОПУЩЕН В ЭТУ БАШНЮ ДО СКОНЧАНИЯ ВЕКОВ.~
@26268 = ~ОТДАЙ МНЕ ПЛАНАРНЫЙ КУБ, КОТОРЫЙ ТЫ НОСИШЬ С СОБОЙ. ОН МОЖЕТ ОСВОБОДИТЬ МЕНЯ ОТСЮДА.~
@26269 = ~ЭТО ДВЕРЬ, КОТОРАЯ ПОЗВОЛИТ БАШНЕ ПОКИНУТЬ ЭТО МЕСТО. ОТДАЙ МНЕ ПЛАНАРНЫЙ КУБ.~
@26270 = ~ЕСТЬ ПЛАНАРНЫЙ КУБ, СПОСОБНЫЙ ОСВОБОДИТЬ МЕНЯ ОТСЮДА.~
@26271 = ~ТОГДА ТЫ НАЙДЕШЬ КУБ. ТЫ ПРИНЕСЕШЬ ЕГО МНЕ.~
@26272 = ~ЕГО МЕСТОНАХОЖДЕНИЕ МНЕ НЕИЗВЕСТНО. НАЙДИ ЕГО. ПРИНЕСИ ЕГО МНЕ.~
@26273 = ~ГДЕ ПЛАНАРНЫЙ КУБ?~
@26274 = ~ПОКАЖИ, ЧТО ТЫ ПРИНЕС. Я ИЗУЧУ ЕГО ПОТЕНЦИАЛ И ПОСМОТРЮ, МОЖНО ЛИ ВЫРАЗИТЬ ЕГО.~
@26275 = ~«Хссст! Назад! — женщина скалится, обнажив ряд черных клыков. — Что тебе нужно от Сев-Тай?!»~
@26276 = ~ГОТОВО.~
@26277 = ~«У меня есть вопросы к тебе...»~
@26278 = ~Это огромное, на вид древнее строение почему-то кажется менее зловещим, чем другие здания его размеров.~
@26279 = ~«У меня есть вопросы к тебе...»~
@26280 = ~«У меня есть вопросы к тебе...»~
@26281 = ~Оставить голема в покое.~
@26282 = ~В этой палатке нет ничего интересного.~
@26283 = ~«Что ты такое?»~
@26284 = ~«Что это за место?»~
@26285 = ~«Чем ты занимаешься?»~
@26286 = ~«Зачем ты делаешь оружие?»~
@26287 = ~«Можешь рассказать поподробнее: что ты делаешь с оружием?»~
@26288 = ~«Можешь что-нибудь сделать с моим оружием?»~
@26289 = ~Похоже на то, что в этом месте можно пропустить пару кружек.~
@26290 = ~«Что ты знаешь о Кровавой войне?»~
@26291 = ~«Ты слышал о ночной ведьме по имени Равель?»~
@26292 = ~«Ты знаешь о цитадели под названием Крепость сожалений?»~
@26293 = ~Ты не в силах определить, что делает это устройство.~
@26294 = ~«Мне нужна тяжелая украшенная птичья клетка из кованого железа. У тебя такой не найдется?»~
@26295 = ~«Возможно, в другой раз. Прощай».~
@26296 = ~«Возможно, в другой раз. Прощай».~
@26297 = ~«Что *ты* такое?»~
@26298 = ~«Неважно... Я определенно не туда попал. Извини, что побеспокоил».~
@26299 = ~«Какое предназначение?»~
@26300 = ~«Еще раз, каково твое предназначение?»~
@26301 = ~«Да, ты уже об этом говорил. У меня есть другие вопросы...»~
@26302 = ~«Понятно... Это все, что я хотел узнать. Прощай».~
@26303 = ~«То есть ты куешь оружие? Это и есть твое предназначение?»~
@26304 = ~«Ты сказал, что твое предназначение — ковать оружие... правильно?»~
@26305 = ~«Понятно. У меня есть другие вопросы...» ~
@26306 = ~«Тогда я позволю тебе продолжить свою работу. Прощай».~
@26307 = ~«Для кого ты делаешь это оружие?»~
@26308 = ~«Зачем ты это делаешь?»~
@26309 = ~«Можешь что-нибудь сделать с моим оружием?»~
@26310 = ~«Можешь что-нибудь сделать с моим оружием?»~
@26311 = ~«У меня есть другой вопрос...»~
@26312 = ~«Тогда я позволю тебе продолжить свою работу. Прощай».~
@26313 = ~«Что произошло?»~
@26314 = ~«У меня есть другой вопрос...»~
@26315 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26316 = ~«Ты говорил, что кто-то расплавил оружие и создал твое тело. Кто это был?»~
@26317 = ~«У меня есть другой вопрос...»~
@26318 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26319 = ~«И ты сказал, что теперь твое предназначение — ковать оружие?»~
@26320 = ~«Понятно... У меня есть другой вопрос...»~
@26321 = ~«Что ж, напомни мне сказать спасибо, э-э, энтропии, когда я снова с ней увижусь. Прощай».~
@26322 = ~«Зачем энтропии оружие?»~
@26323 = ~«Понятно. У меня есть другие вопросы...» ~
@26324 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26325 = ~«Мультивселенная — твой враг? Почему?»~
@26326 = ~«Понятно. У меня есть другие вопросы...» ~
@26327 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26328 = ~«И ты против сковывания энтропии?»~
@26329 = ~«Понятно. У меня есть другие вопросы...» ~
@26330 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26331 = ~«Так ты говоришь, что бессмертие — всего лишь еще один вид смерти?»~
@26332 = ~«Почему эта смерть хуже остальных?»~
@26333 = ~Правда: «За исключением того, что предлагаемая тобой смерть жестока и бессмысленная».~
@26334 = ~Правда: «Совершенно верно. Так что же заставило тебя принять сторону энтропии?»~
@26335 = ~«Понятно. У меня есть другие вопросы...» ~
@26336 = ~«Очень интересно. Это все, что я хотел узнать. Прощай».~
@26337 = ~«А есть ли всему этому предел?»~
@26338 = ~«Это может быть необходимо... в разумных пределах».~
@26339 = ~«Это вещи *никогда* не были необходимостью. Неправильно поощрять их и восхвалять разрушение, которое они несут».~
@26340 = ~Цветное стекло в этом окне формой напоминает огромные драгоценные камни.~
@26341 = ~«Согласен. Без всего этого наступит застой».~
@26342 = ~«Понятно. У меня есть другие вопросы...» ~
@26343 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26344 = ~«Даже если результатом будет смерть?»~
@26345 = ~«Понятно. У меня есть другие вопросы...» ~
@26346 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26347 = ~«Понятно... У меня есть другие вопросы...»~
@26348 = ~«Похоже, битва будет знатной... может, там и увидимся. Прощай».~
@26349 = ~«Пробивать планы? Как?»~
@26350 = ~«Если эта осадная башня может путешествовать по планам, почему ты остаешься здесь?»~
@26351 = ~«Понятно. У меня есть другие вопросы...» ~
@26352 = ~Чудное здание, если не сказать больше.~
@26353 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26354 = ~«Как вообще эта осадная башня попала в город?»~
@26355 = ~«Понятно. У меня есть другие вопросы...» ~
@26356 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26357 = ~«Ты сказал, что башня может пробивать планы? Как?»~
@26358 = ~«Понятно. У меня есть другие вопросы...» ~
@26359 = ~«Жаль это слышать, не думаю, что смогу тебе помочь. Прощай».~
@26360 = ~Эти кованные железные прутья служат скорее как украшение, чем как защита.~
@26361 = ~«Я охраняю, значит, я существую».~
@26362 = ~«Нам нужно больше стражников для защиты литейной».~
@26363 = ~Этот тоннель круто спускается под поверхность города.~
@26364 = ~Этот проход ведет в Нижний район Сигила.~
@26365 = ~Ты ничего не можешь различить сквозь затемненное стекло.~
@26366 = ~«Что случилось с легионами, которые воспользовались башней?»~
@26367 = ~«Понятно. У меня есть другие вопросы...» ~
@26368 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26369 = ~«И что случилась с планами, в которые вторглась осадная башня?»~
@26370 = ~«Понятно. У меня есть другие вопросы...» ~
@26371 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26372 = ~«Понятно... У меня есть другие вопросы...»~
@26373 = ~«Очень интересно... Это все, что я хотел узнать. Прощай».~
@26374 = ~«Как долго она длится?»~
@26375 = ~«У меня есть другой вопрос...»~
@26376 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26377 = ~«Ты когда-нибудь служил на ней?»~
@26378 = ~«У меня есть другой вопрос...»~
@26379 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26380 = ~«Э-э... у меня есть другой вопрос...»~
@26381 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26382 = ~«Ты знаешь, что с ней случилось?»~
@26383 = ~«У меня есть другой вопрос...»~
@26384 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26385 = ~«Ты знаешь, где находится эта клетка?»~
@26386 = ~«У меня есть другой вопрос...»~
@26387 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26388 = ~«У меня есть другой вопрос...»~
@26389 = ~«Это все, что я хотел узнать. Прощай».~
@26390 = ~«Ты знаешь об этом еще что-нибудь?»~
@26391 = ~«У меня есть другой вопрос...»~
@26392 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26393 = ~«Ты не знаешь, как туда попасть?»~
@26394 = ~«У меня есть другой вопрос...»~
@26395 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26396 = ~«У меня есть другой вопрос...»~
@26397 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26398 = ~«Понятно... Мне можно ее забрать?»~
@26399 = ~«Пока я не ушел, у меня еще вопросы...»~
@26400 = ~«Спасибо. Прощай».~
@26401 = ~«Ты говоришь, что мог бы выковать оружие, которое убьет бессмертного?»~
@26402 = ~«У меня есть другой вопрос...»~
@26403 = ~«Понятно... Это все, что я хотел узнать. Прощай».~
@26404 = ~«Откуда ты знаешь, каким оружием нужно воспользоваться?»~
@26405 = ~«У меня есть другой вопрос...»~
@26406 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26407 = ~«И как мне это сделать?»~
@26408 = ~«У меня есть другой вопрос...»~
@26409 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26410 = ~«Что, если враг нападает издалека, из теней, и никогда не показывается?»~
@26411 = ~«Хм-м. Ты мог бы выковать оружие, которое убьет меня?»~
@26412 = ~«Хм-м. Ты мог бы выковать оружие, которое убьет меня?»~
@26413 = ~«У меня есть другой вопрос...»~
@26414 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26415 = ~За прутьями, украшающими переднюю часть этой колонны, ничего нет.~
@26416 = ~«Как?»~
@26417 = ~«У меня есть другой вопрос...»~
@26418 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26419 = ~«Или... по какой-то причине он *не может* вступить со мной в открытый бой».~
@26420 = ~«Как мне воспользоваться этим?»~
@26421 = ~«У меня есть другой вопрос...»~
@26422 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26423 = ~«Как мне воспользоваться этим?»~
@26424 = ~«У меня есть другие вопросы...»~
@26425 = ~«У меня есть другой вопрос...»~
@26426 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26427 = ~«Как мне воспользоваться этим?»~
@26428 = ~Этот трон кажется столь же старым, как и само здание. Кажется, им не пользовались. Это больше произведение искусства, чем сидение правителя.~
@26429 = ~«У меня есть другой вопрос...»~
@26430 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26431 = ~«Ты сказал, что бессмертие — всего лишь слово... что все живущее умирает. Ты смог бы создать оружие, которым можно было бы убить меня?»~
@26432 = ~«Хорошо. У меня есть другие вопросы...»~
@26433 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26434 = ~Эта стойка с деревянным тренировочным оружием не представляет для тебя никакого интереса.~
@26435 = ~«А что, если причина того, что он не нападает на меня в открытую, в том, что у него нет выбора?»~
@26436 = ~«У меня есть другой вопрос...»~
@26437 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26438 = ~«Ты сказал, что бессмертие — всего лишь слово... что все живущее умирает. Ты смог бы создать оружие, которым можно было бы убить меня?»~
@26439 = ~«У меня есть другой вопрос...»~
@26440 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26441 = ~«Правда? Как?»~
@26442 = ~«У меня есть другой вопрос...»~
@26443 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26444 = ~«Хорошо...»~
@26445 = ~«Может, в другой раз. У меня есть другие вопросы...»~
@26446 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@26447 = ~«О чем это ты?»~
@26448 = ~«Почему?»~
@26449 = ~Это чучело для тренировок многого натерпелось от рук воинов-учеников.~
@26450 = ~«Где же мне найти такую оболочку, которая бы отделила меня от планов?»~
@26451 = ~Эта заржавевшая железная пластина, прикрученная к стене, вся в выбоинах, ржавчине, трещинах, следах кислоты и огня.~
@26452 = ~Этот темный угол укутан тенями.~
@26453 = ~Это чучело украшено кармашками, кошельками, сумками и десятками крохотных колокольчиков.~
@26454 = ~«У меня есть другой вопрос...»~
@26455 = ~«Тогда мне придется найти это место самому. Прощай».~
@26456 = ~«Что?»~
@26457 = ~«Как *мне* освободить тебя?»~
@26458 = ~«Если ты покинешь город, ты принесешь планам только войну и разрушение. Умрет несчетное количество планаров. Я не могу позволить такому случиться».~
@26459 = ~«Я не могу этого сделать».~
@26460 = ~«Как *мне* освободить тебя?»~
@26461 = ~«Твое предназначение — быть здесь. Твое назначение — служить мне. Снабжай меня оружием и больше не заикайся о 'свободе'».~
@26462 = ~«Я не согласен».~
@26463 = ~«Хм-м. Я тебя понял... как мне освободить тебя?»~
@26464 = ~«Хм-м. Я тебя понял... как мне освободить тебя?»~
@26465 = ~«Что?»~
@26466 = ~«Говорить больше не о чем. Я не стану тебя освобождать: Планам не нужны хаос и страдания, которые ты несешь. Прощай».~
@26467 = ~«Говорить больше не о чем. Голем, твое назначение — находиться здесь и служить мне. Прощай».~
@26468 = ~«Я не могу позволить тебе освободиться. Планам больше не нужны хаос и кровопролитие».~
@26469 = ~«Говорить больше не о чем. Голем, твое назначение — находиться здесь и служить мне».~
@26470 = ~«Как мне освободить их?»~
@26471 = ~«Как мне освободить их?»~
@26472 = ~«Чему быть — того не миновать. Прощай».~
@26473 = ~«Хорошо, вот».~
@26474 = ~«Я не могу отдать его».~
@26475 = ~«Хорошо, вот».~
@26476 = ~«Как бы там ни было, я не могу отдать куб. Он слишком ценен для меня».~
@26477 = ~«Я бы не стал отдавать тебе такой предмет. Как для подарка, он слишком могущественный... если он мне попадется, я оставлю его себе».~
@26478 = ~«Я не отдам его тебе. Я не могу дать тебе освободиться. Планам больше не нужны хаос и кровопролитие».~
@26479 = ~«Но... у меня нет такого куба».~
@26480 = ~«Я знаю о таком кубе. Но я не отдам его тебе».~
@26481 = ~«Где можно найти такую вещь?»~
@26482 = ~«Где можно найти такую вещь?»~
@26483 = ~«Я знаю о таком кубе. Но я не отдам его тебе».~
@26484 = ~«Хорошо... я найду куб и принесу его тебе».~
@26485 = ~«Я знаю о таком кубе. Но я не отдам его тебе».~
@26486 = ~«У меня его нет. Но если бы и был, я бы не отдал его тебе».~
@26487 = ~«У меня пока нет с собой куба, но я хотел задать тебе пару вопросов...»~
@26488 = ~«Я еще не нашел его. Как найду — вернусь».~
@26489 = ~«Хорошо...»~
@26490 = ~«Можно посмотреть на другое имеющееся у тебя оружие?»~
@26491 = ~«Хорошо. У меня есть другой вопрос...»~
@26492 = ~«Понятно. Это все, что мне нужно. Прощай».~
@26493 = ~«Понятно. Это все, что мне нужно. Прощай».~
@26494 = ~«В чем дело?»~
@26495 = ~«Извини за беспокойство. Прощай».~
@26496 = ~«Что не так?! Эти Хос... Ха-вос... ХАОС-иты сломали мою повозку, напали на меня, убили трех моих сестер, которые пытались им помешать! Больше нет сестер — от них не осталось ничего, кроме имен на этой стене!»~
@26497 = ~«Хаоситы?»~
@26498 = ~«Сожалею о твоей потере. Прощай».~
@26499 = ~«Хаоситы, говорят, это фракция такая. Они БОЛЬНЫЕ на всю голову, бесятся и творят все, что им нравится! Мы никогда не причиняли им вреда! А теперь они скачут как собаки и рвут на куски все, до чего дотянутся».~
@26500 = ~«Кто эти хаоситы, которые напали на тебя?»~
@26501 = ~«Сожалею о твоей потере. Прощай».~
@26502 = ~«Они — банда Улья, кучка пустоголовых бедолаг, называющих себя... 'Голодными Псами Лающими', или как-то так!»~
@26503 = ~«Знаешь, я не собираюсь прописывать людей в книгу мертвых за бесплатно. Будет медь, тогда и поговорим».~
@26504 = ~«Их действия были несправедливыми. Если ты хочешь, я могу исправить это. Если они убили троих, тогда должно быть убито три 'Голодных Пса'».~
@26505 = ~«Попробую их разыскать... Сожалею о твоей потере. Прощай».~
@26506 = ~«Медная серьга в твоем кошельке, если ты пропишешь троих из этих убийц в книге мертвых, идет?»~
@26507 = ~«Хорошо, только задача уже выполнена. Не так давно я уже убил троих из них в Улье. Кто-то из них мог быть убийцей твоих сестер».~
@26508 = ~«Попробую записать их в книгу мертвых. Скажи мне, где их можно найти?»~
@26509 = ~«Не думаю, что могу помочь тебе, Сев-Тай. Прощай».~
@26510 = ~«На этот раз силы не были слепы в своей справедливости! — женщина вытаскивает из своей копны волос медную серьгу. — Это тебе. Она стоит по крайней мере тридцать три медяка. Она принадлежала одной из моих сестер... теперь ей это больше не понадобиться».~
@26511 = ~«Хорошо. Прощай, Сев-Тай».~
@26512 = ~«Хорошо. Прощай, Сев-Тай».~
@26513 = ~«Выйди через южные ворота, в сторону шпиля... потом прогуляйся по кварталу, пока не найдешь место, где люди бегают по кругу и воют на небо. Это и есть Голодные Псы Лающие».~
@26514 = ~«Ага, я был в том квартале. Там полно блудниц и пьяниц. Схожу туда и скоро вернусь».~
@26515 = ~«Пойду, поищу их».~
@26516 = ~«Снова ты... — женщина с рыком поворачивается лицом к тебе. — Есть новости для Сев-Тай?»~
@26517 = ~«Я нашел Голодных Псов Лающих и прописал троих из них в книгу мертвых».~
@26518 = ~Ложь: «Я нашел Голодных Псов Лающих и прописал троих из них в книгу мертвых».~
@26519 = ~«Хороших новостей пока нет. Я все еще выслеживаю тех хаоситов».~
@26520 = ~Убив Голодных Псов, я вернулся к Сев-Тай. В обмен на услугу она дала мне медную серьгу и поблагодарила за отомщенных сестер.~
@26521 = ~Завидев тебя, клыкастая женщина кивает. «Сев-Тай и ее сестры благодарят тебя за оказанную справедливость».~
@26522 = ~«Хорошо, Сев-Тай. Прощай».~
@26523 = ~Перед тобой плакальщик Эс-Аннона. Он все еще издает сдавленные всхлипы, напевая имя мертвого города, и слезы катятся по его щекам.~
@26524 = ~«Я хочу спросить, почему ты оплакиваешь город?»~
@26525 = ~Перед тобой плакальщик Эс-Аннона. Он выглядит расслабленным; в его взгляде спокойствие, которого не было при первой вашей встрече. «Спасибо тебе, друг мой. Вскоре я отправлюсь на поиски своих братьев и передам им, что наша скорбь завершилась».~
@26526 = ~«Я еще не нашел могильную плиту, на которой можно высечь имя Эс-Аннона».~
@26527 = ~«Я позаботился о том, чтобы имя Эс-Аннона не было забыто. Его высекли на черном каменном монументе возле Морга».~
@26528 = ~Оставить плакальщика в покое.~
@26529 = ~Плакальщик качает головой. «Этого я и опасался. Плакальщики Эс-Аннона — единственные, кому по силам эта ноша. Тебе больше не нужно искать, друг...»~
@26530 = ~Я позаботился о том, чтобы имя Эс-Аннона высекли на мемориале тленных. Я вернулся и рассказал это плакальщику, и поток его слез иссяк. Похоже, он обрел мир и благодарен мне за старания.~
@26531 = ~«Хорошо. Желаю тебе удачи в твоих странствиях. Счастливо».~
@26532 = ~«Нет. Я продолжу поиск могильной плиты, и вернусь, когда имя Эс-Аннона будет на ней».~
@26533 = ~Человек прекращает свое безумное бормотание и смотрит на тебя глазами, полными слез. Он раскрывает свои потрескавшиеся губы, чтобы заговорить, однако ему удается только выдавить сухой хрип.~
@26534 = ~«В чем дело? Почему ты плачешь?»~
@26535 = ~«Извини за беспокойство. Прощай».~
@26536 = ~«Я...» Голос у него настолько хриплый, что кажется, будто он уже много дней обходится без воды. При этом по его лицу стекает слеза. «Я... плакальщик Эс-Аннона».~
@26537 = ~«Эс-Аннона? Кто он такой?»~
@26538 = ~Большая, богато украшенная ванна.~
@26539 = ~Я согласился помочь плакальщику и найти могильную плиту, чтобы высечь на ней имя Эс-Аннона.~
@26540 = ~На улицах Улья я встретил «плакальщика Эс-Аннона». Согласно его словам, Эс-Аннон — город, который давным-давно был разрушен, и теперь он (а также другие выжившие) путешествует по планам, оплакивая город перед любым, кто готов слушать. Они хотят, чтобы имя Эс-Аннона не было забыто.~
@26541 = ~«К... *кто* такой Эс-Аннон?!» Он запрокидывает голову и издает резкий смех, грубый и отчаянный. «Эс-Аннон... не человек, а город!»~
@26542 = ~«Почему ты оплакиваешь город?»~
@26543 = ~«Боюсь, я тебя расстроил. Прощай».~
@26544 = ~«Мы оплакиваем его имя, потому что Эс-Аннон не должен быть забыт. Все плакальщики Эс-Аннона разделяют это бремя».~
@26545 = ~«Ты скорбишь по *городу*? Зачем тебе это?»~
@26546 = ~«Ясно; предоставлю тебя твоим мыслям. Прощай».~
@26547 = ~«Потому что имя — это все, что от него осталось. Его залитые светом улицы, его величественные спиральные парки... когда он был опустошен и превратился в воспоминания, только шесть десятков его жителей остались в живых. Наш долг — позаботиться о том, чтобы его имя помнили на планах. Многие плакальщики Эс-Аннона умерли во имя памяти... многие...»~
@26548 = ~За этой роскошной портьерой скрыта только голая стена.~
@26549 = ~«Если это подвергает вас риску, почему бы вам не остановиться?»~
@26550 = ~«Я скорблю по утрате твоего города и его жителей. Прощай».~
@26551 = ~«Пролитые мною слезы, покрывающая меня пыль... все это ничто по сравнению с тем, что ждет нас, если я откажусь от своего священного долга. Мы ОБЯЗАНЫ следить за тем, чтобы его имя помнили. Мы — его живые мемориалы».~
@26552 = ~«Тогда что будет, если все вы умрете?»~
@26553 = ~«Я скорблю по утрате твоего города и его жителей. Прощай».~
@26554 = ~Это рабочее помещение замусорено бесчисленными записями и журналами, не представляющими для тебя интерес.~
@26555 = ~Новая слеза вытекает из глаза плакальщика. Даже его покрытое слоем грязи лицо не может скрыть его отчаянья. «НЕ ЗНАЮ. Мы, плакальщики Эс-Аннона, не можем скорбеть вечно... уже сейчас пыль цепляется за нашу одежду, слюна высыхает в наших ртах, наши тела чахнут и умирают».~
@26556 = ~«Я могу тебе чем-то помочь?»~
@26557 = ~«Я скорблю по утрате твоего города и его жителей. Прощай».~
@26558 = ~«Спасибо, что спросил... — плакальщик качает головой. — Если ты не можешь увековечить Эс-Аннон, ты ничем нам не поможешь».~
@26559 = ~За этими стеклянными дверьми ты различаешь небольшой огороженный дворик.~
@26560 = ~«Почему именно ты должен оплакивать имя Эс-Аннона?»~
@26561 = ~«Зачем его увековечивать человеку? Может, сгодится и могильная плита?»~
@26562 = ~«Зачем его увековечивать человеку? Может, сгодится и могильная плита?»~
@26563 = ~«Я скорблю по утрате твоего города и его жителей. Прощай».~
@26564 = ~«Разве это важно? Другой может оплакивать имя, но потом он тоже умрет». В уголке его глаза постепенно появляется слеза, которая затем скатывается по его щеке. «Тут ничего не поделаешь. Когда умрут плакальщики, умрет и Эс-Аннон».~
@26565 = ~«Возможно, так и должно быть. Раз, по твоим словам, города не стало, то ему суждено кануть в забытие».~
@26566 = ~Из зеркала на тебя смотрит твое обезображенное отражение.~
@26567 = ~«Похоже на то, что напоминание об Эс-Анноне подвергает опасности оставшихся его жителей. Разве оно того стоит?»~
@26568 = ~«Как насчет могильной плиты?»~
@26569 = ~«Я скорблю по утрате твоего города и его жителей. Прощай».~
@26570 = ~Корка грязи на его лице трескается; он сердито ворчит: «Ты ничего не знаешь! Ты не видел его красоту! Его величие! Скажи, ты бы отбросил такие воспоминания, столь великолепные, если бы они у тебя были?»~
@26571 = ~«Вещам суждено умирать. Им суждено быть забытыми. Таков мой тебе совет, плакальщик Эс-Аннона... Кому ты послужишь, унеся город с собой в могилу?»~
@26572 = ~Стойка консьержа, прямо как в хороших постоялых дворах.~
@26573 = ~«Вещам суждено умирать. Им суждено быть забытыми. Таков мой тебе совет, плакальщик Эс-Аннона... Кому ты послужишь, унеся город с собой в могилу?»~
@26574 = ~«Вещам суждено умирать. Им суждено быть забытыми. Таков мой тебе совет, плакальщик Эс-Аннона... Кому ты послужишь, унеся город с собой в могилу?»~
@26575 = ~«Я бы не позволил таким воспоминаниям умереть, подвергая риску последних его хранителей. Было бы лучше, если бы ты посвятил остаток своих дней воспоминаниям об Эс-Анноне вместе со своими братьями».~
@26576 = ~«Я бы не позволил таким воспоминаниям умереть, подвергая риску последних его хранителей. Было бы лучше, если бы ты посвятил остаток своих дней воспоминаниям об Эс-Анноне вместе со своими братьями».~
@26577 = ~«Я бы не позволил таким воспоминаниям умереть, подвергая риску последних его хранителей. Было бы лучше, если бы ты посвятил остаток своих дней воспоминаниям об Эс-Анноне вместе со своими братьями».~
@26578 = ~«Тогда как насчет могильной плиты?»~
@26579 = ~«В таком случае, забудь. Предоставлю тебя твоим мыслям. Прощай».~
@26580 = ~Плакальщик умолкает, и ты наблюдаешь, как в уголке его глаза появляется одинокая слеза. Мгновение спустя он продолжает; его полный переживаний голос звучит как гравий. «В твоих словах... есть доля правды» .~
@26581 = ~«Это тяжелая правда — и для понимания, и для принятия».~
@26582 = ~Слезы в уголках его глаз внезапно исчезают. Все происходит так быстро, что ты уже не уверен, была ли она там. «Как бы там ни было, я приму это. И позабочусь о том, чтобы мои братья тоже это приняли».~
@26583 = ~«Хорошо. Тогда прощай».~
@26584 = ~«Хорошо. Тогда прощай».~
@26585 = ~Я убедил плакальщика Эс-Аннона бросить свое паломничество. Для него более нет нужды скитаться по планам в попытке продлить память того, что в любом случае будет забыто. Он согласился, и вскоре передаст это своим братьям.~
@26586 = ~Я убедил плакальщика Эс-Аннона бросить свое паломничество. Я убедил его, что он и остальные плакальщики не должны подвергать риску память об Эс-Анноне, путешествуя по планам. Он согласился, и вскоре передаст это своим братьям.~
@26587 = ~Плакальщик моргает. «Могильная... плита?»~
@26588 = ~«Это камень, на котором записано имя человека, его жизнь и хвалебные слова о нем. Если он подходит человеку, может, он подойдет и умершему городу?»~
@26589 = ~«Это не имеет значения. Забудь мои слова. Прощай».~
@26590 = ~«Камни способны на такое?»~
@26591 = ~«Да. И живут они подольше людей. Если высечь имя Эс-Аннона на камне, будет ли этого достаточно для его памяти?»~
@26592 = ~«Это не имеет значения. Забудь мои слова. Прощай».~
@26593 = ~Он делает паузу. «Увидят ли другие это имя?»~
@26594 = ~«Да. Оно будет на виду у всех, и останется там еще надолго после твоей смерти».~
@26595 = ~«Это не имеет значения. Забудь мои слова. Прощай».~
@26596 = ~Человек кивает. «Если такое возможно... — он обращается к тебе. — Где найти такой камень?»~
@26597 = ~«Я мог бы разыскать его. Если найду — позабочусь о том, чтоб на нем высекли имя Эс-Аннона».~
@26598 = ~«За несколько медяков я мог бы подыскать могильную плиту и высечь на ней имя Эс-Аннона».~
@26599 = ~«Это не имеет значения. Забудь мои слова. Прощай».~
@26600 = ~«Ты... ты... сделаешь это? Я... — его глаза вновь увлажняются. — Ты освободишь всех плакальщиков Эс-Аннона. Нас осталось всего лишь несколько десятков... бремя памяти будет сброшено после СТОЛЬКИХ лет...»~
@26601 = ~«Я сделаю это. Я вернусь, как только имя будет высечено».~
@26602 = ~«Ты... ты... сделаешь это? Я... — его глаза вновь увлажняются. — Ты освободишь всех плакальщиков Эс-Аннона. Нас осталось всего лишь несколько десятков... бремя памяти будет сброшено после СТОЛЬКИХ лет... и все, что ты просишь, — немного медяков?»~
@26603 = ~«Да».~
@26604 = ~«Забудь, я сделаю это за бесплатно. Я вернусь, как только имя будет высечено».~
@26605 = ~«Тогда ты их получишь». Плакальщик вынимает из одежды пять медных монет, которые отсчитывает тебе. «Это все, что у меня есть. Надеюсь, этого хватит».~
@26606 = ~«Должно хватить. Ладно, я вернусь, как только помещу имя Эс-Аннона на камень».~
@26607 = ~«Мне нужна была только медь. Не видать тебе плиты для Эс-Аннона. Прощай».~
@26608 = ~В обмен на небольшую сумму денег я согласился разыскать для плакальщика могильную плиту и высечь на ней имя Эс-Аннона.~
@26609 = ~За несколько медяков я согласился разыскать для плакальщика могильную плиту и высечь на ней имя Эс-Аннона... но как только этот болван отдал свои последние монеты, я посмеялся над ним и сказал, что не стану выполнять такие дурацкие поручения. Ему следовало знать, что не стоит доверять каждому встречному в Улье.~
@26610 = ~В этих мешках — различные виды зерновых и другого продовольствия.~
@26611 = ~Внезапно слышится шелест ветра, и его глаза высыхают. Одна из слез, текшая по его щеке, попросту исчезает. «В таком случае, служба Эс-Аннону закончена. Я расскажу своим братьям-плакальщикам о камне, который ты описал. Прими мою благодарность».~
@26612 = ~«Э... чтобы высечь имя города на камне, мне пришлось потратить немного меди. Не возместишь мне затраты?»~
@26613 = ~«Пожалуйста. Прощай... Надеюсь, что вы со своими братьями проведете остаток дней в мире».~
@26614 = ~Хотя эти ящики и закрыты, по запаху ты можешь определить, что в них хранятся фрукты и овощи.~
@26615 = ~Он кивает и сует руку в одежды. «Все, что у меня есть, — твое». Он отсчитывает пять медяков и протягивает тебе. «Прими их вместе с моей благодарностью» .~
@26616 = ~«Не за что... в прямом смысле. Прощай».~
@26617 = ~«Не за что. Прощай».~
@26618 = ~Эти ящики сделаны из весьма прочной древесины. Должно быть, в них находятся тяжелые предметы.~
@26619 = ~«Эс-Аннон... Я оплакиваю тебя...»~
@26620 = ~«Твои высокие шпили...»~
@26621 = ~«Твои освещенные мосты...»~
@26622 = ~«Бедные сестры...»~
@26623 = ~Похоже, это что-то вроде печки. Ты понятия не имеешь, как ею пользоваться.~
@26624 = ~Похоже, это нечто вроде органов управления печью. Ты слабо себе представляешь, как ими пользоваться.~
@26625 = ~Несколько *очень* крупных зубов. Десятки более мелких лежат на полке над ними.~
@26626 = ~В этих ящиках содержатся разнообразные продукты.~
@26627 = ~Три шара, больше всего напоминающих крупные цветные жемчужины. Они слегка вибрируют от твоего прикосновения и выделяют слабое тепло.~
@26628 = ~«Пустая» подставка под книги, содержащая несколько невидимых книг.~
@26629 = ~Набор необычных кузнечных инструментов. Хотя их рукоятки, судя по виду, сделаны из точеной кости, они тяжелее железа.~
@26630 = ~Полки ломятся от кувшинов, тарелок, книг, графинов, подсвечников и другой дребедени. Большинство из них сделаны из странных металлов или минералов, а многие из книг, похоже, имеют переплет из человеческой кожи.~
@26631 = ~Эти мечи прекрасны; они покрыты изысканной гравировкой и надписями. Однако они — всего лишь декоративное украшение, непригодное для боя.~
@26632 = ~Огромный боевой штандарт. На вид он сделан из шкуры какого-то чешуйчатого существа. Его вид пробуждает слабые воспоминания... Вряд ли тебе попадался именно это экземпляр, но вот похожие — вполне возможно.~
@26633 = ~Перед тобой Порфирон; он все еще угрюмо стоит посреди улицы, не обращая внимания на прохожих. Паутина линий на его лице колышется в серии причудливых узоров.~
@26634 = ~Пока ты говоришь, угловатые узоры на лице Порфирона растворяются в серию причудливых кривых. «Некто хочет спросить: ты нашел украденные четки?»~
@26635 = ~«Некто ждет: что за вопрос ты хочешь задать?»~
@26636 = ~«У некоего есть имя: его зовут Порфироном». Его голос звучит как гонг. При разговоре линии на его лице сворачиваются в серию причудливых сферических узоров. «Некто хочет знать: зачем ты обращаешься к нему?»~
@26637 = ~«Некто хочет, чтобы ты знал: он не может ответить на твои вопросы». Линии на его лице складываются в угловатый узор, а затем разваливаются в мешанину небрежных каракулей. «Некто только недавно пришел в это место стен».~
@26638 = ~«Линии показывают ярость — ты был оскорблен?» Линии медленно разглаживаются, образуя изящные кривые. «Не хотел обижать тебя — примешь ли ты его извинения?»~
@26639 = ~«Некто опишет недавние события: знаешь ли ты, что некто был осажден троими? Трое потребовали его вещь. Некто боялся нападения — что ему оставалось делать? Некто отдал эту вещь».~
@26640 = ~«Некто был неправильно понят». Линии на его лице становятся угловатыми, но затем снова разглаживаются в кривые. «Некто не боялся быть убитым: некто боялся убить троих».~
@26641 = ~«Некто встал на путь воина: много оружия ему известно. Кулаки, клинок, шест, топор, молот — эти инструменты ему известны». ~
@26642 = ~«Ему запрещено атаковать, — когда он произносит это, линии мелко дрожат на его лице. — Если бы некто в гневе атаковал троих, обет ненасилия был бы нарушен».~
@26643 = ~«Некто незнаком с твоей речью: что такое 'пасси-фит'?»~
@26644 = ~«Некто принадлежит *ордену Наз Ледия*: мы ждем Последних дней, когда все будут призваны на битву. Его тренировки и навыки: они будут держаться в тайне до тех пор». ~
@26645 = ~«Некто поясняет: вещь дорога. Но соблюдение *Наз Ледия* дороже».~
@26646 = ~«Некто обращался к трем ворам: что произошло? Его вопросы были встречены насмешками: трое не вернут вещь».~
@26647 = ~«Некто приносит извинения: у него ничего не осталось».~
@26648 = ~«Некто еще раз приносит извинения: согласен ли ты быть обученным?»~
@26649 = ~«Много оружия ему известно: кулаки, клинок, шест, топор, молот. Ему известны эти инструменты — хочешь ли ты познать их?»~
@26650 = ~«Некто называет цену: возвращение украденной вещи, больше ничего».~
@26651 = ~«Некто должен спросить: собираешься ли ты совершить насилие над теми тремя, которые ограбили его?»~
@26652 = ~Линии на лице человека обретают форму налегающих друг на друга эллипсов. «Если таким образом они поймут послание, то так его и нужно передать».~
@26653 = ~«Некто опасается: без насилия послание не поймут». Линии на лице человека обретают форму серии эллипсов. «Некто не против того, чтобы ты попытался».~
@26654 = ~«Вещь эта — нитка с черными и красными четками для ношения на шее. Ценность этих четок неизмерима в меди — их ценность измерима в вере».~
@26655 = ~«Некто знает место, где были сказаны гневные слова и вещь была утеряна — у бара, который горит изнутри. Трое стоят возле этого места — одеты в черное и красное».~
@26656 = ~«Некто видит твою ношу — некогда утерянные четки». Он берет их у тебя... ты замечаешь, что его руки испещрены такими же линиями, что и на лице. «Некто хочет задать вопрос: как тебе удалось заполучить эти четки у троих?»~
@26657 = ~«Некто доволен: послание насилия было доставлено. Некто благодарит: несколько спасибо и пожалуйста, да?»~
@26658 = ~«Некто хочет знать: Это тот, кто сражается обманом во имя ордена *Наз Ледия*?» Лицо Порфирона вновь покрывается угловатыми узорами. «Таких называют обманщиками — это путь без дисциплины и чести».~
@26659 = ~«Некто хочет знать: Это тот, кто сражается словами во имя ордена *Наз Ледия*?» Лицо Порфирона вновь покрывается угловатыми узорами. «Таких называют дипломатами — это путь без дисциплины и чести».~
@26660 = ~«Некто хочет знать: Это тот, кто сражается монетами во имя ордена *Наз Ледия*?» Лицо Порфирона вновь покрывается угловатыми узорами. «Таких называют торгашами — это путь без дисциплины и чести».~
@26661 = ~«Некто приносит извинения: он не хотел оскорблять». Углы на лице Порфирона становятся очень острыми, затем медленно разглаживаются в мелкую рябь. «Некто благодарит: несколько спасибо и пожалуйста за твои услуги, да?»~
@26662 = ~«Некто объясняет: *Наз Ледию* может обучать тот, у кого нет злобы к ученику».~
@26663 = ~«Некто обучит тебя, да. Но некто предупреждает тебя: с познанием насилия приходит искушение использовать его».~
@26664 = ~«Некто говорит: ты желаешь оставить свою текущую специальность? Путь воина не может быть пройден рассеянным разумом».~
@26665 = ~«Некто услышал тебя — ты уже идешь по этому пути. Некто предлагает тебе слушать...»~
@26666 = ~«Теперь ты вступил на путь воина. Хочешь ли ты узнать больше о его направлениях?»~
@26667 = ~«Некто будет обучать». Линии на его лице складываются в треугольники. «Следующие вещи являются краеугольными камнями в твоем обучении: концентрация, опыт, мастерство».~
@26668 = ~«Во-первых, некто расскажет о концентрации: чтобы уяснить суть, ты должен быть сосредоточенным. Ты должен принять путь воина. Воин — это твоя специализация, и никакая больше».~
@26669 = ~«Во-вторых, некто расскажет об опыте: истинные знания о битве можно получить только с опытом. Есть предел, до которого ты можешь поглощать приемы владения оружием. Когда ты достигаешь нового уровня воинского искусства — возможно, ты готов к новым урокам?» ~
@26670 = ~«Некто расскажет о мастерстве: любое оружие можно изучить лишь до определенного предела. Некто добавит: он может обучить только некоторым из них. Знания об оружии делятся на три уровня: невежда, опытный и мастер. Между ними есть несколько уровней, которые ученик должен пройти, пока наконец не достигнет основы следующего навыка».~
@26671 = ~«Уровень невежды: ты не знаешь, как пользоваться оружием. Атака неуклюжа — урон намного меньше возможного».~
@26672 = ~«Уровень опытного: когда некто изучил оружие, говорят, что он *опытен* в его использовании. Его удары больше не неуклюжи — они стремительны и точны». ~
@26673 = ~«Уровень мастера: когда кто-то становится очень опытным, он превращается в *мастера* в использовании оружия. Это оружие больше не является инструментом — это продолжение его воли».~
@26674 = ~«Некто был обучен рукопашной, владению клинками, шестом, топором и молотом — о чем ты хочешь узнать?»~
@26675 = ~«Использующий кулаки: его удары быстры, наносимый урон дробит кости противника. Следующее оружие ты можешь найти: тяжелые рукавицы, ударные кинжалы или даже цестусы. Они могут наносить дробящий, колющий или рубящий урон. Твои знания ограничены: желаешь ли ты использовать часть своего таланта, чтобы достигнуть уровня опытного в этом оружии?»~
@26676 = ~«Использующий кинжал: его удары быстры. Наносимый урон похож на порез от когтя или укол иглы. Он зависит от типа кинжала. Желаешь ли ты использовать часть своего таланта, чтобы достигнуть уровня опытного в этом оружии?»~
@26677 = ~«Использующий дубину: ее скорость не так высока, как у кулаков или кинжала, но зато урон повыше. Она дробит тело противника, подобно падающему камню. Желаешь ли ты использовать часть своего таланта, чтобы достигнуть уровня опытного в этом оружии?»~
@26678 = ~«Использующий боевой топор: его скорость не так высока, как у дубины, но зато урон повыше. Он вгрызается в тело противника, как огромный коготь. Желаешь ли ты использовать часть своего таланта, чтобы достигнуть уровня опытного в этом оружии?»~
@26679 = ~«Использующий молот: его скорость не так высока, как у дубины, но зато урон повыше. Урон, как у огромной падающей скалы, дробит тело противника. Желаешь ли ты использовать часть своего таланта, чтобы достигнуть уровня опытного в этом оружии?»~
@26680 = ~«Некто обучит тебя: сначала встань вот так...»~
@26681 = ~«Некто поздравляет тебя: знания быстро приходят к тебе. Ты хорошо усваиваешь уроки».~
@26682 = ~«Некто больше не может обучать тебя: знаешь ли ты, что стал опытным в использовании этим оружием? Некто может дать тебе последний урок: чтобы узнать больше, если это вообще возможно, найди мастера. Оставайся на пути воина, и пройдет немного времени, прежде чем ты достигнешь пределов своих знаний».~
@26683 = ~«Некто видит, что твой разум уже заполнен до предела знаниями об оружии: можешь ли ты вернуться ко мне, когда достигнешь нового уровня? Тогда некто научит тебя новым навыкам оружия».~
@26684 = ~«Некто может дать последний урок: найди мастера, чтобы узнать больше».~
@26685 = ~«Некто видит, что твой разум готов к обучению: в каком виде оружия ты хочешь приобрести опыт?»~
@26686 = ~«Здравствуй, Порфирон. Могу ли я задать тебе пару вопросов?»~
@26687 = ~«Здравствуй, Порфирон».~
@26688 = ~«Здравствуй, Порфирон. Могу ли я задать тебе пару вопросов?»~
@26689 = ~«Некто обращается к тебе, Порфирон: могу ли я задать тебе пару вопросов?»~
@26690 = ~«Некто обращается к тебе, Порфирон».~
@26691 = ~«Некто обращается к тебе, Порфирон: могу ли я задать тебе пару вопросов?»~
@26692 = ~Оставить Порфирона в покое.~
@26693 = ~Полка с одеждой отличного качества.~
@26694 = ~«Думаю, да. Это они?»~
@26695 = ~«Пока нет... еще раз, где оно было украдено?»~
@26696 = ~«Пока нет. Я его найду, а затем вернусь».~
@26697 = ~Заполучив четки у головорезов возле бара «Тлеющий труп», я вернул их Порфирону.~
@26698 = ~«Ты можешь обучить меня пути воина?»~
@26699 = ~«Я хочу оставить свою текущую специализацию и снова встать на путь воина».~
@26700 = ~«Скажи, готов ли я к новым урокам?»~
@26701 = ~«Скажи, готов ли я к новым урокам?»~
@26702 = ~«Порфирон, я достиг уровня опытного во всех видах оружия. Можешь ли ты обучить меня еще чему-нибудь?»~
@26703 = ~«Я хотел бы изучить навыки владения оружием».~
@26704 = ~«Пока вопросов нет. Я вернусь позднее».~
@26705 = ~Рулоны превосходных тканей.~
@26706 = ~«Я хочу задать несколько вопросов о городе».~
@26707 = ~«Неважно. Извини за беспокойство».~
@26708 = ~«Ладно. Э, можно тогда спросить: почему эти линии на твоем лице... двигаются?»~
@26709 = ~«Тогда ладно. Извини за беспокойство. Прощай».~
@26710 = ~«Без проблем... но почему ты в ярости?»~
@26711 = ~Стопка великолепной ткани.~
@26712 = ~«Хорошо. Спасибо за уделенное время. Прощай».~
@26713 = ~«Ну, ты боялся неспроста. Эти трое могли убить тебя, если бы ты ее не отдал».~
@26714 = ~«Понятно. Сожалею о твоей потере. Прощай».~
@26715 = ~«Ну... если ты мог их убить, почему же ты позволил им ограбить себя?»~
@26716 = ~«Нет-нет. Держи свое оружие... вот так...»~
@26717 = ~«Ну, это было очень смело с твоей стороны. И деликатно. Прощай».~
@26718 = ~«Это не очень-то все объясняет... Еще раз, если ты опытный воин, почему же ты позволил им ограбить себя?»~
@26719 = ~«Понятно. Сожалею о твоей потере. Прощай».~
@26720 = ~«Обет ненасилия? Ты воин и *пацифист*?»~
@26721 = ~«Понятно. Сожалею о твоей потере. Прощай».~
@26722 = ~«Неважно. Для чего же ты тогда тренировался, раз тебе нельзя никого атаковать?»~
@26723 = ~«Не имеет значения. Сожалею о твоей потере. Прощай».~
@26724 = ~«А тем временем ты позволяешь ограбить себя на улице, даже не защищаясь?»~
@26725 = ~«Если это твое убеждение, то ты должен придерживаться его. Сожалею о твоей потере. Прощай».~
@26726 = ~Эти полки завалены контейнерами с различными порошками, жидкостями, стружкой и тому подобным. Большинство не подписано.~
@26727 = ~«Раз ты не хочешь драться, может, попросил бы их вернуть твою вещь?» ~
@26728 = ~«Понятно. Сожалею о твоей потере. Прощай».~
@26729 = ~«Я могу попробовать вернуть эту вещь».~
@26730 = ~«Я могу избить их как собак и заставить их вернуть украденное».~
@26731 = ~«Я могу попробовать вернуть эту вещь, если ты заплатишь мне за услуги».~
@26732 = ~«Понятно. Сожалею о твоей потере. Прощай».~
@26733 = ~«Ну хорошо. Я их все равно убью».~
@26734 = ~«У тебя *вообще* ничего нет?»~
@26735 = ~«В таком случае, я не могу тебе помочь. Прощай».~
@26736 = ~«Обученным? Чему?»~
@26737 = ~Полки этого шкафа завалены контейнерами с различными порошками, жидкостями, стружкой и тому подобным.~
@26738 = ~«Не заинтересован. Прощай».~
@26739 = ~«Хм-м. Обучение оружию? Если это бесплатно...»~
@26740 = ~«Не заинтересован. Прощай».~
@26741 = ~«Хорошо, я займусь этим. Как выглядит эта вещь?»~
@26742 = ~«Не заинтересован. Прощай».~
@26743 = ~«Ну, если они будут недостаточно умны для того, чтобы отдать то, что я прошу, то я могу сильно разозлиться».~
@26744 = ~«Нет, если получится».~
@26745 = ~«Пожалуй, я не смогу помочь тебе. Прощай».~
@26746 = ~Этот низкий столик завален контейнерами с различными порошками, жидкостями, стружкой и тому подобным. Они не подписаны, и сходу ты не можешь определить ни одну из субстанций.~
@26747 = ~«Ну ладно. Как выглядит та вещь, которую ты потерял?»~
@26748 = ~«Пожалуй, я не смогу помочь тебе. Прощай».~
@26749 = ~«Ну ладно. Как выглядит та вещь, которую ты потерял?»~
@26750 = ~«Ты должен бить... сильнее. Тебе не хватает... свирепости воина. А теперь *бей*!»~
@26751 = ~«Пожалуй, я не смогу помочь тебе. Прощай».~
@26752 = ~«Погоди минуту. У меня есть четки, которые ты ищешь. Это они?»~
@26753 = ~По прилавку разбросаны мириады колб, кувшинов и мензурок; большинство из них сейчас пусты.~
@26754 = ~«Хорошо. Я попробую поискать твои четки. Ты не знаешь, где мне найти этих головорезов?»~
@26755 = ~«Хорошо... продолжай... тренироваться».~
@26756 = ~Гуляя по Улью, я встретил человека с множеством меняющихся линий на коже. Он сказал, что у него украли четки его «ордена»... Наз Ледия, кажется... Их украли трое бандитов в черном и красном, которые, как он сказал, находятся у «бара, который горит изнутри». К счастью, я уже отобрал четки у тех головорезов, так что я могу отдать их незамедлительно.~
@26757 = ~«Три грабителя, одетых в красное и черное, у бара, что горит изнутри? Похоже, найти их будет несложно. Прощай».~
@26758 = ~«Три грабителя, одетых в красное и черное, у бара Тлеющий труп? Пойду поищу их. Прощай».~
@26759 = ~Гуляя по Улью, я встретил человека с множеством меняющихся линий на коже. Он сказал, что у него украли четки его «ордена»... Наз Ледия, кажется... Их украли трое бандитов в черном и красном, которые находятся у бара Тлеющий Труп. Попробую вернуть эту вещь назад.~
@26760 = ~Гуляя по Улью, я встретил человека с множеством меняющихся линий на коже. Он сказал, что у него украли четки его «ордена»... Наз Ледия, кажется... Их украли трое бандитов в черном и красном, которые, как он сказал, находятся у «бара, который горит изнутри». Попробую разыскать это место и вернуть эту вещь назад.~
@26761 = ~«Я убил их и забрал четки».~
@26762 = ~«Я украл их».~
@26763 = ~«Я купил их».~
@26764 = ~«Наврал им так, что они были счастливы отдать их мне».~
@26765 = ~«Я донес до них идею, что в их же интересах вернуть четки».~
@26766 = ~Ложь: «Э... Я переговорил с ними немного. Они были счастливы вернуть мне четки».~
@26767 = ~Ложь: «Э... Я их выкупил. Они были счастливы продать четки».~
@26768 = ~«Благодарю. И все-таки у меня вопрос: если ты не можешь вступать в битву, как же ты смог обучиться на воина?»~
@26769 = ~«Как насчет обучению оружию, которое ты обещал?»~
@26770 = ~«Если ты истинный воин, ты обучишься КАЖДОМУ оружию в своем распоряжении».~
@26771 = ~Правда: «О, я все равно прикончил воров».~
@26772 = ~Ложь: «О, я все равно прикончил воров».~
@26773 = ~«Если ты истинный воин, ты обучишься КАЖДОМУ оружию в своем распоряжении».~
@26774 = ~Правда: «О, я все равно прикончил воров».~
@26775 = ~Ложь: «О, я все равно прикончил воров».~
@26776 = ~«Если ты истинный воин, ты обучишься КАЖДОМУ оружию в своем распоряжении».~
@26777 = ~Правда: «О, я все равно прикончил воров».~
@26778 = ~Ложь: «О, я все равно прикончил воров».~
@26779 = ~«Не за что... наверное. И все-таки у меня вопрос: если ты не можешь вступать в битву, как же ты смог обучиться на воина?»~
@26780 = ~«Хм-м. Как насчет обучению оружию, которое ты обещал?»~
@26781 = ~«Понятно. Можешь ли ты меня научить использованию оружию?»~
@26782 = ~«Просто интересуюсь. Прощай».~
@26783 = ~«Надеюсь, что это так».~
@26784 = ~«Тогда неважно. Прощай».~
@26785 = ~«На данный момент у меня нет никакой специальности, кроме сражений. Я могу вступить на путь воина».~
@26786 = ~«Да. Я желаю оставить искусство мага и взяться за оружие».~
@26787 = ~«Я больше не хочу быть вором... Я хочу выбрать специальность воина».~
@26788 = ~«Нет, в этот раз. Прощай».~
@26789 = ~«Помни, цель наиболее уязвима, если сбить ее с толку».~
@26790 = ~«Хорошо...»~
@26791 = ~«Да».~
@26792 = ~«Я уже знаком с ними. Чему ты можешь меня обучить по части оружия?»~
@26793 = ~«Твои руки должны двигаться быстрее. Засунул — быстро высунул из кармана... иначе тебя точно вздернут».~
@26794 = ~«Не сейчас... Я должен переориентироваться. Спасибо, Порфирон».~
@26795 = ~«Я не понимаю. Ты можешь объяснить?»~
@26796 = ~«Я уже знаком с этими концепциями. Чему ты можешь меня обучить по части оружия?»~
@26797 = ~«Вообще-то, я вернусь позже, когда буду готов к обучению. Прощай».~
@26798 = ~Порфирон рассказал об обучении искусству воина. Он сказал, что для того, чтобы узнать о сражении больше, я должен выбрать специальность воина, и никакую больше. Будучи магом, вором или еще кем, я буду вынужден отказаться от этого, чтобы узнать больше об оружии и сражении. ~
@26799 = ~«Понял: если я хочу узнать больше об оружии, я должен быть только воином. Какой следующий элемент обучения?»~
@26800 = ~«Я уже знаком с этими концепциями. Чему ты можешь меня обучить по части оружия?»~
@26801 = ~«Вообще-то, я вернусь позже, когда буду готов к обучению. Прощай».~
@26802 = ~«Шнурок кошелька надо резать аккуратно. Мягко, но быстро».~
@26803 = ~Порфирон сказал, что есть предел, которым ограничен воин в изучении основных навыков воинского ремесла. Он настоял, чтобы я вернулся назад для дальнейшего обучения, как только получу больше опыта. ~
@26804 = ~«Понял: сперва я смогу обучиться только до определенного предела, который можно будет расширить, когда я достигну следующего уровня. Какой следующий элемент обучения?»~
@26805 = ~«Понял: сперва я смогу обучиться только до определенного предела, который можно будет расширить, когда я достигну следующего уровня. Какой следующий элемент обучения?»~
@26806 = ~«Я уже знаком с этими концепциями. Чему ты можешь меня обучить по части оружия?»~
@26807 = ~«Вообще-то, я вернусь позже, когда буду готов к обучению. Прощай».~
@26808 = ~«Что это за уровни?»~
@26809 = ~«Я уже знаком с основами. Чему ты можешь меня обучить по части оружия?»~
@26810 = ~«Я выслушал достаточно... Я вернусь позже, когда мне понадобится обучение».~
@26811 = ~«Очень похоже на то, когда я очнулся на плите Морга... продолжай. Что насчет опытного уровня?»~
@26812 = ~«Я уже знаком с основами. Чему ты можешь меня обучить по части оружия?»~
@26813 = ~«Я выслушал достаточно... Я вернусь позже, когда мне понадобится обучение».~
@26814 = ~«А уровень мастера?»~
@26815 = ~«Я уже знаком с основами. Чему ты можешь меня обучить по части оружия?»~
@26816 = ~«Я выслушал достаточно... Я вернусь позже, когда мне понадобится обучение».~
@26817 = ~Порфирон рассказал о трех уровнях владения оружием.

Уровень невежды, когда атакующий использует оружие как недостаток. Его атаки неумелы, неточны и наносят гораздо меньший урон, чем атаки более умелого воина. Кажется, с этого уровня я и начал, когда очнулся в Морге. Мне нужно тренироваться, чтобы лучше владеть оружием в этом мире.

Следующим за уровнем невежды является уровень опытного, который достигается воином после изучения оружия. Его атаки больше не затруднены незнанием оружия, и они намного быстрее и точнее.

Вслед за опытным уровнем следует уровень мастера. На этом уровне атакующий не только обучен владением оружия, но и превратил его в продолжение своей воли. Его атаки с изученным оружием быстрее, а наносимый им урон — больше.~
@26818 = ~«Хорошо, я понял. Чему ты можешь обучить меня по части оружия?»~
@26819 = ~«Я выслушал достаточно. Я еще вернусь. Прощай».~
@26820 = ~«Я хочу изучить кулачный бой».~
@26821 = ~«Я хочу изучить кулачный бой».~
@26822 = ~«Я хочу изучить кинжал».~
@26823 = ~«Я хочу изучить кинжал».~
@26824 = ~«Я хочу изучить дубину».~
@26825 = ~«Я хочу изучить дубину».~
@26826 = ~«Я хочу изучить боевой топор».~
@26827 = ~«Я хочу изучить боевой топор».~
@26828 = ~«Я хочу изучить молот».~
@26829 = ~«Я хочу изучить молот».~
@26830 = ~«Ты можешь еще раз рассказать о ратном деле?»~
@26831 = ~«На сегодня хватит. Я вернусь, когда захочу узнать больше».~
@26832 = ~«Да, я хочу изучить это оружие».~
@26833 = ~«Да, я хочу изучить это оружие».~
@26834 = ~«Нет... Каким еще видам оружия ты можешь меня обучить?»~
@26835 = ~«Не думаю, что сегодня я хочу тренироваться. Прощай».~
@26836 = ~С помощью Порфирона... и после многих синяков... я достиг уровня опытного в рукопашном бое.~
@26837 = ~«Да, я хочу изучить это оружие».~
@26838 = ~«Да, я хочу изучить это оружие».~
@26839 = ~«Нет... Каким еще видам оружия ты можешь меня обучить?»~
@26840 = ~«Не думаю, что сегодня я хочу тренироваться. Прощай».~
@26841 = ~С помощью Порфирона... и после нескольких шрамов... я достиг уровня опытного во владении кинжалами. Когда Порфирон обнаружил, что я быстро восстанавливаюсь после порезов, он перестал тратить время, используя меня в качестве разделочной доски.~
@26842 = ~Порфирон сказал, что он больше не может научить меня ничему новому во владении кинжалами. Он сказал, что если я хочу стать специалистом по кинжалам, я должен найти мастера оружия.~
@26843 = ~«Да, я хочу изучить это оружие».~
@26844 = ~«Соберись! Cфокусируй свою силу».~
@26845 = ~«Я вижу, у тебя уже лучше получается. Не останавливайся!»~
@26846 = ~«Великолепно... продолжай».~
@26847 = ~«Да, я хочу изучить это оружие».~
@26848 = ~«Нет... Каким еще видам оружия ты можешь меня обучить?»~
@26849 = ~«Не думаю, что сегодня я хочу тренироваться. Прощай».~
@26850 = ~С помощью Порфирона... и многих синяков... я достиг уровня опытного во владении дубинами.~
@26851 = ~Порфирон сказал, что он больше не может научить меня ничему новому во владении дубинами. Он сказал, что если я хочу стать специалистом по дубинам, я должен найти мастера оружия.~
@26852 = ~«Да, я хочу изучить это оружие».~
@26853 = ~«Да, я хочу изучить это оружие».~
@26854 = ~«Нет... Каким еще видам оружия ты можешь меня обучить?»~
@26855 = ~«Не думаю, что сегодня я хочу тренироваться. Прощай».~
@26856 = ~С помощью Порфирона... и после нескольких шрамов... я достиг уровня опытного во владении боевым топором. Когда Порфирон обнаружил, что я быстро восстанавливаюсь даже после тяжелых ран, он перестал тратить время, пытаясь колоть меня на дрова.~
@26857 = ~Порфирон сказал, что он больше не может научить меня ничему новому во владении боевыми топорами. Он сказал, что если я хочу стать специалистом по топорам, я должен найти мастера оружия.~
@26858 = ~«Да, я хочу изучить это оружие».~
@26859 = ~«Да, я хочу изучить это оружие».~
@26860 = ~«Нет... Каким еще видам оружия ты можешь меня обучить?»~
@26861 = ~«Не думаю, что сегодня я хочу тренироваться. Прощай».~
@26862 = ~С помощью Порфирона... и после нескольких синяков... я достиг уровня опытного во владении молотом. Думаю, нужно немного отдохнуть, пока я не свалился замертво от это звона в голове.~
@26863 = ~Порфирон сказал, что он больше не может научить меня ничему новому во владении молотами. Он сказал, что если я хочу стать специалистом по молотам, я должен найти мастера оружия.~
@26864 = ~«Да...»~
@26865 = ~«Спасибо. Я хотел бы изучить другое оружие, если ты станешь меня обучать».~
@26866 = ~«Спасибо. Я хотел бы изучить другое оружие, если ты станешь меня обучать».~
@26867 = ~«Спасибо. Это все, что я хотел узнать на сегодня».~
@26868 = ~«Ладно. Каким еще видам оружия ты можешь меня обучить?»~
@26869 = ~«Тогда пойду, поищу его. Прощай».~
@26870 = ~«Если ты не можешь обучить меня оружию, расскажи мне о ратном деле».~
@26871 = ~«Хорошо. Я вернусь, когда достигну нового уровня в ремесле».~
@26872 = ~Порфирон сказал, что ничему больше не может обучить по части оружия, что я уже достиг предела уровня знаний оружия. Он сказал, что я должен вернуться, когда достигну нового уровня ремесла, и тогда он сможет обучать меня дальше.~
@26873 = ~«Тогда пойду, поищу его. Прощай».~
@26874 = ~«Это было в завещании».~
@26875 = ~Порфирон сказал, что он больше не может научить меня ничему новому во владении оружием. Он сказал, что если я хочу стать специалистом по оружию, я должен найти мастера по оружию.~
@26876 = ~«Чему ты можешь меня обучить?»~
@26877 = ~«Спасибо, не сегодня. Может быть, потом».~
@26878 = ~«Чем могу тебе помочь, законник? — его лицо перекашивается от презрительной усмешки. — По мне, так тебе бы к лекарю сходить».~
@26879 = ~«Ты из числа тех, кто ограбил монаха в Улье? Забрал его четки?»~
@26880 = ~«У меня есть вопросы к тебе...»~
@26881 = ~«Убери эту ухмылочку с лица, или это тебе понадобится лекарь, 'законник'».~
@26882 = ~«Тогда забудь об этом. Прощай».~
@26883 = ~«Задвинься! Нет времени на вопросы и ответы, законник, — он сплевывает тебе под ноги. — ПРОВАЛИВАЙ, бестолочь несчастная!»~
@26884 = ~«Ты из числа тех, кто ограбил монаха в Улье? Забрал его четки?»~
@26885 = ~«Мне кажется, что это тебе нужно проваливать».~
@26886 = ~«Тогда забудь об этом. Прощай».~
@26887 = ~«На твоем месте я бы не стал разбрасываться такими угрозами. Еще хоть одна слетит с твоего языка — и я подарю тебе вторую улыбку, усек?»~
@26888 = ~«Если считаешь, что можешь одолеть меня, тогда вперед».~
@26889 = ~«Тогда забудь об этом. Прощай».~
@26890 = ~«Это тот бедолага с линиями по всей роже? Который грозился, что может прописать нас всех в книгу мертвых, и при том позволил обчистить себя до нитки? — он улыбается, медленно и беззубо. — Не, никогда о нем не слышал».~
@26891 = ~«Может, тебе лучше вернуть его четки мне, пока *я* не прописал вас всех в книгу мертвых».~
@26892 = ~Ложь: «Вот *это* уже интересно. Весь его орден разыскивает тебя. Похоже, братья *Наз Ледия* довольно-таки неплохо о тебе осведомлены».~
@26893 = ~«Возможно, мы могли бы договориться. Эти четки не представляют ценности ни для кого, кроме членов его ордена. Я мог бы их выкупить».~
@26894 = ~«Тогда забудь об этом. Прощай».~
@26895 = ~Человек хмурится. «Нет, я к ним привязался. Не могу их отдать... разве что за кучку монет. Скажем, пятнадцать медяков?»~
@26896 = ~«Идет».~
@26897 = ~«Как насчет десяти?»~
@26898 = ~Блеф: «Нет, оно того не стоит. Пусть его орден поохотится за тобой. Наверняка братья *Наз Ледия* смогут с тобой договориться, только это тебе вряд ли понравится».~
@26899 = ~«Твоя цена мне не по карману. Может, в другой раз».~
@26900 = ~«Неважно. Прощай».~
@26901 = ~«Ладно, по рукам. Держи...»~
@26902 = ~«Спасибо».~
@26903 = ~«Э, ну... ладно. Все равно эта штуковина выглядит по-уродски. Держи...»~
@26904 = ~«Спасибо».~
@26905 = ~«А? — его ухмылка меркнет. — О чем это ты? Какие еще братья? Тот бедолага был один».~
@26906 = ~Ложь: «Ты глупец. Он — член религиозного ордена. Эти 'четки', которые ты украл, — их самая священная реликвия. Если ее не вернуть, ВЕСЬ его орден будет за тобой охотиться... а у них нет никаких предрассудков насчет убийства воров».~
@26907 = ~«Неважно. Прощай».~
@26908 = ~Он выпучивает глаза. «Э... ну... мы просто взяли их ненадолго». Он запускает руку в складку одежды, вытягивает четки и бережно передает их тебе. «Вот они, без обид, лады?»~
@26909 = ~Ложь: «Надеюсь, этого будет достаточно, чтобы утихомирить его орден. Возможно, небольшое пожертвование тоже не будет лишним. Это поможет сгладить углы и уберечь тебя от их проклятий».~
@26910 = ~«Твоя мудрость способна двигать горы. Прощай».~
@26911 = ~Я поговорил с одним из бандитов насчет ожерелья Порфирона и убедил его с помощью... безобидной.. лжи: если он не вернет ожерелье, то за ним придут более «воинственные» братья из ордена, в котором состоит Порфирон. В качестве завершающего удара я попросил у него о пожертвовании, чтобы оградить его от проклятий, которые может наслать на него орден, и ускользнул с приличной суммой медяков. ~
@26912 = ~Я поговорил с одним из бандитов насчет ожерелья Порфирона и с помощью... безвредной... лжи убедил его в том, что если он не вернет четки, за ним придут более «воинственные» братья ордена Порфирона.~
@26913 = ~«Проклятий?! — он выводит полукруг напротив сердца. — Э, ну, мне бы этого не хотелось... — он достает из кошелька на поясе несколько медных монет и дает их тебе. — Возьми это с моим благословением, законник. Передай, что я не желал ему зла».~
@26914 = ~«Благодарю за пожертвование. Прощай».~
@26915 = ~Этот крупный головорез закутан в красно-черные лохмотья. Он выглядит так, словно сделан целиком из мускулов. Когда ты подходишь, он сердито смотрит на тебя и показывает оскорбительный жест. «Отвали, законник. Нам больше не о чем говорить!»~
@26916 = ~«Мне кажется, что это тебе нужно проваливать».~
@26917 = ~«Отлично. Прощай».~
@26918 = ~«Я — низшая танарри, а точнее, суккуб, — она тихонько вздыхает. — Боюсь, что мы уж слишком распространенные на Нижних планах и в других местах, что не в нашу пользу. Большинство представителей моей расы проводят свое время, соблазняя смертных различными плотскими утехами».~
@26919 = ~«А ты?..»~
@26920 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@26921 = ~«Я должен идти. Прощай».~
@26922 = ~«Хотелось бы думать, что я дистанцировалась от всего этого... В конце концов, это слишком примитивный и непродуктивный способ тратить свое время в мультивселенной. Ведь есть гораздо более интересные занятия, не так ли?»~
@26923 = ~«Пожалуй, да. Могу ли я задать тебе другие вопросы?»~
@26924 = ~Прикоснувшись к этой книге, ты слышишь голос: «Приветствую тебя, хозяин. Чем может услужить тебе сей скромный фолиант?»~
@26925 = ~«Ты умеешь говорить?»~
@26926 = ~«Ты умеешь говорить?»~
@26927 = ~«Ничем. Хватит разговаривать со мной».~
@26928 = ~«Как пожелаешь, хозяин. Просто обратись ко мне, и я помогу тебе любым доступным способом».~
@26929 = ~«Собственно, скажи, что ты умеешь».~
@26930 = ~«Отлично. А теперь умолкни».~
@26931 = ~«Хозяин, я могу разговаривать на многих языках. Только ты должен позаботиться, чтобы наш разговор не заметили, поскольку меня они не могут слышать. И еще, хозяин: речь — лишь одна из моих способностей».~
@26932 = ~«Что ты умеешь? Какие у тебя есть способности?»~
@26933 = ~«Как Мантуок завладел тобой?»~
@26934 = ~«Расскажи мне о себе».~
@26935 = ~«Пока достаточно».~
@26936 = ~«Хозяин, я могу подарить тебе способности, с которыми в трудную минуту ты сможешь сделать больше, а еще могу дать тебе совет».~
@26937 = ~«О каких способностях ты говоришь?»~
@26938 = ~«Дай мне совет».~
@26939 = ~«Дай мне совет».~
@26940 = ~«Дай мне совет».~
@26941 = ~«Дай мне совет».~
@26942 = ~«Дай мне совет».~
@26943 = ~«Дай мне совет».~
@26944 = ~«Дай мне совет».~
@26945 = ~«Дай мне совет».~
@26946 = ~«Дай мне совет».~
@26947 = ~«Дай мне совет».~
@26948 = ~«Дай мне совет».~
@26949 = ~«Дай мне совет».~
@26950 = ~«Дай мне совет».~
@26951 = ~«Дай мне совет».~
@26952 = ~«Дай мне совет».~
@26953 = ~«Дай мне совет».~
@26954 = ~«Забудь об этом. Ответь мне на пару вопросов».~
@26955 = ~«Что ты хочешь узнать, хозяин?»~
@26956 = ~«Что ты умеешь? Какие у тебя есть способности?»~
@26957 = ~«Как Мантуок завладел тобой?»~
@26958 = ~«Расскажи мне о себе».~
@26959 = ~«Дай мне совет».~
@26960 = ~«Дай мне совет».~
@26961 = ~«Дай мне совет».~
@26962 = ~«Дай мне совет».~
@26963 = ~«Дай мне совет».~
@26964 = ~«Дай мне совет».~
@26965 = ~«Дай мне совет».~
@26966 = ~«Дай мне совет».~
@26967 = ~«Дай мне совет».~
@26968 = ~«Дай мне совет».~
@26969 = ~«Дай мне совет».~
@26970 = ~«Дай мне совет».~
@26971 = ~«Дай мне совет».~
@26972 = ~«Дай мне совет».~
@26973 = ~«Дай мне совет».~
@26974 = ~«Дай мне совет».~
@26975 = ~«Пока достаточно».~
@26976 = ~«Больной крысомаг раскопал меня в катакомбах, хозяин. Он освободил меня от хватки моего бывшего хозяина, теперь уже давно почившего. Он принес меня в свое гнездо, чтобы изучить меня. Однако его способности оказались ограниченными... с ним было трудно разговаривать, и он мало что понял из того, чему я его обучал».~
@26977 = ~«Расскажи мне о силах, которыми ты обладаешь».~
@26978 = ~«Понятно. Ответь мне на несколько вопросов».~
@26979 = ~«И то правда. Прощай».~
@26980 = ~«Заданный тобой вопрос непрост, хозяин, однако твой покорный слуга постарается ответить на него наилучшим образом. Я — кодекс давно забытых мгновений, давно утерянных идей, суждений о других временах и других мирах. На моих страницах собраны знания забытых цивилизаций. Все по существу, хозяин, но самое важное вот что: в моих страницах кроется СИЛА. Сила, которая может стать твоей... хозяин».~
@26981 = ~«Расскажи мне о силах, которыми ты обладаешь».~
@26982 = ~«Сейчас меня это не интересует. Лучше ответь на пару вопросов».~
@26983 = ~«Неинтересно. Прощай, книга».~
@26984 = ~«Хозяин, я дам тебе такой совет: Будь осторожен с теми, с кем ты близок. Никогда им полностью не доверяй, и никогда не ослабляй себя, делясь с ними своей силой. Множество известных мне императоров поступали так, и я не желаю тебе их участи».~
@26985 = ~«Дай мне еще один совет».~
@26986 = ~«Хорошо. У меня есть другие вопросы».~
@26987 = ~«Достаточно».~
@26988 = ~«Тогда, хозяин, я дам тебе такой совет. Если кто-то клянется тебе в дружбе — позволь ему доказать это. В словах мало веса, в отличие от действий. Настоящие друзья будут готовы умереть за тебя».~
@26989 = ~«Дай мне еще один совет».~
@26990 = ~«Хорошо. У меня есть другие вопросы».~
@26991 = ~«Достаточно».~
@26992 = ~Ты ощущаешь легкое напряжение в груди, когда книга произносит: «Тогда, хозяин, я дам тебе такой совет. Не выдавай слабости, не признавай ошибок, не сомневайся. Такие вещи говорят другим о том, что ты не уверен, словно шаткий камень, который можно опрокинуть».~
@26993 = ~«Дай мне еще один совет».~
@26994 = ~«Хорошо. У меня есть другие вопросы».~
@26995 = ~«Достаточно».~
@26996 = ~«Тогда, хозяин, я дам тебе такой совет. Остерегайся милосердия. Открытая спина беззащитна против ножа убийцы».~
@26997 = ~«Дай мне еще один совет».~
@26998 = ~«Хорошо. У меня есть другие вопросы».~
@26999 = ~«Достаточно».~
@27000 = ~«Тогда, хозяин, я дам тебе такой совет. Остерегайся распространенных мнений о любви. Любовь нередко должна быть жестокой, дабы возвыситься над обычными сантиментами».~
@27001 = ~«Дай мне еще один совет».~
@27002 = ~«Хорошо. У меня есть другие вопросы».~
@27003 = ~«Достаточно».~
@27004 = ~Ты ощущаешь, как легкая ухмылка поднимает кончики твоего рта. Ты спешно подавляешь ее. «Тогда, хозяин, я дам тебе такой совет: Отдели себя от недалеких глупцов и слабаков, осознав, что у тебя есть предназначение. Одно лишь это даст тебе право идти там, где другие побоялись бы пройти».~
@27005 = ~«Дай мне еще один совет».~
@27006 = ~«Хорошо. У меня есть другие вопросы».~
@27007 = ~«Достаточно».~
@27008 = ~«Тогда, хозяин, я дам тебе такой совет. Есть два секрета успеха. Один из них — никогда не показывай всего, что знаешь».~
@27009 = ~«Дай мне еще один совет».~
@27010 = ~«Хорошо. У меня есть другие вопросы».~
@27011 = ~«Достаточно».~
@27012 = ~«Тогда, хозяин, я дам тебе такой совет. Чтобы обрести могущество, ты должен быть готовым пожертвовать чем угодно: и собой, и дорогими тебе вещами. Власть — это сделка. Нужно отдавать, чтобы получать».~
@27013 = ~«Дай мне еще один совет».~
@27014 = ~«Хорошо. У меня есть другие вопросы».~
@27015 = ~«Достаточно».~
@27016 = ~Книга дала мне совет: «Будь осторожен с теми, с кем ты близок. Никогда им полностью не доверяй, и никогда не ослабляй себя, делясь с ними своей силой. Множество известных мне императоров поступали так, и я не желаю тебе их участи».~
@27017 = ~Книга дала мне совет: «Если кто-то клянется тебе в дружбе — позволь ему доказать это. В словах мало веса, в отличие от действий. Настоящие друзья будут готовы умереть за тебя».~
@27018 = ~Книга дала мне совет: «Не выдавай слабости, не признавай ошибок, не сомневайся. Такие вещи говорят другим о том, что ты не уверен, словно шаткий камень, который можно опрокинуть».~
@27019 = ~Книга дала мне совет: «Остерегайся милосердия. Открытая спина беззащитна против ножа убийцы».~
@27020 = ~Книга дала мне совет: «Остерегайся распространенных мнений о любви. Любовь нередко должна быть жестокой, дабы возвыситься над обычными сантиментами».~
@27021 = ~Книга дала мне совет: «Отдели себя от недалеких глупцов и слабаков, осознав, что у тебя есть предназначение. Одно лишь это даст тебе право идти там, где другие побоялись бы пройти».~
@27022 = ~Книга дала мне совет: «Есть два секрета успеха. Один из них — никогда не показывай всего, что знаешь».~
@27023 = ~Книга дала мне совет: «Чтобы обрести могущество, ты должен быть готовым пожертвовать чем угодно: и собой, и дорогими тебе вещами. Власть — это сделка. Нужно отдавать, чтобы получать».~
@27024 = ~Твоя кровь, казалось бы, замедляет свой ход, когда книга произносит: «Тогда, хозяин, я дам тебе такой совет. Честь и добродетель — идеи, которые губят человека и его дух. Они — всего лишь отвлеченные понятия, которые побуждают к странным поступкам и приводят к смерти. Будь честен с собой и подчиняйся только собственной воле».~
@27025 = ~«Дай мне еще один совет».~
@27026 = ~«Хорошо. У меня есть другие вопросы».~
@27027 = ~«Достаточно».~
@27028 = ~Книга дала мне совет: «Честь и добродетель — идеи, которые губят человека и его дух. Они — всего лишь отвлеченные понятия, которые побуждают к странным поступкам и приводят к смерти. Будь честен с собой и подчиняйся только собственной воле».~
@27029 = ~«Тогда, хозяин, я дам тебе такой совет. Не жалей тех, кто подарил тебе страдания жизни. Поступая так, ты открыто признаешь свою слабость».~
@27030 = ~«Дай мне еще один совет».~
@27031 = ~«Хорошо. У меня есть другие вопросы».~
@27032 = ~«Достаточно».~
@27033 = ~Книга дала мне совет: «Не жалей тех, кто подарил тебе страдания жизни. Поступая так, ты открыто признаешь свою слабость».~
@27034 = ~«Тогда, хозяин, я дам тебе такой совет. Душа человека — море эмоций. Часто люди пытаются привести свои чувства в порядок, но этот порядок ложен. Хаос — вот естественное состояние человека, и ему следует отдаться сполна».~
@27035 = ~«Дай мне еще один совет».~
@27036 = ~«Хорошо. У меня есть другие вопросы».~
@27037 = ~«Достаточно».~
@27038 = ~Книга дала мне совет: «Душа человека — море эмоций. Часто люди пытаются привести свои чувства в порядок, но этот порядок ложен. Хаос — вот естественное состояние человека, и ему следует отдаться сполна».~
@27039 = ~«Тогда, хозяин, я дам тебе такой совет. Познай значение милосердия, пользуйся им в своих целях... но никогда его не практикуй».~
@27040 = ~«Дай мне еще один совет».~
@27041 = ~«Хорошо. У меня есть другие вопросы».~
@27042 = ~«Достаточно».~
@27043 = ~Книга дала мне совет: «Познай значение милосердия, пользуйся им в своих целях... но никогда его не практикуй».~
@27044 = ~«Тогда, хозяин, я дам тебе такой совет. Воспитывай в других страх, потому что только страх управляет людьми. Ничто иное не оставляет таких глубоких шрамов».~
@27045 = ~«Дай мне еще один совет».~
@27046 = ~«Хорошо. У меня есть другие вопросы».~
@27047 = ~«Достаточно».~
@27048 = ~Книга дала мне совет: «Воспитывай в других страх, потому что только страх управляет людьми. Ничто иное не оставляет таких глубоких шрамов».~
@27049 = ~«Тогда, хозяин, я дам тебе такой совет. Улыбайся и протягивай руку дружбы своим врагам, а когда они принимают ее — бей их кинжалом в другой руке. А иначе они, несомненно, сделают с тобой то же самое».~
@27050 = ~«Дай мне еще один совет».~
@27051 = ~«Хорошо. У меня есть другие вопросы».~
@27052 = ~«Достаточно».~
@27053 = ~Книга дала мне совет: «Улыбайся и протягивай руку дружбы своим врагам, а когда они принимают ее — бей их кинжалом в другой руке. А иначе они, несомненно, сделают с тобой то же самое».~
@27054 = ~Когда книга произносит следующие слова, ты ощущаешь в своем сердце тяжелую прохладу; ты чувствуешь какой-то неприятный осадок. «Хозяин, это последний мой совет. Выслушай его внимательно. Помни, что ты способен уничтожить все, что считаешь неприемлемым. Тебе нужно лишь захотеть».~
@27055 = ~«Дай мне еще один совет».~
@27056 = ~«Хорошо. У меня есть другие вопросы».~
@27057 = ~«Достаточно».~
@27058 = ~Книга дала мне совет: «Помни, что ты способен уничтожить все, что считаешь неприемлемым. Тебе нужно лишь захотеть».~
@27059 = ~«Мне жаль, хозяин, что я больше не могу поделиться с тобой мудростью. Ты многому обучился, слушая мои советы; поразмышляй над ними».~
@27060 = ~«Хорошо. У меня есть другие вопросы».~
@27061 = ~«Достаточно».~
@27062 = ~«Хозяин, это способности, которые могут безмерно улучшить твою жизнь. К несчастью, управляющие мной законы... требуют небольшую услугу в обмен на них».~
@27063 = ~«Небольшую услугу? Например?»~
@27064 = ~«Тогда я ничего не хочу».~
@27065 = ~«Услуга эта пустяковая, хозяин. Мне вряд ли пришлось бы вспоминать о ней, если бы не законы, связывающие меня с этими страницами... — книга делает паузу. — Чтобы раскрыть мою силу, ты должен лишь пожертвовать небольшой частичкой себя, хозяин. Ты должен пролить кровь на мою первую страницу. Это действие укрепит связь между нами и позволит мне раскрыть весь твой потенциал. Это небольшая плата за заклинания, которые окажутся в твоем распоряжении».~
@27066 = ~«Хорошо. Вот».~
@27067 = ~«Нет».~
@27068 = ~Эта странная книга, которую я подобрал, попросила меня пролить на ее страницы пару капель крови. Я сделал это, и получил заклинание. Кроме того, она пообещала мне больше силы.~
@27069 = ~Ты делаешь порез и позволяешь нескольким каплям упасть на страницу. Твои кости охватывает странный озноб; ты чувствуешь боль и пустоту. И в то же время ты ощущаешь триумф: ты изучил новое заклинание, Слепоту. «Теперь эта сила твоя... хозяин. Знай, что это лишь первая из сил, хранящихся на моих страницах».~
@27070 = ~«Расскажи мне об остальных силах».~
@27071 = ~«Ответь мне еще на несколько вопросов».~
@27072 = ~«Мне нужен от тебя совет».~
@27073 = ~«Пока мне больше ничего не нужно».~
@27074 = ~«Хозяин, что я могу тебе предложить? Ты хочешь удовлетворить свое любопытство?»~
@27075 = ~«Да. Ответь мне на пару вопросов».~
@27076 = ~«Нет».~
@27077 = ~«Хозяин, это всего лишь небольшая жертва в обмен на большое приобретение... но выбор за тобой. Предложение остается открытым».~
@27078 = ~«Хорошо. Ответь мне на пару вопросов».~
@27079 = ~«Хорошо. Прощай».~
@27080 = ~Эта странная книга, которую я нашел, попросила небольшой кусочек меня в обмен на силу. Я отказал. Тем не менее, предложение все еще в силе.~
@27081 = ~«Тогда помни, что позже тебе может понадобиться увеличить свое могущество, и что я буду ждать тебя... хозяин».~
@27082 = ~«Хорошо. Прощай».~
@27083 = ~Голос книги кажется опечаленным. «Хозяин, к сожалению, законы, управляющие мной, требуют большей жертвы за более могущественную силу. Она досталась бы тебе бесплатно, но, насколько ты видишь, мне не выбирать».~
@27084 = ~«Что это за жертва?»~
@27085 = ~«Тогда забудь об этом».~
@27086 = ~«Вторая жертва заключается в том, что ты должен продать одного из своих товарищей в плен, неволю, рабство. Это усилит связь между тобой и силой: твой товарищ представляет собой силу, находящуюся в твоем распоряжении. Насколько я понимаю, в Чиновничьем районе есть тот, кто поможет тебе в этом. Разыщи поставщицу Вришику».~
@27087 = ~«Я подумаю над этим. Дай мне совет, ладно?»~
@27088 = ~«Я сделаю это. Дай мне совет, ладно?»~
@27089 = ~«Я подумаю. Мне нужны твои ответы».~
@27090 = ~«Я сделаю это. Но сначала мне нужно получить от тебя пару ответов».~
@27091 = ~«Я подумаю над этим. Прощай».~
@27092 = ~Книга предложила мне еще одно заклинание в обмен на продажу одного из моих товарищей в рабство. Если я хочу увидеть эту силу, мне нужно найти поставщицу Вришику.~
@27093 = ~Книга предложила мне еще одно заклинание в обмен на продажу одного из моих товарищей в рабство. Если я хочу увидеть эту силу, мне нужно найти поставщицу Вришику. Я согласился сделать это.~
@27094 = ~«Печально, что ты так низко оцениваешь мое могущество. Не позволяй сомнениям и смятению мешать тебе, хозяин... однако мои слова были поспешными. Помни: предложение остается открытым».~
@27095 = ~«Я сделаю это. Дай мне совет, ладно?»~
@27096 = ~«Я подумаю. Мне нужны твои ответы».~
@27097 = ~«Я подумаю над этим. Прощай».~
@27098 = ~«Хозяин, возможно, ты решился продолжить обучение? Предложение об улучшении твоих способностей остается в силе».~
@27099 = ~«Скажи, что мне нужно делать».~
@27100 = ~«Еще нет. Ответь мне на пару вопросов».~
@27101 = ~«Пока нет. Мне нужен от тебя совет».~
@27102 = ~«Нет. Прощай».~
@27103 = ~«Хозяин, возможно, ты решился продолжить обучение? Предложение об улучшении твоих способностей остается в силе, но ты должен принести вторую жертву».~
@27104 = ~«Ладно, я это сделаю. А теперь ответь на мои вопросы».~
@27105 = ~«Звучит справедливо. Я это сделаю. Мне нужен еще один совет».~
@27106 = ~«Я подумаю над этим. Дай мне совет».~
@27107 = ~«Сперва мне нужно получить ответы на несколько вопросов».~
@27108 = ~«Не сейчас. Прощай».~
@27109 = ~«Хозяин, ты совершил вторую жертву? Воздух вокруг тебя говорит, что ты сделал это. Ты отлично справился; ты быстро учишься. Услышь эти слова и узнай больше». Книга произносит какое-то неразборчивое слово, и ты чувствуешь жжение в груди. Теперь ты знаешь заклинание Поцелуй гадюки.~
@27110 = ~«Ты можешь научить меня чему-то еще, книга?»~
@27111 = ~«Спасибо. Прощай».~
@27112 = ~Книга дала мне заклинание Поцелуй гадюки в обмен на продажу одного из моих товарищей в рабство.~
@27113 = ~«Тебе нужны ответы?»~
@27114 = ~«Как Мантуок завладел тобой?»~
@27115 = ~«Расскажи мне о себе».~
@27116 = ~«Ты можешь дать мне совет?» ~
@27117 = ~«У тебя есть для меня еще силы?»~
@27118 = ~«Какую жертву мне нужно принести ради новой способности?»~
@27119 = ~«Хватит. Прощай».~
@27120 = ~«Тебе нужны мои знания... хозяин?»~
@27121 = ~«Да».~
@27122 = ~«Да».~
@27123 = ~«Да».~
@27124 = ~«Да».~
@27125 = ~«Да».~
@27126 = ~«Да».~
@27127 = ~«Да».~
@27128 = ~«Да».~
@27129 = ~«Да».~
@27130 = ~«Да».~
@27131 = ~«Да».~
@27132 = ~«Да».~
@27133 = ~«Да».~
@27134 = ~«Да».~
@27135 = ~«Да».~
@27136 = ~«Да».~
@27137 = ~«Лучше ответь мне на пару вопросов».~
@27138 = ~«Пока достаточно».~
@27139 = ~«Я дам тебе такой совет: Будь осторожен с теми, с кем ты близок. Никогда им полностью не доверяй, и никогда не ослабляй себя, делясь с ними своей силой. Множество известных мне императоров поступали так, и я не желаю тебе их участи».~
@27140 = ~«Дай мне еще один совет».~
@27141 = ~«Хорошо. У меня есть другие вопросы».~
@27142 = ~«Достаточно».~
@27143 = ~«Тогда я дам тебе такой совет. Если кто-то клянется тебе в дружбе — позволь ему доказать это. В словах мало веса, в отличие от действий. Настоящие друзья будут готовы умереть за тебя».~
@27144 = ~«Дай мне еще один совет».~
@27145 = ~«Хорошо. У меня есть другие вопросы».~
@27146 = ~«Достаточно».~
@27147 = ~Ты ощущаешь легкое напряжение в груди, когда книга произносит: «Тогда я дам тебе такой совет. Не выдавай слабости, не признавай ошибок, не колебайся. Такие вещи говорят другим о том, что ты не уверен, словно шаткий камень, который можно опрокинуть».~
@27148 = ~«Дай мне еще один совет».~
@27149 = ~«Хорошо. У меня есть другие вопросы».~
@27150 = ~«Достаточно».~
@27151 = ~«Тогда я дам тебе такой совет. Остерегайся милосердия. Открытая спина беззащитна против ножа убийцы».~
@27152 = ~«Дай мне еще один совет».~
@27153 = ~«Хорошо. У меня есть другие вопросы».~
@27154 = ~«Достаточно».~
@27155 = ~«Тогда я дам тебе такой совет. Остерегайся распространенных мнений о любви. Любовь нередко должна быть жестокой, дабы возвыситься над обычными сантиментами».~
@27156 = ~«Дай мне еще один совет».~
@27157 = ~«Дай мне еще один совет».~
@27158 = ~«Хорошо. У меня есть другие вопросы».~
@27159 = ~«Достаточно».~
@27160 = ~Ты ощущаешь, как легкая ухмылка поднимает кончики твоего рта. Ты спешно подавляешь ее. «Тогда я дам тебе такой совет: Отдели себя от недалеких глупцов и слабаков, осознав, что у тебя есть предназначение. Одно лишь это даст тебе право идти там, где другие побоялись бы пройти».~
@27161 = ~«Дай мне еще один совет».~
@27162 = ~«Хорошо. У меня есть другие вопросы».~
@27163 = ~«Достаточно».~
@27164 = ~«Тогда я дам тебе такой совет. Есть два секрета успеха. Один из них — никогда не показывай всего, что знаешь».~
@27165 = ~«Дай мне еще один совет».~
@27166 = ~«Хорошо. У меня есть другие вопросы».~
@27167 = ~«Достаточно».~
@27168 = ~«Тогда я дам тебе такой совет. Чтобы обрести могущество, ты должен быть готовым пожертвовать чем угодно: и собой, и дорогими тебе вещами. Власть — это сделка. Нужно отдавать, чтобы получать».~
@27169 = ~«Дай мне еще один совет».~
@27170 = ~«Хорошо. У меня есть другие вопросы».~
@27171 = ~«Достаточно».~
@27172 = ~Твоя кровь, казалось бы, замедляет свой ход, когда книга произносит: «Тогда я дам тебе такой совет. Честь и добродетель — идеи, которые губят человека и его дух. Они — всего лишь отвлеченные понятия, которые побуждают к странным поступкам и приводят к смерти. Будь честен с собой и подчиняйся только собственной воле».~
@27173 = ~«Дай мне еще один совет».~
@27174 = ~«Хорошо. У меня есть другие вопросы».~
@27175 = ~«Достаточно».~
@27176 = ~«Тогда я дам тебе такой совет. Не жалей тех, кто подарил тебе страдания жизни. Поступая так, ты открыто признаешь свою слабость».~
@27177 = ~«Дай мне еще один совет».~
@27178 = ~«Хорошо. У меня есть другие вопросы».~
@27179 = ~«Достаточно».~
@27180 = ~«Тогда я дам тебе такой совет. Душа человека — море эмоций. Часто люди пытаются привести свои чувства в порядок, но этот порядок ложен. Хаос — вот естественное состояние человека, и ему следует отдаться сполна».~
@27181 = ~«Дай мне еще один совет».~
@27182 = ~«Хорошо. У меня есть другие вопросы».~
@27183 = ~«Достаточно».~
@27184 = ~«Тогда я дам тебе такой совет. Познай значение милосердия, пользуйся им в своих целях... но никогда его не практикуй».~
@27185 = ~«Дай мне еще один совет».~
@27186 = ~«Хорошо. У меня есть другие вопросы».~
@27187 = ~«Достаточно».~
@27188 = ~«Тогда я дам тебе такой совет. Воспитывай в других страх, потому что только страх управляет людьми. Ничто иное не оставляет таких глубоких шрамов».~
@27189 = ~«Дай мне еще один совет».~
@27190 = ~«Хорошо. У меня есть другие вопросы».~
@27191 = ~«Достаточно».~
@27192 = ~«Тогда я дам тебе такой совет. Улыбайся и протягивай руку дружбы своим врагам, а когда они принимают ее — бей их кинжалом в другой руке. А иначе они, несомненно, сделают с тобой то же самое».~
@27193 = ~«Дай мне еще один совет».~
@27194 = ~«Хорошо. У меня есть другие вопросы».~
@27195 = ~«Достаточно».~
@27196 = ~Когда книга произносит следующие слова, ты ощущаешь в своем сердце тяжелую прохладу; ты чувствуешь какой-то неприятный осадок. «Это последний мой совет. Выслушай его внимательно. Помни, что ты способен уничтожить все, что считаешь неприемлемым. Тебе нужно лишь захотеть».~
@27197 = ~«Дай мне еще один совет».~
@27198 = ~«Хорошо. У меня есть другие вопросы».~
@27199 = ~«Достаточно».~
@27200 = ~«Мне жаль, что я больше не могу поделиться с тобой мудростью. Ты многому обучился, слушая мои советы; поразмышляй над ними».~
@27201 = ~«Хорошо. У меня есть другие вопросы».~
@27202 = ~«Достаточно».~
@27203 = ~Книга вздыхает: «Больной крысомаг раскопал меня в катакомбах. Он освободил меня от хватки моего бывшего хозяина. Он принес меня в свое гнездо, однако его способности оказались ограниченными, и он мало что понял из моего обучения».~
@27204 = ~«Расскажи мне о силах, которыми ты обладаешь».~
@27205 = ~«Расскажи мне о силах, которыми ты обладаешь».~
@27206 = ~«Понятно. Ответь мне на несколько вопросов».~
@27207 = ~«И то правда. Прощай».~
@27208 = ~«Я и есть сила, хозяин, и я могу обучить тебя большему».~
@27209 = ~«Как?»~
@27210 = ~«Напомни мне».~
@27211 = ~«Сейчас меня это не интересует. Лучше ответь на пару вопросов».~
@27212 = ~«Неинтересно. Прощай, книга».~
@27213 = ~«Всему свое время, всему свое время! Прояви терпение! Ты уже показал, что готов делать все, что потребуется, чтобы достичь этой силы, и ты должен понимать, что за эту силу придется ЗАПЛАТИТЬ».~
@27214 = ~«Что мне нужно сделать?»~
@27215 = ~«Я заплатил достаточно. Забудь об этом».~
@27216 = ~Книга презрительно произносит: «Зайти так далеко, только чтобы теперь отступить. Какой позор. Ты не так силен, как мне казалось».~
@27217 = ~«Как бы там ни было, ответь мне на пару вопросов».~
@27218 = ~«Отлично. Что мне нужно делать?»~
@27219 = ~«Ну и ладно. Прощай».~
@27220 = ~«Нет. Я не буду делать этого, пока ты не продемонстрируешь стремление к раскрытию своего потенциала».~
@27221 = ~«Что мне нужно сделать?»~
@27222 = ~«Тогда забудь об этом».~
@27223 = ~«Тогда будь что будет. Одна дорога ведет к провалу, другая — к успеху».~
@27224 = ~«Отлично».~
@27225 = ~«У тебя есть товарищи, которых ты готов предать?»~
@27226 = ~«Как насчет Морта?»~
@27227 = ~«Как насчет Анны?»~
@27228 = ~«Как насчет Даккона?»~
@27229 = ~«Как насчет Падшей Грации?»~
@27230 = ~«Как насчет Нордома?»~
@27231 = ~«Как насчет Вейлора?»~
@27232 = ~«Как насчет Игнуса?»~
@27233 = ~«Таких нет».~
@27234 = ~«У меня нет товарищей».~
@27235 = ~Книга предложила мне еще большие способности в обмен на убийство одного из моих товарищей. Соблазнительно, как ни крути...~
@27236 = ~«Я могу предложить тебе еще одну силу. Ты показал, что готов делать все, что потребуется, лишь бы довести дело до конца. Твое последнее задание — убить одного из своих спутников в одиночку, без заклинаний».~
@27237 = ~«Как насчет Морта?»~
@27238 = ~«Как насчет Анны?»~
@27239 = ~«Как насчет Даккона?»~
@27240 = ~«Как насчет Падшей Грации?»~
@27241 = ~«Как насчет Нордома?»~
@27242 = ~«Как насчет Вейлора?»~
@27243 = ~«Как насчет Игнуса?»~
@27244 = ~«Я так не думаю».~
@27245 = ~«У меня нет товарищей».~
@27246 = ~«Тьфу. Тогда я больше не буду тратить время на попытки обучить тебя. Где твое честолюбие? Где твоя страсть? Да ты просто беспомощный глупец».~
@27247 = ~«Ладно. Как насчет Морта?»~
@27248 = ~«Ладно. Как насчет Анны?»~
@27249 = ~«Ладно. Как насчет Даккона?»~
@27250 = ~«Ладно. Как насчет Падшей Грации?»~
@27251 = ~«Ладно. Как насчет Нордома?»~
@27252 = ~«Ладно. Как насчет Вейлора?»~
@27253 = ~«Ладно. Как насчет Игнуса?»~
@27254 = ~«Как я уже говорил, я никем не буду пожертвовать. Никакая способность не стоит этого».~
@27255 = ~До этого ты не подозревал, что книги умеют усмехаться. «Тогда страдай в темноте, глупец».~
@27256 = ~«Я передумал. Я убью Морта».~
@27257 = ~«Я передумал. Я убью Анну».~
@27258 = ~«Я передумал. Я убью Даккона».~
@27259 = ~«Я передумал. Я убью Падшую Грацию».~
@27260 = ~«Я передумал. Я убью Нордома».~
@27261 = ~«Я передумал. Я убью Вейлора».~
@27262 = ~«Я передумал. Я убью Игнуса».~
@27263 = ~«У меня нет товарищей».~
@27264 = ~«Хорошо. Прощай».~
@27265 = ~«Ну так найди его! Заслужи чье-нибудь доверие, а потом предай, и ты докажешь, что достоин третьей способности! И не обращайся ко мне, пока не сделаешь это».~
@27266 = ~«Нет».~
@27267 = ~«Ладно, ладно».~
@27268 = ~«Ну? Ты достиг своей цели? Ты убил товарища в одиночку и без заклинаний?»~
@27269 = ~«Да».~
@27270 = ~«Пока нет».~
@27271 = ~«Нет. И не собираюсь».~
@27272 = ~Книга внезапно умолкает, и больше никакие уговоры не могут заставит ее говорит.~
@27273 = ~«Отлично».~
@27274 = ~«Мне неважно, кто — просто покажи свою готовность. А теперь иди и займись этим».~
@27275 = ~«Хорошо».~
@27276 = ~Я согласился убить одного из своих товарищей в обмен на силу из книги.~
@27277 = ~«Великолепно. Ты показал себя достойным учеником. А посему, вот последнее заклинание, которому я могу тебя обучить». Книга бормочет какое-то странное слово, и ты слышишь странный вой у себя в сердце. Ты узнаешь Слово силы, Убить.~
@27278 = ~«Спасибо тебе, книга. Что теперь?»~
@27279 = ~«Прощай, книга».~
@27280 = ~Книга дала мне еще одно, более могущественное заклинание в обмен на смерть одного из моих товарищей — стоящая сделка.~
@27281 = ~Книга дала мне еще одно, более могущественное заклинание в обмен на смерть одного из моих товарищей — стоящая сделка.~
@27282 = ~Книга молчит и не отвечает. Кажется, у нее кончился словарный запас.~
@27283 = ~«Хорошо».~
@27284 = ~Книга больше не разговаривает со мной.~
@27285 = ~«Небольшой совет, шеф: теперь я бы вел себя потише. Не нужно больше вписывать трупы в книгу мертвых без необходимости... особенно женские. К тому же, их убийство может заинтересовать здешних смотрителей».~
@27286 = ~«Они зовут себя 'тленными'. Ты их не пропустишь: они питают особую тягу к черному цвету и окоченевшему выражению лица. Они — всего лишь кучка свихнувшихся упырей, поклоняющихся смерти. Они верят в то, что все должны умереть... и лучше раньше, чем позже».~
@27287 = ~«Ты что, вообще ничего не слушал?! Я сказал, что трухлявые верят в то, что ВСЕ должны умереть, и лучше раньше, чем позже. Думаешь, что трупы, которых ты видел, счастливее в книге мертвых, чем вне ее?»~
@27288 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — все, что осталось от тех бедолаг, кто продал свои тела смотрителям».~
@27289 = ~«Чт... ты *серьезно*? Послушай, шеф, у этих мертвых крошек есть последняя возможность познакомиться с такими крутыми громилами как мы. Нам следует быть более *деликатными*... не ломать их ради ключей, не отрывать им конечности, ничего такого».~
@27290 = ~«Шеф, ОНИ мертвы, МЫ тоже мертвы... улавливаешь, куда я клоню? А? А?»~
@27291 = ~«Шеф, для нас до этих ковыляющих цыпочек — открытая дорога. Мы *все* по крайней мере один раз умирали: у нас есть общая тема для разговоров. Они предрасположены к мужчинам с нашим опытом смерти».~
@27292 = ~«Ну... хорошо, *ты*, может быть, и не мертвый, а вот *я* — да. И как я уже говорил, я не против разделить гроб с какой-нибудь из здешних красивеньких жилистых покойниц». Морт начинает в предвкушении щелкать зубами. «Конечно же, у здешних смотрителей есть приоритет, так что им это навряд ли понравится...»~
@27293 = ~«Послушай, шеф. Ты еще не отошел от свидания со смертью, поэтому у меня для тебя есть два небольших совета. Во-первых, если у тебя возникнет вопрос — *спроси* меня, хорошо?»

^NПРИМЕЧАНИЕ: <SPEAKTO>^-
~
@27294 = ~«Во-вторых, если ты хоть *наполовину* такой забывчивый, каким кажешься, то начни записывать свои мысли: как только ты встретишь то, что *может* быть важным, запиши это, чтобы не забыть».~
@27295 = ~«Да, как в дневнике. Если начнешь забывать важные вещи, вроде того, где ты находишься, открой его и освежи свою память. Понятно?»

^NПРИМЕЧАНИЕ: Чтобы получить доступ к дневнику, выберите кнопку дневника из быстрого меню. Ваш дневник будет автоматически обновляться в течение всей игры.^-
~
@27296 = ~«На одной из тех полок должен быть скальпель. Я бы на твоем месте нашел его до того, как начал бодаться с местными трупаками».~
@27297 = ~«Отлично, ты нашел скальпель! А теперь пора разделаться с этими трупами... и не бойся, я буду держаться у тебя за спиной и давать ценные тактические советы».~
@27298 = ~«Я ПОМОГУ тебе. Хороший совет всегда хорош в трудную минуту».~
@27299 = ~«Я? Я романтик, а не солдат. Я только под ногами буду путаться».~
@27300 = ~«Э... без проблем. Я помогу тебе».

^NПРИМЕЧАНИЕ: Если вы хотите, чтобы Морт помог вам атаковать, просто удостоверьтесь, что до нападения на труп выбраны оба персонажа. Морт присоединится к атаке.^-
~
@27301 = ~«Отлично, похоже, ты позаботился о правильном трупе. Теперь надо найти ключ. Он должен быть на его теле. Как только мы его получим, мы сможем выбраться отсюда».~
@27302 = ~«Отлично, вот и ключ. Он должен подойти к одной из дверей в этой комнате».~
@27303 = ~«Кажется, ты еще не говорил об этом... *кто* такие эти смотрители?»~
@27304 = ~«Эти трупы... откуда они все берутся?»~
@27305 = ~«Почему тебя так заботят женские тела?»~
@27306 = ~«Ладно... Я... попробую это запомнить».~
@27307 = ~«Я запутался... какое тленным дело, если я сбегу?»~
@27308 = ~«Эти трупы, которых я видел здесь... откуда они все берутся?»~
@27309 = ~«До этого ты говорил, чтобы я не убивал *женские* трупы. Почему?»~
@27310 = ~«Ладно... Я... попробую это запомнить».~
@27311 = ~«Просвети меня... *кто* такие эти смотрители?»~
@27312 = ~«До этого ты говорил, чтобы я не убивал *женские* трупы. Почему?»~
@27313 = ~«Ладно... Я... попробую это запомнить».~
@27314 = ~«Последний шанс? Погоди... о *чем* это ты толкуешь?»~
@27315 = ~«Нет... не очень, если честно».~
@27316 = ~«Ты это не серьезно».~
@27317 = ~«Постой... разве ты не говорил до этого, что я *не мертвый*?»~
@27318 = ~«Еще раз, кто эти смотрители?»~
@27319 = ~«Но откуда берутся все эти трупы?»~
@27320 = ~«Ладно... Я попробую это запомнить».~
@27321 = ~«Хорошо... если у меня возникнут вопросы, я спрошу у тебя».~
@27322 = ~«Как в дневнике?»~
@27323 = ~«Ладно... Уяснил. Идем».~
@27324 = ~«Ладно... Я поищу».~
@27325 = ~«А, может, ты мне *поможешь*, Морт?»~
@27326 = ~«Хорошо». ~
@27327 = ~«Я имел ввиду помощь в нападении на *трупов*».~
@27328 = ~«Ну ладно».~
@27329 = ~«Когда я буду нападать на труп, тебе лучше быть рядом со мной, иначе ты будешь следующим, в кого я воткну этот скальпель».~
@27330 = ~«Ну ладно».~
@27331 = ~«Рад, что мы друг друга понимаем. За дело».~
@27332 = ~«Хорошо». ~
@27333 = ~«Тогда я перепробую все двери».~
@27334 = ~Этот ухоженный, хорошо одетый мужчина отдыхает, наслаждаясь свежим воздухом и потягивая напиток, купленный в кафе неподалеку.~
@27335 = ~«Приветствую... — он запинается, разглядев тебя как следует. — Э... вас, сэр». Он натянуто улыбается.~
@27336 = ~«Нет, сэр, проблема во мне. Я просто не привык видеть людей с такой... потрепанной... внешностью, как у вас, — он ненадолго закрывает глаза, положив руку на грудь, будто извиняясь. — Прошу меня простить за реакцию на ваше появление, сэр».~
@27337 = ~«'Бывалая', если хотите. То есть, ваша внешность, сэр... ну, она слегка потрепанная, грубая по краям. Здесь вы, э, немного выделяетесь. Но ведь Сигил полон странностей, не так ли? Мне кажется, просто в Чиновничьем районе их меньше, чем остальной части города, вот и все. Разумеется, за исключением Фестхолла».~
@27338 = ~«Спрашивайте, что хотите... Попробую вам ответить».~
@27339 = ~Похоже, его развеселил твой вопрос. «Да ведь это же Чиновничий район! Сэр, вы недавно в Сигиле? Постойте... вы похожи на человека, который ищет ответы, а не вопросы... и не особо о себе распространяется. Забудьте мой вопрос». Он улыбается.~
@27340 = ~«Ну, большая часть района, где я, похоже, навеки обречен проводить большую часть времени, отведена под архивы и административные здания... правда, они в другой части района».~
@27341 = ~«В первую очередь, это Городской Фестхолл. А также Бордель утоления интеллектуальной страсти... нетипичный бордель, знаете ли... он удовлетворяет потребности более умственного характера. Тем не менее, это весьма соблазнительно!» Он лукаво улыбается.~
@27342 = ~«Из других мест можно упомянуть, — он загибает пальцы на руке, — дом адвоката, аптеку, художественную галерею, катакомбы под районом и мастерскую портного. О! Чуть не забыл... еще есть такой себе 'антикварный магазин'».~
@27343 = ~Мужчина хмыкает, нахмурив лоб. «Позволю допустить, сэр, что вам не нужно постоянное трудоустройство. Можете поискать временную работу у адвоката или в аптеке. Ну а в Фестхолле так просто куча всяких делишек. Может, там вы что-нибудь найдете».~
@27344 = ~Он пожимает плечами, посмотрев в сторону с выражением боли. «Здесь я выполняю свои обязанности, сэр. Это мои средства к существованию, мое место работы».~
@27345 = ~Он поднимает руки, качая головой. «Э, нет, сэр, об этом я сейчас говорить не буду. Никаких разговоров про правила и бумажную работу, пока я вдалеке от них, и точка». Он вежливо улыбается.~
@27346 = ~«О? О каком?»~
@27347 = ~«Адвокаты помогают в спорных делах, готовят официальные документы и действуют в качестве законных представителей своих клиентов. Один из них, Янис, живет неподалеку отсюда. Он очень уважаем и заслуживает доверия. Он живет и работает в районе с очень давних пор».~
@27348 = ~«Адвокаты помогают в спорных делах, готовят официальные документы и действуют в качестве законных представителей своих клиентов».~
@27349 = ~«Один из них, Янис, живет неподалеку отсюда. Он очень уважаем и заслуживает доверия. Он живет и работает в районе с очень давних пор».~
@27350 = ~«В аптеке продают различные мази, снадобья, травы и тому подобное, — на секунду он хмурится. — Хозяева немного чокнутые, постоянно испытывают на себе свои товары. Хотя ребята они неплохие».~
@27351 = ~«Художественная галерея Иваны — весьма занимательное место. У нее собрана коллекция редчайших предметов искусства со всех планов».~
@27352 = ~«Заведение чувствующих, которое ублажает разум и чувства, — на секунду он закрывает глаза, счастливо улыбаясь. — Им управляет очаровательнейшая женщина, Падшая Грация. Очень рекомендую посетить его, если вы впервые в этом районе, сэр».~
@27353 = ~«Заведение чувствующих, которое ублажает разум и чувства. Им управляет очаровательнейшая женщина, Падшая Грация». Он делает глубокий поклон Грации.~
@27354 = ~«О нет, это вы заслуживаете похвалы, госпожа Грация. Для меня это большая честь — произносить подобный комплимент лично вам». Он снова поворачивается к тебе.~
@27355 = ~«Для меня остается загадкой, почему дабусы до сих пор их не закрыли. Там полным-полно монстров. А еще поговаривают, там есть ужасные существа, что-то бормочущие в темноте».~
@27356 = ~«Одно из самых удивительных заведений Сигила... Это штаб-квартира фракции чувствующих, известная по всей мультивселенной своими концертами, выставками и лекциями. Однако самое удивительное у них — это их сенсориумы».~
@27357 = ~«Не могу похвастаться, что я там бывал, но насколько я понимаю, им заправляет одна поставщица товаров... полунечисть. Ее товары приходят с Нижних планов».~
@27358 = ~«Гонсалвис — великолепный портной, вот только у него пылкий нрав, и его легко обидеть. Должен предупредить вас, сэр: он судит людей по одежке, так что вам будет очень трудно с ним сдружиться».~
@27359 = ~«Куда, сэр?»~
@27360 = ~«Дом Яниса находится на юге от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Он будет на восточной стороне дороги».~
@27361 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к востоку от дороги. У нее фасад с южной стороны и три витражных окна».~
@27362 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к западу от дороги. Ее фасад обращен на юг, а черепица на крыше привалена крупными камнями».~
@27363 = ~«Бордель утоления интеллектуальной страсти, да? — он понимающе улыбается. — Он прямо на востоке от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это большое круглое здание, вход - с юга».~
@27364 = ~Он хмурится. «Хм. Я знаю лишь, что туда ведут несколько входов... И еще кое-что. Должен предупредить вас, из этих катакомб никто не выходит... включая тех, кто вошел туда».~
@27365 = ~«Найти Фестхолл легче всего, сэр. Это огромное здание в северо-восточной части этого района».~
@27366 = ~«Я никогда не был там, но знаю, где он. Он находится здесь, в юго-восточной части. Необычное здание, к нему ведет широкая лестница. Сложно не заметить».~
@27367 = ~«Мастерская портного Гонсалвиса находится на северо-востоке от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это длинное здание, вход — с юга».~
@27368 = ~Кивнув, он говорит шепотом: «Ну, знаете, сэр... Баатор, Бездна и тому подобное. Ужасные места».~
@27369 = ~«Заметьте, не тифлинг, а настоящая полунечисть. Дочь инкуба и смертной женщины. Не хочу разносить сплетни, так что давайте не будем о ней разговаривать».~
@27370 = ~«Да. Их правильное название — 'Общество чувств'. Они верят, что истинную сущность мультивселенной можно постичь только с помощью непосредственных переживаний...»~
@27371 = ~«Они нашли способ обмениваться своими ощущениями с другими с помощью сенсориумов».~
@27372 = ~«Чувствующие создали средства, с помощью которых они могут сохранять свои переживания в камнях, что позволяет делиться ими с *другими*. Чувствующие странствуют по планам в поисках новых ощущений, чтобы потом делиться ими... практически все, что они чувствовали или ощущали, находится в их сенсориумах».~
@27373 = ~«В Городском Фестхолле. Там есть сенсориумы, открытые для всех, и сенсориумы, доступные только чувствующим. За их использование взимают небольшую плату, но для переживаний это более чем скромная цена».~
@27374 = ~«В *некоторой* степени — да, только очень интенсивные... и в камне заключены не ваши, а чужие воспоминания».~
@27375 = ~«Нет... — он хмурится, — или, по крайней мере, я так думаю. Скорее всего, камень *копирует* чувственный опыт. Я себе это так представляю, но вам лучше расспросить об этом чувствующих для полной уверенности».~
@27376 = ~«Имя звучит знакомо... это чья-то статуя? Или персонаж из книги?.. Не могу вспомнить».~
@27377 = ~«А, и снова Путник пересек мой путь, — улыбается он, глядя на тебя поверх чашки, — снова вопросы, не так ли?»~
@27378 = ~Он поднимает бровь. «Прошу прощения, сэр?»~
@27379 = ~Он выглядит настороженным. «Ах, да... все мы там будем. Я должен идти, сэр. Кажется, у меня осталось одно неотложное дело».~
@27380 = ~Он отступает назад. «Должен признаться, меня это нисколько не интересует, сэр».~
@27381 = ~«Стража!»~
@27382 = ~«Они посвящают свои жизни переживанию всего, что только можно найти в мультивселенной. Они много путешествуют, как по планам, так и внутри своих мыслей и эмоций. Они пошли еще дальше, знаете ли...»~
@27383 = ~«Мне уже пора. Прощай».~
@27384 = ~«Потрепанной?»~
@27385 = ~«У меня есть несколько вопросов...» ~
@27386 = ~«Не беспокойся. Я должен идти. Прощай».~
@27387 = ~«Чиновничий район?»~
@27388 = ~«Фестхолл?».~
@27389 = ~«Ты имеешь в виду, что я выгляжу как мертвый, так? Да, так и есть. Я мертвый!»~
@27390 = ~«Хм-м. У меня есть несколько вопросов...»~
@27391 = ~«Кажется, понимаю. Прощай».~
@27392 = ~«Что это за место?»~
@27393 = ~«Здесь есть что-нибудь интересное?»~
@27394 = ~«Где здесь можно найти работу?»~
@27395 = ~«Я хотел бы спросить об одном конкретном месте...»~
@27396 = ~«Мне просто нужно сориентироваться...»~
@27397 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@27398 = ~«Ничего особенного. Прощай».~
@27399 = ~«Что ты можешь рассказать об этом районе?»~
@27400 = ~«И то правда. На самом деле, у меня есть другие вопросы...»~
@27401 = ~«Это все, что я хотел узнать. Прощай».~
@27402 = ~«Почему ты 'обречен' здесь оставаться?»~
@27403 = ~«Чем выделяется эта часть района?»~
@27404 = ~«У меня есть другие вопросы...»~
@27405 = ~«Это все, что я хотел узнать. Прощай».~
@27406 = ~«Продолжай...»~
@27407 = ~«У меня есть другие вопросы...»~
@27408 = ~«Это все, что я хотел узнать. Прощай».~
@27409 = ~«У меня есть другие вопросы...»~
@27410 = ~«Это все, что я хотел узнать. Прощай».~
@27411 = ~«У меня есть другие вопросы...»~
@27412 = ~«Это все, что я хотел узнать. Прощай».~
@27413 = ~Сержант Гармониума~
@27414 = ~«Чем ты занимаешься?»~
@27415 = ~«Так что же выделяет эту часть района?»~
@27416 = ~«У меня есть другие вопросы...»~
@27417 = ~«Это все, что я хотел узнать. Прощай».~
@27418 = ~«Так что же выделяет эту часть района?»~
@27419 = ~«У меня есть другие вопросы...»~
@27420 = ~«Это все, что я хотел узнать. Прощай».~
@27421 = ~«Дом адвоката».~
@27422 = ~~
@27423 = ~«Аптека».~
@27424 = ~«Э-э-э... Ну... Удваиваю!»~
@27425 = ~«У меня хватит звенелок, чтобы обчистить вас всех!»~
@27426 = ~«Все еще хватает медяков, а?»~
@27427 = ~«Невероятный бросок! Кажется, наш друг кое-чего не договаривает...»~
@27428 = ~«Я бы туда не совался, гражданин. Внизу опасно».~
@27429 = ~«Видал? ВОТ это бросок, приятель!»~
@27430 = ~«Какая невероятная удача!»~
@27431 = ~«Я НЕ ЗНАЮ НИЧЕГО, КРОМЕ УЖЕ СКАЗАННОГО...»~
@27432 = ~«На помощь! Стража! На меня напали!»~
@27433 = ~«Эльвин разозлилась, и они в страхе разбежались от звука ее голоса».~
@27434 = ~«Немель разозлилась, и они в страхе разбежались от звука ее голоса».~
@27435 = ~«Неа... Мне бы и трех хватило. Ха-ха-ха!»~
@27436 = ~«Должно быть, это очень удобно — иметь четыре ноги».~
@27437 = ~«Захлопни пасть и бросай кости!»~
@27438 = ~«Ага... это же неправильно».~
@27439 = ~::Вздох:: «Не больше, чем те, что ты уже сегодня меряла».~
@27440 = ~«Он похож... ну... он немного смахивает на тот, что ты меряла в последний раз».~
@27441 = ~«По-моему, это платье меня немного полнит».~
@27442 = ~«Потрясающе».~
@27443 = ~«Как тебе *этот* наряд?»~
@27444 = ~«НА ПОМОЩЬ! СТРАЖА!»~
@27445 = ~«Передай бутылку по кругу».~
@27446 = ~«Удача — это всего лишь ОДИН из моих навыков!»~
@27447 = ~«Может быть, завтра я найду работу».~
@27448 = ~«Ты хочешь сказать, что я жульничаю? Да ты просто завидуешь моей удаче!»~
@27449 = ~«Может, ты уже бросишь эти чертовы кости?!»~
@27450 = ~Тленные-плакальщики сказали, что они оплакивают мужчину по имени Янис, который является отцом того призрака, которого я встретил в Морге. Возможно, Янис может что-то знать об этой Дейонарре и обо мне...~
@27451 = ~Тленные-плакальщики сказали, что они оплакивают мужчину по имени Янис, который потерял свою единственную дочь, Дейонарру. Почему-то эти имена кажутся мне знакомыми, но я не могу их вспомнить.~
@27452 = ~Я согласился забрать у портного Гонсалвиса маскарадный костюм Малманера.~
@27453 = ~Я забрал у портного Гонсалвиса маскарадный костюм и отдал его Малманеру.~
@27454 = ~Я согласился достать у портного Гонсалвиса второй костюм для Малманера.~
@27455 = ~Я взял у портного Гонсалвиса второй костюм и отдал его Малманеру.~
@27456 = ~Падшая Грация сказала, что кто-нибудь в Городском Фестхолле может знать что-нибудь еще о Равель.~
@27457 = ~Падшая Грация сказала, что Равель заточили в одном из лабиринтов Леди Боли.~
@27458 = ~Падшая Грация сказала, что Равель — ночная ведьма, одна из серых сестер, обитающих в Серой пустоши. Ее могущество намного выше могущества ее сестер. Давным-давно она пришла в Сигил. Пребывая там, она разозлила Леди Боли и была наказана.~
@27459 = ~Падшая Грация предупредила меня насчет Равель... Она сказала, что если истории о ночной ведьме хоть отчасти правдивы, то она, наверное, самая злая и могущественная из ночных ведьм, когда-либо ходивших по планам.~
@27460 = ~Падшая Грация сказала мне, что родная мать продала ее в рабство... да еще и баатезу, злейшим врагам танарри. Судя по всему, Падшая Грация вырвала свободу у своего господина-баатезу в состязании по импровизации. В детали она не вдавалась.~
@27461 = ~Падшая Грация предложила мне побеседовать с учениками борделя: в разговоре с кем-то из них я могу вспомнить что-нибудь о себе.~
@27462 = ~Я убедил Падшую Грацию присоединиться ко мне на одном условии: я должен поговорить со всеми десятью ее учениками в борделе, а потом вернуться и сказать ей, что я об этом думаю.~
@27463 = ~Я убедил Падшую Грацию присоединиться ко мне на одном условии: я должен поговорить со всеми десятью ее учениками в борделе, а потом вернуться и сказать ей, что я об этом думаю. Я уже поговорил с девятью из них, но десятый избегает меня.~
@27464 = ~Падшая Грация предложила мне пойти в Городской Фестхолл, раз уж я хочу вступить в ряды Общества Восприятия. Она сказала, что там мне могут помочь.~
@27465 = ~Падшая Грация сказала, что она — суккуб, «низшая танарри», один из нечистых духов, обитающих на Нижним планам. Похоже на то, что представители ее расы находят смертных и соблазняют их, утаскивая их души в Бездну. Как очаровательно.~
@27466 = ~Падшая Грация сказала, что она — суккуб, «низшая танарри», один из нечистых духов, обитающих на Нижним планам. Похоже на то, что представители ее расы находят смертных и соблазняют их, утаскивая их души в Бездну. Как очаровательно.~
@27467 = ~В Чиновничьем районе я встретил женщину по имени Падшая Грация. Она, пожалуй, самая красивая из женщин, которых я когда-либо встречал... однако она не человек: у нее есть пара крыльев, сложенных за спиной.~
@27468 = ~«Художественная галерея».~
@27469 = ~«Бордель».~
@27470 = ~«Бордель».~
@27471 = ~«Катакомбы под районом».~
@27472 = ~«Городской Фестхолл».~
@27473 = ~«Антикварный магазин».~
@27474 = ~«Мастерская портного».~
@27475 = ~«Неважно. Позволь спросить кое о чем еще...»~
@27476 = ~«Пожалуй, никаком. Прощай».~
@27477 = ~«Как мне добраться до дома Яниса?»~
@27478 = ~«Я хочу спросить о другом месте...»~
@27479 = ~«У меня есть другие вопросы...»~
