@9481 = ~0200twn5~
@9482 = ~0200twn6~
@9483 = ~0200strk~
@9484 = ~0200twn7~
@9485 = ~0200twn8~
@9486 = ~0200dm1~
@9487 = ~0200dm2~
@9488 = ~0200dm3~
@9489 = ~0200dm4~
@9490 = ~0200dm5~
