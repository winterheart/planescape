@7564 = ~Спровоцировать женщину на воровство и проследить за ее техникой.~
@7565 = ~Оставить его в покое.~
@7566 = ~Спровоцировать женщину на воровство и проследить за ее техникой.~
@7567 = ~Спровоцировать женщину на воровство и проследить за ее техникой.~
@7568 = ~Атаковать ее.~
@7569 = ~Не обращать внимания на инцидент и уйти.~
@7570 = ~Схватить ее за руку.~
@7571 = ~Схватить ее за руку.~
@7572 = ~Схватить ее за руку.~
@7573 = ~«Эй! Ты что творишь?!»~
@7574 = ~Атаковать ее.~
@7575 = ~Не обращать внимания на инцидент и уйти.~
@7576 = ~«Верни мне все, что ты украла у меня. Сейчас же».~
@7577 = ~Свернуть ей шею свободной рукой.~
@7578 = ~Отпустить ее, затем уйти.~
@7579 = ~«Довольно. И чтобы я тебя никогда больше не видел. Понятно?»~
@7580 = ~Блеф: «Отдай мне все, что у тебя есть, и я оставлю тебя в живых».~
@7581 = ~Правда: «Отдай мне все, что у тебя есть, и я оставлю тебя в живых».~
@7582 = ~Кивнуть в знак благодарности, а затем схватить ее свободной рукой за шею.~
@7583 = ~Отпустить ее, затем уйти.~
@7584 = ~«Я же сказал — *все*».~
@7585 = ~«Я не хочу тебя больше видеть. Понятно?»~
@7586 = ~Кивнуть в знак благодарности, а затем схватить ее свободной рукой за шею.~
@7587 = ~Отпустить ее, затем уйти.~
@7588 = ~«Довольно. А теперь чтоб я тебя никогда больше не видел. Понятно?»~
@7589 = ~Кивнуть в знак благодарности, а затем схватить ее свободной рукой за шею.~
@7590 = ~Отпустить ее, затем уйти.~
@7591 = ~Свернуть ей шею свободной рукой.~
@7592 = ~Отпустить ее, затем уйти.~
@7593 = ~Бросить ее.~
@7594 = ~Бросить ее.~
@7595 = ~Уйти.~
@7596 = ~Уйти.~
@7597 = ~«Проклятье...»~
@7598 = ~«В чем дело?»~
@7599 = ~«Что ты делаешь?..»~
@7600 = ~«Э-э-э... Ты уверена, Анна?»~
@7601 = ~«Убери свои чертовы клинки, пока *я* не вышел из себя, понятно?»~
@7602 = ~«Прости, женщина, но я верю тифлингу больше, чем тебе. Верни деньги».~
@7603 = ~«Пойдем, Анна. Она того не стоит».~
@7604 = ~«Убери свои чертовы клинки, пока *я* не вышел из себя, понятно?»~
@7605 = ~«Пойдем, Анна. Она того не стоит».~
@7606 = ~«Я не позволю тебе причинить ей вред, пока ты не докажешь, что она сделала что-то дурное».~
@7607 = ~«В последний раз говорю: убери клинки и дай ей уйти».~
@7608 = ~«Ну и что? Она не стоит того».~
@7609 = ~«Уходи, женщина. И лучше, чтобы мы больше никогда не встречались».~
@7610 = ~«Женщина, тебе лучше уйти».~
@7611 = ~«Похоже, ты была права, Анна. Хорошо, верни все, что ты украла, женщина».~
@7612 = ~«Не важно. Забудь об этом, Анна».~
@7613 = ~«Уходи, женщина. И чтобы больше я тебя здесь не видел».~
@7614 = ~«Прощай».~
@7615 = ~«Прощай».~
@7616 = ~«Прощай».~
@7617 = ~«Прощай».~
@7618 = ~Ты уже почти готов идти прочь, когда неожиданно чувствуешь, что чего-то не хватает. Ты с подозрением оглядываешься на человека, как раз в то время, когда он засовывает руку в твой кошелек... ты не уверен, но тебе кажется, что он мог что-то забрать у тебя.~
@7619 = ~Схватить его за руку.~
@7620 = ~Схватить его за руку.~
@7621 = ~«Эй! Ты что творишь?!»~
@7622 = ~Спровоцировать мужчину на воровство и проследить за его техникой.~
@7623 = ~«Приветствую, говорю».~
@7624 = ~Спровоцировать мужчину на воровство и проследить за его техникой.~
@7625 = ~Спровоцировать мужчину на воровство и проследить за его техникой.~
@7626 = ~Атаковать его.~
@7627 = ~Не обращать внимания на инцидент и уйти.~
@7628 = ~Твоя рука молниеносно выскакивает вперед и хватает его запястье в мертвой хватке. Мужчина вскрикивает, отчаянно пытаясь вырвать руку.~
@7629 = ~Тихо: «Хватит вырываться, или я вырву тебе руку».~
@7630 = ~«Хватит вырываться, черт возьми!»~
@7631 = ~Атаковать его.~
@7632 = ~Позволить ему уйти.~
@7633 = ~Ты недостаточно быстр. Он вырывает свою руку до того, как ты успеваешь ее схватить. С криком он бросается наутек вниз по улице.~
@7634 = ~«Ну хорошо...»~
@7635 = ~От неожиданности мужчина подпрыгивает, а затем начинает убегать.~
@7636 = ~«Ну хорошо...»~
@7637 = ~Он продолжает вырываться из твоей хватки. Становится трудно его удерживать.~
@7638 = ~Атаковать его.~
@7639 = ~Ударить его свободной рукой, привлечь его внимание.~
@7640 = ~Позволить ему уйти.~
@7641 = ~Наверно, только благодаря собственным навыкам в воровстве ты не теряешь бдительности. Перед уходом ты инстинктивно бросаешь взгляд на свой кошелек... и видишь, как мужчина вытаскивает из него свою руку. Хотя сам он не знает, что ты его подловил.~
@7642 = ~Схватить его за руку.~
@7643 = ~Схватить его за руку.~
@7644 = ~«Эй! Ты что творишь?!»~
@7645 = ~Спровоцировать мужчину на воровство и проследить за его техникой.~
@7646 = ~Дать ему пройти.~
@7647 = ~Спровоцировать мужчину на воровство и проследить за его техникой.~
@7648 = ~Спровоцировать мужчину на воровство и проследить за его техникой.~
@7649 = ~Атаковать его.~
@7650 = ~Не обращать внимания на инцидент и уйти.~
@7651 = ~Ты вовлекаешь мужчину в непринужденный разговор, при этом украдкой следя за его движениями. Похоже, мужчина понадеялся на две вещи: во-первых, роль представительного гражданина может снизить внимательность жертвы, и во-вторых, спрашивая у жертвы дорогу, можно ее отвлечь... когда жертва поворачивается, чтобы указать на улицу или ориентир, мужчина снимает сливки с кошелька цели и прячет предметы в своих (подходяще длинных) рукавах. Ты мысленно отмечаешь его технику... в то время как он в очередной раз запускает руку в твой кошелек.~
@7652 = ~Схватить его за руку.~
@7653 = ~Схватить его за руку.~
@7654 = ~«Эй! Ты что творишь?!»~
@7655 = ~Атаковать его.~
@7656 = ~Не обращать внимания на инцидент и уйти.~
@7657 = ~Должно быть, он *что-то* услышал в твоем тоне — он моментально перестает выкручиваться. Под твоим взглядом он сникает. ~
@7658 = ~«Верни мне все, что ты украла у меня. Сейчас же».~
@7659 = ~Позволить ему уйти, уйти самому.~
@7660 = ~Он кивает и начинает опустошать свои карманы. Он отдает тебе пригоршню монет, намного большую, чем украл у тебя... должно быть, в ней около несколько дюжин медяков.~
@7661 = ~«Нет, оставь себе лишнее... Мне нужно только то, что ты украл у меня».~
@7662 = ~«Довольно. И чтобы я тебя никогда больше не видел. Понятно?»~
@7663 = ~Блеф: «Отдай мне все, что у тебя есть, и я не убью тебя».~
@7664 = ~Правда: «Отдай мне все, что у тебя есть, и я не убью тебя».~
@7665 = ~Кивнуть в знак благодарности, а затем напасть на него.~
@7666 = ~Позволить ему уйти, уйти самому.~
@7667 = ~Он удивленно смотрит на тебя, пытаясь разгадать подвох. Затем он пожимает плечами и рассовывает все лишнее назад в карманы.~
@7668 = ~«Довольно. И чтобы я тебя никогда больше не видел. Понятно?»~
@7669 = ~Атаковать его.~
@7670 = ~«Э-э... — он сглатывает. — Рубака, это все. Больше ничего нет».~
@7671 = ~Позволить ему уйти, уйти самому.~
@7672 = ~«Я же сказал — *все*, так что отдай мне *все*».~
@7673 = ~«Отлично. Я не хочу тебя больше видеть. Понятно?»~
@7674 = ~«Тогда твоя жизнь подходит к концу. Готовься к смерти».~
@7675 = ~Позволить ему уйти, уйти самому.~
@7676 = ~Он кивает. ~
@7677 = ~Ударить его, чтобы он понял окончательно.~
@7678 = ~Атаковать его.~
@7679 = ~Позволить ему уйти, уйти самому.~
@7680 = ~Твой удар ломает его челюсть и отбрасывает его на булыжники. Держась рукой за челюсть и постанывая, он поднимается на ноги. Кажется, ты ему выбил несколько зубов.~
@7681 = ~«А теперь проваливай отсюда».~
@7682 = ~Левым боковым ты отвешиваешь ему по шее, и он снова вскрикивает. Немного успокоившись и держась за лицо свободной рукой, он поворачивается к тебе. ~
@7683 = ~«Ты меня внимательно слушаешь?»~
@7684 = ~Он молча кивает.~
@7685 = ~«Верни мне все, что ты украл у меня».~
@7686 = ~«Меня не волнует то, что ты украл у меня... пока я тебя не увижу еще раз. Уяснил?»~
@7687 = ~Он снова кивает.~
@7688 = ~Ударить его, чтобы он понял окончательно.~
@7689 = ~Атаковать его.~
@7690 = ~Позволить ему уйти, уйти самому.~
@7691 = ~Ты снова видишь того же самого человека... он все еще выглядит потерянным и что-то бормочет, пялясь на здания.~
@7692 = ~«Приветствую».~
@7693 = ~Пройти мимо.~
@7694 = ~Когда ты начинаешь с ним говорить, он от неожиданности подпрыгивает. Он явно нервничает. «Э-э... приятно снова встретиться, господин, — он преисполнен надежды. — Могу ли я надеяться на то, что смогу убедить вас показать мне дорогу?»~
@7695 = ~«Еще раз, а куда тебе нужно?»~
@7696 = ~«Нет, не сегодня».~
@7697 = ~«Я же сказал! У меня ничего больше нет!»~
@7698 = ~«Отлично. Я не хочу тебя больше видеть. Понятно?»~
@7699 = ~«Тогда твоя жизнь подходит к концу. Готовься к смерти».~
@7700 = ~Позволить ему уйти, уйти самому.~
@7701 = ~Ты уже собираешься уйти прочь, как вдруг Анна встает у тебя на пути.~
@7702 = ~«Что ты делаешь?»~
@7703 = ~Анна кивает на спину мужчины, который все еще стоит рядом, пялясь на дома. «Этот сигильский ублюдок обставил тебя, как пить дать». Анна улыбается. «Тебе лучше быть поосторожней, пока ты трясешь своей черепушкой, а то можно и без звенелок остаться».~
@7704 = ~«О чем это ты?»~
@7705 = ~Она вытаскивает пригоршню монет и протягивает тебе. «Вот твои звенелки, возвращаю владельцу, верно?» Она снова оглядывается. «Этот убогий паразит даже кармана не обшарит, не растрезвонив об этом всему Сигилу. Он обчистил тебя, а я — его, — говорит она, улыбаясь. — Ну как?»~
@7706 = ~«Э... Ты уверена, что он украл это у меня, Анна?»~
@7707 = ~«Эй... спасибо».~
@7708 = ~«Че?» Анна хмурится, ее хвост начинает хлестать. «*Уверена* ли я?!» Она отступает на шаг. «Ты мне не веришь? — она сплевывает. — А, пофиг».~
@7709 = ~«Это важно для меня. Если эти деньги не наши...»~
@7710 = ~«Тогда неважно».~
@7711 = ~«Э-э?» Анна по-кошачьему шипит. «Ты че, *тупой*? Он обставил тебя. Если ты слишком слепой, чтобы заметить это, то так тебе и надо!»~
@7712 = ~«Ты можешь это доказать?»~
@7713 = ~«Тогда неважно».~
@7714 = ~Анна умолкает, затем хватает деньги с твоей ладони и швыряет их. Ты смотришь, как монеты рассыпаются по улице, некоторые из них тонут в лужах, другие падают в водосток. «Пусть тогда он их забирает! — Анна плюет тебе под ноги. — Ты их *по-любому* недостоин!»~
@7715 = ~«Утихомирься. Пошли».~
@7716 = ~Анна кивает и дарит дьявольскую улыбку. «Ага, всегда пожалуйста».~
@7717 = ~«Ладно. Идем».~
@7718 = ~Оставить существо в покое.~
@7719 = ~Существо медленно наклоняет свою голову и смотрит на тебя. На чешуйчатом лбу появляются морщины, оно открывает пасть, издавая резкое шипение. Ты замечаешь, что жар, излучаемый существом, начинает нарастать.~
@7720 = ~«Я хотел бы поговорить с тобой пару минут».~
@7721 = ~«Я хотел бы поговорить с тобой пару минут».~
@7722 = ~«Я хотел бы поговорить с тобой пару минут».~
@7723 = ~Оставить существо в покое.~
@7724 = ~Существо открывает пасть, показывая ряд почерневших клыков. Оно протяжно шипит. Вокруг его плеч и рук начинает плясать огонь.~
@7725 = ~«Успокойся! Я просто хочу поговорить с тобой».~
@7726 = ~Зашипеть в ответ.~
@7727 = ~Оставить существо в покое.~
@7728 = ~Существо рычит и бросается на тебя!~
@7729 = ~«Я уже говорил: я не собираюсь этого делать!»~
@7730 = ~Защищаться...~
@7731 = ~Существо резко шипит. Его голос похож на скрежет камней друг о друга. Оно шипит несколько секунд, то повышая, то понижая свой резкий голос.~
@7732 = ~«Э-э... что?»~
@7733 = ~Оставить существо в покое.~
@7734 = ~Существо рычит. «НЕЧЕГО тебе сссказать». Глаза нечисти превращаются узкие щелки. «Будешшшь докучать — твоя жаркая кровь прольется на камни».~
@7735 = ~«Я просто хочу задать тебе несколько вопросов...»~
@7736 = ~«Только попробуй — и мы еще посмотрим, чья кровь прольется на землю».~
@7737 = ~Отступить и оставить существо в покое.~
@7738 = ~Внезапно существо принюхивается, затем отворачивается от тебя со странным шипением. Кажется, оно уловило какой-то неприятный для себя запах.~
@7739 = ~«Я сказал, что хочу поговорить с тобой».~
@7740 = ~«Я сказал, что хочу поговорить с тобой».~
@7741 = ~Оставить существо в покое.~
@7742 = ~Глаза существа смотрят на Анну, сужаясь в щелки. Оно открывает пасть, показывая ряд почерневших клыков, вокруг его плеч и рук начинает плясать огонь. Жар, окружающий существо, начинает нарастать.~
@7743 = ~«Эй, я с тобой разговариваю!»~
@7744 = ~Оставить существо в покое, забрать Анну и уйти.~
@7745 = ~Глаза существа фокусируются на Падшей Грации, сужаясь в щелки. Оно открывает пасть, показывая ряд почерневших клыков, вокруг плеч и рук начинает плясать огонь. Жар, окружающий существо, начинает нарастать.~
@7746 = ~«Эй, я с тобой разговариваю!»~
@7747 = ~Отступить, забрав с собой Падшую Грацию, и уйти.~
@7748 = ~Существо рычит и бросается на Анну!~
@7749 = ~«Проклятье!..»~
@7750 = ~Существо рычит и бросается на Падшую Грацию!~
@7751 = ~«Проклятье!..»~
@7752 = ~Эта черная нечисть возвышается на два с половиной метра. Однако его огромный рост компенсируется тонким змееподобным телом. Позади волочится длинный цепкий хвост, из-за спины торчат кожаные крылья. От нечистого несет крепким уксусом... и жаром. Похоже, он не обращает на тебя внимания.~
@7753 = ~«Приветствую».~
@7754 = ~~
@7755 = ~~
@7756 = ~~
@7757 = ~~
@7758 = ~Оставить абишая в покое.~
@7759 = ~Тленный, скорее всего, услышал тебя, но вида не подал.~
@7760 = ~Все тленные поют в одном тоне и ритме. Напев каждые несколько минут переходит в крик, после чего медленно стихает, подобно эху. Когда и оно стихает, тленные произносят несколько строк во славу «Истинной Смерти», после чего продолжают петь.~
@7761 = ~Тленный поднимает голову. Он не перестает петь в том же темпе и тоне, что и другие тленные вокруг него.~
@7762 = ~Тленный не обращает на тебя внимания — вместо этого он кивает и продолжает петь.~
@7763 = ~Плакальщик внезапно останавливается и рассматривает тебя. «Скорбишь ли ты по усопшему?»~
@7764 = ~«Мы будем оплакивать твою боль и боль ее отца, если это не причинит никому обиду».~
@7765 = ~«Мы будем оплакивать твою боль, если таково твое желание».~
@7766 = ~«Мы будем оплакивать твою боль, если таково твое желание».~
@7767 = ~«Мы будем оплакивать ее боль, если это не причинит ей обиду».~
@7768 = ~«Мы будем оплакивать его боль, если это не причинит ему обиду».~
@7769 = ~Тленный кивает и возвращается к пению.~
@7770 = ~Тленный кивает головой и возвращается к пению.~
@7771 = ~«Мы оплакиваем».~
@7772 = ~«Мы оплакиваем не мертвых. Мы оплакиваем живых».~
@7773 = ~«Мы оплакиваем живых, испытывающих боль утраты».~
@7774 = ~«Уход души к Истинной Смерти часто оставляет ощущение беспокойства. Когда уходит любимый, утрату часто сопровождают скорбь и чувство потери».~
@7775 = ~«Ого, шеф». Морт встревает прежде, чем ты заговариваешь с существом. «Лучше захлопнись. Тебе не следует трясти своей черепушкой с нечистью на улице. Пойдем».~
@7776 = ~«Я хочу задать ему несколько вопросов...»~
@7777 = ~Оставить существо в покое.~
@7778 = ~«Нет, не хочешь». Морт украдкой смотрит на существо, затем поворачивается назад, понижая голос до шепота. «Они очень обидчивы. Давай уйдем отсюда».~
@7779 = ~«Я все же рискну».~
@7780 = ~Оставить существо в покое.~
@7781 = ~«Скорбь и чувство утраты — сильные эмоции. Подобные эмоции привязывают живущего к этому существованию, не позволяя ему достичь Истинной Смерти в тот момент, когда смерть приходит к нему. Мы оплакиваем живых, поглощенных подобными эмоциями».~
@7782 = ~«Иногда ее называют последней смертью. Истинная Смерть — это освобождение от серого, полного боли существования. Это освобождение от эмоций, от разума, от этих оболочек».~
@7783 = ~Тленный кивает. «Некоторые это так и называют. Но это не совсем точно».~
@7784 = ~Тленный ждет.~
@7785 = ~Все тленные поют в одном тоне и ритме. В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев повторяется словно волна, накатывающая на береговую линию. С этой мыслью в тебе пробуждается воспоминание...~
@7786 = ~Твое воспоминание смутно: ты стоишь на далеком берегу... где-то в другом месте, далеко отсюда. Рядом с тобой — женщина. Она стоит слева от тебя, как раз за пределами твоего периферийного зрения, поэтому ты не можешь ее различить. При попытке освежить воспоминание оно ускользает...~
@7787 = ~...и ты снова стоишь рядом с тленными-плакальщиками. Их пение теперь едва слышно. Они останавливаются, произносят несколько строк во славу «Истинной Смерти», затем снова начинают петь.~
@7788 = ~Все тленные поют в одном тоне и ритме. В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев по тону намного выше, и напоминает свист летящей стрелы или ветер, гуляющий по каньону. Он начинается и заканчивается быстро: после того как тленные умолкают, они произносят несколько строк во славу «Истинной Смерти», а затем начинают петь снова.~
@7789 = ~Все тленные поют в одном тоне и ритме. В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, в этом напеве есть некая энергетика и случайность: он непредсказуем, и его высота меняется, едва он проходит через их губы. И сколько бы не менялся напев, все тленные попадают в такт. Как только песнопение, наконец, становится едва слышным, тленные произносят несколько строк во славу «Истинной Смерти», а затем начинают петь снова.~
@7790 = ~В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев состоит из одной единственной ноты, звучащей несколько минут... он напоминает тебе звон большого колокола. После этого тленные некоторое время молчат, затем произносят несколько строк во славу «Истинной Смерти» и продолжают петь.~
@7791 = ~В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, этот напев намного нежнее: иногда он звучит настолько тихо, что сливается с шумом улиц. Тленные на несколько минут полностью умолкают, потом произносят несколько строк во славу «Истинной Смерти» и продолжают петь.~
@7792 = ~Тленный изумленно смотрит на тебя. «Наше пение не поменялось. Мы продолжаем один и тот же напев с того момента, как начали петь».~
@7793 = ~Тленный качает головой. «Возможно, это ты изменился».~
@7794 = ~«Я оплакиваю Яниса. Его ранила потеря его первой и единственной дочери Дейонарры».~
@7795 = ~«Мы оплакиваем твою скорбь по усопшим».~
@7796 = ~«Мы оплакиваем жену Ангиара, которая скорбит по усопшему».~
@7797 = ~«Мы оплакиваем Адана, который скорбит по усопшему».~
@7798 = ~Тленный кивает и возвращается к пению.~
@7799 = ~Плакальщик внезапно останавливается и рассматривает тебя. «Скорбит ли тот, о ком ты говоришь, по усопшему?»~
@7800 = ~«Мы будем оплакивать твою боль, если таково твое желание».~
@7801 = ~«Подробности ее смерти мне неизвестны».~
@7802 = ~«Мы будем оплакивать их боль, если это не причинит им обиду».~
@7803 = ~В отличие от пения, которое ты слышал, когда впервые подошел к мемориалу, различить этот напев намного сложнее. Слушая его, ты вдруг понимаешь, что звучит он как-то по-странному приглушенно, как будто сам воздух поглощает его. Песнопение тленных стихает спустя несколько минут. Они произносят несколько строк во славу «Истинной Смерти», затем продолжают петь.~
@7804 = ~«Мы оплакиваем упомянутого тобой, который скорбит по усопшему».~
@7805 = ~Видя, что ты собираешься заговорить с существом, Морт шумно вздыхает.~
@7806 = ~«Да?»~
@7807 = ~«А, нет, ничего... жизнь — лучший учитель, знаешь ли, — он кивает на существо. — Давай, продолжай».~
@7808 = ~«Я так и сделаю».~
@7809 = ~«Ладно, неважно. Идем».~
@7810 = ~Уйти.~
@7811 = ~«Я хотел бы немного поговорить с тобой».~
@7812 = ~Слушать их пение.~
@7813 = ~Слушать их пение.~
@7814 = ~Слушать их пение.~
@7815 = ~Слушать их пение.~
@7816 = ~Слушать их пение.~
@7817 = ~Слушать их пение.~
@7818 = ~Слушать их пение.~
@7819 = ~Уйти.~
@7820 = ~«Приветствую».~
@7821 = ~Оставить их — пускай себе поют.~
@7822 = ~«Не! — Анна выглядит напуганной. — Не надо трясти с ними черепушкой! Эта нечисть сожрет тебя заживо!»~
@7823 = ~«Что ты делаешь?»~
@7824 = ~«Я оплакиваю покойника».~
@7825 = ~«Я здесь ради того, кто потерял другого».~
@7826 = ~«Я хочу задать ему несколько вопросов...»~
@7827 = ~«Ладно, тогда неважно. Идем дальше».~
@7828 = ~«Извини за беспокойство. Прощай».~
@7829 = ~Анна качает головой. «Он выпустит тебе кишки, будь уверен».~
@7830 = ~«Я все же рискну».~
@7831 = ~Оставить существо в покое.~
@7832 = ~«Ты че, *рехнулся*?!» Анна преграждает тебе дорогу, яростно размахивая хвостом из стороны в сторону. «Ты не слышал, что я тебе говорила?! Не тряси черепушкой с нечистыми!»~
@7833 = ~«Я все же рискну».~
@7834 = ~«Ладно, я оставлю его в покое... идем».~
@7835 = ~«Ты точно конченный идиот! — Анна яростно сплевывает. — Скоро у тебя кончатся жизни, и тогда-то я заберу себе то, что от тебя останется!»~
@7836 = ~«Это было бы для меня благословением. А теперь дай мне поговорить».~
@7837 = ~«Я на минуту. Успокойся».~
@7838 = ~«Ладно, я оставлю его в покое... идем».~
@7839 = ~«Я хотел бы поговорить с тобой».~
@7840 = ~Слушать их пение.~
@7841 = ~Слушать их пение.~
@7842 = ~Слушать их пение.~
@7843 = ~Слушать их пение.~
@7844 = ~Слушать их пение.~
@7845 = ~Слушать их пение.~
@7846 = ~Слушать их пение.~
@7847 = ~Оставить его в покое.~
@7848 = ~«Нет. Смерть не тревожит мои чувства».~
@7849 = ~Правда: «Да... Мне кажется, что я в ответе за смерть невинной женщины, Дейонарры. Меня не дает покоя не только это: я чувствую вину за то горе, которое причинил ее отцу».~
@7850 = ~Правда: «Да... Я в ответе за смерть невинного мужчины, Захарии. Его смерть не дает мне покоя».~
@7851 = ~Правда: «Да... Я в ответе за смерть множества невинных на многих планах. Я едва выношу страдания, причиняемые осознанием этого факта».~
@7852 = ~«Не я. Есть женщина, жена Ангиара, которая потеряла своего сына. Скорбь повисла на ней тяжелой ношей».~
@7853 = ~Ложь: «Нет, э-э, я говорю о своем друге, э-э... Адане: он скорбит по умершему».~
@7854 = ~«Да, последняя смерть принесла мне много страданий и боли».~
@7855 = ~«Ну, э-э, прежде чем мы поговорим об этом, у меня есть к тебе несколько вопросов...»~
@7856 = ~«Если это возможно — это бы сильно облегчило мою боль и боль ее отца».~
@7857 = ~«Нет, в этом нет нужды. Прощай».~
@7858 = ~«Если это возможно — это бы сильно облегчило мою боль».~
@7859 = ~«Нет, в этом нет нужды. Прощай».~
@7860 = ~«Если это возможно — это бы сильно облегчило мою боль».~
@7861 = ~«Нет, в этом нет нужды. Прощай».~
@7862 = ~«Если это возможно — это бы сильно облегчило ее боль».~
@7863 = ~«Нет, в этом нет нужды. Прощай».~
@7864 = ~«Если это возможно — это бы сильно облегчило его боль».~
@7865 = ~«Нет, в этом нет нужды. Прощай».~
@7866 = ~Слушать их пение.~
