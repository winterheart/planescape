@38430 = ~Оставить ее в покое.~
@38431 = ~Эта высокая элегантная женщина с резкими чертами лица и королевскими манерами — поразительный пример аристократической красоты. Ее одежда, похоже, соткана из серебряных нитей, а на ее ожерелье висит маленький пузырек. Она источает диковинный эротический запах, который, казалось бы, притягивает тебя к ней.~
@38432 = ~~
@38433 = ~~
@38434 = ~Она осматривает тебя, подняв бровь, что, как тебе кажется, означает пренебрежение. «Приветствую. Меня зовут Вивьен. Смею предположить, что меня вызвали?»~
@38435 = ~«Нет, просто у меня есть несколько вопросов...»~
@38436 = ~«Нет. Прощай».~
@38437 = ~Эта упыриха держится с большей важностью, чем остальные. Да и взгляд у нее более ясный и не такой дикий. «Чем могу... помочь, мясско?»~
@38438 = ~«Кто ты? Что ты здесь делаешь?»~
@38439 = ~«Что это за место?»~
@38440 = ~«Нет, спасибо. Прощай».~
@38441 = ~«Я? Я... Алайна. Это мои упыри. Мы разведчики и охотники. Мы ищем новые месста... мы ищем *еду*. А теперь моя очередь спрашшивать... что здессь делаешшь ТЫ?»~
@38442 = ~«Я ищу бронзовый шар».~
@38443 = ~«Я ищу графин с водой».~
@38444 = ~«Я ищу склеп, в котором много ловушек».~
@38445 = ~«Я просто тут бродил».~
@38446 = ~«Я не знаю». ~
@38447 = ~«Это Затопленные Народы. Это нашши охотничьи земли. Здессь... управляем мы, охотники. Чего тебе здессь нужно?»~
@38448 = ~«Я ищу бронзовый шар».~
@38449 = ~«Я ищу графин с водой».~
@38450 = ~«Я ищу склеп, в котором много ловушек».~
@38451 = ~«Я просто тут бродил».~
@38452 = ~«Я не знаю». ~
@38453 = ~«Бронзовый... шшар? Мы такого... не находили. Поищи в дальних уголках этого месста — может, там ты найдешшь то, что ищешшь».~
@38454 = ~«У меня несколько вопросов...»~
@38455 = ~«Спасибо. Прощай».~
@38456 = ~«Мы не нашшли иссточник воды, но похоже, что большше всего воды к восстоку. Поищи там, и, возможно, найдешшь его».~
@38457 = ~«У меня несколько вопросов...»~
@38458 = ~«Спасибо. Прощай».~
@38459 = ~«Кругом одни ссклепы, и мы защищаем их обитателей... Я ничего тебе не сскажу».~
@38460 = ~«Для меня очень важно найти его».~
@38461 = ~«Для меня очень важно найти его».~
@38462 = ~«Хорошо. Ответь тогда еще на пару моих вопросов...»~
@38463 = ~«Хорошо, тогда прощай».~
@38464 = ~«Это... плохое мессто для прогулок. Здессь много опассностей. Мы обозначили тотемами безопассные пределы... не перессекай их, и будешшь в безопассности. Опассайся здешшних обитателей — они смертельно опассны, и посстоянно прибавляют в чиссле».~
@38465 = ~«Что еще за обитатели?»~
@38466 = ~«Спасибо. У меня еще несколько вопросов...»~
@38467 = ~«Спасибо. Прощай».~
@38468 = ~«Не знаешшь? Не знаешшь? Пожалуй... тебе лучшше уйти. Это мессто... опассно... для мяссных тварей».~
@38469 = ~«Опасно? Чем опасно?»~
@38470 = ~«У меня всего лишь несколько вопросов...»~
@38471 = ~«Спасибо. Прощай».~
@38472 = ~«Я... отвечу, ессли смогу».~
@38473 = ~«Кто ты? Что ты здесь делаешь?»~
@38474 = ~«Что ты можешь рассказать об этом месте?»~
@38475 = ~«Я ищу бронзовый шар».~
@38476 = ~«Я ищу графин с водой».~
@38477 = ~«Я ищу склеп, в котором много ловушек».~
@38478 = ~«Забудь. Прощай».~
@38479 = ~Лидер упырей окидывает тебя холодным оценивающим взглядом. «Ищи на юго-восстоке. Не бесспокой других обитателей этих ссклепов, иначе *пожалеешшь*».~
@38480 = ~«Спасибо. У меня еще несколько вопросов...»~
@38481 = ~«Спасибо. Прощай».~
@38482 = ~Лидер упырей окидывает тебя взглядом, в ее глазах загорается пламя. «Мне вссе *РАВНО*, нассколько это для тебя важно, мяссная тварь. Я ничего тебе не *ССКАЖУ*».~
@38483 = ~«Ладно, ладно. Тогда ответь на еще на пару вопросов».~
@38484 = ~«Говори или умрешь».~
@38485 = ~«Что ж, спасибо за уделенное время. Прощай».~
@38486 = ~«Это мессто кишшит... трокопотоками, белыми рогатыми сущесствами с безмерными аппетитами и жесстоким нравом. Еще здессь поселилоссь много варгулий, и их количесство расстет за счет глупцов, которые забираютсся так далеко в катакомбы».~
@38487 = ~«Понятно... может, ответишь еще на пару вопросов?»~
@38488 = ~«Спасибо за совет. Прощай».~
@38489 = ~«Ты вернулсся, да? Чего ты хочешшь?»~
@38490 = ~«Я хотел задать пару вопросов...»~
@38491 = ~«Ничего. Прощай».~
@38492 = ~«Ссссc... Мясссная тварь, для тебя здесссь нет мессста».~
@38493 = ~«Что ты здесь делаешь?»~
@38494 = ~«Что это за место?»~
@38495 = ~«Кто ты?»~
@38496 = ~«Тогда я пойду. Прощай».~
@38497 = ~«Мы хотим расшшширить нашшш дом. Уссстранить врагов... найти еду, чтобы пришшшлось не жевать ходячее мяссско, верно? Безмолвный Король ссссказал нам... никакого ходячего мясссска».~
@38498 = ~«Кто такой этот Безмолвный Король?»~
@38499 = ~«Что это за место?»~
@38500 = ~«Кто ты?»~
@38501 = ~«Спасибо. Прощай».~
@38502 = ~«Это? Это Затопленные Народы. Это нашшши охотничьи угодья. Это... это нашшша кладовая».~
@38503 = ~«Понятно. Прощай».~
@38504 = ~«Мы разведчики, разведчики Мертвых Народов».~
@38505 = ~«Что вы разведываете?»~
@38506 = ~«Понятно. Тогда прощай».~
@38507 = ~«Сссс! — упырь негодующе шипит. — Безмолвный Король — нашшш правитель. Акаста — нашшш лидер! Сссскоро мы найдем между ними балансссс!»~
@38508 = ~«Так кто же ты такой?»~
@38509 = ~«Понятно. Прощай».~
@38510 = ~«Сссс... мяссско вернулосссь...»~
@38511 = ~«Что ты здесь делаешь?»~
@38512 = ~«Что это за место?»~
@38513 = ~«Кто ты?»~
@38514 = ~«Тогда я пойду. Прощай».~
