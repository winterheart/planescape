@29070 = ~«У меня есть другие вопросы...»~
@29071 = ~«Это все, что я хотел узнать. Прощай».~
@29072 = ~«Хмм. У меня есть другие вопросы...»~
@29073 = ~«Тогда я пойду, поищу еще кого-то. Прощай».~
@29074 = ~«Приветствую...»~
@29075 = ~«Я встретил мага по имени Салабеш, который рассказывал, что здесь есть каменный человек. Ты и есть он?»~
@29076 = ~«Приветствую... ты Ки-Саи?»~
@29077 = ~Прикоснуться к изваянию.~
@29078 = ~Уйти.~
@29079 = ~«И снова приветствую. У меня есть вопросы...»~
@29080 = ~Уйти.~
@29081 = ~«У меня есть вопросы о тебе...»~
@29082 = ~«У меня вопрос на счет этого места».~
@29083 = ~«Что тебе известно о Равель Заморочке?»~
@29084 = ~«Я просто проходил мимо. Прощай».~
@29085 = ~«Скоро я буду там».~
@29086 = ~«Сейчас мне нужно кое-что посмотреть. Я приду туда позже».~
@29087 = ~«Нет, у меня есть несколько вопросов...»~
@29088 = ~«Да, обучи меня».~
@29089 = ~«Да».~
@29090 = ~«Эээ... нет».~
@29091 = ~«Научи меня кулачному бою».~
@29092 = ~«Научи меня кулачному бою».~
@29093 = ~«Научи меня сражаться клинком».~
@29094 = ~«Научи меня сражаться клинком».~
@29095 = ~«Научи меня сражаться палицей».~
@29096 = ~«Научи меня сражаться палицей».~
@29097 = ~«Научи меня сражаться топором».~
@29098 = ~«Научи меня сражаться топором».~
@29099 = ~«Научи меня сражаться молотом».~
@29100 = ~«Научи меня сражаться молотом».~
@29101 = ~«Вообще-то, у меня несколько вопросов...»~
@29102 = ~«Пока ничему. Прощай».~
@29103 = ~«Тогда у меня еще вопросы...»~
@29104 = ~«Я займусь этим. Счастливо».~
@29105 = ~Учиться у него.~
@29106 = ~«Спасибо. Ты можешь меня научить чему-то еще?»~
@29107 = ~«Спасибо. Ты можешь меня научить чему-то еще?»~
@29108 = ~«Спасибо. Прощай, Ки-Саи».~
@29109 = ~«Ты можешь научить меня еще чему-нибудь?»~
@29110 = ~«Тогда у меня еще вопросы...»~
@29111 = ~«Тогда прощай». ~
@29112 = ~«Да, обучи меня».~
@29113 = ~«Да, обучи меня».~
@29114 = ~«Нет... чему еще ты можешь меня обучить?»~
@29115 = ~«Нет, сегодня я не хочу тренироваться. Прощай».~
@29116 = ~«Да, обучи меня».~
@29117 = ~«Да, обучи меня».~
@29118 = ~«Нет... чему еще ты можешь меня обучить?»~
@29119 = ~«Нет, сегодня я не хочу тренироваться. Прощай».~
@29120 = ~«Да, обучи меня».~
@29121 = ~«Да, обучи меня».~
@29122 = ~«Нет... чему еще ты можешь меня обучить?»~
@29123 = ~«Нет, сегодня я не хочу тренироваться. Прощай».~
@29124 = ~«Да, обучи меня».~
@29125 = ~«Да, обучи меня».~
@29126 = ~«Нет... чему еще ты можешь меня обучить?»~
@29127 = ~«Нет, сегодня я не хочу тренироваться. Прощай».~
@29128 = ~«Да, обучи меня».~
@29129 = ~«Да, обучи меня».~
@29130 = ~~
@29131 = ~«Нет... чему еще ты можешь меня обучить?»~
@29132 = ~«Нет, сегодня я не хочу тренироваться. Прощай».~
@29133 = ~«Тогда обучи меня».~
@29134 = ~«Да, я хочу специализироваться на молоте».~
@29135 = ~«Нет. Чему еще ты можешь меня обучить?»~
@29136 = ~«Ты можешь сделать меня воином?»~
@29137 = ~«Тогда у меня еще вопросы...»~
@29138 = ~«В таком случае, прощай».~
@29139 = ~«Да. Я больше не хочу изучать Искусство. Сделай меня воином».~
@29140 = ~«Да. Я больше не хочу быть вором. Сделай меня воином».~
@29141 = ~«Вообще-то, нет. Тем не менее, у меня есть несколько вопросов...»~
@29142 = ~«Не сейчас. Прощай».~
@29143 = ~«Путь Камня?»~
@29144 = ~«У меня есть другие вопросы...»~
@29145 = ~«Это все, что я хотел узнать. Прощай».~
@29146 = ~«Неуязвимости? Ты бы стал непобедим в бою...»~
@29147 = ~«Это все, что я хотел узнать. Прощай».~
@29148 = ~«Ты можешь рассказать мне, чему ты научился к этому времени?»~
@29149 = ~«Понятно. У меня есть другие вопросы...»~
@29150 = ~«Это все, что я хотел узнать. Прощай».~
@29151 = ~Слушать и изучать Путь Камня.~
@29152 = ~Слушать, пытаясь понять Путь Камня.~
@29153 = ~«Спасибо, Ки-Саи. У меня есть другие вопросы...»~
@29154 = ~«Спасибо, Ки-Саи. Прощай».~
@29155 = ~«Все равно спасибо, Ки-Саи. У меня есть другие вопросы...»~
@29156 = ~«Все равно спасибо, Ки-Саи. Прощай».~
@29157 = ~Друзья~
@29158 = ~Слепота~
@29159 = ~[no text]~
@29160 = ~Удаление проклятия~
@29161 = ~Поднять мертвеца~
@29162 = ~Ужас~
@29163 = ~Удача~
@29164 = ~Концентрация Зертимона~
@29165 = ~Стук~
@29166 = ~Расплывчатость~
@29167 = ~Коротко кивнув, женщина высокомерно говорит: «Да? В чем дело? И следите за своими словами, я — Усердная, Четвертый судья района».~
@29168 = ~«Определенно, да! Если бы утвердили Закон о подобающем одеянии, людям вашего сорта не позволили бы разгуливать в таком виде — полуголыми и грязными...»~
@29169 = ~Она недоверчиво смотрит на тебя, затем кивает. «Вы точно подметили... сэр. Тем не менее, нельзя отрицать, что вы выглядите довольно грубовато».~
@29170 = ~«О, но должны! Как легко пенять на жизнь и окружение за свои неудачи! Судя по манерам, вы хорошо образованы, хотя ваш вид говорит о бродячей жизни и бессмысленной жестокости. Почему бы вам не поселиться в Сигиле, стать его деятельным гражданином, вместо того, чтобы быть кровожадным кочевником на его улицах?»~
@29171 = ~«О? А у кого тогда?» Ее высокомерие сменяется легким любопытством.~
@29172 = ~«Тем не менее, я хотела бы, чтобы вы так поступили, сэр».~
@29173 = ~Ты заканчиваешь рассказывать ей свою историю.

Усердная выглядит потрясенной. «Это... это больше похоже на сказку, сэр».~
@29174 = ~«Да, да... безусловно». Она слегка улыбается... ты начинаешь беспокоиться, не тронулась ли она от подобных вещей. «Я желаю вам удачи во всех ваших начинаниях, сэр. Желаю вам снова найти себя».~
@29175 = ~«И вы скажете, что вы *не бродяга*, который шатается по городу, задает вопросы каждому встречному и довольно таки нередко ввязывается в драки насмерть?»~
@29176 = ~Усердная холодно смотрит на тебя. «Вы лжете. Я не собираюсь больше тратить попусту свое время. Произнесете еще хоть одно слово или приблизитесь ко мне слишком близко — и я позову стражу. А теперь прочь от меня».~
@29177 = ~«Стража!»~
@29178 = ~На ее губах появляется тень насмешки. «Я быстра судить, сэр, потому что я судья по профессии. Я не собираюсь больше тратить попусту свое время. Произнесете еще хоть одно слово или приблизитесь ко мне слишком близко — и я позову стражу. А теперь прочь от меня».~
@29179 = ~Ее глаза сужаются. «Не шутите со мной, сэр. На это мне терпения не хватит. Что вам от меня нужно?»~
@29180 = ~Усердная просто смотрит на тебя со слегка удивленным выражением лица.~
@29181 = ~Усердная улыбается. «Я не осведомитель, сэр, который за пригоршню монет развлекает прохожих. Найдите кого-нибудь, кто ответит на ваши вопросы. Меня ждут очень важные государственные дела».~
@29182 = ~«Ни одного. А теперь оставьте меня! Только посмейте сказать хоть слово или подойти ко мне слишком близко — и я позову стражу».~
@29183 = ~«И все же, сэр, у меня нет времени на вопросы».~
@29184 = ~«Постойте... Судя по манерам, вы хорошо образованы, хотя ваш вид говорит о бродячей жизни и бессмысленной жестокости. Почему бы вам не поселиться в Сигиле, стать его деятельным гражданином, вместо того, чтобы быть кровожадным кочевником на его улицах?»~
@29185 = ~«Не так быстро... стоять! — она подозрительно смотрит на тебя. — Кто вы такой?»~
@29186 = ~«Хм-м. Ну хорошо, 'Адан'. Прощайте».~
@29187 = ~«Вы без причины остановили меня посреди улицы, заставили терпеть ваше присутствие, а теперь у вас хватает *наглости* говорить, что это меня не касается? А вот я думаю иначе!»~
@29188 = ~«Бросьте, вы же не думаете, что отделаетесь так легко, верно? Итак, имя!»~
@29189 = ~Она спокойно смотрит на тебя с кислой миной на лице. Наконец, она произносит: «Хорошо. Оставьте меня в покое и постарайтесь не ввязываться в неприятности».~
@29190 = ~«Ваши слова тщательно подобраны, но они безумны, — она хмурится. — И это правда, что вы все забыли? Говорите прямо и осторожно подбирайте слова».~
@29191 = ~Спустя секунду она раздраженно вздыхает. «Судя по манерам, вы хорошо образованы, хотя ваш вид говорит о бродячей жизни и бессмысленной жестокости. Почему бы вам не поселиться в Сигиле, стать его деятельным гражданином, вместо того, чтобы быть кровожадным кочевником на его улицах?»~
@29192 = ~Она качает головой. «Боюсь, я очень занятая женщина, сэр. Моя должность Четвертого судьи оставляет мне слишком мало времени, чтобы ответить на ваши вопросы. Уверена, что другой гражданин сможет вам помочь».~
@29193 = ~Ни слова не говоря, она с любопытством смотрит на тебя.~
@29194 = ~Она заканчивает предложение за тебя: «И привлекли внимание Гармониума, так? А теперь беспокоитесь, что они положили на вас глаз?»~
@29195 = ~Она качает головой, словно журя тебя, как непослушного ребенка. «Я сделаю все возможное, сэр, но вы должны позаботиться о том, чтобы подобных ссор больше не было».~
@29196 = ~Усердная хмурится, когда ты приближаешься к ней. «Вы выглядите знакомо... — ее лицо становится кислым и морщинистым, словно чернослив. — Ах, да... я вспомнила вас».~
@29197 = ~Усердная с отвращением смотрит на тебя. «Разве я не просила вас быть подальше от меня? И я предупреждала, что позову стражу...»~
@29198 = ~Усердная кивает тебе при приближении. «Здравствуйте, сэр».~
@29199 = ~Едва взглянув на тебя, женщина от удивления вздрагивает. «Да ты с ума *сошел*, раз решил подойти к Четвертому судье района? Стража! Стража!»~
@29200 = ~«Приветствую...»~
@29201 = ~Оставить ее в покое.~
@29202 = ~«*Кто*?»~
@29203 = ~«У меня есть несколько вопросов...» ~
@29204 = ~«Что-то не так с моим внешним видом?»~
@29205 = ~«Ничего. Прощай».~
@29206 = ~«Я достаточно чист, и, прошу прощения, но... не хочу нанести вам оскорбление, мадам... некоторые культуры могут найти *вашу* одежду вызывающей».~
@29207 = ~«Вы быстры судить по внешнему виду, не так ли?»~
@29208 = ~«Такая нынче мода в Улье, знаете ли. Возможно, и вам стоит попробовать этот стиль: он будет вам к лицу».~
@29209 = ~«Понятно. У меня есть несколько вопросов...»~
@29210 = ~«Хм-м. Я должен идти. Прощайте».~
@29211 = ~«Мой вид является всего лишь продуктом моего окружения и тяжелой жизни, мадам. Я не могу быть ответственен за это».~
@29212 = ~«Да, это так. В любом случае, прощайте».~
@29213 = ~«Уверяю вас, у меня нет выбора».~
@29214 = ~«Я обдумаю это. Прощайте».~
@29215 = ~«Это трудно объяснить...»~
@29216 = ~Рассказать ей свою историю... или по крайней мере то, что знаешь.~
@29217 = ~«Неважно. Прощайте».~
@29218 = ~Рассказать ей свою историю... или по крайней мере то, что знаешь.~
@29219 = ~«Лучше не стоит, это слишком личное. Прощайте».~
@29220 = ~«Если бы это было сказкой, мадам. Это моя жизнь, вот мои шрамы в доказательство. Вы их, должно быть, уже заметили».~
@29221 = ~«А разве нет? Прощайте».~
@29222 = ~«Спасибо. У меня есть вопросы...»~
@29223 = ~«Премного благодарен. Прощайте, леди Усердная».~
@29224 = ~«С другой стороны, я достаточно чист... не хочу нанести оскорбление, но... некоторые культуры могут найти *вашу* одежду вызывающей».~
@29225 = ~«Э... ну...»~
@29226 = ~Ложь: «Это не так».~
@29227 = ~«Но...»~
@29228 = ~Уйти.~
@29229 = ~Атаковать ее.~
@29230 = ~Попытаться уйти до того, как кто-нибудь придет.~
@29231 = ~«Но...»~
@29232 = ~Уйти.~
@29233 = ~«Простите меня за мою глупость, мадам. По правде говоря, я достаточно чист... не хочу нанести оскорбление, но... некоторые культуры могут найти *вашу* одежду вызывающей».~
@29234 = ~«Вы быстры судить по внешнему виду, не так ли?»~
@29235 = ~«У меня есть несколько вопросов...» ~
@29236 = ~«Хм-м. Я должен идти. Прощайте».~
@29237 = ~«У меня есть несколько вопросов...» ~
@29238 = ~«Что-то не так с моим внешним видом?»~
@29239 = ~«Я должен идти. Прощайте».~
@29240 = ~«Я не считаю вас... осведомителем, мадам. Напротив, вы производите впечатление мудрой женщины, поэтому я надеялся, что вы поможете мне».~
@29241 = ~«Всего один вопрос?»~
@29242 = ~«Тогда прощайте». ~
@29243 = ~«Но...»~
@29244 = ~Уйти.~
@29245 = ~«Тогда приношу свои извинения, мадам, и благодарю вас за уделенное мне время. Прощайте».~
@29246 = ~«Отлично, прощайте».~
@29247 = ~«Хм-м. Посмотрим, заработает ли эта часть».~
@29248 = ~«Дурацкий ключ не подходит!»~
@29249 = ~«И эта не подошла? ::Вздох:: Я достану тебе еще одну».~
@29250 = ~«Еще пару оборотов...»~
@29251 = ~«Может, эта...»~
@29252 = ~«Подай-ка мне те части, да побыстрее!»~
@29253 = ~«Хм... Похоже, это должно сработать».~
@29254 = ~«Может, эта...»~
@29255 = ~«Не, эта деталь не подойдет».~
@29256 = ~«Попробуем эту деталь».~
@29257 = ~«И эта не подошла? ::Вздох:: Я достану тебе еще одну».~
@29258 = ~«Воспользуйся этим инструментом».~
@29259 = ~«Мне кажется, ты неправильно вставил ту деталь».~
@29260 = ~«Лучше бы эта адски скучная работа оказалась моим пропуском наверх».~
@29261 = ~«Этим пням из Хранителей рока нужно уяснить, что жизнь — это не только разрушение!»~
@29262 = ~«Несмотря на мои ошибки, Омбидиас был достаточно добр, чтобы помочь мне с ними справиться».~
@29263 = ~«Твой следующий шаг к просветлению определяет не то, сколько ты живешь, а то, как ты проживаешь жизнь».~
@29264 = ~«Берегись. Поговаривают, что тленные освободили Фоснатуу из темницы».~
@29265 = ~*УДАР*~
@29266 = ~«Уверяю вас, у меня нет выбора».~
@29267 = ~«Я обдумаю это. Прощайте».~
@29268 = ~«Я... не знаю».~
@29269 = ~Ложь: «Меня зовут Адан».~
@29270 = ~Ложь: «Меня зовут Адан».~
@29271 = ~«Это не вас не касается».~
@29272 = ~Уйти.~
@29273 = ~«Я... не знаю».~
@29274 = ~Ложь: «Меня зовут Адан».~
@29275 = ~Ложь: «Меня зовут Адан».~
@29276 = ~«Это довольно щекотливая ситуация, и я прошу вас набраться терпения — я честно не знаю своего имения. Я все забыл».~
@29277 = ~«Я в самом деле не знаю. Я потерял память».~
@29278 = ~Уйти.~
@29279 = ~«Уверяю, мадам, это правда».~
@29280 = ~«Уверяю вас, у меня нет выбора».~
@29281 = ~«Я обдумаю это. Прощайте».~
@29282 = ~«Перед тем, как вы уйдете, мадам, могу ли я попросить у вас об одолжении?»~
@29283 = ~«Тогда прощайте, леди Усердная».~
@29284 = ~«Похоже, гуляя, я нанес оскорбление некоторым местным гражданам...»~
@29285 = ~«Да, мадам».~
@29286 = ~«Весьма благодарен, леди Усердная. Прощайте».~
@29287 = ~«Мадам... Боюсь, что при прошлой нашей встрече я не выказал вам должного уважения. Я надеюсь, что вы примите мои извинения».~
@29288 = ~«У меня есть несколько вопросов...» ~
@29289 = ~«Я должен идти. Прощайте».~
@29290 = ~«Леди Усердная... постойте, умоляю вас. Боюсь, что при прошлой нашей встрече я не выказал вам должного уважения. Я надеюсь, что вы примите мои извинения».~
@29291 = ~«У меня есть несколько вопросов...»~
@29292 = ~«Тогда пойду. Прощайте».~
@29293 = ~«Рад вас видеть, леди Усердная. У меня есть несколько вопросов...»~
@29294 = ~«Рад вас видеть, миледи. Могу ли я попросить у вас об одолжении?»~
@29295 = ~«Я просто проходил мимо. Прощайте, леди Усердная».~
@29296 = ~Атаковать ее.~
@29297 = ~Попытаться уйти до того, как кто-нибудь придет.~
@29298 = ~«Людскааааая зараза! УМРИИИИИИ!» — крысооборотень кидается на тебя.~
@29299 = ~Отвратительный крысочеловек шипит на тебя: «Чего тебе надо, человек?»~
@29300 = ~Крысооборотень презрительно осматривает тебя сверху донизу. «Не твоего ума дело, человек», — хихикает он.~
@29301 = ~«Повелитель... должен быть здесь. Несомненно... он следит за тобой, — его усы подергиваются к тебе. — Уходи сейчас же! Я больше не хочу с тобой разговаривать!»~
@29302 = ~«Это наше гнездо. Ты ведь не собираешься часто сюда наведываться, человек? Нам не нужны такие, как ты».~
@29303 = ~«Мантуок? Чего тебе нужно от Мантуока? Если тебе нужен Мантуок, Мантуок сам тебя найдет», — хихикает он и отступает от тебя.~
@29304 = ~«Проклятье, я же только хотел поговорить!»~
@29305 = ~«Кто ты?»~
@29306 = ~«Где Лотар?»~
@29307 = ~«Что это за место?»~
@29308 = ~«Ты знаешь Мантуока?»~
@29309 = ~«Ничего. Прощай».~
@29310 = ~«Что ж, прекрасно. Где Лотар?»~
@29311 = ~«Что это за место?»~
@29312 = ~«Где Мантуок?»~
@29313 = ~«Забудь».~
@29314 = ~«Ну хорошо тогда».~
@29315 = ~«Тебе не стоит об этом беспокоится. Мне кажется, что эта вонь меня и так одолеет. Счастливо».~
@29316 = ~«Скорее всего, нет. Это не слишком приятное место. Прощай».~
@29317 = ~«Тогда скажи мне, где можно найти Лотара».~
@29318 = ~«Тогда расскажи мне об этом месте».~
@29319 = ~«Отлично. Прощай».~
@29320 = ~Ты видишь гибрид человека и крысы. В его красных глазах виден коварный блеск. Из его пасти доносится вкрадчивый голос: «Итак... двуногий пробрался в логово слуг Лотара. Чего же ты хочешь, человек, и куда ты собрался идти? Подойди и скажи Мантуоку правду».~
@29321 = ~При упоминании Лотара крысочеловек пригибает голову и шипит: «Прислал безволосого для работы на Семью? Невозможно!»~
@29322 = ~Мантуок снова шипит на тебя: «Тогда убирайся и не приходи, пока череп не будет у тебя в руках, — он умолкает и с подозрением смотрит на тебя. — У тебя уже есть череп?»~
@29323 = ~Крысочеловек выхватывает отравленный сыр из твоей руки и тщательно обнюхивает его, с подозрением поглядывая на тебя. Он глотает сыр, и его тело сотрясает от спазма. В конвульсиях он падает на землю, из его рта вытекает тоненькая струйка кровавой слюны. «А...»~
@29324 = ~Мантуок хватает сыр из твое руки и с подозрением обнюхивает его. Он прячет сыр и говорит: «Иди, чужак. Мы еще поговорим, когда ты вернешься». Он начинает грызть сыр.~
@29325 = ~«Я Мантуок. Я глас Многоединого и агент Лотара, Повелителя Костей. Здесь я говорю, а ты отвечаешь. Чего тебе здесь нужно?»~
@29326 = ~«Все, что здесь происходит, касается меня. Говори, иначе моя крысиная семья будет есть твою плоть целую вечность».~
@29327 = ~Мантуок стискивает рот и что-то бормочет себе под нос. «Что ж, ладно. Я вкушу твою кровь и познаю тайны твоей плоти. Крысы! Ко мне!» Он нападает.~
@29328 = ~«В этом месте, мясо, вопросы задаю я. Я на них не отвечаю. Чего... тебе... надо?»~
@29329 = ~«Ищешь Лотара? И притом пришел из его убежища. Уходи сейчас же, и я забуду, что видел тебя».~
@29330 = ~«Болтливый череп? Надо же. Пустая трата времени. Надеюсь, ты договорился с хозяином о возвращении твоего друга, потому что другого пути получить его назад нет».~
@29331 = ~«Это совершенно неприемлемо. В логове Семьи ты должен иметь цель».~
@29332 = ~«Да, иди и не возвращайся, иначе пожалеешь».~
@29333 = ~Мантуок внимательно смотрит на тебя и обдумывает свои слова. «Только не подумай, что я забуду твои слова, человек. Иди к хозяину, если хочешь, но помни, что за тобой будут следить до конца твоих дней». Он отходит.~
@29334 = ~«А ты достал тот череп, который нужен хозяину?»~
@29335 = ~«Хм, а почему бы и нет? Хозяин искушен в тайнах силы, а Многоединый — в тайнах города. Возможно, однажды я объединю их усилия и стану от этого сильнее. В таком соглашении Многоединый видит много преимуществ... а обращение жителей Погребенной деревни поможет расширить влияние Лотара и Многоединого. Все в выигрыше, правда? Итак... чего ты здесь добиваешься?»~
@29336 = ~Он хватает сыр из твоей руки и проглатывает его целиком. «Насчет того черепа: ты его достал?»~
@29337 = ~«Это тот, который просил хозяин?»~
@29338 = ~Мантуок презрительно искривляет губы. «Тогда приложи все усилия, чтобы достать его хозяину. Он будет рад твоему возвращению».~
@29339 = ~«Дай его мне, и я отдам его хозяину. Твои услуги больше не нужны».~
@29340 = ~«Ты не понял... — лапы Мантуока сжимаются и разжимаются, его хвост начинает ходить из стороны в сторону. — Это была не просьба. Отдай мне череп. Мы не хотим неприятностей... прежде всего здесь, двуногий. Тут даже такому как ты будет сложно справиться».~
@29341 = ~«Тогда *достань* его, двуногий, и не возвращайся, пока не найдешь его. Не заставляй хозяина ждать».~
@29342 = ~«Нет, человечек, думаю, что сегодня умру не я. Я вырву нужный хозяину череп из твоих холодных мертвых пальцев».~
@29343 = ~«Тогда я убью тебя и закопаю твое тело и череп в таком месте, где их никогда не найдут».~
@29344 = ~Мантуок берет череп и критически его обнюхивает. «В катакомбах много, очень много мест, двуногий, не так ли? Много мест, где можно кого-нибудь замуровать, чтобы его крики никогда больше не услышали. В одно из таких мест попадешь ты, — он поворачивается к своим крысолюдям. — Бейте его, пока не упадет. Потом унесите тело в катакомбы и где-нибудь замуруйте. Пусть вечно живет в стене».~
@29345 = ~«Тогда ты не оставляешь мне выбора, — он поворачивается к своим крысолюдям. -Бейте его, пока не упадет. Потом унесите тело в катакомбы и где-нибудь замуруйте. Пусть вечно живет в стене».~
@29346 = ~«Это не болезнь! Это благословение! Я намного лучше тебя, полутрупа».~
@29347 = ~Пока ты говоришь, взгляд Мантуока стекленеет от ярости. Без слов он кидается на тебя.~
@29348 = ~«Нет, мы выше тебя. Мы хищники. Мы охотимся на двуногих. Ты для нас еда».~
@29349 = ~Он поворачивается к своим крысолюдям. «Бейте его, пока не упадет. Потом унесите тело в катакомбы и где-нибудь замуруйте. Пусть вечно живет в стене».~
@29350 = ~«Ты вернулся, человечек. Чего ты хочешь?»~
@29351 = ~«Я выполняю задание Лотара. Мне нужно добыть череп».~
@29352 = ~«Кто ты?»~
@29353 = ~«Я ищу здесь главного».~
@29354 = ~«Я ищу своего друга Морта».~
@29355 = ~«Просто осматриваюсь».~
@29356 = ~«Он сказал, что от тебя нету толку, и что ему нужен кто-то, кому он мог бы довериться. То есть мне».~
@29357 = ~«Тем не менее».~
@29358 = ~«Хочешь сыра, Мантуок?» Дать ему отравленный сыр.~
@29359 = ~Офицер Гармониума~
@29360 = ~Бармен~
@29361 = ~Посетитель кафе~
@29362 = ~Друзилла~
@29363 = ~«Хочешь сыра, Мантуок?»~
@29364 = ~Дать ему отравленный сыр. «Хочешь сыра, Мантуок?»~
@29365 = ~Дать ему сыр. «Хочешь сыра, Мантуок?»~
@29366 = ~«Вообще-то, да».~
@29367 = ~«Еще нет. Но я вернусь с ним».~
@29368 = ~«Прощай, крысочеловек».~
@29369 = ~«Гори в аду, Мантуок».~
@29370 = ~«На здоровье, Мантуок».~
@29371 = ~«Кто такой Многоединый?»~
@29372 = ~«Кто такой Лотар?»~
@29373 = ~«Ты работаешь на них обоих? Разве такое возможно?»~
@29374 = ~«Просто осматриваюсь».~
@29375 = ~«Я ищу хозяина этого места».~
@29376 = ~«Я ищу своего друга Морта».~
@29377 = ~«Это тебя не касается».~
@29378 = ~«Просто осматриваюсь».~
@29379 = ~«Я ищу хозяина этого места».~
@29380 = ~«Я ищу своего друга Морта».~
@29381 = ~«А я уже сказал, что это тебя не касается».~
@29382 = ~«Давай, Мантуок».~
@29383 = ~«Просто осматриваюсь».~
@29384 = ~«Я ищу хозяина этого места».~
@29385 = ~«Я ищу хозяина этого места».~
@29386 = ~«Я ищу своего друга Морта».~
@29387 = ~«Это тебя не касается».~
@29388 = ~«Хорошо».~
@29389 = ~«Я запомню это. Прощай».~
@29390 = ~«Тогда я пошел».~
@29391 = ~«Как угодно. Прощай».~
@29392 = ~«Я запомню это».~
@29393 = ~«У меня есть череп».~
@29394 = ~«Да, от скелета».~
@29395 = ~«Да, от зомби».~
@29396 = ~«Да, от упыря».~
@29397 = ~«Да. От крысооборотня».~
@29398 = ~«Да, от древнего скелета».~
@29399 = ~«Еще нет».~
@29400 = ~Блеф: «Прочь с дороги, Мантуок, не то умрешь на месте».~
@29401 = ~«Хочешь сыра, Мантуок?» Дать ему отравленный сыр.~
@29402 = ~«Хочешь сыра, Мантуок?»~
@29403 = ~«Просто осматриваюсь».~
@29404 = ~«Я ищу хозяина этого места».~
@29405 = ~«Я ищу своего друга Морта».~
@29406 = ~«Это тебя не касается».~
@29407 = ~«У меня есть череп».~
@29408 = ~«Да, от скелета».~
@29409 = ~«Да, от зомби».~
@29410 = ~«Да, от упыря».~
@29411 = ~«Да. От крысооборотня».~
@29412 = ~«Да, от древнего скелета».~
@29413 = ~«Еще нет».~
@29414 = ~Блеф: «Прочь с дороги, Мантуок, не то умрешь на месте».~
@29415 = ~«Хочешь еще сыра, Мантуок?» Дать ему отравленный сыр.~
@29416 = ~«Да».~
@29417 = ~«Нет».~
@29418 = ~«Спасибо, Мантуок».~
@29419 = ~«Нет, я думаю, что доставлю его ему лично».~
@29420 = ~«Хочешь сыра, Мантуок?» Дать ему отравленный сыр.~
@29421 = ~«Хочешь сыра, Мантуок?»~
@29422 = ~Дать ему безымянный череп: «Тогда вот. Возьми этот череп».~
@29423 = ~Дать ему череп Харгримма: «Тогда вот. Возьми этот череп».~
@29424 = ~Дать ему череп Тухлой Мери: «Тогда вот. Возьми этот череп».~
@29425 = ~Дать ему череп Акасты: «Тогда вот. Возьми этот череп».~
@29426 = ~Дать ему череп Соэго: «Тогда вот. Возьми этот череп».~
@29427 = ~Дать ему череп Безмолвного Короля: «Тогда вот. Возьми этот череп».~
@29428 = ~«Возможно, твоя презренная болезнь повредил тебе слух. Я сказал, что я сам передам Лотару череп».~
@29429 = ~«Я сказал, что я сам передам Лотару череп».~
@29430 = ~«Пропусти меня, не то умрешь на месте».~
@29431 = ~«Хочешь сыра, Мантуок?» Дать ему отравленный сыр.~
@29432 = ~«Хочешь сыра, Мантуок?»~
@29433 = ~«Лотар пообещал мне безопасный проход. Если ты станешь у меня на пути, он об этом узнает — либо от меня, либо от моего черепа, если тебе каким-то образом удастся убить меня».~
@29434 = ~Дать ему безымянный череп: «Тогда вот. Возьми этот череп».~
@29435 = ~Дать ему череп Харгримма: «Тогда вот. Возьми этот череп».~
@29436 = ~Дать ему череп Тухлой Мери: «Тогда вот. Возьми этот череп».~
@29437 = ~Дать ему череп Акасты: «Тогда вот. Возьми этот череп».~
@29438 = ~Дать ему череп Соэго: «Тогда вот. Возьми этот череп».~
@29439 = ~Дать ему череп Безмолвного Короля: «Тогда вот. Возьми этот череп».~
@29440 = ~«Я больше не буду заставлять его ждать».~
@29441 = ~«Попробуй».~
@29442 = ~«Попробуй, Мантуок».~
@29443 = ~«Ах ты сукин...»~
@29444 = ~«Ах ты сукин...»~
@29445 = ~«Полагаю, как лучшие вы считаете за привилегию ползать по канавам, питаться отбросами и, временами, мертвечиной, лишь бы не сдохнуть, и ходить в великолепных лохмотьях со своими лысыми чешуйчатыми хвостами, волочащимися за вами по дерьму? Вы — вредители, тени людей, отчаянно желающие быть ими. Жалкое зрелище».~
@29446 = ~«Ты мне не ровня».~
@29447 = ~«Лучше ты сам, чем ты со своими друзьями...»~
@29448 = ~«Ты для меня — как учебная мишень».~
@29449 = ~«Посмотрим на твою попытку...»~
@29450 = ~«Я выполняю задание Лотара. Мне нужно добыть череп».~
@29451 = ~«Я ищу здесь главного».~
@29452 = ~«Я ищу своего друга Морта».~
@29453 = ~«Просто осматриваюсь».~
@29454 = ~Изменилось мировоззрение [Nameless One]~
@29455 = ~Этот старик что-то жует, тихонько бормоча себе что-то под нос... через миг раздается *ХРУМ* — это он что-то раскусывает и глотает. Его густые, вызывающе белые брови на миг хмурятся, потом поднимаются, потом снова хмурятся. «Хм-м-м...»~
@29456 = ~«Приветствую...»~
@29457 = ~Оставить его в покое.~
@29458 = ~Даже не глядя на тебя, старик лезет в тунику, достает оттуда красновато-коричневый шарик, некоторое время с любопытством разглядывает его, затем кладет его в рот.~
@29459 = ~«Приветствую, говорю...»~
@29460 = ~Оставить его в покое.~
@29461 = ~Старик хмурится и отмахивается от тебя, потом задумчиво кивает сам себе, смакуя что-то у себя во рту.~
@29462 = ~«У меня тут... пара вопросов...»~
@29463 = ~Оставить его в покое.~
@29464 = ~Старик ухмыляется, показывает тебе оскорбительный жест, потом вдруг застывает... его щеки надуваются, и, скорчившись в жестоком рвотном позыве, он выплевывает огромную черную муху, которая начинают сновать по комнате. «*Проклятые* минаурозийские конфеты! — кричит он, грозя кулаком насекомому, затем оборачивается к тебе. — Чего тебе?!»~
@29465 = ~«У меня есть вопросы о тебе...»~
@29466 = ~«У меня вопрос насчет этого места...»~
@29467 = ~«Ты знаешь что-нибудь о Равель Заморочке?»~
@29468 = ~«Ничего, прощай».~
@29469 = ~Он закидывает в рот маленькую красную конфетку. «Ты что, всегда вот так бродишь и докучаешь могущественным магам своей невежественной болтовней?! Бормотание, болтовня, трескотня, ТРЕП!» При слове 'треп' конфета выстреливает у него изо рта, летит по высокой дуге и шлепается на пол с влажным *плюх*. Он печально глядит на нее.~
@29470 = ~«Я, э-э-э, сожалею насчет конфеты».~
@29471 = ~Поднять ее и съесть.~
@29472 = ~~
@29473 = ~Он удивленно ворчит, хлопая себя по лбу: «Ничего? *ПРОЩАЙ*?»~
@29474 = ~«А ведь она была такая *вкусная*...» — хнычет он. Внезапно он с рычанием поднимает взгляд. «СОЖАЛЕЕШЬ?! Да уж *конечно*, чертов навозный жук! Маги заслуживают уважения, а такие как ты рубаки должны знать свое место! — он начинает подпрыгивать. — Свое место! Свое место!»~
@29475 = ~«Успокойся. Я всего лишь хотел задать тебе пару вопросов».~
@29476 = ~Схватить конфету мага и съесть ее.~
@29477 = ~~
@29478 = ~Ты хватаешь конфету и кладешь ее себе в рот; у нее терпкий сладкий вкус. У мага отпадает челюсть. «Моя... Моя восхитительная изысканная байтопийская фруктовая конфета!»~
@29479 = ~«Вкусно. Можно еще одну?»~
@29480 = ~«Успокойся. Я всего лишь хотел задать тебе пару вопросов».~
@29481 = ~~
@29482 = ~~
@29483 = ~«Еще одну?! *Еще* одну?! Что за вульгарная дерзость! С чего ты взял, что *заслуживаешь* еще одну конфету, ты, грубый невежественный болван?!»~
@29484 = ~«Я не *заслуживаю*, я *хочу* ее. Давай ее сюда».~
@29485 = ~«Да брось... Дай хоть одну».~
@29486 = ~«Забудь».~
@29487 = ~«Ты ничего не получишь! И еще будешь *радоваться*, — чтобы подчеркнуть это, он причмокивает конфетой во рту. — М-м-м-м. *О-о-объедение*, — он вертит конфетой во рту, его глаза закрыты, будто он пребывает в экстазе. — *Ка-а-ак* же вкусно».~
@29488 = ~«Я *хочу* конфету, и ты мне ее *дашь*. Давай ее сюда».~
@29489 = ~«Что ж, отлично... Забудь об этом».~
@29490 = ~«Именно! Забуду! Забуду, паршивый тухлоголовый пустозвон! А теперь бывай здоров».~
@29491 = ~«Но... У меня было несколько вопросов...»~
@29492 = ~~
@29493 = ~«А мне *НАЧХАТЬ*, каштан ты пустоголовый! — он выпучивает глаза, тыча в тебя пальцем. — А теперь пошел вон отсюда! ПОШЕЛ! ВОН! ОТСЮДА! И не возвращайся, пока не будешь готов проявить ко мне надлежащее уважение... и не принесешь с собой подарок!» Неожиданно он подходит ближе и шепчет уголком рта: «Хорошо бы это были конфеты или шоколад. Но учти: ничего обыкновенного, принеси что-нибудь *экзотическое*. А теперь прочь!»~
@29494 = ~«Постой... У меня тут импортный шоколад. Я бы мог презентовать его тебе...»~
@29495 = ~«Как ты *смеешь* столь грубо *требовать* у меня конфеты, как будто это какое-то священное право, дарованное тебе величайшей из сил! Может, мне просто *пасть ниц* от этой твоей прихоти, о великий? И отдать мои драгоценные конфеты твоему ошрамованному святейшеству? Может, мне сперва умастить их дорогими маслами и благословить?» При каждом слове он топает ногой: «Нет! Нет! Нет! Как бы не так!»~
@29496 = ~«Да брось... Дай хоть одну».~
@29497 = ~«Что ж, отлично. Забудь об этом».~
@29498 = ~Маг мрачнеет, следя за твоим приближением. «Невероятно! Ты снова решил проклянуть меня своим отвратительным присутствием, ты, бездумный смердящий придурок? — он прерывает свою речь, чтобы съесть маленький мятный леденец. — Надеюсь, ты научился хоть каким-то *манерам*!»~
@29499 = ~«Я принес тебе немного импортного шоколада — в качестве подарка».~
@29500 = ~«Вообще-то, у меня есть несколько вопросов...»~
@29501 = ~«Я должен идти. Прощай».~
@29502 = ~«О? — его поведение вмиг меняется. — Так любезно с твоей стороны, так по-джентльменски! Можно посмотреть?»~
@29503 = ~Показать ему шоколадного квазита.~
@29504 = ~«Вообще-то, нет».~
@29505 = ~«Это подождет. Прощай».~
@29506 = ~Он отступает, совершенно ошеломленный. «ЧТО?!»~
@29507 = ~«Я просто пошутил. Вот...»~
@29508 = ~«Вообще-то, я не думаю, что ты его заслужил. Ты был таким грубым».~
@29509 = ~«Я принесу его позже. Счастливо».~
@29510 = ~«Ты... ты *что*? — он начинает подпрыгивать. — Абсурд! Нелепость! Бред! *ГРУБО* было бы превратить тебя в миску бааторийских пряных бобов, съесть тебя, а потом развеять тебя по Сигилу маленькими зловонными пуками из моего зада! Вот *ЭТО* уж точно было бы грубо, и я *ничего* подобного не сделал!»~
@29511 = ~«Как бы там ни было, ты его не получишь, пока не извинишься».~
@29512 = ~«Я просто пошутил. Вот...»~
@29513 = ~«Возможно, я принесу его позже. Прощай».~
@29514 = ~Он тут же умолкает, его глаза сужаются с подозрением. «Ну, ты для начала хоть дашь мне *посмотреть* на этот подарок?»~
@29515 = ~Дать ему только посмотреть на шоколадный квазит.~
@29516 = ~«Я, по правде говоря, просто пошутил. Вот, держи...»~
@29517 = ~«Возможно, я принесу его позже. Прощай».~
@29518 = ~Шапочка старика взлетает в воздух с гулким *чпок* и приземляется ему на голову. «Ух... ух ты. Это... это ведь?..» Он облизывается и робко тянется к шоколадному квазиту.~
@29519 = ~«Э, нет. Проси прощения. Сейчас же».~
@29520 = ~«Э, нет. Проси прощения. Сейчас же».~
@29521 = ~Позволить ему забрать его.~
@29522 = ~«Возможно, я принесу его позже. Прощай».~
@29523 = ~Он морщится, закусывает губу и молча трясет кулаками. Наконец он останавливается, разглаживает свои одежды и медленно выдыхает. «Очень хорошо, сэр. Прошу прощения». Ты замечаешь, что одну руку он держит у себя за спиной.~
@29524 = ~«Хм. Ладно, вот шоколадный квазит».~
@29525 = ~«Возможно, я принесу его позже. Прощай».~
@29526 = ~Он морщится, закусывает губу и молча трясет кулаками. Наконец он останавливается, разглаживает свои одежды и медленно выдыхает. «Очень хорошо, сэр. Прошу прощения». Ты замечаешь, что одну руку он держит у себя за спиной.~
@29527 = ~«Молчать, болтливый... о! Я имею в виду: а что, я ничего такого не делал!» Маг невинно улыбается тебе, предоставив свои руки для осмотра.~
@29528 = ~«Хм. Ладно, вот шоколадный квазит».~
@29529 = ~«Возможно, я принесу его позже. Прощай».~
@29530 = ~Он берет его у тебя из рук. «О... он довольно редкий — и просто восхитительный». Он откусывает большой кусок и прячет в тунику то, что от него осталось.~
@29531 = ~«У меня есть несколько вопросов...» ~
@29532 = ~«Ладно. Прощай».~
@29533 = ~Он хмурится, слизывая с пальцев остатки шоколада. «Кто тебя надоумил надоедать мне глупыми вопросами?! — он осуждающе смотрит на тебя. — Давай уже... выкладывай, чем ты там хотел мне подокучать, или проваливай!» Он выуживает из рукава солодовый шарик и съедает его.~
@29534 = ~«Кто ты?»~
@29535 = ~«Я хотел бы купить несколько заклинаний».~
@29536 = ~~
@29537 = ~«Можно мне конфету?»~
@29538 = ~Он закатывает глаза, взмахом руки указывая тебе продолжать.~
@29539 = ~«Я хочу купить немного конфет».~
@29540 = ~«Что ты можешь рассказать об этом месте?»~
@29541 = ~«Ты знаешь что-нибудь о Равель Заморочке?»~
@29542 = ~«Ничего. Прощай».~
@29543 = ~«Кто ты?»~
@29544 = ~«Я хотел бы купить несколько заклинаний».~
@29545 = ~~
@29546 = ~«Можно мне конфету?»~
@29547 = ~«Я хочу купить немного конфет».~
@29548 = ~«Что ты можешь рассказать об этом месте?»~
@29549 = ~«Ты знаешь что-нибудь о Равель Заморочке?»~
@29550 = ~«Ничего. Прощай».~
@29551 = ~«Я... Квелл... — он властно поднимает руку, как бы удерживая тебя от представления. — И не представляйся: ты, должно быть, и есть тот самый чемпион по хамству и занудности по эту сторону Сигила, о котором я так много слышал!»~
@29552 = ~«Как же я *рад* встретить тебя, и хвала силам, что они не подождали, пока ты не загнешься и не помрешь, и не уберегли меня от мук быть вынужденным подшучивать над тобой! Я бы с радостью обменял свои внушительные магические силы только лишь на то, чтобы пробить твой толстый череп и познакомить тебя хотя бы со смыслом слова 'манеры'!»~
@29553 = ~«Манеры? А как на счет того шоколада, который я тебе принес?»~
@29554 = ~«Внушительные магические силы? А ты не мог бы обучить меня?»~
@29555 = ~«У меня есть другие вопросы...»~
@29556 = ~«Это все, что я хотел узнать. Прощай».~
@29557 = ~Он поднимает палец и раскрывает рот, чтобы ответить, но останавливается. «Хм. Тут ты меня подловил». Он пожимает плечами и съедает еще одну конфету.~
@29558 = ~«Так я и думал. У меня есть другие вопросы...»~
@29559 = ~«Это уж точно. Прощай».~
@29560 = ~Он выглядит сбитым с толку. «Я? Шляпа? Не морочь мне голову... Я не ношу шляпу!» Он надувает губы и с подозрением смотрит на тебя суженными глазами.~
@29561 = ~«Если это не шляпа, тогда что это светится у тебя на голове?»~
@29562 = ~«Нет, но меня есть еще вопросы...»~
@29563 = ~«Ладно... неважно. Прощай».~
@29564 = ~«Полнейший бред! Нет у меня ничего на голове... нету, говорю! И я больше не буду это обсуждать, так вот».~
@29565 = ~«Хм-м. У меня еще вопросы...»~
@29566 = ~«Ладно... неважно. Прощай».~
@29567 = ~«Конфету?! И еще разок, на всякий случай: *конфету*?! С чего, умоляю, скажи, с чего ты решил, что я *дам* конфету такому полуголому хаму, как ты, м-м-м?» Он топает ногой, скрестив руки на груди, в ожидании твоего ответа.~
@29568 = ~«Тогда, может, *продашь* мне парочку?»~
@29569 = ~«Ничего. У меня есть другой вопрос...»~
@29570 = ~«Ничего. Прощай».~
@29571 = ~«Ну, это... это я *могу*. Но предупреждаю: я торгую конфетами, но не обычными, а конфетами... *силы*!» — он протягивает последнее слово, жадно потирая руки...~
@29572 = ~«Конфеты... силы?»~
@29573 = ~Он кивает. «Именно. Заметь, они *недешевые*, так что если у тебя недостаточно звенелок, советую *немедленно* закрыть эту тему. Хочешь посмотреть, что у меня есть, м-м-м?» Он склоняет голову набок и лукаво смотрит на тебя.~
@29574 = ~«Да».~
@29575 = ~«Нет, но у меня есть пара вопросов...»~
@29576 = ~«Нет, спасибо. Прощай».~
@29577 = ~«Ты находишься в Городском Фестхолле, в недоступном... *весьма* недоступном месте, пока *ты* не ворвался сюда... частном сенсориуме. Поговори с человеком в фойе Фестхолла, Сплинтером, если у тебя возникнут другие глупые вопросы об этом месте».~
@29578 = ~«Позволь мне спросить кое о чем еще...»~
@29579 = ~«Это все, что я хотел узнать. Прощай».~
@29580 = ~При упоминании ее имени конфета становится ему поперек горла. Он громко глотает конфету, содрогнувшись от боли. «Что рассказать?! Да и зачем вообще? Подобные вещи, подобные истории лучше оставить в пыльных книгах на чердаках памяти стариков! Зло, зло! Такое имя, такое имя... темные истории роятся вокруг него, как мухи над трупом».~
@29581 = ~«Тем не менее, я хотел бы услышать о ней».~
@29582 = ~«Неважно. У меня есть другие вопросы...»~
@29583 = ~«Забудь, что я спрашивал. Прощай».~
@29584 = ~Он закатывает глаза, закинув в рот еще одну конфету. «Она ночная ведьма, мальчик мой, которая пришла в Сигил... всецело порочная, злобно хихикающая, исполненная своей теневой магией, готовая столкнуться лбом с Леди Боли. Чокнутая, чокнутая, чокнутая старая карга... и что ей удалось, так это попасть в лабиринт. Теперь она уже, вероятно, мертва».~
@29585 = ~«Теневая магия?»~
@29586 = ~«Как мне ее найти?»~
@29587 = ~«Как мне ее найти?»~
@29588 = ~«Лабиринт?»~
@29589 = ~«Леди Боли?»~
@29590 = ~«У меня есть другие вопросы...»~
@29591 = ~«Это все, что я хотел узнать. Прощай».~
@29592 = ~«Да-да-да... — ему, похоже, неловко о ней говорить. — Равель кое-что понимала... да нет, не кое-что — она была *лучшей* во всех магических школах. Она знала теневую магию — магию иллюзии и материи теней, останков мертвых».~
@29593 = ~«Как мне ее найти?»~
@29594 = ~«Как мне ее найти?»~
@29595 = ~«У меня есть другие вопросы...»~
@29596 = ~«Это все, что я хотел узнать. Прощай».~
@29597 = ~«Как бы тебе ЧТО?!» Его конфета вылетает изо рта и падает на пол. Ты не успеваешь и глянуть на нее, как он подхватывает ее и кидает обратно в рот, окинув тебя раздраженным взглядом.~
@29598 = ~«Зачем... зачем тебе *спрашивать* о подобном? Ты что, *СПЯТИЛ*? Да что тебе вообще понадобилось от этой злобной твари?»~
@29599 = ~«Она кое-что знает о моем прошлом».~
@29600 = ~«Не обращай внимания... так что ты там говорил о теневой магии?»~
@29601 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29602 = ~«Забудь, что я спрашивал. Прощай».~
@29603 = ~«Сомневаюсь... ее заточили в лабиринт много веков назад. Нет уже ее — попала в книгу мертвых. И даже если она почему-то, по *как-то* причине, все еще держится за жизнь своими почерневшими от крови когтями, что она *может* знать о *тебе*? То есть, не будь она шипящим воплощением хихикающего зла, и даже если бы она *хотела* тебе помочь...»~
@29604 = ~«Я просто надеюсь, что она жива и поможет мне».~
@29605 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29606 = ~«Забудь, что я спрашивал. Прощай».~
@29607 = ~«Во имя шести сисек Лиши и ее вздутого животика, что это, если не мерцающая свеча надежды, брошенная в воющие ветра Пандемониума! *Блим-блим-уууу*! Не будь глупее, чем это необходимо!»~
@29608 = ~«Мне в любом случае нужно ее найти, жива она или мертва».~
@29609 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29610 = ~«Забудь, что я спрашивал. Прощай».~
@29611 = ~«А если она мертва, а она наверняка мертва, то что ты будешь тогда делать, позволь поинтересоваться? Ты ведь все продумал, не так ли? Квелл просто сыплет словами из своих карманов — чепуха, глупости! Что *именно* ты планируешь предпринять, если она в книге мертвых, а?»~
@29612 = ~«Не знаю. Что-нибудь придумаю».~
@29613 = ~«И что же, по-твоему, я должен сделать?»~
@29614 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29615 = ~«Забудь, что я спрашивал. Прощай».~
@29616 = ~«Вай, вай, вай, лучше плана я не слыхал! Чистейшая, ослепительно гениальная идея! При этом не зная, как пробраться в лабиринт, как выбраться оттуда, жива ли она, и, конечно же, не зная, что делать, если она жива. Да я с таким же успехом мог бы разговаривать с лемуром, учитывая все то бредовое безрассудство, которое из тебя хлещет!»~
@29617 = ~«Ты можешь мне сказать, как добраться до ее лабиринта?»~
@29618 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29619 = ~«Забудь, что я спрашивал. Прощай».~
@29620 = ~«Сумасшедший! Безумец! Пустоголовый! Ты что, не понял, что я сказал?! Она заключена в межпространственный *лабиринт* за то, что пыталась переплюнуть саму *ЛЕДИ БОЛИ*! Это значит, что она как минимум вдесятеро более чокнутая, чем ты, и по крайней мере в сотню раз более могущественная! Да она, скорее всего, мертва, мертва, мертва, трижды мертва... и даже если по какой-то счастливой случайности она выжила... она сделает мертвым *тебя*!»~
@29621 = ~«Понимаю, но мне действительно нужна твоя помощь. Ты можешь подсказать мне, как до нее добраться, или нет?»~
@29622 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29623 = ~«Забудь, что я спрашивал. Прощай».~
@29624 = ~Квелл умолкает, пожевывая губу. Пару секунд спустя он выуживает из туники мятный леденец и закидывая его себе в рот. «Ты серьезно? На полном серьезе? К чему вся эта серьезность, этот бааторизм, это ослиное упрямство? — он вздыхает. — Ну что ж, невеждой больше — невеждой меньше».~
@29625 = ~«Да?..»~
@29626 = ~«Во всех лабиринтах есть порталы; уж это я *знаю* наверняка. Вход, выход... именно так их и строит Леди Боли. Я ничего не знаю о портале — ни его расположение, ни даже форму, — но мне рассказывали о ключе к нему... это кусочек Равель».~
@29627 = ~«Кусочек Равель? Но если Равель в ЛАБИРИНТЕ, то как же мне тогда...»~
@29628 = ~«Значит, тебе придется извернуться. Знаешь что, найди что-нибудь, испорченное Равель... это все, что я знаю! Все! И больше не беспокой меня этим! Если хочешь надоедать еще кому-нибудь на этот счет, направляйся в Бордель утоления интеллектуальной страсти — одна из тамошних дамочек наверняка встречала кого-то либо слышала нечто, что может тебе помочь».~
@29629 = ~«Спасибо. У меня есть другие вопросы...»~
@29630 = ~«Благодарю за помощь. Прощай».~
@29631 = ~«Первый блестящий вопрос из тех, что ты задал! По-моему? *Я* считаю, что тебе следует бросить эту бестолковую идею насчет того, чтобы пробраться в лабиринты, поболтать с ночной ведьмой и заскочить назад в склеп, откуда ты выполз! Это намного лучшая мысль, чем нарываться на гнев Леди, это уж точно».~
@29632 = ~«Ты можешь мне сказать, как добраться до ее лабиринта?»~
@29633 = ~«Забудь об этом. У меня есть другие вопросы...»~
@29634 = ~«Забудь, что я спрашивал. Прощай».~
@29635 = ~«*Учить* тебя?! Ха! А ты что, еще и *маг*?»~
@29636 = ~«Да».~
@29637 = ~«Нет, но я надеялся, что ты поможешь мне им стать».~
@29638 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@29639 = ~«Забудь, что я спрашивал. Прощай».~
@29640 = ~Он усмехается тебе. «О-о-о, если бы только у меня был Ботинок праведного задопинания Бигзби, чтобы кинуть им в тебя! НЕТ! Я абсолютно точно *не сделаю* из тебя мага, болван ты эдакий с бульоном вместо мозгов! Сделать такое — значит, унизить Искусство!»~
@29641 = ~«Тогда у меня есть несколько вопросов...»~
@29642 = ~«Тогда неважно. Прощай».~
@29643 = ~«О! Что за чудеса припасены на сегодня мультивселенной для Квелла! Давай, показывай свою книгу заклинаний».~
@29644 = ~Позволить ему осмотреть ее.~
@29645 = ~«Не думаю. Позволь мне спросить кое о чем еще...»~
@29646 = ~«Может, в другой раз. Прощай».~
@29647 = ~Он вырывает ее у тебя из рук и неистово листает. «Это еще что за мусор?! Я тебе отвечу: дерьмо! Дерьмо, дерьмо, дерьмо! Как ты вообще разбираешь заклинания на этих грязных страницах... ты, небось, подставляешь ее под пиво — она вся в выпивке, клею и крови! Да ты не ухаживаешь за своей книгой заклинаний?! Как я могу учить того, кто не уважает Искусство?!»~
@29648 = ~«Почему ее вид имеет значение?»~
@29649 = ~«В ней мои заклинания. Ее вид значения не имеет».~
@29650 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@29651 = ~«Забудь, что я спрашивал. Прощай».~
@29652 = ~«Внешний вид твоей книги заклинаний должен отражать твое уважение к силам, которые она хранит. Эта твоя дрянная книженция годится только для простейших чар! *Истинные* заклинания следует записывать редкими дорогими чернилами на пергаментных листах, окаймленных листовым золотом! Все должно быть как надо, или вообще никак! — он начинает бешено скакать. — Как надо! Как надо!»~
@29653 = ~«Понятно... Так ты научишь меня, или нет?»~
@29654 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@29655 = ~«Забудь, что я даже спрашивал. Прощай».~
@29656 = ~«Нелепость! Абсурд! Да это самое смехотворное утверждение из тех, что я слышал! И кто же *учил* тебя Искусству?»~
@29657 = ~«Повитуха с площади Старьевщиков, Меббет».~
@29658 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@29659 = ~«Забудь, что я даже спрашивал. Прощай».~
@29660 = ~«Позор тому, кто порет такую несусветную чушь! Погляди на эти заклинания! Что за бредовая чепуха тут накалякана: грязное волшебство с названиями сглазов и мумба-юмбой! Банальная, мелочная, мерцающая как свеча магия с напыщенными названиями!»~
@29661 = ~«И все же, почему же ее вид имеет значение?»~
@29662 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@29663 = ~«Забудь, что я даже спрашивал. Прощай».~
@29664 = ~Он закрывает глаза и пару секунд массирует виски. Наконец он произносит холодным ровным тоном: «Очевидно, что я ничему не смогу тебя научить. Однако у меня имеются кое-какие заклинания, которые ты, возможно, захочешь *приобрести*. Хочешь на них посмотреть? М-м-м?»~
@29665 = ~«Да».~
@29666 = ~«Не сейчас. У меня есть еще несколько вопросов...»~
@29667 = ~«Нет, спасибо. Прощай».~
@29668 = ~Квелл оглядывается вокруг, когда ты подходишь. «Проклятье! Уже негде спрятаться! — он громко вздыхает. — Ну, выкладывай! Что ты *теперь* от меня хочешь, м-м-м?» Он закидывает себе в рот конфету и выжидающе смотрит на тебя.~
@29669 = ~«У меня есть несколько вопросов...» ~
@29670 = ~«Ничего, я просто проходил мимо. Прощай».~
@29671 = ~Он мрачно кивает. «Леди Боли, она... 'правит' Сигилом: держит силы подальше от него и тому подобное. Одним из наказаний, припасенных ею для тех, кто пересекает ей дорогу, является заключение в лабиринт... она откалывает кусок Сигила, перекручивает и забрасывает его черт-знает-куда вместе с провинившимся внутри. И тогда он пропал, пропал, пропал для планов!»~
@29672 = ~«Ты упоминал магию теней...»~
@29673 = ~«Как мне ее найти?»~
@29674 = ~«Как мне ее найти?»~
@29675 = ~«У меня есть другие вопросы...»~
@29676 = ~«Это все, что я хотел узнать. Прощай».~
@29677 = ~«Эй, шеф, он скрестил пальцы!»~
@29678 = ~Салабеш Оникс~
@29679 = ~Главарь головорезов~
@29680 = ~Головорез с Чиновничьего района~
@29681 = ~Немель~
@29682 = ~Эльвин~
@29683 = ~Курьер~
@29684 = ~Курьер Джолми~
@29685 = ~Актер~
@29686 = ~Актер~
@29687 = ~Малманер~
@29688 = ~Гадалка~
@29689 = ~Элобранд~
@29690 = ~Старый поэт~
@29691 = ~Подвыпившая распутница~
@29692 = ~Сархава Вджул~
@29693 = ~Подхалим Сарахвы~
@29694 = ~Тренирующийся маг~
@29695 = ~Привратник Фестхолла~
@29696 = ~Тренирующийся маг~
@29697 = ~Тренирующийся вор~
@29698 = ~Тренирующийся вор~
@29699 = ~Тренирующийся воин~
@29700 = ~Тренирующийся воин~
@29701 = ~Чувствующий-проводник~
@29702 = ~Куратор галереи искусств~
@29703 = ~Не обращать на него внимание и осмотреть контору.~
@29704 = ~«Хорошо. Чем могу быть полезен?»~
@29705 = ~«Прошу прощения за вопрос, но с тобой все в порядке?»~
@29706 = ~«Прошу прощения за вопрос, но с тобой все в порядке?»~
@29707 = ~«С тобой все в порядке?»~
@29708 = ~«С тобой все в порядке?»~
@29709 = ~«Мы раньше не встречались?»~
@29710 = ~«Еще раз, кто ты?»~
@29711 = ~«Еще раз, что это за место?»~
@29712 = ~«Еще раз, что такое адвокат?»~
@29713 = ~Слуга Вришики~
@29714 = ~«Ты можешь рассказать мне про наследства?»~
@29715 = ~«Вот наследство Дейонарры, как я и обещал».~
@29716 = ~Пестик~
@29717 = ~«Ты мог бы рассказать мне о пожаре?»~
@29718 = ~Килн~
@29719 = ~«Ты мог бы рассказать мне о своей дочери?»~
@29720 = ~Параметры аудио~
@29721 = ~«Янис, я выяснил, что произошло с Дейонаррой».~
@29722 = ~Параметры игры~
@29723 = ~Клавиши~
@29724 = ~«Сегодня — ничем. Я должен идти... Прощай».~
@29725 = ~Ты видишь Яниса... Когда ты входишь, он поворачивается и бросает на тебя усталый взгляд. Под его глазами темные мешки, и у него такой вид, будто он не выспался.~
@29726 = ~На весь экран~
@29727 = ~«Приветствую, Янис».~
@29728 = ~Игнорировать Яниса.~
@29729 = ~«Снова вы, — смотря на тебя, Янис слегка хмурится. — Чего вы хотите на этот раз?»~
@29730 = ~«У меня есть вопросы к тебе...»~
@29731 = ~«Сегодня — ничего, спасибо».~
@29732 = ~Ты видишь Яниса... Когда ты входишь, его глаза вспыхивают надеждой. «Ах, наконец! Вам удалось убедить их предоставить мне доступ в сенсориум?»~
@29733 = ~«Да. Они согласились предоставить тебе доступ к камню переживаний твоей дочери».~
@29734 = ~«Сперва я хочу получить ответы на несколько вопросов».~
@29735 = ~«Пока еще нет. Надеюсь, скоро у меня будут для тебя новости. Прощай».~
@29736 = ~Человек прищуривается, будто пытаясь узнать тебя. «Да? Чем могу быть полезен?»~
@29737 = ~«Кто ты?»~
@29738 = ~«Извини. Кажется, я не туда попал. Прощай».~
@29739 = ~«Меня зовут Янис, — он осматривает тебя и хмурится. — Вы меня искали?» ~
@29740 = ~«Не знаю... что это за место?»~
@29741 = ~«Прошу прощения... ты уже это говорил. Возможно, ты можешь мне еще чем-то помочь?..»~
@29742 = ~«Извини. Кажется, я не туда попал. Прощай».~
@29743 = ~«Как я уже говорил, меня зовут Янис. Вы чего-нибудь хотели?» ~
@29744 = ~«Не уверен... Что это за место?»~
@29745 = ~«Прошу прощения... ты уже это говорил. Возможно, ты можешь мне еще чем-то помочь?..»~
@29746 = ~«Извини. Кажется, я не туда попал. Прощай».~
@29747 = ~«Я адвокат. Это моя контора, — в голосе Яниса появляются нотки раздражения. — Вам нужна консультация? Если нет, тогда лучше бы вам удовлетворить свое любопытство в другом месте».~
@29748 = ~«Адвокат? Что это значит?»~
@29749 = ~«Адвокат? Что это значит?»~
@29750 = ~«Адвокат? Что это значит?»~
@29751 = ~«Извини, что побеспокоил. Прощай».~
@29752 = ~«Я адвокат. Это моя контора. Ко мне приходят за консультациями».~
@29753 = ~«За какими консультациями?»~
@29754 = ~«За какими консультациями?»~
@29755 = ~«Понятно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29756 = ~«Тогда извини, что побеспокоил. Прощай».~
@29757 = ~Янис становится еще более мрачным. «Адвокат дает консультации, помогает другим разобраться в лабиринтах сигильского законодательства, организовывает для горожан наследства, чтобы обеспечить выбранное ими разделение их имущества после смерти, защищает в судах Сигила тех, кого несправедливо обвинили... — он умолкает. — Вам нужна помощь в одной из этих областей?»~
@29758 = ~«Наследства?»~
@29759 = ~«Вообще-то, мне кажется, что у тебя есть наследство для меня».~
@29760 = ~«Вообще-то, я пришел забрать наследство одной девушки...»~
@29761 = ~«Вообще-то, мне нужны консультации».~
@29762 = ~«Нет, не сегодня. Прощай».~
@29763 = ~«Адвокат помогает другим разобраться в лабиринтах сигильского законодательства, организовывает для горожан наследства, чтобы обеспечить выбранное ими разделение их имущества после смерти, защищает в судах Сигила тех, кого несправедливо обвинили... — он умолкает. — Вам нужна помощь в одной из этих областей?»~
@29764 = ~«Наследства?»~
@29765 = ~«Вообще-то, мне кажется, что у тебя есть наследство для меня».~
@29766 = ~«Вообще-то, я пришел забрать наследство одной девушки...»~
@29767 = ~«Вообще-то, мне нужны консультации».~
@29768 = ~«Нет, не сегодня. Прощай».~
@29769 = ~«Это соглашения, которые вступают в действие после смерти клиента. Они описывают детали того, как должно быть разделено его имущество в случае его кончины. Еще я слышал, что их называют *завещаниями*».~
@29770 = ~«Они что-то вроде контрактов тленных?»~
@29771 = ~«Вообще-то, мне кажется, что у тебя есть наследство для меня».~
@29772 = ~«Вообще-то, я пришел забрать наследство одной девушки...»~
@29773 = ~«Понятно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29774 = ~«Это все, что я хотел узнать. Прощай».~
@29775 = ~«Что вы, нет! Контракты тленных, хоть и вступают в действие в час смерти клиента, завещают его тело тленным; не самый приятный бизнес, но те, кто не сводит концы с концами, находят в этих контрактах средства к существованию...»~
@29776 = ~«Как можно расторгнуть контракт тленных?»~
@29777 = ~«Прошу прощения... ты не мог бы еще раз объяснить мне, что такое наследство?»~
@29778 = ~«Понятно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29779 = ~«Спасибо. Это все, что я хотел узнать. Прощай».~
@29780 = ~Он слегка хмурится. «Который уже подписан? Когда подпись уже поставлена, мало что можно сделать. Контракты тленных очень скрупулезно указывают, где будет пребывать тело после смерти. Не считая уничтожения контракта, больше ничего сделать нельзя».~
@29781 = ~«Понятно. Я что-нибудь должен тебе за эти сведения?»~
@29782 = ~«Прошу прощения... ты не мог бы еще раз объяснить мне, что такое наследство?»~
@29783 = ~«Понятно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29784 = ~«Спасибо. Это все, что я хотел узнать. Прощай».~
@29785 = ~«В самом деле? Хорошо... вы помните номер наследства?»~
@29786 = ~«Кажется, номер наследства '51-АА'».~
@29787 = ~«Номер наследства девушки '687-КС'».~
@29788 = ~«Номер наследства девушки '687-КС'».~
@29789 = ~«Ну, в данный момент — нет. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29790 = ~«Нет, похоже, я ошибся. Неважно».~
@29791 = ~Когда ты называешь наследство, он удивленно смотрит на тебя. «Оно невероятно старое... Вы уверены?.. — на его лице читается потрясение. — Надеюсь, оно не из числа сгоревших...»~
@29792 = ~«Насколько оно старое?»~
@29793 = ~«Сгоревших?»~
@29794 = ~«Ты не мог бы проверить, есть ли у тебя это наследство до сих пор?»~
@29795 = ~«А вообще, неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29796 = ~«Думаю, с наследством я ошибся. Неважно».~
@29797 = ~«Ну... — Янис некоторое время обдумывает это. — Ему, как минимум, несколько десятков лет».~
@29798 = ~«Ты сказал, что оно могло быть в числе сгоревших? Что ты имел ввиду?»~
@29799 = ~«Ты не мог бы проверить, есть ли у тебя это наследство до сих пор?»~
@29800 = ~«А вообще, неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29801 = ~«Думаю, с наследством я ошибся. Неважно».~
@29802 = ~Янис выглядит опечаленным. «Да, эта контора была подвергнута бессмысленному акту вандализма. Год назад в нее незаконно проникли. Похоже, единственной целью взломщика было сжечь мои юридические документы. Многое было утеряно. Как жаль. Сигил может быть крайне... утомительным испытанием для веры... — при упоминании Сигила он, казалось бы, съеживается. — Взломщик уничтожил только отдельные бумаги. Незаменимые».~
@29803 = ~«Насколько старо это наследство?»~
@29804 = ~«Ты не мог бы проверить, есть ли у тебя это наследство до сих пор?»~
@29805 = ~«Ты можешь рассказать мне что-нибудь еще о пожаре?»~
@29806 = ~«А вообще, неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29807 = ~«Думаю, с наследством я ошибся. Неважно».~
@29808 = ~Он быстро кивает. «О, да, конечно... Это займет минуту».~
@29809 = ~«Хорошо, я подожду».~
@29810 = ~«А вообще, неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29811 = ~«Нет, кажется, я ошибся насчет наследства. Неважно».~
@29812 = ~Янис возвращается, кивая. «Да, к счастью, оно не пострадало в пожаре. Все предметы в целости».~
@29813 = ~«Я могу его забрать? Я наследник».~
@29814 = ~«А вообще, неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29815 = ~«Спасибо. Я только хотел удостовериться, что оно в целости. Прощай».~
@29816 = ~ «Конечно... подпишитесь здесь и здесь... над пунктирной линией...»~
@29817 = ~«Здесь и здесь? Хорошо...»~
@29818 = ~«Ну вот. На этом кончается бумажная волокита. Вот все вещи, которые были в хранилище... одна из них напоминает квитанцию Литейной, к тому же, несомненно, весьма старую. Покойный что-то заказывал в Литейной?»~
@29819 = ~«По правде говоря, я не знаю. Возможно... Мне начинает казаться, что может быть что угодно. Где находится Литейная?»~
@29820 = ~«Она находится в Нижнем районе, за массивными воротами. Ищите стражу боголюдей у ворот — и вы не ошибетесь».~
@29821 = ~«Хорошо. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29822 = ~«Спасибо за указания. Я сейчас же туда направлюсь».~
@29823 = ~«Я не из тех людей, которые берут плату за подобную помощь, — он слегка улыбается. — Я адвокат, а не торговец коврами, и в моей конторе нет места жадности».~
@29824 = ~«Спасибо... Я признателен тебе. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29825 = ~«Тогда прими мою благодарность. Счастливо».~
@29826 = ~«Это же... — его глаза расширяются, когда ты называешь наследство. — Наследство моей *дочери*?! — он выглядит шокированным. — Откуда вы знаете мою дочь?!»~
@29827 = ~«Не знаю. Надеюсь, наследство даст ответ на этот вопрос».~
@29828 = ~«Вообще-то, это законное основание, и тебя не касается».~
@29829 = ~«Это тебя не касается. Ты можешь проверить, есть ли у тебя это наследство до сих пор?»~
@29830 = ~«Думаю, я ошибся насчет наследства. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29831 = ~«Я извиняюсь, это было другое наследство. Извини за беспокойство... Прощай».~
@29832 = ~«Зачем... — Янис, похоже, не может подобрать слов. — Кто вы такой, сэр, чтобы моя дочь оставляла вам наследство?»~
@29833 = ~«Возможно, я когда-то ее знал... но забыл».~
@29834 = ~«Как я уже говорил, я не знаю. Надеюсь, наследство ответит на этот вопрос».~
@29835 = ~«Вообще-то, это законное основание, и тебя не касается».~
@29836 = ~«Это тебя не касается. Ты можешь проверить, есть ли у тебя это наследство до сих пор?»~
@29837 = ~«Думаю, я ошибся насчет наследства. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29838 = ~«Я извиняюсь, это было другое наследство. Извини за беспокойство... Прощай».~
@29839 = ~Янис внимательно изучает твое лицо. «Вы кажетесь мне чем-то *знакомым*...»~
@29840 = ~«Ты знаешь, кто я?»~
@29841 = ~«Возможно, если бы у тебя было наследство, оно смогло бы ответить на некоторые из наших вопросов».~
@29842 = ~«Ты можешь отдать мне ее наследство, пожалуйста? Это законное основание, и не тема для споров».~
@29843 = ~«Думаю, я ошибся насчет наследства. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29844 = ~«Прости, я должен идти... Прощай».~
@29845 = ~«Должен признаться, что нет». Янис вздыхает.~
@29846 = ~«Возможно, если бы у тебя было наследство, оно смогло бы ответить на некоторые из наших вопросов».~
@29847 = ~«Ты можешь отдать мне ее наследство, пожалуйста? Это законное основание, и не тема для споров».~
@29848 = ~«Думаю, я ошибся насчет наследства. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29849 = ~«Прости, я должен идти... Прощай».~
@29850 = ~«Конечно, конечно... подождите минуту, я скоро вернусь».~
@29851 = ~«Хорошо. Я подожду».~
@29852 = ~Янис несколько секунд смотрит на тебя, потом его глаза сужаются. «Непременно, — его голос холоден как лед. — Если соизволите, я сию минуту вернусь с ее наследством».~
@29853 = ~«Хорошо».~
@29854 = ~«Вот все входящие в него предметы... — Янис держит в руках три свитка. — Я понятия не имел, что она оставила здесь наследство... — он пялится на них, почти как завороженный. — Вот. Можно... можно прочесть их, сэр?»~
@29855 = ~«Это *личное*. Как адвокат, ты должен это понимать».~
@29856 = ~«Для начала дай прочитать их мне, а потом уж я решу».~
@29857 = ~«Конечно. Вот».~
@29858 = ~«Конечно... — Янис кажется разбитым. — Но прошу, умоляю вас. У меня осталось так мало воспоминаний о моей дочери...»~
@29859 = ~Ложь: «У тебя будет шанс прочесть их. Тем временем, возможно, ты сможешь помочь мне еще в одном деле...»~
@29860 = ~Клятва: «Обещаю, что у тебя будет шанс пересмотреть их. А пока, возможно, ты сможешь помочь мне еще в одном деле...»~
@29861 = ~«Понимаю. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29862 = ~Ложь: «Я не забуду. Я верну их, как только прочту».~
@29863 = ~Клятва: «Я не забуду. Я верну их, как только прочту».~
@29864 = ~«Я понимаю. Прощай».~
@29865 = ~Янис берет свиток и осматривает его. После долгой паузы он медленно поднимает на тебя взгляд. «Вы... многое значили для моей дочери. Она была готова отдать за вас жизнь».~
@29866 = ~«Боюсь, что в этом-то и дело».~
@29867 = ~«Мне кажется, в этом-то и дело».~
@29868 = ~Я согласился помочь психу Нестору из Ночлежки найти его вилку. Бедолага явно спятил, раз держит у себя в кармане оторванное ухо и разговаривает с ним, будто оно может услышать его. Хотя вроде большого вреда от того, что я поищу его вилку, не будет.~
@29869 = ~Вернув Нестору вилку и отправив его домой, я выполнил свою часть уговора с Арло. Он сказал, что я могу отдохнуть в ночлежке бесплатно.~
@29870 = ~Я сделал, как просил Арло, и избавился от Нестора. Хозяин ночлежки был в шоке от того, как я выставил старого дурака, но тем не менее разрешил мне отдыхать в ночлежке бесплатно.~
@29871 = ~Я позволил Янису прочесть наследство Дейонарры. Похоже, ее последние слова принесли ему некоторое облегчение.~
@29872 = ~Я согласился помочь хозяину ночлежки, Арло, избавиться от старого придурка по имени Нестор. Похоже, бродяга обосновался в ночлежке навсегда, и его никто не может выгнать.~
@29873 = ~Янис возвращает тебе свиток. «Спасибо вам, сэр. Я ценю вашу доброту».~
@29874 = ~«Это самое меньшее, что я могу сделать. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29875 = ~«Я скорблю по твоей дочери. Надеюсь, ее слова принесли тебе облегчение. Прощай».~
@29876 = ~Человек некоторое время изучает тебя, нахмурившись в раздумьях. При этом морщины на его лице становятся еще более отчетливыми, и ты вновь поражаешься тому, сколь глубокий отпечаток оставило на нем время. «Нет... и все же вы мне кажетесь знакомым...»~
@29877 = ~«И все же?..»~
@29878 = ~«Неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29879 = ~«Неважно, мне нужно идти».~
@29880 = ~Он продолжает изучать твое лицо, потом качает головой. «Должен признаться, что что-то в вас, сэр, кажется мне знакомым, и я прошу прощения за все обиды, которые моя слабеющая память нанесла вам до сих пор... Я некоторое время был занят. Мы уже *встречались*?»~
@29881 = ~Правда: «Думаю, да. Я и себя-то толком не помню».~
@29882 = ~Ложь: «Нет, я ошибся. Не думаю, что мы встречались».~
@29883 = ~«Занят?»~
@29884 = ~«Занят?»~
@29885 = ~«Занят?»~
@29886 = ~«Неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29887 = ~«Неважно, мне нужно идти».~
@29888 = ~«Хм-м-м. Похоже, это плохо для нас обоих».~
@29889 = ~«Неважно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29890 = ~«Неважно, мне нужно идти».~
@29891 = ~«Хм-м-м. Что ж, хорошо».~
@29892 = ~«Возможно, ты сможешь помочь мне еще в одном деле...»~
@29893 = ~«Я должен идти. Прощай».~
@29894 = ~«По этому делу мало что можно сказать... это был странный, ограниченный в пространстве пожар. Не могу представить, что такого ценного было в тех сгоревших бумагах, однако кто-то, должно быть, хотел уничтожить их».~
@29895 = ~«Возможно, я причастен к тому пожару».~
@29896 = ~«Возможно, я причастен к тому пожару».~
@29897 = ~«Э... удалось найти виновного?»~
@29898 = ~«Удалось найти виновного?»~
@29899 = ~«Ты можешь сказать мне, что сгорело?»~
@29900 = ~«Понятно. Расскажи мне о своей дочери».~
@29901 = ~«Возможно, ты сможешь помочь мне еще в одном деле...»~
@29902 = ~«Я скорблю по твоей утрате. Мне пора идти. Прощай».~
@29903 = ~«Вы? Что вы имеете в виду?»~
@29904 = ~Правда: «Я... мог это сделать на каком-то этапе своей жизни. Когда я был не в своем уме. Я сожалею о содеянном и прошу твоего прощения».~
@29905 = ~Ложь: «Я был магически принужден к тому, чтобы совершить это. Я не понимал, что происходит».~
@29906 = ~«Извини, я оговорился. Расскажи мне о своей дочери».~
@29907 = ~«Прости, я не имел в виду ничего такого. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29908 = ~«Это неважно. Прощай».~
@29909 = ~«Нет... — лицо Яниса твердо как камень. — Я вас отчетливо слышал. Вы утверждали, что причастны к тому пожару. Зачем вам утверждать это? Вы что, с ума сошли?!»~
@29910 = ~Правда: «Я... мог это сделать на каком-то этапе своей жизни. Когда я был не в своем уме. Я сожалею о содеянном и прошу твоего прощения».~
@29911 = ~Ложь: «Я был магически принужден к тому, чтобы совершить это. Я не понимал, что происходит».~
@29912 = ~«Еще раз повысишь на меня голос, и в следующий раз это место сгорит дотла».~
@29913 = ~Янис в гневе стискивает зубы. «Ты... сигильская *дворняга*! Я надеялся, что ты покажешься после своего трусливого поступка! Ты нанес ущерб моему дому и повредил ценные для меня вещи, а теперь вернуться, как вампир в ночи, и еще СМЕЕШЬ мне угрожать?!»~
@29914 = ~Правда: «Я... мог это сделать на каком-то этапе своей жизни. Когда я был не в своем уме. Я сожалею о содеянном и прошу твоего прощения».~
@29915 = ~Ложь: «Я был магически принужден к тому, чтобы совершить это. Я не понимал, что происходит».~
@29916 = ~Свернуть ему шею.~
@29917 = ~Свернуть ему шею.~
@29918 = ~Свернуть ему шею.~
@29919 = ~«Смею. Что ты намерен с этим делать, старик?»~
@29920 = ~Янис уклоняется от твоего выпада и начинает кричать: «Стража! На помощь! На меня напали!»~
@29921 = ~«Проклятье...»~
@29922 = ~Твои руки легко стискиваются на висках Яниса, и ты резко поворачиваешь его голову влево.~
@29923 = ~«Нет времени на твои лекции, старик...»~
@29924 = ~Раздается хруст, и тело Яниса безвольно падает в твои объятия.~
@29925 = ~«Теперь покойся с миром...»~
@29926 = ~«Теперь покойся с миром...»~
@29927 = ~К твоему удивлению, твои действия кажутся тебе инстинктивными, как будто ты уже много раз проделывал это... от этой мысли в твоей голове пробуждается воспоминание, но оно слишком слабое, чтобы ты его вспомнил.~
@29928 = ~Оставить тело и уйти.~
@29929 = ~Янис начинает кричать: «Стража! Помогите! Враги! На помощь!»~
@29930 = ~«Проклятье...»~
@29931 = ~«Проклятье...»~
@29932 = ~«Но... — Янис, казалось бы, почти лишился дара речи. — Но... зачем? Некоторые из сгоревших вещей... имели ценность только для меня... они были невосполнимыми!»~
@29933 = ~«Скорее всего, это были те вещи или бумаги, которые представляли опасность для того, другого я... Не думаю, что когда-либо узнаю это».~
@29934 = ~«По правде говоря, я не знаю».~
@29935 = ~«Ваше другое я? О чем вы говорите?»~
@29936 = ~«Я страдаю особым расстройством... Иногда я теряю себя и на время стаю кем-то другим. В эти моменты я сам не свой».~
@29937 = ~«По правде говоря, я не знаю».~
@29938 = ~Ложь: «Я был магически принужден к тому, чтобы совершить это. Я не понимал, что происходит».~
@29939 = ~«Вы не знаете?! Я что, с ребенком разговариваю?! Как так может быть, чтобы вы не знали причин своих действий!»~
@29940 = ~«Я страдаю особым расстройством... Иногда я теряю себя и на время стаю кем-то другим. В эти моменты я сам не свой».~
@29941 = ~Ложь: «Я был магически принужден к тому, чтобы совершить это. Я не понимал, что происходит».~
@29942 = ~Янис хмурится... кажется, он обдумывает это. «Я слышал о подобных магических *наговорах*, наложенных на людей, — на миг он умолкает. — И вы *решили* прийти и принять ответственность за содеянное...»~
@29943 = ~«Я всего лишь пришел попросить у тебя прощения за совершенное злодеяние».~
@29944 = ~«Я пришел попросить у тебя прощения и восполнить твою утрату, если это в моих силах».~
@29945 = ~«Ну... я не несу ответственность за содеянное. В конце концов, не я это все совершил».~
@29946 = ~Я солгал Янису, сказав, что я был магически принужден устроить пожар в его конторе, и попросил у него прощения. Он проглотил мое вранье и без особого труда простил меня. Он уверил меня, что никакого долговременного вреда я ему не нанес.~
@29947 = ~Янис хмурится... кажется, он обдумывает это. «Я слышал о подобных умственных отклонениях... временная амнезия и проявление другой личности... то есть, вы действительно решили признать свою ответственность за содеянное...»~
@29948 = ~«Это... похоже на мое расстройство. Я пришел просить прощения за содеянное».~
@29949 = ~«Я пришел попросить у тебя прощения и восполнить твою утрату, если это в моих силах».~
@29950 = ~«Ну... я не несу ответственность за содеянное. В конце концов, не я это все совершил».~
@29951 = ~Я сказал Янису, что я в ответе за пожар в его конторе, и попросил его прощения. Он без особого труда простил меня и уверил, что никакого долговременного вреда я ему не нанес.~
@29952 = ~«Я... — Янис хмурится, но затем его лицо разглаживается. — Тут нечего прощать... Со временем я смирился с утратой, и, к тому же, никакого долговременного вреда не было нанесено. Однако мне непонятна мотивация выбора. В том, что сгорело, не было ничего ценного».~
@29953 = ~«Что это были за бумаги?»~
@29954 = ~«В основном, наследства. Некоторые особенно старые».~
@29955 = ~«Наследства?»~
@29956 = ~«Нет, ни Гармониуму, ни убийцам милосердия не удалось найти ответственного за это».~
@29957 = ~«Возможно, я причастен к тому пожару».~
@29958 = ~«Возможно, я причастен к тому пожару».~
@29959 = ~«Ты можешь сказать мне, что сгорело?»~
@29960 = ~«Понятно. Расскажи мне о своей дочери».~
@29961 = ~«Печально. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29962 = ~«Я скорблю по твоей утрате. Мне пора идти. Прощай».~
@29963 = ~«Сгорело немного старых наследств, несколько сувениров и другие памятные подарки, ценные только для меня».~
@29964 = ~«Возможно, я причастен к тому пожару».~
@29965 = ~«Возможно, я причастен к тому пожару».~
@29966 = ~«Наследства?»~
@29967 = ~«Понятно. Расскажи мне о своей дочери».~
@29968 = ~«Возможно, ты сможешь помочь мне еще в одном деле...»~
@29969 = ~«Я скорблю по твоей утрате. Мне пора идти. Прощай».~
@29970 = ~«Вы должны меня простить. В последнее время на меня навалилось столько неприятностей... Боюсь, что последние несколько лет были для меня временем испытаний».~
@29971 = ~«Я могу чем-либо помочь?»~
@29972 = ~«Какие неприятности?»~
@29973 = ~«Понятно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29974 = ~«Извини, что побеспокоил... Надеюсь, твои дела наладятся. Счастливо».~
@29975 = ~«Нет-нет... тут мало чему поможешь, — он кивает тебе. — Тем не менее, я ценю ваше предложение. Спасибо».~
@29976 = ~«Возможно, рассказав о своих неприятностях, ты облегчишь себе душу».~
@29977 = ~«Возможно, рассказав о своих неприятностях, ты облегчишь себе душу».~
@29978 = ~«Возможно, рассказав о своих неприятностях, ты облегчишь себе душу».~
@29979 = ~«Что за неприятности у тебя были?»~
@29980 = ~«Что за неприятности у тебя были?»~
@29981 = ~«Что за неприятности у тебя были?»~
@29982 = ~«Хорошо. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29983 = ~«Надеюсь, твои дела наладятся. Счастливо».~
@29984 = ~Янис вздыхает. «Я бы не хотел обременять вас... Не так давно я потерял свою дочь. И еще тот пожар... но это уже другое дело».~
@29985 = ~«Расскажи мне о своей дочери».~
@29986 = ~«Расскажи мне о своей дочери».~
@29987 = ~«Пожар?»~
@29988 = ~«Понятно. Возможно, ты сможешь помочь мне еще в одном деле...»~
@29989 = ~«Я скорблю по твоей утрате. Мне пора идти. Прощай».~
@29990 = ~Янис вздыхает. «Я бы не хотел еще больше обременять вас... Как я уже упоминал, не так давно я потерял свою дочь. И еще пожар... но это уже другое дело».~
@29991 = ~«Расскажи мне еще о своей дочери».~
@29992 = ~«Расскажи мне еще о своей дочери».~
@29993 = ~«Пожар?»~
@29994 = ~«Возможно, ты сможешь помочь мне еще в одном деле...»~
@29995 = ~«Я скорблю по твоей утрате. Мне пора идти. Прощай».~
@29996 = ~Ветвь черных шипов~
@29997 = ~Ожерелье черных шипов~
@29998 = ~Удар тригита~
@29999 = ~Это основная дробящая атака тригита. У нее средняя скорость, и она наносит много урона.~
@30000 = ~Небольшая стальная вилка~
@30001 = ~Небольшая стальная вилка~
@30002 = ~НЕБОЛЬШАЯ СТАЛЬНАЯ ВИЛКА
Урон: 1-2 колющий
Скорость: 2
Вес: 1
Специализация: клинковые
Не используется жрецами

Эта вилка — уж точно нетипичный образец столового прибора. Ее стальной конец поцарапан и слегка погнут, а зубцы покрыты грязью.~
