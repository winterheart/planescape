@16959 = ~«Ты выглядишь немного уставшим».~
@16960 = ~«Да, госпожа Келлера».~
@16961 = ~«Эта деталь может отвалиться, проверь ее».~
@16962 = ~«Все идет хорошо».~
@16963 = ~«Как идет работа?»~
@16964 = ~«Хм-м. Возможно, так будет лучше».~
@16965 = ~«Попробуй лучше этот инструмент».~
@16966 = ~«Вы правы. Спасибо».~
@16967 = ~«Тебе придется заменить эту часть на новую».~
