@16102 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
@16103 = ~«Забудь, оставь кулон у себя. Прощай».~
@16104 = ~«Я согласен. Дай мне взглянуть на контракт».~
@16105 = ~«Три года — это слишком много».~
@16106 = ~«Я хочу восемь месяцев. Столько ты будешь служить мне».~
@16107 = ~«Довольно болтовни — я просто прирежу тебя и заберу кулон».~
