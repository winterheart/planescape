@5700 = ~~
@5701 = ~NULL MODE~
@5702 = ~~
@5703 = ~~
@5704 = ~NULL MODE~
@5705 = ~~
@5706 = ~~
@5707 = ~~
@5708 = ~NULL MODE~
@5709 = ~~
@5710 = ~~
@5711 = ~~
@5712 = ~«Добрый день, сэр. Могу ли я чем-то помочь?»~
@5713 = ~«Что за теми охраняемыми дверьми?»~
@5714 = ~«В общем, да. Не знал, кому бы это рассказать, но тебе, думаю, можно. Бедай-Линн попросила меня убить Сандоза. Как насчет такого?»~
@5715 = ~«Я разыскиваю убийцу кузнеца. Ты что-нибудь видел той ночью?»~
@5716 = ~«Где тут контора клерка?»~
@5717 = ~«Где я могу найти здешнее начальство?»~
@5718 = ~«Где я могу найти здешнее начальство?»~
@5719 = ~«Нет, спасибо. Прощай».~
@5720 = ~«Боюсь, это секрет, сэр. Даже для наших самых высокоценимых членов фракции. Если вы непричастны к проекту, и не получили разрешение от одного из начальников, мы не можем пропустить вас».~
@5721 = ~«Отлично. Не подскажешь, где контора клерка?»~
@5722 = ~«Отлично. Где я могу найти ваших начальников?»~
@5723 = ~«Отлично. Где я могу найти ваших начальников?»~
@5724 = ~«Я разыскиваю убийцу кузнеца. Ты что-нибудь видел той ночью?»~
@5725 = ~«Кстати, о начальниках: Бедай-Линн попросила меня убить Сандоза. Как насчет такого?»~
@5726 = ~«Что, если я выбью из тебя это?»~
@5727 = ~«Понятно. Прощай».~
@5728 = ~«Как всегда, вопрос. И как всегда, неправильный». Он делает легкий поклон, но движение вызывает у него неожиданный приступ кашля. «Я...» Он умолкает на минуту, переводя дыхание. «Я... Дхолл».~
@5729 = ~«Это был только первый вопрос, Дхолл. Я хочу многое узнать...»~
@5730 = ~«Хорошо, Неугомонный, — Дхолл кивает. — Но, боюсь, в данном вопросе время тебе не враг, — он снова берется за перо. — Когда ты снова захочешь поговорить, я буду здесь».~
@5731 = ~«Возможно, ты ответишь на некоторые из моих вопросов, Дхолл...»~
@5732 = ~«У меня нет времени на это. Прощай».~
@5733 = ~Дхолл качает головой. «Страсти — тяжелый груз. Многих они приковали к этой тени жизни. Цепляясь за эмоции, ты будешь без конца возрождаться в этой 'жизни', в постоянных муках, так никогда и не познав чистоты Истинной Смерти».~
@5734 = ~«Убей в себе страсти. Отбрось нужду в переживаниях. Когда ты будешь действительно очищен, кольцо возрождений прервется, и ты обретешь покой». Дхолл делает вздох... как будто смерть клокочет в его глотке. «За нашими бренными телами, за Границей Вечности, находится покой, к которому стремится каждая душа».~
@5735 = ~«У меня есть другие вопросы...»~
@5736 = ~«Расскажи мне еще о Морге».~
@5737 = ~«Понятно. У меня еще вопросы...» ~
@5738 = ~«Прощай, Дхолл».~
@5739 = ~«Расскажи мне побольше о Морге».~
@5740 = ~«Понятно. У меня еще вопросы...» ~
@5741 = ~«Прощай, Дхолл».~
@5742 = ~«Я говорю о ранах разума. Ты ведь многое забыл, не так ли? Возможно, настоящие раны гораздо глубже, чем эти шрамы, украшающие твое тело, — Дхолл снова кашляет, — но только ты можешь знать это точно».~
@5743 = ~«Расскажи мне побольше о Морге».~
@5744 = ~«Понятно. У меня еще вопросы...» ~
@5745 = ~«Прощай, Дхолл».~
@5746 = ~«У меня есть другие вопросы...»~
@5747 = ~«Прощай, Дхолл».~
@5748 = ~«Чем ты здесь занимаешься?»~
@5749 = ~«У меня есть другие вопросы...»~
@5750 = ~«Прощай, Дхолл».~
@5751 = ~«У меня есть другие вопросы...»~
@5752 = ~«Прощай, Дхолл».~
@5753 = ~«Прощай, Дхолл».~
@5754 = ~«Понятно. У меня еще вопросы...» ~
@5755 = ~«У меня такое чувство, что наши пути еще пересекутся. Прощай, Дхолл».~
@5756 = ~«Я не могу больше с тобой говорить. Прощай, Дхолл».~
@5757 = ~«Спасибо. У меня есть другие вопросы...»~
@5758 = ~«Прощай, Дхолл».~
@5759 = ~«Прямо на юг от главной литейной ты найдешь конторку со столом. Это и есть контора клерка».~
@5760 = ~«Спасибо. Где я могу найти начальство?»~
@5761 = ~«Спасибо. Где я могу найти начальство?»~
@5762 = ~«Я разыскиваю убийцу кузнеца. Ты что-нибудь видел той ночью?»~
@5763 = ~«Не знал, кому бы это рассказать, но... Бедай-Линн попросила меня убить Сандоза».~
@5764 = ~«Что за теми охраняемыми дверьми?»~
@5765 = ~«После гибели Сандоза Кельдор — пожалуй, единственный, кто может вам чем-то помочь. Вы можете найти его в главном зале собраний — за дверью на правой стороне главной литейной. Пропустить невозможно».~
@5766 = ~«Отлично. Что за теми охраняемыми дверьми?»~
@5767 = ~«Можешь подсказать, где найти контору клерка?»~
@5768 = ~«Я разыскиваю убийцу кузнеца. Ты что-нибудь видел той ночью?»~
@5769 = ~Уйти.~
@5770 = ~«По этому поводу вам смогут помочь либо Сандоз, либо Кельдор. Кельдор в главном Зале собраний, прямо за дверью на правой стороне главной литейной. Сандоза обычно можно найти в помещении за Залом».~
@5771 = ~«Спасибо. Как мне найти контору клерка?»~
@5772 = ~«Что за теми охраняемыми дверьми?»~
@5773 = ~«Я разыскиваю убийцу кузнеца. Ты что-нибудь видел той ночью?»~
@5774 = ~«Кстати, о Сандозе: Бедай-Линн попросила меня убить его. Как насчет такого?»~
@5775 = ~«Спасибо. Прощай».~
@5776 = ~«Хотелось бы увидеть, как вы это сделаете, сэр».~
@5777 = ~Атаковать.~
@5778 = ~Уйти.~
@5779 = ~«Нет, сэр. На ночь мы покинули комнату».~
@5780 = ~«Разве это не необычно?»~
@5781 = ~«По чьему приказу?»~
@5782 = ~«У меня другие, не касающиеся убийства вопросы».~
@5783 = ~«Понятно. Это интересно. Спасибо за уделенное время».~
@5784 = ~«ЧТО? Вы серьезно? Поговорите об этом с Кельдором. А пока мы позаботимся об инженере. Спасибо вам».~
@5785 = ~Уйти.~
@5786 = ~«Да, сэр, это необычно. Обычно нас держат здесь день и ночь, чтобы обеспечить безопасность проекта».~
@5787 = ~«Кто имеет право отпустить вас подобным образом?»~
@5788 = ~«Что ты можешь рассказать о проекте?»~
@5789 = ~«Значит, ты утверждаешь, что ничего не видел».~
@5790 = ~«Интересно. Спасибо».~
@5791 = ~«Единственные люди, обладающие такой властью, — Тильдон и Бедай-Линн. Я предполагаю, что фракторы, либо кто-нибудь, близкий к ним, мог бы отдать такой приказ, но не похоже, чтобы они это делали. Я не знаю, чей это приказ, и не представляю, кто бы мог захотеть его отдать».~
@5792 = ~«Это мало чем поможет, но хоть что-то для начала. В таком случае, ответь мне на другие вопросы».~
@5793 = ~«А было ли необычным то, что ты получил этот приказ?»~
@5794 = ~«И ты ничего не видел?»~
@5795 = ~«Это... много чего объясняет. Счастливо».~
@5796 = ~«Еще вопросы?»~
@5797 = ~«Что за теми охраняемыми дверьми?»~
@5798 = ~«В общем, да. Не знал, кому бы это рассказать, но тебе, думаю, можно. Бедай-Линн попросила меня убить Сандоза. Как насчет такого?»~
@5799 = ~«Я разыскиваю убийцу кузнеца. Ты что-нибудь видел той ночью?»~
@5800 = ~«Где тут контора клерка?»~
@5801 = ~«Где я могу найти здешнее начальство?»~
@5802 = ~«Где я могу найти здешнее начальство?»~
@5803 = ~«Забудь об этом. Прощай».~
@5804 = ~«Именно так, сэр. Я ничего не видел».~
@5805 = ~«Хм. Тогда ответь мне на пару вопросов».~
@5806 = ~«Тебе не кажется, что этот приказ был необычным?»~
@5807 = ~«Это... много чего объясняет. Счастливо».~
@5808 = ~«Я понимаю, что мы обязаны помогать вам любым способом касательно этого убийства, но должен предупредить, что моя помощь будет не особо ценной».~
@5809 = ~«Почему же нет? Тебя здесь не было?»~
@5810 = ~«Ладно. Ну, в любом случае, у меня есть еще пару вопросов».~
@5811 = ~«О, тогда забудь об этом».~
@5812 = ~Ты видишь внушительного стражника, который выглядит немного скучающим. «Приветствую, сэр. Чем могу служить?»~
@5813 = ~«Что за теми охраняемыми дверьми?»~
@5814 = ~«В общем, да. Не знал, кому бы это рассказать, но тебе, думаю, можно. Бедай-Линн попросила меня убить Сандоза. Как насчет такого?»~
@5815 = ~«Где тут контора клерка?»~
@5816 = ~«Где я могу найти здешнее начальство?»~
@5817 = ~«Где я могу найти здешнее начальство?»~
@5818 = ~«Забудь об этом. Прощай».~
@5819 = ~«Приветствую, сэр. Чем могу служить?»~
@5820 = ~«Что за теми охраняемыми дверьми?»~
@5821 = ~«В общем, да. Не знал, кому бы это рассказать, но тебе, думаю, можно. Бедай-Линн попросила меня убить Сандоза. Как насчет такого?»~
@5822 = ~«Где тут контора клерка?»~
@5823 = ~«Где я могу найти здешнее начальство?»~
@5824 = ~«Где я могу найти здешнее начальство?»~
@5825 = ~«Забудь об этом. Прощай».~
@5826 = ~«Опять ты? Стража! Стража!»~
@5827 = ~Сражаться.~
@5828 = ~Уйти.~
@5829 = ~«Опять ты? Стража! Стража!»~
@5830 = ~Сражаться.~
@5831 = ~Уйти.~
@5832 = ~«Ладно, пень... проваливай, и никто не пострадает».~
@5833 = ~Уйти.~
@5834 = ~«Добро пожаловать обратно в Литейную, сэр».~
@5835 = ~«Спасибо. Мне нужно забрать одну вещь».~
@5836 = ~«Спасибо».~
@5837 = ~«Добро пожаловать обратно в Литейную, сэр».~
@5838 = ~«Спасибо. Мне нужно забрать одну вещь».~
@5839 = ~«Спасибо».~
@5840 = ~Ты видишь крепкого стражника, который выглядит скучающим. «Прошу сообщить, по какому ты делу».~
@5841 = ~«Просто осматриваюсь».~
@5842 = ~«Я здесь, чтобы забрать заказ».~
@5843 = ~«Я здесь, чтобы оставить заказ».~
@5844 = ~«Кто ты?»~
@5845 = ~«Чем ты занимаешься?»~
@5846 = ~«Я помогаю Зандеру с Построителем снов».~
@5847 = ~«Я здесь, чтобы воспользоваться Построителем снов».~
@5848 = ~«Тогда уверен, ты не будешь против отойти подальше».~
@5849 = ~«Можно войти?»~
@5850 = ~«Вовсе нет».~
@5851 = ~«Да, сэр. Могу ли я увидеть твою квитанцию?»~
@5852 = ~«Да».~
@5853 = ~Ложь: «Да».~
@5854 = ~«Нет».~
@5855 = ~«Уверен, она у меня где-то была...»~
@5856 = ~«Прошу прощения, сэр, но в данный момент мы не принимаем новых заказов в связи с крупным проектом, которым мы заняты. Возвращайся примерно через год. Спасибо за твою заинтересованность».~
@5857 = ~«Ладно. У меня есть еще вопросы...»~
@5858 = ~«Спасибо».~
@5859 = ~«Я стражник верящих в Первопричину, сэр».~
@5860 = ~«Верящих в Первопричину?»~
@5861 = ~«О, понятно. У меня есть другие вопросы...»~
@5862 = ~«Спасибо».~
@5863 = ~«Охраняю ворота, сэр».~
@5864 = ~«П-нятно. У меня есть другие вопросы».~
@5865 = ~«Спасибо за уделенное время».~
@5866 = ~«Ты находишься перед Великой Литейной, домом верящих в Первопричину».~
@5867 = ~«Кого?»~
@5868 = ~«Что такое Великая Литейная?»~
@5869 = ~«О, спасибо. У меня есть другие вопросы».~
@5870 = ~Уйти: «Ах».~
@5871 = ~«Укажи суть твоего требования».~
@5872 = ~«Просто осматриваюсь».~
@5873 = ~«Я здесь, чтобы забрать заказ».~
@5874 = ~«Я здесь, чтобы оставить заказ».~
@5875 = ~«Кто ты?»~
@5876 = ~«Чем ты занимаешься?»~
@5877 = ~«Что это за место?»~
@5878 = ~«Извини, я здесь не по делу».~
@5879 = ~«Только если ты покажешь, что ты здесь по делу».~
@5880 = ~«Понятно. Тогда у меня еще вопросы».~
@5881 = ~«Понятно. Прощай».~
@5882 = ~«Спасибо, сэр. У клерка, которого ты ищешь, есть контора в южной стене Литейной. Благодарю за поддержку». Он открывает тебе ворота.~
@5883 = ~Уйти.~
@5884 = ~«Похоже, у тебя нет квитанции».~
@5885 = ~«Уверен, она у меня где-то была...»~
@5886 = ~«Хм, нет. Только у меня есть другие вопросы».~
@5887 = ~Уйти.~
@5888 = ~«Тогда боюсь, что ты должен уйти».~
@5889 = ~Уйти.~
@5890 = ~«Да, сэр, я уверен, что так оно и есть. Однако, пока ты не предоставишь доказательство, что ты здесь по делу, боюсь, что мы не можем разрешить тебе войти».~
@5891 = ~«Тогда у меня есть другие вопросы».~
@5892 = ~Уйти.~
@5893 = ~«Да, сэр. Нас называют боголюдьми».~
@5894 = ~«Почему?»~
@5895 = ~«Рад за тебя. Прощай».~
@5896 = ~«Кроме того, что это дом верящих в Первопричину, это еще и одна из самых больших литейных, известных смертным. Через эти ворота много чего проходит; мы принимаем заказы со всех планов. В данный момент мы больше не принимаем заказов, поскольку большинство наших ремесленников либо работают над новым проектом, либо им поручены более мелкие заказы на ближайшие несколько месяцев. На деле это означает, что тебя впустят, только если при тебе есть квитанция на получение заказа, либо у тебя здесь срочное дело».~
@5897 = ~«У меня срочное дело!»~
@5898 = ~«У меня есть квитанция!»~
@5899 = ~Уйти.~
@5900 = ~«Мы — одна из пятнадцати признанных фракций Сигила, сэр. Мы верим, что в каждом существе есть искра божественности — не обязательно добро или зло, а лишь возможность быть подобным богу. Мы полагаем, что за божественностью есть нечто большее. Мы верим, что у каждой жизни есть предназначение и цель, и мы призваны осознать эти цели. С каждым шагом в нашей жизни мы стремимся к величию».~
@5901 = ~«Звучит важно».~
@5902 = ~«Рад за тебя. Ты собираешься меня впускать?»~
@5903 = ~«Мы верим, что это так, сэр. Могу ли я еще чем-то помочь?»~
@5904 = ~«Да. У меня есть еще вопросы».~
@5905 = ~«Нет».~
@5906 = ~«Спасибо, не стоит».~
@5907 = ~«Да. Входи».~
@5908 = ~«Спасибо».~
@5909 = ~«Значит, ты тот, из-за кого они подняли весь этот шум, а? Не стал бы их винить за это... на вид-то ты опасен. Давай, вали отсюдова».~
@5910 = ~Прикончить старика.~
@5911 = ~Уйти.~
@5912 = ~«Я б и рад тебе помочь, сынок, но для меня от этого проблем будет больше, чем толку. Уходи и возвращайся попозже, когда стража не будет дышать тебе в затылок».~
@5913 = ~Уйти.~
@5914 = ~Ты видишь иссушенного старика с трясущимися пальцами и лукавым лицом. Он внимательно осматривает тебя и произносит: «Черт... э... а мы раньше не встречались? Ты мне кажешься чем-то знакомым».~
@5915 = ~«Думаю, такое возможно».~
@5916 = ~«Вряд ли, старик».~
@5917 = ~«Откуда? Ты помнишь, где мы встречались?»~
@5918 = ~«Я здесь, чтобы забрать одну вещь».~
@5919 = ~«Мне нужно несколько лишних шмоток и кузнечный инструмент».~
@5920 = ~«Я ищу одежду для маскировки».~
@5921 = ~«Кто ты?»~
@5922 = ~«Я хотел бы получить кузнечный инструмент».~
@5923 = ~«Интересно. Прощай, старик».~
@5924 = ~«Ты хотел еще чего-то?»~
@5925 = ~«Ты упоминал, что видел меня раньше. Не припоминаешь, где?»~
@5926 = ~«Нет, просто хотел увидеть твою улыбающуюся рожу».~
@5927 = ~«Я здесь, чтобы забрать одну вещь».~
@5928 = ~«Мне нужно несколько лишних шмоток и кузнечный инструмент».~
@5929 = ~«Я ищу одежду для маскировки».~
@5930 = ~«Кто ты?»~
@5931 = ~«Я хотел бы получить кузнечный инструмент».~
@5932 = ~«Интересно. Прощай, старик».~
@5933 = ~«Я никогда не забываю лица... постой-ка... ой, ну и Баатор с ним».~
@5934 = ~«Ты помнишь, где это было? Для меня это важно».~
@5935 = ~«Я здесь, чтобы забрать одну вещь».~
@5936 = ~«Мне нужно несколько лишних шмоток и кузнечный инструмент».~
@5937 = ~«Я ищу одежду для маскировки».~
@5938 = ~«Кто ты?»~
@5939 = ~«Я хотел бы получить кузнечный инструмент».~
@5940 = ~«Тогда забудь. Пока».~
@5941 = ~«Могу поклясться, что видал тебя раньше. Ты, случай, преступником не бывал? — старик тихонько хихикает. — О, забудь. Потом вспомню».~
@5942 = ~«Ладно. Тогда ответь мне на пару вопросов».~
@5943 = ~«Надеюсь, что нет. Счастливо».~
@5944 = ~«Не так быстро, малец. Мозгам требуется время, чтобы разогреться для таких задач. Я много прожил, и в то время видел намного больше лиц, так что вспомнить не так-то просто. Память — штука слишком скоротечная, чтоб на нее полагаться».

Перед ответом ты бормочешь: «Мне-то можешь не рассказывать, 'малец'».~
@5945 = ~«Тогда забудь. Я здесь, чтобы забрать одну вещь».~
@5946 = ~«Тогда ладно. Мне нужно несколько лишних шмоток и кузнечный инструмент».~
@5947 = ~«Ладно. Я ищу одежду для маскировки».~
@5948 = ~«Тогда скажи мне: кто ты?»~
@5949 = ~«Тогда мне нужно получить кузнечный инструмент».~
@5950 = ~«Отлично. Бывай, 'малец'».~
@5951 = ~«Есть квитанция? Тебе понадобится квитанция, иначе я ничего не смогу тебе дать».~
@5952 = ~«У меня здесь имеется парочка».~
@5953 = ~«Конечно. Держи».~
@5954 = ~«Конечно. Держи».~
@5955 = ~«Есть».~
@5956 = ~Ложь: «Да».~
@5957 = ~«Конечно. Держи».~
@5958 = ~«Нет».~
@5959 = ~«Забудь. Пока».~
@5960 = ~«Во как? Ну, тогда ладно. Это обойдется тебе... давай прикинем... ну, скажем, в шестьдесят медяков».~
@5961 = ~«На, держи».~
@5962 = ~«У меня нет столько».~
@5963 = ~«Забудь об этом. У меня есть пару вопросов».~
@5964 = ~«Забудь. Пока».~
@5965 = ~«Значит, маскировка? Уже догадываюсь, для чего она тебе сдалась, и продам ее тебе за скромную цену в шестьдесят медяков».~
@5966 = ~«На, держи».~
@5967 = ~«У меня нет столько».~
@5968 = ~«Забудь об этом. У меня есть пару вопросов».~
@5969 = ~«Забудь. Пока».~
@5970 = ~«Я-то? Я Надилин, величайший воин боголюдей! — он вздыхает. — По крайней мере, был когда-то. Теперь я клерк в Литейной, дышу этой копотью и приближаю день своей смерти».~
@5971 = ~«Какая жалость. У меня есть другие вопросы».~
@5972 = ~«Ладно. Это все, что я хотел узнать. Прощай».~
@5973 = ~«О, теперь ты хочешь стать кузнецом, не так ли, малец? Хорошо. Тебе понадобится фартук — десять медяков, какие-нибудь щипцы — еще десять, и молот — он по двадцать. Итого выходит... дай-ка подумать... пятьдесят медяков».~
@5974 = ~«Старик, вообще-то, это сорок медяков».~
@5975 = ~Заплатить пятьдесят медяков.~
@5976 = ~Заплатить пятьдесят медяков.~
@5977 = ~«Извини, но это больше похоже сорок медяков».~
@5978 = ~«Забудь об этом. У меня есть пару вопросов».~
@5979 = ~«Не думаю, что сейчас мне это нужно. Счастливо».~
@5980 = ~«Будь здоров, сынок. А теперь, если ты не против, мне есть чем заняться».~
@5981 = ~«Ррр. Ладно».~
@5982 = ~«Сейчас вернусь». Проходит несколько минут. Он в торопливо возвращается и дает тебе пару предметов: небольшую, почти невесомую металлическую штуковину и палицу превосходной работы. «Этой штуковине... ей же больше сотни лет! Долго же ты ждал, дружище. Как она к тебе попала?»~
@5983 = ~«Оставил ее для себя, но потом был занят».~
@5984 = ~«Досталась мне по наследству».~
@5985 = ~«Это было в завещании».~
@5986 = ~Старик берет твою квитанцию и сверяет ее со своими записями. Он исчезает на одну-две минуты и возвращается с отличной палицей в руках. «Держи, малец».~
@5987 = ~«Спасибо. У меня еще пару вопросов».~
@5988 = ~«Спасибо. Пока».~
@5989 = ~Старик берет у тебя квитанцию, тщательно ее изучает. «Этой вещи больше сотни лет! Как она к тебе попала?»~
@5990 = ~«Оставил ее для себя, но потом был занят».~
@5991 = ~«Досталась мне по наследству».~
@5992 = ~Он замолкает на миг. «Если у тебя имеется квитанция, давай ее сюда. За так я тебе ничего не дам. А теперь уходи. Уверен, что найду, чем заняться, кроме как отвлекаться на прохожих».~
@5993 = ~Уйти.~
@5994 = ~«Тогда держи. Выведи эту сучку отсюда, чтоб нам больше не пришлось терпеть ее предательство».~
@5995 = ~Ложь: «Чего? Оно мне не для того нужно!»~
@5996 = ~«Откуда ты это знаешь?»~
@5997 = ~«Спасибо большое, старик. Счастливо».~
@5998 = ~«Тогда я вообще не могу отдать тебе это. Извини».~
@5999 = ~«Отлично. Тогда ответь мне на пару вопросов».~
@6000 = ~«Отлично. Прощай».~
@6001 = ~Он внимательно изучает квитанцию, потом снова смотрит на тебя. «Разве я тебе уже это не выдавал? Видишь ли, я не могу выдать тебе это дважды, — он кладет квитанцию в карман. — А теперь уходи. Вон!»~
@6002 = ~Уйти.~
@6003 = ~«Что же это я? Конечно же, так оно и есть. Говорю тебе: память — вещь коварная».~
@6004 = ~«Так-то. Давай мне мои вещи».~
@6005 = ~«Так-то. Давай мне мои вещи».~
@6006 = ~«Ну, для меня это все еще дорого».~
@6007 = ~«Если хочешь поработать в кузнице, не забудь взять немного руды у Тильдона. Он скупой ублюдок, но только у него можно достать руду».~
@6008 = ~«Спасибо. У меня есть другие вопросы к тебе».~
@6009 = ~«Спасибо. Прощай».~
@6010 = ~«Если хочешь поработать в кузнице, тебе понадобится немного руды. Попробуй взять ее у заместителя Тильдона. Не помню, как ее звать, но она должна дать ее тебе без особых возражений».~
@6011 = ~«Спасибо, старик. У меня есть другие вопросы к тебе».~
@6012 = ~«Спасибо и прощай».~
@6013 = ~«Хороша вещица, малец. Уверен, ты в самом деле был занят! — он смеется и передает ее тебе. — Держи. Поосторожней с ней, слышишь?»~
@6014 = ~«Так и будет. Только у меня были еще вопросы».~
@6015 = ~«Конечно. Прощай».~
@6016 = ~«Значит, это передавалось из поколения в поколение? Тебе повезло, что мы это не выкинули. Мы иногда так и делаем, а иногда продаем такие вещи, если можем доказать, что заказчик не вернется за ними. Что ж, держи. Обращайся с ним как следует, слышишь?»~
@6017 = ~«Конечно. Ответь мне еще на пару вопросов, ладно?»~
@6018 = ~«Я так и сделаю. Прощай».~
@6019 = ~«Понятно. Неплохой улов. Держи, малец. Обращайся с ним как следует, слышишь?»~
@6020 = ~«Разумеется. Ответь еще на вопрос, ладно?»~
@6021 = ~«Конечно. Прощай».~
@6022 = ~Он смотрит на тебя с отвращением. «Брось, малец. Ты же получил свои вещи. Теперь убирайся отсюда, или я передумаю на счет того, чтобы позвать стражу».~
@6023 = ~Уйти.~
@6024 = ~«Я, быть может, стар и слегка не в себе, но это вовсе не значит, что я не вижу, что к чему. Последнее время Бедай-Линн было несладко, а она ведь никогда не любила работать на нечисть. А теперь уходи. Уверен, мне будет чем заняться».~
@6025 = ~Уйти.~
@6026 = ~«Возможно, мне стоит поговорить с Фародом. Прощай, Дхолл».~
@6027 = ~«В таком случае, я должен разыскать его. Прощай, Дхолл».~
@6028 = ~«Звучит ободряюще. Прощай, Дхолл».~
@6029 = ~«Прощай, Дхолл».~
@6030 = ~«Тогда я пойду и поспрашиваю тамошних жителей. Прощай».~
@6031 = ~«Тогда пойду и разыщу этого Фарода. Прощай, Дхолл».~
@6032 = ~«Может, ты мне объяснишь, почему тленные хотят моей смерти?»~
@6033 = ~«Истинной Смерти?»~
@6034 = ~«Иллюзорность этой жизни?»~
@6035 = ~«Расскажи мне побольше о Морге».~
@6036 = ~«У меня есть другие вопросы к тебе...»~
@6037 = ~«Тогда прощай». ~
@6038 = ~«Я выслушал достаточно. Прощай, Дхолл».~
@6039 = ~«Я выслушал достаточно. Прощай, Дхолл».~
@6040 = ~«Отлично. Прощай, Дхолл».~
@6041 = ~«У меня есть другие вопросы...»~
@6042 = ~«Кажется, я обязан тебе. Прощай, Дхолл».~
@6043 = ~«Похоже на забвение. И зачем кому-то это нужно?»~
@6044 = ~«Ого. Расскажи мне побольше о Морге».~
@6045 = ~«Понятно... У меня есть другие вопросы».~
@6046 = ~«Я должен идти. Прощай, Дхолл».~
@6047 = ~«Тень жизни?»~
@6048 = ~«Расскажи мне побольше о Морге».~
@6049 = ~«Понятно... У меня есть другие вопросы».~
@6050 = ~«Я должен идти. Прощай, Дхолл».~
@6051 = ~«Мне кажется, твой фатализм превзошел тебя самого. Жизнь состоит из этих элементов, но не только из них».~
@6052 = ~«Заперты? Каким образом?»~
@6053 = ~«Довольно этой философии. Как все это относится к тому, что я оказался здесь?»~
@6054 = ~«Понимаю... Как же выбраться из этого кольца возрождений и достигнуть этой... Истинной Смерти?»~
@6055 = ~«Расскажи мне побольше о Морге».~
@6056 = ~«У меня есть другие вопросы...»~
@6057 = ~«Прощай, Дхолл».~
@6058 = ~«Границу Вечности?»~
@6059 = ~«Расскажи мне побольше о Морге».~
@6060 = ~«У меня есть другие вопросы...»~
@6061 = ~«Прощай, Дхолл».~
@6062 = ~«Прощай, Дхолл».~
@6063 = ~«Возможно. У меня есть другие вопросы к тебе...»~
@6064 = ~«Пойду вниз, в мемориальный зал. Может быть, я найду ее тело».~
@6065 = ~«Твой кашель ужасен. Ты хорошо себя чувствуешь?»~
@6066 = ~«Понятно. Прощай, Дхолл».~
@6067 = ~«Возможно, мне стоит найти ее. Перед уходом у меня есть к тебе другие вопросы...»~
@6068 = ~«Пойду вниз, в мемориальный зал. Может быть, я найду ее тело».~
@6069 = ~«У меня есть другие вопросы к тебе...»~
@6070 = ~«Тогда прощай». ~
@6071 = ~«Шеф, ты как, вернулся? Ты вроде как завис».~
@6072 = ~«Э? Дух?»~
@6073 = ~«Ты тряс своей черепушкой с какой-то женщиной? Где? — Морт недоуменно оглядывается. — А как она выглядела?»~
@6074 = ~«Э... нет, просто ты ненадолго завис и стоял как вкопанный. Я уж стал бояться, что ты снова свихнешься и набросишься на меня».~
@6075 = ~«Нет, я в порядке. Ты знаешь, что это был за дух?»~
@6076 = ~«Я в порядке. Идем».~
@6077 = ~«Ну, призрак, с котором я разговаривал. Призрак женщины».~
@6078 = ~«Она была прямо над могилой. Разве ты ее не видел?»~
@6079 = ~«Нет, я в порядке... кажется. Идем».~
@6080 = ~«Ничего не происходит. Прощай... Дейонарра».~
@6081 = ~Уйти.~
@6082 = ~Уйти.~
@6083 = ~«У меня для тебя нет ответов! Твое лживое сердце привело тебя сюда, пусть оно ведет тебя и дальше! Уходи прочь!»~
@6084 = ~«Я должен идти, Дейонарра. Прощай».~
@6085 = ~Уйти.~
@6086 = ~Гневное выражение спадает с лица Дейонарры... с пугающей скоростью оно сменяется выражением отчаяния. «Нет! Постой, любовь моя, — говорит она жалобно. — Пожалуйста, прости меня, умоляю! Не уходи!» ~
@6087 = ~Гневное выражение спадает с лица Дейонарры... с пугающей скоростью оно сменяется выражением отчаянья. «Нет... нет... нет... Я все еще Дейонарра, которую ты помнишь, любовь моя. Пожалуйста, прости меня, умоляю». ~
@6088 = ~Ее голос становится едва различимым шепотом. «Да... да, пожалуйста. Не уходи». Ее молящее выражение лица бросает тебя в дрожь... но не от страха, а от удовольствия. Ты чувствуешь, что уже не впервые манипулируешь этой женщиной.~
@6089 = ~«Отвергну *тебя*?! Да как ты СМЕЕШЬ обвинять меня в том, что я отвергаю ТЕБЯ?!» Дейонарра выбрасывает руки вверх, образуя полукруг, затем опускает их, пальцами указывая на тебя. Похоже, она произносит какое-то заклинание. «Да как ты СМЕЕШЬ!..»~
@6090 = ~«Гори! Гори, как если бы огонь Баатора пожирал тебя изнутри! Гори и знай, что это лишь *крупица* моей ненависти! Я проклинаю тебя, проклинаю всем своим сердцем и душой! Ты никогда не освободишься от оков своей несчастной нежизни. Ты зачахнешь и умрешь! А разум твой иссохнет и сгниет вслед за телом!»~
@6091 = ~«Будучи произнесенным, проклятие уже не может быть снято, — голос Дейонарры превращается в шипение. — Знай: у меня вечность в запасе, 'любовь моя'. Я буду ждать тебя в залах смерти, — она улыбается, но в улыбке нет ничего, кроме печали. — Мы снова будем *вместе*».~
@6092 = ~Дейонарра застывает. Кажется, она хочет что-то сказать, но затем, вздохнув, сдается. «Хорошо, любовь моя... как и прежде, я поверю тебе». Она закрывает глаза. ~
@6093 = ~Клятва: «Обещаю: я найду способ спасти тебя или присоединиться к тебе».~
@6094 = ~«Ну и пусть. Прощай, Дейонарра».~
@6095 = ~«Дейонарра, мое терпение по отношению к тебе истекает. *Держи* себя в руках, если хочешь со мной общаться, иначе мы никогда не заговорим снова. Я понятно излагаю?»~
@6096 = ~«Я прощаю тебя. А теперь мне нужна твоя помощь, Дейонарра».~
@6097 = ~«Дейонарра, мое терпение по отношению к тебе истекает. *Держи* себя в руках, если хочешь со мной общаться, иначе мы никогда не заговорим снова. Я понятно излагаю?»~
@6098 = ~«Я прощаю тебя. А теперь мне нужна твоя помощь, Дейонарра».~
@6099 = ~«Послушай, Дейонарра. У меня есть несколько вопросов к тебе...»~
@6100 = ~«Молчи и слушай, дух! Я сыт по горло твоими играми...»~
@6101 = ~Приготовиться к защите.~
@6102 = ~«Поосторожнее с проклятиями, женщина! Я не стану терпеть...»~
@6103 = ~«Дейонарра! Постой, прости меня...»~
@6104 = ~«Постой! Я хочу поговорить с...»~
@6105 = ~«Сними свое чертово проклятье! Иначе...»~
@6106 = ~Подождать...~
@6107 = ~«Пока ничем, Дейонарра, но я обязательно вернусь. Прощай».~
@6108 = ~Дейонарра горестно качает головой. «Будучи произнесенным, проклятие уже не может быть снято. Прости меня, любовь моя».~
@6109 = ~«Если и есть, то он мне незнаком, — Дейонарра вдруг воодушевляется. — Но, возможно, кто-нибудь более могущественный, чем я, сможет снять проклятье. Прости меня, любовь моя. Я не ведала, что творила».~
@6110 = ~«И нет никого, кто смог бы его снять?»~
@6111 = ~«Понятно... Я хотел бы спросить тебя кое о чем еще...»~
@6112 = ~«Наверное, уже поздновато просить прощения. Прощай, Дейонарра».~
@6113 = ~«Возможно, кто-нибудь сможет мне помочь. Прощай, Дейонарра».~
@6114 = ~«Наверное, уже поздновато просить прощения. Прощай, Дейонарра».~
@6115 = ~«Возможно, кто-нибудь сможет мне помочь. Прощай, Дейонарра».~
@6116 = ~«У меня есть еще несколько вопросов к тебе...»~
@6117 = ~«Наверное, уже поздновато просить прощения. Прощай, Дейонарра».~
@6118 = ~«Возможно, кто-нибудь сможет мне помочь. Прощай, Дейонарра».~
@6119 = ~«Наверное, уже поздновато просить прощения. Прощай, Дейонарра».~
@6120 = ~«Возможно, кто-нибудь сможет мне помочь. Прощай, Дейонарра».~
@6121 = ~«Выбраться?.. — шепчет Дейонарра, затем снова повышает голос. — *Выбраться*?! Из-за тебя я навеки здесь заточена, и ты меня еще спрашиваешь, как отсюда *выбраться*?!»~
@6122 = ~Ты уже собираешься спросить Дейонарру, но слова застревают у тебя в горле. Внезапно ты осознаешь, что, если ты скажешь ей, что ищешь выход отсюда, Дейонарра может решить, что ты бросаешь ее. Если ты собираешься спросить ее о том, как отсюда выбраться, тебе нужно сделать это поделикатнее.~
@6123 = ~«Я чувствую, что в этом месте есть много дверей, скрытых от глаз смертных. Возможно, ты сможешь воспользоваться одним из этих порталов для побега».~
@6124 = ~«Порталы?»~
@6125 = ~«В опасности? — Дейонарра выглядит обеспокоенной. — Конечно же, любовь моя, я помогу тебе...» Она закрывает глаза, и ты видишь, как призрачный ветерок проходит сквозь ее тело, колыша волосы. Спустя минуту ветер стихает и ее глаза медленно открываются. «Возможно, отсюда есть выход».~
@6126 = ~«Да?»~
@6127 = ~«Пока ничем, Дейонарра, но я обязательно вернусь. Прощай».~
@6128 = ~«Пока ничем, Дейонарра, но я обязательно вернусь. Прощай».~
@6129 = ~Ложь: «Я не помню тебя такой. Та Дейонарра, что я любил, была чуткой, нежной... и она никогда бы не бросила нуждающегося в помощи. Неужели ты так низко пала?»~
@6130 = ~«Мне нужна твоя помощь, Дейонарра. Неужели ты отвергнешь меня в час нужды?»~
@6131 = ~Блеф: «Хорошо. Я уважаю твои желания, Дейонарра... Я уйду и больше никогда не вернусь».~
@6132 = ~Блеф: «Хорошо. Я уважаю твои желания, Дейонарра... Я уйду и больше никогда не вернусь».~
@6133 = ~«Прости, что я обидел тебя, Дейонарра. Я уйду и не буду больше тебя мучить».~
@6134 = ~Тихо уйти.~
@6135 = ~«Ты пришел ко мне после моей смерти лишь для того, чтобы *снова* меня бросить, да еще и просишь помочь тебе в этом? — ее лицо искажается в гримасе ярости. — Я *умерла* ради тебя, любовь моя. И до сих пор от этого *страдаю*!»~
@6136 = ~Закрыв глаза, Дейонарра исчезает с беззвучным вздохом.~
@6137 = ~«Да, мне нужно выбраться из этого места. Тебе известен какой-нибудь выход отсюда?»~
@6138 = ~«Я прошу прощения за свою просьбу. Я не хотел тебя обидеть. Пожалуйста, ответь на вопрос...»~
@6139 = ~«Дейонарра, я в опасности. Можешь вывести меня в безопасное место? Я вернусь к тебе, как только смогу».~
@6140 = ~«Я должен идти. Прощай, Дейонарра».~
@6141 = ~«Я должен идти. Прощай, Дейонарра».~
@6142 = ~«Ты знаешь, как отсюда выбраться?»~
@6143 = ~«Дейонарра, я в опасности. Можешь вывести меня в безопасное место? Я вернусь к тебе, как только смогу».~
@6144 = ~«У меня есть другие вопросы к тебе...»~
@6145 = ~«Я должен идти. Прощай, Дейонарра».~
@6146 = ~«Я должен идти. Прощай, Дейонарра».~
@6147 = ~«Да?»~
@6148 = ~«Да?»~
@6149 = ~«Дейонарра, пожалуйста... Мне нужна твоя помощь. Неужели ты отвергнешь меня в час нужды?»~
@6150 = ~«Дейонарра, я прошу тебя лишь потому, что я в опасности. Можешь вывести меня в безопасное место? Я вернусь к тебе, как только смогу».~
@6151 = ~«Неважно. Послушай, у меня есть другие вопросы...»~
@6152 = ~«Я должен идти. Прощай, Дейонарра».~
@6153 = ~«Я должен идти. Прощай, Дейонарра».~
@6154 = ~Уйти.~
@6155 = ~Уйти.~
@6156 = ~Это тяжелый деревянный ящик. Он наглухо забит.~
@6157 = ~Этот ящик сделан из обветшалого дерева. Довольно странно, но у него нет крышки.~
@6158 = ~СЕРДЦЕ ЗАХАРИИ
(малый артефакт)
Особенности:
   Навсегда +1 к Ловкости, если расколоть
   Навсегда +1 к Классу брони против снарядов
Вес: 10
Используется только бойцами

Этот почерневший предмет размером с кулак похож скорее на кусок сгоревшего древесного угля, чем на сердце Захарии. Для своего размера он невероятно тяжел, и по всей его поверхности тянутся трещины... Похоже, он может расколоться надвое в любой момент. Если подержать его, на руках остаются странные ржавые полосы, которые невозможно стереть.

Необычайная тяжесть предмета кажется тебе достаточно любопытной, чтобы немного рассмотреть его; при внимательном осмотре то, что ты сперва принял за сердце Захарии, на самом деле оказывается камнем. Насколько ты можешь судить, в нем нет ни намека на то, что это когда-либо было живой тканью. Как Захария жил с *этим*, бьющимся в его груди, — неизвестно.

Какое бы благословение, позволяющее стрелам Захарии бить без промаха, не было наложено на его глаза, оно оставило свой след и в его сердце. Если расколоть сердце Захарии надвое, сделавший это получит часть его зрения, проворства и восприятия. Это дает прибавку к ловкости, а также шанс обнаружить любой летящий снаряд и уклонится от него.~
@6159 = ~ПОЛЭКС
Урон: 1-10 рубящий
Вес: 15
Скорость: 9
Специализация: клинковые
Используется только бойцами

Характерный полэкс для персонажей с соответствующим снаряжением.~
@6160 = ~КОНТРАКТ СМЕРТИ АНГИАРА
Вес: 0

Этот хрупкий пергамент настолько пропах пылью, словно долгое время лежал на чердаке. Насколько можно понять из неразборчивого текста, этот документ является контрактом между двумя сторонами: фракцией тленных и мужчиной по имени «Ангиар». В обмен на тридцать медяков Ангиар передает права на свое тело тленным, что означает, скорее всего, что они смогут использовать его в качестве рабочего в Морге.~
@6161 = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

Эта небольшая серебряная серьга тебе досталась от подвыпившей проститутки у бара «Тлеющий труп». ~
@6162 = ~АМУЛЕТ ИЗ СРЕЗАННОГО МЕДЯКА
Особенности:
   Малое благословление медяками
  +1 к Удаче (временно)
Вес: 0

СРЕЗАННЫЙ МЕДЯК
Вес: 0

Этот медяк был «срезан»... почти весь металл сточен, хотя оставшаяся часть по-прежнему выглядит как целая монета, а вот спиленная медь позволит «резчику» сделать еще одну. Многие обитатели Улья понемногу пользуются этим способом «делать деньги», однако члены фракции Обреченных занимаются этим с пугающим усердием, создавая амулеты, отражающие их собственную низменную натуру.

Чтобы создать такой амулет, Обреченные находят прогоревших дельцов и других личностей, когда-то владевших большим богатством, но от которых в последствии отвернулась фортуна и оставила их без гроша в кармане. Этим людям вручались заколдованные резаки с просьбой «срезать медь» для Обреченных — утомительный ритуал длиной в день, который наделял медную монету остатками удачи ее бывших владельцев. Этот ритуал, а также сама природа людей, срезающих монету, позволяет наделить монету слабыми чарами, которые влияют на удачу любого, кто ее использует.

Если подбросить срезанный медяк в воздух, он рассыпается дождем из медных монет и дарит владельцу удачу.~
@6163 = ~ПЕЧЕНЬ ЗАХАРИИ
Вес: 3

Печень Захарии выглядит как огромный мертвый слизняк — у нее фактура бурдюка, лежавшего в грязной луже несколько лет. В этот орган было закачано достаточно бальзамирующей жидкости, чтобы сохранить его, но запах гнили и формальдегида, похоже, борются между собой за превосходство.~
@6164 = ~Отпугнуть нежить~
@6165 = ~ИСХОД ДУШИ
Вес: 1~
@6166 = ~ЗУБЫ ИНГРЕСС
Урон: 1-6 дробящий
Скорость: 4
Вес: 1
Специализация: кулаки
Используется только Мортом

Это пригоршня живых зубов Ингресс. Скорее всего, они не захотели возвращаться с ней сквозь портал на ее родной план. Если держать их вместе, они начинают трещать, напоминая тебе кучу жутких прыгающих костяных жучков.

^NПРИМЕЧАНИЕ: Чтобы поменять тип зубов, выбери «Использовать». У зубов также могут появиться новые особенности и способности по мере повышения уровня Морта.^-~
@6167 = ~Оставить женщину в покое.~
@6168 = ~«Чэго тэбэ нада от мэна?» У женщины сильный акцент, и ты с трудом понимаешь, что она говорит. «Хочэш, чтоб я ушол? НЭ уходит этот город, нэ дождося. Я нэ магу, питалсь, но это нэ горад, а спльошной турма».~
@6169 = ~«Сплошной?»~
@6170 = ~«Извини, я должен идти».~
@6171 = ~«Эст миры, эст...» Ее глаза светятся от безумия. «... планы зыбучий пэсок, пола сухой крапива, нэвидимы миры, гдэ твой руки и ноги живот свой жизн, города тлэна, гдэ люды — пэпэл и шэпчущи прах, дом бэз двэр, Сумрачный Зэмлэ, поющий вэтэр, поющий вэтэр...» Она начинает тихонько рыдать, но похоже, что слезы у нее уже кончились. «И тэн... там был ужасны тэн».~
@6172 = ~«Где все эти места?»~
@6173 = ~«Извини, я должен идти».~
@6174 = ~«Гдэ? Гдэ эты мэста?» Она окидывает обрубком правой руки окружающий город. «Оны всэ здэс. Двэр, двэр, вэдут *куда-угодна*».~
@6175 = ~«Двери?»~
@6176 = ~«Извини, я должен идти».~
@6177 = ~«Ты! Ты нэ знат это?! — она косится на тебя, ее зубы начинают стучать. — Я скажу тэбэ: бэрэгис всо, чэрэз что ты праходэш или чэво касаися в этот трыжды прокляты город... Двэр, ворота, окна, кхартинны рама, отрыты рот статуя, проход мэжду полка... Бэрэгис ЛУБОЙ мэсто, ограничэно со всэх сторон. ВСЭ оны — двэр в другой мэсто».~
@6178 = ~«О чем это ты?»~
@6179 = ~«Извини, я должен идти».~
@6180 = ~«У кажды двэр эст КЛУЧ, и этот клуч показыват их настоящий природа... арка станэт портал, картинный рама станэт портал, окно станэт портал... и всэ хотят закинут тэба куда-то ЭЩО. Они крадут тэба... — она поднимает обрубок правой руки. — А инагда на другой сторона с тэба вазмут ДЭСАТЫНА».~
@6181 = ~«Что это за ключи?»~
@6182 = ~«Извини, я должен идти».~
@6183 = ~«Клуч, клуч столко, сколко двэр в этот город. Кажды двэр — клуч, кажды клуч — двэр». Ее зубы снова начинают стучать, как будто ей холодно. «А клуч?.. Клуч — *всо что угодна*. Это можэт быт эмоций, жэлэзны гвозд, зажаты мэжду второй и паты палэц, или мысл, продуманэ три раз, а патом эщо раз наоборот, или стэкляны роза».~
@6184 = ~«И все это ключи, которые открывают те двери?»~
@6185 = ~«Извини, я должен идти».~
@6186 = ~«Да». Ее зубы начинают стучать, она крепко сжимает рот и прищуривается. «Д-д-да. Нэлза уйты... нэлза уйты...»~
@6187 = ~«Как ты попала сюда?»~
@6188 = ~«Извини, я должен идти».~
@6189 = ~«Из...» Кажется, она немного успокаивается, ее глаза устремляются в бесконечность. «Прэшол из другой мэсто, цэлы жизн назад, напэват пэстна на полана под два дэрэво, повалены друг на друг. Открылса блэстащи двэр, в которы я увидэл этот город... Я шагнул внутр и оказалса здэс».~
@6190 = ~«Почему ты не можешь попасть назад?»~
@6191 = ~«Извини, я должен идти».~
@6192 = ~«Питалса!» Она пытается снова заплакать, но слез больше не осталось. «Питалса! ВСЭ двэр вэдут ДРУГОЙ мэсто». Она содрогается и обхватывает свою оплавленную правую руку. «Ходыл тридцат портал, какой-то спэцално, какой-то случайно, но всэ нэ тэ. Нэ могу найты дорога назад...»~
@6193 = ~«Должен же быть портал, который выведет тебя назад».~
@6194 = ~«Извини, я должен идти».~
@6195 = ~«Я нэ могу уйти отсюда! С этот площад! Здэс, за лубой ворота мэна ждэт смэрт!» Она указывает на Морг за воротами, затем поворачивается к тебе; на ее лице написано отчаяние. «Нэ могу уйты из этот город!»~
@6196 = ~«Ты не можешь никуда уйти? Что ты имеешь в виду?»~
@6197 = ~«Извини, я должен идти».~
@6198 = ~«Всо можэт быт двэр. Лубой арка, лубой двэр можэт быт портал не знат клуч, которы завэдэт тэбэ ужасны мэсто, — ее зубы снова начинают стучать, — лучше дэржатса подалшэ от закрый мэсто. Всо можэт быт двэр, а у мэна можэт быт клуч, и я нэ буду знат...»~
@6199 = ~«Ты... боишься проходить через ЛЮБУЮ дверь или арку, потому что она *может* стать порталом?»~
@6200 = ~«Извини, я должен идти».~
@6201 = ~Она кивает, стуча зубами. ~
@6202 = ~«Как давно ты боишься этого?»~
@6203 = ~«Извини, я должен идти».~
@6204 = ~Она прищуривается. «С тэх пор, как я прошол чэрэз портал, гдэ мой рука... — Она останавливается. — Это был мой дэсаты Оборот... Сэчас мне уже сорок Оборот». Ее зубы снова начинают стучать.~
@6205 = ~«Тридцать лет? Ты не входила *ни в какую дверь* уже тридцать лет?»~
@6206 = ~«Извини, я должен идти».~
@6207 = ~Ее взгляд несколько проясняется. Она смотрит на тебя, все еще продолжая стучать зубами.~
@6208 = ~«Если тебе удалось попасть сюда, то должен быть портал, который отправит тебя обратно. Нужно только найти его...»~
@6209 = ~«Бояться ходить через *любую* дверь — это...»~
@6210 = ~«Да ты *спятила*, женщина? Ты, должно быть, совсем дура, раз не ходишь через что угодно, похожее на дверь...»~
@6211 = ~«Извини, я должен идти».~
@6212 = ~Она улыбается. Ее зубы стучат не от холода... они перемещаются внутри рта, десны изгибаются при их перемещениях. Они подымаются и опадают прямо у тебя на глазах, стуча друг о друга.~
@6213 = ~«Что?..»~
@6214 = ~«Ой... Я лучше пойду... прощай».~
@6215 = ~Она шипит на тебя. «Попадыс случайно в ОДИН портал — и будэш их БОЯТЬСЯ. Я прожыл трыцат, обожогса, потэрат рука и голова, — она смотрит себе под ноги. — Хватэт, хватэт».~
@6216 = ~«Прошу прощения... если я смогу найти способ помочь тебе, я сделаю это. Прощай».~
@6217 = ~«Подыхай в этом городе, если боишься его оставить. Пусть тобой правит страх. Прощай, скатертью дорога».~
@6218 = ~«Я запомню твое предупреждение. Прощай».~
@6219 = ~Ты видишь Ингресс. Она укутана в грязные тряпки, ее зубы стучат. Она украдкой смотрит по сторонам, будто боясь нападения в любой момент.~
@6220 = ~«Здравствуй, Ингресс».~
@6221 = ~Оставить ее в покое.~
@6222 = ~«А? Ты! — она косится на тебя. — Что тэбэ нада?! Хочэш, чтоб я ушол? НЭ уходит этот город, нэ дождоса. Я нэ магу, питалсь, но это нэ горад, а сплошной турма».~
@6223 = ~«Тюрьма для всех? Что ты имеешь в виду?»~
@6224 = ~«Расскажи мне об этих планах... которые ты посетила».~
@6225 = ~«Что это за двери, о которых ты говорила?»~
@6226 = ~«Что это за ключи, о которых ты говорила?»~
@6227 = ~«Как ты попала сюда?»~
@6228 = ~«Ингресс, я нашел кое-кого, кто сможет тебя вернуть тебя домой».~
@6229 = ~Этот грязный труп имеет жалкий вид; его плечи сильно опущены, одна нога сломана и вывернута в другую сторону. С ног до головы он покрыт какими-то пятнами... судя по запаху и виду, эти пятна от тухлых фруктов и птичьего помета. Вдобавок к этому, все тело покрыто надписями, а к груди, спине и голове прибито несколько объявлений.~
@6230 = ~«А я-то думал, что это у *меня* жалкий вид. Тебе от гвоздей не больно?»~
@6231 = ~Осмотреть труп. ~
@6232 = ~Труп не отвечает.~
@6233 = ~Осмотреть труп. ~
@6234 = ~Осмотреть рисунки и объявления.~
@6235 = ~Использовать на трупе свою способность «История костей».~
@6236 = ~«Было приятно поболтать с тобой. Прощай».~
@6237 = ~Оставить труп в покое.~
@6238 = ~Осмотреть труп. ~
@6239 = ~Осмотреть труп. ~
@6240 = ~Осмотреть рисунки и объявления.~
@6241 = ~Использовать на трупе свою способность «История костей».~
@6242 = ~«Было приятно поболтать с тобой. Прощай».~
@6243 = ~Оставить труп в покое.~
@6244 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@6245 = ~Осмотреть труп. ~
@6246 = ~Осмотреть труп. ~
@6247 = ~Осмотреть рисунки и объявления.~
@6248 = ~Оставить труп в покое.~
@6249 = ~Несмотря на множество швов, сгнившая кожа трупа отвалилась в нескольких местах, демонстрируя протяженные участки мускулов и костей. Кажется, что на этом зомби упражнялись в меткости метания снарядов... пятна фруктов и грязи повсюду, в некоторых местах из кожи до сих пор торчат камни и осколки стекла. А из головы торчит внушительных размеров булыжник. ~
@6250 = ~Осмотреть рисунки и объявления.~
@6251 = ~Использовать на трупе свою способность «История костей».~
@6252 = ~Вытащить булыжник.~
@6253 = ~Оставить труп в покое.~
@6254 = ~Несмотря на множество швов, сгнившая кожа трупа отвалилась в нескольких местах, демонстрируя протяженные участки мускулов и костей. Кажется, что на этом зомби упражнялись в меткости метания снарядов... пятна фруктов и грязи повсюду, в некоторых местах из кожи до сих пор торчат камни и осколки стекла. ~
@6255 = ~Осмотреть рисунки и объявления.~
@6256 = ~Использовать на трупе свою способность «История костей».~
@6257 = ~Оставить труп в покое.~
@6258 = ~Множество листовок было попросту смыто дождем, но некоторые из них все еще можно прочесть. Одна из них, приколотая к спине, озаглавлена «Управление по борьбе с вредителями и заболеваниями»; та, что прибита ко лбу, похожа на меню ресторана; другая, на теле, — на официальное объявление, а еще одна похожа на объявление о приеме на работу.~
@6259 = ~Осмотреть труп. ~
@6260 = ~Осмотреть труп. ~
@6261 = ~Игнорировать объявления, осмотреть надписи.~
@6262 = ~Прочитать плакат «Управление по борьбе с вредителями и заболеваниями».~
@6263 = ~Осмотреть меню.~
@6264 = ~Осмотреть Официальное объявление.~
@6265 = ~Татуировка спасителя Трист~
@6266 = ~Татуировка ока правосудия~
@6267 = ~«К гражданам Улья, жилающим плодотворно сатрудничать с УВАЖАИМЫМ и БЛАГАРОДНЕШИМ Правительством Сигила: праследуйте низамдлительно в Управление по барьбе с вредителями и балезнями, штобы памочь в барьбе с черипокрысами. АХОТНИКАМ — НАГРАДА! Медяк за каждый принесеный хвост крысы (Хвост должин быть настаящим и крысиным. Кашачие, сабачие или бесовские хвосты не пренимаются). Управление находется в нижнем Улье, к ЮГОВОСТОКУ от ворот Морга. Спрашевать Афициального Испалнительного, Инспектора УВАЖАИМОГО ФИНЕАСА Т. ЛОРТА XXXIX».~
@6268 = ~«Управление по борьбе с вредителями и болезнями?»~
@6269 = ~Осмотреть труп. ~
@6270 = ~Осмотреть труп. ~
@6271 = ~Осмотреть другие объявления.~
@6272 = ~Использовать на трупе свою способность «История костей».~
@6273 = ~Оставить труп в покое.~
@6274 = ~Кто-то приколол меню «Бара собирателей пыли», но его невозможно прочитать, так как слова «БАР ТЛЕЮЩИЙ ТРУП», написанные углем, покрывают всю листовку.~
@6275 = ~«Бар Тлеющий труп?»~
@6276 = ~«Бар Тлеющий труп?»~
@6277 = ~«Бар Тлеющий труп?»~
@6278 = ~Осмотреть труп. ~
@6279 = ~Осмотреть труп. ~
@6280 = ~Осмотреть другие объявления...~
@6281 = ~Использовать на трупе свою способность «История костей».~
@6282 = ~Оставить труп в покое.~
@6283 = ~«ПУБЛИЧНОЕ ОБЪЯВЛЕНИЕ: По приказу Законодательного Совета и с согласия граждан Сигила, да будет известно, что осквернение Зарегистрированного Служителя тленных, будь то расписывание, физический ущерб или прикрепление объявлений, будет рассматриваться как ПРЕСТУПЛЕНИЕ, и преступник будет отвечать за вандализм оного Служителя». — По Приказу Зала Спикеров -~
@6284 = ~Осмотреть труп. ~
@6285 = ~Осмотреть труп. ~
@6286 = ~Осмотреть другие объявления...~
@6287 = ~Использовать на трупе свою способность «История костей».~
@6288 = ~Оставить труп в покое.~
@6289 = ~Все тело покрыто непристойными надписями, которые оскорбляют тленных и прославляют местные банды. Одна из надписей привлекает твое внимание... кто-то вырезал имя «Фарод» на левой руке, а затем перечеркнул его крестом.~
@6290 = ~«Фарод?»~
@6291 = ~«Фарод?»~
@6292 = ~Осмотреть труп. ~
@6293 = ~Осмотреть труп. ~
@6294 = ~Осмотреть другие объявления...~
@6295 = ~Использовать на трупе свою способность «История костей».~
@6296 = ~Оставить труп в покое.~
@6297 = ~Зомби немедленно поднимает левую руку и указывает далеко на юг. Спустя мгновенье рука падает назад с сочным шлепком.~
@6298 = ~Осмотреть труп. ~
@6299 = ~Осмотреть труп. ~
@6300 = ~«Хм-м. Интересно, сработает ли это с другими объявлениями...»~
@6301 = ~«Хм-м. Интересно, сработает ли это с другими объявлениями...»~
@6302 = ~Осмотреть другие объявления.~
@6303 = ~Использовать на трупе свою способность «История костей».~
@6304 = ~«Э... Спасибо».~
@6305 = ~Зомби немедленно поднимает левую руку и указывает далеко на юго-запад. Спустя мгновенье рука падает назад с сочным шлепком.~
@6306 = ~Осмотреть труп. ~
@6307 = ~Осмотреть труп. ~
@6308 = ~Осмотреть другие объявления.~
@6309 = ~Использовать на трупе свою способность «История костей».~
@6310 = ~«Э... Спасибо».~
@6311 = ~Зомби немедленно поднимает левую руку и указывает далеко на запад... и вниз. Спустя мгновенье рука падает назад с сочным шлепком.~
@6312 = ~Осмотреть труп. ~
@6313 = ~Осмотреть труп. ~
@6314 = ~Осмотреть другие объявления.~
@6315 = ~Использовать на трупе свою способность «История костей».~
@6316 = ~«Э... Спасибо».~
@6317 = ~Ты хватаешь булыжник за край и вытягиваешь его из головы трупа. Остатки мозга и сгнившей плоти медленно вытекают из головы... кажется, что все, что было в ней, превратилось в липкую слизь много лет назад. ~
@6318 = ~Осмотреть труп. ~
@6319 = ~Осмотреть другие объявления.~
@6320 = ~Использовать на трупе свою способность «История костей».~
@6321 = ~Оставить труп в покое.~
@6322 = ~Зомби немедленно поднимает левую руку и указывает далеко на юго-восток. Спустя мгновенье рука падает назад с сочным шлепком.~
@6323 = ~Назад в Нижний район~
@6324 = ~«Это напоминает мне одну мою работенку». Кажется, он смущен. «Ну, только... без махания руками». ~
@6325 = ~Осмотреть труп. ~
@6326 = ~Осмотреть труп. ~
@6327 = ~«Хм-м. Интересно, это сработает с другими записками?..»~
@6328 = ~«Хм-м. Интересно, это сработает с другими записками?..»~
@6329 = ~Осмотреть другие записки.~
@6330 = ~Использовать на трупе свою способность «История костей».~
@6331 = ~Оставить труп в покое.~
@6332 = ~«Тестовая таверна»~
@6333 = ~«Тестовый храм»~
@6334 = ~«Три хвоста, по три медяка за крысу...»~
@6335 = ~«Еще один крысолов мертв... эти паразиты становятся все умнее...»~
@6336 = ~«Инспектор Финеас Т. Лорт XXXIX во главе, так-точно-сэр...»~
@6337 = ~«Удивительно, как Улей еще не захлестнули паразиты!»~
@6338 = ~«Мы все ищем утешение в ее объятиях».~
@6339 = ~«Истинная Смерть ждет».~
@6340 = ~~
@6341 = ~~
@6342 = ~«Ты увидишь, что я могу постоять за себя, несущий шрамы. Не подходи ближе».~
@6343 = ~Готово.~
@6344 = ~«Несомненно, ты не из здешних. Уходи сейчас же, нарушитель, иначе стража примет более строгие меры, чем простое сопровождение».~
@6345 = ~«У меня только небольшой вопрос».~
@6346 = ~«У меня только небольшой вопрос».~
@6347 = ~Уйти.~
@6348 = ~«Уходи. Сейчас же. Пока это не стало ошибкой, о которой мы все пожалеем».~
@6349 = ~«Просто ответь на вопрос!»~
@6350 = ~Уйти.~
@6351 = ~Ты видишь гитцерайку со шрамами на лице. По меркам гитцераев она могла бы считаться красивой. «Я не могу помочь тебе в этом. Уйди, прежде чем мне придется позвать стражу. Я выражаю эту признательность только из-за твоего спутника, — она кивает на Даккона и говорит: Почтенный, прости меня».~
@6352 = ~«Это все, конечно, хорошо, но мне нужно, чтобы ты ответила на несколько вопросов».~
@6353 = ~«Отлично». Уйти.~
@6354 = ~«Ты не оставляешь мне выбора», — она замолкает, а затем кричит: «СТРАЖА! КО МНЕ!»~
@6355 = ~Готово.~
@6356 = ~«Я просто хотел, чтобы ты ответила мне на несколько вопросов!»~
@6357 = ~Она снова обращается к Даккону. «Приношу свои извинения, — она поворачивается к тебе. — Позволь мне объяснить. Уходи. Сейчас же. Иначе я буду вынуждена позвать стражу, чтобы сопроводить тебя из этого места. Наш проект не может подвергаться риску».~
@6358 = ~Уйти.~
@6359 = ~«Ты не оставляешь мне выбора», — она замолкает, а затем кричит: «СТРАЖА! КО МНЕ!»~
@6360 = ~Готово.~
@6361 = ~Она снова обращается к Даккону. «Почтенный... не приходи сюда снова. Я не хочу насылать на тебя стражников. Уходи».~
@6362 = ~«Слушай, просто ответь на пару вопросов».~
@6363 = ~Уйти.~
@6364 = ~Взгляд ее черных глаз падает на Даккона. «Почтенный... ты не оставил мне выбора. Прости меня перед лицом наших предков». Она оборачивается и кричит: «Стража! Стража!»~
@6365 = ~Готово.~
@6366 = ~Ты видишь гитцерайку, лысую, со шрамами на щеках и кошачьей грациозной походкой. Повернувшись к вам, она замечает Даккона. Ее глаза расширяются. Она обращается к нему: «Ты принес радость в мое сердце. Меня зовут Келлера. Могу ли я помочь тебе?»~
@6367 = ~«Что это значит?»~
@6368 = ~«Хорошо. Тогда ответь на другие вопросы, если ты не против».~
@6369 = ~«Хорошо. Тогда я закончил. Прощай».~
@6370 = ~«Тогда спрашивай, и я отвечу, если смогу. Твой спутник несет бремя твоего молчания, как часть собственной славы, и там, где я не буду знать, можно ли доверять тебе, уверена, что смогу довериться ему».~
@6371 = ~«Скажи мне, что делает это устройство».~
@6372 = ~«Какие у этого устройства слабые места?»~
@6373 = ~«Кто заказал это устройство?»~
@6374 = ~«Кто заказал это устройство?»~
@6375 = ~«Что ты можешь рассказать об убийстве?»~
@6376 = ~«Что ты можешь рассказать об остальных инженерах?»~
@6377 = ~Обратиться к Даккону: «Кто она, и почему обращается к тебе с таким уважением?»~
@6378 = ~«Пока ничего. Прощай».~
@6379 = ~«Наше устройство извергает особый тип магического огня, который причиняет вред даже тем, кто невосприимчив к обычному огню. Мы работаем над тем, чтобы обходить даже сопротивление магии».~
@6380 = ~«Какие другие применения у него могут быть?»~
@6381 = ~«Хорошо. Ответь на другие вопросы».~
@6382 = ~«Это все. Прощай».~
@6383 = ~Она бросает взгляд на Падшую Грацию, и рот ее изгибается в изящной гримасе. «Извини, почтенный, но я не могу говорить об этом. Я, как по контракту, так и магически, вынуждена не обсуждать это в присутствие некоторых... «проявлений», скажем... убеждений». Она обращается к суккубу: «Прими мои извинения, госпожа Грация».~
@6384 = ~Келлера кивает.~
@6385 = ~«Что это значит?»~
@6386 = ~«Хорошо. Тогда ответь на другие вопросы, если ты не против».~
@6387 = ~Она бросает тяжелый взгляд на Даккона, который некоторое время смотрит на тебя оценивающе, а затем оборачивается и кивком подтверждает ей свое согласие. «Хорошо. Самое слабое место — огневой механизм в задней части устройства. Слишком сильное его повреждение будет для всех нас фатальным. Это вызовет цепную реакцию, которая уничтожит всех, кто привязан к этому устройству. У диверсанта, скорее всего, будет время, чтобы сбежать; у тех из нас, кто привязан к устройству — нет».~
@6388 = ~«Привязан? Что ты имеешь в виду?»~
@6389 = ~«Хорошо. Ответь мне на пару вопросов».~
@6390 = ~«Благодарю». Уйти.~
@6391 = ~Бригадир снова смущенно поворачивается к Падшей Грации и процеживает сквозь зубы: «Я не могу говорить об этом».~
@6392 = ~«Тогда ладно. Ответь мне на пару вопросов».~
@6393 = ~Уйти.~
@6394 = ~«Помимо его боевых качеств? Его можно было бы использовать как отличную буровую установку. Если правильно его настроить, оно могло бы убирать целые просеки леса или поля зерна. Оно может на время делать твердой оболочку вещества Лимбо — мы даже испытывали здесь эту технологию в меньших масштабах, его даже можно использовать для продвижения через сферы Карцери. Варианты его использования ограничены лишь воображением. Так что это не только оружие разрушения».~
@6395 = ~«Интересно. Ответь еще на несколько вопросов».~
@6396 = ~«Отлично. Прощай». Уйти.~
@6397 = ~Она оглядывается по сторонам, вздыхает и отвечает: «Хоть я и не принимала участие в переговорах, я думаю, что это баатезу, которые пользовались нашими услугами. Символ, который ты носишь, даст тебе некоторую дипломатическую неприкосновенность от баатезу, которых ты можешь повстречать».~
@6398 = ~«Уверен, что он мне пригодится. Ответь мне еще на несколько вопросов, если ты не против».~
@6399 = ~«Спасибо за информацию. Прощай».~
@6400 = ~«Немного. Я была здесь со своими кузнецами почти все время. Я бы советовала поговорить с кем-то, кто мог быть в Литейной после наступления темноты. На ум приходят два имени: Тильдон, бригадир рабочих, и Сарос, парень, который, кажется, приглядывает за ним».~
@6401 = ~«Э, Тильдон и Сарос? Отлично. Ответь еще на несколько вопросов, если ты не против».~
@6402 = ~«Э, Тильдон и Сарос? Схожу проверю их. Прощай».~
@6403 = ~Она хмурится, добавляя несколько морщин на свое покрытое шрамами лицо. «Поговори с одним из моих кузнецов, если хочешь *знать* об инженерах. От меня ты не услышишь добрых слов о них».~
@6404 = ~«Почему нет?»~
@6405 = ~«Ладно. Тогда ответь еще на несколько вопросов».~
@6406 = ~«Отлично». Уйти.~
@6407 = ~«Почему? Да потому что они, похоже, не разделяют любовь к этому проекту со своими товарищами. Потому что они — мечтатели, и сами не ничего не делают. Потому что, в конце концов, я не верю в доброту их намерений относительно нас: это все только ради их блага».~
@6408 = ~«Понятно. Тогда расскажи мне другом».~
@6409 = ~«Я понимаю. Прощай».~
@6410 = ~«Я имею в виду, мы привязаны к этой машине посредством магических ритуалов, которые питают ее. Если случится ошибка, или, чего хуже, саботаж — я и все, кого ты видишь в помещении, непременно превратятся в пепел. Что еще хуже, наши души тоже будут уничтожены, разнесены в клочья, и им будет дарован лишь мир холодного и темного забытия. Теперь ты понимаешь нашу секретность?»~
@6411 = ~«Полагаю, что да. Ответь мне еще на несколько вопросов...»~
@6412 = ~«Полагаю, что да. Прощай».~
@6413 = ~«Спрашивай, и я отвечу, если смогу. Я доверяю благоразумию твоего товарища».~
@6414 = ~«Скажи мне, что делает это устройство».~
@6415 = ~«Какие у этого устройства слабые места?»~
@6416 = ~«Кто заказал это устройство?»~
@6417 = ~«Кто заказал это устройство?»~
@6418 = ~«Что ты можешь рассказать об убийстве?»~
@6419 = ~«Что ты можешь рассказать об остальных инженерах?»~
@6420 = ~Обратиться к Даккону: «Кто она, и почему обращается к тебе с таким уважением?»~
@6421 = ~«Пока ничего. Прощай».~
@6422 = ~Лысая, покрытая шрамами женщина гитцерай поворачивается к тебе с невероятной грацией. Ее глаза пробегают по твоему телу оценивающе, затем она говорит: «Твой знак дает тебе право доступа. Что еще ты хочешь от меня?»~
@6423 = ~«Мне нужны лишь ответы на несколько вопросов».~
@6424 = ~«Не смей говорить со мной таким тоном, или я задам тебе взбучку».~
@6425 = ~«Пока ничего. Прощай».~
@6426 = ~«Задавай свои вопросы, и заканчивай с этим. Знай: у меня много работы, ждущей моих рук».~
@6427 = ~«Скажи мне, что делает это устройство».~
@6428 = ~«Какие у этого устройства слабые места?»~
@6429 = ~«Кто заказал это устройство?»~
@6430 = ~«Кто заказал это устройство?»~
@6431 = ~«Что ты можешь рассказать об убийстве?»~
@6432 = ~«Что ты можешь рассказать об остальных инженерах?»~
@6433 = ~«Пока ничего. Прощай».~
@6434 = ~Ее узкие глаза превращаются в щелочки. «Ты смеешь угрожать мне здесь? Убирайся немедленно и дай мне время, чтобы забыть эту обиду, иначе я прикажу страже вышвырнуть твое окровавленное тело на улицу».~
@6435 = ~«Да я скорее умру».~
@6436 = ~«Тогда ладно. Прощай».~
@6437 = ~«Это можно устроить. СТРАЖА! Убейте этого нарушителя!»~
@6438 = ~Приготовиться к схватке.~
@6439 = ~«Наше устройство извергает особый тип магического огня, который причиняет вред даже тем, кто невосприимчив к обычному огню. Мы работаем над тем, чтобы обходить даже сопротивление магии».~
@6440 = ~«Какие другие применения у него могут быть?»~
@6441 = ~«Хорошо. Ответь на другие вопросы».~
@6442 = ~«Это все. Прощай».~
@6443 = ~«Помимо его боевых качеств? Его можно было бы использовать как отличную буровую установку. Если правильно его настроить, оно могло бы убирать целые просеки леса или поля зерна. Оно может на время делать твердой оболочку вещества Лимбо — мы даже испытывали здесь эту технологию в меньших масштабах, его даже можно использовать для продвижения через сферы Карцери. Варианты его использования ограничены лишь воображением. Так что это не только оружие разрушения».~
@6444 = ~«Интересно. Ответь еще на несколько вопросов».~
@6445 = ~«Отлично. Прощай». Уйти.~
@6446 = ~«Я не вижу причины, по которой тебе следует знать эту информацию, богочеловек ты или нет. Я не выдам такие сведения».~
@6447 = ~«Что, если я заставлю тебя говорить?»~
@6448 = ~«Отлично. Тогда можешь ответить еще на несколько вопросов?»~
@6449 = ~«Вполне справедливо. Счастливо».~
@6450 = ~Она оглядывается по сторонам, вздыхает и отвечает: «Хоть я и не принимала участие в переговорах, я думаю, что это баатезу, которые пользовались нашими услугами. Символ, который ты носишь, даст тебе некоторую дипломатическую неприкосновенность от баатезу, которых ты можешь повстречать».~
@6451 = ~«Уверен, что он мне пригодится. Ответь мне еще на несколько вопросов, если ты не против».~
@6452 = ~«Спасибо за информацию. Прощай».~
@6453 = ~Она бросает взгляд на Падшую Грацию, и рот ее изгибается в изящной гримасе. «Извини, почтенный, но я не могу говорить об этом. Я, как по контракту, так и магически, вынуждена не обсуждать это в присутствие некоторых... «проявлений», скажем... убеждений». Она обращается к суккубу: «Прими мои извинения, госпожа Грация».~
@6454 = ~«Хорошо. Тогда я закончил. Прощай».~
@6455 = ~«Да».~
@6456 = ~«Да».~
@6457 = ~Бригадир снова смущенно поворачивается к Падшей Грации и процеживает: «Я не могу сказать!»~
@6458 = ~«Тогда ладно. Ответь мне на пару вопросов».~
@6459 = ~Уйти.~
@6460 = ~«Немного. Я была здесь со своими кузнецами почти все время. Я бы советовала поговорить с кем-то, кто мог быть в Литейной после наступления темноты. На ум приходят два имени: Тильдон, бригадир рабочих, и Сарос, парень, который, кажется, приглядывает за ним».~
@6461 = ~«Э, Тильдон и Сарос? Отлично. Ответь еще на несколько вопросов, если ты не против».~
@6462 = ~«Э, Тильдон и Сарос? Схожу проверю их. Прощай».~
@6463 = ~Она хмурится, добавляя несколько морщин на свое покрытое шрамами лицо. «Поговори с одним из моих кузнецов, если хочешь *знать* об инженерах. От меня ты не услышишь добрых слов о них».~
@6464 = ~«Почему нет?»~
@6465 = ~«Ладно. Тогда ответь еще на несколько вопросов».~
@6466 = ~«Отлично». Уйти.~
@6467 = ~«Почему? Да потому что они, похоже, не разделяют любовь к этому проекту со своими товарищами. Потому что они — мечтатели, и сами не ничего не делают. Потому что, в конце концов, я не верю в доброту их намерений относительно нас: это все только ради их блага».~
@6468 = ~«Понятно. Тогда расскажи мне другом».~
@6469 = ~«Я понимаю. Прощай».~
@6470 = ~Она смотрит на тебя, потом с недоумением оборачивается к нему. «Конечно, почтенный, если ты говоришь за него и принимаешь ответственность за содержание в секрете того, что будет услышано, — она неохотно переключает внимание на тебя. — У тебя ко мне вопросы?»~
@6471 = ~«Мой спутник хотел бы переговорить с тобой о работе этого устройства. Может ли он говорить за нас двоих?»~
@6472 = ~Келлера кивает.~
@6473 = ~«Она — одна из Народа. Ее отметины говорят о той, кто пришел из Лимбо и кого заставили *не знать* дом наших предков. Ее отметины призывают всех гитцераев предоставить ей помощь: они говорят гитцераям, что она все еще одна из Народа. Ее почтение ко мне — почтение ко всем *зертам*».~
@6474 = ~«Она не может говорить об этом в присутствии нечисти. Раз она связана контрактом, то можно предположить, что это проект Законопослушного порядка. А раз связана еще и магически, то, скорее всего, в этом замешаны баатезу».~
@6475 = ~Келлера кивает.~
@6476 = ~«Она не может говорить об этом в присутствии нечисти. Раз она связана контрактом, то можно предположить, что это проект Законопослушного порядка. А раз связана еще и магически, то, скорее всего, в этом замешаны баатезу».~
@6477 = ~«Я понимаю».~
@6478 = ~«Что это за место?»~
@6479 = ~«У меня сообщение для Кельдора от аукционера Гилтспура».~
@6480 = ~«Да. Нам о тебе сообщили. Входи».~
@6481 = ~«Спасибо».~
@6482 = ~Некоторое время стражник смотрит на тебя со скучным выражением. «Желаю удачи. Входи».~
@6483 = ~«Спасибо».~
@6484 = ~Неуклюжий труп смотрит на тебя пустым взглядом. На его лбу вырезан номер «463», а его губы крепко зашиты. От тела исходит легкий запах формальдегида.~
@6485 = ~«Итак... что тут у нас интересного?»~
@6486 = ~Труп продолжает пялиться на тебя.~
@6487 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@6488 = ~«Итак... что тут у нас интересного?»~
@6489 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6490 = ~Использовать на трупе свою способность «История костей».~
@6491 = ~«Было приятно с тобой поболтать. Прощай».~
@6492 = ~Оставить труп в покое.~
@6493 = ~Оставить труп в покое.~
@6494 = ~Оставить труп в покое.~
@6495 = ~Губы этого ходячего трупа крепко сшиты, над бровью вырезан номер «310»; воздух вокруг него насыщен формальдегидом. Как только ты встаешь на его пути, он поворачивает к тебе свой безжизненный взгляд.~
@6496 = ~Труп продолжает пялиться на тебя.~
@6497 = ~Труп не реагирует. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@6498 = ~Ты уж было решаешь, что труп слишком далек от того, чтобы отвечать... но вдруг ты замечаешь страдания, отпечатанные на его лице, и ощущаешь в них беспредельное отчаяние — дух точно вернулся в свою старую оболочку.~
@6499 = ~«Итак... что тут у нас интересного?»~
@6500 = ~«Итак... что тут у нас интересного?»~
@6501 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6502 = ~Использовать на трупе свою способность «История костей».~
@6503 = ~«Было приятно с тобой поболтать. Прощай».~
@6504 = ~Оставить труп в покое.~
@6505 = ~Оставить труп в покое.~
@6506 = ~«Я хотел бы задать тебе вопрос...»~
@6507 = ~Глаза этого трупа близко посажены и слегка косят: один смотрит влево, а другой — вправо. Ты с трудом различаешь номер «257» на разбитом лбу: похоже, труп несколько раз получил по голове, из-за чего номер различается с трудом. ~
@6508 = ~В глазах трупа нет даже намека на понимание; они продолжают смотреть каждый в свою сторону. ~
@6509 = ~Дух врывается назад в тело с такой силой, что труп, охваченный судорогой, отлетает назад! Тело, извиваясь и мечась в безумном танце, тотчас поднимается на ноги, размахивая руками, разрывая швы и тряся отваливающимися кусками плоти. Глаза трупа выпучиваются и вращаются, а сам он без конца хихикает как сумасшедший...~
@6510 = ~«У тебя голова не кружится из-за глаз?»~
@6511 = ~«У тебя голова не кружится из-за глаз?»~
@6512 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6513 = ~Использовать на трупе свою способность «История костей».~
@6514 = ~«Было приятно с тобой поболтать. Прощай».~
@6515 = ~Оставить труп в покое.~
@6516 = ~Оставить труп в покое.~
@6517 = ~«Э-э... У меня к тебе вопрос, дух...»~
@6518 = ~На лбу этого ходячего трупа вырезан номер «1146», губы зашиты грубой черной ниткой. Все тело покрыто ужасающими шрамами — даже хуже, чем у тебя самого. Кажется, хозяин тела сгорел заживо. У него нет носа, ушей и нескольких пальцев, вероятно, потерянных в давнем пожаре. Когда ты загораживаешь ему путь, чтобы привлечь его «внимание», он останавливается и смотрит на тебя пустым взглядом.~
@6519 = ~Труп продолжает пялиться на тебя.~
@6520 = ~Когда дух возвращается в свою бывшую обитель, тебе в нос ударяет запах серы, паленых волос и запекшейся крови. Почти сразу же мертвец падает на пол, неистово содрогаясь, словно в чьей-то хватке, и жалобно стеная. Ты буквально видишь тонкие струйки вонючего дыма, исходящие от его туловища и конечностей.~
@6521 = ~«Итак... что тут у нас интересного?»~
@6522 = ~«Итак... что тут у нас интересного?»~
@6523 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6524 = ~Использовать на трупе свою способность «История костей».~
@6525 = ~«Было приятно с тобой поболтать. Прощай».~
@6526 = ~Оставить труп в покое.~
@6527 = ~Оставить труп в покое.~
@6528 = ~«С тобой... все в порядке?»~
@6529 = ~У этого ковыляющего зашит не только рот, но и глаза, а на брови вырезан номер «732». Похоже, глазные полости были зашиты давным-давно... тебе остается только гадать, когда потерял человек глаза — до смерти или после.~
@6530 = ~Труп продолжает пялиться на тебя.~
@6531 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@6532 = ~«Извини, что забрал ту книгу... она выглядела слишком интересной, что пропустить ее мимо».~
@6533 = ~«Извини, что забрал ту книгу... она выглядела слишком интересной, что пропустить ее мимо».~
@6534 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6535 = ~Использовать на трупе свою способность «История костей».~
@6536 = ~«Было приятно с тобой поболтать. Прощай».~
@6537 = ~Оставить труп в покое.~
@6538 = ~Оставить труп в покое.~
@6539 = ~Оставить труп в покое.~
@6540 = ~На лбу этого мертвого работяги при помощи глубоких порезов нанесены цифры «613», но на коже между «1» и «3» виден большой пробел шириной с палец. Приглядевшись, ты с трудом различаешь вырезанную «2».~
@6541 = ~Труп продолжает пялиться на тебя.~
@6542 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@6543 = ~«Итак... что тут у нас интересного?»~
@6544 = ~«Итак... что тут у нас интересного?»~
@6545 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6546 = ~Использовать на трупе свою способность «История костей».~
@6547 = ~«Было приятно с тобой поболтать. Прощай».~
@6548 = ~Оставить труп в покое.~
@6549 = ~Оставить труп в покое.~
@6550 = ~Оставить труп в покое.~
@6551 = ~Татуировка гибели Гросука~
@6552 = ~Защита Магуса~
@6553 = ~Книга Финама~
@6554 = ~Узы страха~
@6555 = ~~
@6556 = ~~
@6557 = ~~
@6558 = ~~
@6559 = ~~
@6560 = ~~
@6561 = ~~
@6562 = ~У этого ходячего трупа на лбу вырезан номер «1094». Его губы крепко сшиты, от него исходит сильный химический запах свежего формальдегида, окружающего его в виде облака. Несмотря на мертвенно-бледное лицо и впалые безжизненные молочно-белые глаза, совершенно очевидно, что раньше это был красивый молодой человек.~
@6563 = ~Труп продолжает пялиться на тебя.~
@6564 = ~Тело на миг вздрагивает, затем замирает: душа еще раз вселяется в когда-то покинутую оболочку. В считанные секунды в глазах зомби появляется некое подобие жизни, и он начинает оглядываться по сторонам с любопытно-озадаченным выражением лица. Все тело теперь окружено мягким золотым свечением.~
@6565 = ~«Итак... что тут у нас интересного?»~
@6566 = ~«Итак... что тут у нас интересного?»~
@6567 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6568 = ~Использовать на трупе свою способность «История костей».~
@6569 = ~«Было приятно с тобой поболтать. Прощай».~
@6570 = ~Оставить труп в покое.~
@6571 = ~Оставить труп в покое.~
@6572 = ~«Я хотел бы задать тебе вопрос...»~
@6573 = ~У этого поднятого трупа мужчины на лбу вырезан номер «1041». Несмотря на жесткую высушенную плоть, совершенно очевидно, что его лицо когда-то придавало ему довольно «экзотическую» внешность. Губы зомби крепко зашиты — скорее всего, чтобы не стонал все время, — а сам он сильно пахнет формальдегидом.~
@6574 = ~Труп продолжает пялиться на тебя.~
@6575 = ~В миг, когда дух возвращается в свою прежнюю обитель, труп вздрагивает. Его миндалевидные глаза снова темнеют, бледная кожа приобретает слегка бронзовый оттенок. Он выпрямляется, отряхивая пыль из одежды.

Заметив, наконец, вызывающего, призрак бросает на тебя пытливый взгляд, затем делает легкий поклон.~
@6576 = ~«Итак... что тут у нас интересного?»~
@6577 = ~«Итак... что тут у нас интересного?»~
@6578 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6579 = ~Использовать на трупе свою способность «История костей».~
@6580 = ~Использовать на трупе свою способность «История костей».~
@6581 = ~«Было приятно с тобой поболтать. Прощай».~
@6582 = ~Оставить труп в покое.~
@6583 = ~Поклониться в ответ.~
@6584 = ~Немного помятая голова этого мертвеца стянута многочисленными тонкими металлическими лентами, скрепленными прямо на черепе. На проржавевшей табличке над его левым глазом выбит номер «475». Его рот намертво закрыт; от него несет бальзамирующей жидкостью.~
@6585 = ~Труп продолжает пялиться на тебя.~
@6586 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@6587 = ~«Итак... что тут у нас интересного?»~
@6588 = ~«Итак... что тут у нас интересного?»~
@6589 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@6590 = ~Использовать на трупе свою способность «История костей».~
@6591 = ~«Было приятно с тобой поболтать. Прощай».~
@6592 = ~Оставить труп в покое.~
@6593 = ~Оставить труп в покое.~
@6594 = ~Оставить труп в покое.~
@6595 = ~Скелет поворачивается к тебе. На лбу у него высечено число «42»; многие его кости, преимущественно челюсти и суставы, обмотаны кожаными ремешками. Его тело скрывает черный комбинезон.~
@6596 = ~Услышав твой голос, скелет внезапно распрямляется. Он скрещивает руки на груди, ухватившись пальцами за ребра.~
@6597 = ~Скелет не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@6598 = ~Удивительно, как этот мешок костей еще не развалился. Его пожелтевшие кости покрыты гипсом и несколькими слоями вонючего клея... В просветах, где видны кости, ты различаешь сотни мелких трещин. Хотя кто-то позаботился о том, чтобы перемотать скелет кожаными ремешками и соединить его кости скобами в суставах, ремешки уже износились, а скобы вот-вот выпадут. ~
@6599 = ~В ответ скелет опускает руки по швам. Кожаная веревка, связывающая торс скелета, лопается, и грудная клетка раскрывается, как двустворчатая дверь. ~
@6600 = ~К твоему удивлению, рука исчезает, едва ты засовываешь ее внутрь грудной клетки... у тебя странное ощущение, что теперь она находится где-то в *другом* месте. Оказавшись внутри, твоя рука натыкается на невидимый предмет. Он размером с кулак и, похоже, прикреплен к позвоночнику скелета.~
@6601 = ~Скобы свободно выскальзывают из суставов скелета. Скелет разваливается, хотя некоторые кости продолжают шевелиться.~
@6602 = ~Как только ты вытаскиваешь предмет, скелет внезапно растворяется в воздухе, причем скрепляющие скобы и ремни с грохотом падают на пол. Чем бы ни был этот предмет, похоже, один только он и удерживал кости вместе.~
@6603 = ~Похоже на ничем не примечательный кусок железа. Ты не можешь представить, зачем кому-то понадобилось прятать его в грудной клетке скелета.~
@6604 = ~В ответ скелет опускает руки по швам. Кожаная веревка, связывающая корпус скелета, лопается, и грудная клетка раскрывается, как двустворчатая дверь. Ты испытываешь непреодолимое желание засунуть руку внутрь грудной клетки, хотя не можешь объяснить почему.~
@6605 = ~Руки скелета опускаются по швам.~
@6606 = ~Похоже на ничем не примечательный кусок железа. Должно быть, у твоей предыдущей инкарнации были причины спрятать его здесь.~
@6607 = ~Скелет снова скрещивает руки на груди.~
@6608 = ~Скелет снова скрещивает руки на груди.~
@6609 = ~«Эй, шеф. Это уже вандализм. Эти скобы — возможно, единственное, что не дает рассыпаться этому мешку с костями. Знаешь, с такими приятелями некромантия чудес не творит».~
@6610 = ~«Хм-м. Интересно, что подумает этот седобородый, если *я* возьму взаймы его тело...»~
@6611 = ~«Может, уже хватит? У него руки сейчас отвалятся».~
@6612 = ~«*Кажется*, именно этот мертвец был в моем воспоминании...»~
@6613 = ~«Прошу прощения, ты не видал поблизости других скелетов?»~
@6614 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать: не похоже, что у тебя есть что скрывать».~
@6615 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать: не похоже, что у тебя есть что скрывать».~
@6616 = ~Использовать на трупе свою способность «История костей».~
@6617 = ~Внимательно осмотреть скелет.~
@6618 = ~Попробовать вытащить скобы из суставов скелета.~
@6619 = ~Попробовать вытащить скобы из суставов скелета.~
@6620 = ~Попробовать вытащить скобы из суставов скелета.~
@6621 = ~«Эй, а как насчет этого скелета, Морт? Пойдет такое тело?»~
@6622 = ~Оставить скелет в покое.~
@6623 = ~Оставить скелет в покое.~
@6624 = ~Оставить скелет в покое.~
@6625 = ~Скрестить свои руки на груди.~
@6626 = ~Повторять движения скелета... посмотрим, что получится.~
@6627 = ~«Э-э...»~
@6628 = ~Оставить скелет в покое.~
@6629 = ~Оставить скелет в покое.~
@6630 = ~Оставить скелет в покое.~
@6631 = ~Оставить скелет в покое.~
@6632 = ~Попробовать вытащить скобы из суставов скелета.~
@6633 = ~Попробовать вытащить скобы из суставов скелета.~
@6634 = ~«Не против, если я возьму немного ремешков и скоб?»~
@6635 = ~Оставить скелет в покое.~
@6636 = ~Оставить скелет в покое.~
@6637 = ~Оставить скелет в покое.~
@6638 = ~Засунуть руку в грудную клетку, пошарить внутри.~
@6639 = ~Оставить скелет в покое.~
@6640 = ~Вытащить предмет.~
@6641 = ~Оставить скелет в покое.~
@6642 = ~«Прости, Костяшка...»~
@6643 = ~Осмотреть предмет.~
@6644 = ~Осмотреть предмет.~
@6645 = ~Осмотреть кусок железа.~
@6646 = ~Засунуть руку в грудную клетку, пошарить внутри.~
@6647 = ~Оставить скелет в покое.~
@6648 = ~«Э... привет?»~
@6649 = ~«Э... привет?»~
@6650 = ~Внимательно осмотреть скелет.~
@6651 = ~Оставить скелет в покое.~
@6652 = ~Внимательно осмотреть кусок железа.~
@6653 = ~Скрестить свои руки на груди.~
@6654 = ~Повторять движения скелета... посмотрим, что получится.~
@6655 = ~«Э-э...»~
@6656 = ~Оставить скелет в покое.~
@6657 = ~Старик глядит на тебя без страха и произносит: «Значит, ты тот, из-за кого подняли весь этот шум, а? В таком случае, убирайся отсюда. Мне не о чем с тобой говорить».~
@6658 = ~«И что?»~
@6659 = ~«О... Я не хотел ему навредить».~
@6660 = ~«Ну, тогда ладно. Может, в другой раз».~
@6661 = ~«Седобородый?»~
@6662 = ~«Не думаю, что он имеет что-то против».~
@6663 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@6664 = ~Скрестить свои руки.~
@6665 = ~Подстроиться под движения скелета... посмотреть, что получится.~
@6666 = ~«Э...»~
@6667 = ~Оставить скелета в покое.~
@6668 = ~Уйти.~
@6669 = ~Старик глядит на тебя с недоумением, затем произносит: «Здесь я не смогу тебе помочь. Тебе придется уйти со стражей». Он возвращается к устройству, которое держит в руках.~
@6670 = ~Уйти.~
@6671 = ~«И ты действительно думаешь, что я собираюсь тебе помогать после того, как ты мне угрожал? Да ты еще больший болван, чем я думал. Я требую извинений. Сейчас же».~
@6672 = ~«Катись в девять преисподен, дедуля».~
@6673 = ~Ложь: «Прошу прощения. Я погорячился. Этого больше не повторится».~
@6674 = ~«Прошу прощения. Я погорячился. Этого больше не повторится».~
@6675 = ~«Нет. Прощай».~
@6676 = ~«Механизм все еще не в порядке, приятель. Полагаю, раз эта дура Бедай-Линн мертва, я должен дать тебе подсказки, которые нужны тебе для его починки. Итак, вот что тебе нужно делать...» — он начинает рассказывать. Ты не уверен, сможешь ли ты все понять.~
@6677 = ~«Кажется, я понял. Другими словами, мне просто нужно снять главную шестерню, смазать ее, заточить тупые зубья и вернуть ее на место?»~
@6678 = ~«Кажется, я понял... так, что там на счет главного мотивационного узла... нет, постой. Я вообще ничего не понял».~
@6679 = ~«Конечно. А теперь могу ли я вернуться к работе, или ты собираешься докучать мне другими вопросами?»~
@6680 = ~«Ну, вообще-то, я собираюсь задать тебе еще парочку вопросов».~
@6681 = ~«Нет, это все. Прощай».~
@6682 = ~«Понятно: ты так и не сможешь починить эту штуку. Полагаю, мне придется взять на себя ее починку», — говорит он хрипящим голосом и тяжело поднимается на ноги. «Некоторые пни создают нам, седобородым, слишком много трудностей», — бормочет он.~
@6683 = ~«Прежде чем ты уйдешь, я хотел бы задать тебе еще несколько вопросов».~
@6684 = ~«Ну да, кое-кто из нас владеет другими навыками. Пень».~
@6685 = ~«Как только ты будешь готов для ключа снов, несущий шрамы, только скажи — и я дам тебе его».~
@6686 = ~«Дай мне ключ».~
@6687 = ~«Нет. Пока нет. Ответь мне еще на несколько вопросов».~
@6688 = ~«Забудь».~
@6689 = ~Он замолкает, как будто собираясь с мыслями. «Закрой глаза и вытяни руку, — говорит он. — Ты должен почувствовать ключ, прежде чем увидишь его, иначе ничего не выйдет».~
@6690 = ~Сделать, как он говорит.~
@6691 = ~Подглядеть.~
@6692 = ~Ты чувствуешь, как что-то коснулось ладони твоей мозолистой руки. Сперва ты едва можешь его различить, но уже через несколько мгновений оно быстро обретает твердость, пока Зандер, наконец, не говорит: «Открой глаза». Сделав это, ты обнаруживаешь у себя на ладони простое черное перо. «Моя работа окончена, — кивает Зандер. — Воспользуйся этим ключом на самой левой двери Литейной, и Построитель снов откроется для тебя. Теперь я должен уйти... у меня есть работа, нуждающаяся в моем внимании».~
@6693 = ~«Перо? Вся эта работа ради пера?»~
@6694 = ~~
@6695 = ~«Спасибо, Зандер. Прощай».~
@6696 = ~Сквозь щелочки своих глаз ты видишь, как Зандер секунду концентрируется и держит свою руку в воздухе над твоей. Ничего не происходит. Зандер открывает глаза, смотрит на твою пустую ладонь, и взрывается: «Я же сказал тебе закрыть глаза, пень! Это не игра! Ты думаешь, мне нравится тратить свое время на твои глупые уловки? Думаешь, мне хочется чувствовать твои сомнения в моей работе? Закрывай глаза, пень, и не держи их закрытыми, иначе ключа ты не получишь!»~
@6697 = ~«Давай мне ключ, старик. Сейчас же».~
@6698 = ~Сделать, как он говорит.~
@6699 = ~«Забудь. У меня есть дела получше, чем выслушивать весь этот бред». Уйти.~
@6700 = ~«Это последняя мера предосторожности в построителе снов, приятель. Ты чего же, думаешь, мне тут охота вальсировать перед тобой? Я-то пока из ума не выжил. Ты хочешь чего-то другого, или мне возвратиться к работе?»~
@6701 = ~~
@6702 = ~«Возвращайся к работе».~
@6703 = ~«Возвращайся к работе, и прими мою благодарность».~
@6704 = ~Он краснеет, наполняясь потоком брани. Затем он выдыхает, и говорит тоном сдерживаемой ярости: «Пень, ключ хранится в вере. Или ты доверишься мне и закроешь глаза, или не будешь этого делать, и так никогда и не найдешь свои сны. Выбирай. Приятель».~
@6705 = ~Сделать, как он говорит.~
@6706 = ~«Забудь. У меня есть дела получше, чем выслушивать весь этот бред».~
@6707 = ~«Мне нужен от тебя еще один предмет, после чего мы сможем начать финальную стадию Построителя снов. Мне нужна подушка, лежащая в гробу: она стимулирует столь глубокий сон, что с таким же успехом ты мог бы умереть. Она открывает твой разум излучениям Построителя снов. Это, если можно так сказать, капля вдохновения с моей стороны».~
@6708 = ~«Э, подушка из гроба? Ты ее получишь. Но сперва ответь мне еще на пару вопросов».~
@6709 = ~«Не думаю, что я действительно хочу продолжать носить тебе эти вещи».~
@6710 = ~«У меня есть эта подушка. Давай продолжим».~
@6711 = ~«Я достану ее».~
@6712 = ~«Значит, не хочешь? Тогда тебе, вероятно, следует вспомнить, что ты собираешь эти предметы для вещи, в которую ТЫ вложил деньги, для проекта, который был нужен в первую очередь ТЕБЕ, для устройства столь непрактичного, что на него потратили свою жизнь четырех поколений в моей семье, и все ради ТЕБЯ. Если ты хочешь увидеть окончание этого проекта, ты завершишь последние стадии и прекратишь свое бесконечное нытье».~
@6713 = ~«Старик, не говори со мной таким тоном, или это будут последние слова, которые ты произнесешь».~
@6714 = ~«Ладно-ладно. Я это сделаю. Только перестань на меня орать».~
@6715 = ~«Ты собираешься загубить столько потраченного времени и усилий? Ты упустишь свои сны из-за того, что не любишь, когда кто-нибудь называет тебя тупым? Что ж, ты и есть тупица, раз думаешь, что сможешь закончить этот проект без моих знаний. И ты даже больше чем тупица, раз считаешь, что за дерзость можно приговаривать к смерти. Ты действительно думаешь, что сможешь решить свои проблемы, угрожая каждому, кто встретится тебе на пути? Планы ведь не так работают, мой ошрамованный друг».~
@6716 = ~«Я убивал и за меньшее».~
@6717 = ~«А теперь я уйду. Пока я не совершил ошибку, о которой мы все будем сожалеть».~
@6718 = ~«Забей, ублюдок. Ты никогда не вернешь свои сны. Твоего драгоценного Построителя снов больше нет».~
@6719 = ~Готово.~
@6720 = ~«Уж в этом я не сомневаюсь, безмозглая ты сволочь. Твоя идиотская поза крутого вояки — это последняя капля. Можешь катиться прямиком в Бездну вместе со своим Построителем снов». Кажется, он готов позвать стражу.~
@6721 = ~Свернуть ему шею до того, как он не позвал на помощь.~
@6722 = ~Свернуть ему шею до того, как он не позвал на помощь.~
@6723 = ~Сбежать.~
@6724 = ~Твои руки расплываются, когда ты обхватываешь ими шею старого инженера. Ты ломаешь ее как прутик, и он умирает с выпученными глазами у твоих ног. Уж ты ему показал. К несчастью, тебя также видели все присутствующие в Зале. Подняли тревогу.~
@6725 = ~«Тогда ладно».~
@6726 = ~Он ловко уворачивается от твоих вытянутых рук и зовет стражу.~
@6727 = ~«Проклятье».~
@6728 = ~«Машине необходима птичья клетка хорошей работы, украшенная лезвиями, чтобы изобразить разрушающую силу снов, и их способность захватывать наши сердца и воображение. Поищи такую клетку в Осадной башне».~
@6729 = ~«Как мне туда добраться?»~
@6730 = ~Задав дабусу несколько вопросов, ты пытаешься определить значение ребусов, появляющихся над его головой. Он очень терпеливо относится к подобной «дискуссии», предоставляя тебе простые для перевода образы. Спустя несколько минут ты начинаешь понимать его... кажется, ты уже делал нечто подобное раньше.~
@6731 = ~Задав дабусу несколько вопросов, ты пытаешься определить значение ребусов, появляющихся над его головой. Хотя он очень терпеливо относится к подобной «дискуссии», ты не можешь его понять. В конце концов дабус перестает показывать символы и замирает в ожидании.~
@6732 = ~Дабус делает небольшой поклон. Символы вихрем кружатся над его головой, затем он отстраняется.~
@6733 = ~Над головой дабуса появляется серия символов. Затем он кланяется и отворачивается.~
@6734 = ~Дабус ждет.~
@6735 = ~Дабус слегка кивает, и над его головой возникает поток символов. Кажется, он говорит, что он — дабус.~
@6736 = ~Над головой дабуса появляется кучка символов. Кажется, он говорит, что он выполняет свою обязанность... или обязанности.~
@6737 = ~Дабус слегка кивает, и над его головой возникает поток символов. (Я — дабус.)~
@6738 = ~Над головой дабуса появляется кучка символов: (Я выполняю свои обязанности.)~
@6739 = ~Дабус слегка кивает, и над его головой возникает поток символов.~
@6740 = ~Над головой дабуса появляется кучка символов.~
@6741 = ~Дабус слегка кивает, и над его головой возникает поток символов. Кажется, он говорит, что он — дабус.~
@6742 = ~Над головой дабуса появляется кучка символов. Кажется, он говорит, что он выполняет свою обязанность... или обязанности.~
@6743 = ~Дабус слегка кивает, и над его головой возникает поток символов. (Я — дабус.)~
@6744 = ~Над головой дабуса появляется кучка символов: (Я выполняю свои обязанности.)~
@6745 = ~Над головой дабуса возникает единственный символ. Это женская металлическая маска, окруженная торчащими клинками. От одного вида этого призрачного изображения тебе становится неуютно.~
@6746 = ~Над головой дабуса возникает единственный символ. Это белый овал, разделенный черной молнией. Дабус показывает символ несколько секунд, затем отворачивается, перестав обращать на тебя внимание.~
@6747 = ~Перед тобой дабус. Он одет в длинное развевающееся одеяние и слегка парит над землей.~
@6748 = ~Он поворачивается к тебе, и над его головой появляется несколько символов. Они окружены слабым сиянием и... парят в воздухе.~
@6749 = ~«Даже не знаю, хочу ли я принести тебе эти предметы».~
@6750 = ~«Все у меня с собой. А теперь давай мне мои сны».~
@6751 = ~«Ты доказал свою находчивость. Придумай что-нибудь».~
@6752 = ~«Ладно. Тогда ответь мне на несколько вопросов».~
@6753 = ~«Конечно. Еще увидимся».~
@6754 = ~«Все, что мне нужно, чтобы начать последнюю стадию подготовки Построителя снов, — кусочек твоей кожи, погруженный в твою кровь, чтобы машина смогла познакомится с твоей физической сущностью. Все это должно быть в сине-зеленом флаконе, чтобы изобразить море снов, в котором ты будешь плавать».~
@6755 = ~«У меня есть все это. Держи. Покажи мне мои сны».~
@6756 = ~«Даже не знаю, хочу ли я принести тебе это».~
@6757 = ~«Хм, плоть и кровь? В последнее время я отдал достаточно и того, и другого. Сперва ответь мне на вопрос».~
@6758 = ~«Просто ответь мне на пару вопросов, ладно? Твой Построитель меня не интересует».~
@6759 = ~«Плоть, кровь, бутылек. Ладно. Я вернусь».~
@6760 = ~Зандер выглядит так, словно ты ударил его в живот... со всего размаху. «Не интересует? Но... этим занимались четыре поколения моей семьи... мой прадед говорил, что ты казался таким встревоженным... у него был этот свиток...»~
@6761 = ~«Твой прадед? Как? Расскажи, что ты обо мне знаешь».~
@6762 = ~«Нет. Мне это неинтересно. Просто ответь на несколько вопросов».~
@6763 = ~«Ты пришел к моему прадеду Зено и сказал ему, что не можешь видеть сны. Ты сказал, что желаешь вернуть их. Ты предложил ему огромную сумму за то, чтобы он создал машину, которая вернет потерянные тобой сны. Ты сказал, что вернешься через пару лет, чтобы поговорить с ним снова, но так и не сделал этого».

Ты чувствуешь, как к тебе возвращаются воспоминания.~
@6764 = ~Подавить их.~
@6765 = ~Принять их.~
@6766 = ~Принять их.~
@6767 = ~Силой воли ты удерживаешь воспоминания, чтобы они не заполнили твою голову.

«Работа над машиной продолжилась после смерти Зено. Моя бабушка Нула перевела исследования в более эзотерическое русло, используя травы и мозаичные камни для создания магических узоров, которые должны были призвать частицы сна из Астрального и Эфирного планов. Мой дядя продвинулся вперед еще на один шаг, получив одновременно демоническую и небесную помощь в создании этого устройства. Что касается меня... я создал ритуалы, которые раскроют ее потенциал... и тогда ты сможешь получить назад свои сны».~
@6768 = ~«Ладно. Ты меня убедил. Что я должен сделать, чтобы вернуть свои сны?»~
@6769 = ~«Это не то, что мне нужно в данный момент. Просто ответь еще на пару вопросов».~
@6770 = ~«Интересно. Пожалуй, я еще поговорю с тобой об этом. Счастливо».~
@6771 = ~«Она заправляет городом. Ты узнаешь ее, когда увидишь: у нее вокруг лица клинки, она ростом с гиганта и парит над землей, совсем как эти парни». Морт кивает на дабуса, смотрящего на вас обоих. «Про нее никто почти ничего не знает... она не очень говорлива. Все, что тебе следует знать: не зли ее. Если увидишь ее, мой тебе совет — тикай».~
@6772 = ~Воспоминание о юном мастере Зено Зандере заглушает слова его потомка, и ты вспоминаешь дерзкого молодого мага, показывающего созданное им заклинание. «Я называю его 'Усмиритель'», — говорит он. Вы вдвоем наблюдаете за волшебными частичками, которые спокойно оседают на тебе, и ты ощущаешь в своем сердце великую умиротворенность. «Действует, — говоришь ты. — Будем надеяться, что ты так же хорошо справишься с Построителем снов».

Нил Зандер прерывает свой рассказ: «Ты меня слушаешь?»~
@6773 = ~«Что? Конечно. Можешь повторить?»~
@6774 = ~«Нет, я не слушаю. Прощай».~
@6775 = ~Он выглядит слегка раздраженным, но сдерживается. «Работа над машиной продолжилась после смерти Зено. Моя бабушка Нула перевела исследования в более эзотерическое русло, используя травы и мозаичные камни для создания магических узоров, которые должны были призвать частицы сна из Астрального и Эфирного планов. Мой дядя продвинулся вперед еще на один шаг, получив одновременно демоническую и небесную помощь в создании этого устройства. Что касается меня... я создал ритуалы, которые раскроют ее потенциал... и тогда ты сможешь получить назад свои сны».~
@6776 = ~«Ладно. Ты меня убедил. Что я должен сделать, чтобы вернуть свои сны?»~
@6777 = ~«Это не то, что мне нужно в данный момент. Просто ответь еще на пару вопросов».~
@6778 = ~«Интересно. Пожалуй, я еще поговорю с тобой об этом. Счастливо».~
@6779 = ~Маленькая морщинка сосредоточенности прорезает его морщинистый лоб. «Что ты хочешь знать?»~
@6780 = ~«Ранее ты упоминал о Построителе снов. Расскажи мне о нем побольше».~
@6781 = ~«Расскажи мне, что ты знаешь об убийстве кузнеца».~
@6782 = ~«Меня попросили починить тот механизм в Литейной. Ты можешь сказать мне, как это сделать?»~
@6783 = ~Когда он тянется за монетами, ты пытаешься схватить его за руку. Он быстро одергивает руку назад, торжественно хохоча: «За это ты заплатишь в два раза больше, мерзавец! Вон с глаз моих!» Он отворачивается от тебя.~
@6784 = ~Морт усмехается. «Да я скорее пройду через кишки танарри, чем разгадаю, что эти козлиные морды пытаются сказать. Нужен переводчик? Поищи коренного сигильца».~
@6785 = ~«Кто ты?»~
@6786 = ~«Ха, да *есть* у них имена. Я уверен в этом».~
@6787 = ~«Что ты можешь рассказать о боголюдях?»~
@6788 = ~«Расскажи мне о своих коллегах».~
@6789 = ~«Чем ты здесь занимаешься?»~
@6790 = ~«Вот *ты* и скажи, бесовка».~
@6791 = ~«Это одновременно и машина, и ритуал. Это состояние души и конструкция из пара и крови. Тому, кто входит в нее, она дарует сны. Она была построена для тебя, и она ждет тебя. Ты готов завершить ее? Она ждала тебя десятки лет».~
@6792 = ~«Откуда ты знаешь, что его построили для меня?»~
@6793 = ~«Да».~
@6794 = ~Морт усмехается. «Да я скорее пройду через кишки танарри, чем разгадаю, что эти летающие козлиные морды пытаются сказать. Нужен переводчик? Попроси нашу маленькую бесовку, — он кивает на Анну. — Она из Улья».~
@6795 = ~«Нет. Может, вернусь к этому позже. Ответь еще на несколько вопросов».~
@6796 = ~«Нет. Прощай».~
@6797 = ~Морт усмехается. «Да я скорее пройду через кишки танарри, чем разгадаю, что эти летающие козлиные морды пытаются сказать. Нужен переводчик? — он кивает на Даккона. — Попроси нашего ханжу-молчуна перевести».~
@6798 = ~«Потому что мой прадед, Зено Зандер, высек твое лицо на камне, чтобы мы узнали тебя, когда ты вернешься за заказом. Он всегда думал, что ты вернешься, но никто другой по-настоящему не верил в это. Моя семья завершила его, потому что мы дали слово... и вот ты здесь».~
@6799 = ~«У тебя еще есть этот камень?»~
@6800 = ~Морт усмехается. «Да я скорее пройду через кишки танарри, чем разгадаю, что эти летающие козлиные морды пытаются сказать. Нужен переводчик? Попроси танарри, — он кивает на Падшую Грацию. — Наверное, она все время общалась с этими парнями».~
@6801 = ~«Тогда у меня должна была быть на то причина. Давай же завершим его».~
@6802 = ~«Мне это неинтересно. Ответь мне на другой вопрос».~
@6803 = ~«Нет. Год назад он был у меня украден. Я заметил лишь убегающую тень. Это была единственная вещь, которую забрали из моего дома. Не представляю, кто его забрал, но черты лица на нем я запомнил».~
@6804 = ~«Ладно. Давай завершим Построитель снов».~
@6805 = ~«В данный момент меня это не интересует. И все же я хотел бы задать еще несколько вопросов».~
@6806 = ~«В данный момент Построитель снов меня не интересует. Может, позже. Прощай».~
@6807 = ~«Э-э... — Анна странно смотрит на тебя. — Это ж дабус».~
@6808 = ~«Сходи поговори с Бедай-Линн. Она должна знать. Она обеспокоена банальностями этого места. Она ненастоящий мечтатель. Она уделяет внимание тому, что движет этим местом. Она не создает».~
@6809 = ~«Ладно, так и сделаю. У меня есть еще несколько вопросов...»~
@6810 = ~«Ладно, я займусь этим сейчас же».~
@6811 = ~Анна переходит на шепот. «Дабусы — *Ее* народец. Они смотрят за городом, чинят его, сносят и строят заново. Они болтают ребусами, которые висят в воздухе — тебе придется в них разобраться, чтоб понять, о чем они трещат, — Анна выглядит раздраженной. — От них башка раскалывается».~
@6812 = ~«Мне ничего не известно. Я работал здесь над своей конструкцией и сосредоточился на работе. Я не обращал внимания на то, чем занимаются рабочие: они делают свою работу, а я — свою».~
@6813 = ~«Леди Боли». Анна делает полукруг в воздухе перед собой. «Они на нее батрачат, а она их защищает. Не надо им гадить, а то можно и на ее взгляд нарваться».~
@6814 = ~«Ш-ш-ш! — Анна проводит пальцем поперек горла. — Не стоит трясти о ней черепушкой. У нее уши *повсюду*, так-то. Так что не надо упоминать ее имя, лады?»~
@6815 = ~Она молчит секунду. «Ага... могу».~
@6816 = ~«Понятно... Что ж, ответь еще на несколько вопросов».~
@6817 = ~«Понятно. Прощай».~
@6818 = ~Анна мотает головой. «Ну уж нет, не собираюсь я с тобой за компанию попасть в тень Леди, ни за что. Давай не задерживаться, а? От болтовни с ее народцем ничего толкового не выйдет, только на Ее взгляд нарвемся».~
@6819 = ~«Я — Нил Зандер, правнук мастера Зено Зандера, инженера, мечтателя, творца. И я завершил его работу — ту самую, которую заказал ты, — Построитель снов! Готов ли ты теперь заявить о своих правах на него?»~
@6820 = ~«Построитель снов? Что это такое?»~
@6821 = ~«Нет. У меня есть другие вопросы к тебе».~
@6822 = ~Анна кивает. Дабус продолжает пялиться на вас обоих, держа свои руки в рукавах.~
@6823 = ~«Нет. У меня есть другие вопросы к тебе».~
@6824 = ~«Нет».~
@6825 = ~«Он просто сказал, что он из дабусов, — она пожимает плечами. — У них нет имен».~
@6826 = ~«Он просто сказал, что он из дабусов, — она пожимает плечами. — У них нет имен».~
@6827 = ~«Бррр. В них нет настоящего огня. Они говорят о созидании, хвастаются своими возможностями, но не создают ничего необычного. У них бедное, ограниченное, поглощенное деталями воображение. Истинный мечтатель, как я считаю, создает общий проект, и потом уже сосредотачивается на деталях. Начинать с деталей — это удел муравьев... мелких насекомых, которые озабочены только пропитанием».~
@6828 = ~«Ну, этот не назвался, *так* ведь, череп?!»~
@6829 = ~«Как мило с твоей стороны. Ответь мне еще на несколько вопросов, если ты не против».~
@6830 = ~«Понятно... Ну, раз так, тогда я должен идти. Счастливо».~
@6831 = ~Он вздыхает и собирается с мыслями. «Это обширная тема. Начнем сначала. Итак, все существа чего-то хотят, не так ли? Они творят, строят, разрушают, дерутся, любят... они делают все это, потому что хотят чего-то, чего у них нет. Даже на самом примитивном уровне мироздания каждая частичка стремится к чему-то большему. Некоторые достигают этого. Некоторые терпят неудачу».~
@6832 = ~«Продолжай».~
@6833 = ~«Забудь. Лучше я задам тебе пару других вопросов».~
@6834 = ~«С другой стороны, забудь об этом. Счастливо».~
@6835 = ~Она пожимает плечами. «Говорит, что делает свою работу. Ну, знаешь, смотрит за городом и все такое».~
@6836 = ~«Фрактор Кельдор вон там, на помосте. Поговори с ним. Или найди того пня-самоубийцу Сандоза и потолкуй с ним. Ты уже закончил мне докучать?»~
@6837 = ~«Еще нет».~
@6838 = ~«Да. Прощай».~
@6839 = ~Ты видишь лохматого мужчину, одетого по последней моде — если считать, что эта мода умерла полвека назад. Похоже, что его одежда состоит из тряпья уличного оборванца, и он держится высокомерно по отношению к окружающим — или, может, высокомерие действительно ему присуще. Он даже не смотрит в твою сторону, пока ты не обращаешься к нему, после чего он начинает внимательно рассматривать твое лицо. «Ты чего-то хотел?»~
@6840 = ~Анна мотает головой. «Ну уж нет, не собираюсь я с тобой за компанию попасть в тень Леди, ни за что. Если будешь трещать о ней с ее народцем — привлечешь взгляд Леди».~
@6841 = ~«Расскажи мне, что ты знаешь об убийстве кузнеца».~
@6842 = ~«Меня попросили починить тот механизм в Литейной. Ты можешь сказать мне, как это сделать?»~
@6843 = ~«Меня попросили починить тот механизм в Литейной. Ты можешь сказать мне, как это сделать?»~
@6844 = ~«Тогда прощай...» ~
@6845 = ~Она мотает головой. «Не-а, не хочу».~
@6846 = ~«Кто ты?»~
@6847 = ~«Что ты можешь рассказать о боголюдях?»~
@6848 = ~Анна скрещивает руки, ее хвост начинает хлестать вперед-назад.~
@6849 = ~«Расскажи мне о своих коллегах».~
@6850 = ~«Чем ты здесь занимаешься?»~
@6851 = ~«Не-а, я не буду спрашивать у него про Фелла, нет уж. У него с Ней вражда, так что лучше не поминать такие вещи».~
@6852 = ~Он взрывается: «Я могу лишь держаться от нее подальше! Бессмертие — одно из величайших проклятий человеческого воображения: каждый пень думает, что желает его, но никто не подозревает, что он получит. Это дурацкий дар, и только дурак его примет! — он продолжает более спокойным тоном. — И, кроме того, я до сих пор не нашел способа, как сделать кого-то бессмертным с помощью моих машин».~
@6853 = ~«Понятно. Тогда ответь мне еще на несколько вопросов».~
@6854 = ~«Ясно. Вот только это мне не поможет. Прощай».~
@6855 = ~Даккон кивает.~
@6856 = ~«Он говорит, что он — дабус».~
@6857 = ~«Он говорит, что выполняет свои обязанности».~
@6858 = ~Падшая Грация кивает. «Да, конечно».~
@6859 = ~«Он говорит, что он — 'дабус', — Грация замолкает. — Я редко встречала дабусов, у которых вообще было имя... по крайней мере, хоть что-либо, что можно принять за имя. Похоже, они предпочитают использовать символы».~
@6860 = ~«Он говорит, что выполняет свои обязанности, — она поворачивается к тебе. — Они тратят большую часть времени на ремонт и снос частей города. В каком-то смысле они являются хранителями города».~
@6861 = ~«Думаю, что не стоит надеяться на более точный ответ».~
@6862 = ~Грация хмурится. «Не уверена, что будет благоразумно задавать этот вопрос. Он может оскорбить дабуса, ведь Фелл больше не является членом их сообщества...»~
@6863 = ~Оставить существо в покое.~
@6864 = ~Попробовать наладить общение. Возможно, тебе удастся перевести то, что говорит дабус.~
@6865 = ~«Она у меня с собой. Дай мне мои сны».~
@6866 = ~«Клетка. Как прозаично. Ладно. Сперва ответь мне на пару вопросов».~
@6867 = ~Попробовать наладить общение. Возможно, тебе удастся перевести то, что говорит дабус.~
@6868 = ~«Клетка с лезвиями. Я вернусь».~
@6869 = ~Попробовать поговорить с ним. Возможно, ты сможешь его понять.~
@6870 = ~«У меня есть вопросы...»~
@6871 = ~«Морт, ты можешь перевести мне то, что он говорит?»~
@6872 = ~«Морт, ты можешь перевести мне то, что он говорит?»~
@6873 = ~«Морт, ты можешь перевести мне то, что он говорит?»~
@6874 = ~«Морт, ты можешь перевести мне то, что он говорит?»~
