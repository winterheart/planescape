@24255 = ~«Что он сказал, Анна?»~
@24256 = ~«Что он сказал, Даккон?»~
@24257 = ~«Что он сказал, Грация?»~
@24258 = ~«Что он сказал, Анна?»~
@24259 = ~«Что он сказал, Даккон?»~
@24260 = ~«Что он сказал, Грация?»~
@24261 = ~«Почему?»~
@24262 = ~«Понятно. У меня есть к тебе другой вопрос, Фелл».~
@24263 = ~«Тогда неважно. Может быть, я еще вернусь... когда найду переводчика получше. Прощай».~
@24264 = ~«Что он сказал, Анна?»~
@24265 = ~«Что он сказал, Даккон?»~
@24266 = ~«Что он сказал, Грация?»~
@24267 = ~«Почему?»~
@24268 = ~«Возможно, ты сможешь ответить еще на один вопрос...»~
@24269 = ~«Тогда мне больше нечего сказать. Прощай».~
@24270 = ~Фелл сказал, что знал меня, однако не может рассказать всю мою «историю». Самое странное в этом — причина. Он сказал, что не может рассказать, потому что «он не может изменить сущность человека».~
@24271 = ~«Что он сказал, Анна?»~
@24272 = ~«Что он сказал, Даккон?»~
@24273 = ~«Что он сказал, Грация?»~
@24274 = ~Фелл перевел мне руну на моей старой руке... он сказал, что в ней говорится о четырех, кто раньше шли вместе со мной. Эти четверо — «нелюбимый, любящий того, кто не любит», «невидящий то, что видят другие, и видящий то, чего другие не видят», «фамильяр, связанный обязательствами», «раб, чьи цепи — слова». Он сказал, что все они страдали от мучений, как и я, и что мои муки притягивают притягивают таких же мучеников.~
