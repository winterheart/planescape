@33701 = ~«Куда ведут юго-западные ворота?»~
@33702 = ~«Это все, что я хотел узнать. Прощай».~
@33703 = ~«Где находится Ночлежка?»~
@33704 = ~«Куда ведут северные ворота?»~
@33705 = ~«Куда ведут восточные ворота?»~
@33706 = ~«Это все, что я хотел узнать. Прощай».~
@33707 = ~К тебе подбегает улыбчивая женщина средних лет и делает реверанс. «Привет, сэр, какая приятная встреча! Всего лишь за один медяк я могу предложить вам себя в качестве осведомителя. Могу ли я вам чем-то помочь?»~
@33708 = ~Улыбчивая женщина средних лет, едва завидев тебя, весело машет рукой. «Приветствую вас, сэр! Всего лишь за один медяк я могу предложить вам себя в качестве осведомителя. Могу ли я вам чем-то помочь?»~
@33709 = ~Женщина скептически смотрит на тебя, затем пожимает плечами. «Осведомитель — это что-то вроде проводника, сэр. Я могу помочь вам сориентироваться в этой части Улья».~
@33710 = ~Женщина забирает монету и делает реверанс. «В этой части Улья есть ворота, ведущие на запад и на юг; среди здешних примечательных мест можно отметить Морг, Бар собирателей пыли, мемориал тленных и мавзолей. Также здесь много опасных преступников».~
@33711 = ~«Морг — это громадный куполообразный комплекс в северо-восточной части этого района. Тленные не пустят вас внутрь, по крайней мере, если у вас нет с ними никакого дела. Или если вы не умерли». Она улыбается тебе.~
@33712 = ~«Это в юго-западной части этого района... куполообразное строение, вход расположен с юго-восточной стороны. Бар собирателей пыли — одна из самых тихих и безопасных таверн в Улье».~
@33713 = ~«Прямо в центре северной части этого района... что-то типа огороженного дворика с открытой аркой с каждой стороны. Обычно рядом с юго-восточным входом расположена группа тленных-плакальщиков».~
@33714 = ~«Мавзолей расположен в северо-западной части этого района. Большое квадратное строение в виде башни».~
@33715 = ~«В другую часть Улья, сэр. Если вы устали и хотите отдохнуть, то там находится ночлежка».~
@33716 = ~«В еще одну часть Улья, сэр. Там находится тату-салон и бар 'Тлеющий труп'. И, конечно же, куча преступников... там есть целый дом, забитый ими».~
@33717 = ~«Что за осведомитель?»~
@33718 = ~«Конечно... вот медяк».~
@33719 = ~«Больше ничего. Прощай».~
