@8290 = ~Слушать их пение.~
@8291 = ~Уйти.~
@8292 = ~Уйти.~
@8293 = ~«Кто умер?»~
@8294 = ~«Я считал, что вы, тленные, выше оплакивания и эмоций».~
@8295 = ~«Кого именно вы оплакиваете?»~
@8296 = ~«Кого именно вы оплакиваете?»~
@8297 = ~«Кого именно вы оплакиваете?»~
@8298 = ~«Кого именно вы оплакиваете?»~
@8299 = ~«Кого именно вы оплакиваете?»~
@8300 = ~«Кого именно вы оплакиваете?»~
@8301 = ~«Это все, что я желал узнать. Прощай».~
@8302 = ~«Живых?»~
@8303 = ~«Кого именно вы оплакиваете?»~
@8304 = ~«Кого именно вы оплакиваете?»~
@8305 = ~«Кого именно вы оплакиваете?»~
