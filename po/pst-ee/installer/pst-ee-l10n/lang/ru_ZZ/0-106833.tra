@8307 = ~«Кого именно вы оплакиваете?»~
@8308 = ~«Кого именно вы оплакиваете?»~
@8309 = ~«Понятно... У меня еще вопросы...» ~
@8310 = ~«Думаю, я выслушал достаточно. Прощай».~
@8311 = ~«Зачем?»~
@8312 = ~«Кого именно вы оплакиваете?»~
@8313 = ~«Кого именно вы оплакиваете?»~
