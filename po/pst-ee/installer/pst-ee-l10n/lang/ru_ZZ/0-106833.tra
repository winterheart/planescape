@278 = ~Неуклюжий труп смотрит на тебя пустым взглядом. На его лбу вырезан номер, а его губы крепко зашиты. От тела исходит легкий запах формальдегида.~
@279 = ~~
@280 = ~[Неуклюжий труп смотрит на тебя пустым взглядом. На его лбу вырезан номер, а его губы крепко зашиты. От тела исходит легкий запах формальдегида.]~
@281 = ~«Итак... что тут у нас интересного?»~
@282 = ~«Итак... что тут у нас интересного?»~
@283 = ~Труп не шевелится. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@284 = ~Труп продолжает пялиться на тебя.~
@285 = ~Оставить труп в покое.~
@286 = ~Скелет поворачивается к тебе лицом. На лбу у него высечено число, множество костей, преимущественно челюсти и суставы, было обвязано кожаными ремешками. Его тело скрывает черный комбинезон.~
@287 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать, не похоже, что у тебя есть хоть что-то, что можно было прятать».~
@288 = ~«Извини, ты не видал скелетов, гуляющих по близости?»~
@289 = ~«Извини, ты не видал скелетов, гуляющих по близости?»~
@290 = ~Скелет не реагирует.~
@291 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@292 = ~Перед тобой возвышается огромный скелет в богато украшенных бронзовых доспехах. Доспехи прикреплены к костям скелета, а на нагруднике вырезана серия замысловатых символов. Удивительно, откуда мог взяться такой скелет; ты не можешь представить себе людей таких размеров. Огромный клинок в его руках, похоже, весит как целая повозка.~
@293 = ~«Не против, если я немного подержу клинок? Должно быть, ты устал его держать».~
@294 = ~Этот бледный мужчина одет в длинную темную мантию. От него слегка отдает плесенью. Его лицо ничего не выражает; кажется, он полностью поглощен своими обязанностями.~
@295 = ~«Приветствую».~
@296 = ~«Приветствую».~
@297 = ~Оставить его в покое.~
@298 = ~Тленная не обращает на тебя внимания. Должно быть, она спутала тебя с одним из мертвых рабочих.~
@299 = ~«Приветствую».~
@300 = ~Тленный не обращает на тебя внимания. Должно быть, он спутал тебя с одним из мертвых рабочих.~
@301 = ~«Приветствую».~
@302 = ~«Приветствую».~
@303 = ~«Кто ты?»~
@304 = ~«Что это за место?»~
@305 = ~«У меня есть пара вопросов...» ~
@306 = ~Оставить его в покое.~
@307 = ~Тленный подпрыгивает от неожиданности. Затем он поворачивает к тебе голову. Он выглядит потрясенным: должно быть, маскировка у тебя весьма неплохая.~
@308 = ~«Приветствую».~
@309 = ~Тленный отступает на шаг, затем быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@310 = ~Воспользоваться эффектом неожиданности и свернуть ему шею до того, как он сможет позвать на помощь.~
@311 = ~Огромный гехрелет~
@312 = ~«У меня есть пара вопросов...» ~
@313 = ~«Ну хорошо...»~
@314 = ~Этот бледный мужчина одет в длинную темную мантию. От него слегка отдает плесенью. Его лицо ничего не выражает; кажется, он полностью поглощен своими обязанностями.~
@315 = ~«Приветствую».~
@316 = ~«Кто ты?»~
@317 = ~«Что это за место?»~
@318 = ~«Кто ты?»~
@319 = ~«У меня есть пара вопросов...» ~
@320 = ~Оставить его в покое.~
@321 = ~Тленный медленно поднимает свою голову и оборачивается к тебе. «Ты потерялся?»~
@322 = ~«Да».~
@323 = ~«Нет».~
@324 = ~«Нет, я не потерялся. У меня есть несколько вопросов...»~
@325 = ~«Прощай».~
@326 = ~«Я позову стражу, они тебя живо выведут. Погоди минуточку».~
@327 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@328 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@329 = ~Уйти. Быстро.~
@330 = ~«Если ты не потерялся, что же ты здесь делаешь?»~
@331 = ~«Это тебя не касается».~
@332 = ~«Я очнулся на одной из плит в вашей препараторской».~
@333 = ~«Я хочу кое с кем повидаться».~
@334 = ~«Я пришел сюда на похороны, но, похоже, произошла ошибка».~
@335 = ~«Боюсь, что касается. Может, стражники развяжут твой язык». Тленный отступает на шаг; кажется, он собирается позвать стражников.~
@336 = ~«Любишь пошутить? Тогда, может, ты поделишься своими шутками со стражниками». Тленный отступает на шаг; кажется, он собирается позвать стражников.~
@337 = ~Уйти. Быстро.~
@338 = ~«Кого ты хочешь увидеть?»~
@339 = ~Уйти.~
@340 = ~«Еще не встречался с Голодными Псами? На твоем бы месте я бы с этими умалишенными не пересекался... кровавые отморозки, вот они кто!»~
@341 = ~Уйти.~
@342 = ~«Я хочу повидаться с Дхоллом».~
@343 = ~«Я хочу повидаться с Дхоллом».~
@344 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@345 = ~«Дхолла можно найти в приемной комнате на этом этаже. Должен предупредить... Дхолл очень занят, а здоровье у него подкошено. Если у тебя к нему несрочное дело, то лучше не беспокоить его».~
@346 = ~«Скорее всего, Дхолл в приемной комнате на втором этаже. Он очень занят, а здоровье у него подкошено. Если у тебя к нему несрочное дело, то лучше не беспокоить его».~
@347 = ~«Хорошо. Спасибо за информацию».~
@348 = ~«Хорошо. Спасибо за информацию».~
@349 = ~«Дейонаррой? На первом этаже в мемориальном зале похоронена женщина. Может быть, это она?»~
@350 = ~«Дейонаррой? В северо-западном мемориальном зале похоронена женщина. Может быть, это она?»~
@351 = ~«Скорее всего, Соэго находится у главных ворот на первом этаже. Он работает проводником в часы антипика».~
@352 = ~«Скорее всего. Спасибо».~
@353 = ~«Скорее всего. Спасибо».~
@354 = ~«Отлично. Спасибо».~
@355 = ~«Скорее всего, Соэго находится у главных ворот. Он работает проводником в часы антипика».~
@356 = ~«Отлично. Спасибо».~
@357 = ~«Кто был погребен? Возможно, служба проводится в другом конце Морга».~
@358 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@359 = ~«Ты не понимаешь... ошибка в том, что похоронить собирались МЕНЯ».~
@360 = ~«Может быть. Где еще проводят службу?»~
@361 = ~«Ты можешь показать выход отсюда?»~
@362 = ~«По всему периметру Морга расположены погребальные залы. Они расположены вдоль стены на первом и втором этажах. Тебе известно имя усопшего?»~
@363 = ~«Нет».~
@364 = ~«Да».~
@365 = ~«Тогда тебе стоит поговорить с одним из проводников у главных ворот. Они тебе помогут».~
@366 = ~«Отлично. Спасибо».~
@367 = ~Тленный ждет.~
@368 = ~«Это имя мне незнакомо. Справься у одного из проводников у главных ворот... они смогут сориентировать тебя лучше, чем я».~
@369 = ~«Прошу прощения... Я оговорился. Мне неизвестно имя усопшего».~
@370 = ~«Это имя — Дейонарра».~
@371 = ~Ложь: «Меня зовут... э-э, Адан».~
@372 = ~Ложь: «Меня зовут... э-э, Адан».~
@373 = ~Наклониться вперед, будто собираясь прошептать ему что-то на ухо, а затем свернуть ему шею.~
@374 = ~«Понятно. И что же ты здесь делаешь?»~
@375 = ~«Это не твое дело».~
@376 = ~«Я очнулся на одной из плит в вашей препараторской».~
@377 = ~«Я хочу кое с кем повидаться».~
@378 = ~«Я пришел сюда на похороны, но, похоже, произошла ошибка».~
@379 = ~Убежать от него.~
@380 = ~«Хорошо. Я так и сделаю. Прощай».~
@381 = ~Он медленно оборачивается, его взгляд мельком скользит по твоей одежде. «Приветствую тебя, посвященный».~
@382 = ~Оставить его в покое.~
@383 = ~«Кто ты?»~
@384 = ~«Что это за место?»~
@385 = ~Ты видишь строгого мужчину в черной мантии. Он недоверчиво смотрит на тебя.~
@386 = ~Тленный хмурится, когда ты проходишь мимо... кажется, он собирается окрикнуть тебя, но передумывает. Должно быть, твое поведение заставило его придержать свой язык.~
@387 = ~Пройти мимо.~
@388 = ~«Приветствую».~
@389 = ~«Приветствую».~
@390 = ~«Приветствую».~
@391 = ~«У меня есть пара вопросов...» ~
@392 = ~Оставить его в покое.~
@393 = ~«У меня такой же вопрос. Твое лицо мне незнакомо. Как тебя зовут?»~
@394 = ~«Это Морг...» Тленная какое-то время смотрит на тебя, как бы оценивая только что тобою сказанное. «Как, ты сказал, тебя зовут?»~
@395 = ~~
@396 = ~~
@397 = ~~
@398 = ~«Дневник? Не встречал такого».~
@399 = ~Ложь: «Меня зовут... э-э, Адан».~
@400 = ~Тленный терпеливо ждет твоего продолжения.~
@401 = ~«Можешь показать мне выход?»~
@402 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@403 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@404 = ~«Неважно. Извини за беспокойство».~
@405 = ~«Ты можешь просто выйти через главные ворота. Они на первом этаже».~
@406 = ~«У меня есть другие вопросы...»~
@407 = ~«Спасибо. Прощай».~
@408 = ~«Это имя... — тленный на секунду умолкает. — Это имя *звучит* знакомо... Кажется, я припоминаю сборщика с таким именем. Писец Дхолл может знать о нем больше».~
@409 = ~«Сборщика?»~
@410 = ~«Дхолл?»~
@411 = ~«У меня есть другие вопросы...»~
@412 = ~«Сборщики... они собирают тех, кто умер на улицах Сигила, и доставляют их в Морг... — тленный умолкает, хмуря брови. — Ты нездешний. Кто ты?»~
@413 = ~«Я недавно посвящен. Прости мое невежество».~
@414 = ~«Дхолл — один из самых уважаемых членов нашей фракции. Наверное, никто не размышлял о сущности Истинной Смерти и не заслужил ее больше, чем он. У него много знаний, которыми он может поделиться. Если ты незнаком с ним, то я советую тебе как можно раньше воспользоваться этой возможностью. Ему осталось не так долго жить в тени этого существования».~
@415 = ~«*Ему осталось не так долго жить?*»~
@416 = ~«Где я могу найти Дхолла?»~
@417 = ~«Где я могу найти Дхолла?»~
@418 = ~«У меня есть другие вопросы...»~
@419 = ~Кивок. «Дхолл болен. Он стар, даже по меркам гитцераев. Несомненно, смерть последует за болезнью, которую он подхватил. Ему повезло».~
@420 = ~«По меркам гитцераев?»~
@421 = ~«Что это еще за *гитцераи*?»~
@422 = ~«Повезло?»~
@423 = ~«Понятно. У меня еще вопросы...» ~
@424 = ~«Спасибо за уделенное время. Мне нужно идти».~
@425 = ~«Спасибо за уделенное время. Прощай».~
@426 = ~«Дхолл скорее всего находится в приемной комнате на втором этаже. Лучше не отвлекай его слишком сильно, он очень занят... то время, которое он не занят своими обязанностями, отбирает у него болезнь».~
@427 = ~«Дхолл находится в приемной комнате в северо-западной части этого этажа. Должен предупредить... Дхолл очень занят... то время, которое он не занят своими обязанностями, отбирает у него болезнь».~
@428 = ~«Дхолл болен?»~
@429 = ~«Спасибо за уделенное время. Мне нужно идти. Прощай».~
@430 = ~«Дхолл болен?»~
@431 = ~«Спасибо за уделенное время. Мне нужно идти. Прощай».~
@432 = ~«Да, гитцераи живут гораздо дольше, чем люди».~
@433 = ~«Что это еще за *гитцераи*?»~
@434 = ~~
@435 = ~«Гитцераи — это...» Тленный умолкает, затем хмурится, бросив на тебя пристальный взгляд. «Ты ведь нездешний. Кто ты?»~
@436 = ~«Я недавно посвящен. Прости мое невежество».~
@437 = ~«Как это Дхоллу повезло? От него хотят избавиться?»~
@438 = ~«О, у меня есть другие вопросы...»~
@439 = ~«Ему повезло в том, что он достигнет Истинной Смерти. Он больше не будет странствовать в тени этого существования».~
@440 = ~«Спасибо за уделенное время. Прощай».~
@441 = ~«И... это хорошо?»~
@442 = ~«Понятно. И правда, очень повезло. У меня есть другие вопросы...»~
@443 = ~«Понятно. Ну что ж, мне нужно идти. Прощай».~
@444 = ~Тленный кивает. «Да». Он хмурится, затем пристально смотрит на тебя. «Ты ведь не здешний. Кто ты?»~
@445 = ~«Я недавно посвящен. Прости мое невежество».~
@446 = ~«Я... недавно здесь. Я... пытаюсь изучить обстановку».~
@447 = ~«Ты не из наших. Кто ты? Что ты здесь делаешь? Ты из анархистов? Или шпион другой фракции? Стража! Стража!»~
@448 = ~«Проклятье!»~
@449 = ~«Тс-с! Я не смогу тебе ответить под такой крик!»~
@450 = ~Ложь: «Меня зовут... э-э, Адан».~
@451 = ~«У меня есть другие вопросы...»~
@452 = ~«Я должен идти. Прощай».~
@453 = ~Неуклюжий труп смотрит на тебя пустым взглядом. На его лбу вырезан номер «821», а его губы крепко зашиты. От тела исходит легкий запах формальдегида.~
@454 = ~«Итак... что тут у нас интересного?»~
@455 = ~«Итак... что тут у нас интересного?»~
@456 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@457 = ~Использовать на трупе свою способность «История костей».~
@458 = ~«Было приятно поболтать с тобой. Прощай».~
@459 = ~Оставить труп в покое.~
@460 = ~Довольно странно, но твоя способность не работает с этим трупом.~
@461 = ~Ткнуть его в глаз.~
@462 = ~Оставить труп в покое.~
@463 = ~После твоего тычка в глаз труп, рефлекторно закрыв руками лицо, издает нечленораздельный вопль. Он начинает что-то невнятно бормотать, сыпля проклятиями в твой адрес.~
@464 = ~«Ты не зомби! Кто ты?»~
@465 = ~«Зачем ты замаскировался под зомби?»~
@466 = ~Уйти. Быстро.~
@467 = ~Ты уже почти отвернулся, как «зомби» начинает что-то бормотать... кажется, он пытается что-то сказать, но с зашитым ртом это сделать трудно. «Фто ТЫ? Фто тее нао?»~
@468 = ~«Я ищу выход отсюда. Ты можешь мне помочь?»~
@469 = ~«Кто ты?»~
@470 = ~«Рассказывай, кто ты такой, или я позову стражу».~
@471 = ~Ты уже почти отвернулся, как зомби начинает издавать низкое протяжное ворчание: «Никоу ничео не говои пво МЕЯ. Моучи. Не говои НИФЕО твуфявым, — он прикладывает палец к губам. — Фффф». После этого он проводит пальцем по горлу. «Или ты уфнефь нафегда. ПОЯЛ мея?»~
@472 = ~Ложь: «Чего... Я искал тебя».~
@473 = ~«*Зомби*, вопросы здесь задаю я. Рассказывай, что ты здесь делаешь, или я сделаю эту маскировку настоящей».~
@474 = ~«Извини, что побеспокоил тебя... кем бы ты ни был. Прощай».~
@475 = ~«Ты пытаешься меня ЗАПУГАТЬ? Ну все... готовься к смерти».~
@476 = ~Ложь: «Я даже и *не думал* ничего говорить тленным о тебе».~
@477 = ~Правда: «Обещаю, что я ничего не скажу о тебе тленным».~
@478 = ~«Как хочешь. У тебя свои дела, у меня — свои».~
@479 = ~Зомби от неожиданности моргает при твоем обращении. «А? Фто?»~
@480 = ~«Ты не зомби! Кто ты?»~
@481 = ~«Зачем ты замаскировался под зомби?»~
@482 = ~Уйти. Быстро.~
@483 = ~«Зомби» пытается что-то сказать сквозь зашитые губы. На его лице странная смесь испуга и злобы. «Фто ТЫ? Фего тее нао?»~
@484 = ~«Я ищу выход отсюда. Ты можешь мне помочь?»~
@485 = ~«Кто ты?»~
@486 = ~«Рассказывай, кто ты такой, или я позову стражу».~
@487 = ~Ложь: «Чего... Я искал тебя».~
@488 = ~«*Зомби*, вопросы здесь задаю я. Рассказывай, что ты здесь делаешь, или я сделаю эту маскировку настоящей».~
@489 = ~«Извини, что побеспокоил тебя... кем бы ты ни был. Прощай».~
@490 = ~Кажется, зомби не расслышал тебя. Он осматривает тебя с ног до головы, затем хмурится. «Фто ты фдефь делаефь? — его глаза недоверчиво сужаются. — Фпионифь за Мертфяками?»~
@491 = ~«Нет. Я пытаюсь сбежать отсюда».~
@492 = ~«Я не шпион. Меня случайно здесь заперли. Ты поможешь мне выбраться отсюда?»~
@493 = ~Ложь: «Да, я шпионю здесь за... трухлявыми».~
@494 = ~Ложь: «Да, я шпионю здесь за... трухлявыми».~
@495 = ~«Почему бы тебе не рассказать мне, что ТЫ здесь делаешь, пока я не позвал стражу».~
@496 = ~«Почему бы тебе не рассказать мне, что ТЫ здесь делаешь, пока я не позвал стражу».~
@497 = ~Огни Элизиума~
@498 = ~ИНФЕРНАЛЬНЫЙ ШАР
Дистанция: 50 футов
Длительность: особая
Скорость: 1
Область действия: 1 существо
Спасбросок: отменяет действие

Вызывается огненно-красная сфера, ослабляющая и замедляющая врага.

Заклинатель призывает крупный магический огненный шар, который далее может быть брошен в цель с помощью обычного броска атаки заклинателя. Колдующий получает бонус +3 к попаданию для этого броска атаки. Шар причиняет 1-6 очков урона и добавляет штраф -1 к Силе и Ловкости врага на 10 секунд.~
@499 = ~ПОТОК ПРОКЛЯТИЙ
Дистанция: 50 футов
Длительность: 10 секунд за уровень
Скорость: 0
Зона действия: 1 существо (не мертвец)
Спасбросок: отменяет действие

Морт способен огорошить оппонента таким репертуаром своих оскорблений, что тот забудет о защите и начнет атаковать. Жертва, будучи разъяренной, получит штраф к шансу попадания и урону.

Это заклинание не может быть наложено на неживых созданий. Устойчивость к магии не влияет на это заклинание. Однако жертва может сделать спасбросок против заклинаний, чтобы сопротивляться эффектам. Когда жертва «раздражена», то она получает -2 к попаданию, -2 к КБ и -2 к урону на время действия Потока Проклятий.

Эту особую способность может использовать только Морт.~
@500 = ~Перед тобой труп мужчины с выбитым на черепе номером «331». Его веки и губы крепко зашиты, в горле зияет огромная дыра. От него *отвратительно* пахнет.~
@501 = ~Труп беззвучно смотрит вперед своими невидящими глазами.~
@502 = ~«Итак... что тут у нас интересного?»~
@503 = ~«Итак... что тут у нас интересного?»~
@504 = ~«Кх-кх... — зомби неуклюже подает голос, полный тревоги. — Кто здесь!? Отвечай!»~
@505 = ~«Тогда прощай». ~
@506 = ~«Захария?»~
@507 = ~«Ты меня не видишь?»~
@508 = ~Импровизация: «Это я. Ты не узнаешь мой голос?»~
@509 = ~«Я слеп, слеп в смерти, как был слеп при жизни... а теперь отвечай — кто ты?»~
@510 = ~Импровизация: «Это я. Ты не узнаешь мой голос?»~
@511 = ~«Кто ты?»~
@512 = ~«Что... ты! — зомби потрясен, но при этом обрадован. — О взор Леди... — в его голосе звучит удивление. — Разве ты не *мертв*, рубака?»~
@513 = ~«Это Морг, рубака. Ты, что, этого не знаешь?»~
@514 = ~«Что, трудновато под этой вонючей шкурой узнать старого дурака Захарию? Это я, рубака. Слава силам, а я-то думал, что больше никогда тебя не встречу... но и ты тоже изменился, если уши меня не подводят... снова сделал неправильный выбор? — из дыры в горле Захарии со свистом выходит воздух. — Ты ведь тоже мертв?»~
@515 = ~«Кто ты?»~
@516 = ~«Что ты здесь делаешь?»~
@517 = ~«Что это за место?»~
@518 = ~«Я не могу долго говорить, мне нужно идти. Прощай».~
@519 = ~«Кто ты?»~
@520 = ~«Сегодня ты не получишь ответов, труп. Прощай».~
@521 = ~«Захария?»~
@522 = ~«Сегодня ты не получишь ответов, труп. Прощай».~
@523 = ~«Как ты оказался в таком состоянии?»~
@524 = ~«Что ты можешь рассказать о Морге?»~
@525 = ~«Что ты можешь рассказать о моей предыдущей жизни?»~
@526 = ~«Что ты можешь рассказать о моих предыдущих спутниках?»~
@527 = ~«Я должен идти. Прощай».~
@528 = ~«Ага?»~
@529 = ~Он пристыженно умолкает. «Следуя за тобой нелегкой дорогой, рубака, я видел много ужасных вещей. Я начал пить и от выпивки стал полоумным. Однажды я, в стельку пьяный, продал свое тело трухлявым. Судьба решила дать мне пинка под зад, и вскоре после этого я умер».~
@530 = ~«Опознано»~
@531 = ~«У меня есть другие вопросы...»~
@532 = ~«Машина»~
@533 = ~«Место для мертвых, которое управляется Смертью... но некоторые вещи здесь не на своем месте...»~
@534 = ~«Что, например?»~
@535 = ~«Скажу тебе по секрету: здесь есть зомби, который пытается быть как зомби, но это не так. Мне все равно, зачем он это делает, но это довольно странно».~
@536 = ~«У меня есть другие вопросы к тебе...»~
@537 = ~«У меня больше нет времени на разговоры. Прощай».~
@538 = ~«Что-нибудь еще?»~
@539 = ~«Это который зомби?»~
@540 = ~«Интересно. У меня есть другие вопросы...»~
@541 = ~«Еще кое-что: тот старый гитцерай... который работает в препараторской... Дхолл. Он спасал тебя от кремации много-много раз. Тебе повезло, что у тебя есть такой друг».~
@542 = ~«А что именно делал Дхолл, чтобы спасти меня?»~
@543 = ~«Я знаю. У меня есть другие вопросы...»~
@544 = ~«У меня больше нет времени на разговоры. Прощай».~
@545 = ~«Я выслушал достаточно. Прощай».~
@546 = ~«У меня больше нет времени на разговоры. Прощай».~
@547 = ~«Даже если бы мои глаза видели, их номера для меня ничего не значат. Но узнать можно вот как, рубака: его голос звучит неправильно, не как у зомби... он отвечает не так, как все остальные».~
@548 = ~«Что еще странного в Морге ты заметил?»~
@549 = ~«Пойду-ка, поищу этого зомби. Прощай».~
@550 = ~«Он просто откладывал твою кремацию до тех пор, пока ты не очухивался и не слезал с плиты. Вот только непонятно, почему».~
@551 = ~«Часы»~
@552 = ~«Интересно. У меня есть другие вопросы...»~
@553 = ~«Мне нужно идти. Прощай».~
@554 = ~«Хм-м-м. Интересно. У меня есть другие вопросы...»~
@555 = ~«Он считал, что это необходимо предотвратить... ради... ради... я не помню точно, почему это было необходимо».~
@556 = ~«Понятно. Интересно, *почему* это было необходимо. Надо поговорить об этом с Дхоллом... Прощай».~
@557 = ~«Хм-м-м. Странно... У меня есть несколько вопросов...»~
@558 = ~Он пристыженно умолкает. «Когда мы разошлись путями, рубака, жить мне оставалось недолго. Следуя за тобой нелегкой дорогой, рубака, я видел много ужасных вещей. Я начал пить и стал от выпивки полоумным. Однажды я, в стельку пьяный, продал свое тело трухлявым. Судьба решила дать мне пинка под зад, и вскоре после этого я умер».~
@559 = ~«У меня есть другие вопросы...»~
@560 = ~«Мне нужно идти. Прощай».~
@561 = ~«Зачем? Ты забыл, кто ты?»~
@562 = ~«Образно выражаясь... да».~
@563 = ~«Нет... Просто я хочу узнать, был ли ты тем, за кого себя выдаешь».~
@564 = ~«Неважно. У меня есть другие вопросы...»~
@565 = ~«Мне нужно идти. Прощай».~
@566 = ~«Ну... ты всегда был странным типом, вечно подозрительным и следящим за чем-то... Наверное, у такого, как ты, при жизни было много врагов. И любой, кто переходил тебе дорогу, без исключений попадал в черные главы книги мертвых».~
@567 = ~«А еще ты мог быть чертовски жестоким... например, заставил меня подписать тот контракт, или оставил ту вечно хныкающую крошку на Авернусе. Временами ты был похуже балора. Никто даже и думать не мог от том, чтобы сбежать от тебя, сынок».~
@568 = ~«Ты был все равно что военачальник, который захватывал на войне территории; для тебя все было битвой, ты был самой безжалостной сволочью из всех, что я встречал. Для решения проблемы шло все без исключения. Рыдания и мольбы бедной Дейонарры не останавливали тебя, гит предостерегал тебя насчет твоих действий, а бедный Захария только и пытался держаться на ногах, пока мы бродили по планам. Ты был настолько крут, что казался бессмертным, но ведь мы были простыми людьми. Теперь мы все, наверное, в книге мертвых... или, так сказать, в ней и вне ее». ~
@569 = ~«Что-нибудь еще? Что-нибудь особенное...»~
@570 = ~«У меня есть другие вопросы...»~
@571 = ~«Я должен идти. Прощай».~
@572 = ~«Ясно... Что-нибудь еще? Это может мне очень помочь».~
@573 = ~«Неважно. У меня есть другие вопросы...»~
@574 = ~«Я должен идти. Прощай».~
@575 = ~«Построитель снов»~
@576 = ~«Дейонарра?»~
@577 = ~«'Гит'? Кого ты имеешь в виду?»~
@578 = ~«У меня есть другие вопросы...»~
@579 = ~«Понятно... Я должен идти. Прощай, Захария».~
@580 = ~«Ну что я могу сказать, чтобы доказать свою правоту... не все можно вспомнить... Как насчет этого: помнишь, как мы проделывали путь сквозь Авернус и наткнулись на кучку абишаев в личиночной яме?»~
@581 = ~Ложь: «Да».~
@582 = ~«Нет».~
@583 = ~«Что ж, я рад, что хоть кто-то из нас двоих помнит об этом, потому что я, клянусь балором, не помню. Кто ты такой, рубака, и что ты надеешься выловить в обрывках воспоминаний мертвецов?»~
@584 = ~«Я надеюсь найти себя. На самом деле, я забыл, кто я, Захария, и думаю, что ты знаешь меня. Что ты можешь рассказать о моей предыдущей жизни?»~
@585 = ~Тленный-привратник~
@586 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@587 = ~«Ничего... Мне нужно идти. Прощай, Захария».~
@588 = ~«Хм-м-м. Что ж, такого события и я не припомню. А как насчет этого: помнишь, как Дейонарра прописала себя в книгу мертвых, пытаясь не пустить тебя в Проклятый?»~
@589 = ~«Мы были пестрой компанией... Полумертвый парень, который не может прописать себя в книгу мертвых, как бы он ни старался. Да еще и такой страшный, что никто из сил смерти не решается его забрать. Причитающая дочка адвоката, гит-изгой, болтающий без передыху череп с подвешенным языком и полоумный слепой лучник, то есть я».~
@590 = ~«Нет, не помню... ну да ничего. Кажется, что ты меня знаешь. Что ты можешь рассказать о моей предыдущей жизни?»~
@591 = ~«Неважно... У меня есть другие вопросы».~
@592 = ~«Я должен идти. Прощай, Захария».~
@593 = ~«Гит?»~
@594 = ~«'Причитающая дочка адвоката'?»~
@595 = ~«Летающий череп?»~
@596 = ~«Ты был слепым лучником?»~
@597 = ~«Ты не знаешь, что случилось с моим дневником?»~
@598 = ~«Неважно. У меня есть другие вопросы...»~
@599 = ~«Это хорошо. Прощай, Захария».~
@600 = ~«Мрачноватый гит... молчаливый и недружелюбный, как все они. Никогда не доверял этим гитам. Понимаешь, рубака, эти тощие гиты думают только о двух вещах: как бы не попасть в рабство и как убить кальмароголовых иллитидов. Все остальное не имеет большого значения, и этот чертов ублюдок ни с кем, кроме тебя, не общался».~
@601 = ~«Почему так?»~
@602 = ~«Насчет некоторых моих спутников...»~
@603 = ~«У меня есть другие вопросы...»~
@604 = ~«Хм-м-м. Интересно. Спасибо, Захария».~
@605 = ~«Это одна из тех тайн, прояснить которые мне никогда не удавалось. Может, ты мне скажешь?»~
@606 = ~«Я и сам не знаю. У меня есть другие вопросы...»~
@607 = ~«Возможно, мне это удастся. Прощай, Захария».~
@608 = ~«Вздорная крошка, возомнившая себя солдатом. Поклялась, что пойдет за тобой до Баатора и обратно. Силы всемогущие, да она была просто одержима мыслями о тебе, больше ни о чем и не думала. Меня или гита вообще не замечала. Она была просто без ума тебя — сбрендила, это уж точно. Не понимаю, что женщины находят в твоей покромсанной мордашке, но это заставляет их кровь кипеть от страсти. Она была богатенькой из Чиновничьего района, а тебе от нее что-то было нужно, и только из-за этого ты взял ее с собой».~
@609 = ~«Что мне было нужно от нее?»~
@610 = ~«Насчет некоторых моих спутников...»~
@611 = ~«Я выслушал достаточно. Прощай, Захария».~
@612 = ~«Которого из них?»~
@613 = ~«Гит».~
@614 = ~«У меня есть другие вопросы...»~
@615 = ~«'Причитающая дочка адвоката'».~
@616 = ~«Летающий череп».~
@617 = ~«Ты... ты был... слепым лучником?»~
@618 = ~«Неважно. У меня есть другие вопросы...»~
@619 = ~«Я выслушал достаточно. Прощай, Захария».~
@620 = ~«Этот сквернослов просто напрашивался на тумаки, это уж точно! Вечно строил из себя умника и насмехался надо мной!»~
@621 = ~Пьяный маг~
@622 = ~«Насчет некоторых моих спутников...»~
@623 = ~«У меня есть другие вопросы...»~
@624 = ~«Я выслушал достаточно. Прощай, Захария».~
@625 = ~«Это та самодельная книжица, которую ты сшил из собственной кожи, и в которой страниц больше, чем моих прожитых лет?! Какое счастье, что ты ее потерял! Вечно в нее что-то корябал. От нее тянуло страхом. Как будто ты боялся, что ее кто-то свистнет... Ты писал в нее до тех пор, пока пальцы не истирал в кровь, а я уже начинал подумывать, что ты пытался выдуть содержимое своей черепушки через перо. Иногда мы днями ждали, пока ты пишешь. Ненавижу эту адскую книгу. Она словно присосалась к тебе, нехорошо это было. В последний раз, когда я ее видел, рубака, она была у тебя. Если она не у тебя, то я не знаю, где теперь она может быть на планах».~
@626 = ~«Насчет моих спутников...»~
@627 = ~«У меня есть другие вопросы...»~
@628 = ~ «Спасибо за информацию. Прощай, Захария».~
@629 = ~«Звучит знакомо... но если ты тот, о ком я думаю, тогда... кто... — зомби на секунду умолкает. — Кто я?»~
@630 = ~«Я... — зомби замолкает. — Имя... я его не помню. Я... не могу вспомнить, кто я такой».~
@631 = ~«Захария?»~
@632 = ~«Твое имя мне не известно. Я вернусь, если узнаю его. Прощай».~
@633 = ~«Тогда прощай, Захария».~
@634 = ~«Захария?»~
@635 = ~«Я не знаю твоего имени. Я вернусь, если узнаю его. Прощай».~
@636 = ~«Прощай».~
@637 = ~«Как ты оказался в таком состоянии?»~
@638 = ~«Что ты можешь рассказать о Морге?»~
@639 = ~«Что ты можешь рассказать о моей предыдущей жизни?»~
@640 = ~«Что ты можешь рассказать о моих предыдущих спутниках?»~
@641 = ~«Я должен идти. Прощай, Захария».~
@642 = ~«Каждый раз, когда ты бросал нас, рубака, ты что-нибудь оставлял... Даккона ты оставил без хозяина, черепа — без друга. А я? Ты запихнул что-то внутрь меня, и при моей жизни оно никогда не выходило наружу. Из-за этого моя кровь остыла. Оно сидит в моей груди словно осколок».~
@643 = ~«Я... я не знаю. Но оно каким-то образом изменило меня. Изнутри. Я был уже при смерти, когда ты засунул его в меня, так что мне было как-то не до этого».~
@644 = ~«Оно надежно спрятано, но я представляю, где оно находится. Без скальпеля и кое-каких моих указаний ты не сможешь его достать. У тебя есть скальпель?»~
@645 = ~«И что это?»~
@646 = ~«У меня есть другие вопросы...»~
@647 = ~«Да».~
@648 = ~«Я должен идти. Прощай, Захария».~
@649 = ~«Могу я получить его обратно?»~
@650 = ~«Насчет моих спутников...»~
@651 = ~«У меня есть другие вопросы...»~
@652 = ~«Я должен идти. Прощай, Захария».~
@653 = ~«Нет... но я смогу просто разорвать стежки руками».~
@654 = ~«Ну тогда возвращайся, как найдешь его, и тогда мы попробуем вытащить эту штуковину наружу».~
@655 = ~«У меня есть другие вопросы...»~
@656 = ~«Пойду-ка, поищу его. Прощай».~
@657 = ~«Тогда вскрой меня на ладонь ниже грудины и пошарься внутри».~
@658 = ~Сделать это.~
@659 = ~«Неважно, Захария... Лучше я задам тебе несколько вопросов...»~
@660 = ~«Сейчас я не могу, я должен идти. Прощай, Захария».~
@661 = ~«Чуть левее... еще чуть-чуть...» Твоя рука на нащупывает предмет.~
@662 = ~Ты вытаскиваешь печень зомби. «Взгляд Леди! Извини, рубака... Я думал, что тленные, перед тем как выписать нас из книги мертвых, вынимают все органы. Попробуй еще раз. Может быть, оно справа».~
@663 = ~Вытащить его.~
@664 = ~Попробовать еще раз.~
@665 = ~«Вот так... теперь чуть правее и глубже... еще чуть-чуть...» Ты чувствуешь что-то твердое и холодное, по размерам чуть больше ожидаемого. «Кажется, это оно. Вытаскивай».~
@666 = ~Вытащить его.~
@667 = ~Ты вытаскиваешь почерневший предмет размером с кулак, слишком тяжелый для своих размеров. «Вот и все. Ха, я и не думал, что оно такое большое. Это... а что это? Похоже... на сердце».~
@668 = ~«Да, похоже. Спасибо, Захария. У меня есть вопросы к тебе...»~
@669 = ~«Очень похоже. Я должен идти. Прощай, Захария».~
@670 = ~«Перед тем как ты уйдешь, сделай для меня небольшое одолжение, рубака».~
@671 = ~«В последнее время я сделал уже достаточно одолжений и услуг... Мне нужно идти, Захария. Прощай».~
@672 = ~«И что это?»~
@673 = ~Он пристыженно умолкает. «Я совершил много ошибок, ужасных ошибок, если начистоту. Но самая ужасная из них — я подписал с тленными контракт. Не будь я тогда мертвецки пьян, я бы никогда такого не сделал. Я очень сожалею о ней и надеюсь, что ты сможешь разрешить ее правильно».~
@674 = ~Вернет~
@675 = ~«Как?»~
@676 = ~«В последнее время я сделал уже достаточно одолжений и услуг... Мне нужно идти, Захария. Прощай».~
@677 = ~«По моим прикидкам, это тело продержится еще долго... каждый день для меня слишком мучителен. Может, ты прирежешь меня, рубака... по старой дружбе? Одна только мысль о том, что я еще много лет буду торчать в Морге с этими бледнолицыми, леденит мою душу. Ты не мог бы прописать меня обратно в книгу мертвых, где мне и следует быть?»~
@678 = ~Ты вспарываешь ему кишки, и Захария тяжело падает на пол. Тело издает слабый выдох, грудная клетка в последний раз опадает, после чего от него не слышно ни звука.~
@679 = ~«Если ты так хочешь...»~
@680 = ~«Захария, я не хочу убивать тебя. Еще раз. Прощай».~
@681 = ~«Покойся с миром, Захария».~
@682 = ~«Ладно, тогда не бери в голову. Полагаю, теперь я для тебя бесполезен».~
@683 = ~«Что ж, рубака, полагаю, что в факте смерти трудно сомневаться, но как ты тогда со мной разговариваешь? Твой голос так отчетлив...»~
@684 = ~Уйти.~
@685 = ~«Это долгая история... но нет, я не мертв».~
@686 = ~«Что ты здесь делаешь?»~
@687 = ~«Что это за место?»~
@688 = ~«У меня больше нет времени на разговоры, Захария. Прощай».~
@689 = ~«Что ты здесь делаешь?»~
@690 = ~«У меня есть несколько вопросов...» ~
@691 = ~«Я должен идти. Прощай, Захария».~
@692 = ~«Я теперь уборщик в самом безжизненном месте на свете. Я бы мог пересечь Границу Вечности и найти свой родной план, но я промотал всю свою душу, так что теперь я нахожусь здесь».~
@693 = ~«Каково это — быть зомби?»~
@694 = ~«Это очень почетная обязанность... — стежки вокруг рта Захарии уже ослабли настолько, что он смог растянуться в улыбке. — Меня это мало волнует».~
@695 = ~«У меня есть несколько вопросов...» ~
@696 = ~«Я должен идти. Прощай, Захария».~
@697 = ~«У меня есть другие вопросы...»~
@698 = ~«Тогда прощай, Захария».~
@699 = ~Уйти.~
@700 = ~«Ничего. Я солгал».~
@701 = ~Уйти.~
@702 = ~Ложь: «Твое имя пробуждает во мне необузданные мысли, но их смысл мне неясен. Если только ты не расскажешь мне больше...»~
@703 = ~«Приветствую...»~
@704 = ~Подождать.~
@705 = ~Уйти до того, как дух обратит на тебя внимание.~
@706 = ~Ее глаза медленно открываются, секунду она смущенно моргает, будто не понимая, где она находится. Девушка медленно окидывает взглядом комнату. Увидев тебя, ее спокойное лицо искажается яростью. «Ты! Что привело сюда *тебя*?! Захотел лично полюбоваться на причиненные тобой страдания? Или, быть может, даже после моей смерти ты надеешься получить от меня пользу?.. — ее голос превращается в шипение. — ...'любовь моя'».~ [DEN001]
@707 = ~«Кто ты?»~
@708 = ~«Любовь моя? Я знаю тебя?»~
@709 = ~«Любовь моя? Я знаю тебя?»~
@710 = ~Дух складывает руки в мольбе. «Ну почему же воры разума продолжают красть мое имя из твоей памяти? Неужели ты *не помнишь* меня, любовь моя? — дух протягивает руки. — Подумай... — ее голос снова наполняется отчаянием. — ...имя *Дейонарра* должно пробудить в тебе хоть немного воспоминаний».~
@711 = ~«Прости. Моя память покинула меня».~
@712 = ~Ложь: «Да... это имя мне *кажется* знакомым».~
@713 = ~«*Кажется*, я чувствую касание памяти. Поговори со мной еще. Быть может, твои слова воскресят тени моей памяти, Дейонарра».~
@714 = ~«*Кажется*, я чувствую касание памяти. Поговори со мной еще. Быть может, твои слова воскресят тени моей памяти, Дейонарра».~
@715 = ~Дейонарра снова появляется... на этот раз ее лицо полно отчаяния, ее руки вытянуты, будто пытаются за что-то ухватиться. При твоем появлении отчаяние на ее лице сменяется яростью. «Ты снова пришел! Почему ты продолжаешь мучить меня?»~ [DEN002]
@716 = ~Дейонарра снова появляется... на этот раз ее лицо полно отчаяния, ее руки вытянуты, будто пытаются за что-то ухватиться. При твоем появлении отчаяние на ее лице сменяется надеждой. «Любовь моя... ты снова вернулся ко мне! Ты вспомнил меня?»~ [DEN003A]
@717 = ~«Этого я и боялась. Я действительно потеряла тебя... и то, что раньше приносило тебе неудобства, теперь стало оправданием для того, чтобы отказаться от меня так же, как ты отринул воспоминания обо мне!»~
@718 = ~«*Кажется*, я чувствую касание памяти. Поговори со мной еще. Быть может, твои слова воскресят тени моей памяти, Дейонарра».~
@719 = ~«*Кажется*, я чувствую касание памяти. Поговори со мной еще. Быть может, твои слова воскресят тени моей памяти, Дейонарра».~
@720 = ~«Неудобства? Отказаться от тебя? Я не знаю тебя, дух... я ничего не помню. Скажи мне... кто ты? Что ты знаешь обо мне?»~
@721 = ~«Если я отказывался от тебя раньше, то, похоже, что мне снова придется это сделать. Прощай, дух».~
@722 = ~«Да... — она выглядит обнадеженной. — Что пробудило мое имя в твоей памяти?»~
@723 = ~«Я не уверен... но, кажется, я чувствую касание памяти. Поговори со мной еще. Быть может, твои слова воскресят тени моей памяти, Дейонарра».~
@724 = ~«Я не уверен... но, кажется, я чувствую касание памяти. Поговори со мной еще. Быть может, твои слова воскресят тени моей памяти, Дейонарра».~
@725 = ~Лицо Дейонарры превращается яростную маску. «Ты прокаженный пес! Предатель моего сердца! Я бы прокляла тебя, но ты и без моих проклятий обречен на вечные страдания в своих воскрешениях! Прочь!» Она скрещивает свои руки и закрывает глаза.~
@726 = ~«Ах, наконец-то судьба проявила милосердие! Даже смерть не может изгнать меня из твоего разума, любовь моя! Разве ты не понимаешь? Твои воспоминания возвращаются! Скажи мне, как я могу помочь тебе, и я сделаю это!»~
@727 = ~Безымянный~
@728 = ~Анна~
@729 = ~«Ты знаешь, кто я?»~
@730 = ~«Можешь сказать мне, где я нахожусь?»~
@731 = ~«Мне нужно выбраться из этого места. Ты поможешь мне?»~
@732 = ~«Мне нужно выбраться из этого места. Ты поможешь мне?»~
@733 = ~«Что ты желаешь знать?»~
@734 = ~«Кто ты?»~
@735 = ~«Ты можешь сказать, кто я?»~
@736 = ~«Можешь сказать мне, где я нахожусь?»~
@737 = ~«Мне нужно выбраться из этого места. Ты поможешь мне?»~
@738 = ~«Мне нужно выбраться из этого места. Ты поможешь мне?»~
@739 = ~«Ты тот, кто одновременно благословен и проклят, любовь моя. И тот, кто всегда пребывает в моих мыслях и в моем сердце».~
@740 = ~«Благословен и проклят? Что ты имеешь в виду?»~
@741 = ~«У меня есть другие вопросы к тебе...»~
@742 = ~«Я должен идти. Прощай, Дейонарра».~
@743 = ~«Где ты находишься? Ты здесь, рядом со мной, любовь моя... как в те времена, когда мы оба были живы. Теперь меж нами пролегла Граница Вечности».~
@744 = ~«Граница Вечности?»~
@745 = ~«У меня есть другие вопросы к тебе...»~
@746 = ~«Я должен идти. Прощай, Дейонарра».~
@747 = ~«Хорошо...»~
@748 = ~«Природа твоего проклятия должна быть очевидной для тебя, любовь моя. Взгляни на себя, — она указывает на тебя пальцем. — Смерть не принимает тебя. Твои воспоминания покинули тебя. Как ты думаешь, почему?»~
@749 = ~«На самом деле я все еще пытаюсь во всем разобраться. Что ты еще можешь рассказать обо мне?»~
@750 = ~«У меня есть другие вопросы...»~
@751 = ~«Потерянные воспоминания... смерть, не принимающая меня... но почему это проклятие?»~
@752 = ~Голос Дейонарры полон печалью. «Это преграда, которую, боюсь, ты никогда не пересечешь, любовь моя. Она ограждает твою жизнь от того, что осталось от моей...»~
@753 = ~«Я... понимаю. Может быть, ты сможешь ответить на несколько вопросов...»~
@754 = ~«Тест продажи»~
@755 = ~«Я должен идти. Прощай, Дейонарра».~
@756 = ~«Постой... Я многое узнала во время наших путешествий, любовь моя. И то, что ты потерял, я сберегла. Я еще не сказала всего, что знаю о тебе. Мой взор чист... в то время как ты мечешься в темноте в поисках искры разума».~
@757 = ~«Что бы ты там ни знала, может подождать. Прощай».~
@758 = ~«И что ты можешь рассказать мне такого, что могло бы мне пригодиться?»~
@759 = ~«И что же ты видишь, чего я не могу разглядеть?»~
@760 = ~~
@761 = ~«Я должен идти. Прощай, Дейонарра».~
@762 = ~Дейонарра выглядит ошеломленной, затем ее тон меняется, голос почти умоляет. «Я... не хотела брать с тебя клятву, любовь моя. Просто я так долго ждала, когда ты присоединишься ко мне за пределами...»~
@763 = ~«Если тебе не нужна клятва от меня, Дейонарра, то и не надо ее требовать. А теперь расскажи о своем видении, без всех этих клятв и обещаний».~
@764 = ~«Я должен идти, Дейонарра. Прощай».~
@765 = ~«Мне нужно многое узнать. У меня есть вопросы к тебе...»~
@766 = ~«У меня есть вопросы к тебе...»~
@767 = ~«Пока нет. Прощай, Дейонарра».~
@768 = ~«Что это было за видение, о котором ты говорила?»~
@769 = ~«Время ослабляет свою хватку, а холод забвения медленно поглощает нас, любовь моя. Еще не все видения приобрели четкие очертания. Я вижу тебя, любовь моя. Я вижу тебя таким, какой ты сейчас, и...» Дейонарра умолкает.~
@770 = ~«Почему ты замолчала? Твоя речь утомила тебя?»~
@771 = ~«Что? Что ты видишь?»~
@772 = ~«Мне неинтересны видения будущего. Прощай».~
@773 = ~«Я вижу путь, лежащий перед тобой. Он берет свое начало отсюда и проходит сквозь планы. Должна ли я говорить о том, что я вижу?»~
@774 = ~«Говори».~
@775 = ~«Я не хочу знать. Будущее само себя раскроет... со временем».~
@776 = ~«Ты всегда был таким, любовь моя. Ты уже отверг призыв смерти. Что ты отвергнешь в следующий раз? Быть может, само время?» Закрыв глаза, Дейонарра исчезает с беззвучным вздохом.~
@777 = ~«Сначала мне нужно обещание. Обещание, что ты вернешься. Что ты найдешь способ спасти меня или присоединиться ко мне».~
@778 = ~«Трудно поверить, что женщина, которую я когда-то любил, будет вымогать у меня обещания, суля предсказаниями. Ты не веришь мне, Дейонарра?»~
@779 = ~«Цена такого обещания слишком высока».~
@780 = ~Ложь: «Обещаю, я найду способ спасти тебя или присоединиться к тебе».~
@781 = ~«Я не буду давать никаких обещаний, призрак! Не дразни меня больше... говори или исчезни!»~
@782 = ~«Я... я сделаю все, что в моих силах».~
@783 = ~Дейонарра скрещивает руки на груди. «Да, это так, любовь моя. А цена бессмертия, по всей видимости, была не так уж высока? Или честность — это слишком для тебя?» ~
@784 = ~«Любовь моя, вот что видят мои глаза, освобожденные от оков времени...»~ [DEN020]
@785 = ~«Ты встретишь трех врагов, но ни один из них не был бы тебе ровней в период полного расцвета твоих сил. Они — тени зла, добра и нейтральности, которых породили и извратили законы планов».~ [DEN021]
@786 = ~Подождать, пока она не продолжит.~
@787 = ~Подождать, пока она не продолжит.~
@788 = ~«Ты попадешь в тюрьму, построенную из сожалений и скорби, где даже тени теряют рассудок. Там тебя попросят принести ужасную жертву, любовь моя. Чтобы обрести покой, ты должен будешь уничтожить то, что удерживает тебя в живых, и отринуть свое бессмертие».~ [DEN022]
@789 = ~«Уничтожить то, что удерживает меня в живых?»~
@790 = ~«Я должен идти. Прощай, Дейонарра».~
@791 = ~«Я не сомневаюсь в твоей способности восставать из мертвых. Но я уверена, что с каждым перерождением твои мысли и память слабеют. Ты утверждаешь, что потерял память. Быть может, это следствие бесчисленных смертей? Если это так, то что ты потеряешь в следующих смертях? Если ты потеряешь свой рассудок, то даже не сможешь осознать собственное бессмертие. И тогда ты будешь по-настоящему обречен».~
@792 = ~«Я должен идти. Прощай, Дейонарра».~
@793 = ~Дейонарра выглядит разъяренной. «Тогда уходи, как уходил уже триста раз! Зачем ты приходишь сюда? Чтобы помучить меня?! Уходи и никогда больше не возвращайся!» Закрыв глаза, Дейонарра исчезает с беззвучным вздохом.~
@794 = ~Уйти.~
@795 = ~«Я знаю, что когда-то ты говорил, что любишь меня и что будешь любить до тех пор, пока смерть не заберет нас обоих. Я верила тебе, не зная всей правды о том, кто ты и что ты на самом деле».~
@796 = ~«У меня есть другие вопросы...»~
@797 = ~«И кто же я такой?»~
@798 = ~«Прощай, Дейонарра».~
@799 = ~«Мы уже говорили о твоей природе, — взгляд Дейонарры холодеет. — И этот разговор больше не повторится».~
@800 = ~«Хорошо... У меня есть другие вопросы...»~
@801 = ~«Ты заявляла, что знаешь меня, хотя на самом деле знаешь обо мне очень мало. Прощай, Дейонарра».~
@802 = ~«Ты заявляла, что знаешь меня, хотя на самом деле знаешь обо мне очень мало. Прощай, Дейонарра».~
@803 = ~Уйти.~
@804 = ~«Трудно поверить, что женщина, которую я когда-то любил, будет вымогать у меня обещания, суля предсказаниями. Ты не веришь мне, Дейонарра?»~
@805 = ~Ложь: «Обещаю, я найду способ спасти тебя или присоединиться к тебе».~
@806 = ~«Я не буду давать никаких обещаний, призрак! Не дразни меня больше... говори или исчезни!»~
@807 = ~«Я... я сделаю все, что в моих силах».~
@808 = ~Клятва: «Обещаю: я найду способ спасти тебя или присоединиться к тебе».~
@809 = ~«Я знаю, что ты должен умереть... пока еще можешь. Круг *должен* замкнуться, любовь моя. Ты не предназначен для такой жизни. Ты должен найти то, что у тебя отнято, и уйти дальше, в земли мертвых».~ [DEN023]
@810 = ~«Пока я еще могу?»~
@811 = ~«У меня есть другие вопросы...»~
@812 = ~«Бесчисленных смертей? Как долго это продолжается?»~
@813 = ~«Прощай, Дейонарра».~
@814 = ~«Я не знаю точно. Мне известно лишь, что это продолжается достаточно долго».~
@815 = ~«У меня есть другие вопросы...»~
@816 = ~«Прощай, Дейонарра».~
@817 = ~«Порталы — это дыры в реальности, ведущие в различные места на внутренних и внешних планах... если ты найдешь подходящий ключ, то сможешь сбежать через один из них».~
@818 = ~«У меня есть другие вопросы...»~
@819 = ~«Ключ?»~
@820 = ~«Прощай, Дейонарра».~
@821 = ~Дейонарра умолкает, пытаясь что-то вспомнить. «Порталы раскрываются лишь только в том случае, если у тебя есть подходящий 'ключ'. К сожалению, ключом может быть все что угодно... эмоция, кусочек дерева, кинжал из посеребренного стекла, обрывок одежды, твое посвистывание... Боюсь, что только тленные знают, какие ключи нужно использовать, чтобы покинуть эти залы, любовь моя».~
@822 = ~Прежде чем Морт успевает завершить свои разглагольствования, писарь начинает безудержно кашлять. Спустя минуту или две кашель прекращается, и дыхание писаря вновь становится неровным хрипом.~
@823 = ~«Тогда я расспрошу одного из них. Прощай, Дейонарра».~
@824 = ~«Понятно. У меня есть другие вопросы...» ~
@825 = ~Опыт от убийств:~
@826 = ~Прежде чем Морт успевает закончить, взгляд серых глаз писаря падает на тебя. «Бремя прожитых лет лежит на мне тяжелым грузом, Неугомонный, — он откладывает перо, — но глухотой я еще не страдаю».~
@827 = ~«Неугомонный? Ты меня знаешь?»~
@828 = ~Окровавленные тряпки покрывают останки этого трупа. Вонь, идущая от тела, почти невыносима.~
@829 = ~«Тебе знакома женщина, чьи останки погребены внизу, в мемориальном зале? Я думаю, что в прошлом она путешествовала вместе с тобой...» Дхолл начинает кашлять, но ему удается перевести дыхание. «Я ошибаюсь?»~
@830 = ~«Да. Он очень хорошо замаскировался».~
@831 = ~«Да. Он очень хорошо замаскировался».~
@832 = ~Дхолл пристально смотрит на тебя. «Ты уверен?»~
@833 = ~«Я...» У Дхолла начинается очередной приступ кашля. Спустя минуту или две его дыхание становится достаточно спокойным, чтобы он смог продолжить. «Я... незамедлительно предупрежу стражу».~
@834 = ~«Нет, пожалуй, мне просто показалось. У меня есть другие вопросы...»~
@835 = ~«Приветствую».~
@836 = ~«Спасибо. У меня есть другие вопросы...»~
@837 = ~«Отлично. Прощай».~
@838 = ~Этот писарь выглядит очень старым... его кожа морщиниста и имеет желтый оттенок, как у старого пергамента. Темно-серые глаза глубоко посажены на его угловатом лице, длинная белая борода ниспадает на его одежды, подобно водопаду. Его дыхание неровно и прерывисто, но даже периодический кашель не может замедлить движение его пера.~
@839 = ~«Приветствую».~
@840 = ~«Знаю ли я тебя? Я... — в голосе писца звучит горечь. — Я *никогда* не знал тебя, Неугомонный. Не больше, чем ты знал о себе сам». Он умолкает на секунду. «Ты ведь все забыл, не так ли?»~
@841 = ~Его серые глаза сверкают, когда он отрывает свой взгляд от книги. «Подозреваю, что это ты в ответе за нападения в Морге. Это...» Они тихо кашляет, затем тяжело хрипит. «Это не позволит тебе обрести следующую жизнь».~
@842 = ~«Я всего лишь защищался. У меня есть несколько вопросов перед тем, как я удалюсь...»~
@843 = ~«Как по мне, дарить смерть вам, трупопоклонникам, — не такое уж и не преступление. А теперь у меня есть вопросы к тебе...»~
@844 = ~Писарь прекращает вести записи в стоящую перед ним книгу и оглядывается. Его глаза похожи на два гвоздя, забитые в его череп. «Итак...» Его голос уставший, как будто он повторял это уже много раз. «Ты пробудился ото сна и вернулся в свои грезы». Он продолжает более уважительным голосом. «Приятно встретиться... снова, Неугомонный».~
@845 = ~«Неугомонный? Ты меня знаешь?»~
@846 = ~«Как я попал сюда?»~
@847 = ~«Мы — тленные, фракция, собравшая всех тех, кто понял иллюзорность этой жизни. Мы ждем следующей жизни и помогаем другим в их путешествии».~
@848 = ~«Истинная Смерть — это небытие. Состояние, свободное от мыслей, чувств, страстей». Дхолл кашляет, затем восстанавливает неровное дыхание. «Состояние чистоты».~
@849 = ~«По-твоему, лучше оставаться в тени того, что раньше называлось жизнью? Я так не думаю».~
@850 = ~«Дневник? Если он представляет хоть какую-то ценность, то он наверняка в руках Фарода».~
@851 = ~«Ты должен понять. Твое существование для них — богохульство. Многие из нашей фракции распорядились бы тебя кремировать... если бы узнали о твоем несчастье».~
@852 = ~«Хорошо. Что ты хочешь узнать?»~
@853 = ~«А что заставляет тебя думать, что эта жизнь *настоящая*? Прислушайся к себе. Разве ты не чувствуешь какую-то опустошенность? — Дхолл качает головой. — Это чистилище. Здесь только горе. Несчастье. Страдание. Они не являются элементами 'жизни'. Они — часть клетки, в которой мы заперты в этой тени».~
@854 = ~«Ты знал, что в восточной комнате находится кто-то, замаскированный под зомби?»~
@855 = ~«Как я попал сюда?»~
@856 = ~Поверхность этой плиты заляпана высохшей кровью.~
@857 = ~«Что это за место?»~
@858 = ~«Не подскажешь, как мне выбраться отсюда?»~
@859 = ~«Ты находишься в Морге, Неугомонный. Ты снова... пришел...» Не успев закончить, Дхолл заходится в приступе кашля. Спустя некоторое время он берет себя в руки, и его дыхание снова становится неровным хрипом. «...это зал ожидания для тех, кто собирается покинуть тень этой жизни».~
@860 = ~«*Неугомонный*?»~
@861 = ~«Расскажи мне о Морге».~
@862 = ~«Тень этой жизни?»~
@863 = ~«Снова?.. Я был здесь раньше?»~
@864 = ~«Как я попал сюда?»~
@865 = ~«У меня есть другие вопросы...»~
@866 = ~«Прощай, Дхолл».~
@867 = ~Когда ты собираешься уйти, Дхолл произносит: «Знай: я не завидую тебе, Неугомонный. Твои возрождения — проклятье, которого я бы не смог вынести. Ты должен смириться с этим. Когда-нибудь твой путь вернет тебя сюда...» Дхолл кашляет, из его горла доносятся хрипы. «Это путь всех существ из плоти и костей».~
@868 = ~«Несомненно, они здесь, но я не знаю ни их имен, ни где они лежат. Ты прошел путь, по которому ходят многие, но немногие выживают, — Дхолл обводит вокруг тебя рукой. — Все умершие прибывают сюда. Кое-кто из них, должно быть, путешествовал с тобой».~
@869 = ~Бинты, скрывающие это тело, насквозь пропитаны кровью. Несмотря на то, что труп мертв уже несколько дней, кровь все еще сочится из его ран.~
@870 = ~«Где та женщина, которую ты упомянул?»~
@871 = ~«Я не вижу изъяна в твоих рассуждениях. У меня еще вопросы...»~
@872 = ~«Тогда я поищу их. Возможно, они смогут возродить мою память. Прощай».~
@873 = ~«Не уверен, что она достигла Истинной Смерти. Прощай, Дхолл».~
@874 = ~«Понятно. Прощай, Дхолл».~
@875 = ~«Хм-м... Главные ворота — самый очевидный выход, но они не выпустят никого, кроме тленных... — Дхолл заходится в кашле, затем продолжает. — У одного из проводников у главных ворот есть ключ к ним, но он вряд ли откроет их для тебя, разве что ты будешь весьма убедительным».~
@876 = ~«Понятно. У меня еще вопросы...» ~
@877 = ~«Тогда прощай, Дхолл».~
@878 = ~«Да, *снова*. Ты попадал сюда много раз, Неугомонный. Я надеялся, что этот раз будет последним, учитывая полученные тобой раны, — он вздыхает. — Когда же ты откажешься от своих страстей и покинешь эту тень жизни?»~
@879 = ~«Расскажи мне побольше о Морге».~
@880 = ~«*Неугомонный*?»~
@881 = ~«Ранен?»~
@882 = ~Вонь, идущая от этого трупа, поистине невыносима. Кто-то вскрыл грудную клетку этого несчастного, но еще не успел удалить внутренние органы.~
@883 = ~«Тень жизни?»~
@884 = ~«Ты будешь делать то же, что и раньше, Неугомонный. Разыщешь того любителя звенелок, того плешивого идиота, Червеволосого, и вернешь свое имущество. После продолжишь свои бессмысленные поиски, пытаясь выполнить бессмысленные задания, собирая бессмысленные предметы. Затем ты падешь и вернешься назад к нам. Сэкономь время и поговори с мной сейчас, чтобы нам не пришлось вновь заводить этот разговор, когда твои воспоминания снова покинут тебя».~
@885 = ~Дхолл презрительно фыркает, как будто его воротит от воспоминания об этом. «К Моргу тебя доставила твоя ветхая карета, Неугомонный. Увидев ее, ты мог бы возомнить себя аристократом, учитывая количеств подданных, лежащих в ней зловонной разлагающейся кучей».~
@886 = ~«Я приехал сюда на повозке?»~
@887 = ~«Расскажи мне побольше о Морге».~
@888 = ~«У меня есть другие вопросы...»~
@889 = ~«Прощай, Дхолл».~
@890 = ~«Да... твое тело лежало где-то посреди горы трупов». Дхолл снова заходится в приступе кашля, который ему удается побороть только несколько минут спустя. «Твоим 'сенешалем', как всегда, был Фарод, который был рад доставить твое тело к вратам Морга за несколько медяков».~
@891 = ~«Кто этот Фарод?»~
@892 = ~«Похоже, тебе не очень-то нравится Фарод».~
@893 = ~«Расскажи мне побольше о Морге».~
@894 = ~«У меня есть другие вопросы...»~
@895 = ~«Он... сборщик мертвых». Дхолл переводит дыхание, затем продолжает: «У нас в городе есть такие люди, которые собирают тела тех, кто вступил на путь Истинной Смерти, и приносят их нам для подобающего погребения».~
@896 = ~~
@897 = ~«Где я могу найти этого Фарода?»~
@898 = ~«Похоже, тебе не очень-то нравится Фарод».~
@899 = ~«Расскажи мне побольше о Морге».~
@900 = ~«Если все пойдет своим чередом, Неугомонный, то скорее Фарод найдет тебя и притащит нам сюда, чем ты найдешь ту лужу грязи, в которой он барахтается». ~
@901 = ~Голос Дхолла начинает звучать предостерегающе. «Не ищи Фарода, Неугомонный. Я уверен, что ты попросту пройдешь еще один полный круг, и не станешь от этого мудрее, зато обогатишь Фарода на несколько медяков. Прими смерть, Неугомонный. Не повторяй свой круг страданий».~
@902 = ~«Тем не менее, я должен его найти».~
@903 = ~«Расскажи мне побольше о Морге».~
@904 = ~«Понятно. У меня еще вопросы...» ~
@905 = ~«Расскажи мне побольше о Морге».~
@906 = ~«Мне *нужно* найти его. Ты не знаешь, где он может быть?»~
@907 = ~«У меня есть другие вопросы...»~
@908 = ~Дхолл умолкает на минуту. Когда же он начинает говорить, то становится ясно, что он делает это с явной неохотой. «Я не знаю, в каком притоне находится логово Фарода в данный момент, но могу предположить, что оно где-то за воротами Морга, в Улье. Возможно, кто-то из местных знает, где его найти».~
@909 = ~«Расскажи мне побольше о Морге».~
@910 = ~«Похоже, тебе не очень-то нравится Фарод».~
@911 = ~«Расскажи мне побольше о Морге».~
@912 = ~(Заглушка.)~
@913 = ~«У меня есть другие вопросы...»~
@914 = ~«О тебе, Неугомонный, я знаю совсем немного. О твоих спутниках, лежащих теперь под нашим присмотром, я знаю ненамного больше, — Дхолл вздыхает. — Прошу тебя, Неугомонный, больше не проси никого идти с тобой: за тобой остается только несчастье. Не разделяй свою ношу с другими».~
@915 = ~Дхолл вздыхает. «Говорят, что есть души, которые не могут достичь Истинной Смерти. Смерть отказалась от них, и их имена никогда не попадут в книгу мертвых. Подняться из мертвых, как это сделал ты... Это наводит на мысль, что ты — одна из таких душ. Само твое существование неприемлемо для нашей фракции».~
@916 = ~«Неважно. Мне нужно идти. Прощай».~
@917 = ~«Неприемлемо? Похоже, мое положение оставляет желать лучшего».~
@918 = ~«Ясно. Расскажи мне побольше о Морге».~
@919 = ~«У меня есть другие вопросы...»~
@920 = ~«Думаю, я услышал достаточно. Прощай, Дхолл».~
@921 = ~«Меня кто-то сопровождал в пути? Они здесь?»~
@922 = ~«У меня есть другие вопросы...»~
@923 = ~«Прощай, Дхолл».~
@924 = ~«Потому что заставлять тебя принимать нашу веру несправедливо. Ты должен оставить тень этой жизни по своей воле, а не по нашей». Дхолл, кажется, готов разразиться очередным приступом кашля, но с некоторыми усилиями ему удается сдержаться. «И покуда я не покину свою должность, я буду защищать твое право искать свою правду».~
@925 = ~«Хорошо. У меня есть другие вопросы...»~
@926 = ~Судя по исходящему зловонью, все внутренности этих выпотрошенных трупов свалены здесь.~
@927 = ~«Каковы твои обязанности?»~
@928 = ~«Расскажи мне побольше о Морге».~
@929 = ~«Я — единственный, кто регистрирует тела, поступающие в наши залы, Неугомонный». Дхолл начинает кашлять, затем успокаивается. «Только я вижу лица тех, кто лежит на наших плитах. Тайна твоего существования со мной в безопасности».~
@930 = ~«Я — писарь. Я веду учет всех тел, которые поступают в Морг». Дхолл снова кашляет, затем глубоко вздыхает. «И пока поток трупов идет через Морг, я буду при своей должности».~
@931 = ~«Ты сказал, что я был здесь много раз. Почему же тленные не узнают меня?»~
@932 = ~«Расскажи мне побольше о Морге».~
@933 = ~«Понятно. У меня еще вопросы...» ~
@934 = ~«Я уже близок к Истинной Смерти, Неугомонный. Уже скоро я пересеку Границу Вечности и обрету покой, который давно искал. Я устал от этой смертной сферы... — Дхолл тяжело вздыхает. — Для такого, как я, на планах больше нет чудес».~
@935 = ~«Границу Вечности?»~
@936 = ~«Ты уверен? Должен же быть способ помочь тебе».~
@937 = ~«У меня есть другие вопросы...»~
@938 = ~«Я не желаю жить вечно или возрождаться, Неугомонный. Я не смогу этого вынести».~
@939 = ~«Она *разговаривала* с тобой? — Дхолл переходит на шепот. — Ты случаем не *бредишь*, Неугомонный? Она достигла Истинной Смерти и ушла туда, куда тебе не добраться».~
@940 = ~«Ты — тленный, и все же не пытаешься убить меня. Почему?»~
@941 = ~Дхолл умолкает в раздумье. «Скорее всего. Ты что-то потерял... что-то особенно ценное? — он хмурится, понижая тон. — Вряд ли Фарод будет делать исключения для чего либо, кроме вживленных в плоть вещей, но порой даже этого недостаточно, чтобы остановить его жадность».~
@942 = ~«Я потерял дневник».~
@943 = ~«Хм-м. Ты не знаешь, где мне найти Фарода?»~
@944 = ~«У меня есть другие вопросы...»~
@945 = ~Дхолл описывает пальцем полукруг в воздухе перед собой. «Это дурное знамение, Неугомонный. Я молюсь о том, чтобы это оказалось твоим сном... и все же боюсь, это не так».~
@946 = ~«Возможно, мне показалось. У меня еще вопросы».~
@947 = ~«Возможно, мы поговорим об этом позже. Прощай, Дхолл».~
@948 = ~«Где мне найти этого Фарода?»~
@949 = ~«Понятно. У меня еще вопросы...» ~
@950 = ~«Это место, куда мертвых доставляют для погребения или кремации. Забота об умерших, покинувших эту тень жизни и ступивших на путь Истинной Смерти, входит в обязанности тленных, — Дхолл от волнения понижает тон. — Должно быть, ты был тяжело ранен, раз не узнаешь это место. Это практически твой дом».~
@951 = ~«Тень жизни?»~
@952 = ~Из этого мертвенно-бледного тела выкачали всю кровь и заменили ее на бальзамирующую жидкость. Грудная клетка трупа истончает тошнотворный запах.~
@953 = ~«Истинной Смерти?»~
@954 = ~«Тленных?»~
@955 = ~«Сигил?»~
@956 = ~«Ранен?»~
@957 = ~«Да, тень. Видишь ли, Неугомонный, эта жизнь... она не настоящая. Наши с тобой жизни — всего лишь тени, жалкое подобие от того, что было однажды жизнью. Эта 'жизнь' — то, куда мы попадаем *после* того, как умираем. А здесь мы... в западне. В клетке. До тех пор, пока не достигнем Истинной Смерти».~
@958 = ~«Истинной Смерти?»~
@959 = ~«Почему ты решил, что эта жизнь ненастоящая?»~
@960 = ~«Прощай, Дхолл».~
@961 = ~«Да, раны, украшающие твое тело... Получи их более слабый человек, он бы уже был на пути к Истинной Смерти, а у тебя некоторые из них уже зажили, — Дхолл надрывно кашляет, затем успокаивается. — Но это всего лишь поверхностные раны».~
@962 = ~«Есть люди, которых я уважаю, Неугомонный, — Дхолл успокаивает свое неровное дыхание. — Фарод не входит в их число. Он носит свою дурную репутацию как знак гордости и свободно распоряжается имуществом умерших. Он рыцарь легкой наживы, подлая мразь самого низкого пошиба».~
@963 = ~«Рыцарь легкой наживы?»~
@964 = ~«Ты не знаешь, где я могу найти Фарода?»~
@965 = ~«Понятно. У меня еще вопросы...» ~
@966 = ~«Рыцарь легкой наживы, — Дхолл кашляет, — вор. Все, кого Фарод приносит к нашим стенам, лишены всего имущества, которым они обладали при жизни. Фарод присваивает себе все, что ему удается вырвать из их окоченевших пальцев».~
@967 = ~«Мог ли Фарод взять что-нибудь у *меня*?»~
@968 = ~«Ты не знаешь, где я могу найти Фарода?»~
@969 = ~«Понятно. У меня еще вопросы...» ~
@970 = ~«Сигил — это наш прекрасный город, Неугомонный».~
@971 = ~«Расскажи мне еще о Морге».~
@972 = ~«Понятно. У меня еще вопросы...» ~
@973 = ~«Неугомонный — имя не хуже других... — Дхолл переводит дыхание. — Ведь что-то держит тебя здесь, не так ли? Какое-то незаконченное дело, какая-то страсть, которая должна быть подавлена, прежде чем ты сможешь достигнуть Истинной Смерти?»~
@974 = ~«Истинной Смерти?»~
@975 = ~«Расскажи мне еще о Морге».~
@976 = ~«У меня есть другие вопросы...»~
@977 = ~«Прощай, Дхолл».~
@978 = ~Дхолл мельком смотрит на тебя. «Итак. Ты вернулся...» Дхолл начинает хрипло дышать, затем у него начинается удушливый кашель. Спустя минуту кашель прекращается, и он, хрипло дыша, продолжает: «...приветствую тебя снова, Неугомонный».~
@979 = ~«У меня к тебе другие вопросы, Дхолл».~
@980 = ~«Неважно. Прощай».~
@981 = ~«Она разговаривала со мной, Дхолл. Ее душа находится здесь».~
@982 = ~«Возможно, я это выдумал. У меня есть другие вопросы...»~
@983 = ~«Границу между владениями тени этой жизни и Истинной Смерти».~
@984 = ~«Тень этой жизни?»~
@985 = ~«Истинной Смерти?»~
@986 = ~«Эй, шеф. Ты в порядке? Изображаешь из себя труп или пытаешься обмануть трухлявых? Я уж думал, что ты дал дуба».~
@987 = ~«Кто ты?»~
@988 = ~Вдохнуть поглубже, встряхнуть головой и не обращать внимания на говорящий с тобой череп.~
@989 = ~Не обращать внимания на говорящий череп и изучить комнату.~
@990 = ~«Я? — возмущается череп. — Может, *ты* начнешь, паршивец? Кто ты?»~
@991 = ~Не обращать внимания на череп и изучить комнату.~
@992 = ~«Я... не знаю». ~
@993 = ~«Я первый спросил тебя, череп».~
@994 = ~Не обращать внимания на череп и изучить комнату.~
@995 = ~«Я не знаю... Не могу вспомнить».~
@996 = ~«О, значит, *теперь* тебе снова захотелось поговорить с Мортом, а?»~
@997 = ~«Ты не знаешь, кто ты такой, а? *Мог* бы просто сказать: 'забей, пень'. Что ж, ладно... бестолочью притворяешься. Проверяешь, есть ли мне до этого дело. Я Морт. Приветствую, добро пожаловать и далее по списку».~
@998 = ~«Где я, Морт?»~
@999 = ~«Ты *не помнишь*? Нелегкая выдалась у тебя ночка. Надеюсь, никого не покалечил... Меня зовут Морт. Приветствую, добро пожаловать и далее по списку, — он делает паузу. — Слушай, я просто *обязан* спросить: ты случайно не один из тех чувствующих, которые занимаются членовредительством, или это кто-то другой подарил тебе эти шрамы?» ~
@1000 = ~«Чувствующие?»~
@1001 = ~«Шрамы?»~
@1002 = ~Не обращать внимания на Морта и изучить комнату.~
@1003 = ~«Ага, а я спросил тебя вторым. Как тебя звать?»~
@1004 = ~«Я... не знаю». ~
@1005 = ~«Я не знаю... Не могу вспомнить».~
@1006 = ~«Ты знаешь, как мне отсюда выбраться?»~
@1007 = ~«Ты первый, череп».~
@1008 = ~«Да ты натянут как струна. Ладно, ладно... Пускай *я* буде хорошим парнем... я, Морт. Морт Зубоскал. Итак, какому имени не посчастливилось иметь такого владельца как ты?»~
@1009 = ~«Я... не знаю». ~
@1010 = ~«Я не знаю... Я ничего не могу вспомнить».~
@1011 = ~Не обращать внимания на Морта и изучить комнату.~
@1012 = ~«Ты находишься в дыре под названием Морг... это такое большое черное здание с чарующей архитектурой беременной паучихи».~
@1013 = ~«Морг? Я умер?»~
@1014 = ~«Ну, насчет этого не знаю... Но Морг — самое подходящее место для покойников, которое только можно найти в этом городишке. Всякие пни тащат сюда мертвецов, хоронят их, сжигают, а если тебе *конкретно* повезло, тебя возвращают к жизни в качестве раба. Не лучшее место на планах. На твоем месте я бы разыскал ближайший выход и помахал этому месту ручкой».~
@1015 = ~«Как мне выбраться отсюда?»~
@1016 = ~«Прошу прощения... Морг? Что это за место?»~
@1017 = ~«Возвращают к жизни в качестве раба?»~
@1018 = ~«Но почему я тогда могу ходить?»~
@1019 = ~«Говоришь, люди тащат сюда мертвецов? Это так я сюда попал?»~
@1020 = ~Не обращать внимания на Морта и изучить комнату.~
@1021 = ~Пауза. «Ага, наверно. Может, какой-нибудь бездельник спутал тебя со жмуриком и подкинул тебя сюда. То, как ты строишь из себя трупака, и *меня* бы одурачило... может, тебе лучше найти того пня, который притащил тебя сюда, и его расспросить, а? — Морт кивает. — Неплохо соображаешь, как для недавнего мертвеца... рад видеть, что твоя черепушка все еще на месте».~
@1022 = ~«Да, это очаровательная жизнь... если не учитывать, что тебя без конца натирают формальдегида и пришиваю тебе отвалившиеся конечности, это можно считать раем».~
@1023 = ~«Э-э-э... как я уже сказал, в Морге. С тобой все в порядке, шеф? Ты что-то неважно выглядишь».~
@1024 = ~«Шеф, зрелище того, как ты сползаешь с плиты, было жуть как странно. Ты выглядишь так, будто тебе уже пора просить счет за выпивку, если ты понял, о чем я».~
@1025 = ~«Не знаешь, кто такие чувствующие? О, да ты, похоже, рассчитываешь услышать что-то особенное! Ну, они — кучка рубак, которые хотят перепробовать все, что могут предоставить им планы, включая... ладно, пока о них забудем. Что насчет этих шрамов?»~
@1026 = ~«Это как будто какой-нибудь рубака решил разрисовать тебя ножом. Ты весь в шрамах... даже на спине, не считая... — делает паузу. — Скажем так: пень, у тебя на спине целая галерея наколок. Тут что-то написано...»~
@1027 = ~«Шрамы?»~
@1028 = ~«Неважно. У меня есть другие вопросы...»~
@1029 = ~«Зачем кому-то понадобилось тащить меня сюда?»~
@1030 = ~«У меня есть другие вопросы...»~
@1031 = ~«Некоторые люди в этом городишке собирают жмуриков с улиц и продают их здесь за звенелки. Не очень-то хороший способ сводить концы с концами, но если ты живешь отстойнике всех планов, то выбор у тебя не так уж велик».~
@1032 = ~«Звенелки? Какие еще 'звенелки'?»~
@1033 = ~«Неважно. У меня есть другие вопросы...»~
@1034 = ~«Э-э... деньги. Звенелки — это деньги. Разве там, откуда ты, их нету?»~
@1035 = ~«Я не могу вспомнить, откуда я».~
@1036 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1037 = ~Он умолкает. «Не знаю. Ты *болтаешь* со мной... Здешние ходячие мертвецы обычно так не делают. Как мне кажется, трухлявые допустили ошибку и ты не был мертвым. Ты случайно не помнишь, чтобы подписывал какой-то контракт? То есть, обычно они заполняют кучу документов, прежде чем вытащить кого-нибудь из книги мертвых».~
@1038 = ~«Э... контракт? Нет, не помню, чтобы подписывал контракт. Я... почти ничего не помню».~
@1039 = ~«Книга мертвых?»~
@1040 = ~«Документов?»~
@1041 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1042 = ~«Ну да, 'книга мертвых'. Знаешь про такую? А может и не знаешь. Слушай, забудь про 'книгу мертвых'. Ты живой, значит, тебя в ней нет».~
@1043 = ~«Ага, от этого так и хочется ломать кирпичи? Сигил вращается благодаря законам, и нельзя даже облегчиться, не подписав пару контрактов».~
@1044 = ~«Во имя богов и их матерей, ты что, *вообще* не в курсе? Ты хоть представляешь, откуда ты? Наверно, у народа бестолочей пропал их царь. Ты что, показал какому-нибудь богу кукиш, или всегда был таким недалеким?»~
@1045 = ~«Шеф, я без зеленого понятия. А вот ты точно набил руку, изображая из себя мертвеца. Пока ты здесь лежал, я не заметил, чтобы ты моргал или дышал... ничего. Ты что, напился? Что произошло?»~
@1046 = ~«Что ж, вот *это* хороший вопрос. Для тебя, шеф, часы снова начали тикать. Тебя найдут тленные и попытаются исправить 'проблему' с твоим воскрешением, засунув тебя в крематорий. Если и дальше будешь изображать труп, ты так или иначе попадешь в крематорий. Значит, выбор, как у модрона? Что делать?»~
@1047 = ~«Тленные?»~
@1048 = ~«Я... сбегу».~
@1049 = ~«Я все объясню этим... тленным».~
@1050 = ~«Что мне делать?»~
@1051 = ~«Почему бы тебе не сказать? Похоже, у тебя уже заготовлен ответ».~
@1052 = ~«О, *отличная* идея, шеф! Почему *я* до этого не додумался? И как же ты сбежишь? Даю подсказку: нужно небольшое сотрудничество».~
@1053 = ~«Ты меня заинтересовал. Продолжай».~
@1054 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1055 = ~«Как мне кажется, тебе явно нужно отсюда выбираться. Что до меня, то я могу позволить себе подождать. Единственное, то угрожает *мне*, — это смерть от скуки. Мы могли бы протянуть друг другу руку помощи».~
@1056 = ~~
@1057 = ~«По рукам».~
@1058 = ~«Продолжай...»~
@1059 = ~«У тебя нет рук. Как *ты* можешь мне помочь?»~
@1060 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1061 = ~«Может, ты так и не считаешь, но я мог бы помочь выбраться тебе, а ты — мне. У меня нет рук, так что я в слегка затруднительном положении. У тебя недостача в черепушке, а вот у меня много опыта и знаний, как вывести тебя из этой хибары. Будем сотрудничать — оба выберемся *наружу*. По рукам, пень?»~
@1062 = ~«По рукам. У меня есть дурное предчувствие, что нам судьбой предрешено путешествовать вместе, Морт».~
@1063 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1064 = ~«О, *отличная* мысль, шеф! Почему *я* до этого не додумался? — его тон становится насмешливым. — 'Кстати, сэр Тленный, я тут умер и очнулся на плите в вашем маленьком Морге. Вы мне не поможете?' Они тебе 'помогут', куда уж там. Поглядят на тебя пару секунд, потом позовут стражу и закинут тебя в персональную топку».~
@1065 = ~«Звучит, как какие-то крайности... Зачем им это делать?»~
@1066 = ~«Что ж, стража у них должна быть чертовски крутой, чтобы взять меня».~
@1067 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1068 = ~«Просто поверь мне... Неважно, насколько крутым ты себя считаешь и что ты им скажешь, — они тебя схватят. Ты не настолько силен, чтобы пробиться через стены гробницы или пережить жар стихийного плана огня. Пробуждение из мертвых — не лучшая затея, пока вокруг столько стражи. Не будь идиотом».~
@1069 = ~«И каков твой план?..»~
@1070 = ~«Неважно. У меня есть другие вопросы...»~
@1071 = ~«Судьба может присесть на алебарду — мне-то какое дело. Слушай, шеф. Обрати внимание на то, как часто слова 'плохой' и 'судьба' встречаются в одном и том же предложении, и тебе откроется одна из тайн жизни. Лучше всего сказать судьбе завернуться в остролистник: *всегда* есть другой вариант, который судьба не показывает». ~
@1072 = ~«Ну хорошо... а теперь вперед, сваливаем отсюда. Двери выхода заперты, так что нам понадобится ключ. Есть шанс, что он у одного из ходячих трупов в этой комнате».~
@1073 = ~«Буду иметь в виду».~
@1074 = ~«Хватит болтовни. Так какой у тебя план?»~
@1075 = ~«Кто ты?»~
@1076 = ~«Где я?»~
@1077 = ~«Ты знаешь, как мне отсюда выбраться?»~
@1078 = ~«Как я попал сюда?»~
@1079 = ~«Ходячих трупов?»~
@1080 = ~«Как я попал сюда?»~
@1081 = ~Не обращать внимания на Морта и изучить комнату.~
@1082 = ~«Трухлявые? Они смотрят за этим местом. Ты их не пропустишь... Они питают особую тягу к черному цвету и окоченевшему выражению лица. Они зовут себя 'тленными' и притворяются фракцией, но они — всего лишь кучка свихнувшихся упырей, поклоняющихся смерти. Держись от них подальше».~
@1083 = ~«И как мне выбраться отсюда?»~
@1084 = ~«Неважно. У меня есть другие вопросы...»~
@1085 = ~Не обращать внимания на Морта и изучить комнату.~
@1086 = ~Не обращать внимания на Морта и изучить комнату.~
@1087 = ~Не обращать внимания на Морта и изучить комнату.~
@1088 = ~«Что там написано?»~
@1089 = ~«Неважно. У меня есть другие вопросы...»~
@1090 = ~Не обращать внимания на Морта и изучить комнату.~
@1091 = ~«Да? И *какие* же вопросы?»~
@1092 = ~«Кто ты?»~
@1093 = ~«Где я?»~
@1094 = ~«Как я попал сюда?»~
@1095 = ~«Как мне выбраться отсюда?»~
@1096 = ~Не обращать внимания на Морта и изучить комнату.~
@1097 = ~«Я не знаю... Я ничего не могу вспомнить».~
@1098 = ~«Неважно. У меня есть другие вопросы...»~
@1099 = ~Не обращать внимания на Морта и изучить комнату.~
@1100 = ~«Ты что *ничего* не помнишь? Брось, да это же куча танаррьего дерьма. Ты серьезно?»~
@1101 = ~«Да».~
@1102 = ~«Неважно. У меня есть другие вопросы...»~
@1103 = ~Не обращать внимания на Морта и изучить комнату.~
@1104 = ~«Во имя всех богов и их матерей... Э-э, шеф, скорее всего, твои воспоминания просто погрузились глубоко в твою черепушку. Если повезет, они скоро всплывут, поверь мне. Должно быть, нелегкая у тебя ночка выдалась. Надеюсь, ты никого не покалечил и не повздорил со стражей... Кстати говоря, ты случайно не один из тех чувствующих, которые занимаются членовредительством, или это кто-то другой подарил тебе эти шрамы?» ~
@1105 = ~«Чувствующих?»~
@1106 = ~«Шрамы?»~
@1107 = ~«У меня есть другие вопросы...»~
@1108 = ~Не обращать внимания на Морта и изучить комнату.~
@1109 = ~«Разве я должен здесь быть? Я мертв?»~
@1110 = ~«*Как* я выгляжу? Насколько плохи мои шрамы?»~
@1111 = ~«Неважно. У меня есть другие вопросы...»~
@1112 = ~Не обращать внимания на Морта и изучить комнату.~
@1113 = ~«Разве я должен здесь быть? Я мертв?»~
@1114 = ~«Как я выгляжу? Насколько плохи мои шрамы?»~
@1115 = ~«Неважно. У меня есть другие вопросы...»~
@1116 = ~Не обращать внимания на Морта и изучить комнату.~
@1117 = ~«Похоже на указания... — Морт прочищает горло. — Посмотрим... начинается с...»

ЗАМЕТКА: «Я знаю, что ты чувствуешь себя так, как будто ты выпил несколько бочонков помоев из Стикса, но тебе надо сосредоточиться. Среди твоих вещей должен быть ДНЕВНИК, который прольет свет на это темное дело. ФАРОД сможет дополнить оставшуюся часть истории, если его еще не записали в книгу мертвых.

Не потеряй этот клочок кожи ИЛИ дневник, иначе мы снова окажемся в Стиксе, понятно? И поверь мне, что бы ты не делал, НЕ ГОВОРИ никому, КТО ты, ЧТО случилось с тобой или ОТКУДА ты пришел, иначе ты окажешься на полпути в крематорий».~
@1118 = ~«Неудивительно, что моя спина болит. Ты знаешь кого-нибудь с именем Фарод?»~
@1119 = ~«Ты не видел при мне дневника, когда я там лежал?»~
@1120 = ~«Ты знаешь, как мне отсюда выбраться?»~
@1121 = ~«У меня есть другие вопросы...»~
@1122 = ~Не обращать внимания на Морта и изучить комнату.~
@1123 = ~«Нет... тебя обобрали догола, когда доставили сюда. Хотя, с другой стороны, похоже, что достаточно того дневника, что выбит у тебя на теле».~
@1124 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@1125 = ~«Как мне выбраться отсюда?»~
@1126 = ~«Неважно. У меня есть другие вопросы...»~
@1127 = ~Не обращать внимания на Морта и изучить комнату.~
@1128 = ~«Нет, не знаю. С другой стороны, я вообще мало кого знаю. В общем, кто-нибудь да знает, как добраться до этого Фарода... то есть, как только мы выберемся отсюда».~
@1129 = ~«При мне не было дневника, когда я там лежал?»~
@1130 = ~«Как мне выбраться отсюда?»~
@1131 = ~«Неважно. У меня есть другие вопросы...»~
@1132 = ~Не обращать внимания на Морта и изучить комнату.~
@1133 = ~«Может, я умер? И поэтому я здесь?»~
@1134 = ~«Насколько плохо я выгляжу?»~
@1135 = ~«Неважно. У меня есть другие вопросы...»~
@1136 = ~Не обращать внимания на Морта и изучить комнату.~
@1137 = ~Не обращать внимания на Морта и изучить комнату.~
@1138 = ~Не обращать внимания на Морта и изучить комнату.~
@1139 = ~«Я не знаю... Я ничего не могу вспомнить».~
@1140 = ~«Неважно. У меня есть другие вопросы...»~
@1141 = ~Не обращать внимания на Морта и изучить комнату.~
@1142 = ~Не обращать внимания на Морта и изучить комнату.~
@1143 = ~Не обращать внимания на Морта и изучить комнату.~
@1144 = ~Не обращать внимания на Морта и изучить комнату.~
@1145 = ~Не обращать внимания на Морта и изучить комнату.~
@1146 = ~Не обращать внимания на Морта и изучить комнату.~
@1147 = ~«Нет уж, спасибо. От твоей трескотни голова раскалывается. Я сам найду выход».~
@1148 = ~Не обращать внимания на Морта и изучить комнату.~
@1149 = ~Не обращать внимания на Морта и изучить комнату.~
@1150 = ~Не обращать внимания на Морта и изучить комнату.~
@1151 = ~«Что это за документ... контракт... о котором ты говорил?»~
@1152 = ~«У меня есть другие вопросы...»~
@1153 = ~Не обращать внимания на Морта и изучить комнату.~
@1154 = ~«Что ты там говорил насчет книги мертвых?»~
@1155 = ~«Неважно. У меня есть другие вопросы...»~
@1156 = ~Не обращать внимания на Морта и изучить комнату.~
@1157 = ~«Тогда прощай». ~
@1158 = ~«Знаешь, мне известно, что ты не зомби. Ты никого не одурачишь».~
@1159 = ~Труп не отвечает. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@1160 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@1161 = ~Оставить труп в покое.~
@1162 = ~Этот скелет не реагирует. Кажется, он далек от того, чтобы отвечать на твои вопросы.~
@1163 = ~Оставить скелет в покое.~
@1164 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать, не похоже, что у тебя есть хоть что-то, что можно было прятать».~
@1165 = ~«Как долго ты здесь стоишь? Наверно, давно?»~
@1166 = ~Похоже, скелет мертв уже слишком давно, чтобы отвечать на твои вопросы. Либо это, либо его голова находится слишком высоко, чтобы услышать тебя.~
@1167 = ~Осмотреть гигантского скелета... осторожно.~
@1168 = ~«Что это за место?»~
@1169 = ~«У меня есть пара вопросов...» ~
@1170 = ~Оставить ее в покое.~
@1171 = ~Тленная подпрыгивает от неожиданности. Затем она поворачивает к тебе голову. Она выглядит потрясенной: должно быть, маскировка у тебя весьма неплохая.~
@1172 = ~Воспользоваться эффектом неожиданности и свернуть ей шею, пока она не позвала на помощь.~
@1173 = ~Огромный гехрелет~
@1174 = ~«У меня есть несколько вопросов». ~
@1175 = ~Уйти. Быстро.~
@1176 = ~Тленная отступает на шаг, затем быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@1177 = ~Эта бледная женщина одета в длинную темную мантию. От нее слегка отдает плесенью. Ее лицо ничего не выражает; кажется, она поглощена своими обязанностями.~
@1178 = ~Тленная медленно поднимает свою голову и оборачивается к тебе. «Ты потерялся?»~
@1179 = ~«Я позову стражу, они тебя живо выведут. Погоди минутку».~
@1180 = ~«Если ты не потерялся, то что же ты здесь делаешь?»~
@1181 = ~«Боюсь, что меня касается. Может, стражники развяжут твой язык». Тленная делает шаг назад, кажется, она собирается позвать стражников.~
@1182 = ~«Любишь пошутить? Тогда может поделишься своими шутками со стражниками». Тленная отступает на шаг; кажется, она собирается позвать стражников.~
@1183 = ~«Кого ты хочешь увидеть?»~
@1184 = ~«Дхолла можно найти в приемной комнате на этом этаже. Должна предупредить... Дхолл очень занят, а здоровье у него подкошено. Если у тебя к нему несрочное дело, то лучше не беспокоить его».~
@1185 = ~«Дхолл скорее всего в приемной комнате на втором этаже. Он очень занят, а здоровье у него подкошено. Если у тебя к нему несрочное дело, то лучше не беспокоить его».~
@1186 = ~«Дейонаррой? На первом этаже в мемориальном зале похоронена женщина. Может быть, это она?»~
@1187 = ~«Дейонаррой? В северо-западном мемориальном зале похоронена женщина. Может быть, это она?»~
@1188 = ~«Скорее всего, Соэго находится у главных ворот на первом этаже. Он работает проводником в часы антипика».~
@1189 = ~«Скорее всего, Соэго находится у главных ворот. Он работает проводником в часы антипика».~
@1190 = ~«Кто был погребен? Возможно, служба проводится в другом конце Морга».~
@1191 = ~«По всему периметру Морга расположены погребальные залы. Они расположены вдоль стены на первом и втором этажах. Тебе известно имя усопшего?»~
@1192 = ~«Тогда тебе стоит поговорить с одним из проводников у главных ворот. Они тебе помогут».~
@1193 = ~Тленная ждет.~
@1194 = ~«Понятно. И что же ты здесь делаешь?»~
@1195 = ~«Это имя мне незнакомо. Справься у одного из проводников у главных ворот... они смогут сориентировать тебя лучше, чем я».~
@1196 = ~Эта бледная женщина одета в длинную темную мантию. От нее слегка отдает плесенью. Ее лицо ничего не выражает; кажется, она поглощена своими обязанностями.~
@1197 = ~Она медленно оборачивается, ее взгляд мельком скользит по твоей одежде. «Приветствую тебя, посвященный».~
@1198 = ~«У меня такой же вопрос. Твое лицо мне незнакомо. Как тебя зовут?»~
@1199 = ~«Это Морг...» Тленная какое-то время смотрит на тебя, как бы оценивая только что тобою сказанное. «Как, ты сказал, тебя зовут?»~
@1200 = ~Тленная терпеливо ждет твоего продолжения.~
@1201 = ~«Ты можешь просто выйти через главные ворота. Они на первом этаже».~
@1202 = ~«Это имя... — тленная на секунду умолкает. — Это имя *звучит* знакомо... Кажется, я припоминаю сборщика с таким именем. Писец Дхолл может знать о нем больше».~
@1203 = ~«Сборщики... они собирают тех, кто умер на улицах Сигила, и доставляют их в Морг... — тленная умолкает, хмуря брови. — Ты нездешний. Кто ты?»~
@1204 = ~«Дхолл — один из самых уважаемых членов нашей фракции. Наверное, никто не размышлял о сущности Истинной Смерти и не заслужил ее больше, чем он. У него много знаний, которыми он может поделиться. Если ты незнаком с ним, то я советую тебе как можно раньше воспользоваться этой возможностью. Ему осталось не так долго жить в тени этого существования».~
@1205 = ~Кивок. «Дхолл болен. Он стар, даже по меркам гитцераев. Несомненно, смерть последует за болезнью, которую он подхватил. Ему повезло».~
@1206 = ~«Дхолл находится в приемной комнате в северо-западной части этого этажа. Должна предупредить... Дхолл очень занят... то время, которое он не занят своими обязанностями, отбирает у него болезнь».~
@1207 = ~«Дхолл скорее всего в приемной комнате на втором этаже. Лучше не отвлекай его слишком сильно — он очень занят... то время, которое он не занят своими обязанностями, отбирает у него болезнь».~
@1208 = ~«Да, гитцераи живут гораздо дольше, чем люди».~
@1209 = ~«Гитцерай — это... — тленная умолкает, пристально глядя на тебя. — Ты ведь нездешний. Кто ты?»~
@1210 = ~«Ему повезло в том, что он достигнет Истинной Смерти. Он больше не будет странствовать в тени этого существования».~
@1211 = ~Тленная кивает. «Да». Она хмурится, затем пристально смотрит на тебя. «Ты нездешний. Кто ты?»~
@1212 = ~«Ты не из наших. Кто ты? Что ты здесь делаешь? Ты из анархистов? Или шпион другой фракции? — Тленная отступает на шаг. — Стража! Стража!»~
@1213 = ~«Дневник? Не встречала такого».~
@1214 = ~Эта бледная женщина одета в длинную темную мантию. От нее слегка отдает плесенью. Ее лицо ничего не выражает; кажется, она поглощена своими обязанностями.~
@1215 = ~Тленная не успевает и слова вымолвить, как твои руки хватают ее голову за виски и резко сворачивают ее влево. ~
@1216 = ~В шее раздается характерный хруст, и тело тленной безвольно падает в твои объятия.~
@1217 = ~К своему удивлению, это действие происходит практически инстинктивно, будто ты проделывал это уже много раз... с этой мыслью всплывает воспоминание, но оно недостаточно сильно для того, чтобы за него зацепиться.~
@1218 = ~Ты недостаточно быстр, и тленная уворачивается от твоего выпада. Отступив на шаг, она быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@1219 = ~Ты наклоняешься, чтобы «шепнуть» ей что-то на ухо, тленная тоже наклоняется. Как только она оказывается на расстоянии вытянутой руки, ты хватаешь ее за виски и резко сворачиваешь голову влево. ~
@1220 = ~Тленная явно что-то подозревает. Похоже, она хочет что-то сказать, затем едва заметно качает головой и возвращается к своим обязанностям.~
@1221 = ~Тленная внимательно тебя осматривает. «Ты не из наших. Что ты здесь делаешь? Ты из анархистов? Или шпион другой фракции? Кажется, здесь есть дело для стражников...»~
@1222 = ~Тленная кивает и возвращается к своим делам.~
@1223 = ~Тленная хмурится. «Это имя мне незнакомо».~
@1224 = ~Тленная продолжает хмуриться, но затем слегка кивает. «Ну хорошо. Что я могу сделать для тебя, посвященный?»~
@1225 = ~«Ну хорошо...»~
@1226 = ~«Приветствую».~
@1227 = ~«Кто ты?»~
@1228 = ~«Что это за место?»~
@1229 = ~«У меня есть пара вопросов...» ~
@1230 = ~Оставить ее в покое.~
@1231 = ~«Да».~
@1232 = ~«Нет».~
@1233 = ~«Нет, я не потерялся. У меня есть несколько вопросов...»~
@1234 = ~«Прощай».~
@1235 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@1236 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@1237 = ~Уйти. Быстро.~
@1238 = ~Подождать.~
@1239 = ~«Это тебя не касается».~
@1240 = ~«Я очнулся на одной из плит в вашей препараторской».~
@1241 = ~«Я хочу повидаться кое с кем».~
@1242 = ~«Я пришел сюда на похороны, но, похоже, произошла ошибка».~
@1243 = ~Уйти. Быстро.~
@1244 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@1245 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@1246 = ~«Давай, зови их. Буду рад с ними встретиться».~
@1247 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@1248 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@1249 = ~«Давай, зови их. Буду рад с ними встретиться».~
@1250 = ~Это не твое дело.~
@1251 = ~«Это не твое дело».~
@1252 = ~«Да, его зовут «Смерть-Имен». Прощай».~
@1253 = ~«Я хочу повидаться с Дхоллом».~
@1254 = ~Уйти.~
@1255 = ~«Я хочу повидаться с Дхоллом».~
@1256 = ~Мемориальный зал~
@1257 = ~Главный зал~
@1258 = ~«Я хочу повидаться с Дейонаррой».~
@1259 = ~«Хорошо. Спасибо за информацию».~
@1260 = ~«Хорошо. Спасибо за информацию».~
@1261 = ~«Скорее всего. Спасибо».~
@1262 = ~«Скорее всего. Спасибо».~
@1263 = ~«Отлично. Спасибо».~
@1264 = ~«Отлично. Спасибо».~
@1265 = ~«Ты не понимаешь... ошибка в том, что похоронить собирались МЕНЯ».~
@1266 = ~«Может быть. Где еще проводят службу?»~
@1267 = ~«Ты можешь указать выход отсюда?»~
@1268 = ~«Нет».~
@1269 = ~«Да».~
@1270 = ~«Отлично. Спасибо».~
@1271 = ~«Прошу прощения... Я оговорился. Мне неизвестно имя усопшего».~
@1272 = ~«Это имя — Дейонарра».~
@1273 = ~Ложь: «Имя... э-э, Адан».~
@1274 = ~Ложь: «Имя... э-э, Адан».~
@1275 = ~Наклониться вперед, будто собираясь прошептать ей что-то на ухо, а затем свернуть ей шею.~
@1276 = ~Наклониться вперед, будто собираясь прошептать ей что-то на ухо, а затем свернуть ей шею.~
@1277 = ~Убежать от нее.~
@1278 = ~«Это не твое дело».~
@1279 = ~«Я очнулся на одной из плит в вашей препараторской».~
@1280 = ~«Я хочу повидаться кое с кем».~
@1281 = ~«Я пришел сюда на похороны, но, похоже, произошла ошибка».~
@1282 = ~Убежать от нее.~
@1283 = ~«Хорошо. Я так и сделаю. Прощай».~
@1284 = ~«Приветствую».~
@1285 = ~Оставить ее в покое.~
@1286 = ~«Кто ты?»~
@1287 = ~«Что это за место?»~
@1288 = ~«У меня есть пара вопросов...» ~
@1289 = ~Оставить ее в покое.~
@1290 = ~Ложь: «Имя... э-э, Адан».~
@1291 = ~Ложь: «Имя... э-э, Адан».~
@1292 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@1293 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@1294 = ~Ложь: «Имя... э-э, Адан».~
@1295 = ~Ложь: «Имя... э-э, Адан».~
@1296 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@1297 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@1298 = ~«Можешь показать мне, где выход?»~
@1299 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@1300 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@1301 = ~«Всего лишь поверхностные раны? Что ты имеешь в виду?»~
@1302 = ~«Расскажи мне побольше о Морге».~
@1303 = ~«Хорошо. У меня есть другие вопросы...»~
@1304 = ~«Пусть будет так. Прощай, Дхолл».~
@1305 = ~«Расскажи мне побольше о Морге».~
@1306 = ~«Слушай, *зомби*, вопросы здесь задаю я. Рассказывай, что ты здесь делаешь, или я сделаю эту маскировку настоящей».~
@1307 = ~«Я больше не хочу мучить тебя. Прощай».~
@1308 = ~«Ничего не происходит. Прощай... Дейонарра».~
@1309 = ~«Пока нет. Прощай, Дейонарра».~
@1310 = ~«Я должен идти, Дейонарра. Прощай».~
@1311 = ~«Если я отказывался от тебя раньше, то, похоже, что мне снова придется это сделать. Прощай, дух».~
@1312 = ~«Я должен идти, Дейонарра. Прощай».~
@1313 = ~«Хорошо...»~
@1314 = ~«Пока ничем, Дейонарра, но я обязательно вернусь. Прощай».~
@1315 = ~«Можешь ли ты снять проклятие, которое ты наложила на меня?»~
@1316 = ~«Я должен идти. Прощай, Дейонарра».~
@1317 = ~«Нет! Нет!..»~
@1318 = ~«Я должен идти. Прощай, Дейонарра».~
@1319 = ~«Я должен идти. Прощай, Дейонарра».~
@1320 = ~«Прощай, Дейонарра».~
@1321 = ~«Прощай, Дейонарра».~
@1322 = ~«Тогда прощай, Дейонарра».~
@1323 = ~«Тогда прощай, Дейонарра».~
@1324 = ~«Прощай, Дейонарра».~
@1325 = ~«Прощай, Дейонарра».~
@1326 = ~«Тогда я расспрошу одного из них. Прощай, Дейонарра».~
@1327 = ~«*Кто* ты?»~
@1328 = ~«Неважно. Извини за беспокойство».~
@1329 = ~«У меня есть другие вопросы...»~
@1330 = ~«Спасибо. Прощай».~
@1331 = ~«Сборщика?»~
@1332 = ~Уйти. Быстро.~
@1333 = ~Подождать.~
@1334 = ~«Дхолл?»~
@1335 = ~Наклониться вперед, будто собираясь прошептать ему что-то на ухо, а затем свернуть ему шею.~
@1336 = ~Убежать от него.~
@1337 = ~Ложь: «Меня зовут... э-э, Адан».~
@1338 = ~«У меня есть другие вопросы...»~
@1339 = ~«Тс-с! Я не смогу тебе ответить под такой крик!»~
@1340 = ~Использовать на скелете свою способность «История костей».~
@1341 = ~Внимательно осмотреть скелет.~
@1342 = ~Использовать на скелете свою способность «История костей».~
@1343 = ~«Было приятно поболтать с тобой. Прощай».~
@1344 = ~Оставить зомби в покое.~
@1345 = ~Использовать на скелете свою способность «История костей».~
@1346 = ~«Было приятно поболтать с тобой. Прощай».~
@1347 = ~Оставить труп в покое.~
@1348 = ~«Слушай, *зомби*, вопросы здесь задаю я. Рассказывай, что ты здесь делаешь, или я сделаю эту маскировку настоящей».~
@1349 = ~«Я должен идти. Прощай».~
@1350 = ~Он изучает тебя более пристально. «Ты фпион? Ты иф яфейки?»~
@1351 = ~А?~
@1352 = ~«Яфейки?»~
@1353 = ~Тифлинг-головорез~
@1354 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@1355 = ~Использовать на трупе свою способность «История костей».~
@1356 = ~Грист~
@1357 = ~«Было приятно поболтать с тобой. Прощай».~
@1358 = ~Оставить труп в покое.~
@1359 = ~Ложь: «Да... Я искал тебя. И очень рад, что нашел».~
@1360 = ~Ложь: «Да... но я не могу сейчас об этом говорить, если ты понимаешь, что я имею в виду. Какова *твоя* миссия здесь?»~
@1361 = ~Ложь: «Да... но я не могу говорить об этом сейчас. Что ты делаешь здесь?»~
@1362 = ~«Э-э, сейчас у меня нет времени на разговоры... может, как-нибудь в другой раз».~
@1363 = ~Он изучает тебя более пристально. «Ты фпион? Ты иф яфейки?»~
@1364 = ~«Я должен идти. Прощай, Захария».~
@1365 = ~«Я должен идти. Прощай, Захария».~
@1366 = ~«Очень похоже. Я должен идти. Прощай, Захария».~
@1367 = ~«Сейчас я не могу, я должен идти. Прощай, Захария».~
@1368 = ~«Я должен идти. Прощай, Захария».~
@1369 = ~«Я должен идти. Прощай, Захария».~
@1370 = ~ «Спасибо за информацию. Прощай, Захария».~
@1371 = ~«Я выслушал достаточно. Прощай, Захария».~
@1372 = ~«Я выслушал достаточно. Прощай, Захария».~
@1373 = ~«Я выслушал достаточно. Прощай, Захария».~
@1374 = ~«Возможно, мне это удастся. Прощай, Захария».~
@1375 = ~«Хм-м-м. Интересно. Спасибо, Захария».~
@1376 = ~«Это хорошо. Прощай, Захария».~
@1377 = ~«Я должен идти. Прощай, Захария».~
@1378 = ~«Ничего... Мне нужно идти. Прощай, Захария».~
@1379 = ~«Понятно... Я должен идти. Прощай, Захария».~
@1380 = ~«Я должен идти. Прощай».~
@1381 = ~«Я должен идти. Прощай».~
@1382 = ~«Мне нужно идти. Прощай».~
@1383 = ~«Мне нужно идти. Прощай».~
@1384 = ~«Понятно. Интересно, *почему* это было необходимо. Надо поговорить об этом с Дхоллом... Прощай».~
@1385 = ~«Мне нужно идти. Прощай».~
@1386 = ~«Пойду-ка, поищу этого зомби. Прощай».~
@1387 = ~«У меня больше нет времени на разговоры. Прощай».~
@1388 = ~«У меня больше нет времени на разговоры. Прощай».~
@1389 = ~«У меня больше нет времени на разговоры. Прощай».~
@1390 = ~«Я выслушал достаточно. Прощай».~
@1391 = ~«Я должен идти. Прощай, Захария».~
@1392 = ~«Я должен идти. Прощай».~
@1393 = ~«У меня больше нет времени на разговоры, Захария. Прощай».~
@1394 = ~«Я не могу долго говорить, мне нужно идти. Прощай».~
@1395 = ~«Спасибо за уделенное время. Прощай».~
@1396 = ~«Я недавно посвящен. Прости мое невежество».~
@1397 = ~«Я... недавно здесь. Я... пытаюсь изучить обстановку».~
@1398 = ~«Ну... к чему имена? Храни веру, э-э, посвященная».~
@1399 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@1400 = ~Главные ворота~
@1401 = ~Недостаточно места на диске. Planescape: Torment не может быть запущена.~
@1402 = ~ИГРАТЬ В TORMENT~
@1403 = ~Готово~
@1404 = ~Законопослушный добрый~
@1405 = ~Законопослушный нейтральный~
@1406 = ~Законопослушный злой~
@1407 = ~Тленный хмурится, когда ты проходишь мимо, затем обращается к тебе. «Эй, ты. Что ты здесь делаешь?»~
@1408 = ~«Я направляюсь к выходу, только и всего. Я не хочу создавать проблем».~
@1409 = ~«Кажется, я заблудился в этих залах. Здесь есть проводники, которые могут подсказать дорогу посетителям?»~
@1410 = ~«Я... кажется, потерялся». ~
@1411 = ~«Это мое личное дело. А тебе бы не мешало заниматься СВОИМИ делами, тленный».~
@1412 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем свернуть ему шею.~
@1413 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем свернуть ему шею.~
@1414 = ~Тленный хмурится. Кажется, он скептически настроен. «В вестибюле есть проводники, которые могут направить тебя. В Морге нельзя ходить без сопровождения».~
@1415 = ~«Спасибо за помощь. Пойду поговорю с проводником».~
@1416 = ~«Я буду ходить там, где мне вздумается... а тебе бы не мешало думать о своих обязанностях, тленный».~
@1417 = ~«Похоже, ты действительно потерялся». Глаза тленного сужаются в узкие щели, его рука тянется к кинжалу на боку. «Подожди, пока я не позову охрану, которые выведут тебя». Кажется, он готов позвать на помощь. ~
@1418 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1419 = ~Этот бледный мужчина одет в длинную темную мантию. От него слегка отдает плесенью. Его лицо ничего не выражает; кажется, он полностью поглощен своими обязанностями.~
@1420 = ~«Приветствую».~
@1421 = ~«Приветствую».~
@1422 = ~«Приветствую».~
@1423 = ~«Приветствую».~
@1424 = ~Оставить его в покое.~
@1425 = ~Тленный не успевает и слова вымолвить, как твои руки хватают его голову за виски и резко сворачивают ее влево. ~
@1426 = ~«Нельзя дать тебе предупредить своих друзей...»~
@1427 = ~В шее раздается характерный хруст, и тело тленного безвольно падает в твои объятия.~
@1428 = ~«Лучше ты, чем я, трухлявый». ~
@1429 = ~«Лучше ты, чем я, трухлявый». ~
@1430 = ~К своему удивлению, это действие происходит практически инстинктивно, будто ты проделывал это уже много раз... с этой мыслью всплывает воспоминание, но оно недостаточно сильно для того, чтобы за него зацепиться.~
@1431 = ~Перед тобой устало выглядящий мужчина в выцветших черных одеждах. Его худощавое лицо слишком бледное, как будто он давно не спал. Его плечи осунулись, под налитыми кровью глазами видны мешки. Похоже, он не заметил тебя... Должно быть, он спутал тебя с одним из мертвых рабочих.~
@1432 = ~«Приветствую».~
@1433 = ~«Кто ты?»~
@1434 = ~«Что это за место?»~
@1435 = ~«У меня есть несколько вопросов...» ~
@1436 = ~Оставить его в покое.~
@1437 = ~Когда ты обращаешься к тленному, он резко поднимает голову: «Про... прошу прощения? Ты что-то сказал мне?»~
@1438 = ~«Да. У меня есть несколько вопросов...»~
@1439 = ~«Нет. Нет, это не я».~
@1440 = ~Стать тихим как покойник.~
@1441 = ~Стать тихим как покойник.~
@1442 = ~Уйти. Быстро.~
@1443 = ~«О, силы!» Тленный подпрыгивает, затем внимательно смотрит на тебя. Ты замечаешь, что его глаза не налиты кровью, а просто имеют красный оттенок. «Эй, ты заставляешь меня сделать нелестное признание: из тебя вышел убедительный зомби, — он делает легкий поклон. — Я Соэго. Могу ли я спросить тебя, что ты делаешь здесь, — он косится на твои шрамы, — в таком виде?» ~
@1444 = ~«Это не твое дело».~
@1445 = ~«Я не совсем понимаю, что я здесь делаю. Я очнулся на одной из плит наверху, и моя память... немного туманна».~
@1446 = ~«Я заблудился в этих залах и теперь не могу найти выход. Ты можешь мне помочь?»~
@1447 = ~«Я пытаюсь выбраться отсюда».~
@1448 = ~«Мне были нужны перемены в жизни».~
@1449 = ~Тленный некоторое время изучает тебя, затем трясет головой. «Опять почудилось... — вздыхает он и трет глаза. — Эти заклинания от лихорадки действуют слишком сильно...»~
@1450 = ~«Это не твое воображение. У меня есть другие вопросы...»~
@1451 = ~Свернуть ему шею, пока он отвлекся.~
@1452 = ~Свернуть ему шею, пока он отвлекся.~
@1453 = ~«У меня есть несколько вопросов». ~
@1454 = ~Тихо уйти.~
@1455 = ~Тленный внимательно смотрит на тебя, затем наклоняется к тебе... его губы раскрываются, обнажая ряд грязных и острых зубов. Он, как крыса, начинает обнюхивать тебя.~
@1456 = ~«Эй... какого черта ты меня обнюхиваешь?»~
@1457 = ~«Послушай, у меня есть вопросы к тебе...»~
@1458 = ~Свернуть ему шею, пока он наклоняется вперед.~
@1459 = ~Свернуть ему шею, пока он наклоняется вперед.~
@1460 = ~Уйти. Быстро.~
@1461 = ~Как только ты собираешься уйти, тленный издает легкое шипение, затем наклоняется вперед и обнюхивает тебя. «О, силы!» Тленный отступает назад, его глаза широко раскрыты. Ты замечаешь, что его глаза не налиты кровью, а просто имеют красный оттенок. «Эй, ты заставляешь меня сделать нелестное признание: из тебя вышел убедительный зомби, — он слегка кивает. — Я Соэго. Могу ли я спросить, что ты здесь делаешь... в таком виде?» ~
@1462 = ~«Это не твое дело».~
@1463 = ~«Я не совсем понимаю, что я здесь делаю. Я очнулся на одной из плит наверху, и моя память... немного туманна».~
@1464 = ~«Я заблудился и ищу выход. Ты можешь мне помочь?»~
@1465 = ~«Я пытаюсь выбраться отсюда».~
@1466 = ~«Мне были нужны перемены в жизни».~
@1467 = ~«У меня совершенно нет на это времени. Прощай».~
@1468 = ~«О, боюсь, что это *как раз* мое дело». Глаза Соэго блестят красным, уголки его рта слегка подергиваются, словно в предвкушении. «Может... — он широко ухмыляется, показывая ряд острых грязных зубов. — Может, мне стоит позвать охрану? Да... да, пожалуй, я так и сделаю».~
@1469 = ~«Постой! Я потерялся... Я просто заблудился в этих залах и теперь не могу найти выход. Ты можешь мне помочь?»~
@1470 = ~«Стой! Не надо звать стражу! Я просто хочу выбраться отсюда... ты поможешь мне?»~
@1471 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1472 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1473 = ~«Давай, зови их. Буду рад с ними встретиться».~
@1474 = ~«Правда? — тленный недоверчиво осматривает тебя. — Ты *выглядишь* так, как будто тебя только что вскрыли. Не представляю, как ты смог пережить эту невыносимую боль... тебе *больно*? Кажется, да».~
@1475 = ~«Как я вообще сюда попал?»~
@1476 = ~«У меня нет времени на это. Прощай».~
@1477 = ~Соэго кивает, уголки его рта немного подрагивают. «Ну почему же... конечно. Эти залы *способны* запутать посетителей. В этом нет ничего плохого, но тебе нельзя находиться в Морге после девяти ударов колокола. Позволь мне открыть для тебя ворота».~
@1478 = ~«Спасибо».~
@1479 = ~«Спасибо».~
@1480 = ~Соэго тянется к поясу, шарит по одежде, затем начинает шипеть. «Ключ!» В его глазах появляется яркий красный блеск, а губы складываются в гримасу ярости... выражение лица при этом напоминает звериный оскал. «Кто-то украл ключ!» Он разворачивается к тебе и рычит: «Ты! Это сделал ты!» ~
@1481 = ~Блеф: «Эй... погоди! Зачем мне спрашивать тебя о нем, если я его украл?»~
@1482 = ~Ложь: «О чем это ты?! Мне-то он зачем!»~
@1483 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1484 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1485 = ~«Ну, допустим, я. И что? И что ты мне сделаешь?»~
@1486 = ~Соэго берет огромный ключ с пояса и идет к главным воротам. Ты не можешь не заметить его странной походки... он наклоняется вперед, пытаясь сохранить равновесие. ~
@1487 = ~«Какая странная у него походка».~
@1488 = ~Подождать, пока он открывает ворота.~
@1489 = ~Дойдя до ворот, Соэго вставляет ключ в замок. Спустя мгновение из замочной скважины раздается неприятный звук... Он наполняет весь главный зал, эхом раскатываясь по мраморным стенам. ~
@1490 = ~Подождать, пока он не вернется.~
@1491 = ~«Вот и все. Главные ворота открыты, но вернуться обратно ты не сможешь».~
@1492 = ~«Могу ли я задать пару вопросу перед тем, как уйду?»~
@1493 = ~«Спасибо, Соэго. Я пошел».~
@1494 = ~«Выбраться отсюда? — Соэго хмурится. — А как ты умудрился попасть внутрь?»~
@1495 = ~«Я был здесь на похоронах, отдавал дань уважения. Я уже готов уйти... вот только, кажется, я заблудился. Ты не поможешь мне найти выход?»~
@1496 = ~«Я и сам не знаю».~
@1497 = ~«Я и сам не знаю».~
@1498 = ~«Я очнулся на одной из плит наверху, и моя память... немного туманна».~
@1499 = ~«У меня нет времени на это. Прощай».~
@1500 = ~Соэго цокает языком. «Очень любопытно, — он снова изучает тебя. — А может, ты один из контрактников?»~
@1501 = ~«Э, контрактников?»~
@1502 = ~«У меня совершенно нет на это времени. Прощай».~
@1503 = ~Едва ты собираешься уйти, как тленный перестает тебя обнюхивать и испускает легкое шипение. «О, силы!» Тленный отступает назад, его глаза широко раскрыты. Ты замечаешь, что его глаза не налиты кровью, а просто имеют красный оттенок. «Эй, ты заставляешь меня сделать нелестное признание: из тебя вышел убедительный зомби, — он слегка кивает. — Я Соэго. Могу ли я спросить, что ты здесь делаешь... в таком виде?» ~
@1504 = ~«Это не твое дело».~
@1505 = ~«Я не совсем понимаю, что я здесь делаю. Я очнулся на одной из плит наверху, и моя память... немного туманна».~
@1506 = ~«Я заблудился и ищу выход. Ты можешь мне помочь?»~
@1507 = ~~
@1508 = ~«Я пытаюсь выбраться отсюда».~
@1509 = ~«Мне были нужны перемены в жизни».~
@1510 = ~«У меня совершенно нет на это времени. Прощай».~
@1511 = ~«Понятно...» Глаза Соэго блестят красным, уголки его рта слегка подрагивают, словно в предвкушении. «Может... — он широко ухмыляется, показывая ряд острых грязных зубов. — Может, мне стоит позвать охрану? Да... да, пожалуй, я так и сделаю».~
@1512 = ~«Постой! Я потерялся... Я просто заблудился в этих залах и теперь не могу найти выход. Ты можешь мне помочь?»~
@1513 = ~«Стой! Не надо звать стражу! Я просто хочу выбраться отсюда... ты поможешь мне?»~
@1514 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1515 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1516 = ~«Давай, зови их. Буду рад с ними встретиться».~
@1517 = ~Когда ты собираешься уходить, как Соэго издает злобное шипение... затем он неожиданно успокаивается и поднимает руки. «Нет, нет, боюсь, что ты не можешь уйти. Что-то здесь не так. Мне кажется, что будет лучше, если мы разберемся с этим... — уголки его рта подрагивают, в глазах вспыхивает огонек. — Может, охрана поможет. Да... наверное, мне стоит позвать их».~
@1518 = ~«Постой! Я потерялся... Я просто заблудился в этих залах и теперь не могу найти выход. Ты можешь мне помочь?»~
@1519 = ~«Ты не понимаешь... ошибка в том, что похоронить собирались МЕНЯ».~
@1520 = ~«Стой! Не надо звать стражу! Я просто хочу выбраться отсюда... ты поможешь мне?»~
@1521 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1522 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@1523 = ~«Давай, зови их. Буду рад с ними встретиться».~
@1524 = ~Соэго делает шаг назад, затем быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@1525 = ~«Ну хорошо...»~
@1526 = ~До того, как он смог произнести слово, твои руки хватают его голову за виски, и ты резко сворачиваешь его голову влево. ~
@1527 = ~~
@1528 = ~«Нельзя допустить, чтобы ты предупредил своих друзей».~
@1529 = ~В его шее раздается характерный хруст... но вместо того, чтобы безвольно упасть, тленный издает душераздирающий крик и вырывается из твоей хватки! ~
@1530 = ~«Что?!..»~
@1531 = ~«Что?!..»~
@1532 = ~Кажется, тленный шокирован не меньше тебя. В его глазах безумие, из горла издается булькающие звуки... ты уверен, что свернул ему шею: его голова повернута под неестественным углом, но он все еще жив! Пока ты в оцепенении смотришь на него, он слабо хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@1533 = ~«Ну хорошо...»~
@1534 = ~Должно быть, *что-то* насторожило тленного... до того, как ты смог до него дотянуться, он отскакивает назад. В его глазах вспыхивает красный огонек, он скалит зубы. Шипя, он быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@1535 = ~«Ну хорошо...»~
@1536 = ~Перед тобой один из стражников Проклятого. Он весь в крови и тяжело дышит. «Нет времени на разговоры. Есть свободен — помоги нам с... обороной». Он машет тебе рукой, как бы отпуская.~
@1537 = ~Ну, раз уж ты это вспомнил, то дела мои плохи.~
@1538 = ~«А вот что: какой-то долбаный идиот что-то там освободил, и тут мы — в Карцери, деремся за свою жизнь. Вали отсюда и займись чем-нибудь полезным».~
@1539 = ~«Разве я не сказал тебе заниматься своими делами? Я на полном серьезе! Проваливай!»~
@1540 = ~«Что ты, во имя Девяти Преисподних, тут делаешь?»~
@1541 = ~«Ни с места!» Стражник бросается в атаку!~
@1542 = ~Ты видишь мужчину в старых лохмотьях. При твоем приближении он обходит тебя стороной и продолжает идти.~
@1543 = ~Мужчина игнорирует тебя, ускоряя шаг.~
@1544 = ~Он разворачивается, быстро озирается по сторонам, разыскивая твоих возможных друзей. Он выхватывает кинжал. «Тебе лучше оставить меня в покое или я вдену тебе сталь промеж ребер!»~
@1545 = ~Ты видишь мужчину в старых лохмотьях. При твоем приближении он останавливается и смотрит на тебя.~
@1546 = ~«*Проблемы*, пень?.. Или тебе их *не хватает* до  кучи?» Плюет тебе под ноги. «Вали отсюда, или шрамов добавлю».~
@1547 = ~Ухмыляется. «Уверен, что хочешь, вот только ответов для тебя нет. Исчезни!»~
@1548 = ~«Эй! Подожди на минуточку!»~
@1549 = ~«Приветствую...»~
@1550 = ~Оставить его в покое.~
@1551 = ~«Сэр?»~
@1552 = ~«Эй! Подожди на минуточку!»~
@1553 = ~Оставить его в покое.~
@1554 = ~«Успокойся. Я просто хочу задать несколько вопросов...»~
@1555 = ~Атаковать его.~
@1556 = ~«Тогда прощай». ~
@1557 = ~Он ухмыляется. «Уверен, что хочешь, да вот только ответов у меня для тебя нет. Исчезни!»~
@1558 = ~Атаковать его.~
@1559 = ~«Тогда прощай». ~
@1560 = ~«Приветствую».~
@1561 = ~Оставить его в покое.~
@1562 = ~«Успокойся. Я просто хочу задать несколько вопросов...»~
@1563 = ~Атаковать его.~
@1564 = ~«Тогда прощай». ~
@1565 = ~Атаковать его.~
@1566 = ~«Тогда прощай». ~
@1567 = ~Ты видишь человека в лохмотьях. При твоем приближении он неожиданно начинает в страхе озираться.~
@1568 = ~«Эй, ты! Задержись на минутку!»~
@1569 = ~«Приветствую».~
@1570 = ~Оставить его в покое.~
@1571 = ~Мужчина бросает затравленный взгляд, затем отступает на шаг. «А? Чего тебе надо, рубака?» Его голос дрожит: похоже, на него произвели впечатление твои шрамы. «У меня с собой ничего нет, совсем ничего, а мои тряпки того не стоят».~
@1572 = ~«Успокойся. Я не собираюсь тебя грабить. У меня есть несколько вопросов...»~
@1573 = ~«Попробуй сбежать, и я тебе обещаю, что далеко ты не уйдешь. У меня есть несколько вопросов...»~
@1574 = ~«Ничего. Прощай».~
@1575 = ~«А? — ему не очень-то по душе смотреть на тебя. — И чего тебе *нужно*, рубака?»~
@1576 = ~«У меня есть несколько вопросов...» ~
@1577 = ~«Ничего. Прощай».~
@1578 = ~Он остается на почтительном расстоянии, а глаза мечутся из стороны в сторону, как будто он ждет, что кто-то выйдет из тени. «Вопросы, говоришь?.. И... э... что это за вопросы?»~
@1579 = ~«Что ты можешь сказать о Сигиле?»~
@1580 = ~«Что ты можешь сказать об этом... городе?»~
@1581 = ~«Что ты можешь сказать об этих трущобах?»~
@1582 = ~«Что ты можешь сказать об Улье?»~
@1583 = ~«Что ты можешь сказать о Леди Боли?»~
@1584 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@1585 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@1586 = ~«Э... — он осторожно смотрит на тебя, и его брови в смущении подымаются. — А что ты хочешь знать об Улье, рубака?»~
@1587 = ~«Почему его называют Ульем?»~
@1588 = ~«Что есть интересного в округе?»~
@1589 = ~«Неважно. У меня есть другие вопросы...»~
@1590 = ~«Ничего. Прощай».~
@1591 = ~«Э... и что это за вопросы?»~
@1592 = ~«Что ты можешь сказать об этом... городе?»~
@1593 = ~«Что ты можешь сказать о Сигиле?»~
@1594 = ~«Что ты можешь сказать об этих трущобах?»~
@1595 = ~«Что ты можешь сказать об Улье?»~
@1596 = ~«Что ты можешь сказать о Леди Боли?»~
@1597 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@1598 = ~«Я потерял дневник. Тебе ничего такого не попадалось? Или, может, ты знаешь, где его можно найти?»~
@1599 = ~Он выглядит озадаченным. «Я... не знаю, — он начинает дрожать, осознавая, что не может ответить на вопрос. — Наверное, оттого, что здесь куча-мала из улиц и людей».~
@1600 = ~«Что есть интересного в округе?»~
@1601 = ~«Понятно. У меня есть другие вопросы...»~
@1602 = ~«Тогда неважно. Прощай».~
@1603 = ~«Зависит... э... зависит от того, что ты находишь интересным, рубака».~
@1604 = ~«Я ищу развлечений».~
@1605 = ~«Я ищу развлечений».~
@1606 = ~«Я ищу работу».~
@1607 = ~«Я ищу кое-кого по имени Фарод».~
@1608 = ~«Я ищу потерянный дневник. Ты не знаешь, где я его могу найти?»~
@1609 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@1610 = ~«Ну... — он облизывает губы. — Здесь неподалеку есть бар 'Тлеющий труп'... и бар трухлявых... хотя ты не похож на рубаку, который будет пить пойло вместе с трухлявыми... любое другое место вокруг очень опасно, так что будь настороже».~
@1611 = ~«А где это?»~
@1612 = ~«А что опасного в округе?»~
@1613 = ~«Трухлявых?»~
@1614 = ~«У меня есть другие вопросы...»~
@1615 = ~«Понятно. Спасибо за информацию. Прощай».~
@1616 = ~«Ну, 'Тлеющий труп' находится через несколько кварталов к шпилю... э... к югу, рядом с Моргом. Бар трухлявых чуток юго-западнее Морга».~
@1617 = ~«Да повсюду в Улье, как только стемнеет. А потом еще Угловатый Переулок... тебе лучше держаться от нее подальше, если не хочешь попасть в книгу мертвых».~
@1618 = ~«А почему этот 'Угловатый переулок' такой опасный?»~
@1619 = ~«У меня есть другие вопросы...»~
@1620 = ~ «Спасибо за информацию. Прощай».~
@1621 = ~Он думает. «Непыльной... э, честной... работенки в городе много, если поискать, рубака. Можно поохотиться на мозгогрызунов, а потом сдать их в филиал борьбы с вредителями за пару медяков, но скажу тебе, связываться с мозгогрызунами очень опасно. А можно еще пошататься по Улью, пособирать трупы и притащить их Морг ради пары звенелок».~
@1622 = ~«Он сразу за рынком Улья. Иди к шпилю — это на юг и чуть на восток от Морга, три или четыре квартала, пока не упрешься в тупик. Там он и будет. У входа вечно околачиваются крысоловы, так что ты его не пропустишь».~
@1623 = ~«А где этот филиал?»~
@1624 = ~«Мозгогрызунов?»~
@1625 = ~«Собирать трупы?»~
@1626 = ~«У меня есть другие вопросы...»~
@1627 = ~«Понятно. Спасибо за информацию. Прощай».~
@1628 = ~«Ага, трухлявые платят звенелки за трупы, которые ты притащишь к их воротам. Много не заработаешь, но для сборщиков этого хватает... да и к тому же, трупов всегда хватает».~
@1629 = ~«А где филиал, про который ты говорил?»~
@1630 = ~«А что ты там говорил о 'мозгогрызунах'?»~
@1631 = ~«Трухлявых?»~
@1632 = ~«Какая еще работа есть в Улье?»~
@1633 = ~«Сборщиков?»~
@1634 = ~«Ага, мерзкие маленькие твари». Он растягивается в широкой крысиной улыбке. Выглядит он при этом очень глупо. «Поодиночке они ничего сделать не могут... но если мозгогрызуны соберутся вместе, то становятся намного умнее, чем по отдельности. Они начинают думать, как человек... — он качает головой. — И никто не знает, что там копошится в их головах. Но здоровья этого не прибавит, уж поверь».~
@1635 = ~«Ага... Трухлявые... Тленные... бледные как смерть, полные угрюмости и без всякого чувства юмора. Они заботятся о том, чтобы на улицах не было трупов, складывая их в Морге. Это их работа в Сигиле, скорее всего, потому, что больше никто этим заниматься не будет».~
@1636 = ~«У меня есть другие вопросы...»~
@1637 = ~«Понятно. Спасибо за информацию. Прощай».~
@1638 = ~«Какая еще работа есть в Улье?»~
@1639 = ~«Кто именно?»~
@1640 = ~«Как насчет тленных...»~
@1641 = ~«Хаоситы... звучит интригующе».~
@1642 = ~«Свободные?»~
@1643 = ~«Неважно. У меня есть другие вопросы...»~
@1644 = ~«Забудь. Прощай».~
@1645 = ~«А что ты хочешь узнать о Сигиле?»~
@1646 = ~«Что *это* за место?»~
@1647 = ~«*Где* расположен Сигил?»~
@1648 = ~«Вообще-то, у меня есть другие вопросы...»~
@1649 = ~«Неважно. Прощай».~
@1650 = ~«Ну это город. Город Дверей, или Клетка. Место, где все двери куда-то ведут, но не откуда-то. Центр планов, хотя ему и достается весь мусор со всех мест. Кто-то говорит, что это место, где все сходится в одной точке».~
@1651 = ~«У меня есть другие вопросы...»~
@1652 = ~«'Город Дверей'?»~
@1653 = ~ «Спасибо за информацию. Прощай».~
@1654 = ~«Э, ну да... понимаешь, этот город — это... — он нахмуривается, пытаясь найти подходящее выражение. — В городе есть куча дверей, разбросанных повсюду и... ну, понимаешь... двери...» Он снова хмурится, бессильно вздыхая.~
@1655 = ~«Давай я тебе по-простому объясню. Видишь, здесь всюду в Сигиле есть двери, но некоторые из них могут быть не совсем обычными дверьми. Они больше похожи на порталы, догоняешь? А выглядеть они могут вообще *как-угодно*... типа оконного проема... э, рамы для картины, арки... кольца для бочки, проема между ножками стола... или ногами статуи...» ~
@1656 = ~«И... ты хочешь сказать, что все это — двери?»~
@1657 = ~«Двери?..»~
@1658 = ~«Кажется, это может занять порядком времени. У меня есть другие вопросы...»~
@1659 = ~«Неважно. Прощай».~
@1660 = ~Он снова хмурится. «Двери... то есть, порталы могут быть всем, что ограничено со всех сторон. Трудно сказать, где они расположены... пока ты не раздобудешь подходящий ключ к двери. Вообще, ты как сюда попал, рубака? Через дверь?»~
@1661 = ~«Понятно... У меня есть другие вопросы...» ~
@1662 = ~ «Спасибо за информацию. Прощай».~
@1663 = ~«А какое это отношение имеет к сказанному?»~
@1664 = ~«Э... ну, ты ведь не из Сигила, верно?»~
@1665 = ~«Неважно. Прощай».~
@1666 = ~«А что это за 'ключи', про которые ты говорил?»~
@1667 = ~«Значит, в городе полно дверей... а куда они ведут?»~
@1668 = ~«Может быть... Слушай, у меня были еще вопросы...»~
@1669 = ~«Неважно. Прощай».~
@1670 = ~«К каждой двери есть ключ, который ее открывает, верно? Обычно ты даже не *знаешь*, что находишься рядом с дверью, *до тех пор*, пока у тебя нет ключа. Дверь открывается, и ты можешь шагнуть вперед и попытать удачу. Как я сказал, дверью может быть что угодно. Весь трюк в том, что и ключом тоже может быть что угодно, понимаешь? Твое бормотание рядом с дверью, твои воспоминания, или джига, которую ты танцуешь рядом. Или ключом может быть вообще предмет — осколок стекла, булыжник с мостовой, выбитый зуб... да все что угодно».~
@1671 = ~«Куда ведут все эти двери?»~
@1672 = ~«До этого ты спросил, прошел ли я через дверь. Почему ты это сказал?»~
@1673 = ~«Звучит очень запутанно».~
@1674 = ~«Когда ты это увидишь, вмиг все поймешь».~
@1675 = ~«До этого ты спросил, прошел ли я через дверь. Почему ты это сказал?»~
@1676 = ~«Куда ведут все эти двери?»~
@1677 = ~Он пожимает плечами. «Да куда *угодно*, приятель. Некоторые вообще никогда не ведут в одно и тоже место, — он вздыхает. — Понимаешь, при таком раскладе двери могут вести в любое место на планах... *любое*. Вся шутка в том, что их так чертовски много, что очень трудно найти такую, которая приведет тебя туда, куда ты хочешь».~
@1678 = ~«Ты сказал, что у этих дверей есть 'ключи'...»~
@1679 = ~«До этого ты спросил, прошел ли я через дверь. Почему ты это сказал?»~
@1680 = ~«В центре планов, как говорят. Хотя этого никто не проверял, — он пожимает плечами. — Отсюда можно попасть в любое место... несколькими путями. Не все так ужасно в Сигиле, как это можно подумать».~
@1681 = ~«У меня есть другие вопросы...»~
@1682 = ~«Неважно. Прощай».~
@1683 = ~«Леди Боли? Ты что, никогда *не слышал* о ней? Должно быть, ты либо благословен, либо еще более безмоз... э, еще мало знаешь о Сигиле — он тихонько смеется. — Слово Леди — закон в Сигиле, — он немного призадумывается. — Хотя она не очень-то и разговорчива. На самом деле, она убийственно молчалива».~
@1684 = ~«Потерянный чего? — он обескуражен. — Без понятия, где это можно найти, рубака».~
@1685 = ~Он с опаской смотрит на тебя. «Не нужно много говорить о ней, рубака... тебе не нужно попадать в ее тень или петь ей хвалебные речи, хорошо? И не будем больше об этом. Трясти черепушкой про Леди — это глупо, очень глупо».~
@1686 = ~«Что-то типа закона».~
@1687 = ~«Что ты еще можешь рассказать об этой Леди?»~
@1688 = ~«Понятно. У меня есть другие вопросы...»~
@1689 = ~«Неважно. Прощай».~
@1690 = ~«Берлога трухлявых. Мрачное место. Никогда не пойду туда, даже когда меня пропишут в книгу мертвых».~
@1691 = ~«Падальщики. Почти все они обитают на площади Старьевщиков. Только и делают, что ищут трупы, прикарманивают их звенелки, а потом продают тела трухлявым в Морге».~
@1692 = ~«Ну хорошо, у меня есть другие вопросы...»~
@1693 = ~«Неважно. Прощай».~
@1694 = ~«У меня есть другие вопросы...»~
@1695 = ~«Понятно. Прощай».~
@1696 = ~«А почему они это делают?»~
@1697 = ~«У меня есть другие вопросы...»~
@1698 = ~«Какая еще работа есть в Улье?»~
@1699 = ~«Трухлявые платят этим людям за то, что те приносят тела с улиц и переулков, из-за чего трухлявым живется чуть проще — лучше иметь ораву людей с Улья, чем таскать трупы самому. А в Улье трупов порядком, каждый день появляются».~
@1700 = ~«У меня есть другие вопросы...»~
@1701 = ~«Какая еще работа есть в Улье?»~
@1702 = ~«Это имя мне не знакомо, рубака. Кто это?»~
@1703 = ~«Он сборщик, как мне кажется».~
@1704 = ~«Усек. У меня есть еще вопросы...»~
@1705 = ~«Я сам хочу это узнать. Послушай, у меня есть еще вопросы...»~
@1706 = ~«Понятно. Прощай».~
@1707 = ~Он думает. «Ну, тогда, скорее всего, его берлога находится на площади Старьевщиков. Ты можешь поискать там... только днем, конечно же. Ночью там не очень приятно находиться».~
@1708 = ~«А где находится площадь Старьевщиков?»~
@1709 = ~«У меня есть другие вопросы...»~
@1710 = ~«Спасибо за предупреждение. Прощай».~
@1711 = ~«Пара кварталов отсюда — иди на запад от Морга до упора, и ты окажешься там. Однако будь поосторожнее там, рубака... Сборщики не всегда ждут, пока тело само окочурится, чтобы его взять, понимаешь?»~
@1712 = ~«Это место разбойников и грабителей, рубака. Не ходи туда, если только твоя следующая остановка не Морг. Этот переулок — сплошной выжженный мусор, который раньше был улицей, до того, как однажды ночью один свихнувшийся маг не сжег его дотла. Говорят, что его поймали и самого сожгли, а потом выставили в качестве экспоната в баре 'Тлеющий труп'. Вот такой он, Улей».~
@1713 = ~«Э... — он облизывает губы, видя, как ты собираешься уходить. — Приятель, ты не подумай ничего такого... — он изучает тебя пару секунд. — Ты можешь пожертвовать пару медяков знатоку, который помог тебе просветиться? Не очень много, сделай это для старого приятеля... немного для человека с подвешенным языком, который направил на путь истинный? А?»~
@1714 = ~«Нет».~
@1715 = ~«Я пощажу твою жизнь. Как насчет этого?»~
@1716 = ~«Довольно честно». Дать ему один медяк.~
@1717 = ~Дать пять медяков.~
@1718 = ~Дать десять медяков.~
@1719 = ~Он сбит с толку. «Ох, ну хорошо, мир тебе, рубака...» Под недовольное ворчание он уходит прочь.~
@1720 = ~Уйти.~
@1721 = ~Уйти.~
@1722 = ~Человек в испуге поднимает руки. «Нет, нет, ничего, рубака! Просто погода никчемная, вот и все, что я сказал!» Он готов убежать.~
@1723 = ~«*Что* ты сказал?»~
@1724 = ~Атаковать его.~
@1725 = ~Позволить ему убежать.~
@1726 = ~«Э... это очень щедро с твоей стороны, рубака, — он улыбается вымученной улыбкой. — Ступай себе с миром». Он быстро уходит.~
@1727 = ~Атаковать его.~
@1728 = ~Позволить ему убежать.~
@1729 = ~Он воровато оглядывается, пытаясь увидеть случайных свидетелей сделки, затем берет деньги и прячет в одежде. «Большое спасибо тебе, рубака! Да минует тебя тень Леди!»~
@1730 = ~«Погоди... Какая еще Леди? О чем это ты?»~
@1731 = ~«У меня есть другие вопросы...»~
@1732 = ~«Спасибо. Прощай».~
@1733 = ~«У меня есть другие вопросы...»~
@1734 = ~Наследство Кестера~
@1735 = ~Дабус~
@1736 = ~Блудница~
@1737 = ~Тифлинг~
@1738 = ~Дабус~
@1739 = ~Гитцерай-горожанин~
@1740 = ~Блудница~
@1741 = ~Гитцерай~
@1742 = ~Подвыпившая блудница~
@1743 = ~Подвыпившая блудница~
@1744 = ~Жительница Проклятого~
@1745 = ~Девица в беде~
@1746 = ~Девица в беде~
@1747 = ~Кристалл~
@1748 = ~Мошенник~
@1749 = ~Головорез из Улья~
@1750 = ~Житель Улья~
@1751 = ~Испуганный житель Улья~
@1752 = ~Раздраженный житель Улья~
@1753 = ~Головорез из Улья~
@1754 = ~Перед тобой человек, который смущенно оглядывается на окружающие его здание. У него потерянный вид. Он что-то бормочет себе под нос.~
@1755 = ~«Приветствую».~
@1756 = ~Пройти мимо.~
@1757 = ~Человек облегченно вздыхает. «*Наконец-то*! Я взываю к вашей снисходительности, уважаемый господин. Кажется, я заблудился в этом лабиринте улиц... — он неловко хихикает. — Боюсь, что эта часть города, — он окидывает взглядом улицу, — мне не знакома. Здешние жители, похоже, не желают помогать гостям... — он с надеждой смотрит на тебя. — Быть может, я смог бы убедить вас помочь мне?»~
@1758 = ~«В зависимости от того, какая помощь тебе нужна».~
@1759 = ~«Конечно. Куда ты хочешь попасть?»~
@1760 = ~«Выкручивайся сам. На твоем месте я бы побыстрее выбирался бы отсюда».~
@1761 = ~«Сейчас у меня нет времени, чтобы помогать тебе... Прощай».~
@1762 = ~«Я ищу дом моей тети Маргариты. Она говорила, что живет рядом с Моргом, но с тех пор, когда я был здесь в последний раз, планировка улиц поменялась... Вы не знаете, где находится этот дом?»~
@1763 = ~Ложь: «Да. Я могу показать дорогу... за деньги».~
@1764 = ~Правда: «Боюсь, что никогда не слышал об этом месте».~
@1765 = ~«Я не могу помочь тебе. Прощай».~
@1766 = ~«Ах, это справедливо. Ее дом находится рядом с Моргом, — его глаза сужаются, пристально изучая тебя. — Вам точно известно, где находится ее дом?»~
@1767 = ~Тень~
@1768 = ~Большая Тень~
@1769 = ~Тень~
@1770 = ~Осыпанный-Пеплом~
@1771 = ~Большая Тень~
@1772 = ~Перо~
@1773 = ~Отмычки~
@1774 = ~Ключ от препараторской~
@1775 = ~Ключ от препараторской~
@1776 = ~КЛЮЧ ОТ ПРЕПАРАТОРСКОЙ
Вес: 0

Ручка этого бронзового ключа несколько раз перекручена по своей оси так, что она напоминает винт. Если верить Морту, он открывает одну из дверей в препараторской.

^NПРИМЕЧАНИЕ: При использовании ключей в Torment тебе нужно всего лишь иметь их в своем инвентаре, чтобы открыть дверь. В некоторых случаях ключ пропадает после использования... это случается в тех случаях, когда он больше не нужен, при этом в инвентаре освобождается ячейка для других, более важных вещей.^-~
@1777 = ~Ключ от Морга~
@1778 = ~Ключ от Морга~
@1779 = ~КЛЮЧ ОТ ПЕРЕДНИХ ВОРОТ МОРГА
Вес: 0

Это обычный крупный железный ключ. По какой-то причине его мрачный вид напоминает тебе о Морге.

^NПРИМЕЧАНИЕ: При использовании ключей в Torment тебе нужно всего лишь иметь их в своем инвентаре, чтобы открыть дверь. В некоторых случаях ключ пропадает после использования... это случается в тех случаях, когда он больше не нужен, при этом в инвентаре освобождается ячейка для других, более важных вещей.^-~
@1780 = ~Ключ от бальзамационной~
@1781 = ~Ключ от бальзамационной~
@1782 = ~Перед тобой высокое существо с копной белых волос. Его кожа имеет зеленоватый оттенок, а из головы торчит пара козлиных рожек. Оно одето в длинное развевающееся одеяние и слегка парит над землей.~
@1783 = ~«Приветствую».~
@1784 = ~«Приветствую».~
@1785 = ~«Приветствую».~
@1786 = ~Существо поворачивается к тебе, и над его головой появляется несколько символов. Они окружены слабым сиянием и... парят в воздухе.~
@1787 = ~Дабус терпеливо ждет, спрятав свои руки в рукава. Над его головой появляется несколько символов, затем они рассеиваются, уступив появившемуся знаку вопроса.~
@1788 = ~Перед тобой молодой тленный с щетиной на подбородке и темными кругами под глазами. С унылым выражением лица он уставился на стену.~
@1789 = ~Ты видишь Ждущего Смерти. Кажется, он тебя не замечает.~
@1790 = ~Перед тобой крепкий смуглый мужчина с угрюмым лицом. Он одет в мантию тленных и смотрит на тебя каменным взглядом.~
@1791 = ~«Приветствую».~
@1792 = ~::Скрип Скрип::~
@1793 = ~«Я вернусь с твоей квитанцией!»~
@1794 = ~Этот сморщенный человечек из-за своей огромной мантии тленных кажется еще меньше. Похоже, его одежда подобрана таким образом, чтобы скрыть его невысокий рост. Хотя по виду ему около ста лет, он весьма подвижен... Он без конца ерзает, его взгляд метается по бару, как у птицы. ~
@1795 = ~Его глаза начинают сверкать, только заметив тебя. Он кивает в приветствии. «Привет, рад встрече, путник. Кажется, ты новичок в Сигиле... — он умолкает. — Прошу прощения, мы раньше не встречались? Твое лицо мне очень знакомо».~
@1796 = ~При твоем приближении пожилая женщина поворачивается в твою сторону и пристально смотрит на тебя. «О-ля-ля, смотрите, кто сегодня пожаловал к Увядшей... любимый сын смерти». Она окидывает тебя взглядом, затем трясет головой в неверии. «Во имя сил и их матерей, парень... из какого склепа *ты* выполз?»~
@1797 = ~«Не выползал я ни из какого склепа».~
@1798 = ~Этот медяк был «срезан»... почти весь металл сточен, хотя оставшаяся часть по-прежнему выглядит как целая монета, а вот спиленная медь позволит «резчику» сделать еще одну. Эта монета ничего не стоит.~
@1799 = ~Кто ты? Что ты делаешь на нашей территории?~
@1800 = ~Перед тобой красивая собранная женщина. У нее четкие, ярко выраженные черты лица. Ее голос низкий и уверенный. «Я — Кристалл, предводительница Бритвенных Ангелов. Ты находишься в нашем доме. Что тебе нужно от меня?»~
@1801 = ~Эта коренастая старушка словно полностью выцвела: все, начиная с волос и заканчивая платком и платьем, окрашено в оттенки серого. Унылую картину разбавляют только странные травы, привязанные за стебли к ее поясу. Когда она двигается, они издают странный шелест, словно ими что-то подметают.~
@1802 = ~«Приветствую».~
@1803 = ~Старая Меббет~
@1804 = ~Повитуха~
@1805 = ~Этот мужчина облачен в грязную рваную бурую мантию. Его лицо скрыто длинным капюшоном.~
@1806 = ~Ну ладно. Я вернусь попозже.~
@1807 = ~Назад в Погребенную деревню~
@1808 = ~Проход на площадь Старьевщиков~
@1809 = ~Перед тобой уставшая женщина, одетая в тесный кожаный корсаж и гетры. Аромат дешевых духов буквально обволакивает ее, а лицо скрыто за маской грубого макияжа. Завидев тебя, она улыбается. «Почему бы тебе не остановиться и не поболтать со мной, красавчик?»~
@1810 = ~Женщина жеманно поглядывает на тебя. «А теперь ты похож на знатока, который что-то *потерял*. Может, помочь тебе поискать, рубака?» Она слегка улыбается.~
@1811 = ~Этот монумент похож на тот, что стоит возле Морга. На нем нет никаких опознавательных знаков.~
@1812 = ~«Э? — она явно этого не ожидала. — О чем это ты?»~
@1813 = ~Ее тон становится деловым. «Ага, красавчик, теперь вопрос только в щедрости страждущего».~
@1814 = ~«Пара медяков, чтобы *поглядеть*, чего там у тебя пропало, и десять, чтобы найти твою пропажу».~
@1815 = ~«Кажется, ты уже нашел, что искал. Пойдем, красавчик».~
@1816 = ~Женщина улыбается. «Что, звенелок не хватает? Не переживай, красавчик... возвращайся, когда кошелек будет потолще».~
@1817 = ~Женщина встревает в разговор. «Для твоего мимира... или еще какого дегенерата — двойная такса».~
@1818 = ~«Вот это удача! Кажется, то, что мы ищем, мы в твоем скромном убежище, красавица».~
@1819 = ~«Может, ты поможешь мне найти то, что я потерял, красавица».~
@1820 = ~«На самом деле, я потерял дневник».~
@1821 = ~«Я ничего не терял, но у меня есть несколько вопросов...»~
@1822 = ~«Я должен идти. Прощай».~
@1823 = ~«Чтоб тебе сифилис кишки изъел! От тебя несет, как от пастуха, да и одеваешься ты не лучше, а уж рожа — и того хуже, раза в два!»~
@1824 = ~Женщина хмурится. «Я тебе не осведомитель... — она хмурится, затем потирает двумя пальцами друг о друга. — *Если* только у тебя нет пары звенелок, чтобы оплатить мое время».~
@1825 = ~«Десять медяков. Дальнейшие расспросы увеличат гонорар».~
@1826 = ~«Многое теряешь. Если надоест терять и захочется найти — приходи ко мне, красавчик, поболтаем».~
@1827 = ~«Ага». Она зажимает монеты в ладони, в которой они незамедлительно исчезают. «Итак...»~
@1828 = ~«Спрашивай, красавчик».~
@1829 = ~Ее глаза подозрительно сужаются. «О городе? А что?»~
@1830 = ~«Погоди, ты про Сигил? — озираясь, она пожимает плечами. — Этот город лежит под твоими ногами и окружает тебя со всех сторон, — она улыбается. — От этого у гостей желудок ходит ходуном».~
@1831 = ~«В центре планов, как говорят, — она фыркает. — Если ты веришь в эту белиберду».~
@1832 = ~Она ухмыляется. «Ну, красавчик, если верить седобородым, ученым, законникам и всем остальным сотрясателям черепушек, то они говорят, что планы существуют вечно, — она стучит себя по лбу. — А кто скажет, где их 'центр'?»~
@1833 = ~Она кладет руки на пояс и выпячивает губы. «Смотря что тебя интересует, рубака».~
@1834 = ~«Я уже сделала тебе предложение, красавчик, и цена была не такая уж грабительская. Не знаю, где еще ты сможешь получить такое удовольствие, как со мной».~
@1835 = ~Она хохочет. «Ты это у *меня* спрашиваешь? Ты что, решил записаться в нашу общину?» Она складывается пополам от хохота... смех точь-в-точь как у подвыпившей гарпии. Вдоволь нахохотавшись, она делает глубокий вздох. «Да ты... ты просто хохмач».~
@1836 = ~Похоже, это покрытое пеплом дерево здорово пострадало с тех пор, как его сюда пересадили.~
@1837 = ~Она многозначительно улыбается. «Я просто... 'обслуживаю'... фракции, красавчик. Я с ними дел не имею».~
@1838 = ~«В моих объятиях тленные перестают быть тленными, красавчик, — она усмехается. — Эти вояки только и трещат, что о смерти, а вот со мной они про нее не сильно трепаются, сечешь?» ~
@1839 = ~«Без понятия, где можно его найти, красавчик. Он может быть... где угодно, — она с намеком улыбается. — Но зато я знаю, где можно начать поиски».~
@1840 = ~«Фарод? Это одна из *величайших* тайн, красавчик. Если хочешь разузнать об этом знатоке больше, то придется заплатить тройную таксу».~
@1841 = ~Она сгребает твои монеты и кладет их в карман. «Что ты хочешь узнать о старом Фароде?»~
@1842 = ~Она пожимает плечами. «Говорят, что он главарь сборщиков. В его тени полно знатоков».~
@1843 = ~«Ну, никто точно не уверен, но если бы *меня* спросили, то я начала бы с площади Старьевщиков».~
@1844 = ~«Шеф, ты не можешь одолжить мне немного звенелок... э-э... у меня этого так давно не было».~
@1845 = ~«Э... полагаю, это никому *не повредит*...»~
@1846 = ~«Я даже не хочу спрашивать, как ты намереваешься это совершить».~
@1847 = ~«Послушай, Морт... вообще-то, нам нужно идти. Прощай, красавица».~
@1848 = ~«Ага, большая куча тряпья и мусора через три квартала к западу от Морга... У всех сборщиков там есть угол. По всей вероятности, и у Фарода там берлога».~
@1849 = ~«Ну, знаешь... эти бедолаги за деньги собирают жмуриков. Незавидная судьба».~
@1850 = ~«Затем, что они не додумались до того, что делаю я».~
@1851 = ~Она сплевывает и делает полукруг над сердцем. «Это ведьма с клинками! Высокая и могучая, хозяйка всего в этом городе, парит в тишине и убивает любого, кто окажется в ее тени. Она оберегает город... — она переходит на шепот. — И оставляет живых *гнить* здесь».~
@1852 = ~«Ну вот и все, рубака».~
@1853 = ~«Для тебя... — она критически осматривает тебя. — Семь медяков, ни больше, ни меньше. Дальнейшие расспросы увеличат гонорар».~
@1854 = ~«Для такого обаяшки как ты...» Она одаривает тебя широкой улыбкой, раскрывая ряд грязных зубов. «Трех монет будет достаточно, чтобы развязать мне язык, — она облизывает губы, затем хмурится. — Но дальнейшие расспросы увеличат гонорар».~
@1855 = ~Анна ощетинивается на тебя, видя, как ты уходишь с женщиной. «Ты ваще *тупой*... или просто рехнулся?» Ее хвост мечется туда-сюда, затем она круто разворачивается к проститутке. «Ш-ш-ш!» Она размахивает своими ударными кинжалами перед испуганной проституткой. «Вали отсюда, шлюха сигильская!»~
@1856 = ~Она разворачивается к тебе. «А ты, неудачник — тебе лучше притормозить, не то подровняю тебе корешок, сечешь?»~
@1857 = ~Женщина натыкается о тебя, затем отступает назад и с полуулыбкой смотрит вверх на тебя. Пахнет она как винокурня.~
@1858 = ~«При-*веееет*...» Она машет тебе руками, затем начинает безудержно хихикать. «При-вееет, большой рубака...» Она снова начинает хохотать.~
@1859 = ~Она косится на тебя, упирается руками в бедра и наклоняется так близко, что с высока ты можешь полюбоваться ее грудью. «Ну *как* я тебе, рубака?! А?» Она отряхивается, вызывая позвякивание, а затем снова начинает хохотать. «Ты тот, кому нужна ласка и забота!» Она тыкает тебя пальцем в грудь, подчеркивая свои слова.~
@1860 = ~Она одаривает тебя дразняще-строгим взглядом. «Может быть, если ты сделаешь подходящее предложение, — она опирается на тебя. — Так как?»~
@1861 = ~Она надувает губы. «Чтоб ты сифилис подцепил! Посмотрим, сможешь ли ты найти кого-нибудь получше, чем я».~
@1862 = ~«Ну хорошо». Она осматривает тебя с ног до головы, затем пытается немного всплакнуть. «Э-э... нет-нет. Кажется, ты слишком большой, чтобы я с тобой справилась».~
@1863 = ~«О, так ты думаешь, что *я* могу помочь *тебе*?! Эй, а ты рубака с запросами! Тогда окружи меня всю такой лестью!» Она улыбается.~
@1864 = ~«Да!» Она издает пьяный хохот.~
@1865 = ~«Неееет!» Кажется, это слово ее очень забавляет и она тычет тебя в грудь, чтобы подчеркнуть его. «Нет! Нет!»~
@1866 = ~«Дааааа? — она косится на тебя. — Чтооо?»~
@1867 = ~Ты уже готов идти прочь, но вдруг останавливаешься. Внезапно у тебя появляется чувство, что что-то *не так*... и с этим чувством приходит осознание того, что состояние опьянения этой женщины является всего лишь фикцией. Присмотревшись к ней внимательнее, ты замечаешь, что проститутка засовывает что-то в свой рукав... кажется, это принадлежит тебе.~
@1868 = ~Твоя рука хватает ее за запястье мертвой хваткой. Она немедленно трезвеет, отчаянно пытаясь вырвать руку, и начинает кричать на всю глотку.~
@1869 = ~Она успевает вырывать руку до того, как ты ее можешь схватить. Ее пьяное выражение лица исчезает, и она начинает кричать на всю глотку.~
@1870 = ~Ее пьяное выражение лица испаряется, и она начинает кричать на всю глотку.~
@1871 = ~Она продолжает выкручиваться из твоей хватки, крича о помощи. Тебе с трудом верится, что у женщины могут быть такие сильные легкие... от них у тебя в ушах звенит. ~
@1872 = ~Она продолжает выкручиваться из твоей хватки, крича о помощи. Тебе с трудом верится, что у женщины могут быть такие сильные легкие... от них у тебя в ушах звенит.~
@1873 = ~Наверно, только благодаря собственным навыкам в воровстве ты не теряешь бдительности. Перед уходом ты инстинктивно бросаешь взгляд на свой кошелек... и видишь, как проститутка вытаскивает из него свою руку. Хотя сама она не знает, что ты ее подловил.~
@1874 = ~Ты приближаешься, хохоча вместе с ней, и следя за тем, как ее рука снова тянется к твоему кошельку... похоже, ее техника — прикрываться пьяным говором (и грудью), пока она тырит монеты в чужого кошелька. Ее рукава сделаны длинными и широкими специально для того, чтобы быстро прятать украденные предметы. Ты отмечаешь элементы ее техники... даже когда ее рука в очередной раз тянется в твой кошелек.~
@1875 = ~Должно быть, она *что-то* услышала в твоем голосе: она прекращает кричать и смотрит на тебя огромными испуганными глазами. ~
@1876 = ~Она кивает и закатывает назад свои длинные и просторные рукава, показывая обитый тканью мешочек, прикрепленный к запястью. Похоже, она может ронять монеты с ладони прямо в мешочек; при этом ткань заглушает звон монет. Не говоря ни слова, она протягивает тебе мешочек... в нем несколько десятков медяков.~
@1877 = ~Она дотягивается до своей подвязки и вытаскивает еще один мешочек, который протягивает тебе. Он полон медными монетами, которые ты ссыпаешь в свой кошелек.~
@1878 = ~Она медленно дотягивается до своего сапога и достает странный тонкий кинжал, который она протягивает тебе рукояткой вперед. Затем она тянется к другому сапогу и вытаскивает *еще один* кинжал — еще более странный, чем первый — с широким клинком, который она дает тебе, опять же рукояткой вперед. Затем она окидывает голову назад, показывая небольшую сережку, спрятанную под копной волос. Она отстегивает ее и протягивает тебе. ~
@1879 = ~Она кивает. ~
@1880 = ~Ее глаза расширяются, когда твоя рука обхватывает ее шею. Она отчаянно хватается за твои пальцы... она не успевает освободиться; раздается хруст, и она перестает сопротивляться.~
@1881 = ~Ты отпускаешь ее, и она плюхается на землю. Убить ее оказалось проще, чем тленного. Глядя на ее тело, ты ощущаешь странную дрожь... ты *знаешь*, что уже убивал других таким способом. Ты отчаянно пытаешься зацепиться за воспоминание, но оно уходит прочь, скрываясь в твоем подсознании.~
@1882 = ~Ты отпускаешь ее, и она плюхается на землю. Глядя на ее тело, ты ощущаешь странную дрожь... ты *знаешь*, что уже убивал других таким способом. Эта мысль пробуждает воспоминание, но оно недостаточно сильно, чтобы за него можно было зацепиться.~
@1883 = ~Женщина отступает на шаг, а затем внезапно начинает кричать во все горло!~
@1884 = ~Когда ты отворачиваешься, Анна внезапно начинает шипеть. Ты замечаешь, как пьяная женщина испуганно отступает назад.~
@1885 = ~Анна кивает на женщину. Ударные кинжалы выскакивают из ее рук. «Эта ведьма обчистила тебя, как пить дать, — клинок Анны оказывается у горла женщины. — Эта сигильская шлюха приложилась к тебе и облегчила тебя на чуток звенелок».~
@1886 = ~Глядя на вас с Анной, пьяная женщина испуганно трясет головой. «Я ничего не крала, рубака! Она ошибается!»~
@1887 = ~«А? — сердито рычит Анна, яростно махая хвостом. — *Уверена* ли я?!» Она чуть сильнее давит на клинок, приставленный к горлу женщины. «Ага... Уверена, — ее глаза щурятся, глядя на тебя. — Ты мне не веришь?» Она сплевывает. «Неважно. Я просто выпущу ей кишки и заберу звенелки».~
@1888 = ~«А? — Анна шипит словно кошка. — Ты че, *тупой*? Она обчистила тебя, как пить дать».~
@1889 = ~Немного помедлив, женщина кивает и медленно вытаскивает из своего рукава небольшой мешочек, привязанный к запястью. Анна срезает его и прячет у себя. «А теперь исчезни, — она отталкивает женщину прочь. — Ш-ш-ш! Исчезни!»~
@1890 = ~Помолчав некоторое время, Анна прячет свои клики и отступает назад, затем шипит и плюет в ноги женщины: «Ш-ш-ш! Исчезни!»~
@1891 = ~Анна с рычанием делает круговой выпад ударными кинжалами... перерезая тем самым рукав у платья женщины, в котором оказывается привязанный к запястью мешочек. Похоже, он предназначается для того, чтобы быстро прятать монеты с ладони.~
@1892 = ~Женщина кивает, затем медленно достает и отвязывает от запястья небольшой мешочек. Анна выхватывает его и прячет у себя.~
@1893 = ~«Э-э... Приветствую».~
@1894 = ~«Смотри, куда прешь, женщина!»~
@1895 = ~«Прощай».~
@1896 = ~«Прощай».~
@1897 = ~«Прощай».~
@1898 = ~«Прощай».~
@1899 = ~НОВАЯ ЖИЗНЬ~
@1900 = ~СВЯЩЕННЫЙ СИМВОЛ ТЛЕННЫХ СОЭГО
Вес: 1

Этот священный символ когда-то принадлежал тленному Соэго. Символ сделан из тяжелого железа, и выполнен так, чтобы крепиться к запястью несколькими небольшими, туго связанными цепочками. Сам символ напоминает тебе кричащее лицо.~
@1901 = ~Изучение пера показывает, что оно принадлежало вроку, одной из многих рас танарри, которыми наполнена Бездна. Вроки напоминают огромных стервятников; они часто использовались как разведчики войск танарри в Кровавой войне.~
@1902 = ~ПЕРО ДХОЛЛА
Особенность: постоянно +1 к Осведомленности
Вес: 0
Используется только магами

Изучение пера показывает, что оно принадлежало вроку, одной из многих рас танарри, которыми наполнена Бездна. Вроки напоминают огромных стервятников; они часто использовались как разведчики войск танарри в Кровавой войне.

Дхолл пользовался этим пером всю свою жизнь, и, таким образом, оно несет в себе его опыт и воспоминания. Разломив его, ты впитаешь часть его знаний, что даст тебе постоянную прибавку к Осведомленности.~
@1903 = ~ОБАЯНИЕ

Эта способность отвечает за твои убеждение, притягательность и лидерство. При высоком Обаянии остальные будут относиться к тебе более благосклонно.~
@1904 = ~Ты видишь очень сильного человека с каменным выражением лица.~
@1905 = ~«Приветствую».~
@1906 = ~Пройти мимо.~
@1907 = ~Секунду мужчина смотрит на тебя, затем хмыкает и поднимает руку, показывая огромный кинжал. Недобро улыбаясь, он начинает заходить к тебе сбоку под угрожающим углом.~
@1908 = ~Атаковать его.~
@1909 = ~«Э-э, прощай...»~
@1910 = ~Мужчина медленно поднимает голову, когда ты подходишь. Он окидывает тебя взглядом и кривится в отвращении. «Что, к чертям собачьим, ты такое? — он морщит нос. — Может, это трухлявые потеряли одного из своих гниющих псов, — он смеется. — Ха! *Никогда* раньше на видел ничего более уродливого».~
@1911 = ~«Не считая своего отражения?»~
@1912 = ~«Следи за своим языком, не то он будет лежать у твоих ног».~
@1913 = ~«Прощай».~
@1914 = ~Мужчина на мгновение кажется сбитым с толку. Затем он усмехается, перебирая пальцами по рукоятке своего клинка. «Так и нарываешься на кровопролитие, законник».~
@1915 = ~«Только достань свой клинок — и единственный, кого ты убьешь, будешь ты сам».~
@1916 = ~«Угомонись, нам незачем драться».~
@1917 = ~Атаковать его.~
@1918 = ~«Прощай».~
@1919 = ~Он тянется к оружию. «Посмотрим, законник, посмотрим...»~
@1920 = ~«О, значит, незачем? — он плюет тебе под ноги. — Не уж-то, пень, в тебе течет кровь труса? Или она вся из тебя вытекла в последней потасовке?»~
@1921 = ~«Если мне не изменяет память, это у твоей мамаши кровь труса... что, по моим прикидкам, означает, что половина городских ублюдков тебе братья».~
@1922 = ~«Давай прекратим все это, пока не приключилось никакой беды».~
@1923 = ~Атаковать его.~
@1924 = ~«Прощай».~
@1925 = ~Мужчина пару секунд моргает, как бы переваривая сказанное тобой, потом его лицо багровеет от гнева. Он достает клинок и кидается на тебя.~
@1926 = ~«Не-не, пень, не все так просто. Тебе придется *заплатить* за привилегию не носить в себе мой клинок».~
@1927 = ~«Ну ладно. Сколько?»~
@1928 = ~А твоя мамаша платы не просила. С чего бы тебе просить?~
@1929 = ~«А твоя мамаша платы не просила. С чего бы тебе просить?»~
@1930 = ~Атаковать его.~
@1931 = ~Просто пройти мимо.~
@1932 = ~«Пожалуй, вся твоя медь уладила бы это дело, — он смеется. — Ну же, вытряхивай».~
@1933 = ~«Может, в следующий раз ты дважды подумаешь перед тем, как чем заговоришь со мной, ты, болячка в чреве своей матери».~
@1934 = ~«Ага, иди-ка ты дальше в мясницкую лавку, трус», — говорит он, смеясь.~
@1935 = ~«О... прими мой искренние извинения, рубака... ты что, оглох? — он смотрит на тебя с презрением. — Ах, да, тебя же пару раз стукнули по башке, не так ли? — он стукает себя по голове для придания эффекта. — Мне что, говорить помедленнее, пень?»~
@1936 = ~Отдать ему все свои деньги.~
@1937 = ~Атаковать его.~
@1938 = ~Уйти.~
@1939 = ~«*Что* ты сказал?»~
@1940 = ~Пропустить это мимо ушей и уйти.~
@1941 = ~Атаковать его.~
@1942 = ~«*Что* ты сказал?»~
@1943 = ~Пропустить это мимо ушей и уйти.~
@1944 = ~Атаковать его.~
@1945 = ~«Я тебя предупреждал...»~
@1946 = ~Защищаться...~
@1947 = ~Атаковать его.~
@1948 = ~Уйти.~
@1949 = ~Он поднимает руки, когда ты протягиваешь деньги. «Нет, трус, покамест придержи их для меня... Думаю, они мне все равно достанутся после того, когда я тебя выпотрошу, — он обнажает свой клинок и улыбается. — Похоже, я сделаю тебя еще уродливее».~
@1950 = ~Защищаться...~
@1951 = ~«А? — он презрительно усмехается. — Снова ты, пень? Пришел милостыню просить? Иди-ка лучше попрошайничай в другом месте, — он осматривает тебя с ног до головы. — Никогда еще не видел ничего более уродливого».~
@1952 = ~Не считая своего отражения?~
@1953 = ~«Не считая своего отражения?»~
@1954 = ~«Следи за своим языком, не то он будет лежать у твоих ног».~
@1955 = ~«Прощай».~
@1956 = ~Когда ты подходишь, мужчина отступает на шаг. В его глазах виден трусливый хищный огонек, как у падальщика... только глянув на него, ты осознаешь, что он прикидывает, сможет ли с тобой справиться. И все же его голос дрожит от неуверенности. «Оставь меня в покое, я н-н-ничего тебе не сделал».~
@1957 = ~«Даже не думай нападать на меня, иначе мой клинок найдет себе новое жилище».~
@1958 = ~«Ты *нарываешься* на драку?»~
@1959 = ~«Ни на какую драку я не нарываюсь, — при разговоре из его рта летит слюна, — но ты бы последил за собой, раз думаешь, что можешь меня взять!»~
@1960 = ~«Прощай».~
@1961 = ~«*Никто* не говорит со мной подобным тоном, и *никто* мне не угрожает. Возьми свои слова обратно, или для второго шанса будешь уже слишком мертвым».~
@1962 = ~«Да-да. Просто держись на расстоянии, иначе пожалеешь».~
@1963 = ~Атаковать его.~
@1964 = ~«Тогда прощай». ~
@1965 = ~Он угрюмо смотрит на тебя.~
@1966 = ~«Ты меня *понял*? Возьми свои слова обратно, не то я выпущу тебе кишки».~
@1967 = ~Он угрюмо смотрит на тебя.~
@1968 = ~«Ты меня *понял*? Не подходи, не то я выпущу тебе кишки».~
@1969 = ~Атаковать его.~
@1970 = ~Уйти.~
@1971 = ~Атаковать его.~
@1972 = ~Уйти.~
@1973 = ~Его голос дрожит. «Тогда я... беру свои слова обратно. Никого не хотел обидеть».~
@1974 = ~«Ладно. Прочь с глаз моих».~
@1975 = ~«Прочь с глаз моих».~
@1976 = ~Все равно напасть на него.~
@1977 = ~«В таком случае, наши пути больше не пересекутся. Не хотел тебя обидеть, проходя по той же улице».~
@1978 = ~«Ладно. Убирайся с глаз моих».~
@1979 = ~«Прочь с глаз моих».~
@1980 = ~Все равно напасть на него.~
@1981 = ~Перед тобой поразительная рыжеволосая девушка, одетая в кожаную броню. Ее правая рука покрыта рядом соединенных пластин, похожих на кожу какого-то животного, а левую руку защищает рогатый наплечник. Странно, но у нее есть хвост... который мечется из стороны в сторону, пока ты на него смотришь. «Отвали».~ [ANA377A]
@1982 = ~«Приветствую».~
@1983 = ~Пройти мимо.~
@1984 = ~Девушка не обращает на тебя внимания.~
@1985 = ~«Кто ты?»~
@1986 = ~«Можешь сказать мне, где я нахожусь?»~
@1987 = ~«Я ищу кое-кого по имени Фарод. Ты не знаешь, где его можно найти?»~
@1988 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@1989 = ~«Тогда прощай». ~
@1990 = ~Девушка презрительно усмехается, затем делает непристойное движение хвостом. «Отвали, бедолага ты пустоголовый».~
@1991 = ~«Ага, возможно. Я могла бы сказать больше, если ты подсластишь вопрос, сечешь? — она щелкает языком и потирает двумя пальцами друг о друга. — Звенелки?»~
@1992 = ~«Звенелки?»~
@1993 = ~«Звенелки?»~
@1994 = ~«Хорошо... Сколько?»~
@1995 = ~«Тогда неважно. Прощай».~
@1996 = ~Девушка недоверчиво смотрит на тебя, перестав даже вилять хвостом. «И откуда ты такой взялся? Звенелки — монеты... медь, серебро, золото... деньги, сечешь? — она понимает бровь. — Если ты при звенелках, у меня может найтись то, что ты хочешь услышать».~
@1997 = ~«Хорошо. Сколько?»~
@1998 = ~«Сомневаюсь, что у тебя есть хоть *что-то*, что я захочу услышать. Но можешь попробовать, а я уж решу, стоит оно того или нет».~
@1999 = ~«Неважно. Прощай».~
@2000 = ~«Она имеет в виду деньги».~
@2001 = ~«О».~
@2002 = ~«Ага... — она смотрит на Морта, затем пожимает плечами. — То, что сказал череп. Твердая монета».~
@2003 = ~«Хорошо. Сколько?»~
@2004 = ~«Сомневаюсь, что у тебя есть хоть *что-то*, что я захочу услышать. Но можешь попробовать, а я уж решу, стоит оно того или нет».~
@2005 = ~«Неважно. Прощай».~
@2006 = ~«А сколько бы ты заплатил, а? — она изучает тебя, скрестив руки. — Давай, я не собираюсь торчать здесь весь день напролет».~
@2007 = ~Использовать свое Обаяние: «Как насчет десяти? Если информация окажется полезной, будет больше».~
@2008 = ~«Как насчет десяти?»~
@2009 = ~«Как насчет двенадцати?»~
@2010 = ~«Похоже, у меня недостаточно монет, чтобы заинтересовать тебя».~
@2011 = ~«Неважно. Прощай».~
@2012 = ~«Да столько меди не хватит даже, чтобы разжечь аппетит Обреченного. Если хочешь найти друзей, нужно больше, недоумок».~
@2013 = ~«Тогда как насчет двадцати?»~
@2014 = ~«Тогда, похоже, у меня недостаточно монет, чтобы заинтересовать тебя».~
@2015 = ~«Тогда неважно. Прощай».~
@2016 = ~«Ага, по рукам...» Она прячет деньги. Это происходит так быстро, что ты даже не представляешь, куда они исчезли. «Поищи его в переулке в сторону шпиля от Морга... это на юго-запад от Морга, усек?»~
@2017 = ~«Хорошо. У меня есть другие вопросы...»~
@2018 = ~«Довольно странно... на юго-западе от Морга — только переулок, набитый хорошо вооруженными головорезами. Ты об этом знаешь?»~
@2019 = ~«Ты потерялся, но скоро наживешь себе неприятности. Иди, потеряйся где-нибудь в другом месте, пьянь подзаборная».~
@2020 = ~«Для начала я бы хотел задать несколько вопросов...»~
@2021 = ~«Тогда прощай». ~
@2022 = ~«Ага? И че те надо?»~
@2023 = ~«Ты знаешь, что у тебя есть хвост?»~
@2024 = ~«Ничего, но я заметил, что у тебя есть хвост».~
@2025 = ~«Можешь сказать мне, где я нахожусь?»~
@2026 = ~«Я ищу кое-кого по имени Фарод. Ты не знаешь, где его можно найти?»~
@2027 = ~«Ты сказала, что Фарод находится к юго-западу от Морга, правильно?»~
@2028 = ~«Довольно странно... на юго-западе от Морга — только переулок, набитый хорошо вооруженными головорезами. Ты об этом знаешь?»~
@2029 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@2030 = ~«Ничего. Прощай».~
@2031 = ~При твоем приближении рыжеволосая девушка смотрит на тебя, сердито размахивая хвостом из стороны в сторону. «Ну? Че надо?»~ [ANA238D]
@2032 = ~«Ты знаешь, что у тебя есть хвост?»~
@2033 = ~«Ничего, но я заметил, что у тебя есть хвост».~
@2034 = ~«Можешь сказать мне, где я нахожусь?»~
@2035 = ~«Я ищу кое-кого по имени Фарод. Ты не знаешь, где его можно найти?»~
@2036 = ~«Ты сказала, что Фарод находится к юго-западу от Морга, правильно?»~
@2037 = ~«Довольно странно... на юго-западе от Морга — только переулок, набитый хорошо вооруженными головорезами. Ты об этом знаешь?»~
@2038 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@2039 = ~«Ничего. Прощай».~
@2040 = ~«На юго-западе от Морга? Спасибо. Прощай».~
@2041 = ~«*Знаю* ли я? — девушка смотрит на свой хвост. — Ах вот оно че! А я-то думала, что это у меня с глазами что-то. Черт, да ты зоркий, рубака!» Она скалит зубы. «Почему бы тебе не свалить в ту дыру, из которой ты выполз, и не оставить меня в покое?! Ни я, ни мой хвост не продаются, усек?»~
@2042 = ~«Хорошо... Я просто полюбоп...»~
@2043 = ~«Э, ладно... У меня есть другие вопр...»~
@2044 = ~«Тогда неважно. Проща...»~
@2045 = ~«Да, но *почему* у тебя есть хвост?»~
@2046 = ~«Эм, ладно... У меня есть другие вопросы...»~
@2047 = ~«Неважно... Прощай».~
@2048 = ~«Это же очевидно, что ни ты, ни твой хвост не продаются. Ты бы все равно на них не прожила».~
@2049 = ~«Э...»~
@2050 = ~«Че ты сказал, паразит?! А ну-ка повтори!»~
@2051 = ~«Он ничего не говорил... но мне все равно интересно... *почему* у тебя есть хвост?»~
@2052 = ~«Забудь о нем... У меня есть несколько вопросов...»~
@2053 = ~«Он сказал, что ты не смогла бы торговать своим телом».~
@2054 = ~«Он сказал, но я с ним не согласен, что ты не смогла бы торговать своим телом».~
@2055 = ~«Он сказал, и я с ним согласен, что ты не смогла бы торговать своим телом».~
@2056 = ~«Ничего. Мы уходим. Прощай».~
@2057 = ~«Ага, давай, проваливай».~
@2058 = ~Глаза девушки превращаются в щелочки. «Ты че, *тугой*? У тебя, видать, ума, что у камня? А, может, ты — сила тупизны? Да чтоб тебя дабус в стену замуровал!»~
@2059 = ~«Послушай...»~
@2060 = ~«Ладно, неважно. У меня есть другие вопросы...»~
@2061 = ~«Тогда прощай». ~
@2062 = ~«Захлопнись! Больше я те, пень, ничего не скажу! Сгинь!»~
@2063 = ~«Следи за своим языком, девчонка, или нарвешься. Запомни это на следующий раз».~
@2064 = ~Уйти.~
@2065 = ~«Мне надоели твои слова, крошка... пора умирать».~
@2066 = ~Уйти.~
@2067 = ~«Она — тифлинг, шеф. В них есть немного демонической крови, из-за которой они становятся немного подозрительными и бдительными... симпатичный хвостик, кстати. Жаль только, что он приделан к такому уродливому телу».~
@2068 = ~«Ого, а...»~
@2069 = ~«Эй, неплохо сказано, Морт».~
@2070 = ~«Тебе лучше захлопнуть свою черепушку, грязноротый мимир, пока я я те челюсть не оттяпала, усек?»~
@2071 = ~«Прощай».~
@2072 = ~Нечистый довольно поворачивается к тебе. «Ты еще не научил ее манерам, путешественник?»~
@2073 = ~«Анна, держи себя в руках».~
@2074 = ~«Что же ты не *пытаешься* расколоть мою челюсть? Только и дело, что слышу пустую болтовню от всяких отбросов Улья! Давай, попробуй! Я тебе ноги откушу!»~
@2075 = ~«Хватит! Мы уходим».~
@2076 = ~«Хватит!»~
@2077 = ~«Нет. У нее своя голова на плечах, и она говорит, что думает».~
@2078 = ~«Ага, точно. Приструни своего мимира, недоумок, не то я закопаю его рядом с его тушкой, усек?»~
@2079 = ~«Мимир — это говорящая энциклопедия. Это я, шеф».~
@2080 = ~«Понятно».~
@2081 = ~«Ага, вали, откуда пришел».~
@2082 = ~«И тебе прощай».~
@2083 = ~Уйти.~
@2084 = ~«Да, мимир! Че, промеж ушей так пусто, что аж эхом отдает? Вот идиот!»~
@2085 = ~«Ты не ответила на мой вопрос. Что такое мимир?»~
@2086 = ~«Мимир? О чем это ты?»~
@2087 = ~«Хорошо. Послушай, у меня были еще вопросы...»~
@2088 = ~«Прощай».~
@2089 = ~Усмехаясь, она переводит взгляд с Морта на тебя. «Кажись, теперь я врубилась, у кого из вас двоих есть мозги».~
@2090 = ~«Да-да. Слушай, у меня были еще вопросы...»~
@2091 = ~«Прощай».~
@2092 = ~«Во как? Хорошо хоть жмуриками приторговываю, верно? А по тебе, череп, уже топка тленных плачет».~
@2093 = ~«Это еще что? Пытаешься играть со мной в плохого твердолобого, хорошего твердолобого? — она презрительно усмехается. — Слейся, кусок помоев».~
@2094 = ~«Во как? Хорошо хоть жмуриками приторговываю, верно? А по вам обоим уже топка тленных плачет, — ее хвост начинает метаться из стороны в сторону. — Не заставляйте меня прописывать вас в книгу мертвых».~
@2095 = ~«Приторговываешь жмуриками?»~
@2096 = ~«У меня есть другие вопросы...»~
@2097 = ~«Прощай».~
@2098 = ~«Еще нет... У меня есть несколько вопросов...»~
@2099 = ~«Прощай».~
@2100 = ~«Ага, тленный отсыпет звенелок любому, кто притащит к Моргу жмуриков с улицы. Кстати, это моя территория, так что даже не думай искать их здесь, понял?»~
@2101 = ~«Приторговываешь жмуриками?»~
@2102 = ~«Успокойся, крошка. Ответь еще на пару вопросов, а потом мы тебя оставим в покое...»~
@2103 = ~«Это никуда не приведет. Прощай».~
@2104 = ~Уйти.~
@2105 = ~«А зачем тленным мертвецы?»~
@2106 = ~«Твоя территория?»~
@2107 = ~«Отлично».~
@2108 = ~«Прощай».~
@2109 = ~«Чтоб похоронить, как полагается. Отправляют их на правильный план и заботятся, чтобы в мультивселенной все было чистенько и опрятненько».~
@2110 = ~«Да, *план*! Че, промеж ушей так пусто, что аж эхом отдает? Пф-ф! Слишком много вопросов задаешь, шелудивый. Отвали от меня. Иди доставай кого-нибудь другого своими вопросиками».~
@2111 = ~«План?»~
@2112 = ~«Понятно. Послушай, у меня были еще вопросы...»~
@2113 = ~«Прощай».~
@2114 = ~«У меня еще один вопрос...»~
@2115 = ~«Тогда ладно. Прощай».~
@2116 = ~«Да, *моя* территория! Че, промеж ушей так пусто, что аж эхом отдает? Пф-ф! Слишком много вопросов задаешь, шелудивый. Отвали от меня. Иди доставай кого-нибудь другого своими вопросиками».~
@2117 = ~«У меня еще один вопрос...»~
@2118 = ~«Тогда ладно. Прощай».~
@2119 = ~«Эй, полегче, у меня просто пара вопросов...»~
@2120 = ~«Следи за своим языком, крошка. Я *не в настроении*. Так что ответь на мой вопрос. Кто ты?»~
@2121 = ~«Э... Тогда прощай».~
@2122 = ~Она странно смотрит на тебя. «Не-а... Ничего такого не видала».~
@2123 = ~«Хорошо. У меня есть другие вопросы...»~
@2124 = ~«Все равно спасибо. Прощай».~
@2125 = ~«Че, правда? Ну так, может, тебе лучше их спросить, где заныкался старый костыль».~
@2126 = ~Правда: «Хватит врать. Скажи мне, где Фарод, девчонка, или вскоре пополнишь ряды городских мертвецов».~
@2127 = ~Блеф: «Хватит врать. Скажи мне, где Фарод, девчонка, или вскоре пополнишь ряды городских мертвецов».~
@2128 = ~«Может, я так и сделаю. Слушай, у меня были еще вопросы...»~
@2129 = ~«Ну да, — она осторожно смотрит на тебя, — сказала. Ты че, уже забыл?»~
@2130 = ~«Нет, но я бы хотел задать несколько вопросов...»~
@2131 = ~«Нет, просто поинтересовался, может, это *ты* забыла... Понимаешь, на юго-западе от Морга есть только переулок, набитый хорошо вооруженными головорезами. Что-то знаешь об этом?»~
@2132 = ~«Нет, в этот раз. Прощай».~
@2133 = ~Перед тобой бледный мужчина в длинной черной мантии. Он выглядит почти так же, как те люди в Морге, но в отличие от них он кажется смущенным и пялится по сторонам. Едва завидев тебя, он поднимает руку, чтобы привлечь твое внимание.~
@2134 = ~Перед тобой бледный мужчина в длинной черной мантии. В отличии от тленных из Морга, он кажется смущенным и пялится по сторонам, как будто что-то ищет. Едва завидев тебя, он поднимает руку, чтобы привлечь твое внимание.~
@2135 = ~Кажется, мужчина испытывает явное облегчение, когда ты начинаешь разговаривать с ним. Он делает небольшой поклон. «Спасибо, что не прошел мимо, странник. Я — Осыпанный-Пеплом, один из членов секты тленных. Я буду очень признателен, если ты мне поможешь... Я не очень хорошо знаю это место, но ищу некое заведение, бар, в котором часто бывают члены моей секты. Ты не знаешь, где он находится?»~
@2136 = ~Тленный кивает. «Ну да, *фракция*, я имел в виду фракцию... секта, фракция — на самом деле это одно и то же... так ты случайно не знаешь бар, где часто бывают члены моей фракции?»~
@2137 = ~Он вздыхает и поднимает руки. «Мне жаль это признавать, но у меня нет звенелок».~
@2138 = ~Тленный кивает и отвешивает финальный поклон. «Спасибо за уделенное время».~
@2139 = ~Тленный улыбается. «Большое тебе спасибо, странник. Я благодарю тебя за помощь. Люди в Улье... очень редко помогают в подобных случаях».~
@2140 = ~Он кивает. «Твою просьбу можно понять. Скажи мне, где мне найти Бар собирателей пыли, и я буду рад ответить на любой твой вопрос».~
@2141 = ~«Что у тебя за вопросы?»~
@2142 = ~«Прошу прощения, но это имя мне неизвестно».~
@2143 = ~«Не знаю, где ты можешь найти такую вещь. Скорблю по его утрате».~
@2144 = ~Мужчина слегка пожимает плечами. «Я сочувствую твоей потере. В жизни каждого есть много ценных вещей».~
@2145 = ~«Это место... ну, это северо-западный рынок, если я не ошибаюсь. На юго-западе есть какое-то правительственный учреждение... — он ненадолго задумывается. — Кажется, Управление по борьбе с вредителями».~
@2146 = ~Он пожимает плечами. «Улей — очень большое место. Какие-то места я знаю, какие-то — нет».~
@2147 = ~Мужчина моргает. «Ну... На самом деле, я нетипичный тленный».~
@2148 = ~Он умолкает на некоторое время... затем кивает. «С удовольствием. Мы... Тленные... рассматриваем эту жизнь как возможность испытать свои чувства перед следующей. Мы просеиваем тлен наших прошлых жизней в поисках следующих».~
@2149 = ~Мужчина кивает, чувствуя себя немного неуютно. «Ну, я — Осыпанный-Пеплом, член Девятого Круга».~
@2150 = ~Он неожиданно напрягается. «У меня нет времени на обсуждение обычаев и иерархии секты тленных. Так что прошу прощения...»~
@2151 = ~Мужчина смотрит на тебя невинным взглядом, но ты видишь, что он напряжен. «Прошу прощения?»~
@2152 = ~Я не знаю, где это.~
@2153 = ~Он кивает. «Хорошо. Наши пути больше не пересекутся. Найду себе другую аферу... э-э-э, работу, где-нибудь еще».~
@2154 = ~Ты уже готов идти прочь, как вдруг у тебя появляется чувство, что чего-то не хватает. Ты недоверчиво оглядываешься на Осыпанного-Пеплом, едва успевшего спрятать что-то в рукав... кажется, это что-то принадлежало тебе.~
@2155 = ~Ты бы ничего и не заметил, если бы не был настороже. Ты видишь, как во время одного из своих низких поклонов Посыпанный-Пеплом незаметно запускает руку в твой кошелек.~
@2156 = ~Ты бы ничего и не заметил, если бы не был предупрежден о тленном-карманнике. Ты видишь, как во время одного из своих низких поклонов Посыпанный-Пеплом незаметно запускает руку в твой кошелек.~
@2157 = ~Возможно, только благодаря собственным навыкам воровства ты не теряешь бдительности. Перед уходом ты инстинктивно бросаешь взгляд на свой кошелек... и видишь, как Осыпанный-Пеплом вытаскивает из него свою руку. Однако он, кажется, не знает, что ты его подловил.~
@2158 = ~Под предлогом предоставления дополнительной информации о нужных направлениях по местам Улья ты вовлекаешь Осыпанного-Пеплом в непринужденный разговор, при этом украдкой следя за его движениями. Похоже, Осыпанный-Пеплом полностью уверился, что его маскировка под тленного сведет на нет подозрительность жертвы, и что частые поклоны прикроют его попытки залезть в карман. Ты мысленно отмечаешь его технику... вплоть до того момента, когда он в очередной раз пытается добраться до твоего кошелька.~
@2159 = ~Твоя рука молниеносно выстреливает и хватает его запястье мертвой хваткой. Ты отмечаешь, что он уже не пытается строить из себя тленного, и, рыча, пытается вырваться из твоей руки. «Отпусти меня, псина, не то я позову стражу!»~
@2160 = ~Твоя рука молниеносно выстреливает, но тут Осыпанный-Пеплом внезапно отступает, и ты не дотягиваешься до его запястья. Ты наблюдаешь, как он сбрасывает свою маскировку и с ошалелым видом бросается наутек!~
@2161 = ~Осыпанный-Пеплом внезапно бросается наутек!~
@2162 = ~«Тьфу». Он выглядит более чем расстроенным. «Что меня выдало?»~
@2163 = ~«Ну и что у тебя за вопросы?»~
@2164 = ~Он пожимает плечами. «Никто не заподозрит тленного, — он глупо смеется. — Можно наварить неплохой куш, пока кто-нибудь не поймает на афере».~
@2165 = ~Глаза мужчины сужаются. «У меня ничего нет. Ты — моя первая жертва за сегодня».~
@2166 = ~Он ворчит, пытаясь оценить шансы разобраться с тобой, но затем, трезво оценив обстановку, касается внутренней прокладки своей мантии. Резко дергая рукой, он разрывает мантию и вытаскивает оттуда небольшую кучку медяков. Ты бы ни за что не нашел их, если бы он сам не показал.~
@2167 = ~Он скалит зубами. «У меня больше ничего нет».~
@2168 = ~Ты пытаешься обыскать его, но внезапно из его рукава появляется кинжал. Рыча, он нападает на тебя!~
@2169 = ~Мужчина хмурится. «И? Ты думаешь, я обращаю внимание на такие вещи? Я работаю только со звенелками, пень».~
@2170 = ~«А что с ним?»~
@2171 = ~«А ты меня отпустишь, если скажу?»~
@2172 = ~Он сплевывает на землю. «Тогда мне нечего сказать по этому поводу».~
@2173 = ~«Фарод — босс сборщиков. Под его властью много мальчиков на побегушках, и поговаривают, что у него все схвачено. Больше об этом я ничего не знаю. Я бы был настороже, если бы имел с ним дело».~
@2174 = ~«Его берлога находится на площади Старьевщиков... это такая большая куча тряпок и всякого мусора к северо-западу отсюда. Иди через северные ворота до тех пор, пока не уткнешься в нее. Говорят, что Фарод прячется под какой-то мусорной кучей, может, даже похоронен под ней. Кто знает? Теперь ты меня отпустишь?»~
@2175 = ~Он выглядит разозленным. «Ты *говорил*, что отпустишь меня».~
@2176 = ~Ты снова видишь Осыпанного-Пеплом... он все еще выглядит потерянным и что-то бормочет, пялясь на здания.~
@2177 = ~«Боюсь, что я забыл направление, сэр. Могу ли я еще раз услышать, как мне попасть в назначенное место?»~
@2178 = ~«Я ухожу! Оставь меня в покое!»~
@2179 = ~«Я помню, что раньше вы не смогли помочь мне, сэр. Возможно, в этот раз вы сможете подсказать, где находится бар, в котором часто бывают члены моей секты?»~
@2180 = ~«Приветствую».~
@2181 = ~Не обращать на него внимания.~
@2182 = ~«Приветствую».~
@2183 = ~Не обращать на него внимания.~
@2184 = ~«Знаешь, тут ходят слухи о карманном воре, который наряжается как тленный. Ты случайно его не знаешь?»~
@2185 = ~«Секты? Ты, наверное, имел в виду фракции?»~
@2186 = ~«Секты? Ты ведь тленный. Наверное, ты имел в виду фракции?»~
@2187 = ~«А, бар тленных? Он рядом с Моргом. Иди от главных ворот Морга строго на юго-запад. Ты его не пропустишь».~
@2188 = ~«Я слыхал о нем. Я помогу тебе... в обмен на награду».~
@2189 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... в обмен на награду».~
@2190 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@2191 = ~«Нет, извини, я не знаю, где это находится».~
@2192 = ~Ложь: «Нет, извини, я не знаю, где это находится».~
@2193 = ~«Я не могу помочь тебе. Прощай».~
@2194 = ~«Я не могу помочь тебе. Прощай».~
@2195 = ~«Знаешь, тут ходят слухи о карманном воре, который наряжается как тленный. Ты случайно его не знаешь?»~
@2196 = ~«Бар, который ты ищешь, рядом с Моргом. Иди от главных ворот Морга строго на юго-запад. Ты его не пропустишь».~
@2197 = ~«Я слыхал о нем. Я помогу тебе... в обмен на награду».~
@2198 = ~«Я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@2199 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... в обмен на награду».~
@2200 = ~Ложь: «Э-э-э... ага, я слыхал о нем. Я помогу тебе... если ты ответишь на мои вопросы».~
@2201 = ~«Нет, извини, я не знаю, где это находится».~
@2202 = ~Ложь: «Нет, извини, я не знаю, где это находится».~
@2203 = ~«Я не могу помочь тебе. Прощай».~
@2204 = ~«Я не могу помочь тебе. Прощай».~
@2205 = ~«Тогда забудь об этом. Бар, который ты ищешь, рядом с Моргом. Иди от главных ворот Морга строго на юго-запад. Ты его не пропустишь».~
@2206 = ~«Давай так: ты ответишь на несколько моих вопросов — и мы в расчете».~
@2207 = ~Перед тобой симпатичная девушка. Ее волосы спутаны, а корсаж платья разорван. Будучи явно на грани отчаяния, она замечает тебя.~
@2208 = ~«Приветствую».~
@2209 = ~Игнорировать ее.~
@2210 = ~Древний свиток~
@2211 = ~Вортен~
@2212 = ~Вортен~
@2213 = ~Старший глабрезу~
@2214 = ~Старший глабрезу~
@2215 = ~Кестер~
@2216 = ~Кестер~
