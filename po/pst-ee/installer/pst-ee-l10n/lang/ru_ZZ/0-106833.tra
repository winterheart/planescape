@38291 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@38292 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@38293 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@38294 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
@38295 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
