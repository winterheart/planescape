@17013 = ~::Зевает::~
@17014 = ~«Прошу прощения, госпожа! Теперь я понял».~
@17015 = ~«УВЕРЕНА ЛИ Я? ДА!»~
@17016 = ~«Вы уверены?»~
@17017 = ~«ЭТА ДЕТАЛЬ СЮДА НЕ ПОДХОДИТ!»~
@17018 = ~«А?»~
@17019 = ~«Интересно, что она делает?»~
@17020 = ~«Эта штука никогда не заработает».~
@17021 = ~«Привет, Боб!»~
@17022 = ~«Похоже, сегодня одни ходячие жмурики...»~
@17023 = ~«Кажется, трухлявые потеряли одного из своих жмуриков...»~
@17024 = ~«Фу! Никогда еще не видела ничего ужасней...»~
@17025 = ~«Ты че, *недоумок*?! Если продолжим здесь стоять — точно привлечем к себе взгляд Леди!»~
@17026 = ~«Это ведь одна из студий Фелла? Давно хотел с ним познакомиться».~
@17027 = ~«Смотри, чтобы этого больше не повторилось».~
@17028 = ~«Если не найду жмурика, придется прирезать трухлявого...»~
@17029 = ~«Старый костыль, наверно, сейчас считает медяки...»~
@17030 = ~«Еще один неторопливый сигильский день...»~
