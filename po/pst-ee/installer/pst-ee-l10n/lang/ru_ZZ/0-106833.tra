@50317 = ~«Неважно. Извини за беспокойство. Прощай».~
@50318 = ~«Приветствую».~
@50319 = ~Существо поворачивается к тебе, и над его головой появляется несколько символов. Они слегка светятся и... парят в воздухе.~
@50320 = ~«Ох, силы небесные! Чертов дабус».~
@50321 = ~«Что не так?»~
@50322 = ~«Он — дабус. Они 'разговаривают' ребусами, этими тупыми словесными головоломками. Если *ты* не знаешь, что он говорит, то тогда нам лучше поискать кого-нибудь из местных или какой-нибудь другой способ общаться с ними... если нам это надо. Чертово племя. Знаешь что? Да они *умеют* разговаривать, просто они хотят вывести из себя того, кто пытается разгадать их головоломки».~
@50323 = ~«Что за 'дабус'?»~
@50324 = ~«Говорят, что они слуги Леди Боли. Они парят повсюду и ломают, чинят и латают Сигил по ее капризу. Они хуже трупных мух, — Морт вздыхает. — Не нужно их трогать, а не то Леди... рассердится».~
@50325 = ~«'Леди Боли'? Кто это?»~
@50326 = ~«Она заправляет городом. Ты узнаешь ее, когда увидишь: у нее вокруг лица клинки, она ростом с гиганта и парит над землей, совсем как эти парни». Морт кивает на дабуса, смотрящего на вас обоих. «Про нее никто почти ничего не знает... она не очень говорлива. Все, что тебе следует знать: не зли ее. Если увидишь ее, мой тебе совет — тикай».~
@50327 = ~«Понятно».~
@50328 = ~«Что ты можешь рассказать о Леди Боли?»~
@50329 = ~«Понятно».~
@50330 = ~Оставить существо в покое.~
@50331 = ~Перед тобой дабус. Он одет в длинное развевающееся одеяние и слегка парит над землей.~
@50332 = ~«Приветствую».~
@50333 = ~Оставить дабуса в покое.~
@50334 = ~Перед тобой дабус. Он одет в длинное развевающееся одеяние и слегка парит над землей.~
@50335 = ~Он поворачивается к тебе, и над его головой появляется несколько символов. (Нужно выполнять свои обязанности. Нет времени на разговоры.)~
@50336 = ~Дабус склоняет голову набок. Над головой появляется поток из символов, большинство из них излучают скорее удивление и боль, чем какие-то слова. (Мертвого? Где?)~
@50337 = ~Дабус, внимательно посмотрев на тебя, кивает и парит прочь в направлении заброшенного здания.~
@50338 = ~Он поворачивается к тебе, и над его головой появляется несколько символов. Они слегка светятся и... парят в воздухе.~
@50339 = ~Дабус склоняет голову набок. Над головой появляется поток из символов. Хоть ты и не можешь понять, что он говорит, ты замечаешь, что в конце сообщения пульсирует яркий вопросительный знак.~
@50340 = ~«Приветствую».~
@50341 = ~«Приветствую».~
@50342 = ~Оставить дабуса в покое.~
@50343 = ~«Понимаю. Просто подумал, что ты должен это знать. Я нашел тело дабуса на этой улице».~
@50344 = ~~
@50345 = ~Правда: «Оно лежит в заброшенном здании неподалеку отсюда. Похоже, он каким-то образом оказался внутри в западне».~
@50346 = ~Ложь: «Оно лежит в заброшенном здании неподалеку отсюда. Непонятно, как он мог умереть».~
@50347 = ~«Прощай».~
@50348 = ~«Э-э... Просто подумал, что ты должен это знать: я нашел тело дабуса на этой улице».~
@50349 = ~~
@50350 = ~Правда: «Оно лежит в заброшенном здании неподалеку отсюда. Похоже, он каким-то образом оказался внутри в западне».~
@50351 = ~Ложь: «Оно лежит в заброшенном здании неподалеку отсюда. Непонятно, как он мог умереть».~
@50352 = ~~
@50353 = ~~
@50354 = ~~
@50355 = ~Ты видишь тело мертвого дабуса. Запах гниения просто невыносим. Судя по скованной, неестественной позе, тело давно охватило трупное окоченение. Однако все же тебе каким-то образом удалось пробудить место.~
@50356 = ~Использовать на трупе свою способность «История костей».~
@50357 = ~В течение нескольких секунд ничего не происходит. Затем из открытого рта трупа неожиданно издается слабое сопение.~
@50358 = ~«Привет? Ты слышишь меня?»~
@50359 = ~Несколько секунд висит тишина, после которых рот трупа без предупреждения начинает шевелиться. «Конечно я слышу тебя! Я же *мертвый*, а не глухой... ты, словоблудный ниггер».[Temp Line written by Steve Bokkes]~
@50360 = ~«Спокойнее... Я просто хочу задать пару вопросов».~
@50361 = ~«Вопросов? Я что, похож на справочную, засранец?»[Temp Line written by Steve Bokkes]~
@50362 = ~«Какой странный говор... А разве вы, дабусы, не должны говорить загадками?»[Temp Line written by Steve Bokkes]~
@50363 = ~«Черт! Еще одна тупая белая жопа. Всем известно, что смерть — универсальный язык. Какой черт мне прок от этих тупорылых знаков, если ты даже кусок из них понять не можешь? И как тогда ты потом квест решать будешь, а? Да и к тому же, это всего лишь заготовка диалога, балда».[Temp Line written by Steve Bokkes]~
@50364 = ~«Хоть скажи мне, как ты умер, чтобы я смог завершить этот чертов квест Беременной улицы и попасть в Нижний район».~
@50365 = ~«Запросто, белозадый. Вышло типа того. Я приперся сюда на улицу, выяснить, какого хрена здесь творится с домами и все такое. Ну так вот, я ввалился сюда, и все что я понял — двери и окна типа захлопнулись. Я пытался пробить выход, вот только при каждом вылетевшем из стены куске дом ремонтировался обратно».[Temp Line written by Steve Bokkes]~
@50366 = ~«Спасибо, ты мне очень помог».~
@50367 = ~«Хватит трепаться, обезьяна!»[Temp Line written by Steve Bokkes]~
@50368 = ~Уйти.~
@50369 = ~«Хоть скажи мне, как ты умер, чтобы я смог завершить этот чертов квест Беременной улицы и попасть в Нижний район».~
@50370 = ~Оставить мертвеца в покое.~
@50371 = ~Ты видишь тело мертвого дабуса. Запах гниения просто невыносим. Судя по скованной, неестественной позе, тело давно охватило трупное окоченение. Однако все же тебе каким-то образом удалось пробудить место.~
@50372 = ~Использовать на трупе свою способность «История костей».~
@50373 = ~Оставить мертвеца в покое.~
@50374 = ~Мертвому дабусу больше нечего тебе сказать. Попробуй как-нибудь в другой раз, когда Стив доделает этот диалог.[Temp Line written by Steve Bokkes]~
@50375 = ~Уйти.~
@50376 = ~Это записи покойного лингвиста Фина Эндли. Они состоят из его исследований языка Уйо... который очень напоминает записи, обнаруженные тобой в додекаэдре-головоломке.~
@50377 = ~Внимательно прочесть их, надеясь пробудить память.~
@50378 = ~Отложить их.~
@50379 = ~Я прочел записи лингвиста Фина Эндли, и обнаружил, что я уже знаю язык, на котором сделаны записи в додекаэдре-головоломке, — это мертвый язык Уйо. Теперь я, наконец, смогу их прочесть.~
@50380 = ~Читая записи Фина Эндли, касающиеся забытого языка Уйо, ты начинаешь ощущать пульсацию в висках: это возвращаются твои воспоминания... воспоминания об этом языке.

Ты вспоминаешь буквы, слова, фразы, и вот язык снова раскрывается тебе во всей полноте, как будто ветер со Шпиля разогнал покрывало ядовитого дыма Великой Литейной в твоем разуме. Теперь ты можешь прочесть записи на додекаэдре.~
@50381 = ~Отложить записи.~
@50382 = ~Это записи покойного лингвиста Фина Эндли. Они состоят из его исследований языка Уйо.~
@50383 = ~Отложить их.~
@50384 = ~Это старый, поблеклый, безобидный с виду свиток пергамента, связанный красной лентой и слегка отдающий плесенью. Лента скреплена обычной восковой печатью.~
@50385 = ~Сломать печать, вскрыть свиток и прочесть его.~
@50386 = ~Отложить свиток.~
@50387 = ~В свитке несколько строк, написанных неровным почерком, и странная руна. В нем написано:

«это может и не УБИТЬ тебя но по крайней мере ЗАМЕДЛИТ я в этом УВЕРЕН»
«ХВАТИТ ПРЕСЛЕДОВАТЬ МЕНЯ УБЛЮДОЧНЫЕ ВОРЫ это МОЕ тело МОЕ МОЕ МОЕ»
«а теперь... СДОХНИ»~
@50388 = ~«Что за?..»~
@50389 = ~~
@50390 = ~~
@50391 = ~Додекаэдр~
@50392 = ~Додекаэдр~
@50393 = ~Безделушка~
@50394 = ~Это заклинание уже есть в книге заклинаний персонажа.~
@50395 = ~Книга заклинаний данного персонажа заполнена до максимума заклинаниями этого уровня.~
@50396 = ~Магический предмет!~
@50397 = ~Улика!~
@50398 = ~Мешочек с монетами~
@50399 = ~То, что сперва показалось тебе ничем не примечательной книгой, закрытой на крохотный латунный замочек, на самом деле имеет переплет из необычной кожи, украшенный заколдованной бронзой. Названа она просто: «Кодекс необъяснимого».~
@50400 = ~Открыть ее... и прочесть!~
@50401 = ~Благоговейно спрятать книгу.~
@50402 = ~Ты отпираешь крепления и открываешь книгу. Когда ты окидываешь взглядом ее содержание, у тебя отпадает челюсть. Ты стоишь, завороженный, листая ее страницы. Ее содержимое попросту невозможно описать: кажется, что простые слова не в силах объяснить все скрытые в ней чудеса.~
@50403 = ~«Это было... это... я...»~
@50404 = ~Глашатай хранилища Девятого мира~
@50405 = ~«Это было... это... я...»~
@50406 = ~Минуту ты задумчиво стоишь, глядя на Кодекс, после чего закрываешь его и почтительно прячешь.~
@50407 = ~Уйти.~
@50408 = ~Кодекс необъяснимого обернут в переплет из необычной кожи и заколдованной бронзы. Его содержимое попросту невозможно описать: кажется, что простые слова не в силах объяснить все скрытые в нем чудеса.~
@50409 = ~Благоговейно спрятать книгу.~
@50410 = ~«Что? Что? Что в ней было, шеф?»~
@50411 = ~«Не знаю, что и сказать, Морт...»~
@50412 = ~«Ничто из того, что тебя касается, Морт».~
@50413 = ~Показать ему Кодекс.~
@50414 = ~«ЧТО? Наверно, ты шутишь? Брось, дай посмотреть!»~
@50415 = ~Показать ему Кодекс.~
@50416 = ~«Нет, Морт. Просто забудь, что ты его видел».~
@50417 = ~Морт что-то недовольно бормочет... но прекращает разговор.~
@50418 = ~Морт взлетает над твоим плечом, чтобы ознакомиться с содержимым Кодекса. Его глаза чуть не вываливаются из глазниц, пробегая по его страницам. «О-о-о. О-о-о-о. О, я... но... ого».~
@50419 = ~Этот желтоглазый, истекающий слюной упырь воняет кровью и падалью. Он перебирает своими крючковатыми пальцами с длинными грязными когтями, беспрестанно нюхая воздух. Его кожа болезненно-зеленого цвета и покрыта гниющими влажными язвами.~
@50420 = ~«Приветствую...»~
@50421 = ~Оставить упыря в покое.~
@50422 = ~Эта упыриха воняет кровью и падалью. По ее длинным тонким волосам, которые она то и дело убирает со своих желтых глаз жуткими когтями, ползают жуки и черви. Ее кожа болезненно-зеленого цвета и покрыта гниющими влажными язвами.~
@50423 = ~«Приветствую...»~
@50424 = ~~
@50425 = ~Оставить упыриху в покое.~
@50426 = ~Этот разлагающийся труп женщины сперва совершенно тебя не замечает. Однако при твоем приближении она поворачивается и медленно кивает, как бы приветствуя тебя.~
@50427 = ~«Приветствую...»~
@50428 = ~«Приветствую...»~
@50429 = ~Это обыкновенный тяжелый металлический кувшин с пробкой на шарнире. Несмотря на вполне обычный внешний вид, тебе совершенно не хочется прикасаться к этой вещи, как будто она может тебя укусить. Тебе сказали, что внутри кувшина заточен какой-то монстр, однако в горлышке кувшина видна только чернильная темнота.~
@50430 = ~Меч Винн (также известный под названием «Клинок мошенника») больше похож на декоративный кинжал, чем на годное для боя оружие. Хотя его балансировка оставляет желать лучшего, на него наложена могущественная магия, и потому в бою он эффективнее, чем более «обычный» нож. Однако величайшая сила меча Винн заключается в способности позволять своему владельцу жульничать: попросту держа «меч» поднятым в соответствующей театральной позе, его владелец победит в любой игре, в которой будет найден этот артефакт.~
@50431 = ~Это заглушка для текста.~
@50432 = ~Перевернуть кувшин: вдруг что-нибудь выпадет.~
@50433 = ~Спрятать кувшин.~
@50434 = ~Сперва ничего не происходит... затем ужасная черная жидкость начинает пузыриться, вытекая из горлышка кувшина и образуя на земле лужу дымящейся маслянистой мерзости. Кувшин начинает растворяться у тебя в руках, а лужа — волноваться и вздыматься, образуя высокое отвратительное существо...~
@50435 = ~«Что за?..»~
@50436 = ~Сжульничать: встать, слегка расставив ноги, напрячь мышцы и торжественно пронзить клинком небеса.~
@50437 = ~Пока отложить кинжал.~
@50438 = ~По лезвию Меча Винн проходит волна силы. Где-то вдалеке слышен раскат грома. Через миг игра закончится...~
@50439 = ~Наблюдать...~
@50440 = ~Хамрис улыбается тебе. «Добрый день, сэр. Ты еще не разобрался с ситуацией на складе?»~
@50441 = ~«Нет, я все еще работаю над этим. Прощай».~
@50442 = ~«Нет, но у меня есть вопросы к тебе...»~
@50443 = ~Хамрис улыбается тебе. «И снова привет, рубака. Забрал планы, которые искал?»~
@50444 = ~«У меня есть несколько вопросов...» ~
@50445 = ~«Неважно, прощай».~
@50446 = ~Ты видишь пожилого мужчину в элегантных одеждах. У него ясный взгляд и теплая улыбка. Когда ты подходишь, он делает тебе небольшой поклон. «Добрый день, рубака. Я Себастион. Чем могу быть полезен?»~
@50447 = ~«Приветствую».~
@50448 = ~Не обращать внимания на мужчину.~
@50449 = ~Интеллект данного персонажа слишком низок, чтобы скопировать это заклинание.~
@50450 = ~Ты точно хочешь убрать это заклинание из списка запомненных?~
@50451 = ~Скатч~
@50452 = ~Меч Винн~
@50453 = ~Елаан~
@50454 = ~Герик~
@50455 = ~Гиб~
@50456 = ~Пеато~
@50457 = ~Анизиус~
@50458 = ~Сиабха~
@50459 = ~Роберта~
@50460 = ~Анизиус~
@50461 = ~Успешное быстрое сохранение~
@50462 = ~~
@50463 = ~~
@50464 = ~«Они уже мертвы».~
@50465 = ~«Они уже мертвы. Увы, и девочка тоже».~
@50466 = ~«Научи меня какому-нибудь оружию».~
@50467 = ~~
@50468 = ~«Они уже мертвы».~
@50469 = ~«Они уже мертвы. Увы, и девочка тоже».~
@50470 = ~Улыбчивый мужчина приветливо кивает, когда ты подходишь. «Добро пожаловать в мое кафе, уважаемый сэр. Чем могу служить? Может быть, вина?»~
@50471 = ~«Это он?»~
@50472 = ~«Это ведь череп? Его-то ОН и хотел. Хватайте его».~
@50473 = ~«Девять кругов ада, да что ты такое...»~
@50474 = ~«Эй! Пустите! Пустите! На помощь! ПОМОГИТЕ!»~
@50475 = ~«Эй, босс! Я тут, на полке справа от лестницы!»~
@50476 = ~«Быстро 'сваливай', если не хочешь неприятностей. Убирайся прочь!»~
@50477 = ~«Сэр! Сэр! Могу ли я с вами поговорить?»~
@50478 = ~::Упирается руками в стены в невидимом ящике::~
@50479 = ~::Лезет по невидимой веревке::~
@50480 = ~«Так-так... летающий изворотливый череп без тела...»~
@50481 = ~«Так-так... Падшая Грация... или как ты там себя теперь называешь. Воистину, рада тебя видеть здесь. И чем же я обязана быть удостоенной твоим визитом? Я-то думала, ты теперь нечасто имеешь дело с нашим братом, — она несколько секунд смотрит на тебя с той же легкой усмешкой. — Или твоя миссия здесь подошла к концу?»~
@50482 = ~«Так-так... летающий изворотливый череп без тела и Падшая Грация... или как ты там себя теперь называешь. Воистину, рада тебя видеть здесь. И чем же я обязана быть удостоенной твоим визитом? Я-то думала, ты теперь нечасто имеешь дело с нашим братом, — она несколько секунд смотрит на тебя с той же легкой усмешкой. — Или твоя миссия здесь подошла к концу?»~
@50483 = ~Она сужает глаза. «Ты... ты и есть тот человек в шрамах, который ходит тут вокруг и задает всякие вопросы? — она осматривает тебя с головы до ног. — Ты определенно выглядишь потерявшимся. Ты действительно хотел сюда зайти или просто так здесь ошиваешься, от нечего делать?»

«Потому что Вришика, — она указывает на себя, — может тебе помочь».~
@50484 = ~Она отвечает резко, отстреливаясь вопросами, словно стрелами: «Это мой выбор. А ты? Куда дальше приведут тебя приказы? — неожиданно она поворачивается к тебе. — Ты увидишь, *человечек*, — Вришика улыбается, будто смакуя слова, — лучшая соблазнительница — это та, которая может заставить тебя купить иллюзию того, что она целомудренная и неразборчивая в связях в одно и то же время; святая проститутка, так сказать. Госпожа Грация — одна из величайших, — она поворачивается к Падшей Грации, — разве не так? Ты ведь не думаешь, что груз тысячелетнего рабства не оставил шрамов?»~
@50485 = ~«Чем ты можешь мне помочь?»~
@50486 = ~«Что это за место?»~
@50487 = ~«У меня тут несколько вопросов...»~
@50488 = ~«Нет, спасибо. Прощай».~
@50489 = ~«Хорошо. Однако же вы зашли в *мой* магазин». Вришика смотрит на тебя.~
@50490 = ~«Я отвечу на любые вопросы касательно торговли, но не собираюсь быть втянутой в твои знаменитые двадцать-вопросов-обо-всем-вокруг-шпиля, *понятно*?»~
@50491 = ~«Интересуешься покупкой рабов или слуг, Вришика?»~
@50492 = ~«Кто ты, Вришика?»~
@50493 = ~«Что ты имела в виду, назвав Морта 'изворотливым'?»~
@50494 = ~«Похоже, вы с Падшей Грацией небезразличны друг к другу...»~
@50495 = ~«Ну, хотя бы расскажи мне об этом месте».~
@50496 = ~«Тогда давай посмотрим на твой товар».~
@50497 = ~«В таком случае, прощай».~
@50498 = ~«Все, что ты видишь в этом магазине, — результат торговли и путешествий по планам, — она обводит магазин широким жестом. — Здесь можно купить оружие, амулеты... а также другие, *особые* товары... этот магазин наполнен редким и самым что ни есть отборным товаром. Я удовлетворю любые твои запросы».~
@50499 = ~«У меня есть другие вопросы...»~
@50500 = ~«Тогда давай посмотрим на твой товар».~
@50501 = ~«Это все, что я хотел узнать. Прощай».~
@50502 = ~«Изворотливый... искажающий правду, вероломный, лицемерный, *лживый*... о, я это сказала? Я имела в виду, летающий *напыщенный* череп без тела. Вечно выдает свое мнение в напыщенной догматичной манере». Вришика невинно улыбается.~
@50503 = ~«Хм-м. У меня еще вопрос...»~
@50504 = ~«Тогда ладно. Давай посмотрим на твои товары...»~
@50505 = ~«Понятно... Это все, что я хотел узнать. Прощай».~
@50506 = ~~
@50507 = ~«А, эта подстилка баатезу, поселившаяся в Сигиле? Любопытно, не правда ли? Хотя, с другой стороны, что может быть лучшим местом для обучения ее агентов, чем этот ее 'бордель'...»~
@50508 = ~«Подстилка баатезу?»~
@50509 = ~«Обучения ее агентов?»~
@50510 = ~«Хм-м. У меня еще вопрос...»~
@50511 = ~«Хотелось бы посмотреть на твой товар...»~
@50512 = ~«Это все, что я хотел узнать. Прощай».~
@50513 = ~«С тех пор, как ее мать продала ее в рабство, она была игрушкой планов на протяжении многих веков. Она утверждает, что смогла освободиться от оков, но ты можешь верить ее слову не больше, чем слову любой другой сучки-танарри, — она слегка улыбается. — Кроме меня, конечно».~
@50514 = ~«Правда?! *Правда*?! Никто не может 'выпутаться' из договора с баатезу, ты, сучка под человеческой личиной. Ты врешь, и все танарри знают об этом — от низших легионов до самих суккубов-молокососок, скачущих по планам. 'Падшая Грация с самого рождения была рабыней баатезу, и останется ею *навсегда*'. Ты по-прежнему игрушка в руках баатезу. Они мучают тебя, они распоряжаются тобой, как им заблагорассудится, — Вришика ухмыляется. — Ты даже *ведешь* себя как они».~
@50515 = ~«Хватит! Я больше не желаю слушать твою ложь в моем присутствии!»~
@50516 = ~«Да... они ее глаза и уши — в городе Сигил и во всех планах. Все, что они не могут увидеть или услышать, они выуживают из других людей. Кто бы мог подумать, что люди способны на подобную хитрость и обман? О, Грация действительно умна. Может, и не настолько, насколько ее мать, но все же...»~
@50517 = ~«О, *конечно* же, нет! Как я смею предполагать подобное? Но, наверное, тебе следовало бы позволить ему решать самому, — Вришика поворачивается к тебе, сверкая глазами. — Тебя это не удивляет, человечек? Неужели в твою голову не закрадывался хоть малейший намек на сомнение или хоть любопытство? Неужели порядки в борделе не показались тебе *странными*?»~
@50518 = ~Вришика продолжает до того, как ты успеваешь ответить. «Бритва Оккама может оставить шрам, но может и удалить тяжкую болезнь, так часто вызываемую ядом лжецов и мечтателей».

«И вот она здесь, путешествует с тобой. Весьма любопытно. Зачем владелице подобного заведения покидать его по какой-либо причине? И ради человека, которого она едва знает? Вопросы, вопросы...»

«Ответы могут оказаться весьма неприятными».
~
@50519 = ~«О, я уверена, что он просил... какой мужчина сможет сопротивляться?» Вришика ухмыляется и с отвращением смотрит в сторону.~
@50520 = ~«Что ты там говорила насчет того, что она — подстилка баатезу?»~
@50521 = ~«У меня есть другие вопросы...»~
@50522 = ~«Хотелось бы посмотреть на твой товар...»~
@50523 = ~«Это все, что я хотел узнать. Прощай».~
@50524 = ~Вришика громко вздыхает. «Алу-демон... полунечисть. Моя мать — танарри, нечистый дух, а мой отец — великий царь смертных. Какой грубый вопрос... хотя, с другой стороны, ты и сам выглядишь грубым, не так ли?»~
@50525 = ~«У меня есть другие вопросы...»~
@50526 = ~«Хотелось бы посмотреть на твой товар...»~
@50527 = ~«Это все, что я хотел узнать. Прощай».~
@50528 = ~«Я много путешествую и торгую. Я много слышу, много покупаю и многим владею. Возможно, и тебе я многим смогу помочь. Ты чего-нибудь желаешь?»~
@50529 = ~«Только ответы на несколько вопросов...»~
@50530 = ~«Возможно. Чем ты торгуешь?»~
@50531 = ~«Нет, не сейчас. Прощай».~
@50532 = ~Невозможно использовать предмет.~
@50533 = ~«Хочешь посмотреть оружие и амулеты? Или какие-нибудь из моих более *экзотических* приобретений?»~
@50534 = ~«Оружие и амулеты...»~
@50535 = ~«Экзотические товары...»~
@50536 = ~«На самом деле, ничего. Прощай».~
@50537 = ~Неправильный тип предмета~
@50538 = ~Предмет проклят!~ [Z_CURSE]
@50539 = ~Вришика улыбается, пока ты рассматриваешь полки в средней части магазина. «Если не подберешь себе чего-нибудь здесь, в передней и задней частях магазина есть другие товары».~
@50540 = ~~
@50541 = ~~
@50542 = ~~
@50543 = ~~
@50544 = ~Предмет не опознан~
@50545 = ~Нет способности~
@50546 = ~Инвентарь полон~
@50547 = ~ЗЕРТСКИЙ КЛИНОК ДАККОНА («КРАДУЩИЙ БРАТЬЕВ»)
Урон: 3-10 рубящий
Магический урон: +1
Особенности: Запоминание 1-го дополнительного заклинания мага 1-го уровня
THAC0: +1
Скорость: 7
Вес: 5
Специализация: клинковые
Используется только Дакконом

В родном плане гитцераев, Лимбо, материя — довольно редкий предмет. Сам Лимбо состоит из вязкой массы элементов, и только сила воли гитцерая сможет придать ей осязаемую и стабильную форму.

Субстанция под названием *карач* — это материал, формируемый силой мысли. Из этого же вещества сделан клинок Даккона. Целостность клинка сохраняется одной лишь ментальной дисциплиной Даккона. Когда дух и дисциплина воина начинают ослабевать, клинок реагирует на это, отражая мысли своего владельца.

Должно быть, Даккон действительно страдает, поскольку его лезвие из *карача*стало абсолютно черным, повторяя его глаза. Сейчас оно длиннее и острее; ряд острых зубцов, похожих на зубы, тянется теперь по краю лезвия.

Клинок представляет для Даккона какую-то религиозную ценность. Он обернул рукоятку клинка несколькими кусочками пергамента. Похоже, это молитвы, посвященные Зертимону.~
@50548 = ~Заметки Фина Эндли~
@50549 = ~~
@50550 = ~~
@50551 = ~Осмотреть язык нечистого.~
@50552 = ~Осмотреть мазь Горгоны.~
@50553 = ~~
@50554 = ~Осмотреть металлическую фигурку-куб.~
@50555 = ~Осмотреть кувшин с монстром.~
@50556 = ~~
@50557 = ~~
@50558 = ~~
@50559 = ~~
@50560 = ~~
@50561 = ~~
@50562 = ~«На самом деле, позволь мне посмотреть на оружие и амулеты...»~
@50563 = ~«В данный момент меня ничего не заинтересовало. Прощай, Вришика».~
@50564 = ~Вришика замечает, что ты рассматриваешь книгу с названием «ЧИТ-КОДЫ». «Да... они как раз то, о чем ты подумал. Давай, погляди на них».~
@50565 = ~«Чит-коды? Не понял...»~
@50566 = ~Осмотреть различные чит-коды.~
@50567 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50568 = ~«В данный момент меня ничего не заинтересовало. Прощай, Вришика».~
@50569 = ~Невозможно переместить предмет~
@50570 = ~Клинок Бессмертного~
@50571 = ~Кассий~
@50572 = ~Рая~
@50573 = ~«О, да брось, — Вришика кладет руки на пояс и склоняет голову набок. — Не строй из себя дурачка! Запомни, я — нечистый дух; я могу *учуять* твое возбуждение. Да... — она говорит медленно, будто разговаривая с ребенком. — Это *мошеннические* коды. Они дают тебе возможность *МУХЛЕВАТЬ*. Давай... осмотри их. Они не кусаются».~
@50574 = ~Осмотреть различные чит-коды.~
@50575 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50576 = ~«Нет, спасибо. Прощай, Вришика».~
@50577 = ~В книге есть несколько глав: чит телепортации, чит лечение, чит на деньги, чит перезарядки заклинаний, чит улучшения атрибутов, чит смерти, чит на исследование территории, чит доброго слова и чит злого слова.~
@50578 = ~«Что ты за них хочешь?»~
@50579 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50580 = ~«Нет, спасибо. Прощай, Вришика».~
@50581 = ~Ты осматриваешь ряд маленьких бутылочек, на каждой из которых написано «Детское масло». Вришика поднимает одну из них и показывает тебе. «Интересует? Оно, конечно же, настоящее. На его изготовление ушли тысячи хнычущих детей смертных».~
@50582 = ~«Э... нет, спасибо. Позволь мне взглянуть на другие вещи».~
@50583 = ~«Нет, спасибо. Прощай, Вришика».~
@50584 = ~Ты осматриваешь небольшое изогнутое, похожее на чертенка существо, сделанное из чистого молочного шоколада. «Выглядит аппетитно, не так ли? Поставляется с Нижних планов. Знаешь, а они редкостные, и высоко ценятся любителями сладостей. Это настоящий квазит, бесовской фамильяр, превращенный в шоколад с помощью могущественной магии. Всего сто девяносто девять медяков».~
@50585 = ~«Беру».~
@50586 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50587 = ~«Нет, спасибо. Прощай, Вришика».~
@50588 = ~~
@50589 = ~Ты осматриваешь ничем не примечательную книгу, закрытую на крохотный латунный замочек. «Это, — воркует Вришика, — Кодекс необъяснимого. Могу лишь сказать, что он просто... просто... что ж, объяснить я не могу. Одних лишь слов будет недостаточно! Ты можешь приобрести его за тысячу медных монет... и поверь мне: он того стоит».~
@50590 = ~«Беру».~
@50591 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50592 = ~«Нет, спасибо. Прощай, Вришика».~
@50593 = ~Ты осматриваешь маленький стеклянный пузырек с ярлычком «Слезы дэва». «Их собрали с дэва, захваченного в плен в стычке на Кровавой войне. Нечистые пытали плененного ангела целую вечность, пока он, наконец, не сбежал. В этом маленьком пузырьке содержатся двенадцать слез, которые он за то время. Их цена — всего лишь сотня медных монет».~
@50594 = ~«Беру».~
@50595 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50596 = ~«Нет, спасибо. Прощай, Вришика».~
@50597 = ~Ты осматриваешь маленький стеклянный пузырек с ярлычком «Слезы дэва». Вришика показывает его тебе. «Их собрали с дэва, захваченного в плен в стычке на Кровавой войне. Нечистые пытали плененного ангела целую вечность, пока он, наконец, не сбежал. В этом маленьком пузырьке содержатся двенадцать слез, которые он пролил за то время. Говорят, слезы дэва способны смягчить самый дикий гнев... даже такой, как у языка нечистого, — Вришика беспощадно улыбается. — Их цена — всего лишь девятьсот девяносто девять медных монет».~
@50598 = ~«Они могут снять проклятие языка нечистого. Я их возьму».~
@50599 = ~«Собственно, позволь мне взглянуть на другие вещи...»~
@50600 = ~«Должно быть, это то, что нужно Экко... и все же нет, спасибо. Прощай».~
@50601 = ~Ты осматриваешь бутылочку с надписью «Эликсир ужасного разделения». Вришика показывает ее тебе. «Эта смесь была составлена ученой, которая обнаружила, что одержима своей темной половиной, которая время от времени захватывала контроль над ней и приказывала ей делать ужасные вещи. Это снадобье должно было 'отделить' от нее темную половину, создав два отдельных существа. Однако прежде чем она успела воспользоваться им, ее нашли и казнили убийцы милосердия, наказав за серию извращенных убийств. За него я возьму с тебя всего лишь двести медных монет».~
@50602 = ~«Беру».~
@50603 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50604 = ~«Нет, спасибо. Прощай, Вришика».~
@50605 = ~Ты осматриваешь нечто, похожее на язык, плавающий в соленом растворе. Вришика смотрит на него неодобрительным взглядом. «Это язык нечистого... думаю, корнугона, хотя кто скажет наверняка? Говорят, что если поместить его в рот какого-либо живого существа, то оно получит дар речи, даже если до этого не умело говорить. Если он тебе понадобится, я продам тебе эту диковинку всего за шестьдесят шесть медяков».~
@50606 = ~«Беру».~
@50607 = ~«Я возьму его. Он может вернуть Экко голос».~
@50608 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50609 = ~«Нет, спасибо. Прощай, Вришика».~
@50610 = ~Ты осматриваешь бутылочку с надписью «Мазь Горгоны». Вришика берет ее в руки, чтобы продемонстрировать ее тебе. «Я выторговала ее у одного вояки-первичника... кажется, его звали Персей. Если намазать ею любое существо, обращенное в камень, мазь возвращает его плоть в нормальное состояние. Всего лишь сто медных монет. Выгодная покупка, учитывая то, как кстати она будет, если когда-нибудь один из твоих друзей превратится в камень».~
@50611 = ~«Беру».~
@50612 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50613 = ~«Нет, спасибо. Прощай, Вришика».~
@50614 = ~Ты осматриваешь маленькую металлическую копию похожего на куб существа с огромными глазами на одной из граней. У него две ноги, две руки, два складных крыла и не менее восемнадцати шарнирных соединений. Вришика улыбается, когда ты поднимаешь его. «Вероятно, это коллекционный предмет или произведение искусства. Кто знает? И все же он мне нравится. Если купишь его, поспрашивай вокруг... кому-то может быть известно о нем больше, чем мне. Тебе он обойдется всего в полторы тысячи медных монет».~
@50615 = ~«Беру».~
@50616 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50617 = ~«Нет, спасибо. Прощай, Вришика».~
@50618 = ~Ты осматриваешь простой с виду металлический кувшин... несмотря на вполне обычный внешний вид, тебе совершенно не хочется прикасаться к этой вещи, как будто она может тебя укусить. Вришика наблюдает за тобой, посмеиваясь, затем пожимает плечами. «В этом кувшине заключено какое-то чудовище. Именно от этого у тебя волосы дыбом. Если что, он обойдется тебе всего лишь в сто двадцать три медяка».~
@50619 = ~«Беру».~
@50620 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50621 = ~«Нет, спасибо. Прощай, Вришика».~
@50622 = ~Ты осматриваешь грязную матовую линзу размером с твою ладонь, вставленную в полированное стальное кольцо. Маленький зубчатый ободок вокруг кольца наводит на мысль, что линза должна быть прикреплена к какому-то механизму. Она слегка отдает отвратительным запахом. Вришика показывает ее тебе. «Понятия не имею, что это на самом деле, но оно излучает весьма мощную магию. Один старый солдат по имени Гизис принес ее мне с поля боя на Нижних планах. Он убил собственных людей, чтобы сбежать со службы, и принес мне немало интересных вещей, собранных им ходе кампании. Я держу его по большей мере в качестве предмета обсуждения, однако ты можешь получить его за сто сорок девять медных монет, если хочешь».~
@50623 = ~«Беру».~
@50624 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50625 = ~«Нет, спасибо. Прощай, Вришика».~
@50626 = ~Ты осматриваешь кольцо в небольшой коробке с подушечкой. Вришика подносит его поближе, чтобы ты смог разглядеть его. «Это Кольцо почти-невидимости Йевры. Оно делает владельца невидимым... ну, почти. Я расстанусь с ним за небольшую сумму в триста сорок девять медных монет».~
@50627 = ~«Беру».~
@50628 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50629 = ~«Нет, спасибо. Прощай, Вришика».~
@50630 = ~Ты осматриваешь кинжал странной формы, лежащий в декоративной подставке. Табличка под ней гласит «Меч Винн». Вришика стучит кончиком пальца по его эфесу. «Он также известен под названием Меч мошенника. Попросту держа его поднятым, ты победишь в игре. Если ты уверен, что хочешь этого, я могла бы передать его в твои руки за полторы тысячи медных монет».~
@50631 = ~«Победить в... о чем это ты?»~
@50632 = ~«Беру».~
@50633 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50634 = ~«Нет, спасибо. Прощай, Вришика».~
@50635 = ~Вришика смотрит на тебя прищуренными глазами. «О, да брось. Ты *точно* знаешь, о чем я. Купив Клинок мошенника, ты выиграешь игру. Все просто... всего-навсего полторы тысячи медных монет. Он тебе нужен или нет?»~
@50636 = ~«Хорошо, я возьму это».~
@50637 = ~«Нет... но позволь мне еще раз посмотреть другие вещи...»~
@50638 = ~«Нет, спасибо. Прощай, Вришика».~
@50639 = ~Годы не пожалели эту маленькую тряпичную куклу: она расходится по швам, а ткань, похоже, уже начала расползаться. Выглядит она как какая-то странно одетая женщина с ореолом шипов вокруг головы. Вришика показывает ее тебе. «Она была найдена в защищенном множеством ловушек сейфе, закопанном глубоко под Сигилом. Она была в небольшой кучке сокровищ и запретных магических текстов, однако я не знаю, для чего она нужна. Если она тебе понравилась, ее цена — всего лишь девяносто девять медных монет».~
@50640 = ~«Беру».~
@50641 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50642 = ~«Нет, спасибо. Прощай, Вришика».~
@50643 = ~Годы не пожалели эту маленькую тряпичную куклу: она расходится по швам, а ткань, похоже, уже начала расползаться. Очевидно, что это копия Леди Боли, хотя глаза-пуговки и плюшевая мягкость как-то не особо нагоняют на тебя страх. Вришика показывает ее тебе. «Она была найдена в защищенном множеством ловушек сейфе, закопанном глубоко под Сигилом. Она была в небольшой кучке сокровищ и запретных магических текстов, однако я не знаю, для чего она нужна. Если она тебе понравилась, ее цена — всего лишь девяносто девять медных монет».~
@50644 = ~«Беру».~
@50645 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50646 = ~«Нет, спасибо. Прощай, Вришика».~
@50647 = ~Вришика подходит к тебе ближе. «Для такой вещи одних монет будет недостаточно. Мне нужен фунт твоей крови, пролитой передо мной *этим* кинжалом, — внезапно в ее руке появляется зазубренный кинжал, — и сцеженной в эту стальную коробку. На меньшее я не соглашусь».~
@50648 = ~«Я сделаю это».~
@50649 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50650 = ~«Нет, спасибо. Прощай, Вришика».~
@50651 = ~Через минуту неприятный ритуал закончен, и Вришика с довольной улыбкой на губах отдает тебе книгу. «Теперь у меня мало времени. Прощай».~
@50652 = ~«Прощай».~
@50653 = ~«Да, — мурлычет Вришика, — мудрый выбор». Медяки, высыпанные в ее руку, как будто испаряются, только коснувшись ее ладони. Она передает тебе предмет. «Прошу, наслаждайся своим новым приобретением».~
@50654 = ~«Прощай».~
@50655 = ~Полные черные губы Вришики изгибаются в улыбке. «Я *всегда* заинтересована в дополнительной помощи. Стендиш, ленивый болван, помогает мне по магазину, но мне бы пригодился кто-нибудь еще в моем имении. Кого ты предлагаешь? Я заплачу пять тысяч монет, если найду его подходящим».~
@50656 = ~«Как насчет Морта?»~
@50657 = ~«Эта девчонка-тифлинг, Анна».~
@50658 = ~«Даккон, гитцерай».~
@50659 = ~«Падшая Грация».~
@50660 = ~«Вон тот модрон — Нордом».~
@50661 = ~«А вообще, забудь. У меня еще вопрос...»~
@50662 = ~«На самом деле, ничего. Не обращай внимания. Прощай».~
@50663 = ~Вришика смотрит на Морта прищуренными глазами. «Хм-м-м... да, он может пригодиться. Ты ведь понимаешь, что больше никогда его не увидишь... Я заплачу за него пять тысяч медных монет».~
@50664 = ~«Говоришь, больше никогда? Отлично... забирай его».~
@50665 = ~«Нет, лучше не надо. Прощай, Вришика».~
@50666 = ~Вришика показывает кусок пергамента своему новоиспеченному рабу, Морту. «Вот... это адрес моего дома в районе Леди. Сейчас же направляйся туда... попытаешься сбежать — и банда моей нечисти заставит тебя умолять вернуться в Сигил и прислуживать мне, — затем она поворачивается к тебе. — Что до *тебя*... благодарю. Уверена, он сможет поразвлечь меня. Вот твои пять тысяч... Прощай».~
@50667 = ~Вришика смотрит на Даккона прищуренными глазами. «Хм-м-м... гитцерай, да? Еще и *зерт*. Ты ведь понимаешь, что больше никогда его не увидишь... Я заплачу за него пять тысяч медных монет».~
@50668 = ~«Прощай».~
@50669 = ~«Никогда? Понимаю. Забирай его».~
@50670 = ~«Нет, лучше не надо. Прощай, Вришика».~
@50671 = ~«Не будь *смешным*, — Вришика ухмыляется, качая головой. — Как будто она *принадлежит* тебе, чтобы ею распоряжаться... уходи, и не возвращайся, пока хоть немного не избавишься от глупости — или не возвращайся вообще».~
@50672 = ~Уйти.~
@50673 = ~Вришика смотрит на Нордома прищуренными глазами. «Хм-м-м... мой персональный механический слуга? Да, я определенно согласна. Ты ведь понимаешь, что больше никогда его не увидишь... Я заплачу за него пять тысяч медных монет».~
@50674 = ~«Никогда? Понимаю. Забирай его».~
@50675 = ~«Нет, лучше не надо. Прощай, Вришика».~
@50676 = ~Вришика отвешивает быстрый полупоклон. «Добро пожаловать обратно. Пришел за покупками?»~
@50677 = ~«Не сейчас. У меня есть кое-какие вопросы...»~
@50678 = ~«Да».~
@50679 = ~Ты осматриваешь большую оловянную кружку, покрытую странными рунами. Вришика поднимает ее, чтобы ты рассмотрел ее поближе. «Пивная кружка необычной конструкции, сохраняющая свое содержимое — в большинстве случаев, конечно, пиво — ледяным независимо от окружающей температуры. Всего двести девяносто девять медных монет — и ты сможешь наслаждаться самым холодным элем за пределами полуплана льда».~
@50680 = ~«Беру».~
@50681 = ~«На самом деле, позволь мне еще раз взглянуть на другие вещи...»~
@50682 = ~«Нет, спасибо. Прощай, Вришика».~
@50683 = ~Эта женщина с резкими чертами лица выглядит привлекательно, хотя ее темно-синяя кожа и желтые глаза немного настораживают. Когда она изучает тебя, у нее за спиной раскрываются два небольших крыла, как у летучей мыши, затем убираются обратно.~
@50684 = ~Эта женщина с резкими чертами лица выглядит привлекательно, хотя ее темно-синяя кожа и желтые глаза немного настораживают. Когда она изучает тебя, у нее за спиной раскрываются два небольших крыла, как у летучей мыши, затем убираются обратно.~
@50685 = ~Эта женщина с резкими чертами лица выглядит привлекательно, хотя ее темно-синяя кожа и желтые глаза немного настораживают. Когда она изучает тебя, у нее за спиной раскрываются два небольших крыла, как у летучей мыши, затем убираются обратно.~
@50686 = ~«Не знаю, о какой миссии говоришь ты, Вришика, но вот твое присутствие здесь вызывает много вопросов. Последнее, что я о тебе слышала, это то, что ты стала знаменосцем батальона Стервятников. Как ты очутилась в Сигиле?»~
@50687 = ~Падшая Грация говорит с холодностью, которой ты раньше от нее не слышал. Воздух становится практически ледяным, когда она смеряет взглядом Вришику. «Довольно об этом».~
@50688 = ~«Это правда...»~
@50689 = ~«Освободиться от договоров с баатезу можно, если умеешь выбирать слова и понимаешь, что баатезу обязательно сдержат свое слово. Нужно всего лишь остерегаться любых слов, которые они могут обратить в свою пользу... а я *хорошо подкована* по части речи и всех ее тонкостей. И даже учитывая это, было непросто...»~
@50690 = ~Падшая Грация сохраняет безупречное хладнокровие и только кивает... Однако, когда вы пересекаетесь взглядами, она смотрит на тебя слегка раздраженно, но затем улыбается.~
@50691 = ~«Что ты там говорила о том, что она обучает агентов, Вришика?»~
@50692 = ~«У меня еще вопрос, Вришика...»~
@50693 = ~«Хотелось бы посмотреть на твой товар, Вришика...»~
@50694 = ~«Это все, что я хотел знать, Вришика. Прощай».~
@50695 = ~«Не в этом цель моего заведения...»~
@50696 = ~«Он прекрасно знал, почему я согласилась странствовать с ним, Вришика... когда он попросил меня об этом».~
@50697 = ~«Эй! Эй! Эй! Ты ведь *шутишь*, правда? Ты *не можешь* говорить это серьезно, шеф!»~
@50698 = ~«Я серьезно. Берешь его, Вришика?»~
@50699 = ~«Нет. У меня есть другой вопрос, Вришика...»~
@50700 = ~«Ты прав, Морт: это была не лучшая идея. Пошли».~
@50701 = ~«Не могу в это поверить... ты и до этого довольно низко падал, шеф, но это уже слишком. Увидимся в Бааторе, ты, искалеченный мелкостручковый вероломный неблагодарный искромсанный говножующий жирноволосый кривозубый жалкий кусок забывчивого мусора! Помяни мои слова, чертов ублюдок, продолжай в том же духе — и уже скоро откинешься *навсегда*... и тогда уж ты свое получишь!»~
@50702 = ~«Ты че, *совсем* с катушек съехал, бедолага? Силы небес и преисподней, лучше бы это была какая-то дурацкая шутка, иначе клянусь, что сделаю все, чтобы ты откинулся *навсегда*, и я это сделаю!»~
@50703 = ~«Я серьезно. Берешь ее, Вришика?»~
@50704 = ~«Шучу, шучу. У меня есть другой вопрос, Вришика...»~
@50705 = ~«Ты права... это была не самая удачная шутка, Анна. Пошли».~
@50706 = ~Даккон молчит, затем его слова вырываются наружу, словно клинок. «Я не *желаю* быть рабом этой женщины».~
@50707 = ~«Здесь у тебя небольшой выбор, не так ли, раб? Купишь его, Вришика?»~
@50708 = ~«Очень жаль, Даккон. Купишь его, Вришика?»~
@50709 = ~«Тогда ты им не станешь. У меня другой вопрос, Вришика...»~
@50710 = ~«Ладно... Пошли, Даккон».~
@50711 = ~«Я никогда не думал...» Его угольно-черные глаза пару секунд изучают твое лицо, затем он качает головой и опускает взгляд на пол. «Мои поспешные слова привели меня на это жестокий путь. Мой путь... Путь Даккона...» Он молча отворачивается от тебя.~
@50712 = ~«Я так понимаю, мои услуги предоставлены для продажи? Передача полномочий от тебя к Вришике, основанная на денежном обмене?»~
@50713 = ~«Да, верно. Берешь его, Вришика?»~
@50714 = ~«Да, но забудь об этом. У меня другой вопрос, Вришика...»~
@50715 = ~«Да... но я передумал. Пошли, Нордом».~
@50716 = ~«Нордом готовится принять Вришику, алу-демона, поставщицу, владелицу антикварного магазина, в качестве главного представителя власти».~
@50717 = ~«Да?»~
@50718 = ~Перед тобой весьма тучный мужчина, со складками жира, торчащими отовсюду. Он неторопливо обращает на тебя взгляд, и при этом тебя вдруг охватывает ощущение неописуемой опасности. «Во мне истинная суть меча. То, что ты видишь перед собой, — всего лишь оболочка. Клинок во мне. Чтобы получить его, тебе придется победить меня».~
@50719 = ~«Кто ты?»~
@50720 = ~«Леди Торнкомб, здесь, в Фестхолле».~
@50721 = ~Оказалось, что нескольких капель крови Кесай будет достаточно для портального ключа в лабиринт Равель... Теперь мне нужно лишь принести ей носовой платок, чтобы я смог их собрать.~
@50722 = ~«Ведь, говорят, раскаяние способно изменить сущность человека, хотя, наверное, только Серые сестры знают это наверняка».

Ив кивает тебе, улыбаясь. «Я не знаю смысла этой истории, но, возможно, она тебе еще пригодится в будущем».~
@50723 = ~«Приговор Козакса, вынесенный законниками, звучал так: «Заключение сроком на три раза по тридцать дней, в течение которых ты откажешься от своей жизни, будешь провозглашен мертвым, и твое тело вынесут, когда исчезнут все признаки жизни». Козакс смеялся и подначивал их ударить его, но суд хранил молчание».~
@50724 = ~«Продолжай...»~
@50725 = ~«Погоди... У меня есть вопрос...»~
@50726 = ~«Я выслушаю оставшуюся часть истории в другой раз, Ив. Прощай».~
@50727 = ~«Убийцы милосердия привели Козакса в тюрьму и заперли его в темной пустой камере. Там не было ни койки, ни света, а единственной дверью была стальная решетка на потолке.

Кинув его в камеру, убийцы милосердия сказали ему:

- В углу камеры стоит чаша. В ней яд. Твоя смерть будет быстрой.

 — Разве вы не собираетесь казнить меня? — прорычал Козакс охраннику.

 — Никто в Сигиле не поднимет на тебя руку, — последовал ответ убийцы милосердия».~
@50728 = ~«Погоди... У меня есть вопрос...»~
@50729 = ~«Продолжай...»~
@50730 = ~«Я выслушаю оставшуюся часть истории в другой раз, Ив. Прощай».~
@50731 = ~«Но из-за решетки на потолке не последовало ответа. И тогда Козакс заметил, что в камере нет койки. Нет света. И нет еды и воды. И все, что осталось — разбитая чаша; весь яд пропал. И тут Козакс впервые познал леденящее прикосновение приближающейся смерти.

Через дважды по тридцать дней решетку открыли, и тело Козакса, уже остывшее, было вынесено из камеры. Он отказался от жизни, и казнь была выполнена».~
@50732 = ~«Я могу поделиться с тобой еще одной историей».~
@50733 = ~«У меня вопрос к тебе, Ив...»~
@50734 = ~«Мне пора идти. Прощай, Ив».~
@50735 = ~«Эй, сэр... Я бы хотел с Вами поговорить».~
@50736 = ~«Вы! Да, вы. Не могли бы вы пройти?»~
@50737 = ~«Дружище... еще один... эль, пожалуйста».~
@50738 = ~«Вот ты где».~
@50739 = ~*Буль*~
@50740 = ~«Фух! Вот... это — *отрыжка* — вещь».~
@50741 = ~«...и именно поэтому Закон о контроле облачения чрезвычайно важен...»~
@50742 = ~«...и посему можно было бы реализовать 'систему ротации дежурств', чтобы...»~
@50743 = ~«...и вот еще двадцать причин, почему четырнадцатый Нижний магистрат должен...»~
@50744 = ~«...ладно вам. Ох, да вы и слова не сказали! Но позвольте мне просто объяснить...»~
@50745 = ~«Предсказание судьбы... узнайте свою судьбу за какие-то пять медяков!»~
@50746 = ~«Подходите к Элобранд и узнайте свою судьбу! Всего за пять монет...»~
@50747 = ~«Они назвали меня 'вором'. Пф! Да я — 'разведчик', пустые вы головы! 'РАЗВЕДЧИК'!»~
@50748 = ~«Аон тхесей ома ийос ха аон еяш».~
@50749 = ~«Ност айен ай фасир вайл обрис аон меха;»~
@50750 = ~«Юи аон ривон со аон вирано грас Эм нозаэх»~
@50751 = ~«Рарех роиб ай есин со санатоум серольк...»~
@50752 = ~«Иуер неи аон Дадик Артаг, алад авив овилф мойок».~
@50753 = ~«Юи джакиллу недир вир аон джигар оур мхеш -»~
@50754 = ~«Куалоу тьенг вал аон унамихир тсуген во,»~
@50755 = ~«Ноуде аон земон юи аон сойне ашахо же дио?»~
@50756 = ~«Тебе знаком этот язык?»~
@50757 = ~«Нет... но звучит он вполне неплохо».~
@50758 = ~«Хм-м...»~
@50759 = ~::Озадаченный вид::~
@50760 = ~«Просто удивительно, что он продолжает свое представление...»~
@50761 = ~«Интересно, сколько еще он будет находится в этой ловушке?»~
@50762 = ~«Мне его жаль, хоть он и заслужил свою судьбу».~
@50763 = ~«На это, 'добрый' Дерек, я скажу: стыд и позор тебе!»~
@50764 = ~«Это было безосновательно. Совершенно незаслуженно! Что тебя так раздосадовало?»~
@50765 = ~«Вздор! Это из-за твоей брани, хотя ныне ты пытаешься это отрицать!»~
@50766 = ~«Ты глупец, злишься безо всякой причины!»~
@50767 = ~«*Глупец*?! Я?! Да моя глупость лишь в том, что я терпел твое жалкое общество!»~
@50768 = ~«Ну все, довольно! Доставай клинок!»~
@50769 = ~«Достану, чтобы ты смог испробовать его на вкус!»~
@50770 = ~«Ты бьешься словно хилое дитя!»~
@50771 = ~«А ты — как робкий щеголь!»~
@50772 = ~«Постой, зачем нам драться?»~
@50773 = ~«Да. Давай прекратим эту бессмыслицу».~
@50774 = ~«Хорошо, хорошо. Поверить не могу, что наша дружба скатилась до такого».~
@50775 = ~«Ты воистину прав».~
@50776 = ~«Хотя, быть может, наша дружба была бы более стабильной...»~
@50777 = ~::Подозрительный взгляд:: «А?»~
@50778 = ~«...если бы не твой нрав».~
@50779 = ~«Нрав? Что ты подразумеваешь?»~
@50780 = ~«Брось, ведь ты не можешь отрицать, что твой нрав немного, э-э...»~
@50781 = ~«Тот, что слева, довольно таки неплох, правда?»~
@50782 = ~«Э... Мне кажется, его приятель играет лучше».~
@50783 = ~«Да ты бы не узнал хорошую актерскую игру, даже если бы она укусила тебя за задницу».~
@50784 = ~«Еще вина, если не возражаешь...»~
@50785 = ~«... а затем этот дурак наткнулся на меня...»~
@50786 = ~«... так что я *ПРОКЛЯЛ* того неуклюжего болвана!»~
@50787 = ~«... а она сказала: 'Нет, они мои'».~
@50788 = ~«... так что я *ПРОКЛЯЛ* эту напыщенную корову!»~
@50789 = ~«... и они имели наглость косо на меня посмотреть...»~
@50790 = ~«... так что я *ПРОКЛЯЛ* этих убогих, каждого из них!»~
@50791 = ~«... и именно поэтому *я* должен быть наставником магов в Городском Фестхолле».~
@50792 = ~«Где я?»~
@50793 = ~«Почему из меня сделали заключенного?»~
