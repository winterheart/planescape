@6876 = ~«Даккон, ты можешь перевести мне то, что он говорит?»~
@6877 = ~«Падшая Грация, ты можешь перевести мне то, что он говорит?»~
@6878 = ~«Извини... Я не могу тебя понять».~
@6879 = ~«Э-э... Прощай».~
@6880 = ~«Возможно, ты можешь помочь мне...»~
@6881 = ~«Я просто хотел попрактиковаться в ребусах. Прощай».~
@6882 = ~«Морт, ты можешь перевести мне то, что он говорит?»~
