@12670 = ~«Нет, вкус просто отвратительный».~
@12671 = ~«Нет, больше не нужно. Прощай».~
@12672 = ~«Было очень вкусно. У меня к тебе вопрос...»~
@12673 = ~«Хорошо, дай мне еще одну».~
@12674 = ~«Нет, вкус просто отвратительный».~
@12675 = ~«Нет, больше не нужно. Прощай».~
@12676 = ~«Было очень вкусно. У меня к тебе вопрос...»~
@12677 = ~«Хорошо, дай мне еще одну».~
@12678 = ~«Нет, вкус просто отвратительный».~
@12679 = ~«Нет, больше не нужно. Прощай».~
@12680 = ~«Погоди, у меня к тебе вопрос...»~
@12681 = ~Пусть уходит.~
@12682 = ~«Кто ты?»~
@12683 = ~«Я хотел поговорить с тобой насчет крыс...»~
@12684 = ~«Что это за здание, там, за тобой?»~
@12685 = ~«Можешь рассказать мне об этом... городе?»~
@12686 = ~«Можешь рассказать мне о Сигиле?»~
@12687 = ~«Можешь рассказать мне об этих трущобах?»~
@12688 = ~«Можешь рассказать мне об Улье?»~
@12689 = ~«Можешь рассказать мне о Леди Боли?»~
@12690 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@12691 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@12692 = ~«Я хотел бы попробовать одну из твоих крыс».~
@12693 = ~«Ничего. Прощай».~
@12694 = ~Понятно. Расскажи мне об этом 'Улье'».~
@12695 = ~«У меня к тебе еще один вопрос».~
@12696 = ~«Это все, что я хотел узнать. Прощай».~
@12697 = ~«Кто-то платит за хвосты этих крыс?»~
@12698 = ~«У меня есть другие вопросы...»~
@12699 = ~«Это все, что я хотел узнать. Прощай».~
@12700 = ~«Расскажи мне побольше об этом Лорте».~
@12701 = ~«Мозгогрызунов?»~
@12702 = ~«Интересно. Ответь мне еще на вопрос...»~
@12703 = ~«Понятно. У меня все, прощай».~
@12704 = ~«'Опустили'? А что произошло?»~
@12705 = ~«Сигил?»~
@12706 = ~«Хорошо. У меня есть другой вопрос...»~
@12707 = ~«Может, я как-нибудь загляну к нему. Прощай».~
@12708 = ~«Понятно. Еще вопрос...»~
@12709 = ~«Наверное, мне стоит с ним поговорить. Прощай».~
@12710 = ~«Ты выглядишь... дружелюбнее... чем остальные».~
@12711 = ~«Приятно познакомиться, Креден. У меня к тебе еще один вопрос...»~
@12712 = ~«Может, как-нибудь еще поболтаем. Прощай».~
@12713 = ~«Они становятся более сообразительными?»~
@12714 = ~«Понятно. У меня есть другие вопросы...» ~
@12715 = ~«Это все, что я хотел узнать. Прощай».~
@12716 = ~«Откуда у тебя все эти крысы?»~
@12717 = ~«Где лучше всего ловить крыс?»~
@12718 = ~«Расскажи мне об этих крысах».~
@12719 = ~«Ничего. Позволь мне спросить кое о чем еще...»~
@12720 = ~«Неважно. Прощай».~
@12721 = ~«Продолжай...»~
@12722 = ~«Интересно. Позволь мне спросить кое о чем еще...»~
@12723 = ~«Понятно... Это все, что я хотел узнать. Прощай».~
@12724 = ~«Почему? Что здесь такого страшного?»~
@12725 = ~«Леди?»~
@12726 = ~«Тогда я буду с ними осторожен. У меня есть другой вопрос...»~
@12727 = ~«Я запомню это. Прощай».~
@12728 = ~«Сигил?»~
@12729 = ~«Наград? Кто-то платит за крысиные хвосты?»~
@12730 = ~«Понятно. Позволь спросить тебя еще кое о чем...»~
@12731 = ~«Понятно. Это все, что я хотел узнать на данный момент. Прощай».~
@12732 = ~«Почему ты назвал его Клеткой?»~
@12733 = ~«Где конкретно он находится?»~
@12734 = ~«На самом деле, ничего. Но у меня есть другие вопросы...»~
@12735 = ~«Ничего... это не важно. Прощай».~
@12736 = ~«Почему ты назвал его Клеткой?»~
@12737 = ~«Где конкретно он находится?»~
@12738 = ~«На самом деле, ничего. Но у меня есть другие вопросы...»~
@12739 = ~«Ничего... это не важно. Прощай».~
@12740 = ~«Расскажи мне об этих дверях и ключах».~
@12741 = ~«Расскажи мне об этих дверях и ключах».~
@12742 = ~«Понятно. Позволь мне задать другой вопрос...»~
@12743 = ~«Это все, что я хотел узнать на данный момент. Прощай».~
@12744 = ~«А как узнать, куда ведет дверь?» ~
@12745 = ~«Как узнать, какой ключ открывает какую дверь?»~
@12746 = ~«Интересно. У меня есть другие вопросы...»~
@12747 = ~ «Спасибо за информацию. Прощай».~
@12748 = ~Пусть говорит.~
@12749 = ~«А как узнать, какой ключ какую дверь открывает?»~
@12750 = ~«Интересно. Позволь мне спросить кое о чем еще...»~
@12751 = ~«Понятно. Спасибо за ответы. Прощай».~
@12752 = ~«А как узнать, куда ведет дверь?» ~
@12753 = ~«Интересно. Позволь мне спросить кое о чем еще...»~
@12754 = ~«Понятно. Спасибо за ответы. Прощай».~
@12755 = ~«Ты знаешь, почему его называют Ульем?»~
@12756 = ~«Здесь есть что-нибудь интересное?»~
@12757 = ~«Ничего важного. У меня еще вопросы...»~
@12758 = ~«Неважно, это все. Прощай».~
@12759 = ~«Ты знаешь, почему его называют Ульем?»~
@12760 = ~«Есть что-нибудь интересное в округе?»~
@12761 = ~«Ничего важного. У меня еще вопросы...»~
@12762 = ~«Неважно, это все. Прощай».~
@12763 = ~«Места для сходок? Для кого?»~
@12764 = ~«Понятно. Есть что-нибудь интересное в округе?»~
@12765 = ~«Хм-м-м. У меня есть другие вопросы...»~
@12766 = ~ «Спасибо за информацию. Прощай».~
@12767 = ~«Понятно. Что есть интересного в округе?»~
@12768 = ~«Понятно. Позволь мне тогда спросить кое о чем еще...»~
@12769 = ~«Хорошо. Тогда прощай».~
@12770 = ~«Я ищу развлечения».~
@12771 = ~«Я ищу развлечения».~
@12772 = ~«Я ищу работу».~
@12773 = ~«Я разыскиваю человека по имени Фарод».~
@12774 = ~«Я ищу дневник. Тебе ничего такого не попадалось?»~
@12775 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@12776 = ~«Неважно. Прощай».~
@12777 = ~«Можешь сказать, где они находятся?»~
@12778 = ~«Опасных?»~
@12779 = ~«Спасибо. У меня есть другой вопрос».~
@12780 = ~«Наверное, я остановлюсь в одном из них. Прощай».~
@12781 = ~«А вот ты достаточно дружелюбен...»~
@12782 = ~«Потеряться?»~
@12783 = ~«Потеряться?»~
@12784 = ~«У меня есть другие вопросы...»~
@12785 = ~ «Спасибо за информацию. Прощай».~
@12786 = ~«Внешних землях?»~
@12787 = ~«Странно. Позволь мне спросить кое о чем еще...»~
@12788 = ~«Кажется, я понимаю. Прощай».~
@12789 = ~«Продолжай...»~
@12790 = ~«Двери?»~
@12791 = ~«У меня есть другие вопросы...»~
@12792 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@12793 = ~«Да... продолжай...»~
@12794 = ~«У меня есть другие вопросы...»~
@12795 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@12796 = ~«Может быть. У меня есть другие вопросы...»~
@12797 = ~«Интересная теория, я поразмыслю над ней. Прощай».~
@12798 = ~«Хорошо, продолжай».~
@12799 = ~«Перед тем как ты продолжишь, позволь спросить тебя кое о чем еще...»~
@12800 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@12801 = ~«Сборщики?»~
@12802 = ~«Люди платят за мертвых крыс?»~
@12803 = ~«Мозгогрызунов?»~
@12804 = ~«Понятно. Я хотел бы узнать кое о чем еще...»~
@12805 = ~«Отлично. Прощай».~
@12806 = ~«Потеряться?»~
@12807 = ~«Потеряться?»~
@12808 = ~«Что ты говорил насчет людей, которые платят за крыс?»~
@12809 = ~«Интересно. Я хотел бы узнать кое о чем еще...»~
@12810 = ~«Отлично. Прощай».~
@12811 = ~«У меня есть другие вопросы...»~
@12812 = ~«Доходчиво. Прощай, Креден».~
@12813 = ~«Позволь мне тогда спросить кое о чем еще».~
@12814 = ~«Тогда мне нужно идти. Прощай».~
@12815 = ~«Это долгая история... мне просто нужно найти его».~
@12816 = ~«Это не твое дело, крысолов».~
@12817 = ~«Забудь, что я спросил. Ответь мне еще на вопрос...»~
@12818 = ~«Забудь, это не важно. Прощай».~
@12819 = ~«Сборщики?»~
@12820 = ~«А где находится эта площадь Старьевщиков?»~
@12821 = ~«Хорошо. У меня еще вопросы...»~
@12822 = ~ «Спасибо за информацию. Прощай».~
@12823 = ~«Мне очень важно его разыскать... Прошу прощения за резкие слова. Можешь мне помочь?»~
@12824 = ~«Ну и ладно. Может, ты сможешь ответить еще на один вопрос...»~
@12825 = ~«Ну и пусть. Прощай».~
@12826 = ~«У меня есть другие вопросы...»~
@12827 = ~«Тогда буду искать дальше. Прощай».~
@12828 = ~«Спасибо. Что ты там сказал насчет опасных мест?»~
@12829 = ~«Спасибо. Тогда у меня другой вопрос...»~
@12830 = ~«Наверное, я остановлюсь в одном из них. Прощай».~
@12831 = ~«Понятно... а вот ты кажешься достаточно дружелюбным...»~
@12832 = ~«Понятно. Еще вопрос...»~
@12833 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@12834 = ~«Понятно. Что ты там говорил про тех, кто платит за мертвых крыс?»~
@12835 = ~«Понятно. Я хотел бы узнать кое о чем еще...»~
@12836 = ~«Отлично. Прощай».~
@12837 = ~«Спасибо. Что ты там говорил про сборщиков?»~
@12838 = ~«Спасибо. У меня еще вопросы...»~
@12839 = ~ «Спасибо за информацию. Прощай».~
@12840 = ~«Почему бы и нет...»~
@12841 = ~«Да я скорее язык проглочу».~
@12842 = ~«Нет, спасибо. Прощай».~
@12843 = ~«Почему бы и нет... какие у тебя есть?»~
@12844 = ~«Да я скорее язык проглочу».~
@12845 = ~«Нет, не сейчас. Но у меня есть несколько вопросов...»~
@12846 = ~«Нет, спасибо. Прощай».~
@12847 = ~«Почему бы и нет... какие у тебя есть?»~
@12848 = ~«Они меня не интересуют».~
@12849 = ~«Нет, не сейчас. Но у меня есть несколько вопросов...»~
@12850 = ~«Нет, спасибо. Прощай».~
@12851 = ~«А где находится эта площадь Старьевщиков?»~
@12852 = ~«Спасибо. У меня есть другой вопрос...»~
@12853 = ~«Это все, что я хотел узнать. Прощай».~
@12854 = ~«Ты можешь это объяснить, Морт?»~
@12855 = ~«Что такое 'мимир'?»~
@12856 = ~«Не обращай на него внимания... Ты можешь ответить на мои вопросы?»~
@12857 = ~«Нет... давай лучше выслушаем, что скажешь ты, Морт».~
@12858 = ~«Секунду... что такое 'мимир'?»~
@12859 = ~Повернуться к ловцу крыс.~
@12860 = ~«Хорошо».~
@12861 = ~«Нет, я выслушал достаточно. Прощай, крысолов».~
@12862 = ~«Хорошо».~
@12863 = ~«Неважно. Пошли... Прощай, крысолов».~
@12864 = ~«А вот ты достаточно дружелюбен, крысолов...»~
@12865 = ~«Понятно. Еще вопрос...»~
@12866 = ~ «Спасибо за информацию. Прощай».~
@12867 = ~«А... Что ты говорил о людях, которые платят за крыс?»~
@12868 = ~«Понятно Я хотел бы узнать о кое-чем еще...»~
@12869 = ~«Понятно. Прощай».~
@12870 = ~«Эй! Это еще кто? СТРАЖА! ОН ЗДЕСЬ!»~
@12871 = ~Готово.~
@12872 = ~«Ты меня не замараешь своими грязными словами! Вон отсюда!»~
@12873 = ~Уйти.~
@12874 = ~«И что же на этот раз тебе наплел мелкий подхалим? Уверен, что все это — ложь».~
@12875 = ~«Вообще-то я еще не говорил с ним. У меня есть еще вопросы, на которые я хотел бы получить ответы».~
@12876 = ~«Он сказал, что это не подстава. На самом деле, он говорит, что лично видел, как ты убил беднягу».~
@12877 = ~«Я все еще исследую версию про анархистов».~
@12878 = ~«Он говорит, что оставил шило возле трупа, но только потому, что хотел удостовериться, чтобы ты будешь впутан в это дело. Он говорит, что ты — убийца, и что он хочет позаботиться о том, чтобы тебя поймали».~
@12879 = ~«Он говорит, что оставил шило возле трупа, но только потому, что хотел удостовериться, чтобы ты будешь впутан в это дело. Он говорит, что ты — убийца, и что он хочет позаботиться о том, чтобы тебя поймали».~
@12880 = ~«Я принял решение, кого мне обвинить».~
@12881 = ~«Это пока что не твое дело. Мне нужно, чтобы ты ответил на несколько вопросов».~
@12882 = ~«Пока ничего. Прощай».~
@12883 = ~«Жаль беднягу Авильдона, правда жаль. И все же он не был из тех, кто работает без отдыха. Он не был *преданным* своему делу. Так действуют планы, помяни мое слово... каждый рубака получает по заслугам. Ах, да. Чем тебе может услужить старина Тильдон?»~
@12884 = ~«Сарос — ты ведь помнишь Сароса? — дал мне шило, которое он нашел возле тела. И что странно, у этого шила на ручке выгравировано твое имя. Как ты это объяснишь?»~
@12885 = ~«Я хотел бы задать тебе пару вопросов».~
@12886 = ~«Пока ничего. Прощай».~
@12887 = ~«Вот только не спрашивай меня об этом, пень! У тебя в руках опасный преступник, это уж точно, и ты должен позаботиться о том, чтобы он не угрохал еще кого-нибудь. За работу!»~
@12888 = ~«Тильдон, я сказал, что мне нужны ответы на несколько вопросов. Отвечай сейчас же».~
@12889 = ~«Я этим займусь. Не волнуйся. Прощай».~
@12890 = ~«Он ЧТО? Я говорю тебе, что этот парень — вор и убийца, и ты мне не веришь? Что, если я скажу, что он — анархист, а также член Революционной Лиги?»~
@12891 = ~«К чему мне верить в это?»~
@12892 = ~Ложь: «Если это правда, я позабочусь, чтобы его передали в руки правосудия».~
@12893 = ~Правда: «Если это правда, я позабочусь, чтобы его передали в руки правосудия».~
@12894 = ~«Если честно, мне плевать. Полагаю, что я услышал достаточно, чтобы убедиться, что ты виновен в этом».~
@12895 = ~Его лицо принимает праведное выражение. «Потому что я так говорю. Потому что я собираюсь сказать кое-что, что сделает меня преступником, но я скажу это, чтобы увидеть, как свершится правосудие, — он умолкает. — Мне известно, что он — анархист, потому что он пытался меня завербовать. Он, и тот инженер, Бедай-Линн. Я согласился, потому что хотел заманить их в ловушку, но потом понял, что мне не хватит духу причинить вред бедному Саросу. Я отказал им, и теперь они пытаются замести следы. Вот почему они хотят меня убрать. Они — убийцы. Не я».~
@12896 = ~«Предположим, что я поверил в это. Почему бы мне не арестовать и тебя в придачу?»~
@12897 = ~«Вот оно как. Я это проверю. Сперва ответь еще на несколько вопросов».~
@12898 = ~«Ладно. Я это проверю прямо сейчас. Никуда не уходи, Тильдон. Счастливо».~
@12899 = ~«Ну, это ведь правда! Клянусь перед безгрешными глазами моей бедной покойной матери. Он, и тот инженер, Бедай-Линн, — они хотели завербовать меня. Я сказал, что присоединюсь к ним, потому что хотел словить предателей. Это мой долг перед фракцией. Но потом, ну, потом я решил, что не следовало мне делать это. И тогда они решили поглядеть, как я болтаюсь на дереве без листьев».~
@12900 = ~«Интересно. И все же крайне неправдоподобно. Звучит слишком натянуто. Думаю, мне стоит просто выдать тебя».~
@12901 = ~«Понятно. Я это проверю. Ответь еще на несколько вопросов, Тильдон».~
@12902 = ~«Я изучу этот вопрос. Спасибо за подсказку».~
@12903 = ~«Что? Ты обвиняешь МЕНЯ? Но я ведь ничего не сделал! Пень, ты нашел не того человека! Пожалуйста! Я не делал этого!»~
@12904 = ~«Я просто немного пошутил, Тильдон. Расслабься. Ответь мне еще на пару вопросов».~
@12905 = ~«Я шучу, Тильдон. Прощай».~
@12906 = ~«Все улики указывают на тебя, Тильдон. В следующий раз увидимся на твоей казни. Прощай».~
@12907 = ~«Все еще проверяешь? Неважный из тебя следователь, верно? Даже не знаю, зачем я утруждаю себя, помогая тебе, в то время как ты не проверяешь сведения, которые я дал тебе...»~
@12908 = ~«Хватит притворяться праведником, Тильдон. Ответь мне на пару вопросов».~
@12909 = ~«Я услышал все, что хотел от тебя услышать. Прощай».~
@12910 = ~Лица бригадира бледнеет. «Он... что... он... я... он говорил, что он анархист?»~
@12911 = ~«Да. Похоже, он считает тебя опасным для окружающих, будь то анархисты или боголюди, и что кому-то нужно тебя остановить. Он желает ответить за свои преступления, чтобы гарантировать, что и тебя постигнет правосудие».~
@12912 = ~«Да. А ты — убийца. Твои действия выдают тебя».~
@12913 = ~«Он... так и сказал? Тогда ты должен задержать его! Разве ты не видишь, что он несет в себе угрозу? Как ты вообще веришь вору и лжецу, ведь очевидно, что у него нет моральных принципов? Арестуй его, и покончим с этим!»~
@12914 = ~«Что ж, Тильдон, я понимаю это так: он желает понести наказание, если это будет означать, что и ты его разделишь. Все, что мне довелось услышать о нем, говорит мне, что он неплохой человек — и раз он хочет понести наказание, только чтобы убедиться, что ты получишь по заслугам, это значит, что ты действительно его заслужил».~
@12915 = ~«Что-то здесь не так. Зачем ему делать это?»~
@12916 = ~«Не тебе здесь распоряжаться, Тильдон. Запомни это. А теперь ответь на несколько вопросов».~
@12917 = ~«Не торопи, Тильдон. Ты на нетвердой почве. Бывай».~
@12918 = ~«Чтоб воплощать анархистские планы, пень! — он понижает голос и мрачно глядит на тебя. — Видишь ли, эти анархисты, они же фанатики, еще какие, и они не переносят таких людей как я, которые хотят их разоблачить. Они пожертвуют кем угодно, чтобы достичь своей цели», — он выпрямляется и заявляет: «Пришло время для честных людей вроде меня обратить этих пней на путь истинный».~
@12919 = ~«Ладно тебе, Тильдон. Сарос молод, а молодые люди совершают ошибки. Я очень сомневаюсь, что он станет себя губить, чтобы добраться до тебя, лишь бы защитить людей, которые в первую очередь втянули его в это. Преданность — это, конечно, хорошо, но он достаточно умен, чтобы понять, когда его подставляют. Нет, Тильдон, думаю, следует обвинить тебя».~
@12920 = ~«Мне кажется, что тут что-то не так, но я не пойму, что именно».~
@12921 = ~«Честных? Ладно. Ответь мне еще на пару вопросов».~
@12922 = ~«Какая же у тебя благородная цель. Прощай, Тильдон».~
@12923 = ~«Вот что не так: до твоей тупой башки не доходит, какие планы строят эти пни! Придурок, вынь голову из задницы и засади этого мелкого ублюдка за решетку!» На миг он кажется шокированным, осознав, что он сказал и кому, после чего он выпаливает: «Э, прими мои извинения. Это все от переутомления. Не так-то легко, когда все тебя считают убийцей и анархистом».~
@12924 = ~«Я уверен, что так оно и есть. Мне нужно все хорошенько обдумать. Ответь еще на пару вопросов».~
@12925 = ~«Я уверен, что так оно и есть. Прощай».~
@12926 = ~Его мясистое лицо становится красным от ярости. «Ты обвиняешь МЕНЯ? Но я ведь не убийца! Я просто пытаюсь разоблачить анархистов, пень! Будь ты проклят, ты не можешь так со мной поступить! Ты не можешь верить любому из тех, кто говорит, что видел, как я это сделал, так что не можешь утверждать, что это я!»~
@12927 = ~«Сможешь ли ты повторить то же самое под присягой и под действием заклинания? Могу поспорить, что Сарос сможет».~
@12928 = ~«Сарос больше подходит на роль свидетеля. Он более убедительный, и его не так ненавидят здесь, как тебя. Могу поспорить, что именно его версия событий правильная, и как раз это я и собираюсь сказать Кельдору».~
@12929 = ~«Я сдам вас обоих. Как на счет такого? Прощай, Тильдон. Больше мы не увидимся».~
@12930 = ~«Вообще-то, если я захочу, то так и скажу. Прощай, Тильдон».~
@12931 = ~«Я все это хорошенько обдумаю. А пока наслаждайся жизнью, Тильдон. Счастливо».~
@12932 = ~«Мать твою. Могу ли я хотя бы собрать свои вещи и помахать ручкой этому месту? Старина Тильдон позаботится, чтобы ты об этом не пожалел».~
@12933 = ~«Конечно. Проваливай».~
@12934 = ~«Только если выберешься отсюда до того, как я доложу обо всем Кельдору. Думаю, твои шансы невелики».~
@12935 = ~«Нет. Стой здесь — или будет хуже. Будь уверен: я об этом позабочусь. Счастливо, Тильдон».~
@12936 = ~«Иду, иду. Ты меня больше не увидишь».~
@12937 = ~«Уходи, пока я не передумал».~
@12938 = ~«Я передумал. Уже скоро ты увидишься с палачом. Прощай, Тильдон».~
@12939 = ~«Тебе нужны ответы? Например?»~
@12940 = ~«Кто ты?»~
@12941 = ~«Расскажи мне о боголюдях».~
@12942 = ~«Чем ты занимался в ночь убийства?»~
@12943 = ~«Мне нужно воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@12944 = ~«Мне нужно воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@12945 = ~«Мне нужно воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@12946 = ~«Мне нужно воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@12947 = ~«Мне нужно воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@12948 = ~«Мне нужно воспользоваться кузницей. Ты можешь дать мне немного руды?»~
@12949 = ~«Ничего. Прощай».~
@12950 = ~«Кого же ты выбрал?» Он кажется странно напряженным.~
@12951 = ~«Я собираюсь назвать убийцей Сароса».~
@12952 = ~«Я обвиняю вас с Саросом».~
@12953 = ~«Я скажу Кельдору, что убийца — ты».~
@12954 = ~«Пока никого. У меня есть несколько вопросов...»~
@12955 = ~«Пока не могу сказать. Прощай».~
@12956 = ~«Тильдон Серый, бригадир этого цеха. Моя работа — следить за тем, чтобы мои рабочие выполняли свою работу,... ну и следить, чтобы люди вроде тебя их не отвлекали. Они работают в полсилы, мелкие поганцы, и умудряются тратить остаток дня впустую, если меня нет на месте. Я суров... но справедлив. Спроси любого».~
@12957 = ~«Почему тебя называют «Серый»?»~
@12958 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы...»~
@12959 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы...»~
@12960 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы...»~
@12961 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы...»~
@12962 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы...»~
@12963 = ~«Тогда это к тебе я должен обратиться, чтобы получить железную руду для кузницы...»~
@12964 = ~«Пожалуй, так и сделаю. У меня есть другие вопросы...»~
@12965 = ~«Пожалуй, так и сделаю. Прощай».~
@12966 = ~«Потому что я постоянно весь в саже от этих проклятых печей. Это прозвище, которое дали мне мои рабочие... из уважения, конечно».~
@12967 = ~«Она... мертва».~
@12968 = ~Саркастически: «Несомненно. Похоже, они действительно уважают твою тонкую натуру».~
@12969 = ~Серьезно: «Несомненно».~
@12970 = ~«Конечно. Так и должно быть».~
@12971 = ~«Понятно. У меня есть другие вопросы...» ~
@12972 = ~«Понятно. Прощай».~
@12973 = ~«Ты намекаешь, что я не до конца честен со своими рабочими? Ведь это не так! Я для них как отец!»~
@12974 = ~«К несчастью, большинство из них, вероятно, регулярно избивают, словно детей...»~
@12975 = ~«Я просто предполагаю, что ты можешь быть даже СЛИШКОМ справедливым, ну ты понимаешь, о чем я».~
@12976 = ~«Ладно, ладно. У меня есть другие вопросы...»~
@12977 = ~«Не сомневаюсь. Счастливо».~
@12978 = ~Его лицо краснеет от ярости. Когда он, наконец, берет себя в руки, он выплевывает: «Убирайся с глаз моих, или я позову стражу!»~
@12979 = ~«Пока я расследую это убийство, ты не посмеешь. А теперь ответь мне на несколько вопросов».~
@12980 = ~«Просто ответь мне на другие вопросы...»~
@12981 = ~«Ладно, я ухожу. Прощай».~
@12982 = ~Он вопит стражникам: «СТРАЖА! Уберите с глаз моих эту жалкую тушу, и пусть он БОЛЬШЕ НЕ ПРИХОДИТ!»~
@12983 = ~«Ты пожалеешь об этом. Готовься к смерти, свинья».~
@12984 = ~«Отлично. Прощай».~
@12985 = ~«Ты точно так думаешь? Говоришь, мне лучше подумать о том, как я с ними обращаюсь? Ну что ж, ладно. Нет, скорее всего, я продолжу делать так, как делал раньше! А теперь убирайся отсюда».~
@12986 = ~«В данный момент распоряжаешься не ты. У меня есть еще вопросы...»~
@12987 = ~«Просто ответь мне на другие вопросы...»~
@12988 = ~«Ладно, я ухожу. Прощай».~
@12989 = ~«Это правда, так и есть. Они знают, что если они ослушаются, то получат по заслугам».~
@12990 = ~«Ты имеешь в виду, что тот кузнец получил то, что заслужил?»~
@12991 = ~«Понятно. У меня есть другие вопросы...» ~
@12992 = ~«Понятно. Прощай».~
@12993 = ~На миг он бледнеет. «Это была просто фигура речи, вот и все. Я ничего такого не имел в виду».~
@12994 = ~«Хорошо. Ответь мне на пару вопросов».~
@12995 = ~«На этот счет еще посмотрим. Прощай».~
@12996 = ~«Что это должно означать?»~
@12997 = ~«Это значит, что я согласен с тобой».~
@12998 = ~«Это значит, что я думаю, что им на тебя наплевать».~
@12999 = ~«Это значит: забей, пень».~
@13000 = ~«Ну что ж, отлично. Мультивселенная была бы лучшим местом, если бы все так делали. А теперь я должен вернуться к работе».~
@13001 = ~«У меня есть еще пару вопросов...»~
@13002 = ~«Тогда прощай».~
@13003 = ~«Можешь верить тому, чему хочешь, человечек. Я знаю своих рабочих. Им нужна твердая рука, чтобы направлять их. За это они меня уважают. А теперь убирайся прочь».~
@13004 = ~«В данный момент распоряжаешься не ты. У меня есть еще вопросы...»~
@13005 = ~«Просто ответь мне на другие вопросы...»~
@13006 = ~«Отлично. Прощай».~
@13007 = ~«Они приняли меня, и обучили меня быть таким, какой я есть, и за это я им благодарен. Они взяли мой необработанный талант и превратили его в мастерство. Говорю тебе, я — любимец фрактола, и когда-нибудь он таки покажет всем, насколько я важен для этой организации. Они сказали мне, что во всяком есть божественность. Для меня это правда. По правде говоря, я думаю, что я ближе к ней, чем большинство других. Это дает мне право действовать так, словно я — бог, и ожидать от моих подчиненных полной преданности. Меня учили использовать силу и двигать горы верой в себя. Когда я буду управлять вселенной, будь уверен, я припомню каждому пню, который вставал у меня на пути».~
@13008 = ~«Это... интересно. У меня есть другие вопросы...»~
@13009 = ~«Понятно. Прощай».~
@13010 = ~«Полагаю, ты еще не вволю наковался, а? Тогда ладно, держи и проваливай, — он яростно хватает глыбу железа с ближайшей стопки и сует ее тебе в руки. — Тебе еще чего-нибудь, или я могу вернуться к своей обязанности смотреть за этими несчастными?»~
@13011 = ~«У меня еще пара вопросов...»~
@13012 = ~«Возвращайся к работе. Счастливо».~
@13013 = ~Он косится на тебя. «Насколько я могу судить, тебе это ни к чему. Шел бы ты в лабиринты, пень».~
@13014 = ~«Почему бы тебе не отдать его мне, и уйти целым и невредимым?»~
@13015 = ~«Почему бы тебе не отдать его мне, и уйти целым и невредимым?»~
@13016 = ~«Ладно, ладно. Тогда у меня к тебе еще несколько вопросов...»~
@13017 = ~«Если ты хочешь этого. Прощай».~
@13018 = ~Он внимательно осматривает тебя сверху вниз, размышляя, и произносит: «Э, хочешь быть кузнецом? Пожалуй, такой шкуре огонь нипочем. Держи, и не путайся под ногами у моих рабочих. До свидания, сэр».~
@13019 = ~«Тогда прощай».~
@13020 = ~«Похоже, теперь они берут в боголюди кого угодно, — бурчит он. — Не то что в старые времена, когда, чтобы стать членом фракции, ты должен был показать настоящие способности. Тебе нужно железо для того бабского испытания? Вот, держи, и проваливай в лабиринты». Он сует тебе в руки кусок холодной руды.~
@13021 = ~«Спасибо. У меня есть другие вопросы...»~
@13022 = ~«Спасибо. Прощай».~
@13023 = ~Он смотрит на размер твоих рук, на твое лицо, и решает, что ты это серьезно. «Только не думай, что я это забуду, пень», — говорит он, подавая тебе глыбу железной руды. Говоря это, он избегает твоего взгляда.~
@13024 = ~«Спасибо. У меня есть другие вопросы...»~
@13025 = ~«Спасибо. Прощай».~
@13026 = ~Он смотрит на размеры твоих рук и презрительно усмехается. «Ты чего, решил меня напугать? Проваливай, пень». Он отворачивается от тебя.~
@13027 = ~Напасть на его.~
@13028 = ~Уйти.~
@13029 = ~«Чем я занимался? Ну, я... я сидел в своей комнате с хорошим ломтем хлеба и кувшином вина. Всю ночь оставался внутри и не выходил наружу. Не было надобности».~
@13030 = ~«Ты знаешь кого-нибудь, кто мог бы в этом поклясться?»~
@13031 = ~«Понятно. У меня есть другие вопросы...»~
@13032 = ~«Понятно. Прощай».~
@13033 = ~«Нет. И не вижу в этом нужды. Уж кого тебе следует допросить, если ты действительно ищешь зацепки, так это Сароса. Этот маленький рыцарь-вор шастает буквально повсюду, ведь у него папашка — один из здешних шишек. Он постоянно ищет новые впечатления — да парень уже практически чувствующий, если хочешь знать мое мнение. Небось, захотел кого-нибудь убить и увидеть, сойдет ли это ему с рук».~
@13034 = ~«Э, Сарос? Я это запомню. Между тем, у меня есть еще пару вопросов...»~
@13035 = ~«Э, Сарос? Пойду, проверю. Счастливо».~
@13036 = ~Он широко улыбается, показывая несколько гнилых зубов, и подается вперед, чтобы пожать тебе руку. «Ты сделал хороший выбор, друг, хороший выбор. Жду-не дождусь, чтобы увидеть тебя снова».~
@13037 = ~«Это уж точно. Прощай».~
@13038 = ~Железная Гвоздинка выпрямляется и кладет руки на пояс. «Что, опять вернулся? Чего тебе на этот раз?»~
@13039 = ~«Я считаю, что ты убил кузнеца, и пытался свалить на Сароса вину за свое преступление. Также я считаю, что Сарос пытался указать на тебя незаконным способом, и что он виновен в других преступлениях».~
@13040 = ~Железная Гвоздинка выпрямляется и кладет руки на пояс. «Что, опять вернулся? Чего тебе на этот... — неожиданно она замечает позади тебя Анну. — Ну, рубака... кто твоя новая подруга?»~
@13041 = ~«Я просто немного пошутил, Тильдон. Расслабься. Ответь мне еще на пару вопросов».~
@13042 = ~«Я шучу, Тильдон. Прощай».~
@13043 = ~«Убил кузнеца Авильдона и пытался ложью уйти от ответственности. Прощай».~
@13044 = ~«Что, снова ты?»~
@13045 = ~«Ответь мне на пару вопросов, Тильдон».~
@13046 = ~«Нет. Прощай».~
@13047 = ~Ты видишь мужчину с подтянутым животом, крепкими руками и неряшливой бородой. От него воняет так, будто он никогда не мылся, а от его дыхания твой завтрак просится наружу. Ты застаешь его в процессе раздачи указаний своим подчиненным, когда он быстро отвешивает затрещину одному из них. Он поворачивается к тебе, держась за пояс. «Чего тебе?» ~
@13048 = ~«У меня есть несколько вопросов...» ~
@13049 = ~«Ничего. Прощай».~
@13050 = ~Железная Гвоздинка выпрямляется и кладет руки на пояс. «Что, опять вернулся? — она сконфуженно смотрит тебе за спину. — Скажи-ка, рубака... где та симпатичненькая крошка, которая ходила вместе с тобой?»~
@13051 = ~Железная Гвоздинка выпрямляется и кладет руки на пояс. Заметив Анну, она широко улыбается. «Что, снова ты? Приятно снова видеть твое прелестное личико, девочка, — она оборачивается к тебе. — Что тебе нужно, рубака?»~
@13052 = ~«И тебе того же, рубака».~
@13053 = ~Заслышав твое приближение, она выпрямляется. Она вежливо улыбается, но по ее позе и руке, лежащей возле рукоятки оружия, можно сделать вывод, что она готова к неприятностям. Ты замечаешь, что на одном глазу у нее бельмо. «Не так близко, рубака... Что тебе нужно от меня?»~
@13054 = ~Заслышав твое приближение, она выпрямляется. Она вежливо улыбается, но по ее позе и руке, лежащей возле рукоятки оружия, можно сделать вывод, что она готова к неприятностям. Ты замечаешь, что на одном глазу у нее бельмо. Завидев Анну, она улыбается и приветственно кивает тифлингу, после чего оборачивается к тебе. «Не так близко, рубака... Что тебе нужно от меня?»~
@13055 = ~Она кивает. «Валяй».~
@13056 = ~Она вытаскивает три гвоздя из своего мешочка, подбрасывает их в воздухе и ловит ладонью. «Железная Гвоздинка, так меня зовут». Она бросает их назад мешочек с приглушенным *дзынь*.~
@13057 = ~Лицо Гвоздинки становится суровым. «Не твое дело, пень. А что? Может, хочешь добавить такую же рану к своей коллекции?»~
@13058 = ~Она закатывает глаза. «А на что это похоже, пень? Я собираю гвозди!» Она тихонько смеется, тряся своей головой.~
@13059 = ~«Я продаю их человеку по имени Хамрис из Нижнего района. Он гробовщик».~
@13060 = ~Она пожимает плечами. «Да прямо отсюда, наверное. Иногда дабусы что-то ломают, а я подхожу до того, как нагрянут другие и унесут обломки. Еще это может быть строительный мусор от зданий или стен, которые они возводят или разрушают».~
@13061 = ~«Ага, дабусы — слуги Леди, — она озадаченно смотрит на тебя. — Ты, должно быть, недавно в Сигиле».~
@13062 = ~«Они работают над городом, исполняя волю Леди. Вечно что-то строят или перестраивают, используя для чего-то нового то, что развалилось или разрушилось».~
@13063 = ~Гвоздинка смотрит на тебя неодобрительно. «Э, нет, не надо! Я ничего не скажу о ней больше того, что уже сказала... — она проводит пальцем полукруг над своим сердцем. — Дам тебе совет, пень: никого не спрашивай о Леди».~
@13064 = ~«Тут и сказать-то нечего... он немного болтлив — будет трясти черепушкой с тобой до тех пор, пока ты не свихнешься, — но он честный торговец. Ему нужны гвозди — мне нужны звенелки, и все остаются довольны».~
@13065 = ~«Э... Знала я одну дорогу, вот только дабусы снова переделали улицы. Я не знаю, как теперь туда попасть: нужно разведать новую дорогу. Но думаю, что дабусы в конечном счете все выпрямят».~
@13066 = ~Она ухмыляется и качает головой. «Еще ни у кого до меня не было столько ума или желания, чтобы заниматься этим, и я убираю с дороги любого, кто пытается захватить мое дело». Она нежно похлопывает по длинному кинжалу, висящему у нее на боку.~
@13067 = ~«Ага, я так это называю! Приличную работу в Улье не найти, и я не позволю какому-то слабоумному идиоту обставить меня в моем же деле. Немало пней я заставила бежать и вопить, держась за кишки... или отправила прямиком к сборщикам, когда им не везло, — ее слепой глаз злобно сверкает. — Улей знает, кто такая Железная Гвоздинка, это уж точно».~
@13068 = ~Она громко хохочет. «Ага, к тому же, я не думаю, что у тебя найдется место для еще одного шрама!»~
@13069 = ~«Послушай, рубака, у меня еще куча работы. Гвозди сами по себе не станут лезть ко мне в мешок, пока я тут с тобой черепушкой трясу. Почему бы тебе не найти черепушку другого рубаки для этого дела?»~
@13070 = ~Она кивает. «Ага, я слышала это имя. Главарь банды сборщиков — по крайней мере, так говорят. Хотя и не знаю, где его искать. Начни с площади Старьевщиков — она к северо-западу отсюда. Целая куча сборщиков зовет ее своей берлогой...»~
@13071 = ~«Неа, не видела, — она умолкает на мгновение. — Знаешь, а это хорошая идея — иметь дневник. Наверно, стоит и себе такой завести».~
@13072 = ~Она осмысливает сказанное тобой. «Ха. Ты прав. Ты чертовски прав, рубака! Я так и сделаю. Спасибо за идею». Она улыбается.~
@13073 = ~Гвоздинка кажется искренне опечаленной. «Эмм... а... ясно. Очень жаль. Такое слишком часто случается в Улье, — она трясет головой, как будто пытаясь отвлечься от меланхолии. — Ладно, чего ты хотел?»~
@13074 = ~«О? — наконец она, нахмурившись, переключает свое внимание на тебя. — Очень жаль, правда. Так чего же ты хотел?»~
@13075 = ~Она вытаскивает три гвоздя из своего мешочка, подбрасывает их в воздухе и ловит ладонью. «Железная Гвоздинка, так меня зовут». Она бросает их назад мешочек с приглушенным *дзынь*. Она бросает взгляд на Анну, чтобы убедиться, что та видела ее действие. Увидев, что тифлинг уже отвернулась, она оборачивается к тебе.~
@13076 = ~Гвоздинку задело замечание, но она быстро восстанавливает спокойствие. Немного печально она улыбается тебе: «Ну конечно же, я могу, рубака. Что тебе нужно?»~
@13077 = ~Гвоздинка чешет голову. «В Улье есть только два вида работ... ты можешь ловить мозгогрызунов или собирать жмуриков». ~
@13078 = ~«Ага. Власти Сигила платят за каждый принесенный хвост. Их местное отделение находится к югу отсюда; человек внутри расскажет тебе больше».~
@13079 = ~«Тленные дают рубакам звенелки, если те приносят им жмуриков... содержат улицы в чистоте, типа того. Пней, которые занимаются этим, называют сборщиками... собирателями, как я. Вот только гвозди трупами не пахнут». Она ухмыляется.~
@13080 = ~«Ну, все зависит от того, что ты находишь развлечением. Самые лучшие бары здесь — это Бар собирателей пыли и Тлеющий труп. В последнем довольно много людей, но, опять же, все зависит от того, какую компанию ты ищешь». Она поглядывает на Анну, но та не обращает на нее внимания.~
@13081 = ~«В Улье на каждого найдется куча неприятностей... и, судя по твоему виду, на тебя их пришлось немало! Просто следи за теми, с кем ты разговариваешь, вот и все, — она снова оценивающе на тебя смотрит. — Уверена, ты справишься... да и твоя красавица-подруга тоже выглядит сильной». Гвоздинка выжидающе смотрит на Анну, но девушка не обращает внимания на комментарий.~
@13082 = ~Она кивает на Анну. «Кажется, твоя прекрасная спутница — сам жительница Улья... ты не спрашивал ее об этом?» Гвоздинка улыбается тифлингу, хотя ее разбитый глаз несколько притупляет эффект.~
@13083 = ~Гвоздинка раздумывает пару секунд, почесывая подбородок. «Бар Собирателей Пыли находится неподалеку от Морга — иди на юго-запад от его главных ворот. 'Тлеющий труп' (я сама туда заглядываю) на западе отсюда. Я бы пошла туда вместе с тобой пропустить стаканчик, но у меня полным полно работы».~
@13084 = ~«Знаешь, что? Я и сама за себя могу сказать! Я — Анна, если те есть до этого дело». Анна скрещивает руки и фыркает. Гвоздинка только улыбается и смотрит на тебя здоровым глазом.~
@13085 = ~«Знаешь, что? Я и сама за себя могу сказать! Я — Анна, если те есть до этого дело. А что до *этого* увальня, — Анна бросает на тебя яростный взгляд, — то я еще не уверена, друг он мне или нет!» Гвоздинка слегка улыбается перед тем, как посмотреть на тебя здоровым глазом.~
@13086 = ~Хвост Анны внезапно перестает хлестать, и она поворачивается к тебе — от неожиданности она смотрит на тебя во все глаза. Кажется, она хочет что-то сказать... но, кивнув, просто отводит взгляд. По румянцу на шее можно предположить, что она вся покраснела.~
@13087 = ~Хвост Анны перестает хлестать. Она просто кивает, не проронив ни слова.~
@13088 = ~Глаза Анны вспыхивают зеленым огнем, но она не произносит ни единого слова — только сердито смотрит на тебя.~
@13089 = ~Все тело Анны на секунду напрягается. Она не произносит ни слова, но злоба на твои слова буквально заполняет воздух вокруг нее. Ты ждешь худшего, однако она продолжает молчать, лишь презрительно усмехаясь тебе.~
@13090 = ~Анна наклоняет голову и хмуро смотрит на Гвоздику. «А почему б те не бросить интересоваться мной и тем, что я знаю, и просто не ответить на вопросы того парня?» Вдобавок она ухмыляется Гвоздике.~
@13091 = ~На мгновение он выглядит обеспокоенным, но потом произносит: «Сарос — вор. Странно, что он меня обокрал. По правде говоря, шило у меня пропало уже давно, но я не упоминал о нем, потому что думал, что потерял его. Теперь я знаю, что Сарос украл его, чтобы подставить меня. Лучше найди его, прежде чем он помашет тебе ручкой, — видя выражение твоего лица, он добавляет: Прежде чем он убежит».~
@13092 = ~«Звучит слишком просто. Я спрошу его об этом, как только получу ответы на несколько вопросов...»~
@13093 = ~«Тогда я просто пойду его искать. Прощай».~
@13094 = ~«Приветствую...»~
@13095 = ~«Приветствую...»~
@13096 = ~Позволить ее продолжить свою работу.~
@13097 = ~«У меня есть несколько вопросов...» ~
@13098 = ~«Ничего. Прощай».~
