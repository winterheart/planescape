@64130 = ~~
@64131 = ~Анна — тифлинг, дерзкая девчонка на пороге созревания. Когда она сердится, ее выдает мечущийся из стороны в сторону хвост. Приемная дочь Фарода Червеволосого, она выполняет поручения его сборщиков. Она смышленая беспризорница, и Улей для нее — вторая кожа. Ее навыки и способности делают ее полезной для тебя... и, возможно, она станет большим, чем просто товарищем.~
@64132 = ~~
@64133 = ~~
@64134 = ~~
@64135 = ~~
@64136 = ~ТЫ НЕ МОЖЕШЬ УМЕРЕТЬ.~
@64137 = ~~
@64138 = ~~
@64139 = ~~
@64140 = ~~
@64141 = ~~
@64142 = ~~
@64143 = ~Даккон — гитцерай, один из молчаливых жителей Лимбо. Похоже, у них хорошо развитая кастовая система. Его кожа желтая и в морщинах. Кажется, он уже старик; в его маленьких черных глазах таится боль. Он носит клинок *карач* из металла, который был изготовлен из основного вещества Лимбо. Клинок изменяется в соответствии с его настроением. Он неустанно следует за тобой, и все же.. кажется, что он делает это не по своей воле.~
@64144 = ~Падшая Грация — суккуб, одна из танарри, существ, буквально созданных из чистого хаоса и зла. Ее тело и разум — идеальный образец для соблазнения мужчин всех видов и возрастов. И все же она утверждает, что отвергла свою сущность, вместо этого став улучшать свою жизнь и жизнь всех, кто ее окружает, посредством развития дисциплин разума. Она бывшая владелица Борделя утоления интеллектуальной страсти. Она путешествует с тобой, чтобы познавать мир твоими глазами.~
@64145 = ~«У меня есть другие вопросы...»~
@64146 = ~«Я его проверю. Но разговор еще не окончен. Счастливо».~
@64147 = ~«У меня есть другие вопросы».~
@64148 = ~«Я позабочусь об этом. Счастливо».~
@64149 = ~«С удовольствием. У меня другие вопросы».~
@64150 = ~«С удовольствием. Прощай».~
@64151 = ~Найти отца Шерил.~
@64152 = ~Я поговорил с Норочжем и сделал то, о чем он попросил — решил проблему с вором, который наряжался в тленного. Теперь я должен вернуться к Эморику, все рассказать и продолжить свое посвящение в тленные.~
@64153 = ~Найти и вернуть дневник исследований Финама.~
@64154 = ~Разрушить доводы Ки-Сая по поводу того, что нужно учиться на вора, а не на воина.~
@64155 = ~Я не смог найти в Улье садовника, так что я вернулся к Меббет. Она сказала, что это неважно и она, пожалуй, сможет заставить проклюнуться одно из ее старых черношипных семян.~
@64156 = ~Ты видишь Финеаса. Он надевает свои очки и по-дружески на тебя смотрит. «А, это ты, друг мой. Что я могу сделать для тебя на *этот* раз, м-м-м?»~
@64157 = ~«На этот раз ты не подпрыгнул от испуга, когда я пришел».~
@64158 = ~«У меня есть несколько вопросов...» ~
@64159 = ~«Ничего, прощай».~
@64160 = ~Он кивает и улыбается. «После твоего героического поступка я чувствую себя... гораздо лучше. Должен признать, что не чувствовал себя таким отдохнувшим уже много лет, — с задумчивым выражением лица он умолкает. — Спасибо тебе за это. Итак, что я могу для тебя сделать?»~
@64161 = ~«У меня есть несколько вопросов...» ~
@64162 = ~«Ничего, прощай».~
@64163 = ~«Как ты разговариваешь с теми другими зомби? Я не могу понять их так, как понимаю тебя...»~
@64164 = ~«Здравствуй. Подбираешь себе гроб? — он дружески улыбается тебе. — У меня больше нет работы для тебя, так что... Чем я могу тебе помочь?»~
@64165 = ~«У меня есть несколько вопросов...» ~
@64166 = ~«Ничего, прощай».~
@64167 = ~Ты видишь Ксантию. Когда ты подходишь, она окидывает тебя скучающим взглядом. «Что ж... я видела, как ты говорил с тем болваном Торпом. Ты его предупредил?»~
@64168 = ~«Нет, я решил насладиться представлением вместе с тобой».~
@64169 = ~Ксантия смеется, затем улыбается тебе. «Как мило... Прошу, можешь присоединиться ко мне, — она умолкает на миг, задумавшись, затем снимает с пояса кошелек. — Вот... Прими это в качестве награды за то, что не испортил женскую забаву». Она дает тебе кошелек.~
@64170 = ~«Спасибо, Ксантия. Прощай».~
@64171 = ~Вришика слегка хмурится, разглядывая расписку. «Что ж... полагаю, Стендиш сможет ее потом обналичить. Хорошо, держи, — она дает тебе предмет. — Прошу, наслаждайся новым приобретением».~
@64172 = ~«Я хотел бы взглянуть на оружие и амулеты».~
@64173 = ~«Я хотел бы еще раз взглянуть на экзотические товары».~
@64174 = ~«Прощай».~
@64175 = ~«У меня долговая расписка из Борделя на сумму в тысячу монет...»~
@64176 = ~«Нет, спасибо. Прощай».~
@64177 = ~Городской Фестхолл~
@64178 = ~Призванный конструкт~
@64179 = ~Призванный конструкт~
@64180 = ~Владение луком~
@64181 = ~Этот магический жезл позволяет вызывать модронских констуктов для сражения с врагами. Призываются от одного до трех конструктов. Они будут бесстрашно сражаться до самой смерти.~
@64182 = ~Использовать.~
@64183 = ~Отложить.~
@64184 = ~Этот магический жезл позволяет вызывать модронских констуктов для сражения с врагами. Призываются от одного до трех конструктов. Они будут бесстрашно сражаться до самой смерти.~
@64185 = ~Использовать.~
@64186 = ~Отложить.~
@64187 = ~Владение клинковым оружием~
@64188 = ~Этот магический жезл позволяет вызывать модронских констуктов для сражения с врагами. Призываются от одного до трех конструктов. Они будут бесстрашно сражаться до самой смерти.~
@64189 = ~Использовать.~
@64190 = ~Владение кулачным боем~
@64191 = ~Отложить.~
@64192 = ~День  <GAMEDAY>   <HOUR>:<MINUTE>~
@64193 = ~«Пууумите суии убязаносиии...»~
@64194 = ~«Чиите Бимуулноо Кууля...»~
@64195 = ~«Скууро мыыы осуобудиися от пуоотии...»~
@64196 = ~Игнус — горящий человек, влюбленный в пламя. Когда ты вылил на него Графин бесконечной воды, его пламя так и не погасло: он попросту разбил узы заклинания, которое не позволяло ему пошевелиться и сжигало его. Теперь он стал чем-то большим, чем человек, чем-то первичным... и что-то в твоем сердце подсказывает тебе, что он обладает силой, способной уничтожить тебя полностью.~
@64197 = ~Хозяин Костей ночи Лотар держит в своем салоне полки, заполненные черепами. Они рассказывают давно забытые тайны, их шепот заполняет *его* череп сокровенными знаниями. Наверно, он один из тех немногих на свете, кто в самом деле может уничтожить тебя. Народ Сигила произносит его имя благоговейным полушепотом и активно стремится избегать оскорблений в его адрес.

Накопленные им знания окупились для тебя: он рассказал тебе о ведьме Равель Заморочке и как добраться до нее. Еще он предупредил тебя насчет нее, сказав, что ее козни чуть не сбросили Сигил со Шпиля.~
@64198 = ~Нордом — модрон-бродяга, скрывающийся во внутренностях куба-модрона в Лимбо. Если его найдут другие модроны, его безусловно разберут и пустят на лом, чтобы его индивидуальность не заразила других модронов.~
@64199 = ~Этот громоздкий доспех удерживается духом, называющим себя Вейлор. Силой, не дающей ему умереть, является справедливость, и похоже, что он становится тем сильнее, чем больше несправедливости он видит. Его тускло-красные глаза непрестанно горят, а его непоколебимая преданность кредо убийц милосердия отдается в узорах на броне, шлеме и особенно на топоре, который он носит. Что-то в этом существе наводит тебя на мысль, что оно может тебя убить... навсегда. Изо всех существ, которых ты повстречал в своей жизни, с этим нужно быть особо осторожным.~
@64200 = ~Нордом — модрон-бродяга, решивший путешествовать с тобой. Если его найдут другие модроны, его безусловно разберут и пустят на лом, чтобы его индивидуальность не заразила других модронов. Нордом носит с собой пару арбалетов. Временами он разговаривает с ними, и они, похоже, отвечают.~
@64201 = ~«Встань-ка подальше от меня, Морт».~ [ANA575F]
@64202 = ~~
@64203 = ~«Понятно. Расскажи мне о своей дочери».~
@64204 = ~«Понятно. Расскажи мне о своей дочери».~
@64205 = ~Рассматривая гнилые остатки тела, ты замечаешь, левая рука совсем не тронута: она отвалилась от туловища во время падения, и совсем не похоже, чтобы она была поражена трупным гниением, как это случилось с остальной частью тела.~
@64206 = ~«Хм-м. Думаю, я смогу найти применение этой руке...»~
@64207 = ~Триас — небожитель с Верхних планов. Впервые ты встретил его в тюрьме Проклятого, где он был заключен в обсидиановый пузырь. Его красота изумляет: исходящая от него аура подобна волне яркого света. Его крылья опалены до кости, и все же он с гордостью терпит свои страдания.

Тебя обманули.

Триаса зовут Предателем. Он привел армию нечисти к воротом Рая и был изгнан из рядов небожителей. Он обманул нечистого по имени Фьюл Раздвоенный Язык, заставив его заниматься благотворительностью, и очевидно, что он несет зло в своей сути.~
@64208 = ~«Грация... у тебя есть сестры?»~ [MRT461AB]
@64209 = ~«Эй, Нордом, а почему бы тебе не прыгнуть обратно на Механус?»~ [MRT466B]
@64210 = ~«Некто должен сосредоточиться на *Наз Ледии*».~
@64211 = ~«Отойди, не то поплатишься».~
@64212 = ~«Эй пень, не хапай чужое!»~
@64213 = ~«Некто должен держаться заповедей *Наз Ледия*».~
@64214 = ~«Хм-м-м».~
@64215 = ~«Меббет, с тобой все в порядке?»~
@64216 = ~«Меббет... твой голос... ты говоришь голосом *Равель*. *Кто* ты?!»~
@64217 = ~~
@64218 = ~(auto link)~
@64219 = ~«Внимание: Морт. Знаешь ли ты, что у меня шесть сторон?»~ [NOR311]
@64220 = ~«Анна, твой хвост помогает тебе поддерживать равновесие?»~ [NOR291A]
@64221 = ~::Хмуро смотрит на Морта::~
@64222 = ~«Спасибо. Мне пора».~
@64223 = ~Ленни улыбается тебе и задумчиво кивает. «Держи, рубака. Возьми еще и это. Подарочек от Ленни, поможет тебе на новом поприще... Мне они все равно больше не нужны». Он дает тебе пару ударных кинжалов.~
@64224 = ~«Спасибо, Ленни. Прощай».~
@64225 = ~Эти огромные часы как будто вплавились в окружающий их черный камень... земля вокруг потревожена, будто кто-то здесь «недавно» топтался, возможно, пару лет назад.~
@64226 = ~На циферблате часов что-то грубо выцарапано, и внезапно у тебя возникает странное ощущение покалывания, проходящее по затылку: ты понимаешь, что это послание тебе... от тебя самого.~
@64227 = ~Послание, вырезанное на циферблате часов, похоже, сделано кинжалом: 

БЕГИ — ДВЕРИ ЛЖИВЫ — ИСПОЛЬЗУЙ пушки — потом ПОРТАЛ

Кажется, послание писалось в спешке. За ним следует грубая «стрелка», указывающая в сторону, противоположную минутной стрелке часов.~
@64228 = ~Эти огромные часы как будто вплавились в окружающий их черный камень... земля вокруг потревожена, будто кто-то здесь «недавно» топтался, возможно, пару лет назад. На их поверхности есть твое послание... к тебе же.~
@64229 = ~Осмотреть надпись.~
@64230 = ~Оставить часы в покое.~
@64231 = ~«Спасибо за совет...»~
@64232 = ~Осмотреть надпись.~
@64233 = ~Оставить часы в покое.~
@64234 = ~Эти огромные часы как будто вплавились в окружающий их черный камень... глядя на их циферблат, ты внезапно ощущаешь странное покалывание, проходящее по затылку: ты уже видел похожие часы, но не эти. С ними связано нечто важное, но ты не знаешь, что именно.~
@64235 = ~Эти огромные часы как будто вплавились в окружающий их черный камень... в отличие от часов с посланием, на этих нет ни надписей, ни отметок. Очевидно, твое предыдущее воплощение ни разу на них не натыкалось.~
@64236 = ~Оставить часы в покое.~
@64237 = ~Оставить часы в покое.~
@64238 = ~В Крепости я обнаружил странную машину. Она похожа на что-то вроде пушки, но есть подозрение, что это своего рода «сторожевой пост» или запирающий механизм Крепости. Воспользовавшись ею, я очутился в другом изолированном помещении Крепости, балконе, выходящем в главную галерею. Я знаю, что мне нужно найти другие машины и каким-то образом активизировать их. Должно быть, моя память возвращается ко мне: если нацарапанное на часах — какая-то подсказка, то одно из моих воплощений уже проходило через это испытание.~
@64239 = ~В Крепости я обнаружил странную машину. Она похожа на что-то вроде пушки, но есть подозрение, что это своего рода «сторожевой пост» или запирающий механизм Крепости. Воспользовавшись ею, я очутился в другом изолированном помещении Крепости, балконе, выходящем в главную галерею. Я знаю, что мне нужно найти другие машины и каким-то образом активизировать их. Не знаю, почему, но у меня есть странное чувство, что я уже делал это раньше.~
@64240 = ~В Крепости я наткнулся на огромные сломанные часы... осмотрев их, я почувствовал, что должен что-то на них *увидеть*, но что именно — непонятно. Возможно, в прошлом я видел похожие часы.~
@64241 = ~Эта древняя машина похожа на забытый всеми военный реликт. Большая ее часть покрыта пылью, за исключением странной панели с рычагами. Довольно странно, но земля вокруг панели потревожена, будто кто-то здесь «недавно» топтался, возможно, пару лет назад.~
@64242 = ~На панели есть ряд приборов и рычагов. Под ними нацарапаны пометки; похоже, делали их кинжалом и в спешке. Под одними нет пометок, под другими — косая черта, а под одним из рычагов выцарапан крестик. Непонятно, почему, но ты знаешь, что рычаг с крестиком каким-то образом поможет тебе покинуть это место.~
@64243 = ~Он легко поддается тебе, и, к твоему удивлению, превращается в туман... за ним следует твоя ладонь, тоже начав исчезать, потом рука, потом тебя охватывает головокружение, и стены вокруг меркнут...~
@64244 = ~Эта древняя машина похожа на забытый всеми военный реликт. Большая ее часть покрыта пылью, за исключением странной панели с рычагами. От рычага, который ты дернул, не осталось и следа: он пропал, как будто его никогда и не было.~
@64245 = ~Ты быстро находишь помеченный крестиком рычаг и дергаешь его. Он легко поддается тебе, затем превращается в туман... ты глубоко вдыхаешь, затем тебя в очередной раз охватывает головокружение, и стены вокруг меркнут...~
@64246 = ~Найти панель, потом рычаг, отмеченный крестиком.~
@64247 = ~Осмотреть панель.~
@64248 = ~Оставить машину в покое.~
@64249 = ~Потянуть рычаг, отмеченный крестиком.~
@64250 = ~Потянуть рычаг, отмеченный крестиком.~
@64251 = ~Оставить машину в покое.~
@64252 = ~«Чт..»~
@64253 = ~Оставить машину в покое.~
@64254 = ~«Куда это я *н...*»~
@64255 = ~Ты быстро находишь помеченный крестиком рычаг и дергаешь его. Он легко поддается тебе, затем превращается в туман... ты глубоко вдыхаешь, но, в отличие от предыдущих раз... ничего не происходит.~
@64256 = ~Вдалеке слышится гул, как будто *что-то* только что открылось, и по комнатам проносится воющий ветер. Пытаясь понять, откуда доносится звук, ты вдруг осознаешь, что распадаешься и становишься частью ветра...~
@64257 = ~«*Что* происходит?..»~
@64258 = ~~
@64259 = ~Я отказался освободить голема из осадной башни, и в ответ он выбросил меня из нее. Но это, наверно, к лучшему для планов, что я оставил его в клетке.~
@64260 = ~Кажется, потянув рычаг на четвертой машине, я что-то открыл в недрах Крепости... может быть, выход? Мне нужно попытаться найти его и выбраться отсюда к чертям собачьим...~
@64261 = ~Найти панель, потом рычаг, отмеченный крестиком.~
@64262 = ~Похоже, этот скелет попал в какой-то серьезный переплет: либо он участвовал в битве, либо упал через несколько лестничных пролетов. Обе руки и ноги переломаны и собраны вновь с помощью кожаных ремней и тонких железных реек. На лбу высечен номер «863»... но сзади череп имеет открытую пустую полость. Ты замечаешь, что кто-то воспользовался этим и поместил внутрь черепа пергаментный свиток.~
@64263 = ~Вытащить пергамент из черепа скелета.~
@64264 = ~Оставить скелет в покое.~
@64265 = ~Ты ловко вытягиваешь пергамент из черепа рабочего. Довольно странно, но пробоина в череп выглядит так, словно она *предназначена* для хранения сообщений: к пергаменту прикреплена тонкая нитка, которая привязана к черепу изнутри, предотвращая случайное выпадение пергамента.~
@64266 = ~Разорвать нитку, взять пергамент.~
@64267 = ~Ты разрываешь нитку и окидываешь взглядом пергамент — похоже на напоминание от одного из смотрителей Морга. Судя по заметке, этот скелет является что-то вроде ходячего курьера. Еще раз взглянув на скелета, ты понимаешь, что он остановился перед плитой лишь потому, что не смог ее обойти.

^NПРИМЕЧАНИЕ: <READSTUFF>^-~
@64268 = ~Снова осмотреть скелет.~
@64269 = ~Оставить скелет в покое.~
@64270 = ~У этого ковыляющего зашит не только рот, но и глаза, а на брови вырезан номер «732». Похоже, глазные полости были зашиты давным-давно... тебе остается только гадать, когда потерял человек глаза — до смерти или после. Ты замечаешь, что в руках он несет тяжелую книгу, как будто он где-то ее забрал. ~
@64271 = ~Взять том из его рук... осторожно.~
@64272 = ~Оставить труп в покое.~
@64273 = ~Ты осторожно берешь книгу из рук трупа — он даже не замечает этого. Похоже, это книга заклинаний и оберегов: она исписана схемами и таблицами, описывающими различные аспекты искусства некромантии. Сама по себе книга очень тяжелая. Каким бы неуклюжим не был зомби, он, должно быть, очень силен.

^NПРИМЕЧАНИЕ: <READSTUFF>^-~
@64274 = ~Снова осмотреть труп. ~
@64275 = ~Оставить труп в покое.~
@64276 = ~СТАРИННАЯ МЕДНАЯ СЕРЬГА (ЗАКРЫТАЯ)
Вес: 0
Бесполезная (закрыта)

Эта медная серьга выглядит древней. Что довольно странно, у нее нет крючка или каких-либо других приспособлений для крепления на ухе. Однако, на внутренней поверхности серьги высечен ряд необычных вырезов, которые заслуживают более внимательного изучения.

^NПРИМЕЧАНИЕ: Если в дальнейшем у вас появится возможность изучить этот предмет или выполнить с ним действие вне экрана мира, появится кнопка «ИСПОЛЬЗОВАТЬ». Эта кнопка позволяет вам исследовать предмет, воздействуя на него с помощью экрана диалога. Если в этом случае вы захотите исследовать вырезы на серьге, нажмите кнопку ИСПОЛЬЗОВАТЬ внизу.^-~
@64277 = ~~
@64278 = ~Похоже, зубчатый круг на лбу трупа был выжжен очень давно, возможно даже еще до того, как он умер. Возможно, это какой-то религиозный символ или ритуальный знак. Ты замечаешь, что в одной из впадин между внутренними «зубцами» есть маленький треугольник, как будто у него есть какое-то особое назначение.~
@64279 = ~«Хм-м. Интересно... что здесь делает эта отметина, а, труп?»~
@64280 = ~«Хм-м... Не удивлюсь, если зазор между зубцами совпадет с выемками на той медной сережке...»~
@64281 = ~~
@64282 = ~«Янис, в сенсориуме есть камень переживаний с фрагментом переживаний твоей дочери».~
@64283 = ~«Я не уверен. В Фестхолле есть камень переживаний с номером наследства».~
@64284 = ~«Я не уверен. Номер я нашел в Фестхолле, в камне переживаний, о котором я уже говорил; оно предназначено для меня».~
@64285 = ~«Я не уверен. В Фестхолле есть камень переживаний с номером наследства».~
@64286 = ~«Я не уверен. Номер я нашел в Фестхолле, в камне переживаний, о котором я уже говорил; оно предназначено для меня».~
@64287 = ~«Возможно. Что ж, в том камне переживаний она оставила для меня номер наследства...»~
@64288 = ~«Возможно. Что ж, в том камне переживаний она оставила для меня номер наследства...»~
@64289 = ~«В ближайшее время я схожу и разберусь с этим делом. В камне переживаний она оставила номер наследства для меня...»~
@64290 = ~«В ближайшее время я схожу и разберусь с этим делом. В камне переживаний она оставила номер наследства для меня...»~
@64291 = ~«Тогда я в ближайшее время схожу и разберусь с этим делом. А теперь насчет наследства, которое она для меня оставила...»~
@64292 = ~«Тогда я в ближайшее время схожу и разберусь с этим делом. А теперь насчет наследства, которое она для меня оставила...»~
@64293 = ~Изучить символы.~
@64294 = ~Сравнить руны с рунами в Книге Костей и Праха. ~
@64295 = ~Ты сравниваешь диаграммы из книги с символами на нагруднике. Судя по всему, они являются слабым защитным заклинанием, но несколько сферических рисунков и рун в форме черепов, идущих по краям доспехов, наводят на мысль о более сильных некромантских и охранных заклинаниях. Если дотронуться до скелета, то, скорее всего, он пробудится... и будет защищаться.~
@64296 = ~Сравнить образец заклинаний с Книгой Костей и Праха, определить, сможешь ли ты их разрушить.~
@64297 = ~Согласно Книге, защитное заклинание применено только к нагруднику, некромантское заклинание позволяет скелету пробудиться, однако охранное заклинание предоставляет скелету только ограниченные сведения об окружающей обстановке. Ты предполагаешь, что если сначала разрушить охранное заклинание, то это может быть расценено как атака... если только перед этим ты не скроешь свое присутствие.~
@64298 = ~Заглянуть в Книгу Костей и Праха, посмотреть, можно ли их разрушить.~
@64299 = ~Оставить руны в покое и осмотреть гигантского скелета еще раз.~
@64300 = ~Сначала разрушить руны, поддерживающие защитное заклинание, затем — некромантское, а затем — охранное заклинание. ~
@64301 = ~Сначала разрушить руны, поддерживающие охранное заклинание, затем пройтись по рунному узору в обратном порядке, отменив некромантское, а затем — защитное заклинание.~
@64302 = ~Сначала разрушить руны, поддерживающие охранное заклинание, затем пройтись по рунному узору в обратном порядке, отменив некромантское, а затем — защитное заклинание.~
@64303 = ~Оставить руны в покое и осмотреть гигантского скелета еще раз.~
@64304 = ~НЕБО И ЗЕМЛЯ
Урон: 2-20 дробящий
Магический урон: +3
Особенности: 
   +3 дробящего урона
   +2 к Силе
THAC0: +3
Скорость: 2
Вес: 10
Специализация: дубины
Используется только бойцами
Используется только добрыми персонажами
Используется только Безымянным

Грозная аура силы исходит от этого массивного оружия. Рукоять палицы украшают четкие и мощные линии, которые переходят прямо на безупречную сферу, что служит этому оружию наконечником. Из этой идеальной сферы выходят безупречно загнутые шипы, создавая образ, который захватывает и в то же время внушает благоговейный страх. Трепещущее свечение оттенка королевского пурпура окружает это оружие мощи.

Когда держишь это оружие, то сразу становится очевидным тот факт, что лишь те, кто чист сердцем, действительно могут пользоваться им. ~
@64305 = ~Долговая расписка~
@64306 = ~ДОЛГОВАЯ РАСПИСКА
Вес: 0

Эта долговая расписка на сумму в тысячу медных монет, которую владелец может забрать в Борделе утоления интеллектуальной страсти. Экко дала ее тебе для приобретения слез дэва; маловероятно, что ты сможешь сделать с этим что-либо еще.~
@64307 = ~Ударные кинжалы Шар~
@64308 = ~УДАРНЫЕ КИНЖАЛЫ ШАР
Урон: 1-4 колющий
Магический урон: +3
Особенности:
   +2 ко всем спасброскам
   +35% устойчивости к магии
Скорость: 2
Вес: 2
Специализация: кулаки
Используется только бойцами и ворами

Когда-то эти кинжалы носила Шар, убийца магов. Шар была убийцей особого рода, которая решила сосредоточиться на «устранении» магов за большие суммы золотом. Для достижения этой цели она заказала клинки у мага Текса Вуртона. С новым оружием в руках она была довольно успешна в своем ремесле.

Шар встретила свою погибель, когда была нанята для убийства того самого мага, что создал кинжалы. К ее великому удивлению, оружие не могло причинить вред своему создателю, Тексу, и не давало Шар защиту от его заклинаний...~
@64309 = ~МЕРТВЫЙ ЛИМ-ЛИМ
Вес: 5

Этот маленький труп когда-то был твоим ручным лим-лимом... Какие бы силы не действовали на Негативном материальном плане, он не смог здесь выжить.~
@64310 = ~«Чт..»~
@64311 = ~«Чт..»~
@64312 = ~«*Что* происходит?..»~
@64313 = ~«*Что* происходит?..»~
@64314 = ~«Куда это я *н...*»~
@64315 = ~«Куда это я *н...*»~
@64316 = ~Эта древняя машина похожа на забытый всеми военный реликт. Большая ее часть покрыта пылью, за исключением странной панели с рычагами. Довольно странно, но земля вокруг панели потревожена, будто кто-то здесь «недавно» топтался, возможно, пару лет назад.~
@64317 = ~Найти панель, потом рычаг, отмеченный крестиком.~
@64318 = ~Ты быстро находишь помеченный крестиком рычаг и дергаешь его. Он легко поддается тебе, затем превращается в туман... ты глубоко вдыхаешь, но, в отличие от предыдущих раз... ничего не происходит.~
@64319 = ~Вдалеке слышится гул, как будто *что-то* только что открылось, и по комнатам проносится воющий ветер. Пытаясь понять, откуда доносится звук, ты вдруг осознаешь, что распадаешься и становишься частью ветра...~
@64320 = ~«*Что* происходит?..»~
@64321 = ~«*Что* происходит?..»~
@64322 = ~«*Что* происходит?..»~
@64323 = ~Найти панель, потом рычаг, отмеченный крестиком.~
@64324 = ~Ты быстро находишь помеченный крестиком рычаг и дергаешь его. Он легко поддается тебе, затем превращается в туман... ты глубоко вдыхаешь, затем тебя в очередной раз охватывает головокружение, и стены вокруг меркнут...~
@64325 = ~«Куда это я *н...*»~
@64326 = ~«Куда это я *н...*»~
@64327 = ~«Куда это я *н...*»~
@64328 = ~Осмотреть панель.~
@64329 = ~На панели есть ряд приборов и рычагов. Под ними нацарапаны пометки; похоже, делали их кинжалом и в спешке. Под одними нет пометок, под другими — косая черта, а под одним из рычагов выцарапан крестик. Непонятно, почему, но ты знаешь, что рычаг с крестиком каким-то образом поможет тебе покинуть это место.~
@64330 = ~Потянуть рычаг, отмеченный крестиком.~
@64331 = ~Он легко поддается тебе, и, к твоему удивлению, превращается в туман... за ним следует твоя ладонь, тоже начав исчезать, потом рука, потом тебя охватывает головокружение, и стены вокруг меркнут...~
@64332 = ~«Чт..»~
@64333 = ~«Чт..»~
@64334 = ~«Чт..»~
@64335 = ~Потянуть рычаг, отмеченный крестиком.~
