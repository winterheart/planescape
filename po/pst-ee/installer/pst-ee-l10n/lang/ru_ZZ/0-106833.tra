@24785 = ~«Мне кажется, я знаю тебя, Фелл».~
@24786 = ~«Он сказал, что уже видел меня... он знает, как я умер?»~
@24787 = ~«Он сказал, что уже видел меня... он знает, как я умер?»~
@24788 = ~«Он сказал, что уже видел меня... он знает, как я умер?»~
@24789 = ~«Спроси его, слышал ли он что-нибудь о Равель».~
@24790 = ~«Спроси его, слышал ли он что-нибудь о Равель».~
@24791 = ~«Спроси его, слышал ли он что-нибудь о Равель».~
