@106497 = ~Женщина кивает и быстро убегает. Вряд ли ты ее еще увидишь.~
@106498 = ~[This is a placeholder to prevent a string with a sound file from becoming strref 106498, which causes problems.]~
@106499 = ~«Так что же ты такое, Морт? Ты так этого и не сказал».~ [FFG121]
@106500 = ~Проникнуть в фракцию тленных для анархистов: «Да».~
@106501 = ~Проникнуть к чувствующим для анархистов: «Я готов. Я хочу стать чувствующим».~
@106502 = ~Проникнуть к чувствующим для анархистов: «Я готов присоединиться к Обществу Восприятия. Я больше не предан фракции боголюдей».~
@106503 = ~Проникнуть к чувствующим для анархистов: «Я готов присоединиться к Обществу Восприятия. Я больше не предан фракции тленных».~
@106504 = ~Проникнуть к чувствующим для анархистов: «Я готов присоединиться к Обществу Восприятия. Я больше не предан фракции хаоситеков».~
@106505 = ~Проникнуть в ряды хаоситов для анархистов: «Так, что дальше?»~
@106506 = ~Проникнуть в ряды хаоситов для анархистов: «Примкнуть готов к хаоситекам я. Не предан больше фракции старой боголюдей я».~
@106507 = ~Проникнуть в ряды хаоситов для анархистов: «Примкнуть готов к хаоситекам я. Не предан больше фракции старой тленных я».~
@106508 = ~Проникнуть в ряды хаоситов для анархистов: «Примкнуть готов к хаоситекам я. Не предан больше фракции старой чувствующих я».~
@106509 = ~Проникнуть в фракцию тленных для анархистов: «Будь что будет Мой разум должен быть верен себе, а не другому. Отныне я отказываюсь от убеждений моей старой фракции боголюдей».~
@106510 = ~Проникнуть в фракцию тленных для анархистов: «Будь что будет Мой разум должен быть верен себе, а не другому. Отныне я отказываюсь от убеждений моей старой фракции боголюдей».~
@106511 = ~Проникнуть в фракцию тленных для анархистов: «Будь что будет Мой разум должен быть верен себе, а не другому. Отныне я отказываюсь от убеждений моей старой фракции чувствующих».~
@106512 = ~«Проклятье, Вейлор, ты хоть представляешь, что ты наделал?!»~
@106513 = ~Вейлор отворачивается от трупа Триаса и смотрит тебе в лицо. *Ты МИЛОСЕРДЕН и СЛАБ. ЗАКАЛИ свое СЕРДЦЕ, прежде чем болезнь не РАСПРОСТРАНИЛАСЬ*.~ [VHA013]
