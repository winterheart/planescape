@4078 = ~Оставить скелета в покое.~
@4079 = ~Попробовать, сможешь ли ты как-нибудь разрушить чары.~
@4080 = ~Попробовать, сможешь ли ты как-нибудь разрушить чары.~
@4081 = ~Попробовать вытащить клинок из рук скелета.~
@4082 = ~Попробовать вытащить клинок из рук скелета.~
@4083 = ~Попробовать вытащить винты, держащие доспехи скелета.~
@4084 = ~Попробовать вытащить винты, держащие доспехи скелета.~
@4085 = ~«Эй, а как насчет ЭТОГО скелета, Морт? Пойдет такое тело?»~
@4086 = ~Сначала разрушить руны, поддерживающие защитное заклинание, затем — некромантское, а затем — охранное заклинание.~
@4087 = ~Сначала разрушить руны, поддерживающие охранное заклинание, затем пройтись по рунному узору в обратном порядке, отменив некромантское, а затем — защитное заклинание.~
@4088 = ~Сначала разрушить руны, поддерживающие охранное заклинание, затем пройтись по рунному узору в обратном порядке, отменив некромантское, а затем — защитное заклинание.~
@4089 = ~Попробовать вытащить клинок из рук скелета.~
@4090 = ~Попробовать вытащить клинок из рук скелета.~
@4091 = ~Попробовать вытащить винты, держащие доспехи скелета.~
@4092 = ~Попробовать вытащить винты, держащие доспехи скелета.~
@4093 = ~«Эй, а как насчет ЭТОГО скелета, Морт? Пойдет такое тело?»~
@4094 = ~Оставить скелета в покое.~
@4095 = ~«Лучше бы тебе оставаться мертвым, костяшка...»~
@4096 = ~«Чертова куча костей!..»~
@4097 = ~«Возьму-ка я это...»~
@4098 = ~«Посмотрим, что тут у нас на этот раз...»~
@4099 = ~«Возьму-ка я это...»~
@4100 = ~«Возьму-ка я это...»~
@4101 = ~«Возьму-ка я это...»~
@4102 = ~Бинты~
@4103 = ~БИНТЫ
Лечат 3 очка жизни.
Вес: 0

Это рулон бинтов, полезный для перевязывания легких ран. При использовании они восстанавливают 3 очка жизни.~
@4104 = ~Нагрудник 4~
@4105 = ~Кожаный ремень~
@4106 = ~Это рулон бинтов, полезный для перевязывания легких ран. При использовании они восстанавливают 3 очка жизни.~
@4107 = ~Мусор~
@4108 = ~Тряпье~
@4109 = ~Нагрудник 3~
@4110 = ~Укус Морта (острый)~
@4111 = ~Кожаный фартук~
@4112 = ~Квитанция со штампом в виде символа боголюдей. Наверно, ее можно использовать в Великой Литейной.~
@4113 = ~Кожаный ремень~
@4114 = ~Укус Морта~
@4115 = ~Любопытное железное изделие~
@4116 = ~Квитанция~
@4117 = ~Клещи~
@4118 = ~Мусор~
@4119 = ~«Приветствую».~
@4120 = ~Сделать вид, будто ты здесь «свой», и пройти мимо, не обращая на него внимания.~
@4121 = ~Глаза тленного превращаются в узкие щелочки, его рука тянется к кинжалу на боку. Похоже, он готов позвать других стражников. ~
@4122 = ~Ты наклоняешься, чтобы «шепнуть» ему что-то на ухо, и тленный тоже наклоняется. Как только он оказывается на расстоянии вытянутой руки, ты хватаешь его за виски и резко сворачиваешь голову влево.~
@4123 = ~Тленный не успевает и слова вымолвить, как твои руки хватают его голову за виски и резко сворачивают ее влево. ~
@4124 = ~В шее раздается характерный хруст, и тело тленного безвольно падает в твои объятия.~
@4125 = ~К своему удивлению, это действие происходит практически инстинктивно, будто ты проделывал это уже много раз... с этой мыслью всплывает воспоминание, но оно недостаточно сильно для того, чтобы за него зацепиться.~
@4126 = ~Ты недостаточно быстр, и тленный уворачивается от твоего выпада. Отступив на шаг, он быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@4127 = ~Тленный быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон железного колокола.~
@4128 = ~Тленный хмурится, когда ты обращаешься к нему. «Что ты здесь делаешь?»~
@4129 = ~Перед тобой строгий мужчина в черной мантии. Он смотрит прямо вперед. Похоже, он даже не заметил тебя.~
@4130 = ~Когда ты обращаешься к стражнику тленных, он аж подскакивает от неожиданности, затем отступает на шаг. «Ты не зомби... кто ты... и как ты сюда попал?» ~
@4131 = ~Перед тобой строгий мужчина в черной мантии. Завидев тебя, он кивает.~
@4132 = ~«Приветствую, посвященный».~
@4133 = ~«В вестибюле есть проводники. Они могут помочь тебе сориентироваться, посвященный».~
@4134 = ~«Эй! Эй! Что ты делаешь?»~
@4135 = ~«Если ты собираешься трясти черепушкой с трухлявыми, то, пожалуйста, без меня. Я с ними не в лучших отношениях... и тебе не стоит с ними родниться. Они скорее спалят тебя или заживо зароют, чем будут слушать. Не валяй дурака, давай выбираться отсюда».~
@4136 = ~«Эй! Ты оглох, что ли? Ты что творишь?»~
@4137 = ~«Тогда *не слушай* меня больше — тебя похоронят».~
@4138 = ~«Да-да, а ты сможешь поплакаться на панихиде. А пока — умолкни».~
@4139 = ~«А, ты прав. Забудь об этом. Идем».~
@4140 = ~«Слушай, я хочу поговорить с этим парнем. Проблемы?»~
@4141 = ~«Ничего. Идем».~
@4142 = ~«Спасибо за совет, но я *все еще* хочу поговорить с этим парнем».~
@4143 = ~«Согласен. Идем».~
@4144 = ~«Я *хотел* поговорить с этим парнем. Проблемы?»~
@4145 = ~«Ничего. Идем».~
@4146 = ~Попробовать не обращать на него внимания, пройти мимо.~
@4147 = ~«Ничего. Я потерялся, но теперь направляюсь к выходу».~
@4148 = ~«Зови своих друзей, трухлячок... Я их с радостью встречу».~
@4149 = ~Убежать.~
@4150 = ~Подождать.~
@4151 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4152 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4153 = ~«Зови своих друзей, трухлячок... Я их с радостью встречу».~
@4154 = ~Убежать.~
@4155 = ~Подождать.~
@4156 = ~«Нельзя дать тебе предупредить своих друзей...»~
@4157 = ~«Нельзя дать тебе предупредить своих друзей...»~
@4158 = ~«Лучше ты, чем я, трухлявый». ~
@4159 = ~«Лучше ты, чем я, трухлявый». ~
@4160 = ~Затащить тело в тень и уйти.~
@4161 = ~«Надеюсь, ты поладишь со своими богами, тленный...»~
@4162 = ~«Надеюсь, ты поладишь со своими богами, тленный...»~
@4163 = ~«Кажется, я заблудился в этих залах. Здесь есть проводники, которые могут подсказать дорогу посетителям?»~
@4164 = ~«Я... кажется, потерялся». ~
@4165 = ~«Это мое личное дело. А тебе бы не мешало заниматься СВОИМИ делами, тленный».~
@4166 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем свернуть ему шею.~
@4167 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем свернуть ему шею.~
@4168 = ~«Я направляюсь к выходу, только и всего. Я не хочу создавать проблем».~
@4169 = ~«Ничего. Я потерялся, но теперь направляюсь к выходу».~
@4170 = ~«Приветствую».~
@4171 = ~Проковылять мимо.~
@4172 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4173 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4174 = ~«Я все могу объяснить... видишь ли, все началось с того, что я пробудился из мертвых на одной из ваших плит... там был говорящий череп, и...»~
@4175 = ~Убежать.~
@4176 = ~«Приветствую».~
@4177 = ~Кивнуть в ответ, идти дальше.~
@4178 = ~«Возможно, ты сможешь мне помочь. Кажется, я потерялся. Ты можешь показать мне дорогу?»~
