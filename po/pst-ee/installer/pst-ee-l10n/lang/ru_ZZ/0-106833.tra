@37086 = ~Инвентарь полон, предмет выброшен [Vhailor]~ [VHA196]
@37087 = ~Цель невосприимчива к оружию [Namless One]~ [NAM207]
@37088 = ~Цель невосприимчива к оружию [Morte]~ [MRT453G]
@37089 = ~Цель невосприимчива к оружию [Annah]~ [ANA560B]
@37090 = ~Цель невосприимчива к оружию [Dak'kon]~ [DAK201]
@37091 = ~Цель невосприимчива к оружию [Fall-From-Grace]~ [FFG314]
@37092 = ~Цель невосприимчива к оружию [Nordom]~ [NOR281]
@37093 = ~Цель невосприимчива к оружию [Ignus]~ [IGN246]
@37094 = ~Цель невосприимчива к оружию [Vhailor]~ [VHA253]
@37095 = ~Восстановлена память [Nameless One only]~ [NAM077]
@37096 = ~Дневник обновлен [Nameless One only]~ [NAM157]
@37097 = ~Маскировка сброшена~
@37098 = ~Надпись: «Наконец-то я тебя поймал. Ты больше не будешь мучить меня, потому что никто из смертных не способен покинуть эти стены. Ищи ключи и находи смерть в каждом из них. Только тогда ты освободишься».~
@37099 = ~Шкаф~
@37100 = ~Перед тобой девушка с бледным желтоватым оттенком кожи. Она деловито осматривает товары в ящике.~
@37101 = ~Оглянувшись через плечо, она поворачивается: «Ага, и тебе тоже. Чего хотел?»~
@37102 = ~Она выглядит немного раздраженной, но все же приветливо улыбается. «Помогу, чем смогу. Что ты хочешь узнать?»~
@37103 = ~Ее глаза расширяются, она быстро проводит полукруг над сердцем. «Ничем не могу помочь. Говорят, что он в этом районе, но где именно — я не знаю».~
@37104 = ~Она обеспокоена. «Не, рубака. Никому не нужны неприятности, и никто не ищет их специально».~
@37105 = ~Нахмурившись, она обеспокоенно смотрит на тебя. «Ага, я слышала о том, кто это мог сделать, но помочь в этом не смогу».~
@37106 = ~Подумав секунду, она пожимает плечами: «Спроси парня у печи. Ему нравится общаться с людьми. Может быть, он слышал что-нибудь».~
@37107 = ~Она кивает на прилавки: «Анце ими торгует. Поговори с ним насчет этого».~
@37108 = ~Она кивает на прилавки: «Аалек знает толк в Искусстве. Поговори с ним насчет этого».~
@37109 = ~Она хмурится. «Не хочу казаться грубой, но у меня нет времени на разговоры. Спроси парня у печи. Он вечно разговаривает с незнакомцами».~
@37110 = ~С улыбкой на лице она оборачивается к тебе: «И снова здравствуй, рубака. Что тебе нужно?»~
@37111 = ~«Приветствую».~
@37112 = ~Игнорировать ее.~
@37113 = ~«У меня есть несколько вопросов...» ~
@37114 = ~«Неважно, прощай».~
@37115 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@37116 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@37117 = ~«Где я могу купить оружие?»~
@37118 = ~«Где я могу купить магические предметы?»~
@37119 = ~«Неважно. Прощай».~
@37120 = ~«А ты знаешь, кто может знать?»~
@37121 = ~«Хорошо. У меня есть еще вопросы...»~
@37122 = ~«Прощай».~
@37123 = ~«У меня есть другие вопросы...»~
@37124 = ~«Прощай».~
@37125 = ~«А не знаешь кого-нибудь, кто может?»~
@37126 = ~«У меня есть другие вопросы...»~
@37127 = ~«Прощай».~
@37128 = ~«У меня есть другие вопросы...»~
@37129 = ~«Прощай».~
@37130 = ~«У меня есть другие вопросы...»~
@37131 = ~«Прощай».~
@37132 = ~«У меня есть другие вопросы...»~
@37133 = ~«Прощай».~
@37134 = ~«Отлично. Прощай».~
@37135 = ~«У меня есть несколько вопросов...» ~
@37136 = ~«Прощай».~
@37137 = ~Перед тобой старая женщина в простой одежде, с бледно-желтой выветренной кожей. Она скучающе смотрит на тебя.~
@37138 = ~«И тебе привет, сынок. Что тебе нужно от старой Беллы?»~
@37139 = ~Она хмурится, ее лицо почти теряется под сетью морщин: «У меня есть немного времени, так что давай побыстрее».~
@37140 = ~«Лотар... что-то не припомню никого с таким именем».~
@37141 = ~«Нет». Она качает головой, скучающе глядя на тебя.~
@37142 = ~«Череп, значит, потерял... — она громко смеется. — Не могу сказать, что раньше слышала такое. Не знаю, что и сказать даже».~
@37143 = ~Она вздыхает. «Слушай, сынок. Я сюда пришла за покупками, а ты не продавец. Чуешь, куда я клоню?»~
@37144 = ~«А у меня нет больше ответов. Всего хорошего». Она отворачивается от тебя.~
@37145 = ~Перед тобой старая женщина в простой одежде, с бледной желтоватой и выветренной кожей. Она скучающе смотрит на тебя. «Почему ты продолжаешь докучать? Уходи!» Она отворачивается.~
@37146 = ~«Приветствую».~
@37147 = ~Игнорировать ее.~
@37148 = ~«У меня есть несколько вопросов...» ~
@37149 = ~«Ничего. Прощай».~
@37150 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@37151 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@37152 = ~«Можешь рассказать об этом районе?»~
@37153 = ~«Неважно. Прощай».~
@37154 = ~«Понятно. А ты не знаешь, кто может помочь мне?»~
@37155 = ~«Прощай».~
@37156 = ~«У меня есть другие вопросы...»~
@37157 = ~«Прощай».~
@37158 = ~«Понятно. А ты не знаешь, кто может помочь мне?»~
@37159 = ~«Прощай».~
@37160 = ~«У меня есть другие вопросы...»~
@37161 = ~«Понятно. Прощай».~
@37162 = ~«Прощай».~
@37163 = ~Уйти.~
@37164 = ~Перед тобой привлекательная девушка, одетая в хорошую одежду. Она бесцельно бродит, просто рассматривая товары на продажу.~
@37165 = ~Она хмуро осматривает тебя сверху донизу. «Я не связываюсь лицами сомнительного происхождения, к коим, судя по виду, ты идеально подходишь. Проваливай, пень».~
@37166 = ~Нахмурившись еще сильнее, она кладет руки на бедра. «Мне все равно, пень. Оставь меня, или я позову стражу!»~
@37167 = ~Она показывает тебе неприличный жест. «Ну хорошо... Стража! Стража!»~
@37168 = ~Повернувшись к тебе лицом, она тот час же узнает тебя. Она хмуро произносит: «Что нужно сделать, чтобы ты отвязался от меня, пень?»~
@37169 = ~Она показывает тебе неприличный жест. «Я не собираюсь отвечать на твои тупые вопросы. Найди себе седобородого, — она отмахивается от тебя. — А теперь оставь меня в покое, или я позову стражу!»~
@37170 = ~Повернувшись к тебе лицом, она тот час же узнает тебя. Она хмуро произносит: «Что нужно сделать, чтобы ты отвязался от меня, пень?» Она со вздохом вскидывает руки. «Я уже звала стражу, я смогу это сделать еще раз... и, кажется, это придется сделать».~
@37171 = ~«Приветствую».~
@37172 = ~Игнорировать ее.~
@37173 = ~«У меня есть несколько вопросов...» ~
@37174 = ~«Хорошо, прощай».~
@37175 = ~~
@37176 = ~~
@37177 = ~~
@37178 = ~Уйти до того, как они придут.~
@37179 = ~«Если бы смог задать пару вопросов...»~
@37180 = ~«Прошу прощения, я ухожу. Прощай».~
@37181 = ~«Зови...»~
@37182 = ~«Хорошо, прощай».~
@37183 = ~«Зови...»~
@37184 = ~«Хорошо, прощай».~
@37185 = ~Перед тобой ничем не примечательная женщина. Кажется, она всего лишь одна из покупательниц на рынке.~
@37186 = ~Она поворачивается на твое приветствие: «Да?..»~
@37187 = ~С скукой на лице она отвечает: «Хорошо...»~
@37188 = ~«Никогда не слышала о нем. Иначе я бы вспомнила титул *Повелитель Костей*. Такое вряд ли забудешь». Она все еще смотрит на тебя со скучающим лицом.~
@37189 = ~Она пялится на тебя некоторое время. «Череп потерял... такое не каждый день услышишь. Не знаю даже, что можно сказать». Она пожимает плечами.~
@37190 = ~Скучающим взглядом она окидывает рынок. «Да прямо здесь, рубака. Просто порасспрашивай торговцев. Уверена, что ты найдешь то, что тебе нужно».~
@37191 = ~«Да не так уж много... — она вздыхает, — но это дом, кроме которого я, да и многие другие, не знают ничего больше. Приходится любить его, раз отсюда не выбраться».~
@37192 = ~Она хмурится при твоем приближении. «Я уже потратила на тебя свое время. Больше не могу». Она отворачивается от тебя.~
@37193 = ~«Приветствую».~
@37194 = ~Игнорировать ее.~
@37195 = ~«У меня есть несколько вопросов...» ~
@37196 = ~«Неважно».~
@37197 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@37198 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@37199 = ~«Где я могу купить оружие?»~
@37200 = ~«Где я могу купить магические предметы?»~
@37201 = ~«Что ты можешь рассказать об этом районе?»~
@37202 = ~«Неважно. Прощай».~
@37203 = ~«У меня есть еще вопросы...»~
@37204 = ~«Прощай».~
@37205 = ~«У меня есть еще вопросы...»~
@37206 = ~«Прощай».~
@37207 = ~«У меня есть еще вопросы...»~
@37208 = ~«Прощай».~
@37209 = ~«У меня есть еще вопросы...»~
@37210 = ~«Прощай».~
@37211 = ~Уйти.~
@37212 = ~Перед тобой юноша с бледным желтоватым оттенком кожи. Он деловито осматривает товары в ящике.~
@37213 = ~Оглянувшись через плечо, он поворачивается: «Ага, и тебе тоже. Чего хотел?»~
@37214 = ~Он выглядит раздраженным, но все же приветливо улыбается. «Помогу, чем смогу. Что ты хочешь узнать?»~
@37215 = ~Его глаза расширяются, он быстро проводит полукруг над сердцем. «Ничем не могу помочь. Говорят, что он в этом районе, но где именно — я не знаю».~
@37216 = ~Он обеспокоен. «Не, рубака. Никому не нужны неприятности, и никто не ищет их специально».~
@37217 = ~Нахмурившись, он обеспокоенно смотрит на тебя. «Ага, я слышал о том, кто это мог сделать, но помочь в этом не смогу. ~
@37218 = ~Подумав секунду, он пожимает плечами: «Спроси Лазло у печи. Ему нравится общаться с людьми. Может, он слышал что-нибудь».~
@37219 = ~Он кивает на прилавки: «Анце ими торгует. Поговори с ним насчет этого».~
@37220 = ~Он кивает на прилавки: «Аалек знает толк в Искусстве. Поговори с ним насчет этого».~
@37221 = ~Он хмурится. «Слушай, рубака, не хочу казаться грубым, но у меня нет времени на разговоры. Спроси Лазло у печи. Он вечно разговаривает с незнакомцами».~
@37222 = ~С улыбкой на лице он оборачивается к тебе: «И снова здравствуй, рубака. Что тебе нужно?»~
@37223 = ~«У меня есть несколько вопросов...» ~
@37224 = ~«У меня есть несколько вопросов...» ~
@37225 = ~«У меня есть несколько вопросов...» ~
@37226 = ~«Приветствую».~
@37227 = ~Игнорировать его.~
@37228 = ~«Неважно, прощай».~
@37229 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@37230 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто мог это сделать?»~
@37231 = ~«Где я могу купить оружие?»~
@37232 = ~«Где я могу купить магические предметы?»~
@37233 = ~«Что ты можешь рассказать об этом районе?»~
@37234 = ~«Неважно. Прощай».~
@37235 = ~«А ты знаешь, кто может знать?»~
@37236 = ~«Хорошо. У меня есть еще вопросы...»~
@37237 = ~«У меня есть другие вопросы...»~
@37238 = ~«Прощай».~
@37239 = ~«А не знаешь кого-нибудь, кто может?»~
@37240 = ~«У меня есть другие вопросы...»~
@37241 = ~«У меня есть другие вопросы...»~
@37242 = ~«Прощай».~
@37243 = ~~
@37244 = ~«У меня есть другие вопросы...»~
@37245 = ~«У меня есть другие вопросы...»~
@37246 = ~«Прощай».~
@37247 = ~«Отлично. Прощай».~
@37248 = ~«Прощай».~
@37249 = ~Перед тобой старик в простой одежде, с бледной желтоватой и выветренной кожей. Он скучающе смотрит на тебя.~
@37250 = ~«И тебе привет, сынок. Что тебе нужно от меня?»~
@37251 = ~Он хмурится, его лицо почти теряется под сетью морщин: «У меня есть немного времени, так что давай побыстрее».~
@37252 = ~«Лотар... что-то не припомню никого с таким именем. Ничем не могу помочь. Поспрашивай еще кого — может, кто знает».~
@37253 = ~«Неа. Мы простые люди и не суем свой нос в такие вещи». Он качает головой, скучающе глядя на тебя.~
@37254 = ~«Череп, значит, потерял... — он громко смеется. — Не могу сказать, что раньше слышал такое. Не знаю, что и сказать даже».~
@37255 = ~Он устало вздыхает. «Слушай, сынок. Я сюда пришел за покупками, а ты не продавец. Чуешь, куда я клоню? Если нет, то проваливай!»~
@37256 = ~«А у меня нет больше ответов. Всего хорошего». Он отворачивается от тебя.~
@37257 = ~Перед тобой старик в простой одежде, с бледной желтоватой и выветренной кожей. Он скучающе смотрит на тебя. «Опять ты? Проваливай от меня!» Он отворачивается.~
@37258 = ~Уйти.~
@37259 = ~Ты находишься слишком далеко, чтобы разглядеть этот предмет.~
@37260 = ~«Приветствую».~
@37261 = ~Игнорировать его.~
