@28157 = ~«Прощай».~
@28158 = ~Эта привлекательная молодая женщина наблюдает за игрой двух актеров.~
@28159 = ~Женщина поворачивается к тебе, но ее внимание все еще поглощено действиями актеров. Она негромко произносит: «Рада встрече, сэр. Вы давно смотрите? Тот, что слева, неплох, но его партнеру неплохо бы прорепетировать побольше, вам не кажется?»~
@28160 = ~Женщина лишь кивает в ответ, внимательно смотря на актеров.~
@28161 = ~Нахмурившись, она тихо отвечает: «Я наслаждаюсь представлением, сэр. Помолчите, пожалуйста».~
@28162 = ~Она продолжает говорить тихим, но уже более напряженным тоном: «Я прошу вас сохранять тишину, сэр. Или же покиньте это место, иначе я буду вынуждена позвать стражников».~
@28163 = ~Женщина кивает в знак приветствия, но всем своим видом указывает замолчать.~
@28164 = ~«Приветствую...»~
@28165 = ~Оставить женщину в покое.~
@28166 = ~«Я не уверен в этом».~
@28167 = ~«Да, он неважный актер».~
@28168 = ~«Нет, мне кажется, что он хороший актер».~
@28169 = ~«Тогда неважно... У меня есть несколько вопросов...»~
@28170 = ~«У меня есть несколько вопросов...» ~
@28171 = ~Уйти.~
@28172 = ~«Всего лишь несколько вопросов...»~
@28173 = ~Уйти.~
@28174 = ~«Отлично, зови их».~
@28175 = ~Уйти.~
@28176 = ~«У меня есть несколько вопросов...» ~
@28177 = ~Этот джентльмен увлеченно наблюдает за игрой двух актеров.~
@28178 = ~«Приветствую...»~
@28179 = ~Мужчина поворачивается к тебе, но его внимание все еще поглощено действиями актеров. Он негромко произносит: «Да-да, приветствую. Что вы об этом думаете? Тот, что справа, неплох, но его партнеру неплохо бы прорепетировать побольше, вам не кажется?»~
@28180 = ~«Я не уверен в этом».~
@28181 = ~«Хм-м-м». Мужчина возвращается к наблюдению за актерами.~
@28182 = ~«У меня есть несколько вопросов...» ~
@28183 = ~Нахмурившись, он тихо отвечает: «Не сейчас. Я слежу за представлением. Прощайте, сэр».~
@28184 = ~«Всего лишь несколько вопросов...»~
@28185 = ~Он продолжает говорить тихим, но уже более напряженным тоном: «Нет. Оставьте меня, сэр, иначе я вынужден буду позвать стражников».~
@28186 = ~«Отлично, зови их».~
@28187 = ~Уйти.~
@28188 = ~Уйти.~
@28189 = ~Уйти.~
@28190 = ~«Да, он неважный актер».~
@28191 = ~«Нет, мне кажется, что он хороший актер».~
@28192 = ~«Тогда неважно... У меня есть несколько вопросов...»~
@28193 = ~Оставить мужчину в покое.~
@28194 = ~Мужчина кивает в знак приветствия, но всем своим видом указывает замолчать.~
@28195 = ~«У меня есть несколько вопросов...» ~
@28196 = ~Эта привлекательная девушка увлеченно слушает декламирующего пожилого поэта.~
@28197 = ~«Приветствую...»~
@28198 = ~Девушка поворачивается к тебе, однако поэт по-прежнему занимает ее внимание. Она тихо говорит: «Я прошу вас говорить потише, сэр». Она кивает на поэта. «Не классика, конечно, но у этого старика *есть* потенциал».~
@28199 = ~«Я не уверен в этом».~
@28200 = ~Девушка медленно кивает, продолжая внимательно смотреть на поэта.~
@28201 = ~«У меня есть несколько вопросов...» ~
@28202 = ~Хмурясь, она тихо произносит: «Не сейчас, сэр. Проявите уважение к поэту и сохраняйте тишину... Прощайте».~
@28203 = ~«Всего лишь несколько вопросов...»~
@28204 = ~Она по-прежнему говорит тихо, но в ее голосе появляются угрожающие нотки. «Не время и не место для вопросов, сэр. Оставьте меня, или я позову стражников».~
@28205 = ~«Отлично, зови их».~
@28206 = ~Уйти.~
@28207 = ~Уйти.~
@28208 = ~Уйти.~
@28209 = ~«Да, поэт он неважный».~
@28210 = ~Этот джентльмен увлеченно слушает декламирующего пожилого поэта.~
@28211 = ~«Приветствую...»~
@28212 = ~Оставить мужчину в покое.~
@28213 = ~Мужчина поворачивается к тебе, но его внимание все еще занимает поэт. Он тихо отвечает: «Взаимно». На секунду он умолкает, затем шепотом отвечает: «Не самое лучшее стихотворение из тех, что я слышал, но ведь не так уж и плохо, а?»~
@28214 = ~«Я не уверен в этом».~
@28215 = ~«Да, поэт он неважный».~
@28216 = ~«Нет, мне кажется, что он хороший поэт».~
@28217 = ~«Тогда неважно... У меня есть несколько вопросов...»~
@28218 = ~«Хм-м-м». Мужчина кивает и продолжает следить за старым поэтом.~
@28219 = ~«У меня есть несколько вопросов...» ~
@28220 = ~Уйти.~
@28221 = ~Нахмурившись, он тихо отвечает: «Нет, сэр, не сейчас. Я слушаю стихи. Прощайте, сэр».~
@28222 = ~«Всего лишь несколько вопросов...»~
@28223 = ~Уйти.~
@28224 = ~В его тихом голосе появляются угрожающие нотки. «Либо не шумите, либо уходите, сэр, иначе я вынужден буду позвать стражников».~
@28225 = ~«Отлично, зови их».~
@28226 = ~Уйти.~
@28227 = ~Мужчина кивает в знак приветствия, но всем своим видом указывает замолчать.~
@28228 = ~«У меня есть несколько вопросов...» ~
@28229 = ~Перед тобой сногсшибательная женщина с золотистыми кудрями, одетая в лазурно-фиолетовое платье, с двумя длинными элегантными крыльями, ниспадающими с ее плеч. Она обводит взглядом комнату с легкой улыбкой на губах... Пожалуй, она самая красивая женщина из всех, что ты когда-либо встречал. ~
@28230 = ~«Приветствую...»~
@28231 = ~Не обращать внимания на женщину с крыльям, обследовать здание.~
@28232 = ~~
@28233 = ~Когда ты подходишь, Падшая Грация поворачивается к тебе и слегка улыбается. «Чем я могу тебе помочь?»~ [FFG002]
@28234 = ~«Я хотел бы задать тебе несколько вопросов...»~
@28235 = ~«Извини за беспокойство. Прощай».~
@28236 = ~«Да?»~
@28237 = ~«Еще раз, кто ты?»~
@28238 = ~«Те крылья на твоей спине... Кто ты такая?»~
@28239 = ~«Те крылья на твоей спине... Кто ты такая?»~
@28240 = ~«Те крылья на твоей спине... Кто ты такая?»~
@28241 = ~«Могу ли я спросить, госпожа Грация: крылья на твоей спине... ты ведь не человек, верно?»~
@28242 = ~«Могу ли я спросить, госпожа Грация: крылья на твоей спине... ты ведь не человек, верно?»~
@28243 = ~«Могу ли я спросить, госпожа Грация: крылья на твоей спине... ты ведь не человек, верно?»~
@28244 = ~«Что это за место?»~
@28245 = ~«Я пришел за помощью. Возможно, ты сможешь мне помочь».~
@28246 = ~«Что ты можешь рассказать о здешних девушках?»~
@28247 = ~«Что ты можешь рассказать о чувствующих?»~
@28248 = ~«Доводилось ли тебе слышать о ночной ведьме по имени Равель?»~
@28249 = ~«Можешь еще раз сказать, что ты знаешь о Равель?»~
@28250 = ~«Что ты знаешь о Кровавой войне?»~
@28251 = ~«Я поговорил с девятью учениками, как ты и попросила... но десятого я так и не нашел».~
@28252 = ~«Не желаешь присоединиться ко мне в моих странствиях?»~
@28253 = ~«Не желаешь присоединиться ко мне в моих странствиях?»~
@28254 = ~«Не желаешь присоединиться ко мне в моих странствиях?»~
@28255 = ~«Не желаешь присоединиться ко мне в моих странствиях?»~
@28256 = ~В ответ на твой голос женщина поворачивается к тебе. Окинув тебя взглядом, она легонько кивает... Ты замечаешь, что глаза у нее лазурные, в тон ее платью. «Рада встрече, путник, — она откидывает назад непослушную прядь золотистых волос. — Чем я могу тебе помочь?»~ [FFG004]
@28257 = ~«Кто ты?»~
@28258 = ~«Пока ничем, спасибо. Прощай».~
@28259 = ~«Меня зовут Падшей Грацией, — секунду она рассматривает тебя. — Ты в Сигиле недавно, не так ли?»~
@28260 = ~«Да. Это так заметно?»~
@28261 = ~«Нет, на самом деле, у меня есть подозрение, что я здесь уже довольно давно».~
@28262 = ~«Падшая Грация... какое интересное имя».~
@28263 = ~«Я не хотел бы сейчас это обсуждать. Прощай».~
@28264 = ~«Мне зовут Падшая Грация, — она еле заметно улыбается. — Разве ты меня уже забыл?»~
@28265 = ~«Госпожа Грация, могу уверить, что тебе не стоит опасаться того, что я тебя забуду. Ты *совершенно* незабываемая».~
@28266 = ~«Госпожа Грация, могу уверить, что тебе не стоит опасаться того, что я тебя забуду. Ты *совершенно* незабываемая».~
@28267 = ~«Вовсе нет».~
@28268 = ~«Падшая Грация... какое интересное имя».~
@28269 = ~«Нет. Могу ли я задать тебе еще пару вопросов?»~
@28270 = ~«Может и так. Прощай».~
@28271 = ~Падшая Грация мрачнеет, поглядывая на вас двоих. «Я никого не хотела обидеть. Простите меня за колкость».~
@28272 = ~«Ничего страшного, не нужно извинений, моя госпожа. Могу ли я задать тебе другие вопросы?»~
@28273 = ~«Как бы то ни было, лучше уж нам уйти. Прощай, госпожа Грация».~
@28274 = ~Она тихонько смеется. Улыбаясь, она говорит: «Хорошо, я прощаю тебя».~
@28275 = ~«Падшая Грация... какое интересное имя».~
@28276 = ~«Могу ли я задать тебе другие вопросы?»~
@28277 = ~«Я должен идти. Прощай».~
@28278 = ~Она слегка улыбается. «Не так сильно, как это можно подумать. Ты держишься очень достойно».~
@28279 = ~«Что это за место?»~
@28280 = ~«Я должен идти. Прощай».~
@28281 = ~Она кивает. «Я рада, что оно тебе понравилось. Однако я уверена, что ты проделал весь этот путь не за тем, чтобы польстить мне. Чем я могу тебе помочь?»~
@28282 = ~«Что это за место?»~
@28283 = ~«На этот раз — ничем. Прощай».~
@28284 = ~«Это *Бордель утоления интеллектуальной страсти*, — она внимательно смотрит на тебя. — Судя по твоему вопросу, ты не собирался пользовался услугами этого заведения?»~
@28285 = ~«Бордель утоления интеллектуальной страсти? Что это за бордель такой?»~
@28286 = ~«Бордель утоления интеллектуальной страсти? Что это за бордель такой?»~
@28287 = ~«Нет, не думаю. Прощай».~
@28288 = ~«Это Бордель утоления интеллектуальной страсти».~
@28289 = ~«Бордель утоления интеллектуальной страсти? Что это за бордель такой?»~
@28290 = ~«Бордель утоления интеллектуальной страсти? Что это за бордель такой?»~
@28291 = ~«О, понятно. Могу ли я задать тебе другие вопросы?»~
@28292 = ~«О, понятно. Можно задать тебе еще пару вопросов?»~
@28293 = ~«Просто было любопытно. Спасибо за информацию. Прощай».~
@28294 = ~«Я основала этот бордель не для плотских утех, а скорее чтобы дать выход тому сладострастному волнению, которое охватывает умы. Можно получить немало удовольствия, общаясь или соревнуясь с другими в искусстве говорить».~
@28295 = ~«Могу уверить тебя, это не так. Пройдись по борделю, убедись в этом сам».~
@28296 = ~«Так это бордель... где нет сношений?»~
@28297 = ~«Не могу не спросить: зачем ты основала подобное заведение?»~
@28298 = ~«Пожалуй, так и сделаю. Можно сперва задать тебе пару вопросов?»~
@28299 = ~«Хорошо, я так и сделаю. Прощай».~
@28300 = ~«Я основала этот бордель не для плотских утех, а скорее чтобы дать выход тому сладострастному волнению, которое охватывает умы. Можно получить немало удовольствия, общаясь или соревнуясь с другими в искусстве говорить».~
@28301 = ~«Так это бордель... где нет сношений?»~
@28302 = ~«Не могу не спросить: зачем ты основала подобное заведение?»~
@28303 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28304 = ~«Спасибо за объяснение... Мне нужно идти. Прощай».~
@28305 = ~«Есть, но только психологической природы. Могу уверить — это очень возбуждает».~
@28306 = ~«Не могу не спросить: зачем ты основала подобное заведение?»~
@28307 = ~«Могу ли я задать тебе другие вопросы?»~
@28308 = ~«Тогда я, пожалуй, пройдусь по борделю. Прощай».~
@28309 = ~Падшая Грация поднимает бровь. «Очень странный вопрос, — хмурится она. — Даже не знаю, задавал ли мне его кто-нибудь. По крайней мере, прямо».~
@28310 = ~«Прошу прощения, госпожа Грация. Я не хотел быть настолько прямолинейным. Мне было просто любопытно».~
@28311 = ~«Так... почему же?»~
@28312 = ~«Просто довольно странно, чтобы суккуб основал подобное заведение... Предназначение этого места противоречит твоему естеству».~
@28313 = ~«Могу ли я задать тебе другие вопросы?»~
@28314 = ~«Тогда я, пожалуй, пройдусь по борделю. Прощай».~
@28315 = ~«О, не нужно извинений. Я с большим удовольствием сообщу тебе причины, если хочешь».~
@28316 = ~«Да, я бы хотел их услышать».~
@28317 = ~«Просто довольно странно, чтобы суккуб основал подобное заведение... Предназначение этого места противоречит твоему естеству».~
@28318 = ~«Не сейчас. Могу ли я задать тебе другие вопросы?»~
@28319 = ~«Может быть, в следующий раз. Мне нужно идти. Прощай».~
@28320 = ~«Чтобы частично ответить на твой вопрос, тебе следует знать, что я состою в Обществе Восприятия. Наша фракция верит, что каждому необходимо пережить как можно больше всего в мультивселенной».~
@28321 = ~«И именно поэтому ты основала это заведение?»~
@28322 = ~«Понятно. Нет нужды объяснять остальное. Можно задать тебе другие вопросы?»~
@28323 = ~«Тогда я, пожалуй, пройдусь по борделю. Прощай».~
@28324 = ~«Этот бордель призван утолять страсть даже самых заядлых интеллектуалов. Он предназначен для стимуляции разума, повышения знания о себе и других, создания новых способов *познания* другого. Он для тех, кто ищет нечто большее, нежели низменные телесные удовольствия, которых и так достаточно в Улье и Нижнем районе».~
@28325 = ~«Ну, я бы не стал называть их низ... э-э-э, то есть, я могу это понять. Должно бы, девушки здесь действительно особенные».~
@28326 = ~«Понятно. Значит, это заведение поощряет интеллектуальные дуэли, а не, эм, ну, *другие* виды дуэлей. Должно бы, девушки здесь действительно особенные».~
@28327 = ~«Могу ли я задать тебе другие вопросы?»~
@28328 = ~«Тогда я, пожалуй, пройдусь по борделю. Прощай».~
@28329 = ~«Здешние девушки стремятся стать чувствующими. Они пришли ко мне за наставлениями, чтобы подготовиться к вступлению во фракцию. Кроме того, у большинства из них врожденный талант к разговорам, способный разбить скорлупу даже самых загрубевших личностей».~
@28330 = ~«Чувствующие?»~
@28331 = ~~
@28332 = ~«Понятно. Значит, здешние дамы, иначе говоря, являются практикантками?»~
@28333 = ~«Могу ли я задать тебе другие вопросы?»~
@28334 = ~«Тогда я, пожалуй, пройдусь по борделю. Прощай».~
@28335 = ~Она слегка кивает. «Да, я состою в Обществе Восприятия. Наша фракция верит, что каждому необходимо пережить как можно больше всего в мультивселенной».~
@28336 = ~«И здешние девушки готовятся стать чувствующими?»~
@28337 = ~«Понятно. Нет нужды объяснять остальное. Можно задать тебе другие вопросы?»~
@28338 = ~«Тогда я, пожалуй, пройдусь по борделю. Прощай».~
@28339 = ~«Скорее всего, не все из них пройдут. Тем не менее, их попытки приветствуются, и я не откажу им в возможности присоединится к фракции, если таково их желание. В ходе они могут чему-нибудь научиться».~
@28340 = ~«Понятно. Так это нечто вроде подготовительной школы?»~
@28341 = ~«Могу ли я задать тебе другие вопросы?»~
@28342 = ~«Пожалуй, я пройдусь по борделю и сам все увижу. Прощай».~
@28343 = ~«Да. Я надеюсь, изучение искусства общения и его тонкостей позволит посетителям и ученикам лучше себя узнать. Каждый ограничен лишь своим владением речью. Умение с помощью слов вызывать эмоции — колоссальный навык».~
@28344 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28345 = ~«Пожалуй, я пройдусь по борделю и сам все увижу. Прощай».~
@28346 = ~[no text]~
@28347 = ~«Твой спутник прав. Я — низшая танарри, а точнее, суккуб, — она тихонько вздыхает. — Боюсь, что мы уж слишком распространенные на Нижних планах и в других местах, что не в нашу пользу. Большинство представителей моей расы проводят свое время, соблазняя смертных различными плотскими утехами».~
@28348 = ~«А ты?..»~
@28349 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28350 = ~«Я должен идти. Прощай».~
@28351 = ~«Да. Я должен идти. Прощай».~
@28352 = ~«Чувствующие — это фракция Сигила, посвященная переживаниям. Без переживаний и ощущений большая часть мультивселенной для нас недоступна. Поэтому чувствующие стремятся пережить как можно больше: пережив все на свете, можно раскрыть истину мультивселенной».~
@28353 = ~«Интересная философия. Могу ли я присоединиться к чувствующим?»~
@28354 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28355 = ~«Может, оно и так. Как бы там ни было, мне пора. Прощай».~
@28356 = ~«Чтобы присоединиться к чувствующим, достаточно быть учеником жизни».~
@28357 = ~«Я имел в виду, что хотел бы присоединиться к фракции».~
@28358 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28359 = ~«Хорошо. Я должен идти. Прощай».~
@28360 = ~«Конечно... прости, что поддразниваю, — Грация кивает. — Если желаешь присоединиться к чувствующим — попытай счастья в Городском Фестхолле. Кто-нибудь там должен тебе помочь».~
@28361 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28362 = ~«Спасибо. Тогда туда и направлюсь. Прощай».~
@28363 = ~«Ну... — она слегка улыбается. — Это довольно прямолинейно с твоей стороны».~
@28364 = ~«Я хочу быть откровенным в своих намерениях. Ты невероятно мила и хорошо осведомлена по части планов. Компаньону с подобными знаниями я всегда буду рад».~
@28365 = ~«Я хочу быть откровенным в своих намерениях. Ты невероятно мила и хорошо осведомлена по части планов. Компаньону с подобными знаниями я всегда буду рад».~
@28366 = ~«Я такой, какой я есть».~
@28367 = ~«То есть, насколько волнующими может быть это место?»~
@28368 = ~«Ты ведь чувствующая. Несомненно, должен быть какой-то предел тому, что ты можешь здесь познать».~
@28369 = ~«Забудем о моей просьбе. Можно задать еще пару вопросов?»~
@28370 = ~«Тогда прими мои извинения. Я должен идти. Прощай».~
@28371 = ~«Я ценю твою прямоту. Отвечу своим вопросом: зачем мне путешествовать с тобой?»~
@28372 = ~«То есть, тебе было бы неинтересно путешествовать с забывшим все бессмертным, который ищет себя по всем планам?»~
@28373 = ~«Госпожа Грация, я намерен отправиться в места, в которых, наверное, еще никто не бывал... или не мог добраться. Тебя бы это заинтересовало?»~
@28374 = ~«Насколько волнующими может быть это место?»~
@28375 = ~«Ты ведь чувствующая. Несомненно, должен быть какой-то предел тому, что ты можешь здесь познать».~
@28376 = ~«Забудем о моей просьбе. Можно лучше задать тебе пару вопросов?»~
@28377 = ~«Забудем о моей просьбе. Я должен идти. Прощай».~
@28378 = ~«О, мне было бы *невероятно* интересно, — она слегка улыбается. — Подобное предложение не может не заинтриговать, можешь в этом не сомневаться».~
@28379 = ~«Так значит, ты *хотела бы* путешествовать со мной?»~
@28380 = ~«Если ты этого хочешь, то должен кое-что сделать для меня. В этом заведении есть десять учеников. Я бы хотела, чтобы ты переговорил со всеми ими. Потом возвращайся ко мне и поделись своими мыслями. Там и посмотрим, будем ли мы путешествовать вместе или нет».~
@28381 = ~«Я уже поговорил с ними... но учеников только девять. Я не могу найти десятого».~
@28382 = ~«Хорошо. Можно задать тебе несколько вопросов перед уходом?»~
@28383 = ~«Тогда я пойду. Вернусь, как поговорю со всеми ими».~
@28384 = ~«Вполне возможно, — в раздумьях она касается своего подбородка. — И все же...»~
@28385 = ~«То есть, тебе было бы неинтересно путешествовать с забывшим все бессмертным, который ищет себя по всем планам?»~
@28386 = ~«Насколько волнующими может быть это место?»~
@28387 = ~«Ты ведь чувствующая. Несомненно, должен быть какой-то предел тому, что ты можешь здесь познать».~
@28388 = ~«Неважно. Можно я лучше задам тебе пару вопросов?»~
@28389 = ~«Подумай над этим. Я еще вернусь. Прощай».~
@28390 = ~«Думаю, ты будешь весьма удивлен. Если ты хочешь, чтобы я составила тебе компанию в путешествии, мне нужны куда более веские причины».~
@28391 = ~«То есть, тебе было бы неинтересно путешествовать с забывшим все бессмертным, который ищет себя по всем планам?»~
@28392 = ~«Неважно. Можно я лучше задам тебе пару вопросов?»~
@28393 = ~«Что ж, посмотрим, смогу ли я найти более веские причины. Прощай».~
@28394 = ~[no text]~
@28395 = ~«Помощь? Какого рода помощь ты ищешь?»~
@28396 = ~«Похоже, я потерял свои воспоминания... и тем самым потерял себя».~
@28397 = ~«Неважно. Можно задать тебе пару вопросов?»~
@28398 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28399 = ~«У тебя амнезия? — Падшая Грация кажется огорченной. — Какой ужас! И ты не знаешь, как это произошло?»~
@28400 = ~«Нет... По крайней мере, я не могу это вспомнить. Я очнулся на плите в Морге. А до этого — кромешная тьма».~
@28401 = ~«Неважно. Можно задать тебе пару вопросов?»~
@28402 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28403 = ~«Ты очнулся в Морге?»~
@28404 = ~«Думаю, тленные приняли меня за мертвеца... или я в самом деле умер... или что-то в этом роде. Я знаю только, что все мои раны быстро затягиваются. Возможно, я бессмертен, но даже этого не знаю наверняка».~
@28405 = ~«Думаю, тленные приняли меня за мертвеца... или я в самом деле умер... или что-то в этом роде. Я знаю только, что все мои раны быстро затягиваются. Возможно, я бессмертен, но даже этого не знаю наверняка».~
@28406 = ~«Неважно. Можно задать тебе пару вопросов?»~
@28407 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28408 = ~Похоже, Падшая Грация смотрит на тебя с возобновившимся интересом. «Эти шрамы на твоем теле, — она протягивает руку к твоему телу. — Можно?»~
@28409 = ~«Э-э-э... Конечно».~
@28410 = ~«Да».~
@28411 = ~«Вообще-то, я бы предпочел больше это не обсуждать. Можно задать тебе несколько вопросов?»~
@28412 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28413 = ~Падшая Грация легонько проводит пальцем по твоей груди, следуя по краям шрамов, туда, где они сливаются в твои татуировки. Похоже, что она потрясена. «Эти шрамы и впрямь выглядят так, словно понадобилось несколько жизней, чтобы собрать их».~
@28414 = ~«Так и есть... Хотя некоторые из них совсем свежие».~
@28415 = ~«Я бы предпочел больше это не обсуждать. Можно задать тебе несколько вопросов?»~
@28416 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28417 = ~Падшая Грация отступает на шаг. «Некоторые из этих ран были смертельными. Для обычного человека, — она задумчиво потирает подбородок. — И что ты собираешься теперь делать?»~
@28418 = ~«Мне нужно вернуть свои воспоминания и свою жизнь. Я собираюсь прочесывать планы и продолжать поиск в самом себе, покуда не соберу воедино все сведения о том, кто я и что привело меня в это состояние».~
@28419 = ~«Мне нужно вернуть свои воспоминания и свою жизнь. Я собираюсь прочесывать планы и продолжать поиск в самом себе, покуда не соберу воедино все сведения о том, кто я и что привело меня в это состояние».~
@28420 = ~«Я точно не знаю. Пока что я просто ищу подсказки, позволяющие понять, кто я и что со мной случилось».~
@28421 = ~«Я не собираюсь ничего делать. Если ответы и существуют, они сами меня найдут... со временем».~
@28422 = ~«Я бы предпочел больше это не обсуждать. Можно задать тебе несколько вопросов?»~
@28423 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28424 = ~Падшая Грация все еще размышляет, потирая пальчиком подбородок. «Должна признаться: мне никогда не доводилось встречать человека, который в буквальном смысле потерял себя, — она поднимает бровь. — Прошу меня извинить, но я нахожу твое состояние весьма интригующим».~
@28425 = ~«Мне очень лестно, что *ты* так думаешь».~
@28426 = ~«Это так».~
@28427 = ~«Интригующим? Скорее уж 'пугающим'. Мне не нравится, что я не знаю, кто я, что я мог сделать, кто мои враги и кто мои друзья».~
@28428 = ~«Я бы предпочел больше это не обсуждать. Можно задать тебе несколько вопросов?»~
@28429 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28430 = ~«Я оскорбила тебя своими словами, — Падшая Грация склоняет голову. — Прошу прощения, если это так».~
@28431 = ~«Извинения приняты».~
@28432 = ~«Неважно, ты не сказала ничего плохого».~
@28433 = ~«Я бы предпочел больше это не обсуждать. Можно задать тебе несколько вопросов?»~
@28434 = ~«Возможно, мы поговорим об этом в другой раз. Прощай».~
@28435 = ~Падшая Грация кивает. «Если это может помочь, то ты можешь обойти бордель. Некоторые из наших учеников весьма подкованы в словесных науках. Возможно, кто-нибудь из них сможет пробудить твою память».~
@28436 = ~«Может, я так и сделаю. Можно сперва пару вопросов?»~
@28437 = ~«Благодарю. Пойду, пообщаюсь с ними. Прощай».~
@28438 = ~«Кровавая война — это конфликт, бушующий на Нижних планах между баатезу и танарри. Они бьются друг с другом, дабы выяснить, какое зло должно главенствовать — упорядоченное или хаотическое, — Падшая Грация делает паузу. — Лучше избегать этой войны любой ценой. Пусть танарри и баатезу толкут друг другу морды и позволят остальным планам пребывать в мире... или, как минимум, в относительном мире».~
@28439 = ~«Относительном?»~
@28440 = ~«Они используют людскую пехоту?»~
@28441 = ~«Сколько она уже продолжается?»~
@28442 = ~«Ты на ней служила?»~
@28443 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28444 = ~«Понятно. Спасибо за информацию. Прощай».~
@28445 = ~«Ну, война настолько велика, что большинство рас втягиваются в нее против своей воли. Игнорировать ее так же опасно, как и участвовать в ней».~
@28446 = ~«Они используют людскую пехоту?»~
@28447 = ~«Сколько она уже продолжается?»~
@28448 = ~«Ты на ней служила?»~
@28449 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28450 = ~«Понятно. Спасибо за информацию. Прощай».~
@28451 = ~«Да, такое случается. В Кровавой войне участвует множество человеческих наемников. Они служат либо в качестве солдат, либо в качестве пушечного мяса, либо в качестве провианта для нечистых».~
@28452 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28453 = ~«Сколько она уже продолжается?»~
@28454 = ~«Сколько она уже продолжается?»~
@28455 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28456 = ~«Понятно. Спасибо за информацию. Прощай».~
@28457 = ~«Согласно летописям, Кровавая война идет с тех пор, как баатезу впервые повстречали танарри... *очень* давно. Я даже не уверена, что у людей найдется подходящее название такому отрезку времени, — Падшая Грация качает головой. — Боюсь, что баатезу и танарри никогда не нравились друг другу».~
@28458 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28459 = ~«Они используют людскую пехоту?»~
@28460 = ~«Ты на ней служила?»~
@28461 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28462 = ~«Понятно. Спасибо за информацию. Прощай».~
@28463 = ~«Нет. Моя мать служила. Суккубы в основном соблазняют смертных, чтобы забрать их души в Бездну и породить больше танарри, и чтобы те шли умирать на Кровавую войну».~
@28464 = ~«Твоя мать? Она служила на Кровавой войне?»~
@28465 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28466 = ~«Они используют людскую пехоту?»~
@28467 = ~«Сколько она уже продолжается?»~
@28468 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28469 = ~«Понятно. Спасибо за информацию. Прощай».~
@28470 = ~«Да. Она была одной из лучших. Она соблазнила бесчисленное множество смертных мужчин. Теперь она живет в Бездне, продает в рабство своих детей».~
@28471 = ~«Тебя... продала в рабство твоя мать?»~
@28472 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28473 = ~«Они используют людскую пехоту?»~
@28474 = ~«Сколько она уже продолжается?»~
@28475 = ~«Эти вопросы тебя не сильно беспокоят?»~
@28476 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28477 = ~«Понятно. Спасибо за информацию. Прощай».~
@28478 = ~«На некоторое время. Я вырвала свободу в соревновании на импровизацию. Это было очень давно».~
@28479 = ~«Кому она тебя продала?»~
@28480 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28481 = ~«Они используют людскую пехоту?»~
@28482 = ~«Сколько она уже продолжается?»~
@28483 = ~«Эти вопросы тебя не сильно беспокоят?»~
@28484 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28485 = ~«Понятно. Спасибо за информацию. Прощай».~
@28486 = ~«Она продала мена баатезу. Наверное, она считала, что они просто убьют меня. Несмотря на познания в других областях, она очень мало знала об их культуре».~
@28487 = ~«Она продала тебя заклятым врагам танарри?»~
@28488 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28489 = ~«Они используют людскую пехоту?»~
@28490 = ~«Сколько она уже продолжается?»~
@28491 = ~«Эти вопросы тебя не сильно беспокоят?»~
@28492 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28493 = ~«Понятно. Спасибо за информацию. Прощай».~
@28494 = ~«Да, — Падшая Грация расправляет плечи. — Ты хотел узнать что-нибудь еще?»~
@28495 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28496 = ~«Они используют людскую пехоту?»~
@28497 = ~«Сколько она уже продолжается?»~
@28498 = ~«Эти вопросы тебя не сильно беспокоят?»~
@28499 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28500 = ~«Понятно. Спасибо за информацию. Прощай».~
@28501 = ~«О, нет-нет, вовсе нет. Лучше помни вот о чем: Кровавая война стоит за большинством событий на планах. Важно понимать, что она из себя представляет и зачем ведется».~
@28502 = ~«Ты сказала, что пока идет война, остальные планы могут пребывать в относительном покое».~
@28503 = ~«Они используют людскую пехоту?»~
@28504 = ~«Сколько она уже продолжается?»~
@28505 = ~«Ты на ней служила?»~
@28506 = ~«У меня есть вопросы, не связанные с Кровавой войной».~
@28507 = ~«Понятно. Спасибо за информацию. Прощай».~
@28508 = ~«Мне знакомо это имя, — Падшая Грация умолкает и какое-то время размышляет. — Вокруг этого имени роится очень много слухов. Многие считают ее выдумкой, но я подозреваю, что она действительно существует, и что в свое время она произвела неизгладимое впечатление на Клетку, пребывая здесь». Она озадаченно смотрит на тебя. «А почему ты спрашиваешь?»~
@28509 = ~«Я намерен ее разыскать».~
@28510 = ~«Что еще ты знаешь о ней?»~
@28511 = ~«Неважно. У меня есть другие вопросы...»~
@28512 = ~«Просто так. Спасибо за информацию. Прощай».~
@28513 = ~Грация поднимает бровь. «Правда? Не могу не спросить: зачем?»~
@28514 = ~«Мне нужна информация, которой она располагает».~
@28515 = ~«Неважно. У меня есть другие вопросы...»~
@28516 = ~«Просто так. Спасибо за информацию. Прощай».~
@28517 = ~«И эта информация больше никому недоступна?»~
@28518 = ~«Подозреваю, что только Равель владеет нужными мне знаниями».~
@28519 = ~«Неважно. У меня есть другие вопросы...»~
@28520 = ~«Не знаю, но собираюсь это выяснить. Прощай».~
@28521 = ~Грация мягко кладет свою руку на твою. «Подумай: если Равель действительно существует, то она чрезвычайно могущественна и коварна. Если рассказы о ее деяниях хоть отчасти верны, то она — существо, открывшее новые определения слова 'зло'. Найти ее — задача не из простых». ~
@28522 = ~«Я осознаю это».~
@28523 = ~«Я осознаю это. Ты знаешь о Равель что-нибудь еще?»~
@28524 = ~«Понятно. Можно задать тебе еще пару вопросов?»~
@28525 = ~«Я знаю. Тем не менее, я должен разыскать ее. Спасибо за информацию. Прощай».~
@28526 = ~«Что ж, легенды мне еще не встречались. Прогулочка будет что надо, — она улыбается. — Разве ты не пробовал заниматься чем-то скучным?»~
@28527 = ~«Нет, не пробовал... Тебе известно еще что-нибудь о Равель?»~
@28528 = ~«Ничего не могу с этим поделать. Можно задать тебе еще пару вопросов?»~
@28529 = ~«Возможно, и занимался — в прошлых своих воплощениях, но не теперь. Идем».~
@28530 = ~«Поговаривают, что она была одной из ведьм Серой пустоши. Многие уверены, что силой и коварством она намного превзошла своих сестер. Давным-давно она пришла в Сигил; ходят слухи, что кроме зла, которое она там сотворила, своими поступками она поставила под угрозу саму Клетку. Сейчас о ней слышно только в байках, она — персонаж детских сказок, — Грация делает паузу. — Полагаю, Леди Боли разобралась с ней так же, как и со всеми угрозами Сигилу».~
@28531 = ~«Как?»~
@28532 = ~«Что такое Серая пустошь?»~
@28533 = ~«Кто еще может знать о ней что-нибудь?»~
@28534 = ~«Могу ли я задать тебе другие вопросы?»~
@28535 = ~«Понятно. Спасибо за информацию. Прощай».~
@28536 = ~«Скорее всего, Равель попала в лабиринт, в одну из тюрем Леди».~
@28537 = ~«Лабиринт? Это еще что такое?»~
@28538 = ~«Что такое Серая пустошь?»~
@28539 = ~«Кто еще может знать о ней что-нибудь?»~
@28540 = ~«Могу ли я задать тебе другие вопросы?»~
@28541 = ~«Понятно. Спасибо за информацию. Прощай».~
@28542 = ~«Гиблый план, находящийся как раз посередине между Баатором и Бездной. Чаще всего он становится полем битвы в Кровавой войне».~
@28543 = ~«Ты знаешь, что случилось с Равель?»~
@28544 = ~«Кто еще может знать о ней что-нибудь?»~
@28545 = ~«Могу ли я задать тебе другие вопросы?»~
@28546 = ~«Понятно. Спасибо за информацию. Прощай».~
@28547 = ~«Кто-нибудь в Фестхолле может знать о ней больше».~
@28548 = ~«Ты знаешь, что случилось с Равель?»~
@28549 = ~«Что такое Серая пустошь?»~
@28550 = ~«Могу ли я задать тебе другие вопросы?»~
@28551 = ~«Понятно. Спасибо за информацию. Прощай».~
@28552 = ~Падшая Грация вскидывает бровь. «В самом деле?»~
@28553 = ~«Да... но это долгая история, пожалуй, куда более долгая, чем я знаю. Мне гораздо интереснее узнать, что это за место».~
@28554 = ~«Да, но эту историю я расскажу в другой раз. Мне пора. Прощай».~
@28555 = ~Она кивает. «Я рада, что оно тебе нравится. Мне и самой оно по душе».~
@28556 = ~«А что оно значит?»~
@28557 = ~«Могу ли я задать тебе другие вопросы?»~
@28558 = ~«На этот раз — ничем. Прощай».~
@28559 = ~«Значение имен — сложная тема. Тут можно много рассказывать, и большую часть лучше оставить недосказанной. Пожалуй, эту историю я расскажу как-нибудь в другой раз».~
@28560 = ~«Падшая Грация — это твое настоящее имя?»~
@28561 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@28562 = ~«Прошу прощения за беспокойство. Прощай».~
@28563 = ~«Может быть, — улыбается она. — А может быть, нет. Есть имена, которыми нарекают, а есть — которые заслуживают. Кому судить, которое из них настоящее? Точно не мне».~
@28564 = ~«Хорошо. Тогда можешь ответить на другие вопросы?»~
@28565 = ~«Прошу прощения за беспокойство. Прощай».~
@28566 = ~«Путешествовать с тобой?» Падшая Грация улыбается. Похоже, она не обращает внимания на твоих спутников. «Это довольно бесцеремонно с твоей стороны».~
@28567 = ~«Я хочу быть откровенным в своих намерениях. Ты невероятно мила и хорошо осведомлена по части планов. Компаньону с подобными знаниями я всегда буду рад».~
@28568 = ~«Я такой, какой я есть».~
@28569 = ~«То есть, насколько волнующими может быть это место?»~
@28570 = ~«Ты ведь чувствующая. Несомненно, должен быть какой-то предел тому, что ты можешь здесь познать».~
@28571 = ~«Забудем о моей просьбе. Можно задать еще пару вопросов?»~
@28572 = ~«Тогда прими мои извинения. Я должен идти. Прощай».~
@28573 = ~«Путешествовать с тобой?» Падшая Грация улыбается. Похоже, она не обращает внимания на Анну. «Это довольно бесцеремонно с твоей стороны».~
@28574 = ~«Я хочу быть откровенным в своих намерениях. Ты невероятно мила и хорошо осведомлена по части планов. Компаньону с подобными знаниями я всегда буду рад».~
@28575 = ~«Я хочу быть откровенным в своих намерениях. Ты невероятно мила и хорошо осведомлена по части планов. Компаньону с подобными знаниями я всегда буду рад».~
@28576 = ~«Я такой, какой я есть».~
@28577 = ~«То есть, насколько волнующими может быть это место?»~
@28578 = ~«Ты ведь чувствующая. Несомненно, должен быть какой-то предел тому, что ты можешь здесь познать».~
@28579 = ~«Забудем о моей просьбе. Можно задать еще пару вопросов?»~
@28580 = ~«Тогда прими мои извинения. Я должен идти. Прощай».~
@28581 = ~«Путешествовать с тобой?» Падшая Грация улыбается. Похоже, она не обращает внимания на Морта. «Это довольно бесцеремонно с твоей стороны».~
@28582 = ~«Я хочу быть откровенным в своих намерениях. Ты невероятно мила и хорошо осведомлена по части планов. Компаньону с подобными знаниями я всегда буду рад».~
@28583 = ~«Я такой, какой я есть».~
@28584 = ~«То есть, насколько волнующими может быть это место?»~
@28585 = ~«Ты ведь чувствующая. Несомненно, должен быть какой-то предел тому, что ты можешь здесь познать».~
@28586 = ~«Забудем о моей просьбе. Можно задать еще пару вопросов?»~
@28587 = ~«Тогда прими мои извинения. Я должен идти. Прощай».~
@28588 = ~«Так ты не смог найти десятого ученика? Любопытно».~
@28589 = ~«Думаю, что десятый ученик — это я. В таком случае, я поговорил со всеми».~
@28590 = ~«Думаю, что десятый ученик — это я. В таком случае, я поговорил со всеми».~
@28591 = ~«Под борделем я видел десять камней, и один из них пуст... так что мне кажется, что здесь только девять проституток. Значит, десятый *ученик* — это я. В таком случае, я поговорил со всеми».~
@28592 = ~«Мне кажется, что Луис — десятый ученик... в своем роде».~
@28593 = ~«Ты можешь сказать мне, где найти десятого ученика?»~
@28594 = ~«Возможно, я его пропустил. Можно задать тебе пару вопросов?»~
@28595 = ~«Я буду искать еще внимательнее. Возможно, я таки найду десятого ученика. Прощай».~
@28596 = ~Она кивает. «Хорошо. И каковы твои мысли?»~
@28597 = ~«Нам с тобой следует покинуть это место и отправиться исследовать планы. Здесь для нас не осталось ничего, что можно было бы испытать».~
@28598 = ~«Ученик где-то рядом... Может, тебе стоит присмотреться получше».~
@28599 = ~«Думаю, что десятый ученик — это я. В таком случае, я поговорил со всеми».~
@28600 = ~«Думаю, что десятый ученик — это я. В таком случае, я поговорил со всеми».~
@28601 = ~«Думаю, что десятый ученик — это я. В таком случае, я поговорил со всеми».~
@28602 = ~«Мне кажется, что Луис — десятый ученик... в своем роде».~
@28603 = ~«Возможно, я его пропустил. Можно задать тебе пару вопросов?»~
@28604 = ~«Я буду искать еще внимательнее. Возможно, я таки найду десятого ученика. Прощай».~
@28605 = ~Грация соединяет пальцы так, чтобы ладони образовали подобие круга. «Говорят, что Леди обладает способностью брать части Сигила...» Ты с удивлением видишь, как призрачный образ мизинца Грации отделяется от руки и сам по себе парит в воздухе, вращаясь вдоль небольшого круга. «...и делать из них лабиринт».~
@28606 = ~«Продолжай...»~
@28607 = ~«Понятно. Расскажи мне о плане, из которого родом Равель... о Серой пустоши».~
@28608 = ~«Думаю, я понял. Кто-нибудь еще может знать больше о Равель?»~
@28609 = ~«Неважно. Можно задать тебе другие вопросы?»~
@28610 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@28611 = ~Небольшой призрачный круг парит в воздухе, затем начинает медленно вращаться. «В эту часть Сигила она помещает узника. Попав в лабиринт, выбраться из него уже нельзя. Это может случиться в любое время, пока ты гуляешь по улице, входишь через дверь, — она резко хлопает в ладони, — и вдруг оказываешься в другом месте». Внутри призрачного круга ты неожиданно замечаешь мерцающее движение, как будто внутри кто-то бродит.~
@28612 = ~«Продолжай...»~
@28613 = ~«Понятно. Расскажи мне о плане, из которого родом Равель... о Серой пустоши».~
@28614 = ~«Думаю, я понял. Кто-нибудь еще может знать больше о Равель?»~
@28615 = ~«Неважно. Можно задать тебе другие вопросы?»~
@28616 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@28617 = ~Грация продолжает; крошечный призрачный лабиринт отражается в ее глазах. «Говорят, что в каждом лабиринте есть портал наружу, но найти его нелегко. Возможно, их оставили для того, чтобы дать узнику надежду. А, может, для того, чтобы помучить его». Призрачный лабиринт меркнет. «Наверно, и для того, и для другого».~
@28618 = ~«Понятно. Расскажи мне о плане, из которого родом Равель... о Серой пустоши».~
@28619 = ~«Думаю, я понял. Кто-нибудь еще может знать больше о Равель?»~
@28620 = ~«Неважно. Можно задать тебе другие вопросы?»~
@28621 = ~«Понятно. Это все, что я хотел узнать. Прощай».~
@28622 = ~Стоящая рядом с тобой Анна начинает шипеть. «Ш-ш-ш! Чем это ты занимаешься, перекидываешься с ней всякими заумными словечками? Ты че, из ума выжил?»~
@28623 = ~«Анна, успокойся и помолчи... Я тут кое с кем разговариваю, понятно?»~
@28624 = ~«Анна, я всего лишь проявил любезность, чтобы она простила меня за мою грубость, понимаешь?»~
@28625 = ~Анна сплевывает. «Да уж, строишь из себя щеголя. Ну ты и дурень — заигрывать с нечистыми! Тебе в дурдом часом не пора?»~
@28626 = ~«Она из нечисти, из суккубов — вот она кто. Разберется, кто ты из себя такой, а потом затащит твою душонку на Нижние планы, так и будет».~
@28627 = ~Анна напрягается, затем начинает что-то ворчать себе под нос. «Кто это сказал, что она идет с нами? Нам не нужны такие, как она, ну уж нет».~
@28628 = ~Анна напрягается, затем начинает что-то ворчать себе под нос. «Кто это сказал, что она идет с нами? Нам не нужны такие, как она, ну уж нет».~
@28629 = ~«Череп, тебе бы захлопнуть свою черепушку, а то ща как задвину — будешь зубы из шпиля выдергивать...»~
@28630 = ~«Какая скукота».~
@28631 = ~«Шеф, она — танарри... суккуб».~
@28632 = ~«Задвинься, бесовка! — Морт клацает зубами. — Я ЗА то, чтобы суккубка пошла с нами... Видят силы, от *тебя* веселья, как от колючки в кишках».~
@28633 = ~«Эй, минутку! Это *я* лучше всех разбираюсь в планах! Это моя работа, шеф!»~
@28634 = ~«Двое сведущих в плана людей в нашей команде — довольно неплохо, как по мне. Кроме того, еще я сказал, что она мила, Морт».~
@28635 = ~«Пожалуй, только для глаз! Мне почему-то КАЖЕТСЯ, что стоит какой-нибудь цыпочке чуть-чуть оголиться, как ты уже принимаешь ее в команду! — Морт умолкает. — Не то чтобы я против. Просто подумал, что стоит об этом сказать».~
@28636 = ~«Заметано, Морт. Госпожа Грация... Может, я слишком забегаю вперед, но ты не хотела бы отправиться с нами в путешествие?»~
@28637 = ~«Мой товарищ в шрамах хотел сказать: с нами ДВУМЯ... Кстати, я Морт. Прошу простить моего товарища за то, что он не соизволил представить нас друг другу... Мне кажется, ваше присоединение к нам — ОТЛИЧНАЯ идея. У нас много места для суккуба. МНОГО места».~
@28638 = ~Вернуться в игру~
@28639 = ~Вы действительно хотите удалить эту сохраненную игру?~
@28640 = ~Удалить~
@28641 = ~Готово~
@28642 = ~В имени сохранения содержатся неверные символы. Удалите любой из присутствующих символов: . , ? : < > | * / \ "~
@28643 = ~Имя сохранения неверно. Укажи другое имя.~
@28644 = ~Переписать~
@28645 = ~Сохранить~
@28646 = ~Игра успешно сохранена.~
@28647 = ~Пусто~
@28648 = ~Загрузить~
@28649 = ~СОХРАНИТЬ ИГРУ~
@28650 = ~Девушка кивает в знак приветствия, но всем своим видом указывает замолчать.~
@28651 = ~Введите название сохранения:~
@28652 = ~ЗАГРУЗИТЬ ИГРУ~
@28653 = ~Оставить девушку в покое.~
@28654 = ~«Нет, мне кажется, что он хороший поэт».~
@28655 = ~«Тогда неважно... У меня есть несколько вопросов...»~
@28656 = ~«У меня есть несколько вопросов...» ~
@28657 = ~«Поторопись, несущий шрамы. Я не могу ждать тебя весь день».~
@28658 = ~Он бросает на тебя холодный взгляд, делает небольшое движение, и ты внезапно исчезаешь.~
@28659 = ~«Ты уже надумал забирать тот тараторящий коробок? Его бесконечное нытье меня утомляет».~
@28660 = ~Взгляд Лотара ожесточается. «Ты все равно заберешь его». Взмахом руки Лотар освобождает Морта, и тот исчезает с полки. «Ты найдешь его снаружи у лестницы, где ты вошел в мои владения, — он отворачивается. — Прощай».~
@28661 = ~Взмахом руки Лотар освобождает Морта, и тот исчезает с полки. «Ты найдешь его снаружи у лестницы, где ты вошел в мои владения, — он отворачивается. — Прощай».~
@28662 = ~«Вижу, ты вернулся. Принес мне череп?»~
@28663 = ~«Тогда советую заняться его поисками, если ты все еще надеешься получить свои ответы... и тебе все еще нужен твой болтливый псевдомимир».~
@28664 = ~«Ну? Ты принес мне череп, который мне нужен взамен твоего?» Лотар криво усмехается.~
@28665 = ~«Тогда иди. Советую тебе не возвращаться, пока не найдешь его».~
@28666 = ~«Что это значит? Та гробница была начинена ловушками и так хорошо защищена от магии гадания, что даже для меня она была бы испытанием! Этому должно быть объяснение, и, — он протягивает слова медленно и сердито, — ТЫ предоставишь мне его. Пройди через портал в комнатах снизу и найди ответ».~
@28667 = ~«Опять ты? — глядя на тебя, старик слегка пошатывается. — Чего тебе нужно от старого Лотара? Я ответил на твои вопросы. Предупреждаю: я не собираюсь тратить на тебя весь день». Его взгляд падает на тебя с силой кувалды.~
@28668 = ~«Вижу, ты вернулся. Принес мне череп?»~
@28669 = ~«Тогда советую спуститься в катакомбы и найти еще один, м-м?»~
@28670 = ~«Ну? Ты нашел череп, которым купишь себе ответы?»~
@28671 = ~«А! Посетитель. Что заставило тебя прийти в мой скромный салон незвано, без разрешения?»~
@28672 = ~«Но ты же понимаешь, что не можешь войти без спроса в Кости Ночи и надеяться на то, что ты уйдешь так быстро. Я здесь торгую ответами, мальчик, и, клянусь всеми силами, либо я получу от тебя ответ, либо твоя голова украсит мою полку».~
@28673 = ~«У тебя остался ровно один шанс ответить мне, не то я не вырву ответ из твоего скалящегося черепа».~
@28674 = ~Глаза старика вспыхивают, он выплевывает перекрученную фразу из тайных слов. Твое тело охватывает боль. Тебя окутывает тьма...~
@28675 = ~Вспышка света и дым на мгновение ослепляют тебя, и перед тобой появляется иссушенный старик. «У нас гости, череп?»~
@28676 = ~«У каждого ответа и заклинания есть своя цена. В твоем случае... — старик умолкает. — Черепа — моя валюта. Я задаю им вопросы, и они мне отвечают. Мертвые накопили много знаний за время своих жизней. Чем ценнее череп, тем больше вопросов ты можешь задать, тем сильнее заклинание, которое я могу для тебя создать».~
@28677 = ~Глаза Лотара опасно сверкают. «Это была не просьба».~
@28678 = ~«У тебя последний шанс, мешок со шрамами, пока я не передумал и не забрал твой череп».~
@28679 = ~Старик игнорирует Морта. «Приветствую, путник. Кто ты такой, чтобы входить в скромный салон Лотара без приглашения?»~
@28680 = ~«Выкрал? Твоего друга? Я ничего такого не делал. И где же этот друг?»~
@28681 = ~«Выкрал? Твоего друга? Я ничего такого не делал. И где же этот друг?»~
@28682 = ~«Ты должен пробраться через Логово Мысли, которым управляют черепные крысы, или через Мертвые Народы, которыми заправляют ходячие мертвецы, пройти через залитые водой области Затопленных Народов и найти гробницу безымянного господина. Бывалые... приключенцы... вроде тебя не испытают в этом трудностей. Отодвинь диван, зайди в портал в восточной стене комнаты снизу. Портал продолжит действовать до твоего возвращения. Я дам тебе ответы, когда у тебя будет череп».~
@28683 = ~«О, да? И что же это может быть?»~
@28684 = ~«Тебе нужен тот болтливый череп, лишенный половины приличия и манер? Если хочешь его вернуть, дай мне взамен более ценный череп, — отвечает Лотар. — Мне не нужно торговаться за то, что и так мое».~
@28685 = ~ПУСТОЙ УЗЕЛ СООБЩИ КОЛИНУ ЕСЛИ НАТКНЕШЬСЯ НА НЕГО~
@28686 = ~«Отодвинь диван в центре комнаты, зайди в портал в восточной стене в комнате внизу. Портал продолжит действовать до твоего возвращения. В катакомбах много черепов. Один очень ценный череп лежит в погребенных склепах тленных, за Затопленными Народами. Принеси его мне — мои слуги-крысооборотни не смогли этого сделать, — и я позабочусь о том, чтобы твой друг вернулся к тебе. Возможно, я даже отвечу на несколько твоих вопросов».~
@28687 = ~«Даю тебе слово. Этого будет достаточно для тебя. Если ты, конечно, не решил распрощаться со своим другом...»~
@28688 = ~«Твое невежество поражает. Ты и в самом деле знаешь очень мало о немногом. Так, принеси мне череп в обмен на этот или прощайся со своим другом».~
@28689 = ~Лотар стискивает посох. «Этот череп МОЙ. Если ты продолжишь настаивать, я заберу и твой в придачу».~
@28690 = ~«Череп говорит мудро. Учти это».~
@28691 = ~Лотар берет череп и внимательно его осматривает. «Пхе. Этот ничего не стоит. Он ничего не может мне рассказать. Чтобы потратить на тебя время, мне нужен ценный череп. Сгинь!»~
@28692 = ~Взгляд Лотара сердито сверкает. «Значит, убиваешь моих слуг? Дай мне череп». Он внимательно осматривает череп и произносит: «Я могу учуять его предательство через кость. Он был осторожным, но недостаточно, да? Не бойся, я отниму у него его тайны и разберусь с его двуличной сущностью, — его пальцы делают тайный жест. — Твой друг будет ждать на поверхности у входа сюда. Задавай свои вопросы».~
@28693 = ~Лотар берет у тебя череп и внимательно осматривает его. «Говоришь, Харгримм? Лидер Мертвых Народов? У него для меня много информации. Сделка состоялась, — его пальцы делают тайный жест. — Твой друг будет ждать на поверхности у входа сюда. Задавай свои вопросы».~
@28694 = ~Лотар берет у тебя череп Тухлой Мери, смахивает с него лишнюю плоть и внимательно осматривает. «Говоришь, предводительница зомби в Мертвых Народах? Этого будет достаточно, — его пальцы делают тайный жест. — Твой друг будет ждать на поверхности у входа сюда. Задавай свои вопросы».~
@28695 = ~Лотар берет у тебя череп Акасты, смахивает с него лишнюю плоть и внимательно осматривает. «Королева упырей? Этого будет достаточно, — его пальцы делают тайный жест. — Твой друг будет ждать на поверхности у входа сюда. Задавай свои вопросы».~
@28696 = ~Лотар берет у тебя череп Соэго и внимательно осматривает его, проверяя зубы. «Значит, миссионер тленных и шпион? Этого будет достаточно, — его пальцы делают тайный жест. — Твой друг будет ждать на поверхности у входа сюда. Задавай свои вопросы».~
@28697 = ~Лотар берет у тебя череп Безмолвного Короля и нежно прижимает его к груди. «Безмолвный Король, да? Этого более чем достаточно!» Он шепчет черепу: «Ты раскроешь мне все свои секреты, мой новый друг, — его пальцы делают тайный жест. — Твой друг будет ждать на поверхности у входа сюда. Задавай свои вопросы».~
@28698 = ~Лотар берет у тебя череп и внимательно осматривает его. «Говоришь, Харгримм? Лидер Мертвых Народов? У него для меня много информации. Сделка состоялась. Можешь задавать свои вопросы».~
@28699 = ~Лотар берет у тебя череп Тухлой Мери, смахивает с него лишнюю плоть и внимательно осматривает. «Говоришь, предводительница зомби в Мертвых Народах? Этого будет достаточно. Можешь задавать свои вопросы».~
@28700 = ~Лотар берет у тебя череп Акасты, смахивает с него лишнюю плоть и внимательно осматривает. «Королева упырей? Этого будет достаточно. Можешь задавать свои вопросы».~
@28701 = ~Лотар берет у тебя череп Соэго и внимательно осматривает его, проверяя зубы. «Значит, миссионер тленных и шпион? Этого будет достаточно — занимательный череп, даже если он и не пригодится.  Можешь задавать свои вопросы».~
@28702 = ~Лотар берет у тебя череп Безмолвного Короля и нежно прижимает его к груди. «Безмолвный Король, да? Этого более чем достаточно! Можешь задавать свои вопросы». Он шепчет черепу: «Ты раскроешь мне все свои секреты, мой новый друг».~
@28703 = ~«Твоя смертность или, если хочешь, твоя душа, позволяющая тебе жить и умирать, ушла от тебя. Тебя ее лишила посредством магии ночная ведьма Равель Заморочка. Твоя смертность — ключ к твоему существованию: найдя ее, ты найдешь свои ответы».~
@28704 = ~«Это побочный эффект от утраты смертности».~
@28705 = ~«Равель Заморочка — загадка, даже среди ночных ведьм. Некоторые говорят, что она чокнутая; другие говорят, что она играет в настолько сложную игру, что никто не в силах ее понять. Она — абсолютное зло. Даже нечистые на ее фоне кажутся святыми. Хвала силам, она теперь вне досягаемости для людей: Леди Боли отправила ее в лабиринты».~
@28706 = ~«Лабиринты подобны карманным измерениям... небольшие мирки в промежутках между планами. Чтобы добраться до лабиринта, тебе придется найти портал и ключ. Я не знаю ни ключа, ни портала. Возможно, тебе стоит отыскать своих старых знакомых: безусловно, ты оставил немало их за собой. Вне всякого сомнения, они сами тебя найдут; молись, чтобы у них были добрые намерения. Пожалуй, тебе стоило бы посетить Городской Фестхолл: там можно найти много ответов».~
@28707 = ~«Я не давал тебе разрешения говорить, череп! — Морт дрожит от сурового голоса Лотара. — Несущий шрамы, если ты хочешь вернуть череп, то должен принести мне более ценный череп из катакомб под нами. Я не стану торговаться за то, что и так мое. Соглашайся или не соглашайся».~
@28708 = ~«Она создавала игрушки и головоломки, она решала проблемы, не нуждающиеся в решении. Она решила, что Сигил, Клетка — это самая большая головоломка, и поставила перед собой задачу разгадать ее, конечно же, для того, чтобы впустить армии нечисти под ее управлением, нарушив равновесие города и превратив его в склеп. Воздай хвалу любой силе, в которую веришь, что ей это не удалось».~
@28709 = ~«Хвала силам, ты здесь, шеф. Вытащи меня отсюда».~
@28710 = ~«Те крысооборотни схватили меня и притащили сюда! Ну же, босс... нам нужно убираться отсюда! Это плохое место!»~
@28711 = ~«У меня не получается! Я пробовал! Давай, сними меня, пока...»~
@28712 = ~«Хватит шутить, босс... нам нужно уходить отсюда, пока...»~
@28713 = ~«О... нет, — яростно шепчет Морт. — НЕ раздражай этого знатока, босс... Он запишет тебя в книгу мертвых раньше, чем ты плюнешь».~
@28714 = ~Морт включается в разговор. Его голос звучит жалко, испугано и почтительно. Очевидно, что, по мнению Морта, с этим типом, Лотаром, лучше не пересекаться. «Он имеет в виду меня. Послушайте, сэр, просто отпустите меня, и мы все забудем. Все останется в Канаве, а?»~
@28715 = ~Морт включается в разговор. «Он имеет в виду меня. Послушайте, сэр, просто отпустите меня, и мы все забудем. Все останется в Канаве, а?»~
@28716 = ~«Мне это подходит, босс, ведь я здесь застрял. Соглашайся, ладно? Просто найди череп и возвращайся за мной».~
@28717 = ~«Босс, нет! Он сотрет тебя в порошок! — кажется, Морт просто в ужасе. — Он один самых больших шишек во всей чертовой Клетке!»~
@28718 = ~«Босс, не нарывайся! Соглашайся!»~
@28719 = ~«Что ты здесь делаешь?»~
@28720 = ~«Почему?»~
@28721 = ~«Я работаю над этим, Морт».~
@28722 = ~«Почему бы тебе просто не слететь оттуда?»~
@28723 = ~«Я даже не знаю. Кажется, тебе там так уютно со всеми остальными черепами...»~
@28724 = ~«Отлично. Лотар, я за ним вернусь. Прощай».~
@28725 = ~«Это не подходит МНЕ, Морт. Я буду за него биться, Лотар».~
@28726 = ~«Очень жаль. Отдай его, Лотар».~
@28727 = ~«Отлично. Я вернусь за ним, Лотар».~
@28728 = ~«Я просто хотел еще немного поговорить с тобой».~
@28729 = ~~
@28730 = ~«Расскажи мне о Равель Заморочке».~
@28731 = ~«Почему я бессмертен?»~
@28732 = ~«Почему я бессмертен?»~
@28733 = ~«Почему я потерял память?»~
@28734 = ~~
@28735 = ~«Минутку...»~
@28736 = ~«Нет, можешь оставить его себе».~
@28737 = ~«Дай. Верни мне его, пожалуйста».~
@28738 = ~«Спасибо, шеф. Не могу выразить свою радость тем, что я снова с тобой». Его голос истекает сарказмом. «А еще я научился новому приемчику, пока был там».~
@28739 = ~«Правда? В этом чувствуется твой стиль, босс. Хорошо придумано. Ты условно прощен. Просто не делай так больше».~
@28740 = ~«Почему-то мне в это верится с трудом. Давай просто забудем о случившемся. Идем».~
@28741 = ~«Спасибо, босс. Давай убираться отсюда! — Морт делает паузу. — А, кстати, босс... Эти ребята действительно соображают. Я научился у них паре острот».~
@28742 = ~~
@28743 = ~«Ага. Отлично. Я очень рад, что ты вернулся назад».~
@28744 = ~«Извини, приятель. Я хотел его обмануть».~
@28745 = ~«Извини, приятель. Я хотел его обмануть».~
@28746 = ~«Конечно, Морт. Идем».~
@28747 = ~«Отлично».~
@28748 = ~«Морт, я блефовал. Вот увидишь».~
@28749 = ~«Идем».~
@28750 = ~Кандриан рассказал мне о Карцери, Великой тюрьме Планов. Он сказал, что единственный способ сбежать из тюрьмы — это стать сильнее тюремщика. Еще он сказал, что оковы плана сильнее плоти.~
@28751 = ~Кандриан рассказал мне о клетке-головоломке в самом сердце Лимбо. Нечто вроде зерна порядка посреди беспокойного моря хаоса.~
@28752 = ~Кандриан рассказал мне о своем путешествии на Негативный материальный план, место, где бытие превращается в небытие.~
@28753 = ~После того, как Кандриан выпустил Ингресс из Сигила, он передал мне небольшой подарок: ее танцующие зубы. Как очаровательно.~
@28754 = ~Я переговорил с Кандрианом насчет Ингресс, и он сказал, что проведете ее домой. Он попросил меня сообщить Ингресс, чтобы та ждала его, а после — встретиться с ним снова в «Тлеющем трупе».~
@28755 = ~«Расскажи мне о главных правилах».~
@28756 = ~Ки-Саи, боевой инструктор в Городском Фестхолле, отказался обучать меня, сказав, что я слишком слаб. Возможно, если когда-нибудь я стану сильнее, я вернусь.~
@28757 = ~«У меня человеческий череп».~
@28758 = ~«У меня череп крысооборотня...»~
@28759 = ~«У меня череп Харгримма, скелета-жреца из Мертвых Народов».~
@28760 = ~«У меня череп Тухлой Мери, предводительницы зомби из Мертвых Народов».~
@28761 = ~«У меня череп Акасты, предводительницы непокорных упырей».~
@28762 = ~«У меня череп Соэго, крысооборотня и миссионера тленных».~
@28763 = ~«У меня череп Безмолвного Короля, правителя Мертвых Народов».~
@28764 = ~«У меня череп Мантуока».~
@28765 = ~«Хорошо. Я вернусь».~
@28766 = ~«В той гробнице нет черепа, Лотар».~
@28767 = ~«Пока нет».~
@28768 = ~«Хорошо».~
@28769 = ~«У меня нет ответа. Откуда мне знать?»~
@28770 = ~«Я хотел бы задать еще несколько вопросов».~
@28771 = ~«Я просто хотел еще немного поговорить с тобой».~
@28772 = ~«Ничего, спасибо. Прощай».~
@28773 = ~«У меня человеческий череп».~
@28774 = ~«У меня череп Мантуока».~
@28775 = ~«У меня череп Харгримма, скелета-жреца из Мертвых Народов».~
@28776 = ~«У меня череп Тухлой Мери, предводительницы зомби из Мертвых Народов».~
@28777 = ~«У меня череп Акасты, предводительницы непокорных упырей».~
@28778 = ~«У меня череп Соэго, крысооборотня и миссионера тленных».~
@28779 = ~«У меня череп Безмолвного Короля, правителя Мертвых Народов».~
@28780 = ~«У меня череп крысооборотня».~
@28781 = ~Параметры видео~
@28782 = ~«Ладно, ладно».~
@28783 = ~«В той гробнице нет черепа, Лотар».~
@28784 = ~«Пока нет».~
@28785 = ~«Кто ты?»~
@28786 = ~«Что это за место?»~
@28787 = ~«Кто ты?»~
@28788 = ~«Давай посмотрим на твою попытку, старик».~
@28789 = ~«Ты торгуешь ответами? Тогда скажи мне: кто я? Почему я бессмертен?»~
@28790 = ~ПАРАМЕТРЫ ВИДЕО~
@28791 = ~«Я так не думаю. Прощай».~
@28792 = ~«Тогда я здесь, чтобы купить ответы».~
@28793 = ~«А у тебя есть ровно один шанс, чтобы наколоться перед тем, как я тебя убью».~
@28794 = ~«Ах...»~
@28795 = ~«И?»~
@28796 = ~Его губы искривляются в презрительной усмешке. «Вот так всегда: *воры* и *воровство*! Я участвовал в пяти разведывательных операциях на Войне Лжи. Разведчик — моя профессия... *разведчик*. Я обучаю скрытности и шпионажу, а не обычному воровству».~
@28797 = ~«Говорю, забудь об этом».~
@28798 = ~«Ладно, ладно. Я достану тебе череп».~
@28799 = ~«Попробуй, Лотар».~
@28800 = ~«Не нужно сердиться. Я достану череп».~
@28801 = ~«Ты выкрал моего друга. Отдай его. Сейчас же».~
@28802 = ~«Ты выкрал моего друга. Отдай его. Сейчас же».~
@28803 = ~«Прошу прощения, сэр, но у вас есть кое-что, принадлежащее мне».~
@28804 = ~«Я был там, и в склепе никого не оказалось».~
@28805 = ~«Я вернусь».~
@28806 = ~«Принадлежащий мне череп находится на этой полке».~
@28807 = ~«Мой друг Морт очутился на твоей полке».~
@28808 = ~~
@28809 = ~«Начнем с того, что... он никогда не был твоим... и ничьим вообще».~
@28810 = ~«Он мой».~
@28811 = ~«Где мне найти ценный череп?»~
@28812 = ~«Хорошо. Где мне найти ценный череп?»~
@28813 = ~«Он мой».~
@28814 = ~«Начнем с того, что он никогда не был твоим».~
@28815 = ~Ингресс умолкает. «Мнэ нада идты. Я должэн ПОКИНУТ это место».~
@28816 = ~Ингресс ничего не говорит, лишь тихо кивая. Ее зубы начинают стучать во рту.~
@28817 = ~Ингресс внимательно смотрит на тебя, когда ты приближаешься. «Кан-дры-ан?»~
@28818 = ~Ки-Саи, боевой инструктор в Городском Фестхолле, обучил меня мастерству владения молотом. Теперь я специализируюсь на этом конкретном оружии.~
@28819 = ~Ки-Саи, боевой инструктор в Городском Фестхолле, обучил меня «Пути Камня». И хотя большая часть его философии не особо полезна или вообще неприменима ко мне, существу из плоти, я могу воспользоваться некоторыми его принципами, чтобы меня было сложнее ранить в бою.~
@28820 = ~Ки-Саи, боевой инструктор в Городском Фестхолле, попытался обучить меня «Пути Камня». Однако его философия была попросту слишком сложна и чужда мне, чтобы я смог понять ее.~
@28821 = ~В последний раз Янис так меня достал, что я душил его до тех пор, пока он не умолк.~
@28822 = ~В последний раз Янис так меня достал, что я душил его до тех пор, пока он не умолк. Убийство пробудило воспоминание... но оно было слишком слабым, чтобы удалось его вспомнить. Одну вещь я знаю наверняка — он не первый, кого я задушил.~
@28823 = ~Мне удалось обманом заставить одноухого тифлинга отдать мне вилку Нестора. Он сказал, что его преследуют, и что он слышит голоса в своей голове. Скорее всего, он просто спятил, как и старик.~
@28824 = ~Я встретил одноухого тифлинга, прячущегося в тени большой арки в северной части Улья. Что-то в его глазах подсказало мне, что он не из тех, с кем можно шутки шутить.~
@28825 = ~Я вернул Нестору вилку. Она оказалась портальным ключом или что-то вроде того. Получив свою вещь, Нестор теперь может вернуться туда, откуда пришел. Интересно, сколько времени этот бедолага слонялся по Сигилу, не имея возможности вернуться домой?~
@28826 = ~Я забрал наследство Дейонарры у ее надоедливого отца. Мне не нравится его тон в разговоре со мной. Лучше бы он следил за собой, а то еще закончит как его дочка.~
@28827 = ~Я забрал наследство Дейонарры у ее надоедливого отца.~
@28828 = ~Я забрал свое наследство у адвоката Яниса в Чиновничьем районе. Среди прочего имущества в наследстве была странная квитанция... на вид очень старая. Янис сказала, что это «квитанция Великой Литейной», и что это означает, что я что-то заказывал у боголюдей. Еще он сказал, что квитанция позволит мне пройти в Великую Литейную в Нижнем районе.~
@28829 = ~Янис сказал, что единственный способ расторгнуть контракт тленных — это уничтожить его.~
@28830 = ~По всей видимости, Янис — «адвокат». Он дает юридические консультации, организовывает наследства и участвует в судах.~
@28831 = ~Я встретил человека по имени Янис, который работает в Чиновничьем районе. У меня такое чувство, что я откуда-то его знаю, вот только откуда?~
@28832 = ~Маг по имени Квелл сказал мне, что ключ к порталу, ведущему в лабиринт Равель, является, как ни странно, частью самой Равель.~
@28833 = ~В частном сенсориуме Городского Фестхолла я встретил мага по имени Квелл. Он торгует разнообразными волшебными конфетами. В каждой из них содержится разного рода магия, которая начинает действовать, если ее съесть.~
@28834 = ~Я сообщил Ингресс, что Кандриан может помочь ей выбраться назад домой. Я встречусь с Кандрианом в баре 'Тлеющий труп', чтобы удостовериться, что все прошло хорошо. ~
@28835 = ~Эта безумная Ингресс боится даже своей тени и всего, что МОЖЕТ стать порталом. Она живет как собака на улицах города. Мне ее немного жалко... Если я смогу найти опытного путешественника по планам, которому известен портал, через который она попала сюда, я могу вернуться и сообщить ей об этом. ~
@28836 = ~Ингресс оказалась в западне из-за своего страха перед порталами... У нее был неприятный опыт путешествий по планам, из-за чего она боится их так, что не может пройти через *все*, что может стать порталом. Если я смогу найти в городе опытного путешественника по планам, то, возможно, я смогу найти способ вернуть ее домой.~
@28837 = ~Ингресс попала в город с помощью одной из дверей на ее родном плане... она напела какой-то мотив на поляне под двумя поваленными друг на друга деревьями и открыла портал в этот город. Она вошла в него, и с тех пор она не может найти дорогу назад.~
@28838 = ~Ингресс предупредила меня о «дверях» в городе... она утверждает, что любое ограниченное пространство — картинная рама, арка, окно — любая из этих вещей может стать порталом в некоторое место, при условии, что у тебя рядом с ним есть подходящий ключ. Эти ключи могут быть чем угодно... материальным и нематериальным: железный гвоздь, мысль, продуманная три раза, стеклянная роза, эмоция... все это может открыть дверь в некоторое место.~
@28839 = ~В городе возле Морга я встретил покалеченную женщину по имени Ингресс. Она сильно обезображена — без сомнения, полученные ею раны отразились на ее разуме.~
@28840 = ~«Прости, что побеспокоил тебя, Ингресс. Будь осторожна».~
@28841 = ~«Его зовут Кандриан. Он скоро должен прийти, чтобы помочь тебе... верь ему, хорошо?»~
@28842 = ~«Я вернусь и встречусь с Кандрианом в баре 'Тлеющий труп', и проверю, чтобы все было хорошо. Крепись, Ингресс».~
@28843 = ~«Нет, я не Кандриан... он скоро должен подойти, чтобы помочь тебе. Я встречусь с ним снова в баре 'Тлеющий труп' и прослежу, чтобы все было хорошо. Крепись, Ингресс».~
@28844 = ~«Нет, я не Кандриан... Кандриану не повезло и он умер. К счастью, это означает, что ты и Кандриан когда-нибудь встретитесь. Прощай».~
@28845 = ~*Вздох*~
@28846 = ~«Ради чего я охраняю сломанную машину?»~
@28847 = ~«Хм-м, какое расточительство».~
@28848 = ~«Хм-м, какое расточительство».~
@28849 = ~«Слишком большая для оружия».~
@28850 = ~«БОГОЛЮДИ ЗНАЮТ ЧТО ПОЧЕМ».~
@28851 = ~«ТЛЕННЫЕ ДУМАЮТ, ЧТО ЖИЗНЬ — ЭТО ШУТКА...»~
@28852 = ~«ОНИ ЛИШЬ НАПОЛНЯЮТ МНОЖЕСТВОМ СОМНЕНИЙ»~
@28853 = ~«Хорошо. Я вернусь, и ты отдашь мне Морта. Прощай».~
@28854 = ~«Ну ладно. Как мне достать другой череп, который стоит этого?»~
@28855 = ~«Просто мне верни его. Он мой».~
@28856 = ~«Ну ладно. Как мне найти ценный череп?»~
@28857 = ~«Я так не думаю. Верни мне его, или ответишь за это».~
@28858 = ~«Ладно, ладно».~
@28859 = ~«У меня много вопросов».~
@28860 = ~«У меня много вопросов».~
@28861 = ~«У меня много вопросов».~
@28862 = ~«У меня много вопросов».~
@28863 = ~«У меня много вопросов».~
@28864 = ~«У меня много вопросов».~
@28865 = ~«У меня много вопросов».~
@28866 = ~«У меня много вопросов».~
@28867 = ~«У меня много вопросов».~
@28868 = ~«У меня много вопросов».~
@28869 = ~«У меня много вопросов».~
@28870 = ~«Расскажи мне об этой Равель».~
@28871 = ~«Кто это?»~
@28872 = ~«Я потерял свою смертность? О чем это ты?»~
@28873 = ~«Я потерял свою смертность? О чем это ты?»~
@28874 = ~«В лабиринты? Как мне ее найти?»~
@28875 = ~«Что она сделала?»~
@28876 = ~«Понятно. Спасибо. Прощай, Лотар».~
@28877 = ~«Что сделала Равель?»~
@28878 = ~«Спасибо, Лотар. Прощай».~
@28879 = ~~
@28880 = ~«Начнем с того, что... он никогда не был твоим... и ничьим вообще».~
@28881 = ~«Он мой».~
@28882 = ~«Где мне найти ценный череп?»~
@28883 = ~«Тогда я найду ее и заставлю вернуть мне смертность. Прощай».~
@28884 = ~Выполнен спасбросок: устойчивость к смерти~
@28885 = ~Выполнен спасбросок: устойчивость к жезлам~
@28886 = ~Выполнен спасбросок: устойчивость к полиморфизму~
@28887 = ~Выполнен спасбросок: устойчивость к дыханию~
@28888 = ~Выполнен спасбросок: устойчивость к заклинаниям~
@28889 = ~Спасбросок провален: устойчивость к жезлам~
@28890 = ~Спасбросок провален: устойчивость к магии~
@28891 = ~Спасбросок провален: устойчивость к полиморфизму~
@28892 = ~Спасбросок провален: устойчивость к дыханию~
@28893 = ~Спасбросок провален: устойчивость к заклинаниям~
@28894 = ~Спасбросок провален: устойчивость к смерти~
@28895 = ~Исцеление:~
@28896 = ~Грация благодарит мужчину кивком и улыбкой: «Вы так любезны, сэр».~
@28897 = ~Статуя не отвечает.~
@28898 = ~Статуя не отвечает.~
@28899 = ~Ты дотрагиваешься до статуи и обнаруживаешь, что хотя одежда, украшающая ее, сделана из серой ткани, а не из камня, «кожа» ее холодна и тверда как гранит.~
@28900 = ~Статуя, как и раньше, остается безразличной к твоим вопросам.~
@28901 = ~«Статуя» двигается... еле-еле, почти незаметно, но определенно кивает.~
@28902 = ~«Статуя», как и раньше, продолжает молчать.~
@28903 = ~По-прежнему нет ответа.~
@28904 = ~Глаза изваяния открываются; оно смотрит на тебя холодными серыми глазами. Говорит оно неспешно, голосом, напоминающим трущиеся друг о друга валуны. «Твое терпение... отмечено. Теперь Ки-Саи будет... говорить... с тобой».~
@28905 = ~Глаза изваяния открываются; оно смотрит на тебя холодными серыми глазами. Говорит оно неспешно, голосом, напоминающим трущиеся друг о друга валуны. «Твое терпение... отмечено. Теперь Ки-Саи будет... говорить... с тобой».~
@28906 = ~Ты уже было думаешь, что он тебя не услышал, когда он отвечает: «Спрашивай».~
@28907 = ~После молчаливой паузы он произносит: «Спрашивай».~
@28908 = ~«Меня зовут... Ки-Саи».~
@28909 = ~«Ки-Саи... размышляет. Также Ки-Саи... обучает... других искусству... боя».~
@28910 = ~Он осматривает тебя сверху донизу, издавая низкий рокот. Потом медленно обхватывает одну руку другой и отламывает один из своих ногтей с резким *хрум*. «Ки-Саи хочет посмотреть, как ты... сломаешь этот камень». Он дает тебе осколок камня.~
@28911 = ~Ты стараешься изо всех сил, но не можешь сломать камень. «Ки-Саи находит тебя... неподходящим... слишком слабым... для обучения искусству боя». Он берет у тебя камень и кладет его себе в рот, затем разжевывает его в пыль с резким хрустом.~
@28912 = ~Приложив некоторое усилие, ты разламываешь осколок камня надвое. Он берет у тебя осколки и кладет их себе в рот, затем разжевывает их в пыль с резким хрустом. «Ки-Саи находит тебя... физически подходящим. Теперь Ки-Саи спрашивает тебя... зачем... тебе это обучение?»~
@28913 = ~«Тогда Ки-Саи не видит... надобности... в схватке».~
@28914 = ~«Ки-Саи имеет в виду, что... есть много способов... сделать это. Можно... украсть оружие противника... оставив его... беззащитным».~
@28915 = ~«Ки-Саи не видит... надобности. Тебе не удалось убедить Ки-Саи... в обратном. Возможно, тебе следует поговорить... со здешним наставником воров. Если ты не хочешь учиться под его началом... он может предоставить контраргументы моим доводам».~
@28916 = ~Через некоторое время он кивает. «Можно... спрятаться. Если тебя нельзя увидеть... на тебя нельзя напасть. Ты... неуязвим».~
@28917 = ~Через некоторое время он кивает. «Могучие чары... могут поразить множество врагов... быстрее... чем любой клинок».~
@28918 = ~Он слегка улыбается, из его глотки слышится глухой рокот. «Ки-Саи находит тебя... подходящим для обучения. Встретимся... в тренировочном зале».~
@28919 = ~Когда ты наносишь изваянию удар, его глаза мгновенно раскрываются, и оно ловит твой кулак железной хваткой. Сузив свои холодные серые глаза, оно произносит голосом, напоминающим трущиеся друг о друга камни: «Зачем... ты... бьешь Ки-Саи?»~
@28920 = ~Он медленно кивает, хмурясь. «Ты... прощен. Однако... чувствуется, что тебе не хватает... терпения».~
@28921 = ~«Ки-Саи не хотел... никого обманывать. Ки-Саи... находит тебя... безрассудным... и грубым».~
@28922 = ~Он закрывает глаза и стает даже еще более тихим.~
@28923 = ~«Я... из расы... каменных принцев. Ки-Саи... генаси земли».~
@28924 = ~Он гордо кивает. «Отец Ки-Саи... существо стихии земли... Дао. Мать Ки-Саи... человеческая женщина... благородных кровей. Вот что значит быть... генаси земли».~
@28925 = ~«Ничего».~
@28926 = ~«Это... Городской Фестхолл. Хочешь узнать больше... спроси... других».~
@28927 = ~Статуя все еще стоит здесь, как всегда неподвижная и молчаливая.~
@28928 = ~«Статуя» все еще стоит здесь, как всегда неподвижная и молчаливая.~
@28929 = ~«Ки-Саи приветствует тебя».~
@28930 = ~«Не... говори. Иди... в тренировочный зал».~
@28931 = ~Он холодно смотрит на тебя глазами из гранита. «Ты здесь... чтобы учиться у Ки-Саи?»~
@28932 = ~«Ты... воин по профессии?»~
@28933 = ~«Ки-Саи искусен... с любым оружием, не специализируется... на одном... владеет многими. Чему ты будешь учиться... у Ки-Саи?»~
@28934 = ~«Ты не можешь... изучить больше... в данный момент. Возвращайся к... Ки-Саи... когда станешь... более опытным».~
@28935 = ~«Тогда Ки-Саи... обучит тебя».~
@28936 = ~«Ки-Саи... рад... такому... ученику как ты. Ты учишься... быстро».~
@28937 = ~Оценив твое мастерство, Ки-Саи качает головой. «Ки-Саи считает, что ты... уже достаточно искусен в этой... форме боя. Ки-Саи не может... научить тебя большему. Если хочешь... лучше изучить это оружие... найди Корура в Нижнем Районе».~
@28938 = ~«Ки-Саи обучит тебя... искусству... кулачного боя. Это то... чего ты хочешь?»~
@28939 = ~«Ки-Саи обучит тебя... искусству боя... мечом. Это то... чего ты хочешь?»~
@28940 = ~«Ки-Саи обучит тебя... искусству боя... булавой. Это то... чего ты хочешь?»~
@28941 = ~«Ки-Саи обучит тебя... искусству боя... топором. Это то... чего ты хочешь?»~
@28942 = ~«Ки-Саи обучит тебя... искусству боя... большим молотом. Это то... чего ты хочешь?»~
@28943 = ~Оценив твое мастерство, Ки-Саи кивает и издает низкой рокот. «Ки-Саи считает, что ты... готов... лучше изучить... большой молот».~
@28944 = ~«Ки-Саи хочет, чтобы ты знал... вот что: когда ты начнешь изучать мастерство владения... молотом... ты не сможешь изучать... другое оружие. Это то... чего ты хочешь?»~
@28945 = ~Рот Ки-Саи медленно искривляется в гримасе неодобрения. «Тогда Ки-Саи не может... научить тебя ничему».~
@28946 = ~Левая бровь Ки-Саи ну очень медленно поднимается. «Ты... бросишь свою текущую специализацию, чтобы встать... на путь воина?»~
@28947 = ~«Ки-Саи размышляет о... Пути Камня».~
@28948 = ~Ки-Саи кивает. «Это... философия. Это... метод боя. С его помощью... Ки-Саи пытается достичь... неуязвимости».~
@28949 = ~«Да. Сейчас... Путь еще... несовершенен. Когда-нибудь Ки-Саи... сделает его совершенным. Ки-Саи... знает это».~
@28950 = ~Ки-Саи кивает. «Никто не просил... Ки-Саи поделиться его познанием... Пути. Теперь Ки-Саи... сделает это». Он начинает рассказывать, подробно, медленно и старательно...~
@28951 = ~После часов выслушивания и огромного количества вопросов ты начинаешь понимать, сколь малому Ки-Саи может научить тебя в своем Пути Камня. В бою ты можешь использовать его, чтобы выдерживать и отражать удары врага, что улучшает твой Класс Брони.~
@28952 = ~После часов выслушивания и огромного количества вопросов ты все же не можешь понять Путь Камня Ки-Саи. Его идеи попросту слишком сложны и чужды тебе, чтобы ты мог охватить его.~
@28953 = ~«Приветствую...»~
@28954 = ~«Приветствую...»~
@28955 = ~«Я встретил мага по имени Салабеш, который рассказывал, что здесь есть каменный человек. Ты и есть он?»~
@28956 = ~«Приветствую... ты Ки-Саи?»~
@28957 = ~Прикоснуться к изваянию.~
@28958 = ~Уйти.~
@28959 = ~«Я встретил мага по имени Салабеш, который рассказывал, что здесь есть каменный человек. Ты и есть он?»~
@28960 = ~Прикоснуться к изваянию.~
@28961 = ~Уйти.~
@28962 = ~«Э... шеф? Ты ведь раньше видел статуи? Ты ведь знаешь, что они не разговаривают?»~
@28963 = ~«Ну... э... м-м. Тут ты прав, босс».~
@28964 = ~«Шеф, может, она слишком анатомически правильная?»~
@28965 = ~«Конечно, босс. Я это знал».~
@28966 = ~Морт закатывает глаза и издает бульканье. «О силы, нет, только не еще один пень, говорящий... вот... так!»~
@28967 = ~«Подумай, Морт: ты — летающий и говорящий череп, который отрицает существование живых статуй».~
@28968 = ~«Я встретил здесь мага по имени Салабеш, который говорил о каменном человеке. Это ты?»~
@28969 = ~«Может быть. Я просто к нему прикоснусь...»~
@28970 = ~Уйти.~
@28971 = ~«Я встретил здесь мага по имени Салабеш, который говорил о каменном человеке. Это ты?»~
@28972 = ~«Конечно, Морт. Я просто к нему прикоснусь...»~
@28973 = ~Уйти.~
@28974 = ~«Это был риторический вопрос, Морт»~
@28975 = ~«Я встретил здесь мага по имени Салабеш, который говорил о каменном человеке. Это ты?»~
@28976 = ~Ударить статую.~
@28977 = ~Уйти.~
@28978 = ~«У меня есть вопросы о тебе...»~
@28979 = ~«У меня есть вопросы об этом месте».~
@28980 = ~«Что ты знаешь о Равель Заморочке?»~
@28981 = ~«Я потом к тебе загляну. Прощай».~
@28982 = ~«Хм-м. Зачем кому-то одевать статую?»~
@28983 = ~«Хм-м. Зачем кому-то одевать статую?»~
@28984 = ~«Я встретил мага по имени Салабеш, который рассказывал, что здесь есть каменный человек. Ты и есть он?»~
@28985 = ~Ударить статую.~
@28986 = ~Уйти.~
@28987 = ~«Я встретил мага по имени Салабеш, который рассказывал, что здесь есть каменный человек. Ты и есть он?»~
@28988 = ~Ударить статую.~
@28989 = ~Уйти.~
@28990 = ~«Хорошо. У меня есть несколько вопросов...»~
@28991 = ~«Я так и думал. Прощай».~
@28992 = ~«Привет? Как насчет моих вопросов?»~
@28993 = ~«Хмм. Тогда прощай».~
@28994 = ~Подождать ответ.~
@28995 = ~Продолжать ждать.~
@28996 = ~Сдаться и уйти.~
@28997 = ~~
@28998 = ~Сдаться и уйти.~
@28999 = ~«У меня есть вопросы о тебе...»~
@29000 = ~«У меня вопрос на счет этого места».~
@29001 = ~«Что тебе известно о Равель Заморочке?»~
@29002 = ~«Я к тебе потом загляну. Прощай».~
@29003 = ~«У меня есть вопросы о тебе...»~
@29004 = ~«У меня вопрос на счет этого места».~
@29005 = ~«Что тебе известно о Равель Заморочке?»~
@29006 = ~«Неважно. Прощай».~
@29007 = ~«Над чем ты размышлял, когда я впервые встретил тебя?»~
@29008 = ~«Кто ты?»~
@29009 = ~«Чем ты здесь занимаешься?»~
@29010 = ~«Вообще-то, у меня есть другие вопросы...»~
@29011 = ~«Неважно. Прощай».~
@29012 = ~«Так кто же ты такой?»~
@29013 = ~«Чем ты здесь занимаешься?»~
@29014 = ~«У меня есть другие вопросы...»~
@29015 = ~«Это все, что я хотел узнать. Прощай».~
@29016 = ~«Над чем это ты размышлял?»~
@29017 = ~«Ты можешь обучить меня?»~
@29018 = ~«Кто ты?»~
@29019 = ~«У меня есть другие вопросы...»~
@29020 = ~«Это все, что я хотел узнать. Прощай».~
@29021 = ~Разломать камень.~
@29022 = ~Разломать камень.~
@29023 = ~«А вообще, неважно. У меня есть другие вопросы...»~
@29024 = ~«Сейчас я должен уйти; вот камень. Прощай».~
@29025 = ~«Тогда у меня есть еще вопросы...»~
@29026 = ~«В таком случае, прощай».~
@29027 = ~«Для самозащиты».~
@29028 = ~«Чтобы сокрушать моих врагов».~
@29029 = ~«Чтобы сокрушать моих врагов».~
@29030 = ~«Неважно. Позволь мне спросить кое о чем другом...»~
@29031 = ~«Пока что я не знаю. Прощай».~
@29032 = ~«Что ты имеешь в виду?»~
@29033 = ~«Забудь. Позволь мне спросить кое о чем еще...»~
@29034 = ~«В таком случае, прощай».~
@29035 = ~«Но битву все еще нужно выиграть. Было бы ошибкой полагаться на воровство».~
@29036 = ~«Но битву все еще нужно выиграть. Было бы ошибкой полагаться на воровство».~
@29037 = ~~
@29038 = ~«Значит, ты не хочешь тренировать меня?»~
@29039 = ~~
@29040 = ~~
@29041 = ~«Позволь мне тогда спросить кое о чем еще...»~
@29042 = ~«В таком случае, прощай».~
@29043 = ~«Но еще ни один вор не овладел скрытностью до такой степени. И от некоторых врагов не спрятаться; твой запах или даже мысли выдадут тебя».~
@29044 = ~«Но еще ни один вор, даже Илай, не овладел скрытностью до такой степени. И от некоторых врагов не спрятаться; твой запах или даже мысли выдадут тебя».~
@29045 = ~«Значит, ты не хочешь тренировать меня?»~
@29046 = ~~
@29047 = ~~
@29048 = ~«Маги — словно бутылки с горючим маслом... могущественны, но если их использовать, больше ничего из себя не представляют. Они физически немощны, их заклинания — словно костыли, восполняющие их неполноценность. Когда магия потрачена, суть битвы все еще остается».~
@29049 = ~~
@29050 = ~«Значит, ты не хочешь тренировать меня?»~
@29051 = ~~
@29052 = ~~
@29053 = ~«Скоро я буду там».~
@29054 = ~«Сейчас мне нужно кое-что посмотреть. Я приду туда позже».~
@29055 = ~«Прости, я всего лишь хотел проверить, точно ли ты статуя».~
@29056 = ~«Так тебе и надо за то, что хотел меня обмануть».~
@29057 = ~«Забудь о том, что случилось. Прощай».~
@29058 = ~«Возможно. У меня есть несколько вопросов...»~
@29059 = ~«Возможно. Прощай».~
@29060 = ~«Прости, я всего лишь хотел проверить, точно ли ты статуя».~
@29061 = ~«Очень жаль. У меня есть несколько вопросов...»~
@29062 = ~«Тогда прощай». ~
