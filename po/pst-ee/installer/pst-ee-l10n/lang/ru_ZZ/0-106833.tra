@46738 = ~~
@46739 = ~~
@46740 = ~~
@46741 = ~~
@46742 = ~~
@46743 = ~~
@46744 = ~~
@46745 = ~На лбу этого очень мускулистого трупа масса шрамов, как будто при жизни в бою он бил своих врагов головой, как дубиной. Номер «1508» вышит на лбу красными нитками, рот зашит грубой черной ниткой. От него слегка отдает бальзамирующей жидкостью.~
@46746 = ~«Итак... что тут у нас интересного?»~
@46747 = ~Труп продолжает пялиться на тебя.~
@46748 = ~Оставить труп в покое.~
@46749 = ~«Итак... что тут у нас интересного?»~
@46750 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@46751 = ~Использовать на трупе свою способность «История костей».~
@46752 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@46753 = ~Оставить труп в покое.~
@46754 = ~«Было приятно с тобой поболтать. Прощай».~
@46755 = ~Оставить труп в покое.~
@46756 = ~Тело этого трупа сплошь покрыто пятнами, его уши, кончик носа и некоторые пальцы сгнили напрочь... скорее всего, мужчина стал жертвой какой-то ужасной болезни. На лбу у него вытатуирован номер «1445», а его губы крепко сшиты.~
@46757 = ~«Итак... что тут у нас интересного?»~
@46758 = ~Труп продолжает пялиться на тебя.~
@46759 = ~Оставить труп в покое.~
@46760 = ~«Итак... что тут у нас интересного?»~
@46761 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@46762 = ~Использовать на трупе свою способность «История костей».~
@46763 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@46764 = ~Оставить труп в покое.~
@46765 = ~«Было приятно с тобой поболтать. Прощай».~
@46766 = ~Оставить труп в покое.~
@46767 = ~«Простите, сэр. Никому туда нельзя, пока не вернется фрактор Сандоз. Вы не можете туда войти».~
@46768 = ~«Что ты можешь рассказать о нем?»~
@46769 = ~Из-за двери слышится приглушенный голос. «Поди прочь!»~
@46770 = ~«Ты Сандоз?»~
@46771 = ~Пустой прицел~
@46772 = ~Кубические арбалетные стрелы~
@46773 = ~Сферические арбалетные стрелы~
@46774 = ~Пирамидальные арбалетные стрелы~
@46775 = ~Арбалетные стрелы Зефира~
@46776 = ~Свистящие арбалетные стрелы~
@46777 = ~Расщепленные арбалетные стрелы~
@46778 = ~Крылатые арбалетные стрелы~
@46779 = ~Зазубренные арбалетные стрелы~
@46780 = ~Клыкастые арбалетные стрелы~
@46781 = ~Жилет Анны~
@46782 = ~Прежде чем продолжить, ты должен потратить все свои очки персонажа.~
@46783 = ~OK~
