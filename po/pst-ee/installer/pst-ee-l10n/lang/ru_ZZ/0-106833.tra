@13607 = ~«Тогда неважно».~
@13608 = ~Притвориться, что изучаешь его, подменить пергамент фальшивым контрактом, после чего вернуть его Мортаю.~
@13609 = ~Притвориться, что изучаешь его, подменить пергамент фальшивым контрактом, после чего вернуть его Мортаю.~
@13610 = ~Притвориться, что изучаешь его, подменить пергамент фальшивым контрактом, после чего вернуть его Мортаю.~
@13611 = ~«Хорошо... похоже, с ним все в порядке».~
@13612 = ~~
@13613 = ~«Я хотел бы выкупить контракт, который ты заключил с Ангиаром».~
@13614 = ~«А контракт, который ты заключил с Ангиаром, при тебе?»~
@13615 = ~«Могу ли я еще раз взглянуть на контракт Ангиара?»~
@13616 = ~«Ладно, неважно. У меня есть другие вопросы...»~
@13617 = ~«Я просто интересовался. Прощай».~
@13618 = ~«Что-то не так?»~
@13619 = ~«Прощай, Мортай».~
@13620 = ~«Может быть. Я тебя не припоминаю».~
@13621 = ~«Нет, не думаю».~
@13622 = ~«Прощай, Мортай».~
@13623 = ~«Прощай, Мортай».~
@13624 = ~Уйти.~
@13625 = ~«У меня есть к тебе вопросы...»~
@13626 = ~«Неважно. Я должен идти».~
@13627 = ~«Контракт?»~
@13628 = ~«Контракт?»~
@13629 = ~«Не ты ли подписал подписал Контракт Смерти с Ангиаром?»~
@13630 = ~«Могу ли я посмотреть на контракт, который ты заключил с Ангиаром?»~
@13631 = ~«Нет, у меня есть несколько вопросов...»~
@13632 = ~«Не думаю, что ты можешь помочь мне. Мне нужно идти».~
@13633 = ~«У меня есть к тебе вопросы...»~
@13634 = ~«Неважно. Я должен идти».~
@13635 = ~«Я хочу подписать контракт».~
@13636 = ~«Я хочу подписать контракт».~
@13637 = ~«А что за проблема с проявлением эмоций?»~
@13638 = ~«Прошу прощения, но я не хочу подписывать контракт. Однако у меня есть вопросы...»~
@13639 = ~«Я не хотел никого оскорблять... но думаю, что ты не сможешь мне помочь. Прощай».~
@13640 = ~Подождать, пока он не вернется...~
@13641 = ~Притвориться, что изучаешь его, подменить пергамент фальшивым контрактом, после чего вернуть его Мортаю.~
@13642 = ~Притвориться, что изучаешь его, подменить пергамент фальшивым контрактом, после чего вернуть его Мортаю.~
@13643 = ~Притвориться, что изучаешь его, подменить пергамент фальшивым контрактом, после чего вернуть его Мортаю.~
@13644 = ~«Хорошо... похоже, с ним все в порядке».~
@13645 = ~~
@13646 = ~«Я хотел бы выкупить этот контракт».~
@13647 = ~«Могу ли я еще раз взглянуть на контракт Ангиара?»~
@13648 = ~«Да, но меня есть еще вопросы...»~
@13649 = ~«Да, это все, что я хотел узнать. Прощай».~
@13650 = ~Вернуть ему контракт.~
@13651 = ~~
@13652 = ~Вернуть ему «Контракт Ангиара».~
@13653 = ~«Вообще-то, неважно. Лучше я задам несколько вопросов...»~
@13654 = ~«Вообще-то, неважно. Лучше я задам несколько вопросов...»~
@13655 = ~«Прощай».~
@13656 = ~Оставить его в покое.~
@13657 = ~Он бросает на тебя беглый взгляд и начинает отворачиваться, но, передумав, поворачивается к тебе. Он пробегается взглядом по твоему телу сверху вниз, покачивая головой. «Какой кошмар, рубака. Столько шрамов я еще ни у кого не видел. Что ты делал? Дрался голыми руками с ордами Баатора?»~
@13658 = ~«У меня к тебе несколько вопросов».~
@13659 = ~«Не твое дело, старик».~
@13660 = ~«Я бывал в нескольких битвах, и теперь шрамы могут это подтвердить».~
@13661 = ~«Что здесь происходит?»~
@13662 = ~«Неважно».~
@13663 = ~Он хмурится. «Ты что, увидал на мне татуировку 'мудрец'?» Он смотрит на тебя, как будто действительно ожидает ответа на свой вопрос.~
@13664 = ~«Э-э-э... Да вроде нет. Я просто подумал, что человек в твоих годах сумел получить огромный опыт, которым он мог бы поделиться с теми, кто не так удачлив...»~
@13665 = ~«Послушай, мне просто нужны ответы. Ты сможешь дать их мне?»~
@13666 = ~«А, неважно. Прощай».~
@13667 = ~Постепенно его хмурое лицо расплывается в улыбке. «А ты забавный малый, рубака. 'Огромный опыт', чтоб его! — он умолкает на несколько секунд. — Ну хорошо, ты заслужил ответы. Чем я могу тебе помочь?»~
@13668 = ~«Прежде всего, что здесь происходит?»~
@13669 = ~Он кивает через плечо. «Видишь мясника? Сейчас какой-то бедолага лишится головы. Такое не каждый день увидишь».~
@13670 = ~«А какое преступление он совершил?»~
@13671 = ~«О. Я хотел бы спросить у тебя кое-что еще».~
@13672 = ~«Понятно. Что ж, спасибо за уделенное время. Прощай».~
@13673 = ~«Точно не знаю. Может, убил какого-нибудь доходягу, или, может, его кто-то кинул и положил под топор. В этом городишке ничего не скажешь наверняка».~
@13674 = ~«Кинул?»~
@13675 = ~«У меня к тебе другие вопросы».~
@13676 = ~«О... Спасибо. Хорошего дня».~
@13677 = ~Он смеется. «Ты ведь недавно здесь? Кинуть — значит подставить, предать, вогнать заточку под дых. В Проклятом такое иногда случается».~
@13678 = ~«Понятно. Расскажи мне кое о чем еще...»~
@13679 = ~«Хм-м. Мне пора, прощай».~
@13680 = ~Он хмуро смотрит на тебя и делает неприличный жест. «Наденься на кол, пень!» Он отворачивается от тебя.~
@13681 = ~Оставить его в покое.~
@13682 = ~Он согласно кивает. «Это точно. Что хочешь от меня?»~
@13683 = ~«У меня к тебе несколько вопросов».~
@13684 = ~«Расскажи, что здесь происходит».~
@13685 = ~«На самом деле — ничего. Прощай».~
@13686 = ~«Конечно». Он ждет твой вопрос.~
@13687 = ~«Я ищу одного дэва. Я слышал, что он где-то в Проклятом».~
@13688 = ~«Что ты можешь сказать о Проклятом?»~
@13689 = ~«Кто здесь всем управляет?»~
@13690 = ~«Какие местные новости?»~
@13691 = ~«Неважно. Прощай».~
@13692 = ~«Ходят слухи, что дэва в городе... Только не представляю, где он может быть. Дэва в городе уж точно привлек бы к себе много внимания, — он задумывается. — У меня нет для тебя ответа. Попробуй порасспрашивать кого-нибудь еще. Наверно, кто-нибудь видел его».~
@13693 = ~«Еще один вопрос».~
@13694 = ~«Ты был очень полезен. Мне пора».~
@13695 = ~Он задумчиво оглядывается по сторонам. «Проклятый — это просто огромная навозная куча. Здесь рубаке нужно глядеть в оба... Вот и все, что я могу сказать».~
@13696 = ~«Хорошо. Позволь мне спросить еще кое о чем...»~
@13697 = ~«Спасибо за помощь. Прощай».~
@13698 = ~«Наверное, Товус Гильяф. Его можно найти в административном здании. Только один совет: не суй свой нос в его дела, иначе можешь запросто лишиться головы». Ребром руки он разрубает воздух, словно гильотина.~
@13699 = ~«Я запомню это. Еще одна вещь...»~
@13700 = ~«Понятно. Я должен идти. Прощай».~
@13701 = ~На секунду он крепко задумывается. «Ну... Говорят, дочь Гниющего Копчика пропала, из-з чего он немного не в себе. Помимо этого, нет ничего достойного упоминания».~
@13702 = ~«Кто такой Гниющий Копчик?»~
@13703 = ~«У меня к тебе другой вопрос».~
@13704 = ~«Спасибо за помощь. Прощай».~
@13705 = ~«Он — хозяин Ворот предателей, местной дыры для пьяниц. Кажется, она вон там». Он указывает в неопределенном направлении.~
@13706 = ~«Расскажи мне еще кое о чем».~
@13707 = ~«Я должен идти. Прощай».~
@13708 = ~Игнорировать его.~
@13709 = ~Поначалу тебе кажется, что он не слышит тебя, но затем поворачивает голову, окидывая тебя беглым взглядом. Спустя секунду он отворачивается. «Я не знаю тебя, пень, и знать не хочу. Уходи, я не хочу причинять тебе вреда».~
@13710 = ~«Послушай, я просто хочу задать тебе несколько вопросов».~
@13711 = ~«Ты угрожаешь не тому человеку, идиот. Просто ответь на мои вопросы, и я не буду учить тебя манерам».~
@13712 = ~Напасть на его.~
@13713 = ~«Отлично. Тогда я ухожу».~
@13714 = ~Он поворачивается к тебе снова, его лицом побагровело от гнева. Стиснув зубы, он отвечает: «Вопросы? Пень, я что, похож на местного мудреца? Прочь с глаз моих, пока я не добавил к твоим шрамам еще парочку».~
@13715 = ~«Ты угрожаешь не тому человеку, идиот. Просто ответь на мои вопросы, и я не буду учить тебя манерам».~
@13716 = ~«Посмотрим, что у тебя получится».~
@13717 = ~«Отлично, тогда я ухожу».~
@13718 = ~Он разворачивается, меча яростные молнии. Не успев что-то сказать, он вдруг останавливается и присматривается к тебе. И пока он разглядывает те многочисленные шрамы, которыми покрыто твое тело, его гнев утихает и превращается в страх. «О... Извини, рубака. Что за темноту ты хочешь развеять?»~
@13719 = ~«Я ищу одного дэва. Я слышал, что его можно найти здесь».~
@13720 = ~«Какие местные новости?»~
@13721 = ~«Расскажи мне о Проклятом».~
@13722 = ~«Неважно».~
@13723 = ~Нахмурившись, он на секунду отворачивается от тебя. «Ошибся привратным городом, рубака. Дэва сюда не попадают, по крайней мере, я об этом не слышал».~
@13724 = ~«Хорошо. Тогда у меня есть другие вопросы».~
@13725 = ~«Спасибо. Еще увидимся».~
@13726 = ~«Не могу сказать. Я стараюсь никуда не вляпываться и держаться подальше от чужих забот. Это серьезно продлевает жизнь». Он умолкает. Кажется, он немного нервничает. «Только без обид... но тебе лучше делать то же самое».~
@13727 = ~«Я запомню это. Позволь мне спросить кое о чем еще».~
@13728 = ~«Занятно... Что-то я не припомню, чтобы я просил у тебя совет. Еще одна такая оговорка — и ты об этом сильно пожалеешь».~
@13729 = ~«Спасибо за совет. Еще увидимся».~
@13730 = ~Он хмыкает и озирается по сторонам перед тем, как ответить. «Его назвали Проклятым не просто так, рубака. Это место — тюрьма для всех бедолаг, которые набедокурили в своей жизни. И самое печальное то, что большинство пней даже не подозревают, что они — пленники».~
@13731 = ~«Тюрьма?»~
@13732 = ~«Теперь понятно. Еще вопрос».~
@13733 = ~«Ладно, спасибо за информацию».~
@13734 = ~«Конечно. Что ты хочешь знать?»~
@13735 = ~«Я ищу одного дэва. Я слышал, что его можно найти здесь».~
@13736 = ~«Какие местные новости?»~
@13737 = ~«Расскажи мне о Проклятом».~
@13738 = ~«Неважно».~
@13739 = ~Пытаясь справиться с собой, он подавляет новую вспышку гнева. «Извини, больше не повторится. Ты, э-э-э, еще что-то хочешь?»~
@13740 = ~«Ага, у меня есть несколько вопросов к тебе».~
@13741 = ~«Нет, это все».~
@13742 = ~Оглянувшись по сторонам, он наклоняется к тебе поближе. «Да, этого не заметить с первого взгляда, но Проклятый — настоящая тюрьма. Попробуй уйти отсюда — и ты поймешь, что я имею в виду. Ты не сможешь пройти через городские ворота, если у тебя нет на то веских причин». Он снова оглядывается и умолкает. «Больше я ничего не могу сказать».~
@13743 = ~«Хм-м. Позволь мне спросить кое о чем еще».~
@13744 = ~«Спасибо. Еще увидимся».~
@13745 = ~Услышав, как ты воешь, человек начинает кружить перед тобой, затем криво оскаливается и запрокидывает голову, подхватывая твой вой. Через несколько мгновений он останавливается, затем продолжает скакать, рычать и лаять, словно какой-то одичавший пес.~
@13746 = ~Его лай оканчивается рыком, и он набрасывается на тебя!~
@13747 = ~Этот человек с бешеными глазами все еще скачет, лает и завывает на всю мощь своих легких.~
@13748 = ~«Да, вот уж у кого шарики за ролики заехали, — Морт закатывает глаза. — Бессмысленно общаться с хаоситеками, шеф. Они все из ума выжили».~
@13749 = ~«Они типа 'фракция', у которой нет никаких правил... кроме того, чтобы не держать у себя в голове одну мысль слишком долго. Иногда их еще называют хаоситами. Полагаю, нет нужды объяснять почему».~
@13750 = ~«Они просто привлекают новых людей, словно мух... наверное, тех, кто и так уже достаточно спятил или хаотичен. Не думаю, что у них есть для этого вербовщики... хотя наверняка на их счет ничего нельзя сказать».~
@13751 = ~Ты открываешь рот, но тут тебя перехватывает Анна, шипя: «Ты че, *сбрендил*?! Ни слова ему! Он из Голодных Псов, — она понижает голос. — Хаоситы — пустоголовые, опасные! Они роятся как мухи, так что, скорее всего, рядом есть другие».~
@13752 = ~«Они банда с Улья, к тому же — хаоситы! — она качает головой, затем щелкает тебя хвостом по спине. — Держись от них подальше и смотри в оба. Я уже цапалась с ними: кусают они еще похлеще, чем лают».~
@13753 = ~«Это типа фракция, как трухлявые, законники или чувствующие... только у них нет ни правил, ни убеждений... — Анна скручивает хвост штопором для пущего эффекта. — Они типа чокнутые, свихнувшиеся пустомели, рубишь?» Она на какое-то время задумывается. «Кое-кто зовет их хаоситеками, но им это до лампочки».~
@13754 = ~Анна пожимает плечами. «Без понятия. Приходят, да и все. Как мухи на навоз, наверное».~
@13755 = ~«Приветствую».~
@13756 = ~«Приветствую».~
@13757 = ~Выдать долгий жалобный вой.~
@13758 = ~Выдать долгий жалобный вой.~
@13759 = ~Оставить человека в покое.~
@13760 = ~Оставить человека в покое.~
@13761 = ~«Я *сказал*, 'приветствую'».~
@13762 = ~Зарычать на него, оскалившись.~
@13763 = ~«Э... тогда прощай».~
@13764 = ~«Э... тогда прощай».~
@13765 = ~«Я сказал: приветствую».~
@13766 = ~Зарычать на него, оскалившись.~
@13767 = ~«Э... Что ж, приятно было поболтать».~
@13768 = ~«Э... Что ж, приятно было поболтать».~
@13769 = ~«Если ты так хочешь умереть, волко-человек...»~
@13770 = ~«Приветствую».~
@13771 = ~Выдать долгий жалобный вой.~
@13772 = ~Оставить человека в покое.~
@13773 = ~Оставить человека в покое.~
@13774 = ~«Хаоситеки?»~
@13775 = ~«Еще раз, кто такие хаоситеки?»~
@13776 = ~«Я думал, что смогу что-нибудь у него узнать. Ладно, пойдем отсюда».~
@13777 = ~«А как тогда к ним приходят люди?»~
@13778 = ~«Понятно. Идем».~
@13779 = ~«Понятно. Спасибо за информацию».~
@13780 = ~«Голодный Пес? О чем это ты?»~
@13781 = ~«Голодные Псы? Кто они такие?»~
@13782 = ~«Я все равно с ним поговорю».~
@13783 = ~«Возможно, ты права. Идем».~
@13784 = ~«Хаоситы?»~
@13785 = ~«Еще раз, кто такие хаоситы?»~
@13786 = ~«Я все равно с ним поговорю».~
@13787 = ~«Я думал, что смогу что-нибудь у него узнать. Ладно, пойдем отсюда».~
@13788 = ~«А как тогда к ним приходят новые люди?»~
@13789 = ~«Я все равно с ним поговорю».~
@13790 = ~«Понятно. Идем».~
@13791 = ~«Я все равно поговорю с ним».~
@13792 = ~«Понятно. Спасибо за информацию».~
@13793 = ~Человек прерывает рычание и поднимает руку к занавесу из волос, которым прикрыты его глаза. Когда он откидывает грязные локоны своей иссушенной рукой, несколько странных коричневых букашек выпадают из его волос и разбегаются по мостовой. За волосами кожа бледная, словно луна, и покрыта морщинами. Когда он смотрит на тебя, его широкие косматые брови поднимаются в виде буквы V. «Руку мою возьми, на полетим луну-у-у?»~
@13794 = ~Человек яростно кивает, затем по-детски хлопает в ладоши. «Ответы отдели маслом полусинего! ЗНАЙ! Забудь про свой воп-роус!» Потом он издает длинный переливчатый вой, который прерывает резким лаем.~
@13795 = ~Человек запрокидывает голову и *воет*. Звук этот настолько ужасный, что ты вынужден закрыть уши. Но даже этого недостаточно: как только ты закрываешь уши, вой перерастает в пронзительный визг, который сверлит тебе голову, проникает в уши, под кожу, прокрадывается под череп и пожирает остатки твоего рассудка. Звук настолько ужасен, что ты не в силах даже говорить. ~
@13796 = ~Человек нахмуривается, однако брови его поднимаются в виде буквы Л, образуя странное выражение лица. Ты не представляешь, как он это делает, но от наблюдения за тем, как двигаются мышцы его лица, тебе становится не по себе. Ты не в состоянии определить, зол ли он или удивлен, или и то, и другое, или вообще что-то третье. «Спой-ко поцелуй рас-кажет мужчины, отвеееты прет-почитаю о сердце женщины».~
@13797 = ~Кажется, человек зачарован твоим голосом. С каждым сказанным тобой словом глаза его все больше проясняются. «Лающий Дикар-я, это-я! Хочешь, спросить, можешь-ты, ты-может?»~
@13798 = ~Он восхищенно хлопает в ладоши, словно ребенок на ярмарке, затем отвечает с подвыванием: «Воп-РОУС! Воп-РОУС!»~
@13799 = ~Он нахмуривается, зажмуривает глаза, затем открывает их. Когда он начинает говорить, голос у него уже ровный... как будто говорит другой, более здравомыслящий человек. Эффект пугающий. «Больше одного пропало, больше одного придется тебе найти. Каждый — часть того, что у тебя есть, так что другие должен ты найти». Он моргает и некоторое время трясет головой, будто удивленный самому себе, затем смущенно хихикает.~
@13800 = ~Он уж было собирается возражать, но тут его левый кулак взмывает и бьет его по виску. В ответ он воет, потом внезапно останавливается, моргая. «Один в серванте твоей гостевой комнаты, что в Холле чувствующих, а другой — в стенах запечатанной гробницы глубоко под городом, там, где плачут камни. Другие...» Не успевает он закончить, как его правый кулак поднимается и бьет его по лицу, от чего он снова воет. Некоторое время он моргает и трясет головой, будто удивляясь себе, потом неловко улыбается.~
@13801 = ~Лающий Дикарь разводит руками... похоже, он не помнит, что только что сказал.~
@13802 = ~На миг Лающий Дикарь выглядит испуганным, затем указывает вверх с выражением надежды. «Э... там?» Он сглатывает слюну. Похоже, он не знает, и почему-то ты ему веришь.~
@13803 = ~Лающий Дикарь пожимает плечами, настороженно глядя на тебя. «Может, еще где-то?» Он сглатывает слюну.~
@13804 = ~Лающий Дикарь пожимает плечами, затем отвечает нараспев. «Наоборот? Ни наружу, ни наизнанку, не потерян — не помочь... — он хрипит, будто прочищая горло. — Может, сперва потеряешь его, а потом спросишь меня, а потом наоборот?»~
@13805 = ~«Кха-уос! — произносит он с запинками, как будто ему трудно выговорить это слово. — Некоторые говорят 'Хаоситеки', я же говорю 'Ик-ет-и-соах'. ХАОС-иты. Не люди. Люди не, люди да, три носочка — вот и да, — он приседает и начинает раскачиваться взад-вперед, напевая дискантом: «Хао-сит, хао-сит, скачет-по-дорож-ке, это-фракция-такая, нас-пока-немножко».~
@13806 = ~В ответ он начинает лаять на всю мощь своих легких. Ты видишь, как из его рта потоками вылетает слюна; ты отступаешь, чтобы не попасть под брызги. Через некоторое время он останавливается и издает длинный жалобный вой.~
@13807 = ~Он смотрит на тебя искоса, затем наклоняется вперед, чтобы обнюхать тебя. «Мот... жмот, дохляк... сопляк, бражник... бродяжник, задачник... — он фыркает и ворчит себе под нос. — Неудачник!»~
@13808 = ~Кажется, это первое из сказанного тобой, что смутило Лающего Дикаря. На миг он задумывается, затем рычит и тычет в тебя пальцем. «Человек-хаоса и так уже ты! Уже ты-ты-ты!»~
@13809 = ~В голове Дикаря будто кто-то зажег факел: его глаза распахиваются, и он широко улыбается. Улыбка превращается в оскал, затем в ухмылку. Он начинает скакать и плясать перед тобой. «Умно! Верно! Оно! — он хлопает тебя по плечу обеими руками, затем воет в небо. — Снова ты хаоситек! Во второй раз! В третий раз! Дикобраз!»~
@13810 = ~Дикарь прекращает пританцовывать и устремляет на тебя пристальный взгляд. «Фрактолом скоро станешь ты с такими мозгами, твой разум поплатится за подобные мысли! — он хихикает и вздымает руки вверх. — Грядет безумный король, и планы перевернутся!»~
@13811 = ~Дикарь от неожиданности раскрывает рот. «Ты стал фрактолом — цена, которую твой разум платит за такие мысли! — он указывает на тебя пальцем, словно скипетром. — Склонись, фрактол! Король Хаос-итов! Объявляю тебя мужем плоти и женой хаоса! А теперь можешь поцеловать подпругу!»~
@13812 = ~Услышав тебя, Дикарь поднимает взгляд и раскрывает рот от неожиданности. Он вскакивает на ноги и указывает на тебя пальцем, словно скипетром. «Склонись, фрактол! Король ВСЕХ Хаос-итов! Объявляю тебя мужем плоти и женой хаоса! А теперь можешь поцеловать подпругу!»~
@13813 = ~Дикарь скрещивает руки на груди. «Король хаоса, вот ты кто; фрактол — просто название, которое ты вешаешь на себя, как грязную рубашку».~
@13814 = ~Дикарь пожимает плечами, затем по-хулигански ухмыляется. «Как и в жизни, выбора нет. Удачи тебе в неудачах и богатства в несчастьях! — он сужает глаза. — Ты хочешь сменить титул, изменить свой разум. Первое легче второго, если только ты не тупица!»~
@13815 = ~Дикарь делает низкий поклон и складывает из своих пальцев треугольник. «Ловко, ловко! Теперь уж не фрактол ты! Честность, правила, законы и прочие упрямые вещи — им не место в голове фрактола... — минуту он обдумывает это. — Нет оков! — он нахмуривается, затем пожимает плечами. — И есть оковы! Но нет теперь фрактола».~
@13816 = ~Вы с Дикарем бешено скачете несколько минут подряд, воя в небо. Несколько прохожих кидают на вас странные взгляды, а кто-то издалека начинает кричать, чтобы вы утихли. В конце концов, Дикарь спотыкается, и когда он поднимается, танец заканчивается.~
@13817 = ~Когда ты произносишь эти слова, кажется, что в глазах этого человека загорается искра человечности. Некоторое время он смотрит в небо, затем поднимает левую ногу и заглядывает под нее. Похоже, там он ничего не находит, и потому он вытягивает руки в стороны и поворачивает к ним свои глаза таким образом, что каждый глаз смотрит в противоположную сторону. Потом он трясет головой (попутно возвращая глаза в нормальное состояние) и украдкой смотрит тебе в лицо.~
@13818 = ~Дикарь пожимает плечами. Похоже, его это не особо беспокоит. «Ла-ды, ды-ла, а?»~
@13819 = ~Некоторое время он бормочет себе что-то под нос, потом выкрикивает: «Важно не!» Ты не успеваешь отреагировать, как его рука со свистом описывает в воздухе дугу и бьет тебя по лицу. «Пожаловать добро! Трижды с кхауосом ты!» — хихикает он, в то время как боль в твоем лице понемногу утихает. У тебя странное чувство, будто ты только что был посвящен... и Дикарю это очень нравится.~
@13820 = ~«Назад дороги нет... — бормочет Дикарь, все еще щурясь. — Старую фракцию простить-нет...»~
@13821 = ~Человек рычит, затем усмехается и пальцами изображает рожки на своей голове. «Ничего! — он ухмыляется, потом убирает рожки и взмахивает руками, словно крыльями. — Все! — он сдавленно всхлипывает и вытирает слезы. — Кто ищет — находит, кто находит — ищет... — он хлопает в ладоши. — Какая разница? Не ищи по-году, вы-году, и она сама тебя найдет...»~
@13822 = ~Дикарь кажется неожиданно заинтересованным. «Что у тебя для меня, хм-м-м-м?!»~
@13823 = ~Он смотрит на твои вещи с безразличием. «Ничего! Куча мала бес-делишек! Ничего не стоящее барахло!»~
@13824 = ~Он ворчит и скрещивает руки на груди. Кажется, будто он прячется за своими волосами. «Ниче нет!»~
@13825 = ~Он взвизгивает... «Все! У меня есть все! А все — это ничего, так что лучше уходи СЮДА! — он хнычет как ребенок, схватившись за ногу. — Бедная ножка, бедная ножка, не хотел тебя обидеть...»~
@13826 = ~Внимание Дикаря тут же приковывает один из твоих крысиных хвостиков. Он хватает хвостик с твоей ладони и зажимает его пальцами, будто он — извивающийся червяк. Молниеносно он связывает его в странный узелок и бросает его тебе. «Заколдован, нет сомне-е-ений...» — говорит он неотчетливо, затем хихикает.~
@13827 = ~Ты видишь Лающего Дикаря. Он все еще сидит, сгорбившись, покрытый своими длинными грязными волосами... Кажется, он поглощен собственным рычанием. ~
@13828 = ~«Да, вот уж у кого шарики за ролики заехали, — Морт закатывает глаза. — Бессмысленно общаться с хаоситеками, шеф. Они все из ума выжили».~
@13829 = ~«Они типа 'фракция', у которой нет никаких правил... кроме того, чтобы не держать у себя в голове одну мысль слишком долго. Иногда их еще называют хаоситами. Полагаю, нет нужды объяснять почему».~
@13830 = ~«Они просто привлекают новых людей, словно мух... наверное, тех, кто и так уже достаточно спятил или хаотичен. Не думаю, что у них есть для этого вербовщики... хотя наверняка на их счет ничего нельзя сказать».~
@13831 = ~Ты открываешь рот, но тут тебя перехватывает Анна, шипя: «Ты че, *сбрендил*?! Ни слова ему! Он из Голодных Псов, — она понижает голос. — Хаоситы — пустоголовые, опасные! Они роятся как мухи, так что, скорее всего, рядом есть другие».~
@13832 = ~«Они банда с Улья, к тому же — хаоситы! — она качает головой, затем щелкает тебя хвостом по спине. — Держись от них подальше и смотри в оба. Я уже цапалась с ними: кусают они еще похлеще, чем лают».~
@13833 = ~«Это типа фракция, как трухлявые, законники или чувствующие... только у них нет ни правил, ни убеждений... — Анна скручивает хвост штопором для пущего эффекта. — Они типа чокнутые, свихнувшиеся пустомели, рубишь?» Она на какое-то время задумывается. «Кое-кто зовет их хаоситеками, но им это до лампочки».~
@13834 = ~Анна пожимает плечами. «Без понятия. Приходят, да и все. Как мухи на навоз, наверное».~
@13835 = ~«Приветствую».~
@13836 = ~«Приветствую».~
@13837 = ~«Приветствую».~
@13838 = ~Зарычать на него.~
@13839 = ~Зарычать на него.~
@13840 = ~Зарычать на него.~
@13841 = ~Оставить человека в покое.~
@13842 = ~Оставить человека в покое.~
@13843 = ~«Э, не сегодня. У меня есть другие вопросы...»~
@13844 = ~«Взять тебя за руку и улететь на луну? Не сегодня, друг мой».~
@13845 = ~«Взять тебя за руку и улететь на луну? Не сегодня, друг мой».~
@13846 = ~«Луна — луны — уныл — аныл?»~
@13847 = ~Зарычать на него, потом начать лаять.~
@13848 = ~Склонить голову набок, как бы изучая его.~
@13849 = ~«Э... Тогда прощай».~
@13850 = ~«Э... Тогда прощай».~
@13851 = ~«Слушай, успокойся. У меня к тебе вопросы...»~
@13852 = ~«Э... Тогда прощай».~
@13853 = ~«Э... Тогда прощай».~
@13854 = ~Отвернуться, оставив его в покое.~
@13855 = ~Отвернуться, оставив его в покое.~
@13856 = ~«Э, не сегодня. У меня есть другие вопросы...»~
@13857 = ~«А?»~
@13858 = ~Сочинить песенку: «Холостяк и кровельщик по лесу идут... с ними сердце девичье, смеется на снегу».~
@13859 = ~«Только поцелуй расскажет о сердце женщины, но ты предпочитаешь ответы мужчины? Что ж, отлично, только знай: мои ответы — это вопросы, и я предпочту ответы от тебя».~
@13860 = ~«Только поцелуй расскажет о сердце женщины, но ты предпочитаешь ответы мужчины? Что ж, отлично, только знай: мои ответы — это вопросы, и я предпочту ответы от тебя».~
@13861 = ~«Э... Тогда прощай».~
@13862 = ~«Э... Тогда прощай».~
@13863 = ~«Ты можешь, а я спрошу: Кто... или что... ты такое?»~
@13864 = ~«Ты можешь, а я спрошу: ты один из хаоситов?»~
@13865 = ~«Вот мой вопрос: ты один из Голодных Псов Лающих?»~
@13866 = ~«Я могу присоединиться к хаоситам?»~
@13867 = ~«Присоединиться могу я к хаоситам?»~
@13868 = ~«Присоединиться могу я к хаоситам?»~
@13869 = ~«Я ищу кое-кого по имени Фарод. Ты о нем слышал?»~
@13870 = ~«Я ищу потерянный дневник. Ты не знаешь, где мне его найти?»~
@13871 = ~«Еще раз, что ты там говорил о моих дневниках?»~
@13872 = ~«Что я получу, став хаоситом? Какие-нибудь силы? Какие-нибудь особые способности?»~
@13873 = ~«Можно посмотреть вещи, которые хаоситы продают членам своей фракции?»~
@13874 = ~«Э... нет вопросов, сегодня. Прощай».~
@13875 = ~«Э... нет вопросов, сегодня. Прощай».~
@13876 = ~«Не отвечай на вопрос: Кто... или что... ты такое?»~
@13877 = ~«Не отвечай на вопрос: ты один из хаоситов?»~
@13878 = ~«Вот мой вопрос: ты один из Голодных Псов Лающих?»~
@13879 = ~«Я могу присоединиться к хаоситам?»~
@13880 = ~«Присоединиться могу я к хаоситам?»~
@13881 = ~«Присоединиться могу я к хаоситам?»~
@13882 = ~«Я ищу кое-кого по имени Фарод. Ты о нем слышал?»~
@13883 = ~«Я ищу потерянный дневник. Ты не знаешь, где мне его найти?»~
@13884 = ~«Еще раз, что ты там говорил о моих дневниках?»~
@13885 = ~«Что я получу, став хаоситом? Какие-нибудь силы? Какие-нибудь особые способности?»~
@13886 = ~«Можно посмотреть вещи, которые хаоситы продают членам своей фракции?»~
@13887 = ~«Э... нет вопросов, сегодня. Прощай».~
@13888 = ~«Э... нет вопросов, сегодня. Прощай».~
@13889 = ~«Можешь хотя бы рассказать мне, где один из них?»~
@13890 = ~«Холл чувствующих? Это где?»~
@13891 = ~«Гробница под городом? Где?»~
@13892 = ~«Где те другие дневники?»~
@13893 = ~«У меня есть другие вопросы...»~
@13894 = ~«Э... Тогда прощай».~
@13895 = ~«Э... Тогда прощай».~
@13896 = ~«Ты сказал, что один — в саркофаге под городом? Это где?»~
@13897 = ~«Где те другие дневники, о которых ты упоминал?»~
@13898 = ~«У меня есть другие вопросы...»~
@13899 = ~«Тогда забудь об этом. Я попытаюсь сам его найти».~
@13900 = ~«Тогда забудь об этом. Я попытаюсь сам его найти».~
@13901 = ~«Ты сказал, что один — в Холле чувствующих? Где это?»~
@13902 = ~«Где те другие дневники, о которых ты упоминал?»~
@13903 = ~«У меня есть другие вопросы...»~
@13904 = ~«Тогда забудь об этом. Я попытаюсь сам его найти».~
@13905 = ~«Тогда забудь об этом. Я попытаюсь сам его найти».~
@13906 = ~«Ты сказал, что один — в Холле чувствующих? Где это?»~
@13907 = ~«Ты сказал, что один — в саркофаге под городом? Это где?»~
@13908 = ~«У меня есть другие вопросы...»~
@13909 = ~«Тогда забудь об этом. Я попробую сам их найти».~
@13910 = ~«Тогда забудь об этом. Я попробую сам их найти».~
@13911 = ~«Чтобы потерять, мне сначала придется найти его. У меня еще несколько вопросов...»~
@13912 = ~«Тогда забудь об этом. Я попытаюсь сам его найти».~
@13913 = ~«Тогда забудь об этом. Я попытаюсь сам его найти».~
@13914 = ~«Значит, ты один из хаоситов. Отлично. У меня еще несколько вопросов...»~
@13915 = ~«Э... Тогда прощай».~
@13916 = ~«Э... Тогда прощай».~
@13917 = ~«Полагаю, это значит «да». Отлично. У меня еще несколько вопросов...»~
@13918 = ~«Э... Тогда прощай».~
@13919 = ~«Э... Тогда прощай».~
@13920 = ~«Полагаю, это значит «нет». Отлично. У меня еще несколько вопросов...»~
@13921 = ~«Хм-м. Присоединиться могу я к хаоситам?»~
@13922 = ~«Э... Тогда прощай».~
@13923 = ~«Э... Тогда прощай».~
@13924 = ~Улыбнуться, сузить глаза и сказать: «В точ-нос-ти».~
@13925 = ~«О, я забыл. Прости. У меня есть другие вопросы...»~
@13926 = ~«Стоит того, чтобы попробовать. В таком случае, прощай».~
@13927 = ~«Стоит того, чтобы попробовать. В таком случае, прощай».~
@13928 = ~«Дикобразы-мы, хаоситек-я!»~
@13929 = ~«Дикобраз-я, хаоситек-я!»~
@13930 = ~«Быть может, быть может. Но к тебе другие есть вопросы у меня...»~
@13931 = ~«Э... фрактол?»~
@13932 = ~«Фрактол-я! Подпруги всем и никому!»~
@13933 = ~«Э... фрактол?»~
@13934 = ~«Фрактол-я! Подпруги всем и никому!»~
@13935 = ~«Я не хочу быть фрактолом».~
@13936 = ~«Фрактол-я! Грязным рубашкам — нет, во веки веков!»~
@13937 = ~«Ну, мне кажется, это не честно, что я стал фрактолом, и никто даже не просил меня. Насчет этого должны быть какие-то правила».~
@13938 = ~«Фрактол-я! Лбы твердые повсюду!»~
@13939 = ~«Ну, раз вопрос со свержения с престола решен, у меня есть к тебе вопросы...»~
@13940 = ~«Просто хотел прояснить это. Прощай».~
@13941 = ~«У меня вопрос!»~
@13942 = ~«У меня нет вопросов! С-час-ли-вот! Вот-ли-с-час!»~
@13943 = ~«Я уже принадлежу к фракции боголюдей, но...»~
@13944 = ~«Я уже принадлежу к фракции тленных, но...»~
@13945 = ~«Я уже принадлежу к фракции анархистов, но...»~
@13946 = ~«Я уже принадлежу к фракции чувствующих, но...»~
@13947 = ~«Я уже принадлежу к фракции боголюдей. Я передумал... Я не стану предавать их».~
@13948 = ~«Я уже принадлежу к фракции тленных. Я передумал... Я не стану предавать их».~
@13949 = ~«Я уже принадлежу к фракции анархистов. Я передумал... Я не стану предавать их».~
@13950 = ~«Я уже принадлежу к фракции чувствующих. Я передумал... Я не стану предавать их».~
@13951 = ~«Так... что дальше?»~
@13952 = ~«Знаешь что... Не обращай внимания. У меня есть другие вопросы...»~
@13953 = ~«А вообще, забудь. Не хочу я быть хаоситом. Счастливо».~
@13954 = ~«И все же у меня есть другие вопросы...»~
@13955 = ~«Э... Тогда прощай».~
@13956 = ~«Примкнуть готов к хаоситекам я. Не предан больше фракции старой я боголюдей».~
@13957 = ~«Примкнуть готов к хаоситекам я. Не предан больше фракции старой я тленных».~
@13958 = ~«Примкнуть готов к хаоситекам я. Не предан больше фракции старой я анархистов».~
@13959 = ~«Примкнуть готов к хаоситекам я. Не предан больше фракции старой я чувствующих».~
@13960 = ~Солгать с целью проникнуть в ряды хаоситов для анархистов: «Примкнуть готов к хаоситекам я. Не предан больше фракции старой я».~
@13961 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@13962 = ~«Не думаю, что я готов сделать это. Прощай».~
@13963 = ~Напасть на него за то, что он ударил тебя.~
@13964 = ~«Тогда к тебе еще вопросы у меня...»~
@13965 = ~«Э... Тогда прощай».~
@13966 = ~«В таком случае, у меня есть другие вопросы...»~
@13967 = ~«Э... Тогда прощай».~
@13968 = ~«Нет-нет, я спросил: что у тебя для меня».~
@13969 = ~Показать ему, что у тебя есть.~
@13970 = ~Показать ему, что у тебя есть.~
@13971 = ~Показать ему, что у тебя есть.~
@13972 = ~«Неважно. Прощай».~
@13973 = ~«В таком случае, у меня есть другие вопросы...»~
@13974 = ~Оставить Дикаря в покое.~
@13975 = ~Сильно ударить его по ноге.~
@13976 = ~«В таком случае, у меня есть другие вопросы...»~
@13977 = ~Оставить Дикаря в покое.~
@13978 = ~«В таком случае, у меня есть другие вопросы...»~
@13979 = ~Оставить Дикаря в покое.~
@13980 = ~«У меня к тебе еще несколько вопросов...»~
@13981 = ~«Спасибо, Дикарь. Прощай».~
@13982 = ~«Воп-РОУС, Дикарь! Закрой уши и слушай меня!»~
@13983 = ~«Воп-РОУС, Дикарь! Закрой уши и слушай меня!»~
@13984 = ~«Воп-РОУС, Дикарь! Закрой уши и слушай меня!»~
@13985 = ~«Не слушай мои ВОП-РОУСЫ, Дикарь, ВОП-РОУСЫ у меня...»~
@13986 = ~«Хаоситеки?»~
@13987 = ~«Еще раз, кто такие хаоситеки?»~
@13988 = ~«Я думал, что смогу что-нибудь у него узнать. Ладно, пойдем отсюда».~
@13989 = ~«А как тогда к ним приходят люди?»~
@13990 = ~«Понятно. Тогда пойдем».~
@13991 = ~«Понятно. Спасибо за информацию».~
@13992 = ~«Голодный Пес? О чем это ты?»~
@13993 = ~«Голодные Псы? Кто они такие?»~
@13994 = ~«Я все равно с ним поговорю».~
@13995 = ~«Возможно, ты права. Идем».~
@13996 = ~«Хаоситы?»~
@13997 = ~«Еще раз, кто такие хаоситы?»~
@13998 = ~«Я все равно с ним поговорю».~
@13999 = ~«Я думал, что смогу что-нибудь у него узнать. Ладно, пойдем отсюда».~
@14000 = ~«А как тогда к ним приходят новые люди?»~
@14001 = ~«Я все равно с ним поговорю».~
@14002 = ~«Понятно. Идем».~
@14003 = ~«Я все равно поговорю с ним».~
@14004 = ~«Понятно. Спасибо за информацию».~
@14005 = ~Оставить Дикаря в покое.~
@14006 = ~«Не слушай мои ВОП-РОУСЫ, Дикарь, ВОП-РОУСЫ у меня...»~
@14007 = ~Когда ты подходишь, Ждущий Смерти поворачивается к тебе. «И снова здравствуй, — на его лице видна слабая улыбка. — Спасибо тебе за помощь».~
@14008 = ~Тленный даже не подымает голову. Он смотрит вдаль, будто рассматривая что-то во многих лигах за пределами бара.~
@14009 = ~Тленный не отвечает, продолжая пялиться в пространство.~
@14010 = ~Тленный не отвечает, продолжая пялиться в пространство.~
@14011 = ~Ты уже собираешься уходить, но тут тленный начинает что-то тихо бубнить: ты едва различаешь слова. Тебе *кажется*, он что-то сказал про контракт.~
@14012 = ~Тленный поворачивается к тебе с каменным лицом; его глаза безжизненны. «Почему ты подписал тот Контракт Смерти?»~
@14013 = ~Похоже, он ощущает отвращение. «Звенелки. Этого мне и следовало ожидать».~
@14014 = ~«Оживит память? — он хмурится. — И ты не помнишь ничего, кроме прожитого за эту жизнь?»~
@14015 = ~Он удивленно смотрит на тебя. «Что ты имеешь в виду?»~
@14016 = ~Тленный *хмыкает*. «И ты продал свое тело не раздумывая... просто так. Тебе больше ничего не надо?»~
@14017 = ~«Освобождения? Освобождения от этой реальности. Послушай... ты же видел трупы, расхаживающие по Сигилу? — он вздыхает. — Безмозглые, неспособные чувствовать боль, ярость или тяжесть прожитых лет... это и есть Истинная Смерть, гуляющая по улицам. Это идеал».~
@14018 = ~«Я хочу... я жажду освобождения. Пустота. Без боли и страданий».~
@14019 = ~«И *все*? Ты не видишь сути. Я же вижу освобождение от боли и страданий».~
@14020 = ~Ты уже собираешься уходить, но тут тленный начинает что-то тихо бубнить: ты едва различаешь слова. Тебе *кажется*, он что-то сказал про желание умереть.~
@14021 = ~Юноша даже бровью не повел. «Ты хочешь умереть?»~
@14022 = ~Он моргает. «Да... да, хочу. Ты собираешься убить меня? — он замирает, будто бы решаясь. — Давай, мне все равно».~
@14023 = ~«Да... — он изучает тебя. — Почему ты хочешь умереть?»~
@14024 = ~«Да... — он изучает тебя. — Почему ты хочешь жить?»~
@14025 = ~Тленный молча слушает тебя. После твоих слов он продолжает смотреть на тебя. Кажется, он что-то обдумывает.~
@14026 = ~Тленный отводит свой тяжелый взгляд. «Тогда нам нечего обсуждать... ни сейчас, ни когда бы то ни было. Прощай».~
@14027 = ~«Да».~
@14028 = ~«Это существование... это существование — лишь жалкая пародия на жизнь. Я не хочу больше играть в эту шараду, — его лицо морщится от отвращения. — Ради чего кто-то будет оставаться здесь, посреди мультивселенной, в этом грязном городе, который питается болью и ненавистью? Смерть... тиха... и утешительна».~
@14029 = ~«И это *жизнь*? — он стискивает зубы, сжимая руки в кулаки. — Это существование... это существование — жалкая *пародия* на жизнь. Я не хочу больше играть в эту шараду. Смерть тиха... и утешительна».~
@14030 = ~Похоже, твое замечание задело юношу. «А тебе откуда знать?»~
@14031 = ~Юноша удивленно смотрит на тебя. «Ты говоришь правду, — он потрясен. — Что там? Что ты видел?»~
@14032 = ~«Ты *должен* сказать мне! Я должен знать!»~
@14033 = ~«Ты должен сказать мне! — он стискивает кулаки. — Что ты *хочешь* от меня?!»~
@14034 = ~«Ты смеешься надо мной. Ты издеваешься над моими вопросами...»~
@14035 = ~«Скажи, что ты видел! Какова Истинная Смерть? Что ты видел там?» Его голос становится настолько громким и настойчивым, что окружающие тленные начинают озираться в вашу сторону. ~
@14036 = ~«Нет никакой разницы... — он опускает голову, шевеля губами. — За тенью этого существования ждут еще большие мучения. Нет никакого забвения, никакого очищения... никакой разницы. Планы вращаются... но все остается по-прежнему».~
@14037 = ~Он усмехается. «Нет. Я уже пробовал. Несколько раз».~
@14038 = ~«Это больше, чем просто убеждение, это реальность, — его взгляд темнеет. — Ты видел город? Он гниет, и внутри все гниют вместе с ним... Нет никакой надежды, нет ничего, к чему можно было бы *стремиться*. Все погрязли во тьме и тени».~
@14039 = ~«Я так и думал, — вздыхает он. — Тогда то место, должно быть, лучше этого. И поэтому я должен умереть, чтобы попасть туда...» Он смотрит на тебя. «Ты поможешь мне умереть?»~
@14040 = ~Тленный непроизвольно улыбается, но затем угрюмость вновь возвращается к нему. «Тогда я *должен* умереть, — он с надеждой смотрит на тебя. — Ты поможешь мне?»~
@14041 = ~Он недоумевающе смотрит на тебя, открывая и закрывая рот. «Тогда уходи. Нам не следует больше разговаривать».~
@14042 = ~Он кивает. «Философия тленных — значимая цель. Иначе я бы не стал тленным».~
@14043 = ~Он ворчит. «Ты говоришь как один из наших фракторов... они никогда не упустят момента *почитать* мне нотацию».~
@14044 = ~«Но как... — похоже, он загнан в тупик. — Как же мне справиться с ней?»~
@14045 = ~«Возможно... — он обдумывает сказанное тобой. — Возможно, ты прав. Но... иногда слишком сложно игнорировать боль этой жизни. Как же мне с ней справиться?»~
@14046 = ~Юноша затихает в раздумьях. Наконец он снова оборачивается к тебе. «В твоих словах есть смысл... и свежий взгляд на вещи. Я сделаю так, как ты сказал».~
@14047 = ~«Я ищу способ покончить с собой. Ты убьешь меня?»~
@14048 = ~«Хорошо. Оставь меня. Нам больше не следует разговаривать».~
@14049 = ~Он облегченно вздыхает, вытаскивая из мантии кошелек.
Кошелек со *звоном* падает перед ним. «Сделай это сейчас. Я не могу больше ждать».~
@14050 = ~Он закрывает глаза.~
@14051 = ~Ты бережно берешь кошелек с пола и тихо уходишь. Похоже, в мешочке около пятидесяти монет. Тленный продолжает стоять неподвижно, с закрытыми глазами.~
@14052 = ~Ты накладываешь свои руки ему на шею и начинаешь медленно давить. Он задыхается, его зрачки расширяются — с молящим выражением лица он начинает царапать твои руки.~
@14053 = ~Ты продолжаешь сдавливать его шею, и неожиданно, даже не осознавая этого, отводишь от него руки. Ждущий Смерти глотает воздух — кажется, он хочет поблагодарить тебя за то, что ты остановился — и тут ты хватаешь его за виски и резко поворачиваешь голову влево. Слышится характерный хруст — и юноша падает в твои объятия.~
@14054 = ~К своему удивлению, это действие происходит практически инстинктивно, будто ты это проделывал много раз... с этой мыслью появляется смутное воспоминание, однако оно слишком слабое, чтобы за него зацепиться.~
@14055 = ~В тот момент, когда тело падает на пол, по всему бару раздается громкий грохочущий звук...~
@14056 = ~Ты отпускаешь его... и весьма неохотно, к своему неудовольствию. Юноша глотает воздух, натужно кашляя.~
@14057 = ~Юноша слабо кивает.~
@14058 = ~Юноша молча смотрит на тебя, затем медленно кивает, потирая шею.~
@14059 = ~Юноша снова кивает, совладав, наконец, со своим дыханием. «Хорошо... Спасибо... тебе. За... свежий взгляд на жизнь».~
@14060 = ~«Дело не в решимости...»~
@14061 = ~Он бросает небольшой мешочек на стол. «Это все, что у меня есть. Пятьдесят медяков. Убей меня — и они твои».~
@14062 = ~Тленный фыркает. «С трудом верится».~
@14063 = ~Тленный, недоуменно сморгнув, усмехается. «Первой смерти? Постой, ты что, был возрожден?»~
@14064 = ~Тленный, недоуменно сморгнув, усмехается. «Ты лжешь. Никто не может умереть больше одного раза... если только не был возрожден с помощью сильной магии».~
@14065 = ~«Возрожден... возвращен к жизни... магия для этого должна по-настоящему сильной».~
@14066 = ~«Могущественный волшебник или жрец... или кто-нибудь из сил... но я таких не знаю, — он хмурится. — Что-то не верится, что ты кого-нибудь из них знаешь».~
@14067 = ~Он скептически смотрит на тебя. «Неа, не буду, хотя и очень хочется».~
@14068 = ~«Постой... Что ты имеешь в виду? — похоже, он хочет развернуться, но не может. — Ты это несерьезно...»~
@14069 = ~Твое зрение медленно возвращается... на этот раз смерть была другой. Ты видишь Ждущего Смерти, стоящего над тобой... он сильно напуган и удивлен. Усадив тебя на стул, он с опаской оглядывается на посетителей бара... они либо не обращают на тебя внимания, либо посчитали, что ты перебрал с выпивкой.~
@14070 = ~«Ты спятил, — он смотрит на твои раны. — Должно быть, ты не умер, а просто ранен».~
@14071 = ~«Ты... ты из ходячих трупов?»~
@14072 = ~«Тогда что же ты такое?»~
@14073 = ~«И все же... ты продолжаешь мыслишь и чувствовать?»~
@14074 = ~«Быть мертвым... и *продолжать* думать и чувствовать? Что за мучение — никогда не покидать своего тела? — кажется, эта мысль его очень пугает. — Даже смерть не несет освобождения».~
@14075 = ~«Ладно, шеф... — шепчет тебе Морт.  — Идем. Этот трухлявенький скоро станет удобрением».~
@14076 = ~«Приветствую».~
@14077 = ~Оставить его в покое.~
@14078 = ~«Приветствую».~
@14079 = ~Не обращать на него внимания, пройти мимо.~
@14080 = ~«Всегда пожалуйста. Прощай».~
@14081 = ~«Могу ли я задать тебе пару вопросов?..»~
@14082 = ~«Могу ли я задать тебе пару вопросов?..»~
@14083 = ~«Могу ли я задать тебе пару вопросов?..»~
@14084 = ~«Прощай».~
@14085 = ~«Прощай».~
@14086 = ~«Прощай».~
@14087 = ~«Прощай».~
@14088 = ~«Тогда прощай». ~
@14089 = ~«Тогда прощай». ~
@14090 = ~«Тогда прощай». ~
@14091 = ~«Тогда прощай». ~
@14092 = ~«Что ты сказал?»~
@14093 = ~Уйти, не обращая на него внимания.~
@14094 = ~Правда: «Мне нужны были деньги».~
@14095 = ~Правда: «Я хотел узнать, оживит ли это мою память».~
@14096 = ~Правда: «Ну, учитывая то, что я и смерть — понятия несовместимые, я решил, что ничего не теряю».~
@14097 = ~Правда: «Если честно, я и сам не знаю».~
@14098 = ~«А тебе какое дело?»~
@14099 = ~«Это не твое дело. Прощай».~
@14100 = ~«Зачем мне это сделать?»~
@14101 = ~«Зачем мне это сделать?»~
@14102 = ~«Я видел то, что находится по ту сторону».~
@14103 = ~«Не знаю. Я видел не так много из того, что лежит по ту сторону смерти. Если я умру еще раз, то, возможно, я смогу что-нибудь об этом сказать».~
@14104 = ~«Я уже умирал. Хотя и ничего не помню об этом».~
@14105 = ~«Просто знаю. Называй это предчувствием».~
@14106 = ~«Тогда неважно. Я должен идти. Прощай».~
@14107 = ~«Например?..»~
@14108 = ~«И кто захочет такой участи?»~
@14109 = ~«'Идеал'? Да не гони. Это не идеал, а просто тухлятина».~
@14110 = ~«Ты не стар, ты просто невежда. У тебя вся жизнь впереди — не ищи смерти. В свое время она сама придет за тобой, так что живи, пока можешь».~
@14111 = ~«Может и так. Не мне об этом судить. Прощай».~
@14112 = ~«Ты хочешь умереть?»~
@14113 = ~«Я должен идти. Прощай».~
@14114 = ~«Ты хочешь умереть?»~
@14115 = ~«Я должен идти. Прощай».~
@14116 = ~«Что ты сказал?»~
@14117 = ~Уйти, не обращая на него внимания.~
@14118 = ~Правда: «Нет. А ты?»~
@14119 = ~~
@14120 = ~Правда: «Да. А ты?»~
@14121 = ~Ложь: «Да. А ты?»~
@14122 = ~«Я и в правду не знаю. А *ты* хочешь умереть?»~
@14123 = ~«Ты *угрожаешь* мне, сопляк?»~
@14124 = ~«Прощай».~
@14125 = ~«Если это твое решение, то я уважаю его... Приготовься к смерти».~
@14126 = ~«Ты *хочешь* умереть?»~
@14127 = ~«Мне тоже все равно. Прощай».~
@14128 = ~Правда: «Ради чего здесь жить? Я заперт в этом городе, доверху набитом разными монстрами и тварями, без единой подсказки, как и почему я сюда попал. Я чужд — и этому городу, и самому себе. Жизнь для меня не имеет никакой ценности».~
@14129 = ~Правда: «Потому что смерть отвергнула меня. Одно лишь это заставляет ее желать».~
@14130 = ~Правда: «Во мне... чего-то не хватает. Я здесь, разговариваю с тобой, но внутри себя я чувствую какую-то пустоту. Что бы я не делал, я не могу избавиться от этого чувства. Как по мне, уж лучше умереть».~
@14131 = ~Правда: «Возможно, после смерти я смогу узнать о себе что-то, чего не мог узнать при жизни».~
@14132 = ~Правда: «Я лгал тебе, когда говорил, что хочу умереть. А кто хочет? Может, ты?»~
@14133 = ~Правда: «Я лгал тебе, когда говорил, что хочу умереть. А кто хочет? Может, ты?»~
@14134 = ~Правда: «Просто хочу».~
@14135 = ~Правда: «Инстинкт самосохранения. Я *хочу* жить».~
@14136 = ~Правда: «Я пока что не хочу предаваться забвению. Мне *куда* больше нравится быть живым».~
@14137 = ~Правда: «Прежде чем я сдамся, я должен найти ответ на ряд вопросов о моей прежней жизни. Я хочу узнать, кто я такой».~
@14138 = ~«Я не знаю». ~
@14139 = ~«Я больше не хочу обсуждать это с тобой. Прощай».~
@14140 = ~«Ты хочешь умереть? Вот почему ты спрашиваешь?»~
@14141 = ~«Я должен идти. Прощай».~
@14142 = ~«Пока я не ушел... почему ты хочешь умереть?»~
@14143 = ~«Тогда прощай». ~
@14144 = ~«Почему ты хочешь умереть?»~
@14145 = ~«Почему ты не хочешь жить?»~
@14146 = ~«Тогда почему же ты до сих пор себя не убил?»~
@14147 = ~«Я должен идти. Прощай».~
@14148 = ~«Безусловно, жизнь куда лучше того, как ты ее представляешь».~
@14149 = ~«Какой унылый взгляд... Жизнь — нечто гораздо большее, чем просто боль и ненависть».~
@14150 = ~«Тогда почему же ты до сих пор себя не убил?»~
@14151 = ~«Я должен идти. Прощай».~
@14152 = ~«Поверь мне, это не так».~
@14153 = ~«Может быть, после первой смерти».~
@14154 = ~«Тогда почему же ты до сих пор себя не убил?»~
@14155 = ~«Если в этой жизни тебя ничего не удерживает, то ты должен умереть».~
@14156 = ~«Я должен идти. Прощай».~
@14157 = ~«Я видел то, что находится по ту сторону».~
@14158 = ~«Не знаю. Я видел не так много из того, что лежит по ту сторону смерти. Если я умру еще раз, то, возможно, я смогу что-нибудь об этом сказать».~
@14159 = ~«Я думаю, что я уже умирал. Хотя и ничего не помню об этом».~
@14160 = ~«Просто знаю. Называй это предчувствием».~
@14161 = ~«Тогда неважно. Я должен идти. Прощай».~
@14162 = ~Правда: «Я нахожусь на острове посреди океана из темноты. Остров состоит из затененных камней... но эти камни — *не камни*: они что-то бормочут и шепчут мне на языке, которого я не понимаю. Там нет тишины и покоя, а холод пробирается до мозга костей».~
@14163 = ~«Я не скажу об этом месте никому. Я и так сказал слишком много».~
@14164 = ~Правда: «Я нахожусь на острове посреди океана из темноты. Остров состоит из затененных камней... но эти камни — *не камни*: они что-то бормочут и шепчут мне на языке, которого я не понимаю. Там нет тишины и покоя, а холод пробирается до мозга костей».~
@14165 = ~«Я ничего тебе не скажу».~
@14166 = ~«Я не буду об этом говорить. Прощай».~
@14167 = ~«Я хочу, чтобы ты жил».~
@14168 = ~«Я ничего не даю, поэтому я ничего не хочу от тебя. Прощай».~
@14169 = ~«*Ты* — дурак, раз хочешь так беспечно расстаться со своей жизнью. Это оскорбляет и смерть, и жизнь».~
@14170 = ~«Тогда нам не о чем больше говорить. Прощай».~
@14171 = ~Правда: «Я нахожусь на острове посреди океана из темноты. Остров состоит из затененных камней... но эти камни — *не камни*: они что-то бормочут и шепчут мне на языке, которого я не понимаю. Там нет тишины и покоя, а холод пробирается до мозга костей».~
@14172 = ~Ложь: «Это забвение. Там ничего нет. Это небытие».~
@14173 = ~Ложь: «Это место великого наслаждения, божественной красоты. Там душа может обрести счастье».~
@14174 = ~«Я ничего не скажу. Прощай». ~
@14175 = ~«За исключением тебя. Ты еще можешь измениться».~
@14176 = ~«То, во что ты веришь, становится истиной».~
@14177 = ~«Я должен идти. Прощай».~
@14178 = ~«То, во что ты веришь, становится истиной».~
@14179 = ~«Тогда нам больше не о чем говорить. Прощай».~
@14180 = ~«А как насчет твоих убеждений как тленного? Разве эта цель недостаточно достойна?»~
@14181 = ~«Тогда нам больше не о чем говорить. Прощай».~
@14182 = ~«Нет».~
@14183 = ~«Да».~
@14184 = ~«Это зависит от того... сколько ты дашь?»~
@14185 = ~«Если у тебя не хватает решимости покончить с собой, то я не собираюсь этого делать за тебя».~
@14186 = ~«Нет... Прощай».~
@14187 = ~«Нет».~
@14188 = ~«Да».~
@14189 = ~«Это зависит от того... сколько ты дашь?»~
@14190 = ~«Если у тебя не хватает решимости покончить с собой, то я не собираюсь этого делать за тебя».~
@14191 = ~«Нет... Прощай».~
@14192 = ~Уйти.~
@14193 = ~«Тогда уясни следующее: ты слишком сильно желаешь достичь забвения. Согласно принципам тленных, так страстно желая Истинной Смерти, ты никогда ее не достигнешь».~
@14194 = ~«Тогда почему бы не сконцентрироваться на убеждениях тленных? Возможно, эта жизнь полна боли и страданий, но если ты посвятишь себя своим убеждениям и тому, что дорого для тебя, то они помогут тебе преодолеть ее».~
@14195 = ~«Тогда нам больше не о чем говорить. Прощай».~
@14196 = ~«И они были правы — в твоем сердце они видели только желание умереть. Если ты хочешь достичь Истинной Смерти, то сначала должен смириться с правилами этой жизни, какой бы болезненной она для тебя ни была. Это возможность, а ты еще слишком молод. Возможно, пожив в этой жизни, ты умеришь свое стремление к смерти».~
@14197 = ~«Тогда не буду больше читать тебе морали. Прощай».~
@14198 = ~«Просто живи полной жизнью. Используй ее как возможность, какой бы мучительной она ни была. Ты еще слишком молод. Возможно, пожив в этой жизни, ты умеришь свое стремление к смерти».~
@14199 = ~«Ты должен выдержать эту жизнь. Терпя, ты научишься не замечать боли и страданий. Вскоре они перестанут тебя волновать, и ты начнешь продвигаться вперед к Истинной Смерти и забвению, которые ищешь».~
@14200 = ~«Все зависит от тебя. Прощай».~
@14201 = ~«Просто живи полной жизнью. Используй ее как возможность, какой бы мучительной она ни была. Ты еще слишком молод. Возможно, пожив в этой жизни, ты умеришь свое стремление к смерти».~
@14202 = ~«Ты должен выдержать эту жизнь. Терпя, ты научишься не замечать боли и страданий. Вскоре они перестанут тебя волновать, и ты начнешь продвигаться вперед к Истинной Смерти и забвению, которые ищешь».~
@14203 = ~«Всю свою жизнь мы учимся умирать. Только ты сможешь дать ответ на свой вопрос». ~
@14204 = ~«Все зависит от тебя. Прощай».~
@14205 = ~«Это все, о чем я прошу... живи, взрослей и учись. Прощай».~
@14206 = ~«Нет».~
@14207 = ~«Да».~
@14208 = ~«Это зависит от того... сколько ты дашь?»~
@14209 = ~«Если у тебя не хватает решимости покончить с собой, то я не собираюсь этого делать за тебя».~
@14210 = ~«Прощай».~
@14211 = ~«Тогда прощай». ~
@14212 = ~«Ну хорошо... закрой глаза».~
@14213 = ~«Постой... Мне не нужны твои деньги. Я хочу знать, почему ты хочешь умереть».~
@14214 = ~«Я не буду этого делать. Прощай». ~
@14215 = ~Обхватить руками его шею и задушить его.~
@14216 = ~Забрать деньги и тихо уйти.~
@14217 = ~«Оставь деньги себе. Я хочу знать, почему ты хочешь умереть».~
@14218 = ~«Я не буду этого делать. Прощай». ~
@14219 = ~«Содержимое этого кошелька — цена за твою глупость. Прощай...»~
@14220 = ~Свернуть ему шею.~
@14221 = ~Отпустить его.~
@14222 = ~«Увидимся на той стороне, трухлячок...»~
@14223 = ~«Увидимся на той стороне, трухлячок...»~
@14224 = ~Позволить телу упасть на пол.~
@14225 = ~«Ой-ой...»~
@14226 = ~«Передумал?»~
@14227 = ~«Послушай... в следующий раз, когда захочешь 'умереть', будь в этом уверен, иначе другой на моем месте не остановится, когда ты попросишь. И прекрати лопотать о мучениях жизни, раз уж ты все еще хочешь оставаться ее частью».~
@14228 = ~«Деньги я оставлю у себя в качестве платы за этот урок».~
@14229 = ~«Я не выполнил свою часть сделки, так что можешь забрать свои деньги».~
@14230 = ~«Не благодари меня, просто *живи*. Ты оскорбляешь смерть, беспечно расставаясь со своей жизнью. Прощай».~
@14231 = ~«Тогда должна быть другая причина. Так что я спрашиваю тебя: что в жизни такого, из-за чего ты возненавидел ее?»~
@14232 = ~«Нет, в ней. Если бы ты действительно решился умереть, то уже бы давно нашел способ. Хватит тратить время на пустую болтовню. Прощай».~
@14233 = ~«Ну хорошо... закрой глаза».~
@14234 = ~«Постой... Мне не нужны твои деньги. Я хочу знать, почему ты хочешь умереть».~
@14235 = ~«Я не буду этого делать. Прощай». ~
@14236 = ~«Попробуй убить меня. Увидишь, что из этого выйдет».~
@14237 = ~«Я могу доказать это».~
@14238 = ~«Я видел то, что находится по ту сторону».~
@14239 = ~«Не знаю. Я видел не так много из того, что лежит по ту сторону смерти. Если я умру еще раз, то, возможно, я смогу что-нибудь об этом сказать».~
@14240 = ~«Я думаю, что из нас двоих лжешь ты, и лжешь ты только себе. Прощай».~
@14241 = ~«Возрожден?»~
@14242 = ~«Попробуй убить меня. Увидишь, что из этого выйдет».~
@14243 = ~«Хочешь на это посмотреть?»~
@14244 = ~«Я видел то, что находится по ту сторону».~
@14245 = ~«Не знаю. Я видел не так много из того, что лежит по ту сторону смерти. Если я умру еще раз, то, возможно, я смогу что-нибудь об этом сказать».~
@14246 = ~«Если я умру и запомню это, я обязательно вернусь и расскажу тебе об этом. А уж потом решай, лгу я или нет. Прощай».~
@14247 = ~«Я думаю, что из нас двоих лжешь ты, и лжешь ты только себе. Прощай».~
@14248 = ~«Возрожден?»~
@14249 = ~«Попробуй убить меня. Увидишь, что из этого выйдет».~
@14250 = ~«Хочешь на это посмотреть?»~
@14251 = ~«Если я умру и запомню это, я обязательно вернусь и расскажу тебе об этом. А уж потом решай, лгу я или нет. Прощай».~
@14252 = ~«Я думаю, что из нас двоих лжешь ты, и лжешь ты только себе. Прощай».~
@14253 = ~«Кто может обладать подобной силой?»~
@14254 = ~«Ты не веришь, что я могу умереть? Попробуй убить меня. Увидишь, что из этого выйдет».~
@14255 = ~«Ты не веришь, что я могу умереть? Я могу доказать это тебе».~
@14256 = ~«Если я умру и запомню это, я обязательно вернусь и расскажу тебе об этом. А уж потом решай, лгу я или нет. Прощай».~
@14257 = ~«Я должен идти. Прощай».~
@14258 = ~«Ты не веришь, что я могу умереть? Попробуй убить меня. Увидишь, что из этого выйдет».~
@14259 = ~«Ты не веришь, что я могу умереть? Я могу доказать это тебе».~
@14260 = ~«Если я умру и запомню это, я обязательно вернусь и расскажу тебе об этом. А уж потом решай, лгу я или нет. Прощай».~
@14261 = ~«Я думаю, что из нас двоих лжешь ты, и лжешь ты только себе. Прощай».~
@14262 = ~«Тогда тебе придется смотреть — я покажу тебе, что забирает смерть».~
@14263 = ~«А, неважно. Что ты имел ввиду под словом 'возрожден'?»~
@14264 = ~«Если страх и нерешительность правят твоими поступками, то сомневаюсь, что это существование принесет тебе много радости».~
@14265 = ~«Довольно этого. Прощай».~
@14266 = ~Свернуть себе шею.~
@14267 = ~«Теперь веришь?»~
@14268 = ~«Нет».~
@14269 = ~«Да».~
@14270 = ~«Я не знаю». ~
@14271 = ~«Я не знаю. Но я умираю и возрождаюсь».~
@14272 = ~«Да».~
@14273 = ~«Да, но... есть какая-то опустошенность. Чего-то не хватает, и это пожирает меня, ни на миг не оставляет в покое».~
@14274 = ~«Это верно. Возможно, тебе не стоит торопиться покидать эту жизнь, не зная, что ждет тебя в следующей».~
@14275 = ~«Похоже на то. Пойдем отсюда».~
@14276 = ~«Похоже на то. Пойдем отсюда».~
@14277 = ~«Похоже на то. Пойдем отсюда».~
@14278 = ~«Похоже на то. Пойдем отсюда».~
