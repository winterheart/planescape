@4280 = ~«Ему еще недолго жить в тени этого существования?»~
@4281 = ~«Где я могу найти Дхолла?»~
@4282 = ~«Где я могу найти Дхолла?»~
@4283 = ~«У меня есть другие вопросы...»~
@4284 = ~«По меркам гитцераев?»~
@4285 = ~«Что это еще за *гитцераи*?»~
@4286 = ~«Повезло?»~
@4287 = ~«Понятно. У меня есть другие вопросы...» ~
@4288 = ~«Дхолл болен?»~
@4289 = ~«Спасибо за уделенное время. Мне нужно идти. Прощай».~
@4290 = ~«Дхолл болен?»~
@4291 = ~«Спасибо за уделенное время. Мне нужно идти. Прощай».~
@4292 = ~«Что это еще за *гитцераи*?»~
@4293 = ~«Как это Дхоллу повезло? От него хотят избавиться?»~
@4294 = ~«О, у меня есть другие вопросы...»~
@4295 = ~«Спасибо за уделенное время. Прощай».~
@4296 = ~«Я недавно посвящен. Прости мое невежество».~
@4297 = ~«Я... недавно здесь. Я... пытаюсь изучить обстановку».~
@4298 = ~«Ну... к чему имена? Храни веру, э-э, посвященная».~
@4299 = ~«И... это хорошо?»~
@4300 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@4301 = ~«Понятно. И правда, очень повезло. У меня есть другие вопросы...»~
@4302 = ~«Понятно. Ну что ж, мне нужно идти. Прощай».~
@4303 = ~«Я недавно посвящен. Прости мое невежество».~
@4304 = ~«Я... недавно здесь. Я... пытаюсь изучить обстановку».~
@4305 = ~«Ну... к чему имена? Храни веру, э-э, посвященная».~
@4306 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@4307 = ~«Проклятье!»~
@4308 = ~«Тс-с-с! Я не смогу тебе ответить под такой крик!»~
@4309 = ~«Тс-с-с! Я не смогу тебе ответить под такой крик!»~
@4310 = ~«У меня есть другие вопросы...»~
@4311 = ~«Я должен идти. Прощай».~
@4312 = ~«Приветствую».~
@4313 = ~«Приветствую».~
@4314 = ~«Приветствую».~
@4315 = ~«Приветствую».~
@4316 = ~Оставить ее в покое.~
@4317 = ~«Нельзя дать тебе предупредить своих друзей...»~
@4318 = ~«Лучше ты, чем я, трухлявка». ~
@4319 = ~«Лучше ты, чем я, трухлявка». ~
@4320 = ~Оставить тело, уйти.~
@4321 = ~«Ну хорошо...»~
@4322 = ~«Нельзя дать тебе предупредить своих друзей...»~
@4323 = ~Уйти прочь.~
@4324 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@4325 = ~Свернуть ей шею до того, как она сможет позвать на помощь.~
@4326 = ~Уйти. Быстро.~
@4327 = ~«Нет-нет... не он, э-э... то есть, я хотел сказать, не шпион... понимаешь, я пробудился на одной из плит... и...»~
@4328 = ~Уйти прочь.~
@4329 = ~«Я недавно посвящен. Прости мое невежество».~
@4330 = ~Я... недавно здесь. Я... пытаюсь изучить порядки.~
@4331 = ~«Я... недавно здесь. Я... пытаюсь изучить порядки».~
@4332 = ~«Ну... к чему имена? Храни веру, э-э, посвященная».~
@4333 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@4334 = ~«У меня есть пара вопросов...» ~
@4335 = ~«На этот раз — ничего. Прощай».~
@4336 = ~«Я хочу повидаться с Дейонаррой».~
@4337 = ~«Спасибо за уделенное время. Мне нужно идти».~
@4338 = ~«Эй! Эй! Что ты делаешь?»~
@4339 = ~«Я *хотел* поговорить с этой дамочкой. Проблемы?»~
@4340 = ~«Ничего. Идем».~
@4341 = ~«Если ты собираешься трясти черепушкой с трухлявыми, то, пожалуйста, без меня. Я с ними не в лучших отношениях... и тебе не стоит с ними родниться. Они скорее спалят тебя или заживо зароют, чем будут слушать. Не валяй дурака, давай выбираться отсюда».~
@4342 = ~«Спасибо за совет, но *все еще* хочу поговорить с этой дамочкой».~
@4343 = ~«Согласен. Идем».~
@4344 = ~«Эй! Ты оглох, что ли? Ты что творишь?»~
@4345 = ~«Слушай, я хочу поговорить с этой дамочкой. Проблемы?»~
@4346 = ~«Ничего. Идем».~
@4347 = ~«Тогда *не слушай* меня больше — тебя похоронят».~
@4348 = ~«Да-да, а ты сможешь поплакаться на панихиде. А пока — умолкни».~
@4349 = ~«А, ты прав. Забудь об этом. Идем».~
@4350 = ~Уйти.~
@4351 = ~Коснуться ее плеча, привлечь ее внимание.~
@4352 = ~Уйти.~
@4353 = ~Некоторое время ты наблюдаешь за ней; под ритм движения ее рук в твоей памяти всплывает два эпизода. В одном из них ты играешь на каком-то струнном инструменте, похожим на арфу. В другом кто-то ворует чей-то кошелек... к твоему удивлению, это воспоминание внезапно толкает тебя на осмотр карманов Эи-Вейн.

^NПРИМЕЧАНИЕ: К вам вернулись воспоминания. Эти вспышки дадут вам дополнительный опыт, навыки и позже даже могут привести к тому, что вы вспомните еще больше.^-~
@4354 = ~Коснуться ее плеча, привлечь ее внимание.~
@4355 = ~Коснуться ее плеча, привлечь ее внимание.~
@4356 = ~Уйти.~
@4357 = ~Уйти.~
@4358 = ~Уйти.~
@4359 = ~«А?»~
@4360 = ~«Яфейки?»~
@4361 = ~Хмурясь, он шипит на тебя. «Ты не фпион! — он гонит тебя прочь. — Профь! Профь!» ~
@4362 = ~«Сперва ты расскажешь мне, что ты здесь делаешь, или я позову стражу».~
@4363 = ~«Сперва ты расскажешь мне, что ты здесь делаешь, или я позову стражу».~
@4364 = ~«Отвечай на мои чертовы вопросы, или не успеешь пройти и трех шагов, как я сделаю эту маскировку настоящей».~
@4365 = ~«Отвечай на мои чертовы вопросы, или не успеешь пройти и трех шагов, как я сделаю эту маскировку настоящей».~
@4366 = ~Зомби согласно кивает. Кажется, ты замечаешь, что под слоем маскировки его распирает от гордости.~
@4367 = ~«Ну хорошо, хорошо... Я ухожу».~
@4368 = ~«Ты поможешь мне выбраться отсюда?»~
@4369 = ~«Так что же ты делаешь здесь?»~
@4370 = ~Ложь: «Так ты шпионишь для анархистов? Я тоже шпионю за трухлявыми... Но сейчас я не могу об этом говорить, если ты понимаешь, о чем я. Какова *твоя* миссия здесь?»~
@4371 = ~Ложь: «Так ты шпионишь для анархистов? Я тоже шпионю за трухлявыми... Но сейчас я не могу об этом говорить. Что ты здесь делаешь?»~
@4372 = ~«Э-э, сейчас у меня нет времени на разговоры... может, как-нибудь в другой раз».~
@4373 = ~Зомби выглядит заинтересованным. «Пвоулемы? Фево ты натвовил?»~
@4374 = ~«Я очнулся на одной из плит на верхнем этаже».~
@4375 = ~«Каким-то образом я... оказался здесь запертым. Ты поможешь мне выбраться?»~
@4376 = ~«Поговорим об этом в другой раз».~
@4377 = ~Зомби смотрит на тебя как на умалишенного. «Ты фпятил?»~
@4378 = ~«Да, я фпятил. Я окончательно фпятил».~
@4379 = ~«Фпятил? Что это значит?»~
@4380 = ~«Фпятил? Что это значит?»~
@4381 = ~«Я знаю, в это трудно поверить, но я говорю правду: я очнулся из мертвых на одной из плит на верхнем этаже».~
@4382 = ~«Э-э, нет... На самом деле, я каким-то образом оказался здесь заперт. Ты поможешь мне выбраться?»~
@4383 = ~«Забудь о нашем разговоре. Мне нужно идти».~
@4384 = ~Он смотрит на тебя, затем начинает шипеть и отмахиваться от тебя. «Ты фпятил! Профь от мея!»~
@4385 = ~«Я никуда не уйду. Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4386 = ~«Я никуда не уйду. Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4387 = ~«Сначала ты ответишь на мои чертовы вопросы, или я сделаю твою маскировку настоящей».~
@4388 = ~«Сначала ты ответишь на мои чертовы вопросы, или я сделаю твою маскировку настоящей».~
@4389 = ~«Ну ладно, ладно... прощай».~
@4390 = ~Фальшивый зомби недоверчиво смотрит на вас обоих.~
@4391 = ~«Это правда — я очнулся на одной из здешних плит».~
@4392 = ~«Э-э, прошу прощения... На самом деле, я оказался здесь заперт. Ты поможешь мне выбраться?»~
@4393 = ~«Неважно. Мне нужно идти».~
@4394 = ~Он смотрит на тебя, затем начинает шипеть и отмахиваться от тебя. «Пуфтогоовый! Приурок! Профь от мея, пей! Профь!»~
@4395 = ~«Я никуда не уйду. Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4396 = ~«Я никуда не уйду. Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4397 = ~«Сначала ты ответишь на мои чертовы вопросы, или я сделаю твою маскировку настоящей».~
@4398 = ~«Сначала ты ответишь на мои чертовы вопросы, или я сделаю твою маскировку настоящей».~
@4399 = ~«Ну хорошо, хорошо... Я ухожу».~
@4400 = ~На миг он кажется испуганным, потом осматривает тебя, и по его лицу расползается ухмылка. «Ты подеиффя фо мной фвоим фекветом, я подеюфь фвоим ф *тоой*. Фдефь у мея пряфуффа друфья, у тея фдефь *никоо*. Тее фдефь не мефто. Твуфьявые тея уют. Я фбегу».~
@4401 = ~«Ты не сможешь сбежать, если я УБЬЮ тебя. А теперь отвечай, или я сделаю твою маскировку настоящей».~
@4402 = ~«Ты не сможешь сбежать, если я УБЬЮ тебя. А теперь отвечай, или я сделаю твою маскировку настоящей».~
@4403 = ~«Тогда гори в аду. Я ухожу».~
@4404 = ~Глаза зомби превращаются в щелочки, он шипит на тебя: «Ты ПЫТАЕФФЯ фапифать мея ф кьигу мертфых? У мея фдефь пвяфуффа двуфья, у тея фдефь *никоо*. Твониф мея — они тея пвиконфят».~
@4405 = ~«Я рискну. Готовься к смерти».~
@4406 = ~«Тогда гори в аду. Я ухожу. Тебе лучше быть настороже... *зомби*».~
@4407 = ~На миг он кажется испуганным, потом осматривает тебя, и по его лицу расползается ухмылка. «ТЫ пытаеффя фапифать МЕЯ ф кьигу мертфых? У мея фдефь пвячуффа двуфья, у тея фдефь *никоо*. Твонеф мея — они тея пвиконфят».~
@4408 = ~«Я рискну. Готовься к смерти».~
@4409 = ~«Что, если я раскрою твою маскировку перед стражей?»~
@4410 = ~«Что, если я раскрою твою маскировку перед стражей?»~
@4411 = ~«Тогда гори в аду. Я ухожу. Тебе лучше быть настороже... *зомби*».~
@4412 = ~Глаза зомби превращаются в щелочки, он шипит на тебя: «Ты подеилфя фо мной фвоим фекретом, я подеюфь фоим ф *тоой*. Фдефь у мея прячуффа друфья, у тея фдефь *никоо*. Твуфьявые тея уют. Я фбегу».~
@4413 = ~«Это был твой последний шанс, труп. Готовься к смерти».~
@4414 = ~«Тогда гори в аду. Я ухожу. Тебе лучше быть настороже, *зомби*».~
@4415 = ~Недобрый блеск в твоих глазах не оставляет от его самонадеянности и следа. «Не-не-не! Не наа фвать фтражу! — он явно напуган. — Я-я-я фпионю фа твуфявыми, говою, фео увиву. Ни-нифео больфе».~
@4416 = ~«Шпионишь? Для кого?»~
@4417 = ~«И чем же, по твоим наблюдениям, занимаются тленные?»~
@4418 = ~«У меня есть другие вопросы...»~
@4419 = ~«Это все, что я хотел узнать. Прощай, *зомби*».~
@4420 = ~«Не-не-не! Не твогаи мея!» Факт того, что ты явно превосходишь зомби в грубой силе, очевидно, повлиял на его решение, и от его самонадеянности не осталось и следа. «Я-я-я фпионю за твуфьявыми, говою, фео увиву. Ни-нифео больфе».~
@4421 = ~«Шпионишь? Для кого?»~
@4422 = ~«И чем же, по твоим наблюдениям, занимаются тленные?»~
@4423 = ~«У меня есть другие вопросы...»~
@4424 = ~«Это все, что я хотел знать. А теперь прочь с дороги, *зомби*».~
@4425 = ~Зомби в страхе умолкает, ничего не желая говорить.~
@4426 = ~«Ну же, для кого ты следишь за этим местом?»~
@4427 = ~«Ну же, для кого ты следишь за этим местом?»~
@4428 = ~«Если ты скажешь мне прямо сейчас, для кого ты шпионишь, будет ГОРАЗДО меньше боли».~
@4429 = ~«Если ты скажешь мне прямо сейчас, для кого ты шпионишь, будет ГОРАЗДО меньше боли».~
@4430 = ~«Тогда неважно. Так чем же, по твоим наблюдениям, занимаются тленные?»~
@4431 = ~«Есть еще кое-что, что я хочу узнать...»~
@4432 = ~«Тогда забудь об этом. Прощай, *зомби*».~
@4433 = ~«Иффефь мея? Вафем? — он искоса смотрит на тебя. — У тея соофение двя мея?»~
@4434 = ~Ложь: «Да, у меня есть сообщение для тебя».~
@4435 = ~«Сообщение от кого?»~
@4436 = ~«Нет, у меня нет сообщений».~
@4437 = ~Яростно шепчет. «Тада фео тее *надо*, пей?!»~
@4438 = ~«Я ищу выход отсюда. Ты можешь мне помочь?»~
@4439 = ~«Мне нужны кое-какие сведения...»~
@4440 = ~«Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4441 = ~«Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4442 = ~«Отвечай на мои чертовы вопросы, или не успеешь пройти и трех шагов, как я сделаю эту маскировку настоящей».~
@4443 = ~«Отвечай на мои чертовы вопросы, или не успеешь пройти и трех шагов, как я сделаю эту маскировку настоящей».~
@4444 = ~«Извини, что побеспокоил тебя... кем бы ты ни был. Прощай».~
@4445 = ~«Какое фоофение?»~
@4446 = ~«Ты должен сообщить мне свое задание».~
@4447 = ~Ложь: «У меня к тебе новые распоряжения».~
@4448 = ~Ложь: «У меня... к тебе новые распоряжения».~
@4449 = ~«Извини, у меня нет сообщений».~
@4450 = ~«Неважно. Извини за беспокойство. Прощай».~
@4451 = ~Его глаза в ярости сужаются. «Ты не фьяфной. Фто ты?»~
@4452 = ~«Я ищу выход отсюда. Ты можешь мне помочь?»~
@4453 = ~«Мне нужны кое-какие сведения...»~
@4454 = ~«Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4455 = ~«Рассказывай, что ты здесь делаешь, или я позову стражу».~
@4456 = ~«*Зомби*, вопросы здесь задаю я. Рассказывай, что ты здесь делаешь, или я сделаю эту маскировку настоящей».~
@4457 = ~«*Зомби*, вопросы здесь задаю я. Рассказывай, что ты здесь делаешь, или я сделаю эту маскировку настоящей».~
@4458 = ~«Извини, что побеспокоил тебя... кем бы ты ни был. Прощай».~
@4459 = ~«Я фпионю фа твуфьявыми. Говою, чео вифу. Нифео больфе».~
@4460 = ~«И чем же, по твоим наблюдениям, занимаются тленные?»~
@4461 = ~«Понятно. Я хотел спросить у тебя еще кое-что...»~
@4462 = ~«Это все, что я хотел узнать. Прощай».~
@4463 = ~«Нифео. Они нифео ни деают. Нифео не нафол. Твупы, твупы, пвофто твупы. Твуфьявые *нифео* ни деают, — его глаза деловито сужаются. — Буу дальфе фледить».~
@4464 = ~«Понятно. Я хотел спросить у тебя еще кое-что...»~
@4465 = ~«Это все, что я хотел узнать. Прощай».~
@4466 = ~Он сужает глаза, будто пытаясь тебя вычислить. «Какие вафповявения?»~
@4467 = ~«Доложи свою миссию».~
@4468 = ~«Мне нужно найти выход, через который можно уйти незамеченным».~
@4469 = ~«Я твой сменщик. Сообщи все, что тебе удалось узнать, отдай все вещи и покинь это место».~
@4470 = ~«Я здесь, чтобы помочь тебе во всем, в чем ты будешь нуждаться».~
@4471 = ~«Твои распоряжения будут переданы в свое время. Я вернусь».~
@4472 = ~Он на секунду умолкает, затем медленно, будто бы понимающе кивает. «Пофеу я доувен помоать тее?»~
@4473 = ~«Потому что мне нужна твоя помощь».~
@4474 = ~«Мы можем помочь друг другу. Что ты хочешь взамен?»~
@4475 = ~«Потому что я не хотел бы *раскрывать* твою маскировочку... если только ты не поможешь мне».~
@4476 = ~«Потому что я не хотел бы *раскрывать* твою маскировочку... если только ты не поможешь мне».~
@4477 = ~«Тебе, похоже, больше по душе маскироваться под труп, чем БЫТЬ им. Годится такая причина?»~
@4478 = ~«Тебе, похоже, больше по душе маскироваться под труп, чем БЫТЬ им. Годится такая причина?»~
@4479 = ~«Забудь о нашей встрече. Я должен идти. Прощай».~
@4480 = ~Зомби едва усмехается. «Фем *нао* фео-то, но нифто нифео *не дает*. *Дай* мне фео-нить, и, *мовет*, я помоу».~
@4481 = ~«Что тебе надо?»~
@4482 = ~«Как на счет того, чтобы ты мне помог, а я взамен не стал звать стражу?»~
@4483 = ~«Как на счет того, чтобы ты мне помог, а я взамен не стал звать стражу?»~
@4484 = ~«Ты похож на того, кто скорее выбрал бы остаться в живых, чем ответил мне 'нет'. Итак... в последний раз спрашиваю: как мне отсюда выбраться?»~
@4485 = ~«Ты похож на того, кто скорее выбрал бы остаться в живых, чем ответил мне 'нет'. Итак... в последний раз спрашиваю: как мне отсюда выбраться?»~
@4486 = ~«Неинтересно. Прощай».~
@4487 = ~Он оглядывает тебя с ног до головы, как бы примериваясь, сможет ли он с тобой справиться, останавливается на шрамах и решает не делать этого. «Хм-м. Ты мовефь убевать фееф поуталы».~
@4488 = ~Порталы?~
@4489 = ~«Ты не сможешь сбежать, если я УБЬЮ тебя. А теперь отвечай, или я сделаю твою маскировку настоящей».~
@4490 = ~«Ты не сможешь сбежать, если я УБЬЮ тебя. А теперь отвечай, или я сделаю твою маскировку настоящей».~
@4491 = ~На миг он кажется испуганным, потом осматривает тебя, и по его лицу расползается ухмылка. «Ты подеиффя фо мной фвоим фекветом, я подеюфь фвоим ф *тоой*. Фдефь у мея пряфуффа друфья, у тея фдефь *никоо*. Тее фдефь не мефто. Твуфьявые тея уют. Я фбегу».~
@4492 = ~«Тогда гори в аду. Я ухожу».~
@4493 = ~«Тее нуно найти *кьюч* дья мея. Нуен желефный кьюч к байвамовофной комуафе».~
@4494 = ~«Ты имеешь в виду этот ключ?»~
@4495 = ~«Хорошо. Где этот ключ?»~
@4496 = ~«У меня нет времени на это. Помоги мне сбежать, или я позову стражу».~
@4497 = ~«У меня нет времени на это. Помоги мне сбежать, или я позову стражу».~
@4498 = ~«Я не собираюсь ничего тебе приносить. Помоги мне сбежать, или я прямо здесь и сейчас сверну тебе шею».~
@4499 = ~«Я не собираюсь ничего тебе приносить. Помоги мне сбежать, или я прямо здесь и сейчас сверну тебе шею».~
@4500 = ~«Нет, спасибо. Может быть, в другой раз».~
@4501 = ~«Он у твуфьявой, — он показывает на свои глаза. — У нее воутые глафифи...» Затем он делает движение руками, похожее на стрижку ножницами. «Лефвия на пайфах».~
@4502 = ~«Я уже с ней встречался. Вот ключ».~
@4503 = ~«Тленная... с желтыми глазами и лезвиями на пальцах? Хорошо. Я вернусь с ключом».~
@4504 = ~«Судя по твоему описанию, эта тленная выглядит довольно привлекательно. Ты уверен, что не хочешь, чтобы я вас познакомил?»~
@4505 = ~Зомби моргает. Кажется, он тебя не понял.~
@4506 = ~«Это была шутка, видишь ли, ты... а, забудь, найду я твой ключ».~
@4507 = ~Зомби косо на тебя смотрит. «Ефи тея поимают, не говои никоу обо мне, или я добеусь до тея, когда ты буешь фпать».~
@4508 = ~«Я найду твой треклятый ключ... но лучше бы тебе быть поосторожнее со своими угрозами, слышишь меня?»~
@4509 = ~«Я еще вернусь».~
@4510 = ~«Я найду твой треклятый ключ... но лучше бы тебе быть поосторожнее со своими угрозами, слышишь меня?»~
@4511 = ~«Я еще вернусь».~
@4512 = ~«Я ховоф ф мафкироуке. У мея ефть фрамы. Я наил на сея мноо байфамируфеи фидкофти. Иф мея поуфифя ХООФЫЙ фомби, — зомби хихикает через зашитые губы, потом стучит себя по голове. — Твуфяки тууупые».~
@4513 = ~Этот опрятный, хорошо одетый человек определенно куда-то направляется.~
@4514 = ~«Я фду тея фдефь. Найди кьюч, — зомби улыбается мертвецким оскалом. — Потом я помоу тее».~
@4515 = ~«Если я найду его, то принесу».~
@4516 = ~«Тогда забудь об этом».~
@4517 = ~Глаза зомби расширяются, он протягивает руку и прищелкивает пальцами. «Дай его мие».~
@4518 = ~«Секундочку. Я хочу кое-что взамен».~
@4519 = ~«На, бери».~
@4520 = ~Глаза зомби расширены, он выхватывает ключ из твоей руки. Затем он поворачивается, все время кивая. «Хорофо... хорофо».~
@4521 = ~«А теперь... Как мне выбраться отсюда?»~
@4522 = ~«А теперь... Есть кое-что, о чем я хочу узнать...»~
@4523 = ~«Фто ты хофефь уфнать?»~
@4524 = ~«Как мне выбраться отсюда?»~
@4525 = ~«Еще раз — где тот портал, о котором ты говорил?»~
@4526 = ~«Ты можешь замаскировать меня под зомби?»~
@4527 = ~«Ты можешь еще раз замаскировать меня под зомби?»~
@4528 = ~«Что ты здесь делаешь?»~
@4529 = ~Ты знаешь кого-нибудь по имени Фарод?~
@4530 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@4531 = ~«Что ты можешь сказать о Дхолле?»~
@4532 = ~«Что ты можешь сказать о Дейонарре?»~
@4533 = ~«Что ты можешь сказать о Соэго?»~
@4534 = ~«Как ты приобрел такой внешний вид?»~
@4535 = ~«Как ты приобрел такой внешний вид?»~
@4536 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4537 = ~«Фа-ОД? — нахмурившись, зомби напряженно думает. — Я... фвыфал, фто он фиет де-то ф Уле, — он качает головой. — Нефнаю где, — он снова хмурится. — Твуфявые фодят ф ума, они не ЛЮЯТ Фа-ода».~
@4538 = ~«Улей?»~
@4539 = ~«А почему тленные не любят Фарода?»~
@4540 = ~«Есть еще кое-что, что я хочу узнать...»~
@4541 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4542 = ~«Твуффобы фнауви».~
@4543 = ~«А почему тленные не любят Фарода?»~
@4544 = ~«Есть еще кое-что, что я хочу узнать...»~
@4545 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4546 = ~«Он фбофик. Пвинофит твупы ф Моуг, пводает их твуфвым. Пвинофит МУОГО твупоф. Твуфявые ненают, откуда он их беет. Дуают, он пифет пьей в кьигу мертфых».~
@4547 = ~«Э-э... что?»~
@4548 = ~«Э-э... что?»~
@4549 = ~«А... Есть кое-что еще, о чем я хочу узнать...»~
@4550 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4551 = ~«Ненают. Какой-то пей обфифтил тея?»~
@4552 = ~«Э-э... что?»~
@4553 = ~«Э-э... что?»~
@4554 = ~«А... Есть кое-что еще, о чем я хочу узнать...»~
@4555 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4556 = ~Зомби пытается сказать, умолкает, пытается снова, затем вздыхает. Очевидно, что доходчивей он сказать не сможет.~
@4557 = ~«А... Есть кое-что еще, о чем я хочу узнать...»~
@4558 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4559 = ~Зомби ворчит. «Ты мовешь убевафь феев поуталы, — он взмахивает руками. — Пуф».~
@4560 = ~«Порталы? Что за порталы?»~
@4561 = ~~
@4562 = ~~
@4563 = ~«Поуталы... — зомби окидывает широким жестом пространство вокруг себя. — Поуталы вефде».~
@4564 = ~«Ты можешь показать мне один из этих порталов?»~
@4565 = ~~
@4566 = ~~
@4567 = ~Зомби кивает. «Тее надо выити, пойти ф арку на певом этаже, февео-фападный фал... Тее нувна кофть паица, фогнутоо в кьюк... — он поднимает указательный палец и сгибает его в крюк. — Ефли у тея кьюч, иди в авку и пуыгай ф тайную гуобицу. И ты выбралфя отфюда. Тайный выфод, — он энергично кивает. — Там ты мовефь ОДОФНУТЬ».~
@4568 = ~«У меня есть другие вопросы...»~
@4569 = ~«Арка в северо-западной комнате, на первом этаже? Хорошо, я проверю».~
@4570 = ~«Фуфай! Фапомиай! — в голосе зомби слышна раздраженность. — Арка, пеувый этаж, феверо-фападная коуната... — он поднимает указательный палец и сгибает его. — Тее нувна кофть паица, фогнутая. Ты попаефь ф тайную гуобицу. Тайный выфод. Там ты мовефь ОДОФНУТЬ».~
@4571 = ~«Есть еще кое-что, что я хочу узнать...»~
@4572 = ~«Арка в северо-западной комнате, на первом этаже, открывается костью изогнутого пальца? Хорошо, на этот раз запомнил».~
@4573 = ~«Пифец, — пожимает плечами. — Фтарый. Вовтый».~
@4574 = ~«Полагаю, добавить больше нечего. Я хочу знать кое-что еще...»~
@4575 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4576 = ~«Э? — хмурится. — Фто она?»~
@4577 = ~«Забудь. Я хочу знать кое-что еще...»~
@4578 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4579 = ~«Пвоводник. На пеувом этаже. Фто ты хофефь фнать о нем?»~
@4580 = ~«Что ты знаешь о нем?»~
@4581 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4582 = ~«Фтвааный. Не твуфявый, не анавфифт. Гуава двугие... — пожимает плечами. — Как у квыфы. Фтванно».~
@4583 = ~«Хорошо, что только он странный в этом месте. Я хочу знать кое-что еще...»~
@4584 = ~«Неважно. Позже у меня могут появиться другие вопросы. Никуда не уходи».~
@4585 = ~Ты видишь фальшивого зомби. Ты удивлен его маскировке... его дыхание едва заметно, ты практически не можешь уловить его.~
@4586 = ~«Приветствую».~
@4587 = ~«Приветствую».~
@4588 = ~«Приветствую».~
@4589 = ~«Приветствую».~
@4590 = ~Оставить его в покое.~
@4591 = ~Зомби быстро оглядывается вокруг, высматривая соглядатая, затем поворачивается к тебе: «Фто?»~
@4592 = ~«Вот ключ к бальзамационной комнате, который ты хотел».~
@4593 = ~«Вот ключ к бальзамационной комнате, который ты хотел».~
@4594 = ~«Еще раз — где тот ключ, о котором ты говорил?»~
@4595 = ~«У меня есть несколько вопросов к тебе...»~
@4596 = ~«Неважно».~
@4597 = ~Зомби быстро оглядывается вокруг, высматривая соглядатая, затем шипит на тебя. «Ухои! Вон!»~
@4598 = ~«Нет. Сначала у меня несколько вопросов к тебе...»~
@4599 = ~«Тогда неважно».~
@4600 = ~«Тогда неважно».~
@4601 = ~«Я ховоф ф мафкироуке. У мея ефть фрамы. Я наил на сея мноо байфамируфеи фидкофти. Иф мея поуфифя ХООФЫЙ фомби, — зомби хихикает через зашитые губы, потом стучит себя по голове. — Твуфяки тууупые».~
@4602 = ~«Ага, уж кто тупой, так это они. Это точно».~
@4603 = ~«Это не больно?»~
@4604 = ~«Довольно неплохая маскировка. Скажи... а ты можешь и меня замаскировать под зомби?»~
@4605 = ~«Есть еще кое-что, что я хочу узнать...»~
@4606 = ~«Мне нужно идти. Прощай».~
@4607 = ~Зомби определенно не понял сарказма, энергично кивая словам. «Тупие твуфявые. Ив мея ХОВОФЫЙ фомби».~
@4608 = ~«Это не больно?»~
@4609 = ~«Довольно неплохая маскировка. А ты можешь и меня замаскировать под зомби?»~
@4610 = ~«Есть еще кое-что, что я хочу узнать...»~
@4611 = ~«Мне нужно идти. Прощай».~
@4612 = ~«Есть еще кое-что, что я хочу узнать...»~
@4613 = ~«Мне нужно идти. Прощай».~
@4614 = ~Он смотрит на твои шрамы. «А как ты думаефь? По мие, нет, не офень, — бьет себя по груди. — Я КИЕПКИЙ».~
@4615 = ~«Довольно неплохая маскировка. А ты можешь и меня замаскировать под зомби?»~
@4616 = ~«Есть еще кое-что, что я хочу узнать...»~
@4617 = ~«Мне нужно идти. Прощай».~
@4618 = ~«Есть еще кое-что, что я хочу узнать...»~
@4619 = ~Что-то бормоча, он несколько раз оглядывает тебя с ног до головы, затем кивает. «Уху. Мие нуна банка баифама, — показывает на шрамы на твоей груди. — И игоука ф ниткой».~
@4620 = ~«На, бери».~
@4621 = ~«Я подумаю над этим. У меня есть еще несколько вопросов...»~
@4622 = ~«Может, быть в другой раз, спасибо... Прощай».~
@4623 = ~«Бальзамирующая жидкость и нитка? Пойду, поищу их».~
@4624 = ~Странным взглядом он осматривает тебя с ног до головы. «Ты будефь ХОВОФЫМ фомби. Мовно фделать из тея фомби? ХОВОФАЯ мафкиофка».~
@4625 = ~«Спасибо. У меня есть другие вопросы к тебе...»~
@4626 = ~«Конечно. Ты сможешь сделать это?»~
@4627 = ~«Почему бы и нет? Я и так чувствую себя ходячим мертвецом».~
@4628 = ~«Нет... нет... так тоже неплохо. Прощай».~
@4629 = ~Зомби берет у тебя предметы и приступает к работе...~
@4630 = ~Попробовать не двигаться.~
@4631 = ~Попробовать не двигаться.~
@4632 = ~Попробовать не двигаться.~
@4633 = ~Зомби обильно натирает твое тело бальзамирующей жидкостью, затем широкими стежками зашивает несколько шрамов. Начав с ног, он медленно поднимается наверх, зашивая в конце концов твои губы.~
@4634 = ~«Ммм-ммф-ммм... Фпафибо».~
@4635 = ~«Ммм-ммф-ммм... Фпафибо».~
@4636 = ~«Ммм-ммф-ммм... Фпафибо».~
@4637 = ~Зомби держит тебя за руку. «Офтововно! Вафгоов вафофет фвы, науфив мафкивку. Фомби не говоят. Поняу? Говои медвенно, офтовоно».

^NПРИМЕЧАНИЕ: Помните, что никто не ожидает, что зомби будет говорить. Если вы, будучи зомби, заговорите с кем-нибудь, вы рискуете раскрыть свою маскировку.^-~
@4638 = ~«Ммф... ммм. Я... понимаю».~
@4639 = ~Зомби хмурится. «Мафкирофка не деужится доуго... бальфам выфыхает, фвы рвутфя, — он жмет плечами. — Фнаружи Морга от нее нифего не офтанетфя. Не бегай! Ефли ты побежифь, то науфифь вфю мафкирофку».

^NПРИМЕЧАНИЕ: Вооружение и/или бег немедленно разрушит вашу маскировку. Если вы найдете новое оружие, не используйте его до тех пор, пока вам больше не понадобится маскировка. Если у вас включен автобег и вы хотите сохранить маскировку, проверьте, что он отключен сразу же, как закончите разговаривать с Ваксисом.^-~
@4640 = ~Снова кивнуть, уйти.~
@4641 = ~«Зомби» хмурится. «Фде-то я тея виел. Мы не виелифь раньфе?»~
@4642 = ~«Может быть. Где ты меня видел?»~
@4643 = ~X. ~
@4644 = ~К твоему удивлению, зомби отступается от тебя... Он начинает со страхом озираться.~
@4645 = ~«Не хочешь говорить? Тогда приготовься кричать».~
@4646 = ~«Тогда неважно. Так чем же, по твоим наблюдениям, занимаются тленные?»~
@4647 = ~«Есть еще кое-что, что я хочу узнать...»~
@4648 = ~«Тогда забудь об этом. Прощай, *зомби*».~
@4649 = ~Зомби смотрит на вас обоих с явной опаской, продолжая молчать... но что-то в его выражении говорит тебе, что предположение Морта верно.~
@4650 = ~«Значит, анархисты? Так за кем вы тут следите?»~
@4651 = ~«Если ты скажешь мне прямо сейчас, почему анархисты следят за этим местом, боли будет ГОРАЗДО меньше».~
@4652 = ~«Тогда неважно. Так чем же, по твоим наблюдениям, занимаются тленные?»~
@4653 = ~«Есть еще кое-что, что я хочу узнать...»~
@4654 = ~«Тогда забудь об этом. Прощай, *зомби*».~
@4655 = ~Зомби выглядит сбитым с толку, но затем пожимает плечами, начиная копаться в своей заляпанной тунике. «Вфе тихо, твувявыя не февелятся, нифего новоо с пофледнего отфета». Спустя несколько секунд он протягивает тебе какие-то предметы, затем ворчит: «Вот» Судя по запаху, они прятались очень глубоко, чтобы их невозможно было найти в случае обыска. «Я фкоро уйду».~
@4656 = ~«Уйдешь? Как?»~
@4657 = ~~
@4658 = ~Зомби ворчит: «Поутал в арке — пеувый этав, феверо-фападная коумата, нувен кофтяной паиец дья откуывания, — он кивает. — Удафи».~
@4659 = ~«Э-э... Ладно».~
@4660 = ~Глаза зомби превращаются в щелочки, он шипит на тебя: «Ты ПЫТАЕФФЯ фапифать мея ф кьигу мертфых? У мея фдефь пвяфуффа двуфья, у тея фдефь *никоо*. Твониф мея — они тея пвиконфят».~
@4661 = ~«Это был твой последний шанс. Готовься к смерти».~
@4662 = ~«Тогда гори в аду. Я ухожу. Тебе лучше быть настороже... *зомби*!»~
@4663 = ~На миг он кажется испуганным, потом осматривает тебя, и по его лицу расползается ухмылка. «ТЫ пытаеффя фапифать МЕЯ ф кьигу мертфых? У мея фдефь пвячуффа двуфья, у тея фдефь *никоо*. Твонеф мея — они тея пвиконфят».~
@4664 = ~«А что, если я раскрою твою маскировку страже?»~
@4665 = ~«А что, если я раскрою твою маскировку страже?»~
@4666 = ~«Я рискну. Готовься к смерти».~
@4667 = ~«Тогда гори в аду. Я ухожу. Тебе лучше быть настороже... *зомби*».~
@4668 = ~Глаза зомби превращаются в щелочки, он шипит на тебя: «Ты подеилфя фо мной фвоим фекретом, я подеюфь фоим ф *тоой*. Фдефь у мея прячуффа друфья, у тея фдефь *никоо*. Твуфьявые тея уют. Я фбегу».~
@4669 = ~«Это был твой последний шанс, труп. Готовься к смерти».~
@4670 = ~«Тогда гори в аду. Я ухожу. Тебе лучше быть настороже... *зомби*».~
@4671 = ~«А?»~
@4672 = ~«Порталы?»~
@4673 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@4674 = ~«Мне нужно идти. Прощай».~
@4675 = ~Морт шепотом вклинивается в разговор. «О силы... этот пень — *анархист*. Строить из себя зомби — это первое, что может взбрести в их пустые головы».~
@4676 = ~«Анархист?»~
@4677 = ~«Анархисты... это такая фракция...» Похоже, Морт еле сдерживает поток оскорблений, но затем замечает, что зомби смотрит на вас обоих, внимательно слушая. «...они, э, хотят *освободить* всех от оков правительства. Свергнуть старый порядок, чтобы установить новый — без никаких порядков».~
@4678 = ~Правда: «Похоже на благородное стремление. Порядку время от времени не помешает хорошая встряска».~
@4679 = ~Ложь: «Похоже на благородное стремление. Любой анархист, посвятивший себя столь высокой цели, *определенно* является мне другом».~
@4680 = ~«Это все довольно... противоречиво».~
@4681 = ~«Это одна из самых идиотских вещей, которую я когда-либо слышал».~
@4682 = ~Правда: «Вряд ли кому-то это покажется созиданием. Для прогресса всегда нужны какой-никакой порядок и закон».~
@4683 = ~Шепотом: «Он интересуется, не спятил ли ты, не слетел с катушек, не выжил из ума... и я, кстати, тоже. А теперь выкинь это 'Я очнулся из мертвых' из своего лексикона, хорошо?! Ты ставишь меня в глупое положение».~
@4684 = ~«Я смущаю ТЕБЯ?»~
@4685 = ~«Я просто хотел узнать, о чем этот... труп... говорит. Ясно?»~
@4686 = ~«Не моя вина, что никто в этом сумасшедшем... 'чокнутом'... месте не говорит нормально... или хотя бы не ВЫГЛЯДИТ так».~
@4687 = ~«Слушай, я НЕ хочу лгать этому парню. Лучше говорить с ним напрямую».~
@4688 = ~Морт вздыхает. «Слушай, шеф... ты должен понимать свою ситуацию. Ты не сможешь разгуливать, рассказывая всем одну только ПРАВДУ. Мы не должны делать себя целями ловца кроликов, ясно?»~
@4689 = ~«Ловец кроликов? Цели? Что это... а, неважно».~
@4690 = ~«Замолкни, Морт».~
@4691 = ~«Я... я запомню это. Мне нужно поговорить с этим 'зомби'».~
@4692 = ~«Погоди... — говорит Морт удивленно. — Да этот пень — *анархист*. Ха. Строить из себя зомби — это первое, что может взбрести в их пустые головы».~
@4693 = ~«Анархист?»~
@4694 = ~«Анархисты — это фракция, которая тратит свое время на слежку за представителями власти и на поиски способов низвергнуть все, от чего несет порядком или контролем, — Морт фыркает. — Анархисты считают, что каждый пень на планах должен быть свободен и счастлив искать свою собственную 'правду', как только правительство будет сожжено дотла. Они хотят основать новый порядок, в котором не будет никакого порядка».~
@4695 = ~Правда: «Похоже на благородное стремление. Порядку время от времени не помешает хорошая встряска».~
@4696 = ~«Это все довольно... противоречиво».~
@4697 = ~«Это одна из самых идиотских вещей, которую я когда-либо слышал».~
@4698 = ~«Как хочешь».~
@4699 = ~Правда: «Вряд ли кому-то это покажется созиданием. Для прогресса всегда нужны какой-никакой порядок и закон».~
@4700 = ~«Он говорит, что этот Фарод продал очень много жмуриков... трупов... тленным. Ну, сборщики занимаются этим — находят тела мертвых и продают их тленным. Похоже, этот Фарод запродал так много жмуриков, что трухлявые начали подозревать, что он записывает жителей Улья в книгу мертвых раньше положенного срока... ну, ты понял, просто убивает их».~
@4701 = ~«Понятно. Я хотел бы знать кое-что еще...»~
@4702 = ~«Да этот Фарод просто святой. Возможно, позже у меня будут другие вопросы. Никуда не уходи».~
@4703 = ~«Он хочет знать, не обокрал ли кто тебя. Наверно, интересуется, что случилось».~
@4704 = ~«Понятно. Я хотел бы знать кое-что еще...»~
@4705 = ~«Да, я жду не дождусь поймать этого вора. Слушай, возможно, позже у меня будут другие вопросы. Никуда не уходи».~
@4706 = ~«Ага, уж кто тупые, так это *они*. Это точно».~
@4707 = ~Окно характеристик~
@4708 = ~«Не могу поверить, что ты делаешь это. Ты, что, СОВСЕМ спятил?»~
@4709 = ~Свиток жреца~
@4710 = ~«А нельзя ли ему зашить рот потуже?»~
@4711 = ~«Замоокни, Моот...»~
@4712 = ~«Ммм-ХММФ!»~
@4713 = ~Поток проклятий~
@4714 = ~Центральная комната~
@4715 = ~Препараторская.~
@4716 = ~Приемная.~
@4717 = ~Крематорий~
@4718 = ~СИЛ~
@4719 = ~Квитанция Боголюдей~
@4720 = ~Квитанция~
@4721 = ~Раскрывающийся портал~
@4722 = ~Клещи~
@4723 = ~Кузнечный молот~
@4724 = ~Железная руда~
@4725 = ~Топор из рогов~
@4726 = ~Низкокачественный стилет~
@4727 = ~Высококачественная кувалда~
@4728 = ~Укус Морта~
@4729 = ~«Ты ведь должен был уйти? Стража! Выведите отсюда этого пня!»~
@4730 = ~Уйти.~
@4731 = ~«На помощь! Стража! Стража!»~
@4732 = ~Атаковать.~
@4733 = ~Уйти.~
@4734 = ~«Силы небесные! Наше оборудование уничтожено! Откуда же теперь фрактол будет брать деньги, чтобы платить нам? Хорошо, что мы преданы нашей цели. Ну, мне уже пора возвращаться к работе... теперь работать будет вдвое тяжелее. Я бы сказал, это чертовски сложное испытание».~
@4735 = ~Уйти.~
@4736 = ~«Привет, брат! Хотел бы я найти время, чтобы поговорить с тобой, вот только расплавленная сталь ждать не будет. Если тебе чего-нибудь нужно, поговори с бригадирами... у них-то время есть».~
@4737 = ~«Ладно. Удачи».~
@4738 = ~«Значит, ты расследуешь убийство, так? Не скажу, что сильно огорчен тем, что того ублюдка завалили, но, с другой стороны, не скажешь, чтобы кто-нибудь имел зуб на этого алкаша. С чего начинать? Даже не знаю».~
@4739 = ~«Но ведь ты знаешь больше, чем хочешь мне сказать?»~
@4740 = ~«Но ведь ты знаешь больше, чем хочешь мне сказать?»~
@4741 = ~«Ладно. Можешь еще раз подсказать мне насчет кузницы?»~
@4742 = ~«Ладно. Спасибо за уделенное время».~
@4743 = ~«Ну, что ж... — кузнец украдкой оглядывается. — Неплохо бы тебе начать с бригадира. В последнее время она выглядит немного раздосадованной. Не думаю, что это она, но мне кажется, она может иметь кое-какие соображения насчет того, кто это сделал».~
@4744 = ~«Бригадир? Где мне ее найти?»~
@4745 = ~«Спасибо за уделенное время. Прощай».~
@4746 = ~«Нет, это все, что я могу тебе сказать».~
@4747 = ~«Ладно. Можешь еще раз подсказать мне, как пользоваться кузницей?»~
@4748 = ~«Ладно. Спасибо за уделенное время».~
@4749 = ~«Хочешь поработать в кузнице? Во-первых, тебе нужен защитный фартук. Потом тебе нужны еще клещи, молоток и свободная наковальня. Берешь кусок железа, держишь его в огне, пока не станет пластичным, а потом выбиваешь из него дурь на наковальне. Как только получишь нужную форму, суешь его в ведро с водой. Только заметь, это ускоренный курс... чтобы справиться, тебе понадобятся кое-какие навыки».~
@4750 = ~«А что здесь может быть сложного?»~
@4751 = ~«Хорошо. У меня есть другие вопросы».~
@4752 = ~«Ладно. Спасибо».~
@4753 = ~«Обычно она где-то возле конторы клерка... наблюдает за нами. Черт, я понимаю, что это ее работа, но мне-то можно было бы доверять».~
@4754 = ~«Спасибо. У меня есть другие вопросы».~
@4755 = ~«Если бы тебе можно было доверять, тебе бы не нужен был бригадир. Прощай».~
@4756 = ~«Могу себе представить. Прощай».~
@4757 = ~«Посмотрим, как ты удивишься, пень. Убирайся отсюда. Я занят».~
@4758 = ~Уйти.~
@4759 = ~«Посмотрим, как ты удивишься, пень. Убирайся отсюда. Я занят».~
@4760 = ~«Да? Чего? Давай быстрее, я занят».~
@4761 = ~«Кто ты?»~
@4762 = ~«Где мне найти контору клерка?»~
@4763 = ~«Где твой бригадир?»~
@4764 = ~«Чем ты здесь занимаешься?»~
@4765 = ~«Что ты можешь рассказать о боголюдях?»~
@4766 = ~«Вообще-то, я слишком занят, чтоб стоять тут и трепаться с каждым встречным. Тебе здесь чего-нибудь нужно?»~
@4767 = ~«Ну, да».~
@4768 = ~«На самом деле, нет».~
@4769 = ~«Тогда перестань тратить мое время. У меня график. Прощай».~
@4770 = ~Уйти.~
@4771 = ~«Видишь вон там комнату со столом и стариканом, что сидит за ним? Это контора клерка, и там сидит клерк. Тебе еще чего-нибудь нужно, или мне уже можно вернуться к работе?»~
@4772 = ~«У меня есть еще вопросы».~
@4773 = ~«Нет, это все. Пока».~
@4774 = ~«О, да я здесь весь день сижу, задрав ноги. Слушай, не хочу показаться грубым, но ведь совершенно очевидно, чем я занимаюсь: я кую вещи из стали. И если я в ближайшее время не вернусь к работе, мне придется начать ее сначала».~
@4775 = ~«Ладно-ладно. У меня еще немного вопросов».~
@4776 = ~«Спасибо за уделенное время. Пока».~
@4777 = ~«Нет нужды в таком тоне, 'дружище'. До свидания».~
@4778 = ~Кузнец прекращает работу и смотрит на тебя, как бы оценивая. «Богочеловек — это вояка, который верит, что все мы можем стать богами. И даже ты. Неважно, хорошо это или плохо. Мы все проживаем наши жизни, учась превращению в более совершенные формы. Вот еще одно определение богочеловека: это тот, кого выводят люди, задающие вопросы, на которые они уже и так должны знать ответы».~
@4779 = ~«То есть ты пытаешься сказать, что мы преодолеваем испытания, и от этого становимся лучше?»~
@4780 = ~«То есть ты пытаешься сказать, что ты — не самый подходящий человек для того, чтобы говорить об этом сейчас?»~
@4781 = ~«Спасибо. Я пошел».~
@4782 = ~«Я пытаюсь сказать, что тебе следует поговорить с одним из фрактотумов за той дверью в восточной стене: им все равно больше нечем заняться. В отличие от меня. Счастливо».~
@4783 = ~«У меня еще пара вопросов».~
@4784 = ~Уйти.~
@4785 = ~«Дружище, мне кажется, ты уже достаточно поработал в кузнице. Все согласны, что ты уже... э-э... чему-то научился. Отойди и дай поработать тем, кому это действительно нужно».~
@4786 = ~«Ну ладно».~
@4787 = ~«Силы небесные! Наше оборудование уничтожено! Откуда же теперь фрактол будет брать деньги, чтобы платить нам? Хорошо, что мы преданы нашей цели. Ну, мне уже пора возвращаться к работе... теперь работать будет вдвое тяжелее. Я бы сказал, это чертовски сложное испытание».~
@4788 = ~Уйти.~
@4789 = ~«Силы небесные! Наше оборудование уничтожено! Откуда же теперь фрактол будет брать деньги, чтобы платить нам? Хорошо, что мы преданы нашей цели. Ну, мне уже пора возвращаться к работе... теперь работать будет вдвое тяжелее. Я бы сказал, это чертовски сложное испытание».~
@4790 = ~Уйти.~
@4791 = ~«Забудь».~
@4792 = ~«Некоторые подписывают с тленными контракты, согласно которым они могут использовать их тела, как только те умрут. Возможно, тебя взяли... по недоразумению. Ты кажешься гораздо умнее, чем наши обычные зомби».~
@4793 = ~«Люди продают вам свои тела после смерти?»~
@4794 = ~«О. У меня есть другие вопросы...»~
@4795 = ~«У меня нет времени на это. Прощай».~
@4796 = ~«О да. В обмен на небольшую сумму многие готовы продать свое тело, которое все равно им не понадобится, когда они достигнут Истинной Смерти».~
@4797 = ~«И что вы делаете с этими телами?»~
@4798 = ~«Понятно... Ты не против, если я задам тебе пару вопросов?»~
@4799 = ~ «Спасибо за информацию. Прощай».~
@4800 = ~«Оболочки совершают различные поручения по всему Моргу. Они перевозят тела, моют полы, помогают готовить тела к погребению... относительно несложные задачи. К сожалению, они не способны выполнять более сложные инструкции».~
@4801 = ~«Хорошо, 'контрактник' я или нет, но как я попал сюда, если я не мертв?»~
@4802 = ~«Понятно... Ты не против, если я задам тебе пару вопросов?»~
@4803 = ~ «Спасибо за информацию. Прощай».~
@4804 = ~Соэго кивает: «Задавай свои вопросы».~
@4805 = ~«Я хочу уйти. Можешь ли ты проводить меня к выходу?»~
@4806 = ~«Можешь ли ты помочь мне выбраться отсюда?»~
@4807 = ~«Тебе известно, что на втором этаже есть труп, который на самом деле — замаскированный человек?»~
@4808 = ~«Прошу прощения?»~
@4809 = ~«Можно спросить... с тобой все в порядке? Ты выглядишь уставшим».~
@4810 = ~«Ты ведь Соэго, верно? Я слышал, что ты немного странноват для тленного. Что ты похож на крысу».~
@4811 = ~«Ты ведь Соэго, верно? Я слышал, что ты немного странноват для тленного. Что ты похож на крысу».~
@4812 = ~Качественное зеркало~
@4813 = ~Железная руда~
@4814 = ~P3 SFull~
@4815 = ~Серебряная серьга~
@4816 = ~Сердце Захарии~
@4817 = ~Исход души~
@4818 = ~Отпугнуть нежить~
@4819 = ~Печень Захарии~
@4820 = ~Булыжник~
@4821 = ~Срезанный медяк~
@4822 = ~Контракт Смерти Ангиара~
@4823 = ~Контракт Смерти Медноглазого~
@4824 = ~Фальшивый Контракт Смерти~
@4825 = ~Полэкс~
@4826 = ~Череп-кулон~
@4827 = ~Малый меч~
@4828 = ~Кинжал Адана~
@4829 = ~Кольцо Адана~
@4830 = ~Плоский черный жетон~
@4831 = ~Крысиный амулет~
@4832 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@4833 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@4834 = ~«Неважно. Мне нужно идти. Прощай».~
@4835 = ~«Неважно. Мне нужно идти. Прощай».~
@4836 = ~«Наверху есть человек, замаскированный под труп. Я думаю, он шпионит за тленными».~
@4837 = ~«Наверху есть человек, замаскированный под труп. Я думаю, он шпионит за тленными».~
@4838 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@4839 = ~«Неважно. Мне нужно идти. Прощай».~
@4840 = ~«Что? Как это могло случиться?..» Соэго внезапно переходит на шепот, его губы раскрываются, обнажая ряд острых зубов. «*Анархист*, — в его глазах вспыхивает красный огонек. — Анархист. *Здесь*, — неожиданно он вспоминает о твоем присутствии и успокаивается. — Спасибо за предупреждение. Я позабочусь, чтобы стража разобралась с этим делом». ~
@4841 = ~РАСКРЫВАЮЩИЙСЯ ПОРТАЛ
Вес: 10

Это блестящий образец филигранного металлического изделия, которое ты забрал в Великой Литейной. Оно кажется почти невесомым. Из него выдвигаются острые лезвия Пока ты не представляешь, для чего оно предназначено, но, должно быть, оно достаточно важно, чтобы оставить его при себе.

Все, что тебе нужно для того, чтобы активизировать его, — это найти подходящий ключ.~
@4842 = ~КЛЕЩИ
Вес: 5

Покрытые сажей клещи, используемые для удержания железной руды в пылающем огне горна.~
@4843 = ~КУЗНЕЧНЫЙ МОЛОТ
Вес: 4

Молот, используемый для ковки железа. Очень тяжелый.~
@4844 = ~ЖЕЛЕЗНАЯ РУДА
Вес: 5

Кусок железной руды.~
@4845 = ~НИЗКОКАЧЕСТВЕННАЯ КУВАЛДА
Урон: 2-7 дробящий
Скорость: 8
Вес: 10
Специализация: дубины
Используется только бойцами

Этот молот представляет собой немногим большее, чем тяжелую глыбу металла на конце прочной палки. Да, он мощный, но у него плохой баланс и он совершенно неизящен.~
@4846 = ~ВЫСОКОКАЧЕСТВЕННАЯ КУВАЛДА
Урон: 1-10 дробящий
Скорость: 8
Вес: 9
Специализация: молоты
Используется только бойцами

Это добротный молот, хорошо сбалансированный и радующий глаз. Пусть вас не смущает его внешний вид — это оружие опасно. Ему необходимы пара рук и желание наносить сокрушающий урон врагам.~
@4847 = ~ВЫСОКОКАЧЕСТВЕННЫЙ СТИЛЕТ
Урон: 1-4 колющий
Скорость: 1
Вес: 1
Специализация: клинковые
Не используется жрецами

Этот тонкий кинжал — своего рода произведение искусства. Это одноручное колющее оружие.~
@4848 = ~НИЗКОКАЧЕСТВЕННЫЙ СТИЛЕТ
Урон: 1-2 колющий
Скорость: 2
Вес: 1
Специализация: клинковые
Не используется жрецами

Этот широкий кинжал, задуманный как колющее оружие, на деле больше годится разве что под пресс-папье. Он туп и несбалансирован, и в настоящем бою может только помешать.~
@4849 = ~ТОПОР ИЗ РОГОВ
Урон: 2-7 рубящий
Скорость: 8
Вес: 8
Специализация: топоры
Используется только бойцами

Первобытные культуры нередко использовали части тела животных в качестве оружия. Похоже, это рога какого-то существа, превращенные в грубое подобие боевого топора. ~
@4850 = ~БУЛЫЖНИК
Вес: 3

Этот отполированный булыжник раньше находился в черепе зомби. С него до сих пор стекают остатки мозга.~
@4851 = ~КОЖАНЫЙ ФАРТУК
Вес: 5

Похоже, это тяжелый фартук, сделанный из шкуры какого-то животного. Подобные фартуки используются для защиты одежды рабочих от жара кузницы.~
@4852 = ~«Без проблем. У меня есть еще вопросы...»~
@4853 = ~«Неважно. Мне нужно идти. Прощай».~
@4854 = ~«Неважно. Мне нужно идти. Прощай».~
@4855 = ~Ты уже готов сказать это, но вдруг останавливаешься. Глядя на Соэго, ты чувствуешь странное покалывающее чувство... почему-то тебе кажется, что не следует ничего говорить. ~
@4856 = ~«Я слышал о тебе кое-что странное, Соэго. Что ты похож на крысу».~
@4857 = ~«Э... я хотел бы у тебя кое-что спросить».~
@4858 = ~«Неважно. Мне нужно идти. Прощай».~
@4859 = ~«Неважно. Мне нужно идти. Прощай».~
@4860 = ~На минуту Соэго в тишине изучает тебя. В его глазах вспыхивает красный огонек, и он издает легкое шипение. «Кажется, ты злоупотребляешь нашим гостеприимством». Неожиданно он делает шаг назад, затем быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@4861 = ~«Что за?.. Что ты делаешь?»~
@4862 = ~«Ну хорошо. Приготовься к смерти, Соэго».~
@4863 = ~Соэго удается слабо улыбнуться, уголки его рта слегка подрагивают. «Я немного приболел... небольшая лихорадка, ничего страшного. Иногда из-за нее трудно... заснуть».~
@4864 = ~«Я могу чем-нибудь помочь?»~
@4865 = ~«О. У меня есть другие вопросы...»~
@4866 = ~«Ясно. Что ж, мне нужно идти. Прощай».~
@4867 = ~«Ясно. Что ж, мне нужно идти. Прощай».~
@4868 = ~Соэго качает головой: «Нет-нет, спасибо за заботу... Я переживу, — он немного хмурится. — Тебе нужно что-либо еще?»~
@4869 = ~«Да. У меня есть еще вопросы...»~
@4870 = ~«Нет, не хочу тебя больше беспокоить. Спасибо за информацию».~
@4871 = ~«Нет, не хочу тебя больше беспокоить. Спасибо за информацию».~
@4872 = ~«Фарод? Ну конечно же, я знаю его, — он хмурится, в его глазах появляется красный блеск. — Отвратительный человек. Никакого уважения к мертвым, и еще меньше — к живым. Сборщик».~
@4873 = ~«Сборщик?»~
@4874 = ~«Ты знаешь, где его можно найти?»~
@4875 = ~«О. У меня есть другие вопросы...»~
@4876 = ~«Понятно. Кажется, мне пора идти».~
@4877 = ~«Понятно. Кажется, мне пора идти».~
@4878 = ~«Сборщики находят трупы и доставляют их сюда, в Морг. Затем мы заботимся о том, чтобы тела были похоронены надлежащим образом». ~
@4879 = ~«А если сборщик находит тело... мое, к примеру... он может принести его сюда и продать его вам?»~
@4880 = ~«А этот сборщик, Фарод... ты не знаешь, где я могу найти его?»~
@4881 = ~«О. У меня есть другие вопросы...»~
@4882 = ~«Ясно. Что ж, мне нужно идти. Прощай».~
@4883 = ~«Ясно. Что ж, мне нужно идти. Прощай».~
@4884 = ~«Да».~
@4885 = ~«Хм-м. Выходит, мне крайне важно найти этого Фарода. Ты не знаешь, где я могу найти его?»~
@4886 = ~«О. У меня есть другие вопросы...»~
@4887 = ~ «Спасибо за информацию. Прощай».~
@4888 = ~ «Спасибо за информацию. Прощай».~
@4889 = ~«Я знаю, что он живет в Улье, в трущобах вокруг Морга, но точнее сказать не могу. Другие сборщики могут знать, если они соизволят говорить с тобой». ~
@4890 = ~«Еще раз, чем занимаются сборщики?»~
@4891 = ~«О. У меня есть другие вопросы...»~
@4892 = ~ «Спасибо за информацию. Прощай».~
@4893 = ~ «Спасибо за информацию. Прощай».~
@4894 = ~«Дневник? — Соэго выглядит растерянным. — Нет, мне он не попадался».~
@4895 = ~«Ладно, неважно. У меня есть другие вопросы...»~
@4896 = ~«Все равно спасибо. Прощай».~
@4897 = ~«Все равно спасибо. Прощай».~
@4898 = ~Перед тобой сильно уставший мужчина в черной одежде. Его худощавое лицо очень бледно, похоже, он не высыпается: плечи поникли, под красными глазами огромные мешки. Он настолько погружен в раздумья, что даже не замечает тебя.~
@4899 = ~«Приветствую».~
@4900 = ~~
@4901 = ~~
@4902 = ~~
@4903 = ~~
@4904 = ~«Приветствую...» Человек поворачивается к тебе лицом и слегка кивает. Внезапно ты замечаешь, что его глаза не налиты кровью, а просто имеют красный оттенок. «Я Соэго. Чем я могу... — неожиданно он замечает твои шрамы, при этом уголки его рта начинают подрагивать. — Прошу прощения, ты потерялся?»~
@4905 = ~«Да».~
@4906 = ~«Нет».~
@4907 = ~«Нет, я не потерялся. У меня есть несколько вопросов...»~
@4908 = ~«Нет. Я просто искал выход. Прощай».~
@4909 = ~«Тогда ладно... — уголки рта Соэго снова начинают подрагивать, словно в предвкушении. — Позволь мне позвать охрану, она выпроводит тебя. Подожди минуточку». Кажется, вот-вот он позовет охрану.~
@4910 = ~«Секундочку! Пожалуйста... не надо звать охрану. Я пришел сюда на похороны, и просто заблудился в этих залах... Ты не можешь указать мне выход наружу?»~
@4911 = ~«Нет! Я не потерялся. Я оговорился».~
@4912 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4913 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4914 = ~Уйти. Быстро.~
@4915 = ~Подождать.~
@4916 = ~«Не помню, чтобы я тебя впускал, — Соэго подозрительно смотрит на тебя, его глаза горят красными факелами. — Могу ли я поинтересоваться, что ты здесь делаешь?»~
@4917 = ~«Я был здесь на похоронах, отдавал дань уважения. Я уже готов уйти... вот только, кажется, я заблудился. Ты не поможешь мне найти выход?»~
@4918 = ~«Это тебя не касается».~
@4919 = ~«Я очнулся на одной из плит в вашей препараторской».~
@4920 = ~«Я хочу повидаться кое с кем».~
@4921 = ~«Я пришел сюда на похороны, но, похоже, произошла ошибка».~
@4922 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем, когда он наклоняется в ответ, свернуть ему шею.~
@4923 = ~Уйти. Быстро.~
@4924 = ~Он выглядит удивленным. «Ты... очнулся на одной из плит наверху?»~
@4925 = ~«Ой, нет. Я оговорился».~
@4926 = ~«Да. Я знаю, в это трудно поверить, но это правда. Я очнулся на одной из ваших плит наверху».~
@4927 = ~Соэго кивает. «С кем ты хочешь увидеться? Я буду рад тебе показать дорогу».~
@4928 = ~«Это не твое дело».~
@4929 = ~«Я хочу повидаться с Дхоллом».~
@4930 = ~«Я хочу повидаться с Дейонаррой».~
@4931 = ~Ложь: «Э... с Аданом. Он все еще работает здесь, или?..»~
@4932 = ~Ложь: «Э... с Аданом. Он все еще работает здесь, или?..»~
@4933 = ~«Ой, ни с кем. Я оговорился».~
@4934 = ~«Дхолла? Писаря Дхолла можно найти в приемной комнате на верхнем этаже, — уголки рта Соэго начинают подрагивать. — Он очень занят, а здоровье его подорвано. Если у тебя к нему не срочное дело, то лучше не беспокоить его».~
@4935 = ~«Что не так с Дхоллом?»~
@4936 = ~«В приемной комнате?»~
@4937 = ~«Хорошо. Я не буду долго задерживать его. Прощай».~
@4938 = ~«Да... в приемную комнату доставляются все тела из города. Их записывают, а затем подготавливают к погребению».~
@4939 = ~«Что не так с Дхоллом?»~
@4940 = ~«Спасибо за разъяснения. Я постараюсь, чтобы мой визит к Дхоллу был коротким. Прощай».~
@4941 = ~«О, с ним ничего плохого. Дхолл... — Соэго клацает зубами, — очень *стар*. Его ревностная каталогизация мертвых довела его до ручки. Несомненно, смерть незамедлительно последует за его изнурительной болезнью».~
@4942 = ~«Хорошо. Я не буду долго задерживать его. Прощай».~
@4943 = ~«Дейонарру? В северо-западном мемориальном зале погребена женщина с таким именем. Ты ее ищешь?»~
@4944 = ~«Да... ты можешь сказать, что с ней произошло?»~
@4945 = ~«Да. Мне нужно ее проведать».~
@4946 = ~«Я не знаю, но она здесь уже достаточно долго. Ее отец может знать, что произошло с ней... он часто приходит сюда из своих апартаментов в Верхнем районе. Это он захотел поместить ее здесь в мемориальном зале».~
@4947 = ~«Спасибо за разъяснения. Пойду, проведаю ее».~
@4948 = ~«Адан...» Глаза Соэго сужаются, красный блеск, который ты в них видел, казалось бы, усиливается. «В этих залах Морга нет никого, живого или мертвого, носящего подобное имя». Его рот подергивается, и, к твоей неожиданности, он начинает принюхиваться. ~
@4949 = ~«Э... значит, я ошибся».~
@4950 = ~Уголки рта Соэго снова подергиваются, а глаза сверкают. «Тогда что ты здесь делаешь?»~
@4951 = ~«Я был здесь на похоронах, отдавал дань уважения. Я уже готов уйти... вот только, кажется, я заблудился. Ты не поможешь мне найти выход?»~
@4952 = ~«Это не твое дело».~
@4953 = ~«Я очнулся на одной из плит в вашей препараторской».~
@4954 = ~«Я хочу повидаться кое с кем».~
@4955 = ~«Я пришел на похороны».~
@4956 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем, когда он наклоняется в ответ, свернуть ему шею.~
@4957 = ~Соэго хмурится, когда ты наклоняешься вперед. Ты замечаешь, что он что-то вынюхивает, что-то проверяя. Неожиданно его глаза сужаются. Похоже, он готов позвать стражу.~
@4958 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4959 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4960 = ~До того, как ты смог дотянуться до Соэго, он отскакивает назад. В его глазах вспыхивает красный огонек, он скалит зубы. Шипя, он быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@4961 = ~«Ну хорошо...»~
@4962 = ~«Кого хоронили? Возможно, служба проводится в другом месте Морга».~
@4963 = ~«Ты не понял... хоронили МЕНЯ».~
@4964 = ~«Прошу прощения... Я оговорился. Мне неизвестно имя усопшего».~
@4965 = ~«Ее зовут Дейонарра».~
@4966 = ~«Ну...» Соэго отводит глаза в сторону. Кажется, он смущен. «Кажется, произошла какая-то ошибка. Или тебя принесли твои кровные родственники, или тленные, или... — Соэго неожиданно умолкает, как будто ему в голову пришла неприятная мысль, — или один из *сборщиков*».~
@4967 = ~Ложь: «Его зовут... э, Адан».~
@4968 = ~Ложь: «Его зовут... э, Адан».~
@4969 = ~Наклониться вперед, будто собираясь прошептать ему что-то, а затем свернуть ему шею.~
@4970 = ~Убежать от него.~
@4971 = ~«Сборщиков?»~
@4972 = ~«Да, сборщиков... банды собирателей, которые приносят нам мертвые тела. Они могли решить, что ты мертв, — Соэго хрипит, его глаза приобретают блеск, — они были так ослеплены медью, что не позаботились проверить тело перед тем, как доставить тебя сюда, — Соэго изучает тебя. — Тебе несказанно повезло, что ты выжил... иначе ты мог достичь Истинной Смерти раньше положенного срока».~
@4973 = ~«Значит, произошла ошибка... Я хочу уйти отсюда. Немедленно».~
@4974 = ~Соэго кивает, уголки его рта начинают подрагивать. «Ну... ладно, ладно. Позволь мне открыть главные ворота».~
@4975 = ~«Хорошо». ~
@4976 = ~«Хорошо». ~
@4977 = ~«Тебя?»~
@4978 = ~«Да, *меня*. Я пробудился на одной из ваших плит наверху».~
@4979 = ~«Прошу прощения... Я ошибся».~
@4980 = ~При твоем приближении Соэго вынюхивает воздух и поднимает взгляд. Увидев тебя, он хмурится. «Я уже открыл для тебя ворота. Почему ты все еще здесь?»~
@4981 = ~«Перед тем, как уйти, я хочу задать несколько вопросов».~
@4982 = ~«Я как раз направляюсь к воротам. Прощай».~
@4983 = ~При твоем приближении Соэго вынюхивает воздух и поднимает взгляд. Увидев тебя, он слегка кивает. «Ты нашел то, что искал?»~
@4984 = ~«Да, спасибо. Прошу прощения, я, кажется, заблудился в этих залах... Ты не поможешь мне найти выход?»~
@4985 = ~«Да. Мне пора идти. Ты можешь указать, где выход?»~
@4986 = ~«Да, я как раз направляюсь к воротам. Прощай».~
@4987 = ~Соэго кивает, уголки его рта немого подрагивают. «Ну почему же... конечно. Эти залы *могут* запутать посетителей. Позволь мне открыть для тебя ворота».~
@4988 = ~«Спасибо».~
@4989 = ~«Спасибо».~
@4990 = ~«Очень странно» В глазах Соэго вспыхивает красный огонек, уголки рта начинают подрагивать, будто в предвкушении. «Может... — он широко ухмыляется, показывая ряд острых грязных зубов. — Может, мне стоит позвать охрану? Да... да, пожалуй, я так и сделаю».~
@4991 = ~«Постой! Я потерялся... Я просто заблудился в этих залах и теперь не могу найти выход. Ты можешь мне помочь?»~
@4992 = ~«Стой! Не надо звать стражу! Я просто хочу выбраться отсюда... ты поможешь мне?»~
@4993 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4994 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@4995 = ~«Давай, зови их. Буду рад с ними встретиться».~
@4996 = ~Соэго кивает... но его рот снова дергается. Похоже, он этого даже не замечает. «Возвращайся, когда воздашь все почести, и я открою для тебя главные ворота. Уже пробило девять ударов — закончи свои дела побыстрее».~
@4997 = ~«Пожалуй, отложу это до следующего раза. Ты мог бы меня отсюда выпустить?»~
@4998 = ~«Спасибо. Я скоро вернусь».~
@4999 = ~«У меня совершенно нет на это времени. Прощай».~
@5000 = ~Этот массивный топор является оружием с двумя лезвиями и шипом на обухе. Это оружие занимает две руки, но длинная рукоять позволяет владельцу развить значительную силу при замахе. Он похож скорее на железную глыбу с заточенной гранью, и баланс у него далек от совершенства. Это оружие пригодится в случае крайней необходимости.~
@5001 = ~Этот молот — не более чем тяжелая глыба металла на конце крепкой палки. Да, он мощный, но баланс у него неважный, и он начисто лишен изящества. Для его использования потребуются две руки.~
@5002 = ~Это молот искусной работы, прекрасно сбалансированный и радующий глаз. Но не будь одурачен его внешним видом — это оружие опасно. Для него потребуются две руки и желание наносить дробящий урон своим врагам.~
@5003 = ~ВЫСОКОКАЧЕСТВЕННЫЙ СТИЛЕТ
Урон: 1-4 колющий
Вес: 1
Скорость: 1
Специализация: клинковые
Не используется жрецами

Этот тонкий кинжал — своего рода произведение искусства. Это одноручное колющее оружие.~
@5004 = ~Этот широкий кинжал, идеальный в качестве колющего оружия, на деле больше годится под пресс-папье. Он туп и несбалансирован, и в настоящем бою может только помешать.~
@5005 = ~Это пригоршня живых зубов Ингресс. Скорее всего, они не захотели возвращаться с ней сквозь портал на ее родной план. Если держать их вместе, они начинают трещать, напоминая тебе кучу жутких прыгающих костяных жучков.~
@5006 = ~БУЛЫЖНИК
Вес: 3

Этот отполированный булыжник раньше находился в черепе зомби. С него до сих пор стекают остатки мозга.~
@5007 = ~СЕРДЦЕ ЗАХАРИИ
Вес: 10
Используется только бойцами

Этот почерневший предмет размером с кулак похож скорее на кусок сгоревшего древесного угля, чем на сердце Захарии. Для своего размера он невероятно тяжел, и по всей его поверхности тянутся трещины... Похоже, он может расколоться надвое в любой момент. Если подержать его, на руках остаются странные ржавые полосы, которые невозможно стереть.~
@5008 = ~СЕРЕБРЯНАЯ СЕРЬГА
Вес: 0

Эта небольшая серебряная серьга тебе досталась от подвыпившей проститутки у бара «Тлеющий труп». ~
@5009 = ~СРЕЗАННЫЙ МЕДЯК
Вес: 0

Этот медяк был «срезан»... почти весь металл сточен, хотя оставшаяся часть по-прежнему выглядит как целая монета, а вот спиленная медь позволит «резчику» сделать еще одну. Эта монета ничего не стоит.~
@5010 = ~ИСХОД ДУШИ
Вес: 1~
@5011 = ~ПЕЧЕНЬ ЗАХАРИИ
Вес: 3

Печень Захарии выглядит как огромный мертвый слизняк — у нее фактура бурдюка, лежавшего в грязной луже несколько лет. В этот орган было закачано достаточно бальзамирующей жидкости, чтобы сохранить его, но запах гнили и формальдегида, похоже, борются между собой за превосходство.~
@5012 = ~КОНТРАКТ СМЕРТИ АНГИАРА
Вес: 0

Этот хрупкий пергамент настолько пропах пылью, словно долгое время лежал на чердаке. Насколько можно понять из неразборчивого текста, этот документ является контрактом между двумя сторонами: фракцией тленных и мужчиной по имени «Ангиар». В обмен на тридцать медяков Ангиар передает права на свое тело тленным, что означает, скорее всего, что они смогут использовать его в качестве рабочего в Морге.~
@5013 = ~ГРАФИН
Вес: 2

Это обычный сосуд, закрытый пробкой. Внутри есть небольшое количество воды.~
@5014 = ~КОЛЬЦО АДАНА
Вес: 0

Это подарок, полученный тобой на прощанье от Адана в баре «Тлеющий труп». Непримечательное металлическое кольцо, с виду очень тяжелое и массивное, тем не менее оно почти невесомо. Когда ты его рассматриваешь, кажется, что кольцо переливается серебром, бронзой и золотом.~
@5015 = ~КИНЖАЛ АДАНА
Урон: 2-5 колющий
THAC0: +1
Скорость: 1
Вес: 0
Специализация: клинковые
Не используется жрецами

Это подарок, полученный тобой на прощание от Адана в баре «Тлеющий труп». Это непримечательный металлический кинжал с цельной серебряной рукоятью. Трудно ощутить его баланс, он почти невесом. Клинок кинжала сделан из какого-то странного металла, который переливается серебром, бронзой и золотом, когда ты его рассматриваешь.~
@5016 = ~Отпугнуть нежить~
@5017 = ~ФАЛЬШИВЫЙ КОНТРАКТ СМЕРТИ
Вес: 0

Этот поддельный «Контракт Смерти» похож на обычный Контракт Смерти тленных, однако мелкий судорожный почерк в нем скрывает тот факт, что подписавшийся в нем на самом деле вовсе не передавал тленным право на свое тело после смерти... по существу, в нем написано, что любой подписавший его тленный платит подписавшему контракт только лишь за его подпись.~
@5018 = ~КОНТРАКТ СМЕРТИ МЕДНОГЛАЗОГО
Вес: 0

Ты получил этот незаполненный контракт у Медноглазого; от него исходит слабый металлический запах. Из того, что ты разобрал в тексте, написанном мелким сжатым почерком, следует, что данный документ является контрактом между двумя сторонами: фракцией Тленных и пока еще неуказанной личностью. В обмен на тридцать медяков подписавший этот контракт передает права на свой труп тленным, предположительно, для использования его в качестве рабочего Морга.~
@5019 = ~ДУБИНА С ШИПАМИ
Урон: 1-6 дробящий
Урон: 1-6 колющий
Скорость: 7
Вес: 12
Специализация: дубинки
Не используется магами

Это тяжелая железная дубина, утыканная острыми шипами.~
@5020 = ~ИНТ~
@5021 = ~МУД~
@5022 = ~ЛОВ~
@5023 = ~ТЕЛ~
@5024 = ~ОБА~
@5025 = ~КЛАСС БРОНИ~
@5026 = ~ОЧКИ ЖИЗНИ~
@5027 = ~ОЧКИ ПЕРСОНАЖА~
@5028 = ~Убежать от него.~
@5029 = ~«Эй! Эй! Что ты делаешь?»~
@5030 = ~«Я *хотел* поговорить с этим парнем. Проблемы?»~
@5031 = ~«Ничего. Идем».~
@5032 = ~«Если ты собираешься трясти черепушкой с трухлявыми, то, пожалуйста, без меня. Я с ними не в лучших отношениях... и тебе не стоит с ними родниться. Они скорее спалят тебя или заживо зароют, чем будут слушать. Не валяй дурака, давай выбираться отсюда».~
@5033 = ~«Спасибо за совет, но я *все еще* хочу поговорить с этим парнем».~
@5034 = ~«Согласен. Идем».~
@5035 = ~«Эй! Ты оглох, что ли? Ты что творишь?»~
@5036 = ~«Слушай, я хочу поговорить с этим парнем. Проблемы?»~
@5037 = ~«Ничего. Идем».~
@5038 = ~«Тогда *не слушай* меня больше — тебя похоронят».~
@5039 = ~«Да-да, а ты сможешь поплакаться на панихиде. А пока — умолкни».~
@5040 = ~«А, ты прав. Забудь об этом. Идем».~
@5041 = ~«Что ты *наделал*? Если ты хочешь убить его, сделай это!»~
@5042 = ~«Я это и *хотел*! Я свернул ему шею! Он не должен теперь шевелиться!»~
@5043 = ~«По крайней мере он *ходить* умеет, — Морт фыркает. — Радость о полета пропадает в тот момент, когда мне хочется кого-то пнуть». ~
@5044 = ~(Auto-Link.)~
@5045 = ~Выглядит так, будто кто-то остановился на полпути при вскрытии этого тела.~
@5046 = ~В этих бочках содержится темная жидкость. Она пахнет смесью уксуса и формальдегида.~
@5047 = ~Test Drink for Tavern Test 1~
@5048 = ~Этот стол покрыт мотками ниток, обрывками одежды, ржавыми инструментами, грязными пузырьками и окровавленными простынями.~
@5049 = ~«Эй, шеф! Ты что творишь?!»~
@5050 = ~«Я хотел поговорить с этим писарем. Он может кое-что знать о том, как я попал сюда».~
@5051 = ~Это тело выглядит так, словно кто-то вывернул его наизнанку. Машина в конце стола сняла кожу со лба, открыв прямой доступ к черепу.~
@5052 = ~«Послушай, трясти черепушкой с трухлявыми — это ПОСЛЕДНЯЯ мысль, которая должна...»~
@5053 = ~«И мы *тем более* не должны болтать с больными трухляками. Давай, пошли отсюда. Чем быстрее мы свалим отсюда, тем лучш...»~
@5054 = ~Как и все тела в этой комнате, это покрыто кровью и полностью выпотрошено.~
@5055 = ~Похоже на огромную дробилку. Из-под нее вытекает свежая кровь.~
@5056 = ~Это тело накрыто грубым темным полотном.~
@5057 = ~Это тело замотали бинтами, как мумию.~
@5058 = ~«Приветствую».~
@5059 = ~Эта плита покрыта засохшей кровью и какими-то ошметками.~
@5060 = ~Оставить старого писаря в покое.~
@5061 = ~Это устройство похоже на своеобразную швейную машину... с нее свисают рычаги с крючками, трубками и металлическими иглами.~
@5062 = ~«Ты знаешь меня?»~
@5063 = ~«Прощай».~
@5064 = ~Через всю комнату проходит система рельсов. Похоже, что плиты в ней можно передвигать по этим рельсам.~
@5065 = ~Этот гниющий труп истыкан трубками. Через них желтая жидкость течет в странную машину, которая щелкает, прямо как насекомое.~
@5066 = ~Кто-то воткнул трубку в ногу этого трупа. Она подключена к странной щелкающей машине, стоящей рядом с плитой.~
@5067 = ~Поверхность этой металлической плиты покрыта остатками крови и органов. Она гораздо больше других плит и помещена на вращающейся платформе.~
@5068 = ~Это выпотрошенное тело является наглядным свидетельством того, насколько далеко можно вытягивать внутренности, не разорвав их.~
@5069 = ~«Ты знаешь, кто я?»~
@5070 = ~«Где ее тело?»~
@5071 = ~«Я ничего о ней не знаю».~
@5072 = ~«Она узнала меня, но я не смог ее вспомнить».~
@5073 = ~«Ты говорил, что здесь есть другие. Кто они?»~
@5074 = ~«Ты говорил, что здесь есть другие. Кто они?»~
@5075 = ~«В северо-западном мемориальном зале, этажом ниже. Проверь гробы... ее имя должно быть на одной из мемориальных табличек. Возможно, это оживит твои воспоминания».~
@5076 = ~«Я не знаю. Не припомню, чтобы даже путешествовал вместе с женщиной».~
@5077 = ~«Да, она утверждает, что знает меня, но я не могу ее вспомнить».~
@5078 = ~«Ты говорил, что здесь есть другие. Кто они?»~
@5079 = ~«Ты говорил, что здесь есть другие. Кто они?»~
@5080 = ~Дхолл не отвечает. Он просто молчаливо смотрит на тебя.~
@5081 = ~«Где я могу найти ее?»~
@5082 = ~«Ты говорил, что здесь похоронены и другие мои спутники. Где они?»~
@5083 = ~«Ты говорил, что здесь похоронены и другие мои спутники. Где они?»~
@5084 = ~Еще один труп на каменной плите... нет никаких видимых причин его смерти.~
@5085 = ~Кровь на этом столе еще не успела засохнуть.~
@5086 = ~Ты готовишься снова поднять молот...~
@5087 = ~«... и что теперь?»~
@5088 = ~Ты подходишь к кузнице. Жара просто невероятная. Что ты будешь делать?~
@5089 = ~Поработать в кузнице.~
@5090 = ~Поработать в кузнице.~
@5091 = ~Поработать в кузнице.~
@5092 = ~Отступить назад.~
@5093 = ~Жар от пламени слишком силен, даже для твоей закаленной шкуры. Ты начинаешь получать урон от огня.~
@5094 = ~Поработать в кузнице.~
@5095 = ~Отступить назад.~
@5096 = ~Пламя излучает нестерпимый жар, но благодаря защите ты способен выдержать его без какого-либо урона. Ты хочешь поработать в кузнице?~
@5097 = ~Да.~
@5098 = ~Нет.~
@5099 = ~И снова пламя обжигает твою кожу. Что ты хочешь сделать в первую очередь?~
@5100 = ~Приготовить клещи.~
@5101 = ~Ударить по наковальне молотом.~
@5102 = ~Взять руду.~
@5103 = ~Взять руду клещами и подержать ее в пламени горна.~
@5104 = ~Положить руду на наковальню и ударить по ней молотом.~
@5105 = ~Отступить назад от кузницы.~
@5106 = ~Умереть. Слишком здесь жарко.~
@5107 = ~Ты держишь клещи твердой хваткой, жар горна покрывает твою кожу волдырями. Что ты хочешь сделать?~
@5108 = ~Ударить по наковальне молотом.~
@5109 = ~Взять руду клещами и подержать в огне.~
@5110 = ~Положить руду на наковальню и ударить по ней молотом.~
@5111 = ~Отступить назад от кузницы.~
@5112 = ~Умереть. Слишком здесь жарко.~
@5113 = ~Ты пару секунд колотишь по пустой наковальне, посылая звон металла о металл безразличным небесам, пока жар горна продолжает обжигать тебя. Что теперь?~
@5114 = ~Приготовить клещи.~
@5115 = ~Ударить по наковальне молотом.~
@5116 = ~Взять руду.~
@5117 = ~Взять руду клещами и подержать ее в пламени горна.~
@5118 = ~Положить руду на наковальню и ударить по ней молотом.~
@5119 = ~Отступить назад от кузницы.~
@5120 = ~Умереть. Слишком здесь жарко.~
@5121 = ~Ты берешь кусок руды голыми руками. Там, где ты стоишь, жар от горна кажется настолько сильным, чтобы может расплавить железо: твоя кожа просто изнывает от боли. Что теперь?~
@5122 = ~Ударить по наковальне молотом.~
@5123 = ~Держать руду в пламени горна клещами.~
@5124 = ~Положить руду на наковальню и ударить по ней молотом.~
@5125 = ~Держать руду в огне голыми руками.~
@5126 = ~Отступить назад от кузницы.~
@5127 = ~Срезанный медяк~
@5128 = ~Серебряная серьга~
@5129 = ~Булыжник~
@5130 = ~Зубы Ингресс~
@5131 = ~Низкокачественная кувалда~
@5132 = ~«Тест таверны»~
@5133 = ~«Ом-м-м».~
@5134 = ~«Славно, что ты пришел, рубака».~
@5135 = ~«Ищешь компанию, рубака?»~
@5136 = ~«Подойди, красавчик, поболтай со мной немножко».~
@5137 = ~«Порталы! Порталы, повсюду!..»~
@5138 = ~*Кхе*~
@5139 = ~*Кхе-Кхе*~
@5140 = ~Еще одна ржавая окровавленная плита.~
@5141 = ~Этот синий металлический гобелен сделан из тонких звеньев.~
@5142 = ~Здесь целый набор ножей, топоров и молотов. Если приглядеться, эти легковесные трофеи мало сгодятся в качестве оружия.~
@5143 = ~Некоторые из этих чаш наполнены сухой, похожей на известь субстанцией. В других содержатся какие-то неизвестные маслянистые жидкости.~
@5144 = ~На этой полке нет ничего, кроме нескольких кусков простого сукна.~
@5145 = ~Похоже, это мумифицированное тело доставлено для кремации.~
@5146 = ~Умереть. Слишком здесь жарко.~
@5147 = ~Руда быстро размягчается, становясь пригодной для работы. Твоя кожа покрывается волдырями.~
@5148 = ~Положить размягченную руду в горн и придать ей форму.~
@5149 = ~Мой молот! Я забыл взять молот, чтобы обработать эту штуку! Я вернусь!~
@5150 = ~Отойти от кузницы.~
@5151 = ~Умереть. Слишком здесь жарко.~
@5152 = ~Ты помещаешь холодную руду на наковальню и ударяешь по ней от всей души молотом, разбивая ее на бесполезные мелкие кусочки. Пламя горна играет симфонию боли на твоей коже.~
@5153 = ~Отступить назад от кузницы.~
@5154 = ~Смерть. Жара просто сокрушительна.~
@5155 = ~Боль от пламени просто изумительна. Руда в твоей руке становится мягкой как глина, воздух заполняется запахом горелой плоти. Железо вкипает в твою ладонь, и ты теряешь сознание от боли.~
@5156 = ~Готово.~
@5157 = ~Что ты хочешь выковать?~
@5158 = ~Что-нибудь маленькое и опасное — стилет!~
@5159 = ~Двуручный молот.~
@5160 = ~Боевой топор.~
@5161 = ~~
@5162 = ~Ничего. Жара невыносима для тебя.~
@5163 = ~Стилет... быстрое, простое в обращении оружие, и, к тому же, так ты быстрее вырвешься из этих адских мук. Ты действительно хочешь стилет?~
@5164 = ~Да.~
@5165 = ~Да.~
@5166 = ~Да.~
@5167 = ~Нет. Лучше я сделаю что-нибудь другое.~
@5168 = ~Нет. С кузницей я закончил.~
@5169 = ~Молот: его легко сделать, и ты сможешь быстро уйти от огня литейной. Ты действительно хочешь молот?~
@5170 = ~Да.~
@5171 = ~Да.~
@5172 = ~Да.~
@5173 = ~Нет. Лучше я сделаю что-нибудь другое.~
@5174 = ~Нет. С кузницей я закончил.~
@5175 = ~Работа над боевым топором потребует времени, и пока ты будешь над ним работать, пламя выжжет твою плоть. Ты уверен?~
@5176 = ~Да.~
@5177 = ~Да.~
@5178 = ~Да.~
@5179 = ~Нет. Лучше я сделаю что-нибудь другое.~
@5180 = ~Нет. С кузницей я закончил.~
@5181 = ~На этой мемориальной табличке изображен странный символ. Он выглядит как кричащий череп с острыми клинками, выступающими со всех сторон.~
@5182 = ~Эти тяжелые ворота из ржавой стали заперты. Нет никакого намека на возможность открыть их.~
@5183 = ~От стены до пола тянутся тяжелые металлические трубы.~
@5184 = ~Этот тяжелый гобелен сделан из какой-то сияющей материи. На нем — символ кричащего черепа с выступающими острыми клинками по сторонам.~
@5185 = ~Табличка на гробу гласит: «Здесь лежит Дейонарра».~
@5186 = ~Похоже на огромную гробницу. Мраморная облицовка придает ей довольно элегантный вид.~
@5187 = ~Табличка на этому гробу пуста.~
@5188 = ~NULL MODE~
@5189 = ~Ты критически рассматриваешь свою работу — это, конечно, не лучшее оружие, но, по крайней мере, у тебя хоть что-то вышло.~
@5190 = ~~
@5191 = ~~
@5192 = ~~
@5193 = ~~
@5194 = ~Это сгодится для моего испытания.~
@5195 = ~Полагаю, оно сгодится для боя...~
@5196 = ~Небольшое утешение. Жара просто убивает тебя. Но, по крайней мере, испытание богочеловека пройдено.~
@5197 = ~Небольшое утешение. Жара убивает тебя.~
@5198 = ~Ты создал стилет. Ты отходишь от кузницы, чтобы полюбоваться своей работой.~
@5199 = ~Это стилет. Вполне достаточно для испытания.~
@5200 = ~Это стилет. Вышло неплохо... и с виду он вполне годен для боя.~
@5201 = ~Жара просто невыносима. Испытание пройдено, но за это придется поплатиться.~
@5202 = ~Жара просто невыносима. За это придется поплатиться.~
@5203 = ~У тебя вышло очень даже неплохо! Твой стилет не только годен для боя, но и отлично сбалансирован, да и выглядит устрашающе. Отличная работа.~
@5204 = ~Эта вещь хорошо мне послужит. Без сомнений, Кельдор будет впечатлен! Самое время убираться из этого пламени.~
@5205 = ~Это отлично мне послужит в предстоящих испытаниях. Пора убираться из этого пламени.~
@5206 = ~Жара просто невыносима.~
@5207 = ~Жара просто невыносима. Я не могу двигаться... не могу дышать...~
@5208 = ~Выкованный тобой молот выглядит почти так же, как и та болванка, которую ты нашел. По крайней мере, должно сработать.~
@5209 = ~Для меня этого вполне достаточно. Пойду, покажу Кельдору.~
@5210 = ~Столько хлопот из-за куска металла? Силы небесные! Пойду-ка я отсюда.~
@5211 = ~Жара оказалась слишком сильной. Но, по крайней мере, испытание пройдено.~
@5212 = ~Жара оказалась слишком сильной.~
@5213 = ~Поглядите-ка! Это же кувалда... выглядит не лучше и не хуже других кувалд.~
@5214 = ~Отлично. Этого вполне достаточно для Кельдора. С кузницей я пока закончил.~
@5215 = ~Этого для меня вполне достаточно. Пора проломить кое-кому череп. С кузницей я пока закончил.~
@5216 = ~Жара и мощь литейной слишком сильны. Тем не менее, ты создал молот и, как минимум, прошел испытание.~
@5217 = ~Жара и мощь литейной слишком сильны.~
@5218 = ~Вот так отличная кувалда... удобной формы, хорошо сбалансированная, и отлично ложится в твои руки.~
@5219 = ~Хорошо. Я просто покажу ее Кельдору... и, возможно, позже проломлю ей пару черепов.~
@5220 = ~Хорошо. Это может пригодиться.~
@5221 = ~Силы литейной неодолимы. Но, по крайней мере, испытание богочеловека пройдено, и пройдено блестяще.~
@5222 = ~Силы литейной неодолимы.~
@5223 = ~И это — топор? Больше похоже на молот, и все же у него острые кромки, так что, наверно, лучше назвать его топором и закончить с этим.~
@5224 = ~Хм. Что ж, это удовлетворяет требованиям Кельдора.~
@5225 = ~Хм. Может, получится продать его на лом.~
@5226 = ~Жара и мощь пекла литейной оказались невыносимыми. Но, по крайней мере, испытание пройдено.~
@5227 = ~Жара и мощь пекла литейной оказались невыносимыми.~
@5228 = ~Это полноценное изделие. С ним ты не выиграешь никаких наград, однако оно годно для боя и смертоносно.~
@5229 = ~Вполне неплохо. Уверен, Кельдор это оценит.~
@5230 = ~И этого будет вполне достаточно: даже ним можно рассекать плоть и разбивать кости.~
@5231 = ~Удушающий черный дым литейной и неистовая жара слишком сильны. Но, по крайней мере, испытание пройдено.~
@5232 = ~Удушающий черный дым литейной и неистовая жара слишком сильны.~
@5233 = ~Еще немного отделки, и этот топор будет достоин руки лучшего воина — настолько он хорош.~
@5234 = ~Я всегда знал, что во мне это есть. Пойду, покажу Кельдору... и, возможно, испытаю это оружие.~
@5235 = ~Мы с этим топором еще много чего повидаем. Я так и чувствую это.~
@5236 = ~Отличная работа. К сожалению, жара литейной оказалась слишком сильной, чтобы терпеть дальше.~
@5237 = ~К сожалению, жара литейной оказалась слишком сильной, чтобы терпеть дальше.~
@5238 = ~Что ты хочешь сделать в первую очередь?~
@5239 = ~Приготовить клещи.~
@5240 = ~Ударить по наковальне молотом.~
@5241 = ~Взять руду.~
@5242 = ~Взять руду клещами и подержать ее в пламени горна.~
@5243 = ~Положить руду на наковальню и ударить по ней молотом.~
@5244 = ~Отступить назад от кузницы.~
@5245 = ~В этом шкафу хранятся бутылки, бинты и изорванные полоски ткани.~
@5246 = ~На крышке этого деревянного ящика стоят пузырьки, бутылки и прочие вещи.~
@5247 = ~На этом столе аккуратно разложены старые пергаменты и бинты.~
@5248 = ~На этой полке есть глиняные кувшины, пергамент, куски ткани и прочая утварь.~
@5249 = ~Ты держишь клещи твердой хваткой, пот течет по тебе ручьями. Что ты намерен делать?~
@5250 = ~Ударить по наковальне молотом.~
@5251 = ~Взять руду клещами и подержать в огне.~
@5252 = ~Положить руду на наковальню и ударить по ней молотом.~
@5253 = ~Отступить назад от кузницы.~
@5254 = ~Ты пару секунд колотишь по пустой наковальне, посылая звон металла о металл безразличным небесам. Жаркая, тяжелая и душная работа. Что теперь?~
@5255 = ~Приготовить клещи.~
@5256 = ~Ударить по наковальне молотом.~
@5257 = ~Взять руду.~
@5258 = ~Взять руду клещами и подержать ее в пламени горна.~
@5259 = ~Положить руду на наковальню и ударить по ней молотом.~
@5260 = ~Отступить назад от кузницы.~
@5261 = ~Ты держишь в руках кусок руды. В месте, где ты стоишь, жар от горна настолько силен, что почти плавит железо: он практически обжигает тебе кожу. Хорошо, что ты защищен от пламени. Что теперь?~
@5262 = ~Ударить по наковальне молотом.~
@5263 = ~Держать руду в пламени горна клещами.~
@5264 = ~Положить руду на наковальню и ударить по ней молотом.~
@5265 = ~Держать руду в огне голыми руками.~
@5266 = ~Держать руду в огне голыми руками.~
@5267 = ~Отступить назад от кузницы.~
@5268 = ~Руда быстро размягчается, вскоре став достаточно податливой для обработки. Твои руки становятся скользкими от пота.~
@5269 = ~Положить размягченную руду в горн и придать ей форму.~
@5270 = ~Мой молот! Я забыл взять молот, чтобы обработать эту штуку! Я вернусь!~
@5271 = ~Отойти от кузницы.~
@5272 = ~Ты помещаешь холодную руду на наковальню и ударяешь по ней от всей души молотом, разбивая ее на бесполезные мелкие кусочки. Пламя горна неистовствует, поднимая до небес вонь горящего метала.~
@5273 = ~Отступить назад от кузницы.~
@5274 = ~Боль от пламени просто изумительна. Руда в твоей руке становится мягкой как глина, воздух заполняется запахом горелой плоти. Железо вкипает в твою ладонь, и ты теряешь сознание от боли.~
@5275 = ~Что ты хочешь выковать?~
@5276 = ~Потерять сознание.~
@5277 = ~Что-нибудь маленькое и опасное — стилет!~
@5278 = ~Двуручный молот.~
@5279 = ~Боевой топор.~
@5280 = ~~
@5281 = ~Стилет... быстрое, простое в обращении оружие, и, к тому же, так ты быстрее вырвешься из этих адских мук. Ты действительно хочешь стилет?~
@5282 = ~Да.~
@5283 = ~Да.~
@5284 = ~Да.~
@5285 = ~Нет. Лучше я сделаю что-нибудь другое.~
@5286 = ~Нет. С кузницей я закончил.~
@5287 = ~Молот. Сделать его легко, и ты сможешь быстро уйти из этого карцера. Ты действительно хочешь молот?~
@5288 = ~Да.~
@5289 = ~Да.~
@5290 = ~Да.~
@5291 = ~Нет. Лучше я сделаю что-нибудь другое.~
@5292 = ~Нет. С кузницей я закончил.~
@5293 = ~Топор займет некоторое время, на протяжении которого тебе придется ох как несладко, но, как минимум, ты не сгоришь насмерть. Ты уверен, что хочешь сделать топор?~
@5294 = ~Да.~
@5295 = ~Да.~
@5296 = ~Да.~
@5297 = ~Нет. Лучше я сделаю что-нибудь другое.~
@5298 = ~Нет. С кузницей я закончил.~
@5299 = ~~
@5300 = ~~
@5301 = ~~
@5302 = ~Ты критически рассматриваешь свою работу — это, конечно, не лучшее оружие, но, по крайней мере, у тебя хоть что-то вышло.~
@5303 = ~Это сгодится для моего испытания.~
@5304 = ~Полагаю, оно сгодится для боя...~
@5305 = ~Ты создал стилет. Ты отходишь от кузницы, чтобы полюбоваться своей работой.~
@5306 = ~Это стилет. Вполне достаточно для испытания.~
@5307 = ~Это стилет. Вышло неплохо... и с виду он вполне годен для боя.~
@5308 = ~У тебя вышло очень даже неплохо! Твой стилет не только годен для боя, но и отлично сбалансирован, да и выглядит устрашающе. Отличная работа.~
@5309 = ~Эта вещь хорошо мне послужит. Без сомнений, Кельдор будет впечатлен! Самое время убираться из этого пламени.~
@5310 = ~Это отлично мне послужит в предстоящих испытаниях. Пора убираться из этого пламени.~
@5311 = ~Выкованный тобой молот выглядит почти также, как и та болванка, которую ты нашел. По крайней мере... должно сработать.~
@5312 = ~Столько хлопот из-за куска металла? Силы небесные! Пойду-ка я отсюда.~
@5313 = ~Для меня этого вполне достаточно. Пойду, покажу Кельдору.~
@5314 = ~Поглядите-ка! Это же кувалда... выглядит не лучше и не хуже других кувалд.~
@5315 = ~Отлично. Этого вполне достаточно для Кельдора. С кузницей я пока закончил.~
@5316 = ~Этого для меня вполне достаточно. Пора проломить кое-кому череп. С кузницей я пока закончил.~
@5317 = ~Вот так отличная кувалда... удобной формы, хорошо сбалансированная, и отлично ложится в твои руки.~
@5318 = ~Хорошо. Я просто покажу ее Кельдору... и, возможно, позже проломлю ей пару черепов.~
@5319 = ~Хорошо. Это может пригодиться.~
@5320 = ~И это — топор? Больше похоже на молот, и все же у него острые кромки, так что, наверно, лучше назвать его топором и закончить с этим.~
@5321 = ~Хм. Что ж, это удовлетворяет требованиям Кельдора.~
@5322 = ~Хм. Может, получится продать его на лом.~
@5323 = ~Это полноценное изделие. С ним ты не выиграешь никаких наград, однако оно годно для боя и смертоносно.~
@5324 = ~Вполне неплохо. Уверен, Кельдор это оценит.~
@5325 = ~И этого будет вполне достаточно: даже ним можно рассекать плоть и разбивать кости.~
@5326 = ~Еще немного отделки, и этот топор будет достоин руки лучшего воина — настолько он хорош.~
@5327 = ~Я всегда знал, что во мне это есть. Пойду, покажу Кельдору... и, возможно, испытаю это оружие.~
@5328 = ~Мы с этим топором еще много чего повидаем. Я так и чувствую это.~
@5329 = ~Твоя врожденная устойчивость к огню позволяет тебе держать руду в огне до тех пор, пока она не начинает плавиться и течь сквозь пальцы. Другие кузнецы в литейной с трепетом наблюдают, как расплавленная руда капает с твоих пальцев. К сожалению, руды больше нет.~
@5330 = ~Уйти.~
@5331 = ~Ты подходишь к кузнице. Жара просто невероятная. Что ты будешь делать?~
@5332 = ~Поработать в кузнице.~
@5333 = ~Поработать в кузнице.~
@5334 = ~Поработать в кузнице.~
@5335 = ~Отступить назад.~
@5336 = ~«Стража! Стража! Задержите этого человека! ХВАТАЙТЕ ЕГО!»~
@5337 = ~Готово.~
@5338 = ~«Проваливай, пень. Приходи в другой раз и, может быть, мы еще поговорим».~
@5339 = ~«У меня только парочка вопросов...»~
@5340 = ~«Я... сказала... ПРОВАЛИВАЙ. Вернешься в другой раз, когда как следует обдумаешь свою позицию на счет выполнения приказов».~
@5341 = ~Уйти.~
@5342 = ~Она саркастически тебе ухмыляется: «Спасибо тебе большое за то, что соизволил починить наши машины. Твоя забота о благополучии Литейной ну просто радует и воодушевляет. Пень». Она сплевывает на землю у твоих ног и отворачивается.~
@5343 = ~Напасть на нее.~
@5344 = ~«У меня есть вопросы к тебе».~
@5345 = ~Уйти.~
@5346 = ~«Чего? Парень, давай быстрее... На таких, как ты, у меня терпения мало, да и к тому же у меня еще куча работы благодаря тебе».~
@5347 = ~«Я передумал. Я помогу починить механизм».~
@5348 = ~«Еще раз, где контора клерка?»~
@5349 = ~«Как мне присоединиться к боголюдям?»~
@5350 = ~«Как мне загладить свою вину?»~
@5351 = ~«Забудь. В любом случае, я уже ухожу».~
@5352 = ~«О, так значит, если тебе что-то нужно, ты вдруг изъявляешь желание помочь? Может, все твои испытания как раз и проверяют уровень эгоизма, пень, но это вовсе не означает, что они мне должны нравиться. Вовсе нет. И ты мне не нравишься. У нас уже есть кое-кто другой, кто занимается его починкой. Так что забей». Она отворачивается и уходит.~
@5353 = ~Уйти.~
@5354 = ~«Просто спроси еще кого-нибудь, пень, или сам выясни». Она отворачивается и уходит.~
@5355 = ~Уйти.~
@5356 = ~Минуту она будто бы решается, как бы взвешивая, что лучше: послать тебя куда подальше или завербовать нового члена в ряды своей фракции. Неохотно она произносит: «Иди через дверь самой правой стены Литейной в зал собраний. Найди там Кельдора Дурианского. Он может тебе помочь».~
@5357 = ~«Спасибо. У меня есть другой вопрос».~
@5358 = ~Уйти.~
@5359 = ~«Можешь ли ты загладить свою вину? Ха! Я так не думаю, парень. Шел бы ты в лабиринты». Она отворачивается и уходит.~
@5360 = ~Уйти.~
@5361 = ~«Приветствую, искатель. Чем я могу тебе помочь? Только, пожалуйста, побыстрее... нам еще нужно утвердить график».~
@5362 = ~«Мне нужно кое-что забрать у клерка. Где он?»~
@5363 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5364 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5365 = ~~
@5366 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5367 = ~«Мне нужно попасть в охраняемую комнату в том конце, но я потерял свой символ».~
@5368 = ~«Мне нужно попасть в охраняемую комнату в том конце, но я потерял свой символ».~
@5369 = ~~
@5370 = ~~
@5371 = ~~
@5372 = ~«Мне нужно воспользоваться кузницей».~
@5373 = ~«Мне нужно воспользоваться кузницей».~
@5374 = ~«Где мне найти вещи, с которыми работают в кузнице?»~
@5375 = ~«Думаю, мне ничего не нужно. Прощай».~
@5376 = ~«Видишь вон там комнату со столом? Он сидит за этим столом. Там ты сможешь получить то, что тебе нужно».~
@5377 = ~«Спасибо. У меня есть другие вопросы».~
@5378 = ~Она некоторое время оглядывается по сторонам, чтобы убедиться, что никто за ней не наблюдает, после чего снимает с шеи золотой медальон и украдкой дает его тебе. «Никому не говори о том, где ты достал это», — говорит она сдавленным голосом.~
@5379 = ~«Спасибо. Пока».~
@5380 = ~«Спасибо. У меня есть другие вопросы».~
@5381 = ~«Спасибо. Прощай».~
@5382 = ~«Я бы рада тебе помочь, но разрешить такое может только самое высшее начальство. Тебе следует поговорить с Кельдором».~
@5383 = ~«Отлично. У меня есть другие вопросы».~
@5384 = ~«Спасибо ни за что. Пока».~
@5385 = ~«Конечно. Только убедись, что у тебя имеются все необходимые для этого вещи: защита от пламени, щипцы, молот, и, конечно же, железная руда».~
@5386 = ~«Ладно. У меня есть другие вопросы».~
@5387 = ~«Где мне найти эти вещи?»~
@5388 = ~«Спасибо. Прощай».~
@5389 = ~«Боюсь, что мы должны дать другим шанс воспользоваться кузницей. Ты уже и так долго ее занимаешь, дружище».~
@5390 = ~«Понятно. У меня есть другие вопросы».~
@5391 = ~«Отлично. Прощай».~
@5392 = ~«Я бы рада тебе помочь, но я, кажется, потеряла символ, который разрешал мне входить туда. Прошу прощения, ищущий».~
@5393 = ~«Это ничего. У меня есть другие вопросы».~
@5394 = ~«Ну ладно. Пока».~
@5395 = ~«Еще вопросы? И какие же?»~
@5396 = ~«Мне нужно кое-что забрать у клерка. Где он?»~
@5397 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5398 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5399 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5400 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5401 = ~«Мне нужно попасть в охраняемую комнату в том конце, но я потерял свой символ».~
@5402 = ~«Мне нужно попасть в охраняемую комнату в том конце, но я потерял свой символ».~
@5403 = ~«Мне нужно попасть в охраняемую комнату в том конце».~
@5404 = ~«Мне нужно попасть в охраняемую комнату в том конце, но я потерял свой символ».~
@5405 = ~«Мне нужно попасть в охраняемую комнату в том конце, но я потерял свой символ».~
@5406 = ~«Мне нужно воспользоваться кузницей».~
@5407 = ~«Мне нужно воспользоваться кузницей».~
@5408 = ~«По поручению Кельдора я расследую случившееся здесь убийство. Что ты можешь о нем рассказать?»~
@5409 = ~«Я ищу выход отсюда».~
@5410 = ~«Я ищу контору по приему заказов. Там меня ждет одна вещь».~
@5411 = ~«Я хотел бы здесь осмотреться».~
@5412 = ~«Кто ты?»~
@5413 = ~«Что здесь происходит?»~
@5414 = ~«Что конкретно отстаивают боголюди?»~
@5415 = ~«Где мне найти вещи, с которыми работают в кузнице?»~
@5416 = ~«Думаю, мне ничего не нужно. Прощай».~
@5417 = ~«Тогда хорошо, что у меня еще свой сохранился. Держи, но никому не рассказывай, что это я тебе его дала, ладно? Удачи».~
@5418 = ~«Спасибо. У меня есть другие вопросы».~
@5419 = ~«Спасибо. Прощай».~
@5420 = ~«У меня его тоже больше нет. Извини. Тебе придется найти другой способ попасть туда».~
@5421 = ~«Спасибо. У меня есть другие вопросы».~
@5422 = ~«Спасибо. Прощай».~
@5423 = ~«Если не найдешь их где-нибудь лежащими без дела, тогда придется купить их у клерка... конечно же, по номинальной цене».~
@5424 = ~«Понятно. У меня есть другие вопросы...»~
@5425 = ~«Спасибо. Прощай».~
@5426 = ~«Ну? Чего ты там ждешь? Иди в кузницу! Мы не можем поддерживать огонь в покинутых горнах, пока ты там прохлаждаешься».~
@5427 = ~«Ну, сперва у меня пару вопросов...»~
@5428 = ~«Еще раз, где мне достать те вещи для кузницы?»~
@5429 = ~«Ну хорошо, хорошо... Я уже иду».~
@5430 = ~«Я уже сказала тебе все, что знаю! Чего еще тебе от меня надо?»~
@5431 = ~«Я хочу, чтобы ты еще раз повторила свой рассказ... медленно».~
@5432 = ~«У меня есть другие вопросы».~
@5433 = ~«Ничего. Пока».~
@5434 = ~«Ты хочешь знать, что я видела в ночь убийства? Значит так... я работала поздно ночью, когда вдруг услышала шум драки. Когда я вышла, то увидела темную фигуру, бегущую через дверь в зал собраний, и подняла тревогу».~
@5435 = ~«Тебе известны еще какие-нибудь детали?»~
@5436 = ~«И все?»~
@5437 = ~«Откуда мне знать, что это не ты сделала?»~
@5438 = ~«Спасибо. У меня есть другие вопросы».~
@5439 = ~«Спасибо. Прощай».~
@5440 = ~«Я знаю лишь трех людей, имеющих доступ к зданию в ту ночь. Это Тильдон, Сарос и Бедай-Линн. У них совершенно разное телосложение, но в дыму литейной я не смогла как следует разглядеть убийцу».~
@5441 = ~«Откуда мне знать, что это не ты сделала?»~
@5442 = ~«Значит, подозреваемых всего трое? Выглядит слишком просто».~
@5443 = ~«Ладно. Где мне найти Тильдона?»~
@5444 = ~«У меня алиби. Не говоря уже о том, что Кельдор уже выяснил у меня правду. Мне нечего скрывать. А вот у Тильдона, Сароса и Бедай-Линн, по всей видимости, есть, хотя бы потому, что они не желают быть проверенными чарами Кельдора».~
@5445 = ~«Отлично. Где мне найти Сароса?»~
@5446 = ~«Как удобно. Где мне найти Бедай-Линн?»~
@5447 = ~«Отлично. У меня есть другие вопросы».~
@5448 = ~«У меня есть другие вопросы».~
@5449 = ~«Хорошо. У меня есть другие вопросы».~
@5450 = ~«Где мне найти Тильдона?»~
@5451 = ~«Где мне найти Сароса?»~
@5452 = ~«Где мне найти Бедай-Линн?»~
@5453 = ~«Спасибо. Этого будет достаточно. Прощай».~
@5454 = ~«Обычно он либо в главном зале литейной, либо в комнате для экспериментов позади. Тебе не составит труда его найти».~
@5455 = ~«Где мне найти Сароса?»~
@5456 = ~«Где мне найти Бедай-Линн?»~
@5457 = ~«Обычно он находится в главном зале собраний. Ты не сможешь его пропустить».~
@5458 = ~«Где мне найти Тильдона?»~
@5459 = ~«Где мне найти Бедай-Линн?»~
@5460 = ~«Ее можно найти в одном из залов Литейной. Она — один из наших главных инженеров, и потому должна проводить регулярный обход. Ты ее узнаешь, когда увидишь».~
@5461 = ~«Где мне найти Тильдона?»~
@5462 = ~«Где мне найти Сароса?»~
@5463 = ~«Спасибо тебе за помощь с механизмом. Мы могли бы починить его и без тебя, но это заняло бы намного больше времени. Мы благодарны тебе. Что еще я могу для тебя сделать?»~
@5464 = ~«У меня есть несколько вопросов».~
@5465 = ~«Ну, вообще-то, больше ничего. Прощай».~
@5466 = ~«Снова ты? Чего тебе на этот раз? Прошу извинить за мою раздражительность, но у нас здесь график».~
@5467 = ~«У меня есть вопросы к тебе».~
@5468 = ~«По поручению Кельдора я расследую случившееся здесь убийство. Что ты можешь о нем рассказать?»~
@5469 = ~«Пока ничего. Я вернусь».~
@5470 = ~Ты видишь невысокую женщину с небольшими рожками на лбу и загнутыми назад ушами. Она слегка отдает серой, даже на фоне зловонного жара Литейной. «Приветствую. Чем я могу тебе помочь?»~
@5471 = ~«По поручению Кельдора я расследую случившееся здесь убийство. Что ты можешь о нем рассказать?»~
@5472 = ~«Я ищу выход отсюда».~
@5473 = ~«Я ищу контору по приему заказов. Там меня ждет одна вещь».~
@5474 = ~«Я хотел бы здесь осмотреться».~
@5475 = ~«Кто ты?»~
@5476 = ~«Что здесь происходит?»~
@5477 = ~«Что конкретно отстаивают боголюди?»~
@5478 = ~«Ничего, спасибо. Прощай».~
@5479 = ~«Обернись сюда. Видишь этот длинный тоннель? Просто пройди через него и окажешься у главных ворот».~
@5480 = ~«Спасибо».~
@5481 = ~«Это вон та контора со столом. Он должен сидеть прямо за ним».~
@5482 = ~«Спасибо. У меня есть другие вопросы».~
@5483 = ~«Спасибо. Прощай».~
@5484 = ~«Обычно я бы и сама была не против. Но, к сожалению, в данный момент мы немного заняты. Возвращайся через год или около того, и я с радостью проведу тебе экскурсию».~
@5485 = ~«А что здесь происходит?»~
@5486 = ~«Хорошо. У меня есть другие вопросы».~
@5487 = ~«Отлично. Прощай».~
@5488 = ~«Я — Алисса Тилд, бригадир этого зала. Это главный литейный зал в Великой Литейной, где ведется большинство наших текущих публичных работ. Литейная, конечно же, больше него, но сейчас мы работаем над крупным заказом, и мы поклялись держать его в секрете, так что большинство рабочих зон закрыты для посторонних. Приношу свои извинения».~
@5489 = ~«Понимаю. У меня есть другие вопросы».~
@5490 = ~«Закрыты для посторонних? Это же смешно! Прощай!»~
@5491 = ~«Понятно. Спасибо, что уделила время».~
@5492 = ~«Мы получили большой и очень, очень секретный заказ, который занимает практически все наши ресурсы. Мы выполняем и меньшие заказы на повседневные предметы, но в данный момент Литейная целиком брошена на выполнение нашего заказа. Не надоедай вопросами о нем, ведь я все равно ничего тебе не расскажу».~
@5493 = ~«Кажется, в этом ты непоколебима. Отлично. У меня другие вопросы».~
@5494 = ~«Кажется, в этом ты непоколебима. Прощай».~
@5495 = ~«Это одновременно и общинная, и индивидуалистическая фракция, и есть много вариаций на тему, в зависимости от кого, кто говорит, но главная ее суть в том, что жизнь — да что там, все существующее — является чем-то типа испытания. Все происходящие вещи испытывают нас, и то, как мы реагируем, определяет, насколько близки мы к пониманию всего сущего. Мы ищем истину мультивселенной, и для нас очевидно, что мы на правильном пути».~
@5496 = ~«Понятно... У меня есть другие вопросы».~
@5497 = ~«Как мне к вам присоединиться?»~
@5498 = ~«Хм. Спасибо, что уделила мне время».~
@5499 = ~«Сходи поговори с Кельдором Дурианским. Он в зале собраний, что за дверью на правой стене».~
@5500 = ~«Спасибо. У меня есть другие вопросы».~
@5501 = ~«Спасибо. Прощай».~
@5502 = ~Уйти.~
@5503 = ~Рабочий разворачивается и убегает от тебя.~
@5504 = ~Готово.~
@5505 = ~Этот человек намеренно игнорирует тебя, пока стража сопровождает тебя к выходу.~
@5506 = ~Готово.~
@5507 = ~«Я слышал, что рядом с телом нашли шило кузнеца. Но, с другой стороны, я считаю, что здесь его можно было бы найти где угодно. Ставлю на то, что виновен Тильдон — в Литейной не было более злобного человека».~
@5508 = ~«Спасибо за помощь. Тем не менее, мне нужны ответы на несколько вопросов».~
@5509 = ~«Отлично. Это все, что я хотел узнать».~
@5510 = ~«Спрашивай».~
@5511 = ~«Кто ты?»~
@5512 = ~«Чем ты занимаешься?»~
@5513 = ~«Кто твой начальник?»~
@5514 = ~«Забудь. Прощай».~
@5515 = ~«А что? Ты от стяжателей? Я уже заплатил налоги».~
@5516 = ~«Стяжатели? Кто они такие?»~
@5517 = ~«Нет, я просто поинтересовался. Ну, ты знаешь. Проявил дружелюбие».~
@5518 = ~«Забудь. Мне все равно нужно узнать кое-что другое».~
@5519 = ~«Забудь».~
@5520 = ~«Отрабатываю свое дневное жалование. Работаю над собой. Поддерживаю в этом месте чистоту. Слежу, чтобы материалы доходили до кузнецов, когда они в них нуждаются. Забочусь, чтобы готовая продукция доходила туда, куда надо... короче, делаю свою работу».~
@5521 = ~«Значит, твоя задача — просто прибираться и выполнять черную работу?»~
@5522 = ~«Ясно. Еще один вопрос к тебе».~
@5523 = ~«Ясно. Пока».~
@5524 = ~«А что? Ты на него работаешь?»~
@5525 = ~«М-м-м... да».~
@5526 = ~«Ты шутишь?»~
@5527 = ~«Ну, ты знаешь... городские сборщики налогов. Ты что, бестолочь? Мне нужно возвращаться к работе».~
@5528 = ~Уйти.~
@5529 = ~«Нет у меня времени быть дружелюбным, особенно когда начальник смотрит тебе через плечо. Последнее время мы сильно заняты. Что, если я просто скажу, что могу побыть дружелюбным, когда этот проект закончится?»~
@5530 = ~«Хорошо. Может, ответишь еще на один вопрос?»~
@5531 = ~«Конечно. Прощай».~
@5532 = ~«Если хочешь так считать. С тех пор, как я изучаю нудное учение боголюдей, я решил, что это — проверка на упорство. Я рассматриваю свою жизнь как проверку на упорство».~
@5533 = ~«Почему бы не посмотреть на это как на проверку на сообразительность и просто уйти?»~
@5534 = ~«И как, выходит?»~
@5535 = ~«Понятно. Прощай».~
@5536 = ~«Тогда он — соль земли. Настоящий джентльмен. Хороших вещей о нем просто не перечесть, вот только мне нужно возвращаться к работе». Рабочий отворачивается и игнорирует последующие просьбы.~
@5537 = ~Уйти.~
@5538 = ~«Один из самых прогнивших ублюдков, которых я имел несчастье повстречать... а вырос я в Улье среди нескольких настоящих чемпионов по этой части. Надеюсь, его скоро прикончат... ужасно и мучительно. Да и потом, большинство из нас, рабочих, думают так же».~
@5539 = ~«Понятно. Ответь еще на несколько вопросов».~
@5540 = ~«Ясно. Пока».~
@5541 = ~«Уйти куда? Кто возьмет меня на работу? Система позаботилась о том, чтобы я не подходил для других видов труда, кроме как для прислуживания, потому что родился я в Улье. Черт, я рад, что хоть здесь работаю. Если только ты не найдешь мне лучшую работу, чем эта, я рад оставаться здесь. Все же лучше, чем помереть с голоду».~
@5542 = ~«О, прошу тебя, ты мог бы заняться чем угодно, если б только решился».~
@5543 = ~«Звучит убедительно. Но тебе не кажется, что ты мог бы добиться лучшего?»~
@5544 = ~«Как ни странно, да. Это дает мне надежду на то, что когда-нибудь я закончу лучше, в этой жизни или в следующей. Я, может, и не вижу очевидного, но скажу тебе вот что: хлебнув помоев, как я, начинаешь ценить те маленькие радости, что жизнь подбрасывает тебе. Для низших классов жизнь — не одни лишь первоцветы, пень, — рабочий отворачивается. — Мне нужно возвращаться к работе».~
@5545 = ~Уйти.~
@5546 = ~«И что, закончить таким ошрамованным зомби, как ты? Нет уж, извольте. Не знаю, что ты там наделал, но спасибо, я рад быть таким, какой я есть. Медленное продвижение по жизни больше соответствует моим убеждениям. А теперь, если ты позволишь, мне надо вернуться к работе». Рабочий отворачивается и игнорирует тебя.~
@5547 = ~Уйти.~
@5548 = ~«Вот что я тебе скажу... ты живешь своей жизнью, а я живу своей. Лады? А теперь мне нужно возвращаться к работе». Рабочий отворачивается и игнорирует тебя.~
@5549 = ~Уйти.~
@5550 = ~«Говорю тебе, со всеми теми волнениями, которые происходят вокруг в последнее время, я с трудом понимаю, что вообще происходит. Как будто я никогда не покидал Улей... чем я могу тебе помочь?»~
@5551 = ~«Ты мог бы ответить мне на несколько вопросов».~
@5552 = ~«Не можешь. Забудь».~
@5553 = ~Ты видишь серого жителя Улья, который таскает ящики. Ты даже не можешь определить пол бедняги. «Чего ты хочешь от меня?»~
@5554 = ~«Только пару ответов».~
@5555 = ~«Ничего. Прощай».~
@5556 = ~«Чего тебе надо?»~
@5557 = ~«Просто несколько ответов».~
@5558 = ~«Ничего».~
@5559 = ~«СТРАЖА! СТРАЖА! Здесь нарушитель!»~
@5560 = ~Готово.~
@5561 = ~«Извини. Не могу с тобой сейчас говорить. Пожалуй, поговорим, когда вернешься».~
@5562 = ~Уйти.~
@5563 = ~«Даже не знаю, как тебя отблагодарить за то, что свернул шею тому безумному инженеру. Кто бы мог подумать, что она — анархистка? Мы же все могли погибнуть! Чем я могу тебе помочь?»~
@5564 = ~«Можешь рассказать, для кого разрабатывается этот проект?»~
@5565 = ~«Ты упоминал что-то о критической стадии?»~
@5566 = ~«Что это за проект?»~
@5567 = ~«Как эта штуковина работает?»~
@5568 = ~«К чему эта секретность?»~
@5569 = ~«Сколько еще осталось до завершения?»~
@5570 = ~«Интересно, можешь ли ты рассказать мне что-нибудь об убийстве в главном зале литейной?»~
@5571 = ~«Что ты можешь рассказать о своем начальнике?»~
@5572 = ~«Что ты можешь рассказать о своем начальнике?»~
@5573 = ~«Расскажи мне об инженерах в этом проекте».~
@5574 = ~«Не подскажешь, где мне найти контору клерка?»~
@5575 = ~«Нет, об этом ничего сказать не могу. Во-первых, я ничего не знаю. Во-вторых, я подписал договор о неразглашении, который связывает мою жизнь с целостностью этого проекта. Если проект провалится, я могу умереть, как и все мои друзья здесь. Я не могу пойти на такой риск».~
@5576 = ~«Расскажи мне о боголюдях».~
@5577 = ~«Расскажи мне об инженерах в этом проекте».~
@5578 = ~«Расскажи мне об инженерах в этом проекте».~
@5579 = ~«Расскажи мне об инженерах в этом проекте».~
@5580 = ~«Пока ничего, спасибо».~
@5581 = ~«Вполне справедливо. Тогда расскажи мне еще о чем-нибудь».~
@5582 = ~«Отлично. Прощай».~
@5583 = ~«Ужасная вещь. Я слышал, что пострадавший тем еще пнем, но это не значит, что его нужно было вот так просто сталкивать в механизм. Поскольку Литейная закрыта большую часть года, пока мы работаем над этим проектом, скорее всего, это сделал кто-то из своих. Я всего лишь могу поручиться, что все наши рабочие были на своих местах — никто из нас не мог отлучиться незамеченным на время, достаточное, чтобы это сделать».~
@5584 = ~«Ясно. В таком случае, можешь ответить на другие мои вопросы?»~
@5585 = ~«Этого достаточно. Прощай».~
@5586 = ~«Обычно ты можешь найти ее где-то здесь. Она — гитцерайка, изгнанная своим народом. Она работает здесь, потому что так ее почти не видят, и таким образом ее позор облегчается. Она талантлива и умна».~
@5587 = ~«Интересно, будет ли она говорить с моим другом Дакконом».~
@5588 = ~«Тогда, наверно, поговорю с ней позже. У меня к тебе еще несколько вопросов».~
@5589 = ~«Спасибо за уделенное время. До свиданья».~
@5590 = ~«Наш главный инженер, Нил Зандер, — настоящий гений. Он создал такие вещи, что я даже и не мечтал, что такое возможно. Говорят, что он создал даже складной портал, а в свободное время работает над Построителем снов. Ходят слухи, что давным-давно его семья подписала контракт на создание этой машины для человека, который не мог видеть снов.
Другой наш инженер, Бедай-Линн, работает не так давно, но она столь же одаренная. Она слегка эксцентрична, но работа ее выглядит мастерски и многообещающе.
Обычно ты можешь найти их в главном зале собраний».~
@5591 = ~«Прекрасно. Между тем, у меня есть еще несколько вопросов».~
@5592 = ~«Значит, машина снов? Пожалуй, поищу его».~
@5593 = ~«Ты можешь найти контору клерка справа от главной литейной».~
@5594 = ~«Спасибо. Ответь еще на пару вопросов».~
@5595 = ~«Спасибо».~
@5596 = ~«Что я думаю о боголюдях? Одна из лучших вещей в этой фракции — это то, что мы искренне заботимся о людях — не просто о членах фракции, а обо всех. Когда-нибудь каждый из нас сможет стать богом или более чем богом, и потому мы помогаем всем. Иначе мы бы были эгоистами или, чего хуже, — дураками. А ведь мы не дураки».~
@5597 = ~«Время покажет. Ответь еще на один вопрос».~
@5598 = ~«Хорошо. Прощай».~
@5599 = ~«Как ты уже знаешь, Бедай-Линн была задержана за убийство. Она была умелой, но ненадежной. Откуда же нам было знать, что она убийца?

Наш главный инженер — Нил Зандер, талантливый старик. Говорят, будто он создал складной портал, а в свободное время работает над Построителем снов. Ходят слухи, что давным-давно его семья подписала контракт на создание этой машины для человека, который не мог видеть снов. Обычно ты можешь найти его в главном зале собраний».~
@5600 = ~«Отлично. У меня еще один вопрос».~
@5601 = ~«Построитель снов? Пойду поищу его».~
@5602 = ~«Хвала силам, ты остановил эту суку Бедай-Линн до того, как она смогла нам навредить. Это могло бы стоить нам жизни.

Что касается другого нашего инженера, Нила Зандера, то его обычно можно найти в главном зале собраний. За свою жизнь он разработал уйму хитроумных устройств, и, вполне вероятно, создаст еще».~
@5603 = ~«Спасибо. Расскажи еще о чем-нибудь».~
@5604 = ~«Говоришь, еще создаст? Тогда прощай».~
@5605 = ~«Кто же знал, что Бедай-Линн попытается низвергнуть саму организацию боголюдей? Мы знали, что она способный магический инженер, но и не подозревали, что она — анархистка.

Что касается другого нашего инженера, Нила Зандера, то его обычно можно найти в главном зале для собраний. За свою жизнь он разработал уйму хитроумных устройств, и, вполне вероятно, создаст еще».~
@5606 = ~«Действительно, кто бы мог подумать? У меня еще несколько вопросов».~
@5607 = ~«Тогда, наверно, я пойду и поищу его. Счастливо».~
@5608 = ~Он пристально разглядывает тебя, а затем, видимо, решается поверить тебе. «Э... сейчас где только не найдешь этих слабых мест. Обшивка все еще непрочная: мы ее еще не укрепляли. В огневых гнездах установлены орудия, но в данный момент они опасно нестабильны. И паровой котел внутри может взорваться от всей нагрузки, которую мы к нему прикладываем. Все так и ждет, чтобы рассыпаться. По-моему, самое уязвимое место — огневой механизм там, на конце. И если он сломается, вместе с ним погибнут все наши рабочие».~
@5609 = ~«Спасибо. У меня есть другие вопросы».~
@5610 = ~«Спасибо. Прощай».~
@5611 = ~«Ты хочешь узнать о Келлере? Какой-то чертов придурок убил ее, и это все, что я могу о ней сказать. Разговор окончен. Убирайся. Стража! Уберите отсюда этого пня!»~
@5612 = ~Уйти.~
@5613 = ~«Да? Что же ты хочешь узнать?»~
@5614 = ~«Какие у этой штуки слабые места?»~
@5615 = ~«Ты упоминал что-то о критической стадии?»~
@5616 = ~«Что это за проект?»~
@5617 = ~«Как эта штуковина работает?»~
@5618 = ~«К чему эта секретность?»~
@5619 = ~«Сколько еще осталось до завершения?»~
@5620 = ~«Можешь рассказать, для кого разрабатывается этот проект?»~
@5621 = ~«Интересно, можешь ли ты рассказать мне что-нибудь об убийстве в главном зале литейной?»~
@5622 = ~«Что ты можешь рассказать о своем начальнике?»~
@5623 = ~«Что ты можешь рассказать о своем начальнике?»~
@5624 = ~«Расскажи мне об инженерах в этом проекте».~
@5625 = ~Он с подозрением смотрит на тебя. «Зачем тебе это знать?»~
@5626 = ~«Не подскажешь, где мне найти контору клерка?»~
@5627 = ~«Расскажи мне о боголюдях».~
@5628 = ~«Расскажи мне об инженерах в этом проекте».~
@5629 = ~«Расскажи мне об инженерах в этом проекте».~
@5630 = ~«Расскажи мне об инженерах в этом проекте».~
@5631 = ~«Пока ничего, спасибо».~
@5632 = ~«Потому что я сам немного понимаю в магической инженерии, и подумал, что мог бы помочь оптимизировать работу. Если бы ты указал мне на слабые места, я мог бы подкинуть тебе парочку идей».~
@5633 = ~«Потому что я сам немного понимаю в магической инженерии, и подумал, что мог бы помочь оптимизировать работу. Если бы ты указал мне на слабые места, я мог бы подкинуть тебе парочку идей».~
@5634 = ~«Потому что вся эта штуковина кажется весьма хрупкой».~
@5635 = ~«Потому что мне дали полномочия осмотреть этот проект, и я желаю знать его слабые места».~
@5636 = ~«Потому что мне дали полномочия осмотреть этот проект, и я желаю знать его слабые места».~
@5637 = ~«Мне просто было интересно, вот и все».~
@5638 = ~«Забудь об этом. У меня есть другие вопросы...»~
@5639 = ~«Забудь, что я спрашивал. Прощай».~
@5640 = ~Он смотрит на тебя с еще большим подозрением. «Я не стану отвечать. Если тебе нужно знать нечто подобное, говори с Келлерой, а не со мной».~
@5641 = ~«Где Келлера?»~
@5642 = ~«Где Келлера?»~
@5643 = ~«Нет, забудь, что я спрашивал. До свиданья».~
@5644 = ~«Я думаю, это оружие. Мы не уверены, для войны оно или для охоты — силы небесные, если оно для охоты, я не хотел бы увидеть тварь, для которой оно предназначено, — но когда мы закончим, оно сможет потягаться с Кораблем Хаоса, который Хранители Рока построили вместе с танарри пару лет назад. Во всяком случае, в теории».~
@5645 = ~«Что оно работает?»~
@5646 = ~«Зачем вся эта секретность?»~
@5647 = ~«Сколько еще осталось до завершения?»~
@5648 = ~«У меня есть другие вопросы».~
@5649 = ~«Прощай».~
@5650 = ~«Знаешь, я не вполне уверен. Чтобы получить эту информацию, тебе следует поговорить с одним из инженеров. Я знаю, что у него есть массивный, сфокусированный тепловой луч — по крайней мере эту его часть мы завершили. Мы даже окончательно установили его на устройстве. Над многими вещами в этой штуковине мы еще даже не начинали работать. Нам не разрешается их видеть, пока мы не закончим каждую часть».~
@5651 = ~«Еще раз, что это?»~
@5652 = ~«Зачем вся эта секретность?»~
@5653 = ~«Сколько еще осталось до завершения?»~
@5654 = ~«Ответь еще на несколько вопросов, если ты не против».~
@5655 = ~«Спасибо. Пока».~
@5656 = ~«Если бы ты знал, что враг создает оружие против тебя, разве ты бы не приложил все усилия, чтобы это оружие уничтожить? Мы даже не имеем понятия, для кого оно предназначено. Мы просто верим слову начальства, что оно не будет использовано в противоречии нашим взглядам. Никто из нас не знает, кто его заказал, так что мы ни за что не сможем раскрыть темноту кому-нибудь, кто захочет его уничтожить... тем более, что наши жизни скреплены с ним».~
@5657 = ~«Что ты имеешь в виду?»~
@5658 = ~«Еще раз, что это?»~
@5659 = ~«И как оно работает?»~
@5660 = ~«Сколько еще осталось до завершения?»~
@5661 = ~«Ответь еще на несколько вопросов, если ты не против».~
@5662 = ~«Спасибо. Пока».~
@5663 = ~«Пожалуй, его еще делать не один десяток лет. Но самая сложная часть будет закончена в этом году. Необходимо совершить некоторые магические ритуалы, а на это уйдет некоторое время. Мы все с облегчением вздохнем, когда будем знать, что наши жизни не скреплены проектом, которой готов рвануть из-за нестабильности».~
@5664 = ~«Скреплены? Что ты имеешь в виду?»~
@5665 = ~«Еще раз, что это?»~
@5666 = ~«И как оно работает?»~
@5667 = ~«Зачем вся эта секретность?»~
@5668 = ~«У меня к тебе другие вопросы».~
@5669 = ~«Спасибо. Прощай».~
@5670 = ~«В силу характера этого проекта — секретность и все такое, не говоря уже о магии, которая позволяет нам работать с машиной, — нам пришлось скрепить часть своих жизней в машине. Мы получим их обратно, когда проект будет завершен, но если он даст сбой, или, огради нас силы, будет саботирован, при взрыве он заберет все наши жизни».~
@5671 = ~«Плохи дела. И все же, у меня к тебе другие вопросы».~
@5672 = ~«Плохи дела. Удачи вам с этим. Счастливо».~
@5673 = ~Ты видишь тифлинга, одетого как боголюди, который тщательно осматривает какую-то штуку в центре зала. «В данный момент я не могу с тобой говорить. Мы на критической стадии».~
@5674 = ~«На критической стадии? Чего?»~
@5675 = ~«Я надеялся, что ты ответишь мне на несколько вопросов».~
@5676 = ~«Тогда извини, что отвлек. Прощай».~
@5677 = ~«Снова ты? Что тебе нужно на этот раз?»~
@5678 = ~«Ты упоминал что-то о критической стадии?»~
@5679 = ~«У меня есть вопросы к тебе...»~
@5680 = ~«В таком случае, я покидаю тебя. Прощай».~
@5681 = ~«Да. Этот проект, над которым мы работаем, — оружие, которое, кроме всего прочего, может иметь массовое применение в мирное время. Нам еще далеко до завершения, но мы на деликатной стадии — достаточно деликатной, чтобы вписать всех нас в книгу мертвых, если какой-нибудь пень все испортит».~
@5682 = ~«Чем вы занимаетесь?»~
@5683 = ~«О... У меня еще один вопрос».~
@5684 = ~«Понятно. Удачи».~
@5685 = ~«Мы настраиваем переменные в нижних магических диапазонах устройства. Одна единственная ошибка может погубить весь проект, и если это случится, нас всех накроет образовавшейся в результате магической волной».~
@5686 = ~«Понятно. Ответишь на другие вопросы?»~
@5687 = ~«Понятно. Прощай».~
@5688 = ~«Почту за честь встретить еще одного изгоя. Быть может, разделив наш позор, мы уменьшим ту боль, что он нам причиняет».~
@5689 = ~«Рад за тебя. Но я тебя не спрашивал. У меня еще несколько вопросов к этому бедолаге».~
@5690 = ~«Мы скоро поговорим с ней, друг мой. Тем временем, у меня есть другие вопросы к нашему другу».~
@5691 = ~«Товарищи! Ко мне! Здесь нарушитель! Прямо тут!»~
@5692 = ~Сражаться.~
@5693 = ~«Сэр, вас попросили уйти. Прошу так и поступить. Сейчас же».~
@5694 = ~Готово.~
@5695 = ~«Пожалуйста, освободите двор, сэр. Либо входите, либо выходите».~
@5696 = ~~
