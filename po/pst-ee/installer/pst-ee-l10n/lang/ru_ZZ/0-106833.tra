@24694 = ~«Я еще вернусь... когда найду переводчика получше. Прощай».~
@24695 = ~«Что не так?»~
@24696 = ~«Что за 'дабус'?»~
@24697 = ~«'Леди Боли'? Кто это?»~
@24698 = ~«Что ты можешь рассказать о Леди Боли?»~
@24699 = ~«Понятно».~
@24700 = ~«Э-э... постой-ка. Ты сказал, что дабусы парят, верно? А этот ходит по земле».~
@24701 = ~«Э-э... постой-ка. Ты сказал, что дабусы парят, верно? А этот ходит по земле».~
@24702 = ~«Понятно».~
