@68492 = ~ПРОЩАЙ, МОРТ.~
@68493 = ~НЕ НУЖНО СЛОВ, ЧТОБЫ ПОНЯТЬ, ЧТО У ТЕБЯ НА СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68494 = ~НЕ НУЖНО СЛОВ, ЧТОБЫ ПОНЯТЬ, ЧТО У ТЕБЯ НА СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68495 = ~НЕ НУЖНО СЛОВ, ЧТОБЫ ПОНЯТЬ, ЧТО У ТЕБЯ НА СЕРДЦЕ, АННА. ПРОЩАЙ.~
@68496 = ~ХОРОШО, ДАККОН. ОБЕ НАШИ СМЕРТИ БЫЛИ ОДНОЙ ЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68497 = ~ХОРОШО, ДАККОН. ОБЕ НАШИ СМЕРТИ БЫЛИ ОДНОЙ ЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68498 = ~ХОРОШО, ДАККОН. ОБЕ НАШИ СМЕРТИ БЫЛИ ОДНОЙ ЕДИНОЙ. ТЫ ПОКИНЕШЬ ЭТО МЕСТО СВОБОДНЫМ.~
@68499 = ~НАВЕРНО, ТАК И ЕСТЬ. ПРОЩАЙ, ГРАЦИЯ.~
@68500 = ~НАВЕРНО, ТАК И ЕСТЬ. ПРОЩАЙ, ГРАЦИЯ.~
@68501 = ~НАВЕРНО, ТАК И ЕСТЬ. ПРОЩАЙ, ГРАЦИЯ.~
