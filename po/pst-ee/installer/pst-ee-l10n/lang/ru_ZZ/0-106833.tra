@39662 = ~«Мне пора идти. Прощай, Ив».~
@39663 = ~«Просто расскажи свою историю, Анна».~
@39664 = ~«Пожалуйста, поделись своей историей, Анна...»~
@39665 = ~«Просто расскажи свою историю, Анна».~
@39666 = ~«Пожалуйста, поделись своей историей, Анна...»~
@39667 = ~«Я хочу поделиться с тобой еще одной историей, Ив».~
@39668 = ~«У меня вопрос к тебе, Ив...»~
@39669 = ~«Быть может, в другой раз, Ив. Прощай».~
@39670 = ~«Продолжай...»~
@39671 = ~«Погоди... У меня есть вопрос...»~
@39672 = ~«Я выслушаю оставшуюся часть истории в другой раз, Ив. Прощай».~
@39673 = ~«Я могу поделиться с тобой еще одной историей».~
@39674 = ~«У меня вопрос к тебе, Ив...»~
@39675 = ~«Мне пора идти. Прощай, Ив».~
@39676 = ~«Тленные Главы».~
@39677 = ~«Часы и квадрон».~
@39678 = ~«Вопрошающая у ворот».~
@39679 = ~«Рассказ о пасечнике».~
@39680 = ~«Позолоченный сказ».~
@39681 = ~«Поклонник Леди».~
@39682 = ~«Рассказ о человеке, который не хотел делиться своим опытом».~
@39683 = ~«Казнь».~
@39684 = ~«Выжженная земля».~
@39685 = ~«Твою версию Тонущей Ачали».~
@39686 = ~«Цветы и чувствующие».~
@39687 = ~«Сказка об отце, дочери и ее возлюбленном».~
@39688 = ~«Вообще-то, у меня есть вопрос...»~
@39689 = ~«Не бери в голову, Ив. Счастливо».~
@39690 = ~«Да, есть».~
@39691 = ~«Нет, но у меня есть несколько вопросов...»~
@39692 = ~«Вообще-то, я просто проходил мимо. Прощай, Ив».~
@39693 = ~«У меня еще вопрос...»~
@39694 = ~«Тогда прощай, Ив».~
@39695 = ~«Не за что. У меня есть другой вопрос...»~
@39696 = ~«Конечно. Прощай, Ив».~
@39697 = ~«У меня еще вопрос...»~
@39698 = ~«Это все, что я хотел узнать, Ив. Прощай».~
@39699 = ~«Да, пожалуйста».~
@39700 = ~«Не сейчас. У меня есть другие вопросы...»~
@39701 = ~«Я просто проходил мимо, Ив; я послушаю позже. Прощай».~
@39702 = ~«Продолжай...»~
@39703 = ~«Погоди... У меня есть вопрос...»~
@39704 = ~«Я выслушаю оставшуюся часть истории в другой раз, Ив. Прощай».~
@39705 = ~«Продолжай...»~
@39706 = ~«Погоди... У меня есть вопрос...»~
@39707 = ~«Я выслушаю оставшуюся часть истории в другой раз, Ив. Прощай».~
@39708 = ~«Продолжай...»~
@39709 = ~«Погоди... У меня есть вопрос...»~
@39710 = ~«Я выслушаю оставшуюся часть истории в другой раз, Ив. Прощай».~
@39711 = ~«Спасибо. У меня к тебе вопрос, Ив...»~
@39712 = ~«Спасибо, Ив. Мне нужно идти, прощай».~
@39713 = ~«Тогда забудь».~
@39714 = ~«Морт, просто расскажи историю».~
@39715 = ~«Нет уж, Морт. Я не желаю слышать ее».~
@39716 = ~«Ладно... тогда давай».~
@39717 = ~«Не может быть, чтобы все было настолько хорошо».~
@39718 = ~«Что такое денуэман?»~
@39719 = ~«Ладно... валяй».~
@39720 = ~«Постой... что такое денуэман?»~
@39721 = ~«Ладно, валяй».~
@39722 = ~«Ладно, валяй».~
@39723 = ~~
@39724 = ~«Продолжай, Морт».~
@39725 = ~«Погоди... У меня есть вопросы к Ив...»~
@39726 = ~«Морт, мы послушаем ее в другой раз. Счастливо, Ив».~
@39727 = ~«Продолжай, Морт».~
@39728 = ~«Погоди... У меня есть вопросы к Ив...»~
@39729 = ~«Морт, мы послушаем ее в другой раз. Счастливо, Ив».~
@39730 = ~Это невидимое дробящее оружие для крепких созданий 7-9 уровня.~
@39731 = ~УКУС МОРТА
(оружие по умолчанию)
Урон: 1-3 колющий
Скорость: 1
Вес: 0
Специализация: «кулаки» (без комментариев)

Укус Морта смертелен, и он СПОСОБЕН зажевать кого-нибудь насмерть. Если его быстрые слоты оружия не полностью заняты, Морт всегда может выбрать укус в качестве своего текущего оружия.

^NПРИМЕЧАНИЕ: Укус Морта является его атакой по умолчанию. Хотя урон, наносимый укусом, сравнительно мал, он позволяет Морту атаковать быстро, что может вывести из себя любого мага, пытающегося прочесть заклинание.^-~
@39732 = ~Судя по вытатуированным указаниям, которые прочел Морт на моей спине, мне нужно найти некоего «Фарода». Не знаю даже, где надо его искать... надеюсь, расспросив местных, я смогу выследить его.~
@39733 = ~Я нашел Фарода... встреча оказалась чем-то вроде эмоциональной разрядки. Он оказался дряхлым вором трупов, и похоже, что он заинтересован скорее в том, чтобы выдавить из меня как можно больше, чем в том, чтобы снабдить меня полезными сведениями.~
@39734 = ~Найти свой пропавший дневник.~
@39735 = ~Судя по вытатуированным указаниям, которые прочел Морт на моей спине, когда я пробудился в Морге, при мне должен был быть мой дневник. Лучше мне его найти — надеюсь, что он поможет мне понять, что здесь происходит.~
@39736 = ~Я нашел ОДИН из своих дневников... наверно, поблизости валяются еще *несколько*. Нужно позаботиться о том, чтобы не пропустить их.~
@39737 = ~Гнилой Уильям мертв. Теперь мне нужно убить Черного Бутона по просьбе Кристалл.~
@39738 = ~Черный Бутон мертв.~
@39739 = ~Гнилой Уильям желает, чтобы Кристалл была мертва в обмен на бесплатный проход через переулок Опасных углов.~
@39740 = ~Кристалл мертва. Теперь мне нужно убить Черного Бутона по просьбе Гнилого Уильяма.~
@39741 = ~Черный Бутон мертв, а Гнилой Уильям попытался предать меня.~
@39742 = ~Черный Бутон желает, чтобы Кристалл была мертва.~
@39743 = ~Кристалл мертва.~
@39744 = ~Черный Бутон желает, чтобы Гнилой Уильям был мертв.~
@39745 = ~Гнилой Уильям мертв.~
@39746 = ~Кристалл желает, чтобы Гнилой Уильям был мертв.~
@39747 = ~Кристалл желает, чтобы Гнилой Уильям был мертв в обмен на бесплатный проход через переулок Опасных углов.~
@39748 = ~Кристалл желает, чтобы Черный Бутон был мертв.~
@39749 = ~Гнилой Уильям желает, чтобы Кристалл была мертва.~
@39750 = ~Гнилой Уильям желает, чтобы Черный Бутон был мертв.~
@39751 = ~Черный Бутон желает, чтобы Кристалл была мертва.~
@39752 = ~«Продолжай, Морт».~
@39753 = ~«Погоди... У меня есть вопросы к Ив...»~
@39754 = ~«Морт, мы послушаем ее в другой раз. Счастливо, Ив».~
@39755 = ~Спросить другого спутника.~
@39756 = ~«У меня есть история, которой я хочу поделиться с тобой, Ив».~
@39757 = ~«Тогда у меня есть вопрос к Ив...»~
@39758 = ~«В таком случае, мы пойдем. Счастливо, Ив».~
@39759 = ~«Это... интересная история, Нордом».~
@39760 = ~«Приукрашено?»~
@39761 = ~«Продолжай, Ив...»~
@39762 = ~«Постой, Ив... У меня вопрос...»~
@39763 = ~«Ив, я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@39764 = ~«Давай, Анна...»~
@39765 = ~«Погоди... У меня есть для тебя история, Ив».~
@39766 = ~«Забудь об этом, Анна. У меня есть вопрос к Ив...»~
@39767 = ~«Не бери в голову, Анна. Прощай, Ив».~
@39768 = ~«Продолжай, Анна...»~
@39769 = ~«Погоди... У меня есть вопрос к Ив...»~
@39770 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39771 = ~«Продолжай, Анна...»~
@39772 = ~«Погоди... У меня есть вопрос к Ив...»~
@39773 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39774 = ~«Продолжай, Анна...»~
@39775 = ~«Погоди... У меня есть вопрос к Ив...»~
@39776 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39777 = ~«Продолжай, Анна...»~
@39778 = ~«Погоди... У меня есть вопрос к Ив...»~
@39779 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39780 = ~«Продолжай, Анна...»~
@39781 = ~«Погоди... У меня есть вопрос к Ив...»~
@39782 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39783 = ~«Продолжай, Анна...»~
@39784 = ~«Погоди... У меня есть вопрос к Ив...»~
@39785 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39786 = ~«Продолжай, Анна...»~
@39787 = ~«Погоди... У меня есть вопрос к Ив...»~
@39788 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39789 = ~«Продолжай, Анна...»~
@39790 = ~«Погоди... У меня есть вопрос к Ив...»~
@39791 = ~«Анна, мы ее послушаем в другой раз. Прощай, Ив».~
@39792 = ~«Эй, шеф. Ты в порядке? Изображаешь из себя труп или пытаешься обмануть трухлявых? Я уж думал, что ты дал дуба».~ [MRT001]
@39793 = ~«Чт?.. Ты кто?»~
@39794 = ~~
@39795 = ~«Э... кто я? А как насчет *тебя* для начала? Кто ты?»~
@39796 = ~«Я... не знаю. Не могу вспомнить».~
@39797 = ~«Я *первый* спросил тебя, череп».~
@39798 = ~«Ты не можешь вспомнить свое *имя*? Хе. Что ж, в СЛЕДУЮЩИЙ раз, когда будешь кутить ночью в городе, не налегай на выпивку. Зовут Мортом. Я тоже здесь заперт».~
@39799 = ~«Заперт?»~
@39800 = ~«Ага, а я спросил тебя *вторым*. Как твое имя?»~
@39801 = ~«Я... не знаю. Не могу вспомнить».~
@39802 = ~«Ты первый, череп. В последний раз спрашиваю».~
@39803 = ~«Пф-ф... да ты натянут как струна. Ну хорошо, пусть *я* буду хорошим парнем. Зовут Мортом. А кто ты?»~
@39804 = ~«Я... не знаю. Не могу вспомнить».~
@39805 = ~«Ага, и поскольку ты еще не успел размять ноги, вот тебе новость: я перепробовал все двери, и эта комната заперта крепче пояса целомудрия».~
@39806 = ~«Мы заперты... где? Что это за место?»~
@39807 = ~«Оно называется 'Моргом'... это такое большое черное здание с чарующей архитектурой беременной паучихи».~
@39808 = ~«Морг? Постой... я умер?»~
@39809 = ~«Не похоже. Хотя на тебе куча шрамов... выглядит так, словно какой-то пень изрисовал тебя всего ножом. Еще одна причина свалить отсюда побыстрее, пока тот, кто изрезал тебя, не вернулся назад и не завершил свою работу».~
@39810 = ~«Шрамы? Они так плохи?»~
@39811 = ~«Ну... художество на груди не ТАК уж плохо выглядит... но то, что на спине... — Морт делает паузу. — Скажем так, шеф, у тебя целая галерея татуировок на спине. Тут что-то написано...»~
@39812 = ~«Татуировки на моей спине? Что там написано?»~
@39813 = ~«Ха! Похоже, тебя доставили с инструкцией... — Морт прочищает горло. — Посмотрим... начинается с...»

«Я знаю, что ты чувствуешь себя так, как будто ты выпил несколько бочонков помоев из Стикса, но тебе надо СОСРЕДОТОЧИТЬСЯ. Среди твоих вещей должен быть ДНЕВНИК, который прольет свет на это темное дело. ФАРОД сможет дополнить оставшуюся часть истории, если его еще не записали в книгу мертвых».~
@39814 = ~«Фарод?.. А там есть еще что-нибудь?»~
@39815 = ~«Ага, здесь есть еще немного... — Морт умолкает. — Посмотрим... вот продолжение...»

'Не потеряй дневник, иначе мы вновь окажемся в Стиксе. И что бы ты ни делал, НЕ ГОВОРИ никому, КТО ты и ЧТО с тобой произошло, иначе тебя живо отправят в крематорий. Делай так, как я сказал: ПРОЧТИ дневник, а затем НАЙДИ Фарода'.~
@39816 = ~«Неудивительно, что спина так болит: да там целая чертова поэма. А дневник, который должен быть со мной... он был возле меня, пока я здесь валялся?»~
@39817 = ~«Нет... тебя обобрали догола, когда доставили сюда. Хотя, с другой стороны, похоже, что достаточно того дневника, что выбит у тебя на теле».~
@39818 = ~«А как насчет Фарода? Ты его знаешь?»~
@39819 = ~«Нет, не знаю... С другой стороны, я вообще мало кого знаю. В общем, КТО-НИБУДЬ да знает, как добраться до этого Фарода... э, то есть, как только мы выберемся отсюда».~
@39820 = ~«И *как* же мы выберемся отсюда?»~
@39821 = ~«Ну, если все двери заперты, значит, нам понадобится ключ. Есть шанс, что он есть у одного из ходячих трупов в этой комнате».~
@39822 = ~«Ходячих трупов?»~
@39823 = ~«Ага, хранители Морга используют мертвые тела в качестве дешевой рабочей силы. Трупы тупые как пробка, они безвредны и не будут атаковать до тех пор, пока ты не нападешь первым».~
@39824 = ~«А есть какой-нибудь другой способ? Я не хочу никого убивать из-за какого-то ключа».~
@39825 = ~«Так значит, я должен напасть на одного из этих трупов и забрать у него ключ?»~
@39826 = ~«Погоди, ты что, думаешь, что причинишь им боль? Они уже МЕРТВЫ. Но если тебе нужна мотивация, то пожалуйста: если ты убьешь их, то по крайней мере они отдохнут до того, как хранители поднимут их снова на работу».~
@39827 = ~«Ну хорошо... Я собью одного из них и заберу ключ».~
@39828 = ~«Хорошо, но перед этим неплохо бы вооружиться. Кажется, здесь где-то на полках есть скальпель».

^NПРИМЕЧАНИЕ: Обыщите полки в комнате, чтобы найти оружие, с которым можно напасть на зомби. <SEARCH_WEAPON>^-~
@39829 = ~«Ладно, я поищу его».~
@39830 = ~«И последнее: эти трупы медлительны, но их удар — все равно что поцелуй тарана. Если они начнут доставать тебя, помни, что ты можешь БЕГАТЬ, а они — нет. Используй это, чтобы держаться на дистанции, если тебе нужно восстановиться».

^NПРИМЕЧАНИЕ: Если вы в опасности или при смерти, используйте бег, чтобы держать дистанцию с зомби, пока восстанавливаетесь.^-~
@39831 = ~«Хорошо. Спасибо за совет».~
@39832 = ~«На одной из тех полок должен быть скальпель. Я бы на твоем месте нашел его до того, как начал бодаться с местными трупаками».

^NПРИМЕЧАНИЕ: Обыщите полки в комнате, чтобы найти оружие, с которым можно напасть на зомби. <SEARCH_WEAPON>^-~
@39833 = ~«Ладно... Я поищу».~
@39834 = ~«Отлично, ты нашел скальпель! А теперь пора разделаться с этими трупами... и не бойся, я буду держаться у тебя за спиной и давать ценные тактические советы».~
@39835 = ~«А, может, ты мне *поможешь*, Морт?»~
@39836 = ~«Хорошо». ~
@39837 = ~«Я ПОМОГУ тебе. Хороший совет всегда хорош в трудную минуту».~
@39838 = ~«Я имел ввиду помощь в нападении на *трупов*».~
@39839 = ~«Ну хорошо тогда».~
@39840 = ~«Я? Я романтик, а не солдат. Я только под ногами буду путаться».~
@39841 = ~«Когда я буду нападать на труп, тебе лучше быть рядом со мной, иначе ты будешь следующим, в кого я воткну этот скальпель».~
@39842 = ~«Ну хорошо тогда».~
@39843 = ~«Э... без проблем. Я помогу тебе».

^NПРИМЕЧАНИЕ: Если вы хотите, чтобы Морт помог вам атаковать, просто удостоверьтесь, что до нападения на труп выбраны оба персонажа. Морт присоединится к атаке.^-~
@39844 = ~«Я рад, что мы поняли друг друга».~
@39845 = ~«Тогда настало время познакомить этих трупов с их второй смертью...»

^NПРИМЕЧАНИЕ: <ATTACKNOTE>^-~
@39846 = ~«Вперед».~
@39847 = ~«Отлично, похоже, ты позаботился о правильном трупе. Теперь надо найти ключ. Он должен быть на его теле. Как только мы его получим, мы сможем выбраться отсюда».

^NПРИМЕЧАНИЕ: <DEADPILE>^-~
@39848 = ~«Хорошо». ~
@39849 = ~«Отлично, вот и ключ. Он должен подойти к одной из дверей в этой комнате».~
@39850 = ~«Тогда я перепробую все двери».~
@39851 = ~«Я знал, что ты вернешься, шеф! Все-таки понял, что я нужен тебе, а?»~ [MRT516]
@39852 = ~«Да... идем».~
@39853 = ~«Не сейчас, Морт».~
@39854 = ~«Пф-ф. Ну хорошо, не знаю, как долго я смогу здесь быть, так что я даю тебе ПОСЛЕДНИЙ шанс. Ты уверен, что не хочешь моего мудрого совета и быстрой остроты?»~
@39855 = ~«Морт, у тебя НЕТ ни того, ни другого».~
@39856 = ~«Ладно. Я передумал. Давай, идем».~
@39857 = ~«Не сейчас, Морт. Может быть потом».~
@39858 = ~«Ты пытаешься задеть мои чувства, шеф? Погоди, разве я что-то не так сказал? Или это из-за того, что у меня нет рук? Что?»~
@39859 = ~«Ладно. Я передумал. Давай, идем».~
@39860 = ~«Ничего такого. Просто сейчас я не нуждаюсь в твоей компании. Прощай, Морт».~
@39861 = ~«Ну хорошо, я не собираюсь ждать тебя ВЕЧНО, так что тебе лучше вернуться, как только ты передумаешь».~
@39862 = ~«Я так и сделаю. Прощай, Морт».~
@39863 = ~«Что тебя гложет, шеф?»~ [MRT515]
@39864 = ~«Пока ничего, Морт. Просто проверяю, что ты еще со мной».~
@39865 = ~Оставить ее в покое.~
@39866 = ~Улыбчивая девушка приседает в милом реверансе и смотрит на тебя, улыбаясь. «Добро *пожаловать*, сударь! Я Ненни! Как *тебе* этот славный д... — внезапно она замечает твои шрамы и прикрывает рот рукой в перчатке. — О, боги! Ты ранен! — она закрывает глаза. — По всему телу!»~
@39867 = ~«Это все старые шрамы. Я в порядке».~
@39868 = ~«Только немного. Я очень скоро поправлюсь».~
@39869 = ~«Да, но раны скоро затянутся».~
@39870 = ~«Не думай об этом. У меня еще вопросы...»~
@39871 = ~«Не волнуйся об этом. Счастливо».~
@39872 = ~Она молча кивает и опускает руку.~
@39873 = ~«У меня есть несколько вопросов...» ~
@39874 = ~«Я должен идти. Прощай».~
@39875 = ~«Пожалуйста, спрашивай!» — она головокружительно улыбается.~
@39876 = ~«Что ты здесь делаешь?»~
@39877 = ~«Что ты можешь сказать об этом месте?»~
@39878 = ~«Что ты можешь рассказать о молчаливой проститутке?»~
@39879 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@39880 = ~«Кимаскси сказала, что кто-то забрал вещи из ее комнаты тоже. Ты не видела ничего странного?»~
@39881 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@39882 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@39883 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@39884 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@39885 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@39886 = ~«Неважно. Прощай».~
@39887 = ~«Нет, извини. *Отличное*, однако, имечко, не правда ли? Могу поспорить, она действительно интересная личность! Эй... тебе нужно спросить о ней у Ив. Она собирает *всевозможные* истории!»~
@39888 = ~«Так и сделаю. У меня есть другой вопрос...»~
@39889 = ~«Это все, что я хотел узнать. Прощай, Ненни».~
@39890 = ~«А? — она, похоже, не может оторвать взгляд от твоих шрамов. — О, как это некрасиво с моей стороны! Не обращай внимания на мое грубое поведение! Меня зовут Ненни, — она делает небольшой реверанс. — И мне очень приятно приветствовать тебя в нашем Борделе утоления интеллектуальной страсти, — она возвращается к рассматриванию твоего тела. — У тебя еще и татуировки под шрамами! Что это? — она показывает на одну из твоих татуировок.~
@39891 = ~«Эта...»~
@39892 = ~«Неважно, я...»~
@39893 = ~«Выглядит потрясающе! Погляди-ка на эти чернильные линии... Думаю, это чернила...» Она присматривается к татуировке, затем пытается прикоснуться к ней.~
@39894 = ~Позволить ей прикоснуться к тебе.~
@39895 = ~Не дать ей прикоснуться к тебе.~
@39896 = ~«Я *думаю*, это чернила, — она проводит пальцем по краю татуировки. — Это ведь чернила? И что за рисунок! Гляди, как тут пересекаются линии — она прикасается к центру татуировки. — Просто удивительно... — она надувает губки и разочарованно нахмуривается. — Я могла бы сделать ее лучше, не будь тут так много шрамов...»~
@39897 = ~«Со шрамами уже ничего не поделаешь — они навсегда».~
@39898 = ~«У меня есть несколько вопросов...» ~
@39899 = ~«Я уже должен идти. Прощай».~
@39900 = ~Когда ты избегаешь ее прикосновения, Ненни смотрит на тебя. «Извини, извини меня, сударь! Я не желала тебе зла: я лишь хотела потрогать татуировки и ощутить их узор. Это так очаровательно! — она делает недовольную гримаску, потом легонько хлопает себя по голове. — Слишком прямая! Я слишком прямая! Прими мои извинения, сударь! Прошу, не огорчайся!»~
@39901 = ~«Без проблем».~
@39902 = ~«Смотри, чтобы этого больше не повторилось».~
@39903 = ~Ненни кивает, затем мило улыбается тебе. «Прости меня, прости... но я *должна* знать... ты абсолютно *уверен*, что с тобой все в порядке? Я смотрю на тебя и просто не могу поверить, что тебе хоть *немного* не больно».~
@39904 = ~«Никакой физической боли, правда».~
@39905 = ~«У меня амнезия, не более того».~
@39906 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@39907 = ~«Не волнуйся об этом. Счастливо».~
@39908 = ~«О, прости меня, прости... чтоб меня оспа побила, если еще раз скажу о них! — она съеживается. — Но я *должна* знать... ты абсолютно *уверен*, что с тобой все в порядке? Я смотрю на тебя, и просто не могу поверить, что тебе хоть *совсем* не больно».~
@39909 = ~«Никакой физической боли, правда».~
@39910 = ~«У меня амнезия, не более того».~
@39911 = ~«Забудь об этом. У меня есть несколько вопросов...»~
@39912 = ~«Не волнуйся об этом. Счастливо».~
@39913 = ~«О! У тебя внутри болит? В голове? — она энергично хлопает в ладоши. — Может, я могу помочь! Вернее, я знаю, что могу! Программа обучения чувствующих включает в себя изучение избавления других от боли... моя госпожа говорит, что чувствующий может вытянуть боль из раны и забрать ее с собой... как бы там ни было, я *могу* помочь! Можно, я попробую?! Пожалуйста, скажи да!»~
@39914 = ~«Чувствующие?»~
@39915 = ~«Да, пожалуйста».~
@39916 = ~«Твоя госпожа?»~
@39917 = ~«Нет. У меня есть несколько вопросов...»~
@39918 = ~«Нет, мне не больно. Прощай».~
@39919 = ~«О, да, — радостно отвечает Ненни. — Госпожа Грация. Она — самая удивительная личность из тех, что я знаю!»~
@39920 = ~«Расскажи мне о госпоже Грации»~
@39921 = ~«Понимаю. Ну, давай, попробуй мне помочь...»~
@39922 = ~«Не думаю, что мне в самом деле нужна твоя помощь, однако у меня есть вопросы...»~
@39923 = ~«Понятно. Хотя не думаю, что ты сможешь помочь мне. Прощай».~
@39924 = ~«Она так прекрасна, не правда ли? Трудно поверить, что она из Нижних планов, — она такая милая и умная!»~
@39925 = ~«Причем здесь Нижние планы?»~
@39926 = ~«Понимаю. Ну, давай, попробуй мне помочь...»~
@39927 = ~«Не думаю, что мне в самом деле нужна твоя помощь, однако у меня есть вопросы...»~
@39928 = ~«Понятно. Хотя не думаю, что ты сможешь помочь мне. Прощай».~
@39929 = ~Внезапно Ненни замечает Падшую Грацию возле тебя. «О! Госпожа Грация!» Она делает реверанс; Грация кивает в ответ, улыбаясь.~
@39930 = ~«Причем здесь Нижние планы?»~
@39931 = ~«Понимаю. Ну, давай, попробуй мне помочь...»~
@39932 = ~«Не думаю, что мне в самом деле нужна твоя помощь, однако у меня есть вопросы...»~
@39933 = ~«Понятно. Хотя не думаю, что ты сможешь помочь мне. Прощай».~
@39934 = ~«Ну, все они там, внизу, такие *злые*. Кто бы мог подумать, что госпожа Грация происходит из такого места?»~
@39935 = ~«Понимаю. Ну, давай, попробуй мне помочь...»~
@39936 = ~«Не думаю, что мне в самом деле нужна твоя помощь, однако у меня есть вопросы...»~
@39937 = ~«Понятно. Хотя не думаю, что ты сможешь помочь мне. Прощай».~
@39938 = ~Ненни складывает руки в замок и небрежно кладет их тебе на лоб.~
@39939 = ~Позволить ей прикоснуться к тебе.~
@39940 = ~Позволить ей прикоснуться к тебе.~
@39941 = ~Не дать ей прикоснуться к тебе.~
@39942 = ~Когда она подходит ближе, ты замечаешь, что кожа Ненни слегка пахнет сиренью. Она нежно кладет свои руки в перчатках тебе на лоб и закрывает глаза. Она что-то мурлычет себе под нос, и ты ощущаешь, как по твоему телу пробегает еле ощутимая волна тепла.~
@39943 = ~«Э... спасибо. Было приятно».~
@39944 = ~«Конечно! Я так рада, что могу помочь!» Ненни широко улыбается тебе; похоже, она готова взорваться от счастья.~
@39945 = ~«У меня вопрос...»~
@39946 = ~«Я должен идти. Прощай».~
@39947 = ~Ненни застывает; она выглядит удивленной, затем слегка обиженной. «Извини меня! Извини! Ты не любишь, когда тебя касаются? Я должна была предупредить тебя! Просто таким образом работает Чувствительное прикосновение... Я кладу свои руки на твое тело — обычно возле раны, чтобы лучше сфокусировать силу — и вытягиваю боль».~
@39948 = ~«Чувствительное прикосновение...?»~
@39949 = ~«Прекрасно. В таком случае, продолжай».~
@39950 = ~«У меня вопрос...»~
@39951 = ~«Я должен идти. Прощай».~
@39952 = ~«Амнезия? — Ненни моргает, затем лицо ее проясняется. — Потеря памяти! Тебе *так* повезло, — ее голос весело звенит. — Все должно быть так *ново* для тебя».~
@39953 = ~«В этом есть доля правды, только новизна эта... нежеланна».~
@39954 = ~«Меня это не слишком беспокоит».~
@39955 = ~«Я... не смотрел на это под таким углом».~
@39956 = ~«Я бы предпочел, чтобы некоторые вещи были мне более знакомы».~
@39957 = ~Она закрывает глаза. «Это звучит так *печально*».~
@39958 = ~«Да, это так... но меня есть еще вопросы...»~
@39959 = ~«Вовсе нет. У меня есть несколько вопросов...»~
@39960 = ~«Возможно... как бы там ни было, прощай».~
@39961 = ~«Правда? Почему?»~
@39962 = ~«Нет, и все тут. Разве можно объяснить чувство?»~
@39963 = ~«Мне не нравится терять память, да и смерть — не самое приятное переживание».~
@39964 = ~«Без фундамента — некого понимания того, кто я такой — я не способен развиваться».~
@39965 = ~«Просто... ничего. У меня вопрос...»~
@39966 = ~«Я не хочу больше обсуждать это. Прощай».~
@39967 = ~Ненни восхищенно складывает руки. «Я так рада, что смогла открыть твой разум этой идее! Я слышала, что как раз ради этого и живут чувствующие... чтобы давать другим новые впечатления».~
@39968 = ~«Чувствующие?»~
@39969 = ~«У меня есть несколько вопросов...» ~
@39970 = ~«Я должен идти. Прощай».~
@39971 = ~«Например, кто? — она улыбается, потом хихикает над собой. — В смысле: что, например?»~
@39972 = ~«Мой убийца, к примеру».~
@39973 = ~«Не Морт. Он слишком хорошо мне знаком».~
@39974 = ~«Я хотел бы знать, был ли я знаком с кем-то из моих товарищей раньше».~
@39975 = ~«Просто... ничего. У меня вопрос...»~
@39976 = ~«Я не хочу больше обсуждать это. Прощай».~
@39977 = ~«О, любой может попробовать! — радостно восклицает Ненни. — Попробуй! Давай, уверена — ты сможешь».~
@39978 = ~«Мне не нравится терять память, да и смерть — не самое приятное переживание».~
@39979 = ~«Без фундамента — некого понимания того, кто я такой — я не способен развиваться».~
@39980 = ~«Просто... ничего. У меня вопрос...»~
@39981 = ~«Я не хочу больше обсуждать это. Прощай».~
@39982 = ~«Чувствующие! Ах, они такие *мечтатели*. Они считают, что понимания можно достичь, только попробовав как можно больше всего в мультивселенной! Попробуй это, послушай то, почувствуй это, посмотри на то... и всего этого *так* много вокруг, это *такое* огромное место, что иной раз трудно все перепробовать».~
@39983 = ~«У меня есть другие вопросы...»~
@39984 = ~«Это все, что я хотел узнать. Прощай».~
@39985 = ~Ненни хихикает.~
@39986 = ~«У меня есть несколько вопросов...» ~
@39987 = ~«Прощай, Ненни».~
@39988 = ~«А, — Ненни нахмуривает лоб в тяжелых раздумьях. — Пожалуй, в этом есть какой-то смысл. Я так хотела бы помочь!»~
@39989 = ~«Что ж, ты *могла бы* ответить на мой вопрос...»~
@39990 = ~«Я тоже. Прощай, Ненни...»~
@39991 = ~«Да! Это могут все чувствующие, но я еще не совсем чувствующая, так что у меня это не очень хорошо получается. Когда я научусь, я смогу забирать себе боль других людей — чтобы помочь им, и все такое!»~
@39992 = ~«Тогда давай».~
@39993 = ~«У меня вопрос...»~
@39994 = ~«Я должен идти. Прощай».~
@39995 = ~«Без понятия! Извини. Хммм. Может, тебе Джульетту спросить. Они с Кесай когда-то были по-настоящему близкими подругами. Потом Джульетта встретила Монтекки, и теперь они не особо разговаривают».~
@39996 = ~«У меня еще вопросы, Ненни...»~
@39997 = ~«Это все, что я хотел узнать. Прощай».~
@39998 = ~«Ах, Экко! Да, она такая загадочная, *не правда ли*?! Ты знаешь, что она вообще не разговаривает? Правда! — Ненни подается вперед и понижает голос. — Мне кажется, что она была эмоционально ранена, да так, что она, может, и вообще никогда не заговорит! Могу поспорить, что об этом знает Долора, ведь она когда-то разговаривала с последним возлюбленным Экко, который был у нее тогда, когда она еще могла говорить!»~
@39999 = ~«У меня еще вопросы, Ненни...»~
@40000 = ~«Это все, что я хотел узнать. Прощай».~
@40001 = ~«С *тобой* болтаю, глупыш! — она хихикает и толкает тебя в живот. — Так я разговариваю и со *всеми* остальными клиентами. Так делают все проститутки; ведь для этого и существует Бордель! Изучать новые способы разговора, делиться впечатлениями и понимать других людей».~
@40002 = ~«У меня еще вопросы, Ненни...»~
@40003 = ~«Это все, что я хотел узнать. Прощай».~
@40004 = ~«М-м... конечно, могу! Бордель утоления интеллектуальной страсти — это школа, основанная госпожой Падшей Грацией. Все проститутки здесь — и я тоже! — учатся азам общения с людьми, всему, что поможет нам узнать побольше о других и нас самих. Мне здесь нравится... это нескончаемая волна переживаний, которая проходит сквозь меня и наполняет мою голову свежими идеями!»~
@40005 = ~«Я еще вернусь. Прощай».~
@40006 = ~«У меня еще вопросы, Ненни...»~
@40007 = ~«Это все, что я хотел узнать. Прощай».~
@40008 = ~«Хмм, — Ненни сильно нахмуривается. — Я... э...»~
@40009 = ~«Что?»~
@40010 = ~«О, я просто не могу! Я не могу сказать ни о ком ничего дурного! Просто у меня это не слишком хорошо получается!»~
@40011 = ~«Нет ничего дурного в том, чтобы указать на вора, Ненни».~
@40012 = ~«Неважно... У меня еще вопрос».~
@40013 = ~«Не обращай внимания, Ненни. Счастливо».~
@40014 = ~«О, но я ведь не знаю, она ли воровка...» Ненни закусывает губу и жалобно смотрит на тебя, как будто хочет, чтобы ты оставил эту тему.~
@40015 = ~«Слушай, а почему бы тебе не *попробовать* сказать о ней что-нибудь нехорошее».~
@40016 = ~«Неважно... У меня еще вопрос».~
@40017 = ~«Не обращай внимания, Ненни. Счастливо».~
@40018 = ~«Ах, ладно». Ненни кладет руки на пояс и сильно нахмуривается, даже слишком сильно. Ты сопротивляешься искушению рассмеяться. «О-о-о, она мне очень, ну *очень* не нравится, — она на миг останавливается, затем искоса смотрит на тебя, как бы оценивая твою реакцию. — Было убедительно?»~
@40019 = ~«Нет, не очень...»~
@40020 = ~«Нет. Просто забудь об этом... У меня другой вопрос».~
@40021 = ~«Не обращай внимания, Ненни. Счастливо».~
@40022 = ~Ненни мрачнеет. «Я знала, что у меня не получится! — она уныло глядит на тебя. — Ты представляешь, как это *сложно* — сказать о ком-то что-нибудь плохое?! От этого так не по себе».~
@40023 = ~«Почему бы тебе не потренироваться на мне, Ненни?»~
@40024 = ~«Неважно... У меня еще вопрос».~
@40025 = ~«Не обращай внимания, Ненни. Счастливо».~
@40026 = ~«Наверно, я могла бы попробовать... — ее терзают сомнения. — Ты большой грязный противный грубиян! — она кладет руки на пояс. — Подлец! — она смотрит на тебя. — Ну как?»~
@40027 = ~«Сделай ударение на 'грубиян'».~
@40028 = ~«Попробуй меня ударить».~
@40029 = ~«Ты большой грязный противный *грубиян*!»~
@40030 = ~«Уже лучше. А теперь ударь меня».~
@40031 = ~Ненни складывает ладони у своего рта; она выглядит шокированной. «О, я не могу! Я не должна! — она закрывает глаза. — Да и зачем кому-то кого-то бить?»~
@40032 = ~«Вперед. Бей легонько, если хочешь. Помни: я — грязный противный грубиян. Я это заслужил».~
@40033 = ~Ненни дает тебе пощечину; ты еле чувствуешь это. Она все еще выглядит потрясенной и испуганной из-за того, что причинила тебе боль. «О, прости меня! Тебе больно? Скажи, что ты в порядке!»~
@40034 = ~«Не порти образ, Ненни. Давай, покажи, на что ты способна. Ты можешь сказать что-нибудь плохое... просто позволь ему выйти наружу».~
@40035 = ~«Ай! Проклятье, меня ни разу так сильно не били!»~
@40036 = ~«О... в смысле, ах! — Ненни выпрямляется во весь рост своего миниатюрного тела, сжимает руки в кулачки, кладет их на пояс и корчит милую гримаску. «Ах, чтоб ты провалился! Ты это заслужил за все те унижения, через которые я прошла из-за тебя! Уходишь из дому посреди ночи, — ее взгляд блуждает по тебе вверх-вниз. — Ввязываешься в драки и получаешь все эти шрамы! Что об этом дети подумают, хм?!»~
@40037 = ~«Великолепно».~
@40038 = ~«Э... дети?»~
@40039 = ~«О, не хвали меня, будто я из тех, неженок, что ждут твоего одобрения! Я самостоятельная женщина, и эта женщина собирается уйти из твоей жизни, если только не получит от тебя кое-какие твердые обязательства!»~
@40040 = ~«Ладно... этого достаточно, Ненни».~
@40041 = ~«Э... успокойся. Пора угомониться».~
@40042 = ~Ненни бьет тебя. Ты еле ощущаешь это. «Получай, — она бьет тебя снова. — Вот тебе!» — она снова ударяет тебя, быстро превращаясь в маленький молотящий кулаками смерч.~
@40043 = ~«Ладно, ладно... Пора угомониться».~
@40044 = ~Ненни устало вздыхает. «Фух. Это легче, чем я думала!»~
@40045 = ~«Кроме шуток».~
@40046 = ~«И я уверена, что в следующий раз у меня получится еще лучше! Я так рада узнать что-нибудь новое... спасибо!»~
@40047 = ~«Конечно. У меня еще вопрос...»~
@40048 = ~«Что?! — ярость Ненни берет новую планку. — Ты забыл о наших детях?! Ты уже что, мозги пропил, раз не можешь вспомнить даже то, что у нас есть *дети*?! — Ненни в гневе вскидывает руки. — Ты безнадежный, бестолковый и еще много без-, которые я сейчас не буду упоминать».~
@40049 = ~«Э... успокойся. Пора угомониться».~
@40050 = ~Глаза Ненни расширяются еще больше, когда ты корчишься от притворной боли. «О, боги! Ох, я не хотела бить тебя так сильно! Прости меня! Прости!»~
@40051 = ~«Никогда не извиняйся. Скажи 'лучше привыкай'».~
@40052 = ~Ненни смотрит на тебя. «О... э, лучше привыкай».~
@40053 = ~«Нахмурься, когда произносишь это. Говори безжалостно и убедительно».~
@40054 = ~Ненни выпрямляется во весь рост своего миниатюрного тела, сжимает руки в кулачки, кладет их на пояс и корчит милую гримаску. «Лучше привыкай!»~
@40055 = ~«Великолепно».~
@40056 = ~«Может быть... Однажды ночью я видела, как эта низкая, подлая Марисса украдкой выходила из комнаты Вивьен. Не то, чтобы я говорю, что она его прихватила, но я знаю, что Марисса — не очень приятная личность, да и это, конечно, звучит подозрительно, да? Я бы пошла и спросила у нее об этом». Ненни кивает тебе.~
@40057 = ~«Спасибо, Ненни. У меня есть другой вопрос...»~
@40058 = ~«Это все, что я хотел узнать. Прощай, Ненни».~
@40059 = ~«Конечно, знаю! Однажды ночью я видела, как эта гадкая Кимаскси Змееязыкая украдкой выходила из комнаты Мариссы. Знаешь, они обе — подлые, но Кимаскси просто ужасна! Как бы там ни было, я бы сперва с ней поговорила».~
@40060 = ~«Спасибо, Ненни. У меня есть другой вопрос...»~
@40061 = ~«Это все, что я хотел узнать. Прощай, Ненни».~
@40062 = ~Глаза Ненни неожиданно расширяются. «О! Точно! Знаешь, однажды я видела мужчину, прокрадывающегося из комнаты Кимаскси, пока она разговаривала с клиентом... Я весь тот день следила за парадной дверью, но он так и не вышел! Разве это не странно? Не думаю, что он смог бы выбраться через окно, так что я так и не поняла, куда он делся. А потом я и вовсе забыла об этом! Странно, да?»~
@40063 = ~«Да... У меня есть другой вопрос...»~
@40064 = ~«Вот оно. Счастливо, Ненни»~
@40065 = ~«Добро *пожаловать*, сударь! Я Ненни! Как *тебе* этот славный д... О! Мы уже встречались! — Ненни хихикает и радостно улыбается тебе. — Извини! Ведь я *знала*, что мы уже знакомы...»~
@40066 = ~«Все хорошо, Ненни. У меня есть несколько вопросов...»~
@40067 = ~«Я просто проходил мимо. Прощай, Ненни».~
@40068 = ~Морт вертится вокруг тебя, подшучивая над очевидностью слов девушки. «Силы небесные, шеф... а ведь она права! Как я раньше не заметил... ты же весь в *шрамах*!»~
@40069 = ~«Это все старые шрамы. Я в порядке».~
@40070 = ~«Только немного. Я очень скоро поправлюсь».~
@40071 = ~«Да. И очень сильно».~
@40072 = ~«Не думай об этом. У меня еще вопросы...»~
@40073 = ~«Не волнуйся об этом. Счастливо».~
@40074 = ~Морт водит бровями. «Да ты и впрямь слишком «прямая»... может, стоит что-нибудь сделать с этими обвисшими, болтающимися гр...»~
@40075 = ~«Хватит, Морт».~
@40076 = ~Морт умолкает.~
@40077 = ~«Нет проблем, Ненни».~
@40078 = ~«Следи, чтобы это больше не повторилось, Ненни».~
@40079 = ~«Нет проблем, барышня».~
@40080 = ~«Следи, чтобы это больше не повторилось, девочка».~
@40081 = ~«Эй!»~
@40082 = ~Морт бурчит себе под нос: «Думаю, хорошо, что там *вообще* хоть что-нибудь есть».~
@40083 = ~«У меня другой вопрос, Ненни...»~
@40084 = ~«Это все, что я хотел узнать, Ненни. Прощай».~
@40085 = ~«Понятно. У меня еще вопросы...»~
@40086 = ~«Вообще-то, я просто проходил мимо. Прощай».~
@40087 = ~Когда ты подходишь, знатная женщина грациозно приседает в реверансе. «Рада снова вас видеть, сэр».~
@40088 = ~«Да, приветствую. У меня есть несколько вопросов...»~
@40089 = ~«Приветствую. Я просто проходил мимо. Прощай».~
@40090 = ~Женщина кивает. «Конечно».~
@40091 = ~«Ты упомянула, что ты здесь — постоянный клиент?»~
@40092 = ~«Что ты здесь делаешь?»~
@40093 = ~«Что ты можешь рассказать об этом месте?»~
@40094 = ~«Что ты можешь рассказать о молчаливой куртизанке?»~
@40095 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40096 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40097 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40098 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@40099 = ~«Я переговорил со всеми девятью куртизанками... ты не знаешь, кто десятая или где она находится?»~
@40100 = ~«Вообще-то, неважно. Прощай».~
@40101 = ~Она кивает. «Все верно, молодой человек. Как-то вечером я наведалась сюда, чтобы собственными глазами увидеть причину, по которой мой муж наносит сюда постоянные визиты... Я быстро сдружилась с парой куртизанок — и вот я здесь! Знаете ли, наслаждаться добротной беседой — удовольствие не только для мужчин».~
@40102 = ~«Совершенно верно. У меня еще вопрос...»~
@40103 = ~«Наверное. Как бы там ни было, прощай».~
@40104 = ~«Бордель — это школа, основанная Падшей Грацией... она обучает будущих членов Общества Восприятия тонкому искусству речи и общения. Если то, что я слышала, — правда, то Бордель содержится на средства наиболее обеспеченных клиентов».~
@40105 = ~«Падшая Грация?»~
@40106 = ~«Расскажи мне об Обществе Восприятия».~
@40107 = ~«У меня есть другие вопросы...»~
@40108 = ~«Это все, что я хотел узнать. Прощай».~
@40109 = ~Женщина бросает на тебя странный взгляд, но лишь ненадолго. «Вы, конечно, уже слышали о них раньше, да? О чувствующих? Они — фракция, верящая, что чувственный опыт является ключом к пониманию мультивселенной. Штаб-квартира их фракции, Городской Фестхолл, находится неподалеку... выйдите отсюда, поверните налево, потом еще раз налево. Там вы найдете многих желающих поговорить об Обществе Восприятия».~
@40110 = ~«У меня есть другие вопросы...»~
@40111 = ~«Это все, что я хотел узнать. Прощай».~
@40112 = ~«Я ее не знаю... не помню ее имени. Мне сказали, что она не может общаться, так что я никогда и не пыталась заговорить с ней».~
@40113 = ~«У меня есть другие вопросы...»~
@40114 = ~«Это все, что я хотел узнать. Прощай».~
@40115 = ~«Равель? Я не знаю никого по имени Равель, и тем более что она — мать Кесай. Ведь сама Кесай мне говорила, что она — сирота, и что ее отец, наполовину нечистый, оставил ее здесь, в Сигиле».~
@40116 = ~«У меня есть другие вопросы...»~
@40117 = ~«Это все, что я хотел узнать. Прощай».~
@40118 = ~«Нет. Хотя в последнее время Вивьен об этом постоянно упоминает — она ведь так расстроена! Я была бы очень рада, если бы ей его вернули — она теперь почти ни о чем другом не говорит».~
@40119 = ~«У меня есть другие вопросы...»~
@40120 = ~«Это все, что я хотел узнать. Прощай».~
@40121 = ~Женщина резко нахмуривается. «О, мне нет дела до Мариссы... какой же у нее неприятный характер! Что касается ее вуали, то нет... я ничего об этом не знаю».~
@40122 = ~«У меня есть другие вопросы...»~
@40123 = ~«Это все, что я хотел узнать. Прощай».~
@40124 = ~«Равель... Заморочка... — она медленно, будто впервые, произносит это имя. — Должна признаться — не знаю».~
@40125 = ~«У меня есть другие вопросы...»~
@40126 = ~«Это все, что я хотел узнать. Прощай».~
@40127 = ~«Я знаю только девятерых куртизанок... и я точно уверена, что общалась со всеми. Возможно, появилась новая девочка, с которой я еще незнакома?..»~
@40128 = ~«У меня есть другие вопросы...»~
@40129 = ~«Это все, что я хотел узнать. Прощай».~
@40130 = ~«Заглядываю сюда, чтобы поболтать с подругами, вот и все. Я — одна из немногих женщин, посещающих Бордель утоления интеллектуальной страсти».~
@40131 = ~«Постоянный клиент?»~
@40132 = ~«Можешь порекомендовать, с кем бы мне поболтать?»~
@40133 = ~«У меня есть другие вопросы...»~
@40134 = ~«Это все, что я хотел узнать. Прощай».~
@40135 = ~«Зависит от того, с кем именно вы желаете побеседовать. Что касается меня... ну, я дружу с Вивьен и Кесай-Серри, а также изредка перекидываюсь парой слов с этой милой мушкой Ненни».~
@40136 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40137 = ~«У меня есть другие вопросы...»~
@40138 = ~«Это все, что я хотел узнать. Прощай».~
@40139 = ~«Да... куртизанки зовут ее госпожой Грацией. Обычно она встречает клиентов в фойе Борделя... вы можете найти ее там, если захотите пообщаться».~
@40140 = ~«У меня есть другие вопросы...»~
@40141 = ~«Это все, что я хотел узнать. Прощай».~
@40142 = ~«Советую проявить ко мне немного уважения».~
@40143 = ~«Да, но не стану тратить свое время. Прощай».~
@40144 = ~«Нет. Прощай».~
@40145 = ~«Опять вы докучаете мне своим присутствием. Да если бы я хотел говорить с такими как *вы*, то таких есть целый район на востоке отсюда. А теперь оставьте меня».~
@40146 = ~«Советую проявить ко мне немного уважения».~
@40147 = ~Уйти.~
@40148 = ~Аристократ смотрит на тебя суженными глазами. «Меня это не волнует... нисколько! А теперь уходите. Исчезните, оставьте меня».~
@40149 = ~«Советую проявить ко мне немного уважения».~
@40150 = ~Уйти.~
@40151 = ~Он закрывает глаза и медленно выдыхает, как бы успокаивая себя. «Если это необходимо, чтобы избавиться от вас, что ж, так тому и быть. Сэр, смиренно прошу вас: будьте так *любезны*, покиньте меня и найдите себе собеседника где-нибудь *еще*».~
@40152 = ~«Отлично... Прощай».~
@40153 = ~Уйти.~
@40154 = ~«Здравствуй и прощай».~
@40155 = ~«Еще раз приветствую, сэр».~
@40156 = ~«Приветствую. У меня есть несколько вопросов...»~
@40157 = ~«Здравствуй и прощай».~
@40158 = ~Он кивает. «Да, продолжай...»~
@40159 = ~«Как ты получил этот синяк под глазом?»~
@40160 = ~«Что ты здесь делаешь?»~
@40161 = ~«Что ты можешь рассказать об этом месте?»~
@40162 = ~«Что ты можешь рассказать о молчаливой куртизанке?»~
@40163 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40164 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40165 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40166 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@40167 = ~«Я переговорил со всеми девятью куртизанками... ты не знаешь, кто десятая или где она находится?»~
@40168 = ~«Вообще-то, неважно. Прощай».~
@40169 = ~Он глупо улыбается. «Ах, этот? Долгая история, сэр. Которая вряд ли будет вам интересной».~
@40170 = ~«Напротив... прошу, расскажи».~
@40171 = ~«Хорошо. У меня есть другие вопросы...»~
@40172 = ~«Тогда прощай» .~
@40173 = ~Мужчина вздыхает, закатывая глаза. «Хорошо... но я не стану вдаваться в подробности. Несмотря на мое прошлое замечание о длине рассказа, я могу выразить его в двух словах: Кимаскси Змееязыкая».~
@40174 = ~«Кто?»~
@40175 = ~«О... да, я с ней знаком».~
@40176 = ~«Понятно. У меня есть другой вопрос...»~
@40177 = ~«Это все, что я хотел узнать. Прощай».~
@40178 = ~«О, я гляжу, вы с ней еще не разговаривали. Я больше не стану рассказывать о том, что за конфетка эта Кимаскси, сэр... вместо этого я настаиваю, чтобы вы с ней поговорили. Она одна из здешних куртизанок, самая очаровательная ученица госпожи Грации». Он улыбается тебе.~
@40179 = ~«Госпожа Грация?»~
@40180 = ~«У меня есть другие вопросы...»~
@40181 = ~«Может быть, тогда я найду ее. Прощай».~
@40182 = ~Мужчина мечтательно вздыхает. «Не правда ли, она восхитительна? — внезапно к нему возвращается сосредоточенность. — Постойте! Не принимайте мои слова за проявление любви, сэр... В конце концов, я помолвлен с женщиной, которой всецело принадлежит мое сердце. Но Кимаскси... она такая... *другая* в разговоре». Он улыбается тебе.~
@40183 = ~«Да уж... другая. У меня еще вопрос...»~
@40184 = ~«Я уже должен идти. Прощай».~
@40185 = ~«Как что, наслаждаюсь радостями Борделя! А вы?»~
@40186 = ~«Радостям?»~
@40187 = ~«У меня есть другие вопросы...»~
@40188 = ~«Это все, что я хотел узнать. Прощай».~
@40189 = ~«Да, совершенно верно... вы здесь разве не за тем, чтобы беседовать с дамами? В конце концов, в этом и заключается предназначение данного заведения. Клиенты ходят сюда лишь для одного — беседовать с прекрасными ученицами госпожи Грации!»~
@40190 = ~«Госпожа Грация?»~
@40191 = ~«У меня есть другие вопросы...»~
@40192 = ~«Это все, что я хотел узнать. Прощай».~
@40193 = ~Мужчина кивает. «Да, и как она выглядит. Я бы мог слушать ее голос часами! По-моему, она уступает только Кимаскси... — на миг его мысли уплывают куда-то далеко. — О! Но, как я уже и говорил, госпожа Грация — владелица Борделя. Наверняка она где-то неподалеку... идите поговорите с ней сами. Уверяю вас, вы не пожалеете».~
@40194 = ~«У меня есть другие вопросы...»~
@40195 = ~«Это все, что я хотел узнать. Прощай».~
@40196 = ~«Какой сигилец не знает о Борделе утоления интеллектуальной страсти? Должно быть, сэр, вы здесь совсем недавно, — он вздыхает. — Гулять... болтать с дамами... все это здесь, в Борделе. Если вас интересует его история со всеми подробностями, советую поговорить с госпожой Грацией».~
@40197 = ~«Госпожа Грация?»~
@40198 = ~«У меня есть другие вопросы...»~
@40199 = ~«Это все, что я хотел узнать. Прощай».~
@40200 = ~Мужчина задумывается. «Никогда с ней не разговаривал. Кажется, ее зовут Экко».~
@40201 = ~«У меня есть другие вопросы...»~
@40202 = ~«Это все, что я хотел узнать. Прощай».~
@40203 = ~«Равель... Равель... вы имеете в виду легендарную ночную ведьму? Трудно поверить, что это чудовищное создание могло быть *чьей-либо* матерью, не говоря уже о Кесай».~
@40204 = ~«У меня есть другие вопросы...»~
@40205 = ~«Это все, что я хотел узнать. Прощай».~
@40206 = ~«Она потеряла свой аромат? Как странно... Недавно я проходил мимо нее, и от нее довольно-таки хорошо пахло. Как и раньше, разумеется. Пожалуй, не припомню, чтобы я когда-либо встречал женщину со столь соблазнительным ароматом».~
@40207 = ~«Вообще-то, пропал ее *личный* аромат».~
@40208 = ~«У меня есть другие вопросы...»~
@40209 = ~«Это все, что я хотел узнать. Прощай».~
@40210 = ~«В самом деле? Я и не знал, что такое возможно. Что ж, безусловно, я надеюсь, что она его себе вернет!»~
@40211 = ~«У меня есть другие вопросы...»~
@40212 = ~«Я должен идти. Прощай».~
@40213 = ~«Нет. Хотя должен признаться, Марисса меня чем-то пугает. Я боюсь, что в ее комнате меня поджидает нечто ужасное, и что она просто потакает мне, перед тем как разорвать меня на части. Я, к примеру, буду очень рад, если у нее снова будет вуаль, и она будет встречаться с клиентами за пределами своей темной комнаты».~
@40214 = ~«У меня есть другие вопросы...»~
@40215 = ~«Я должен идти. Прощай».~
@40216 = ~«Все, что я знаю о Равель — обычные детские сказки... что она невероятна злая, и что она навлекла на себя гнев Леди Боли и была навеки изгнана».~
@40217 = ~«У меня есть другие вопросы...»~
@40218 = ~«Я должен идти. Прощай».~
@40219 = ~«Десятая? Десятая ученица... десятая куртизанка... хм-м. Нет, не скажу, что даже знал об этом, не говоря уже о том, кем бы она могла быть».~
@40220 = ~«У меня есть другие вопросы...»~
@40221 = ~«Я должен идти. Прощай».~
@40222 = ~«Ооо, нет... ты просто *обязан* нам сейчас же все рассказать».~
@40223 = ~«Да... пожалуйста, расскажи нам».~
@40224 = ~«Брось это, Морт. У меня к нему другой вопрос...»~
@40225 = ~«Забудь об этом, Морт. Идем».~
@40226 = ~Она мельком смотрит на тебя, после чего снова устремляет свой взор вдаль. «Да, приветствую... Меня зовут Джульетта. Чем я могу... ах, не обращай внимания. Оставь меня, пожалуйста». Она раздраженно вздыхает.~
@40227 = ~«О, ничего страшного. Не учитывая того, что я провожу дни напролет, глядя в лицо посредственностям, пытаясь найти что-нибудь, способное избавить меня от их ужасно скучных разговоров».~
@40228 = ~«Увы, это так, — она вздыхает, закрывает глаза и массирует себе виски. — Ужасная скука!»~
@40229 = ~«Нет, нет... хотя было любезно с твоей стороны предложить мне это. У меня уже есть мужчина, сэр, и я всем сердцем люблю его. Просто я хочу... — она постукивает пальцами по подбородку. — чего-то *большего* от наших с ним отношений».~
@40230 = ~Она нахмуривается и закатывает глаза. «В лучшем случае, сомнительно. У меня уже есть мужчина, сэр, и я всем сердцем люблю его. Просто я хочу... — она постукивает пальцами по подбородку. — Чего-то *большего* от наших с ним отношений».~
@40231 = ~Null node.~
@40232 = ~«Единственное, чего в них *не хватает* — это волнующих моментов, сэр. Наши семьи прекрасно восприняли новость о том, что мы встречаемся, его родственники любят моих, а наши друзья считают, что наш союз благословили сами силы. Все просто чудесно, вот только... — она мрачнеет. — уж слишком *гладко*. Ведь не должно же быть, чтобы отношения были такими беззаботными».~
@40233 = ~«Да, проблема в том... — она вспыхивает, — что нет проблем, о которых можно было бы рассказать! Наши семьи прекрасно восприняли новость о том, что мы встречаемся, его родственники любят моих, а наши друзья считают, что наш союз благословили сами силы. Все просто чудесно, вот только... — она мрачнеет. — уж слишком *гладко*. Ведь не должно же быть, чтобы отношения были такими беззаботными».~
@40234 = ~Null node.~
@40235 = ~«Разве нет? У тебя никогда не было таких отношений? — она ненадолго обращает на тебя свой взгляд. — Похоже, что жизнь твоя исполнена множеством трудностей, судя по бледности твоей кожи».~
@40236 = ~«Просто у всех моих подруг такие интересные отношения... с суматохой, враждующими семьями, кинжалами в спинах, ядами, сумасшедшими родственниками и разгневанными отцами с огромными мечами. Я же люблю человека, семья которого любит меня, и его самого все любят, — она снова вздыхает. — Величайший источник досады. Как бы я хотела внести пикантность в наши отношения...»~
@40237 = ~«Тем не менее, я хочу испытать трудности. Я хочу пережить все радости и невзгоды отношений... но только с ним, и ни кем другим, — она вздыхает. — О, любовь — такая штука. Она может быть тупой как дубина и совсем бесполезной для стремящихся быть чувствующими».~
@40238 = ~«Я не уверена. Какой-то элемент опасности. Или ревности. Что-нибудь *впечатляющее*».~
@40239 = ~Она закусывает губу. «У меня никогда было *настоящих* увлечений, ведь я так его люблю! Но может... мне завести ненастоящий роман? — она критически осматривает тебя сверху донизу. — Похоже, тебе не чужды опасные предприятия. У тебя нет желания стать моим ухажером?»~
@40240 = ~Джульетта нахмуривается. «Моего общества и моей благодарности будет достаточно».~
@40241 = ~Услышав это, она мрачнеет еще больше. «Что у тебя на уме... это ведь *не предполагает* касаний ко мне?»~
@40242 = ~Джульетта обдумывает это предложение, затем кивает. «Хорошо. Я выполню обещанное, *как только* ты выполнишь свое обещание. Ты все понял?»~
@40243 = ~«В таком случае, мы зашли в тупик. Ты уверен, что не хочешь еще раз подумать?»~
@40244 = ~Глаза Джульетты вспыхивают. «Отличная идея! Просто отличная! — внезапно она мрачнеет. — Вот только он знает мой почерк... может, ты мне что-нибудь напишешь?»~
@40245 = ~«О, сделаешь? Великолепно! Как только ты достанешь их, пожалуйста, отдай их моему любимому, Монтекки... его можно найти в Городском Фестхолле. Что касается писем... пожалуйста, обратись к Нарушителю Пенну. У него типография в Нижнем районе. Благодарю тебя!»~
@40246 = ~Джульетта смотрит на тебя, затем усмехается. «О, я очень сомневаюсь, что... хмм. На самом деле, эта идея не такая уже и тухлая, как я сперва подумала. Определенно, на вид ты довольно *опасен*, — она смотрит тебе в глаза, как будто приценивается к лошади. — Ты столь же грубый и жесткий, насколько можно судить по твоей внешности?»~
@40247 = ~«Значит, ты выполнишь это для меня?»~
@40248 = ~«Великолепно! Моего возлюбленного, Монтекки, можно найти в Городском Фестхолле. Спасибо тебе!»~
@40249 = ~Джульетта закатывает глаза: «О, продолжай, если это необходимо».~
@40250 = ~Джульетта делает долгий и несчастный вздох. Ты понимаешь, что она вовсе и не смотрит на тебя.~
@40251 = ~«Хм? О, я, по правде говоря, и не слушала... прошу прощения. Но ты ведь, несомненно, пришел не только для того, чтобы задавать кучу вопросов о моей скучной жизни и моих скучных деяниях?..»~
@40252 = ~«Я здесь готовлюсь стать чувствующей. Госпожа Грация — наш учитель. Все проститутки здесь — ее ученицы».~
@40253 = ~Джульетта кивает. «Член Общества Восприятия, фракции, посвященной чувствам и впечатлениям. Госпожа Грация лучше, чем я, подойдет для ответов на вопросы, касающиеся Чувствующих».~
@40254 = ~Джульетта ухмыляется. «Бордель... это школа для стремящихся быть чувствующими. Госпожа Грация — наш учитель и, кроме того, она более компетентна в таких вопросах, чем я. Быть может, тебе лучше поговорить с ней?»~
@40255 = ~Джульетта печально качает головой. «В самом деле, как жалко! Бедняжка. Признаюсь, я временами пробиралась в ее покои, чтобы взять пару капель ее духов... но чтобы осмелиться улизнуть с личным ароматом Вивьен? Как просто возмутительно! В любом случае, спроси об этом малышку Ненни. Она без конца тут порхает, высматривает все».~
@40256 = ~«О, да кому вообще *понадобилась* эта вещь? Я, к примеру, надеюсь, что эта невоспитанная и чрезвычайно неприятная женщина останется в своей комнате до тех пор, пока я не покину это место! Что до твоего вопроса, то ответ — нет; я ее не видела, и не знаю, где бы она могла быть. Во всяком случае, Ненни может знать: она без конца тут блуждает, присматриваясь ко всему».~
@40257 = ~«Равель чего? Это еще кто? — Джульетта кажется сбитой с толку. — Это действительно чье-то имя? Если так, то Ив должна о ней знать. Ей известны мириады рассказов, так что она, скорее всего, расскажет тебе историю этой Равель».~
@40258 = ~«О ком это ты *говоришь*?»~
@40259 = ~«Не представляю, о ком ты ведешь речь».~
@40260 = ~Ты видишь Джульетту, как всегда несчастную. Она едва отмечает твое присутствие, лишь на секунду взглянув в твою сторону, после чего снова устремляет свой взгляд в пустое пространство.~
@40261 = ~Джульетта с надеждой смотрит на тебя. «Ну? Уже что-нибудь есть?»~
@40262 = ~Похоже, Джульетта шокирована, и уже через секунду она начинает хныкать и жалобно рыдать.~
@40263 = ~Ей удается унять свои рыдания, и, утерев глаза, она смотрит на тебя.~
@40264 = ~«Ты сказал ему?.. Проклятье! Что же мне теперь делать?!»~
@40265 = ~Джульетта кивает. «Да, совершенно верно. Благодарю тебя».~
@40266 = ~Null node.~
@40267 = ~Джульетта выглядит шокированной. «Он... он сказал *такое*?! Как я могла быть такой... ах! Похоже, что в наших отношениях были проблемы, которых я так жаждала, а я просто не замечала их из-за своей меланхолии!»~
@40268 = ~Джульетта разочарованно стискивает зубы. «О-о-о! Какое сильное разочарование! Значит, мне придется попробовать что-нибудь еще».~
@40269 = ~Джульетта с надеждой смотрит на тебя. «Ну? Уже что-нибудь есть?»~
@40270 = ~«И что, он не собирается за меня драться?»~
@40271 = ~Джульетта выглядит хуже, чем ты когда-либо ее видел. Ее лицо изможденное и бледное, с черными кругами вокруг налитых кровью глаз. Она дарит тебе нерешительную улыбку, как будто пытаясь выглядеть мило.~
@40272 = ~«Приветствую. Пришел задавать свои вопросы, угадала?»~
@40273 = ~«Равель... хмм... а! Думаю, я где-то уже слышала это имя. Не знаю, правда ли это, но до меня *доносились* кое-какие слухи. Ты можешь спросить о том же Кимаскси Змееязыкую... видишь ли, они сводные сестры».~
@40274 = ~«О, ты говоришь об Экко. Говорят, она поклялась никогда больше не говорить по какой-то причине. Представить не могу, зачем кому-либо делать такое».~
@40275 = ~Морт подлетает поближе к тебе и шепчет: «Мне жаль ее любовника. Он не представляет, как плохо обстоят дела. От таких девчонок, как эта, одни проблемы».~
@40276 = ~«Это звучит не очень мудро, Джульетта. Довольствуйся тем, что имеешь».~
@40277 = ~«Что у тебя на уме, Джульетта?»~
@40278 = ~«У меня еще вопросы, Джульетта...»~
@40279 = ~«Это все, что я хотел узнать, Джульетта. Прощай».~
@40280 = ~«Что не так?»~
@40281 = ~«Для начала, у меня есть несколько вопросов...»~
@40282 = ~«Ладно. Счастливо».~
@40283 = ~«У тебя такая скучная жизнь?»~
@40284 = ~«Понятно. У меня были вопросы...»~
@40285 = ~«Это все, что я хотел узнать. Прощай».~
@40286 = ~«Возможно, я мог бы сделать ее менее скучной, моя госпожа».~
@40287 = ~«Уверен я мог бы добавить твою жизнь немного волнения...»~
@40288 = ~«Уверен я мог бы добавить твою жизнь немного волнения...»~
@40289 = ~«Понятно. У меня были вопросы...»~
@40290 = ~«Это все, что я хотел узнать. Прощай».~
@40291 = ~~
@40292 = ~~
@40293 = ~~
@40294 = ~~
@40295 = ~~
@40296 = ~~
@40297 = ~~
@40298 = ~«Не помню, чтобы у меня хоть с кем-то были отношения».~
@40299 = ~«Не помню, чтобы у меня хоть с кем-то были отношения. Остатки воспоминаний о них наводят меня на мысль, что у меня были какие-то проблемы с этим».~
@40300 = ~«Понятно. У меня были вопросы...»~
@40301 = ~«Это все, что я хотел узнать. Прощай».~
@40302 = ~«Это звучит не очень мудро. Довольствуйся тем, что имеешь».~
@40303 = ~«Что ты имеешь в виду?»~
@40304 = ~«Понятно. У меня были вопросы...»~
@40305 = ~«Это все, что я хотел узнать. Прощай».~
@40306 = ~«Ох... плохо... варгулья укуссссила... так плохо...»~
@40307 = ~«И как же ты собираешься оживить ваши отношения?»~
@40308 = ~«Стремишься быть чувствующей?»~
@40309 = ~«Понятно. У меня были вопросы...»~
@40310 = ~«Это все, что я хотел узнать. Прощай».~
@40311 = ~«Почему бы тебе не завести роман?»~
@40312 = ~«Почему бы тебе не написать несколько фальшивых любовных писем от неизвестного почитателя?»~
@40313 = ~«Если хочешь, я мог бы притвориться ревнивым поклонником».~
@40314 = ~«Понятно. У меня были вопросы...»~
@40315 = ~«Удачи. Прощай».~
@40316 = ~«Да. Я сделаю это».~
@40317 = ~«А что мне от этого?»~
@40318 = ~«Нет... У меня есть кое-какие вопросы...»~
@40319 = ~«Нет, спасибо. Прощай».~
@40320 = ~«Ладно; в таком случае, я займусь этим».~
@40321 = ~«Нет».~
@40322 = ~«Забудь. У меня есть несколько вопросов...»~
@40323 = ~«Нет, спасибо. Прощай».~
@40324 = ~«Больше не льсти себе — это меня бесит. Мне нужна кое-какая информация».~
@40325 = ~«Мне нужна кое-какая информация».~
@40326 = ~«Согласен».~
@40327 = ~«Нет. Так не пойдет».~
@40328 = ~«Ладно... Я этим займусь».~
@40329 = ~«Нет, извини. У меня есть несколько вопросов...»~
@40330 = ~«Нет. Прощай, Джульетта».~
@40331 = ~«Это не ко мне. Хотя я мог бы присмотреть кое-что для тебя».~
@40332 = ~«А вообще, забудь об этом. У меня есть несколько вопросов...»~
@40333 = ~«Пожалуй, нет. Прощай, Джульетта».~
@40334 = ~«Конечно. Прощай».~
@40335 = ~«Круче меня не найдешь, уверяю тебя».~
@40336 = ~«Да».~
@40337 = ~«Да, я сделаю это».~
@40338 = ~«А что мне от этого будет?»~
@40339 = ~«Вообще-то... нет. Но у меня есть пара вопросов...»~
@40340 = ~«Да... плохи дела...»~
@40341 = ~«Конечно. Пойду, поговорю с ним... Счастливо».~
@40342 = ~«Что ты здесь делаешь?»~
@40343 = ~«Что ты можешь сказать об этом месте?»~
@40344 = ~«Что ты можешь рассказать о молчаливой проститутке?»~
@40345 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40346 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40347 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40348 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@40349 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
@40350 = ~«Что ты здесь делаешь?»~
@40351 = ~«Что ты можешь сказать об этом месте?»~
@40352 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40353 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40354 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40355 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@40356 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
@40357 = ~«Вообще-то, ничего особенного. Прощай».~
@40358 = ~«Джульетта? Ты меня слышишь?»~
@40359 = ~«Неважно. Прощай».~
@40360 = ~«У тебя такая скучная жизнь?»~
@40361 = ~«Вообще-то, да, у меня есть вопросы...»~
@40362 = ~«Это все, что я хотел узнать. Прощай».~
@40363 = ~«Чувствующей?»~
@40364 = ~«У меня есть другие вопросы...»~
@40365 = ~«Это все, что я хотел узнать. Прощай».~
@40366 = ~«У меня есть другие вопросы...»~
@40367 = ~«Это все, что я хотел узнать. Прощай».~
@40368 = ~Татуировка анархиста~
@40369 = ~Шило Тильдона~
@40370 = ~Регистрационная книга приемной комнаты~
@40371 = ~Страница из регистрационного журнала~
@40372 = ~Записка от трупа #1201~
@40373 = ~Небрежная записка~
@40374 = ~Треугольная серьга~
@40375 = ~Серьга «Правило трех»~
@40376 = ~Предмет +6 к невосприимчивости~
@40377 = ~Предмет +5 к невосприимчивости~
@40378 = ~Предмет +4 к невосприимчивости~
@40379 = ~Предмет +3 к невосприимчивости~
@40380 = ~Предмет +2 к невосприимчивости~
