@8349 = ~«Думаю, я выслушал достаточно. Прощай».~
@8350 = ~«Кого именно вы оплакиваете?»~
@8351 = ~«Кого именно вы оплакиваете?»~
@8352 = ~«Кого именно вы оплакиваете?»~
@8353 = ~«Кого именно вы оплакиваете?»~
@8354 = ~«Кого именно вы оплакиваете?»~
@8355 = ~«Кого именно вы оплакиваете?»~
@8356 = ~«Неважно. У меня есть другие вопросы...»~
@8357 = ~«Думаю, я выслушал достаточно. Прощай».~
@8358 = ~«Что ты делаешь?»~
@8359 = ~«Почему ваши песнопения изменились?»~
@8360 = ~«Я оплакиваю покойника».~
@8361 = ~«У меня просьба от того, кто потерял другого».~
@8362 = ~«Я хотел бы послушать ваше пение».~
@8363 = ~«Извини за беспокойство. Прощай».~
@8364 = ~Попробовать вспомнить...~
@8365 = ~Попробовать вспомнить...~
@8366 = ~Попробовать вспомнить...~
@8367 = ~Попробовать вспомнить...~
@8368 = ~Восстановить самообладание.~
@8369 = ~Восстановить самообладание.~
@8370 = ~Снова слушать.~
@8371 = ~Оставить их — пускай себе поют.~
@8372 = ~«У меня есть вопросы к тебе...»~
@8373 = ~Оставить их — пускай себе поют.~
@8374 = ~«У меня есть вопросы к тебе...»~
@8375 = ~Оставить их — пускай себе поют.~
@8376 = ~«У меня есть вопросы к тебе...»~
@8377 = ~Оставить их — пускай себе поют.~
@8378 = ~«У меня есть вопросы к тебе...»~
@8379 = ~Оставить их — пускай себе поют.~
@8380 = ~«Ваше пение изменилось... Я слышу отличия в тоне и ритме».~
@8381 = ~«Ладно, забудь».~
@8382 = ~«У меня есть другие вопросы...»~
@8383 = ~«Может оно и так. Прощай».~
@8384 = ~«Дейонарры? Кажется, я слышал о ней. Тебе известно, как она умерла?»~
@8385 = ~«У меня есть другие вопросы...»~
@8386 = ~«Спасибо. Это все, что я желал узнать».~
@8387 = ~«Я оправился. Кому-то из тех, кого вы оплакивали до меня, помощь нужна больше, чем мне».~
@8388 = ~«У меня есть другие вопросы...»~
@8389 = ~«Спасибо. Это все, что я желал узнать».~
@8390 = ~«Она оправилась. Кому-то из тех, кого вы оплакивали до ее, помощь нужна больше, чем ей».~
@8391 = ~«У меня есть другие вопросы...»~
@8392 = ~«Спасибо. Это все, что я желал узнать».~
@8393 = ~«Э-э... Адан оправился. Кому-то из тех, кого вы оплакивали до его, помощь нужна больше, чем ему».~
@8394 = ~«У меня есть другие вопросы...»~
@8395 = ~«Спасибо. Это все, что я желал узнать».~
@8396 = ~«У меня есть другие вопросы...»~
@8397 = ~Слушать.~
@8398 = ~Уйти.~
@8399 = ~«Нет. Это не вызывает у них никаких эмоций».~
@8400 = ~«Да. Женщина, жена Ангиара, потеряла своего сына. Скорбь повисла на ней тяжелой ношей».~
@8401 = ~Ложь: «Э-э, да... мой друг, э-э... Адан... недавно потерял близкого человека. Он скорбит по умершему».~
@8402 = ~«Да, последняя смерть принесла им много страданий и боли».~
@8403 = ~«Прошу прощения... Я оговорился. Прощай».~
@8404 = ~«Если это возможно — это бы сильно облегчило мою боль».~
@8405 = ~«Нет, в этом нет нужды. Прощай».~
@8406 = ~«У меня есть другие вопросы...»~
@8407 = ~«Хорошо. Это все, что я желал знать».~
@8408 = ~«Если это возможно — это бы сильно облегчило их боль».~
@8409 = ~«Нет, в этом нет нужды. Прощай».~
@8410 = ~«У меня есть вопросы к тебе...»~
@8411 = ~Оставить их — пускай себе поют.~
@8412 = ~«Он оправился. Кому-то из тех, кого вы оплакивали до его, помощь нужна больше, чем ему».~
@8413 = ~«У меня есть другие вопросы...»~
@8414 = ~«Спасибо. Это все, что я желал узнать».~
@8415 = ~«Ты думаешь, что можешь угрожать мне безнаказанно? Дурак!» Она произносит три загадочных слова, и ты чувствуешь, как будто у тебя вырвали кусок сердца. Затем она кричит: «Стража! СТРАЖА!»~
@8416 = ~Напасть на нее.~
@8417 = ~Уйти.~
@8418 = ~«Советую тебе уйти. Ты не сочтешь драку с нашей стражей испытанием, стоящим потраченных усилий. Прочь с глаз моих».~
@8419 = ~«Я хотел бы задать тебе несколько вопросов».~
@8420 = ~«Ты ответишь на мои вопросы, иначе тебя постигнет наказание».~
@8421 = ~«Отлично. Прощай».~
@8422 = ~«Я не стану отвечать на твои вопросы, пока стража хочет от тебя другого. Это все».~
@8423 = ~«Ты ответишь на мои вопросы или заплатишь, девчонка».~
@8424 = ~«Отлично. Прощай».~
@8425 = ~«Итак. Ты вернулся просить у меня прощения, или решил продолжать заниматься своими грязными делами?»~
@8426 = ~«Я пришел убить тебя».~
@8427 = ~«Я пришел извиниться перед тобой, Саросса».~
@8428 = ~«Я пришел извиниться перед тобой, Саросса».~
@8429 = ~«Я пришел извиниться перед тобой, Саросса».~
@8430 = ~«Ни то, ни другое. Прощай... пока что».~
@8431 = ~«Как смеешь ты обращаться ко мне, послав моего брата под топор палача? Мне следовало вырвать волю из твоей души за ту боль, что ты причинил моей семье».~
@8432 = ~«Сарос был твоим братом?»~
@8433 = ~«Прости меня, Саросса. Он виновен, и никакие кровные узы этого не изменят».~
@8434 = ~«Сарос был твоим братом?»~
@8435 = ~«Прости меня, Саросса. Он виновен, и никакие кровные узы этого не изменят».~
@8436 = ~«Он был моим братом. Поступил бы ты по-другому, если бы знал, что он мне родня?»~
@8437 = ~«И он, и Тильдон виновны, хотя и в разных преступлениях. Они оба должны предстать перед законом».~
@8438 = ~«Забудь. Прощай».~
@8439 = ~Правда: «Да».~
@8440 = ~Ложь: «Да».~
@8441 = ~«Нет».~
@8442 = ~«Ведь ты в самом деле так считаешь? Я люблю своего брата, но ты верен самому себе, и я не могу винить тебя в этом».~
@8443 = ~«Хорошо. Тогда ответь на несколько вопросов, ладно?»~
@8444 = ~«В таком случае, вернешь ли ты ту часть меня, которую ты украла?»~
@8445 = ~«В таком случае, вернешь ли ты ту часть меня, которую ты украла?»~
@8446 = ~«В таком случае, вернешь ли ты ту часть меня, которую ты украла?»~
@8447 = ~Правда: «Я приношу свои извинения за то, что причинил боль тебе и твоим родным, госпожа».~
@8448 = ~Ложь: «Я приношу свои извинения за то, что причинил боль тебе и твоим родным».~
@8449 = ~«Тогда счастливо».~
@8450 = ~«Ты действительно считал, что сможешь обмануть того, кто способен читать людские сердца? Дурак». Она произносит единственное слово, которое искажает пространство вокруг тебя, вырывает частицу тебя, и уносит ее в небеса. «Сгинь, ошрамованная плоть, и больше не обращайся ко мне».~
@8451 = ~«Я вернусь. Ты за это заплатишь».~
@8452 = ~«Прощай, Саросса. Я этого не забуду».~
@8453 = ~Ее глаза удаляются, словно она видит нечто за пределами пяти твоих чувств. «Ты прощен, поскольку помнишь, что у всех твоих действий есть последствия, видишь ты их или нет, и что ты можешь причинить боль из-за своего невежества. Пусть эти слова служат тебе».~
@8454 = ~«Спасибо. Не могла бы ты ответить на некоторые мои вопросы?»~
@8455 = ~«Спасибо. Прощай».~
@8456 = ~«Он был моим братом, а теперь еще и мой отец на пороге смерти. Надеюсь, твое сердце способно вынести сознание того, что оно принесло в мир столько боли».~
@8457 = ~«Я не могу отвергать мою веру в закон в пользу отдельной личности».~
@8458 = ~«Конечно, может. Я делал это раньше, и, вполне вероятно, буду продолжать».~
@8459 = ~«Если бы я знал, что он — твой брат, я бы не впутывал его».~
@8460 = ~«Эта мысль не согревает мне сердце... но я верю, что нередко такая боль часто ведет к лучшим вещам. И хотя мы не способны увидеть пользу немедленно, мы учимся видеть добро, когда боль утихает».~
@8461 = ~«Тогда извиняйся».~
@8462 = ~Правда: «Я не имел права говорить с тобой так. Мои слова и действия были поспешными и необдуманными. Я приложу все усилия, чтобы быть поосторожнее в дальнейшем».~
@8463 = ~Ложь: «Я не имел права говорить с тобой так. Мои слова и действия были поспешными и необдуманными. Я приложу все усилия, чтобы быть поосторожнее в дальнейшем».~
@8464 = ~«Нет».~
@8465 = ~«Не лги мне, получеловек, иначе я вырву жизнь из твоего тела, — она выплевывает еще одно перекрученное слово, и ты конвульсивно вздрагиваешь, когда еще одна частичка твоей души вырывается из тебя. — А теперь иди. Я не желаю говорить с тобой».~
@8466 = ~Напасть на нее.~
@8467 = ~«Тогда прощай».~
@8468 = ~«Раз ты не сожалеешь, тогда и я не сожалею. Уходи. Сейчас же».~
@8469 = ~Напасть на нее.~
@8470 = ~«Прощай».~
@8471 = ~«Тогда извиняйся».~
@8472 = ~Правда: «Я не имел права говорить с тобой так. Мои слова и действия были поспешными и необдуманными. Я приложу все усилия, чтобы быть поосторожнее в дальнейшем».~
@8473 = ~Ложь: «Я не имел права говорить с тобой так. Мои слова и действия были поспешными и необдуманными. Я приложу все усилия, чтобы быть поосторожнее в дальнейшем».~
@8474 = ~«Нет».~
@8475 = ~«Тогда извиняйся».~
@8476 = ~Правда: «Я не имел права говорить с тобой так. Мои слова и действия были поспешными и необдуманными. Я приложу все усилия, чтобы быть поосторожнее в дальнейшем».~
@8477 = ~Ложь: «Я не имел права говорить с тобой так. Мои слова и действия были поспешными и необдуманными. Я приложу все усилия, чтобы быть поосторожнее в дальнейшем».~
@8478 = ~«Нет».~
@8479 = ~Ее рот снова издает эти слова, и ты чувствуешь, что снова обрел целостность: будто кто-то вернул частичку твоей собственной сущности. «Теперь ты свободен, получеловек. Чего ты хочешь?»~
@8480 = ~«Почему ты продолжаешь называть меня получеловеком?»~
@8481 = ~«Мне нужны ответы на несколько вопросов».~
@8482 = ~«Расскажи мне о твоей семье».~
@8483 = ~«Расскажи мне о твоей семье».~
@8484 = ~«Расскажи мне о твоей семье».~
@8485 = ~«Расскажи мне о твоей семье».~
@8486 = ~«Ведь ты никого, кроме себя, не уважаешь? Я никому не могу простить такого, неважно, насколько он может быть одарен. Прощай, получеловек. СТРАЖА!»~
@8487 = ~«Твой брат сказал, что у тебя есть особый талант».~
@8488 = ~«Ничего. Прощай».~
@8489 = ~Напасть на нее.~
@8490 = ~Уйти.~
@8491 = ~«Я называю тебя получеловеком, потому что не могу увидеть твою душу. Все остальные смертные, встречавшиеся в моей жизни, показывали мне свою душу — как сияющую искру, либо как тлеющие угли. Ты не показываешь вообще ничего. Я зову тебя получеловеком, потому что не вижу твою душу, как вижу ее у других. То ли у тебя нет души, то ли ты вышел за пределы себя — точно я сказать не могу. Так или иначе, ты человек лишь наполовину. Какова вторая половина, я не берусь утверждать».~
@8492 = ~«Понятно. Тогда ответь мне на несколько вопросов».~
@8493 = ~«Понятно. Прощай».~
@8494 = ~«Какие ответы тебе нужны, получеловек?»~
@8495 = ~«Почему ты зовешь меня получеловеком?»~
@8496 = ~«Мне необходимо поговорить с тобой насчет твоего отца».~
@8497 = ~«Кто ты?»~
@8498 = ~«Расскажи мне о твоей семье».~
@8499 = ~«Расскажи мне о твоей семье».~
@8500 = ~«Расскажи мне о твоей семье».~
@8501 = ~«Расскажи мне о твоей семье».~
@8502 = ~«У всех есть особые таланты. Расскажи мне о своих».~
@8503 = ~«Ничего. Прощай».~
@8504 = ~«Мой брат Сарос — дитя Литейной, и все же я боюсь, что он никогда не принимал философию верящих в Первопричину. Мой отец здесь фрактор, и его путешествия увели его далеко от Литейной, в миры, о достижении которых большинство смертных даже не мечтают».~
@8505 = ~«Расскажи мне больше о твоем брате».~
@8506 = ~«Расскажи мне больше о твоем отце».~
@8507 = ~«Расскажи мне больше о твоем отце».~
@8508 = ~«Расскажи мне больше о твоем отце».~
@8509 = ~«Понятно. Ответишь на другие вопросы?»~
@8510 = ~«Спасибо. Прощай».~
@8511 = ~Нотка горечи закрадывается в ее голос. «Мой брат, как ты знаешь, ждет казни. Мой отец, насколько ты можешь или не можешь знать, путешествует по всей мультивселенной в поисках вещей, которые большинство смертных пока еще не способны объять».~
@8512 = ~«Расскажи мне больше о твоем брате».~
@8513 = ~«Расскажи мне больше о твоем отце».~
@8514 = ~«Расскажи мне больше о твоем отце».~
@8515 = ~«Расскажи мне больше о твоем отце».~
@8516 = ~«Понятно. Ответишь на другие вопросы?»~
@8517 = ~«Мой брат Сарос, надеюсь, вполне благоразумный парень для своего возраста, а мой отец здесь фрактор. Он человек, чьи путешествия увели его далеко от Литейной, в миры, о достижении которых большинство смертных даже не мечтают».~
@8518 = ~«Расскажи мне больше о твоем брате».~
@8519 = ~«Расскажи мне больше о твоем отце».~
@8520 = ~«Расскажи мне больше о твоем отце».~
@8521 = ~«Расскажи мне больше о твоем отце».~
@8522 = ~«Понятно. Ответишь на другие вопросы?»~
@8523 = ~«Спасибо. Прощай».~
@8524 = ~«Я не знаю, как получила его. Похоже, это нечто, всегда бывшее частью меня. Я могу лишь предположить, что мои предыдущие жизни и мои убеждения дали мне особую проницательность по отношению к природе смертных. Я одарена способностью видеть возможности в каждом живом существе. Читая истинное имя, высеченное на самой сущности смертного, и произнося его слегка неправильно, я способна менять природу этой возможности, и тем самым менять сущность его владельца».~
@8525 = ~«Ты можешь научить меня этому?»~
@8526 = ~«Ты можешь изменить меня?»~
@8527 = ~«Интересно. Ответь мне еще на несколько вопросов».~
@8528 = ~«Вселенная действует странными методами. Прощай».~
@8529 = ~«Сарос — дерзкий, импульсивный парень, легко поддающийся на провокацию. Он жаждет показать себя равным чему угодно в планах, и полон юношеской агрессии. Думаю, он ощущает себя скорее чувствующим, чем богочеловеком, что в очередной раз подтверждает мое мнение о том, что чувствующие — самая незрелая из всех фракций в Сигиле».~
@8530 = ~«Почему это они самые незрелые?»~
@8531 = ~«Расскажи о своем отце».~
@8532 = ~«Расскажи о своем отце».~
@8533 = ~«Расскажи о своем отце».~
@8534 = ~«Ты можешь ответить на мои вопросы?»~
@8535 = ~«Благодарю... и прощай».~
@8536 = ~«Мой отец — фрактор верящих в Первопричину; всю свою жизнь он твердо верил, что мы существуем для определенной цели. Я могу лишь надеяться, что он все еще твердо придерживается этого убеждения, равно как и веры в то, что его дети любят его».~
@8537 = ~«Тогда я передам ему твои надежды. Можешь ли ты ответить мне еще на несколько вопросов?»~
@8538 = ~«Похоже, он неплохой человек. Ответь мне еще на несколько вопросов, ладно?»~
@8539 = ~«Похоже, он неплохой человек. Прощай».~
@8540 = ~«Тогда я передам ему твои надежды. Прощай».~
@8541 = ~«Благодаря твоим словам, мой отец Сандоз жив и здоров. Я могу лишь надеяться, что какая бы сила его так не ранила (не могу поверить, что он дошел до этого сам), она заплатит за свои злодеяния. Что еще я могу для тебя сделать?»~
@8542 = ~«Ответь мне на другие вопросы».~
@8543 = ~«Ничего. Прощай».~
@8544 = ~«Мой отец мертв».~
@8545 = ~«Извини. Можешь ответить на пару вопросов?»~
@8546 = ~«Ррр.. ладно. Прощай».~
@8547 = ~«Я не буду этого делать. Он всегда был импульсивным, жаждущим доказать свою отвагу перед этой жестокой вселенной, и теперь он не может этого сделать. Я никого здесь не виню, но говорить об этом не стану. Если хочешь знать больше, поговори со мной позже. Прощай».~
@8548 = ~«Прощай».~
@8549 = ~«Я могу изменить тебя, но не могу обучить тебя. Это все равно как рассказывать слепому о цвете, или глухому — о звуке. И я *изменю* тебя, если цена будет соответствующей».~
@8550 = ~«Какова цена?»~
@8551 = ~«Я думаю, что это не очень честно».~
@8552 = ~«Забудь об этом. Ответь мне на пару других вопросов».~
@8553 = ~«Какова цена?»~
@8554 = ~«Почему они самые незрелые? Да потому что они, слово дети, не понимают, что существует нечто большее за пределами мира чувств, за тем, что можно увидеть, услышать, попробовать или понюхать. Оглянись. Ты во Внешних планах. Это материализованная вера — но это не значит, что эта на вид грубая материя может быть постигнута чувствами. Это вера — простой физикой ее не объяснить».~
@8555 = ~«Ясно. Поговорим о других вещах».~
@8556 = ~«Понятно. Прощай».~
@8557 = ~«Скажи мне: ты разделяешь философию боголюдей?»~
@8558 = ~Правда: «Да».~
@8559 = ~Ложь: «Да».~
@8560 = ~«Нет».~
@8561 = ~«Я знаю недостаточно, чтобы ответить тебе».~
@8562 = ~«Да, это нечестно. Но это мой дар, это мои испытания, и я сама выбираю, что делать с моими дарами. Чем я могу тебе помочь?»~
@8563 = ~«Ответь на несколько вопросов».~
@8564 = ~«Ты не можешь, по крайней мере, пока. Прощай».~
@8565 = ~«Тогда я без сомнений поделюсь с тобой своим даром». Она произносит загадочное слово, которое потрясает тебя до самого основания, и по какой-то причине твое тело ощущает себя более сильным.~
@8566 = ~«Как ты это сделала?»~
@8567 = ~«Спасибо большое! Ты можешь ответить на мои вопросы?»~
@8568 = ~«Благодарю. Прощай».~
@8569 = ~«Тебе не нравится эта философия? Почему же?»~
@8570 = ~«Потому что я уже присоединился к тленным».~
@8571 = ~«Потому что я уже присоединился к чувствующим».~
@8572 = ~«Потому что я уже присоединился к анархистам».~
@8573 = ~«Я думаю, это даже хуже, чем у тленных. Они, по крайней мере, не поучают — просто принимают и двигаются дальше».~
@8574 = ~«Я все еще думаю об этом. Убеди меня».~
@8575 = ~«Узнай о нас больше. Присоединись к фракции до конца. Если ты еще не сделал этого, сходи поговори с Кельдором Дурианским. Он — фрактор по части вербовки. Ты можешь найти его здесь, в Большом Зале. Прощай».~
@8576 = ~«Прощай».~
@8577 = ~«Тогда я не буду пытаться переубедить тебя. Что еще я могу для тебя сделать?»~
@8578 = ~«Ответь на пару вопросов».~
@8579 = ~«Ничего. Прощай».~
@8580 = ~Ты видишь девушку. Когда ты подходишь к ней, она смотрит тебе прямо в глаза. Тебе становится неуютно от ощущения, что она не просто проверяет цвет твоих глаз — ее взгляд, похоже, проникает намного глубже. «Приветствую, незнакомец. Как проходит твой день?»~
@8581 = ~«Вполне неплохо. Я хотел бы задать тебе несколько вопросов».~
@8582 = ~«Ты Саросса? Мне нужно поговорить с тобой о твоем отце».~
@8583 = ~«Вполне неплохо. Прощай».~
@8584 = ~«Приветствую, израненный человек. Чего ты от меня хочешь?»~
@8585 = ~«Ответы».~
@8586 = ~«Мне необходимо поговорить с тобой насчет твоего отца».~
@8587 = ~«Ничего. Прощай».~
@8588 = ~«Я Саросса, дочь Сандоза, одного из фракторов боголюдей».~
@8589 = ~«Ответь мне на другие вопросы».~
@8590 = ~«Мне необходимо поговорить с тобой насчет твоего отца».~
@8591 = ~«Ясно. Спасибо тебе. Прощай».~
@8592 = ~«А что с ним?»~
@8593 = ~«Он закрылся в своей башне и угрожает покончить с собой. Что ты можешь рассказать мне о нем, что позволило бы мне удержать его от этого поступка?»~
@8594 = ~«Ты лжешь! Мой отец путешествует! Он не вернется по крайней мере в ближайшие дни!»~
@8595 = ~«И тем не менее. Поговори с Кельдором, если не веришь мне. Я требую твоей поддержки, если хочешь видеть своего отца в живых».~
@8596 = ~«Ты мне не веришь? Отлично. Это будет на твоей совести. Прощай».~
@8597 = ~«Конечно, в этом можешь не сомневаться, — она замолкает и очень пристально смотрит на тебя. — Ты ведь говоришь правду? В твоем сердце я не вижу обмана по этому поводу. Отлично. Вот что я хочу, чтобы ты сказал моему отцу: Вся жизнь — это испытание. Никто не может проскочить напрямую к его завершению. Такого ответа нет. Только Хранители Рока и тленные верят в полное разрушение — и за это ты всегда их презирал. Вспомни об этом».~
@8598 = ~«Я передам это послание. Но сперва я хотел бы задать тебе пару вопросов».~
@8599 = ~«Я передам это послание. Прощай».~
@8600 = ~«Как смеешь ты обращаться ко мне, послав моего брата под топор палача? Мне следовало вырвать волю из твоей души за ту боль, что ты причинил моей семье».~
@8601 = ~«Сарос был твоим братом?»~
@8602 = ~«Прости меня, Саросса. Он виновен, и никакие кровные узы этого не изменят».~
@8603 = ~«Сарос был твоим братом?»~
@8604 = ~«Прости меня, Саросса. Он виновен, и никакие кровные узы этого не изменят».~
@8605 = ~«И он, и Тильдон виновны, хотя и в разных преступлениях. Они оба должны предстать перед законом».~
@8606 = ~«Я не могу. Прощай».~
@8607 = ~Толпа черепов~
@8608 = ~Чувствительное прикосновение~
@8609 = ~История костей~
@8610 = ~Чувствительность к искажениям~
@8611 = ~Цветной шар~
@8612 = ~Броня~
@8613 = ~Малое бальзамирование~
@8614 = ~Железный кулак~
@8615 = ~Опознание~
@8616 = ~Запугивание~
@8617 = ~Магический снаряд~
@8618 = ~Усмиритель~
@8619 = ~Защита от зла~
@8620 = ~Захват~
@8621 = ~Щит~
@8622 = ~Жгучее прикосновение~
@8623 = ~Снаряд терпения~
@8624 = ~Поцелуй гадюки~
@8625 = ~Проклятие черных шипов~
@8626 = ~Щит из черных шипов~
@8627 = ~Мост крови~
@8628 = ~Великое бальзамирование~
@8629 = ~Громогласное эхо~
@8630 = ~Ледяной нож~
@8631 = ~Гнев~
@8632 = ~Зеркало боли~
@8633 = ~Луч ослабления~
@8634 = ~Сила~
@8635 = ~Проклятье роя~
@8636 = ~Шаровая молния~
@8637 = ~Полосы Сиреллина~
@8638 = ~Смущение~
@8639 = ~Мантия защиты~
@8640 = ~Слезы Элизиума~
@8641 = ~Призрачная броня~
@8642 = ~Удержание нежити~
@8643 = ~Невыносимая насмешка Таши~
@8644 = ~Вампирическое касание~
@8645 = ~Секира мучений~
@8646 = ~Черная сфера~
@8647 = ~Замешательство~
@8648 = ~Отчаяние~
@8649 = ~Удар пламенем~
@8650 = ~Силовые снаряды~
@8651 = ~Улучшенная сила~
@8652 = ~Улучшенное вампирическое касание~
@8653 = ~Саван теней~
@8654 = ~Облако-убийца~
@8655 = ~Конус холода~
@8656 = ~Аура страха~
@8657 = ~Удвоение Энолла Эва~
@8658 = ~Антимагическая оболочка~
@8659 = ~Сфера неуязвимости~
@8660 = ~Вой Пандемониума~
@8661 = ~Кислотная буря~
@8662 = ~Буря клинков~
@8663 = ~Пламя и лед~
@8664 = ~Мантия опеки~
@8665 = ~Ветреная буря~
@8666 = ~Этот гит поворачивается к тебе, когда ты подходишь. Его глаза — словно два уголька; они быстро пробегают по тебе, затем встречаются с твоими глазами. Хотя он и похож на человека, у него кожа желтоватого оттенка и худощавое лицо. У него щуплое угловатое тело; его конечности выглядят так, будто они сделаны из одних лишь жил, натянутых на кости. Его одежда — причудливая смесь пестрых цветов и грязных глухих оттенков коричневого.~
@8667 = ~Взгляд гита встречается с твоим. Его трудно понять из-за акцента: он будто берет каждое слово, выплевывает его, а потом еще и протягивает каждую гласную. Если ты правильно его понял, он сказал: «И путнику рады».~
@8668 = ~Взгляд гита встречается с твоим. Его трудно понять из-за акцента: он будто берет каждое слово, выплевывает его, а потом еще и протягивает каждую гласную. Если ты правильно его понял, он сказал: «Ты *неизвестен* мне». Он делает странное ударение на слове *неизвестен*.~
@8669 = ~Каменное лицо гита немного расслабляется, вызов в его взгляде сменяется любопытством. «Ты *неизвестен* мне, — его взгляд пробегает по тебе, еще раз оценивая. — Я выслушаю тебя».~
@8670 = ~Этот гит поворачивается к тебе, когда ты подходишь. Как и у Даккона, у него кожа желтоватого оттенка и худощавое телосложение. Его одежда — причудливая смесь пестрых цветов и глухих оттенков грязно-коричневого. Черные как смоль глаза гита пробегаются сначала по Даккону, потом по тебе.~
@8671 = ~Мужчина не обращает на тебя внимание и вместо этого обращается к Даккону. Он произносит несколько отрывистых слов на грубом языке, которого ты не понимаешь. При этом выражение его лица не меняется, он не делает никаких жестов, так что ты не можешь даже предположить, что он говорит. Даккон отвечает вереницей слов на том же языке, и гитцерай замолкает.~
@8672 = ~Когда ты говоришь, гитцерай поворачивается к тебе, потом к Даккону и снова что-то говорит, на этот раз дольше. Даккон отвечает; кажется, эта все та же вереница слов, что и раньше. Гитцерай снова умолкает. Даккон что-то добавляет, и гитцерай отвечает еще одним длинным потоком слов.~
@8673 = ~Пустой узел.~
@8674 = ~«Твои слова *известны* мне, — перебивает гитцерай. — Обернись ко мне и говори прямо. Я выслушаю тебя».~
@8675 = ~Гитцерай игнорирует тебя и вместо этого поворачивается к Даккону. Он произносит несколько отрывистых слов на грубом языке. Если ты все правильно понял, он сказал: «Мое почтение, *зерт*».~
@8676 = ~Когда ты говоришь, гитцерай поворачивается к тебе, потом к Даккону и что-то говорит, на этот раз дольше.~
@8677 = ~Ты с трудом разбираешь структуру предложений, но, кажется, он сказал: «Есть некто по имени Даккон, не принадлежащий к Народу. Говорят, его разум рассеян. Говорят, что он *зерт*, *не знающий* слов Зертимона».~
@8678 = ~Ответ гита столь стремителен, что за ним практически стоит оскорбление. Ты не уверен, что точно уловил смысл, но похоже на то, что гит бросил Даккону своего рода вызов в виде вопроса: «*Зерт*, ты *подчиняешься* командам этого человека?»~
@8679 = ~Некоторое время гит молчит. «От этого дела несет иллитидами, — его взгляд пробегает по лицу Даккона. — Я не вижу на тебе цепей. Отвечай, как могло произойти это кощунство?»~
@8680 = ~Гит не смотрит на тебя. Его внимание сосредоточено на Дакконе. «Он может говорить. Я выслушаю его».~
@8681 = ~Гит поворачивается к тебе и смотрит тебе в глаза. Даккон продолжает смотреть на гита.~
@8682 = ~Клинок гита исчезает, он отступает назад. Даккон опускает свой клинок. Гит шипит на Даккона: «Око Вилькара не столь остро, сердце Селканта не так черно. Это не будет забыто». Похоже, он собирается уйти.~
@8683 = ~Гит обращается к Даккону. «Слова этого человека — яд для моих ушей. Должен ли я его слушать?» ~
@8684 = ~На долю секунды кажется, что гит тебя не расслышал. Затем раздается свист стали, и в руках гита появляется клинок. В тот же миг Даккон достает свой клинок. Похоже, что он намерен напасть на гита, если он двинется к тебе.~
@8685 = ~Несмотря на то, что клинок Даккона наготове, гит не спускает с тебя глаз. Похоже, его следующий вопрос адресован Даккону. «Твой разум рассеян по этому поводу?»~
@8686 = ~«В этом деле слышны отголоски иллитидов, *зерт*. Ради него ты обнажил свой клинок против одного из Народа. Во имя Зертимона, я не могу допустить такого оскорбления твоему духу и оставить его слова, не пролив его крови».~
@8687 = ~Гит поворачивается к тебе, но его внимание приковано к Даккону. «Как могло произойти такое кощунство, *зерт*?»~
@8688 = ~Гит ждет. Кажется, его терзают мучения.~
@8689 = ~Этот гит поворачивается к тебе, когда ты подходишь. Его глаза — словно два уголька; они быстро пробегают по тебе, затем встречаются с твоими глазами. Хотя он и похож на человека, у него кожа желтоватого оттенка и худощавое лицо. У него щуплое угловатое тело; его конечности выглядят так, будто они сделаны из одних лишь жил, натянутых на кости. Его одежда — причудливая смесь пестрых цветов и грязных глухих оттенков коричневого.~
@8690 = ~Раздается свист стали, и в руке гитцерая появляется клинок. «Ты *известен* мне. Ты напал на одного из Народа. Я позволю этим камням сполна напиться твоей кровью». ~
@8691 = ~Гит мешкает. «Ошибки быть не может. Описание подходит: человеческий мужчина в шрамах». ~
@8692 = ~Лоб гита хмурится, ни через несколько мгновений он опускает клинок. «Прости меня. Впредь я буду более осторожен со словами». Похоже, он все еще испытывает подозрение.~
@8693 = ~Гит мешкает. «Ошибки быть не может. Описание подходит: человеческий мужчина в шрамах, — он бросает взгляд на Даккона. — Ты заступишься за этого человека, *зерт*?»~
@8694 = ~Даккон говорит медленно, как будто хочет успокоить гита. «Его слова — не учение Вождей. Его грубость ненамеренная».~
@8695 = ~«Для меня в его словах звучит правдивость и авторитет Вождей. Моему разуму не... дозволено рассеиваться по этому поводу».~
@8696 = ~«Не нападай. Мне нельзя ослушаться».~
@8697 = ~Даккон снова говорит медленно. «Мой выбор — Выбор Тча». Когда он произносит это, его кожа принимает пепельный оттенок... кажется, будто каждое слово медленно убивает его. «Это мои собственные оковы. Вождям сотни лет, но нет часов, способных измерить этот рассказ. Эта вещь запутана, как корни Фрихиса, и распутать ее почти невозможно, — Даккон мрачнеет. — Не нападай, иначе я могу стать братоубийцей».~
@8698 = ~Даккон отвечает на том же языке. Структура у предложения довольно странная. Тебе кажется, что Даккон сказал: «Этот принадлежит к числу честных».~
@8699 = ~Ответ Даккона тот же, что и раньше; тон немного изменился, но смысл остался прежним. «Этот принадлежит к числу честных». Даккон умолкает, как бы давая словам время впитаться. «Говорит тот, что возле меня. Ты выслушаешь его?»~
@8700 = ~Ответ Даккона краток, но произносится медленно, как будто ему приходится вытаскивать каждое слово из горла. «Выбор Тча стал моим».~
@8701 = ~Даккон снова говорит медленно. «Это мои собственные оковы». Когда он произносит это, его кожа, казалось бы, принимает пепельный оттенок... кажется, будто каждое слово медленно убивает его. «Вождям сотни лет, но нет часов, способных измерить этот рассказ. Эта вещь запутана, как корни Фрихиса, и распутать ее почти невозможно, — Даккон мрачнеет, его голос усиливается. — Говорит тот, что возле меня. Ты выслушаешь его?»~
@8702 = ~Даккон поворачивается к тебе «Он выслушает тебя».~
@8703 = ~Даккон кивает, но настолько медленно, будто это причиняет ему боль. «Ты... ошибся. Этот человек не убивал никого из Народа».~
@8704 = ~Даккон поворачивается к гитцераю и что-то говорит, на этот раз более размеренно и осторожно. Гитцерай отвечает кратко.~
@8705 = ~«Я сказал, 'приветствую'».~
@8706 = ~«Я сказал, 'приветствую'».~
@8707 = ~«Я сказал, 'приветствую'».~
@8708 = ~«Я сказал, 'приветствую'».~
@8709 = ~«Я сказал, 'приветствую'».~
@8710 = ~«Я сказал, 'приветствую'».~
@8711 = ~«У меня есть несколько вопросов...» ~
@8712 = ~«У меня есть несколько вопросов...» ~
@8713 = ~«У меня есть несколько вопросов...» ~
@8714 = ~«У меня есть несколько вопросов...» ~
@8715 = ~«У меня есть несколько вопросов...» ~
@8716 = ~«У меня есть несколько вопросов...» ~
@8717 = ~«Неважно. Извини за беспокойство».~
@8718 = ~«Ну хорошо...»~
@8719 = ~«Ты гитьянки, верно? У меня к тебе несколько вопросов...»~
@8720 = ~«Я сказал, 'приветствую'».~
@8721 = ~«Ты меня понимаешь?»~
@8722 = ~«У меня есть несколько вопросов...» ~
@8723 = ~«Неважно. Прощай».~
@8724 = ~«У меня есть к тебе вопросы...»~
@8725 = ~«Неважно. Прощай».~
@8726 = ~Не дать ему пройти.~
@8727 = ~Пусть уходит.~
@8728 = ~«Ты не мог бы сперва ответить на несколько вопросов?»~
@8729 = ~«Нет. Сперва ответь на пару вопросов».~
@8730 = ~«Я не отступлю. Советую тебе спрятать свой свинокол, пока я не воткнул его в тебя».~
@8731 = ~Напасть на него первым.~
@8732 = ~Отойти в сторону и позволить ему пройти.~
@8733 = ~«У меня всего лишь несколько вопросов».~
@8734 = ~«Тогда для начала ответь мне на пару вопросов».~
@8735 = ~«Я не отступлю. Советую тебе спрятать свой свинокол, пока я не воткнул его в тебя».~
@8736 = ~Напасть на него первым.~
@8737 = ~«Готовься к смерти...»~
@8738 = ~Не отвечать.~
@8739 = ~Попробовать вспомнить перевод...~
@8740 = ~Попробовать вспомнить перевод...~
@8741 = ~«Прости?»~
@8742 = ~«Пока больше ничего. Прощай».~
@8743 = ~«Чем я занимаюсь? Я инженер из инженеров. Я учился у кузнеца-танарри Казана, который нагревал слова в горне ненависти, закалял их в желобе отчаяния, и посылал их на истребление глупости. Ему доносились обрывки фраз, меткие слова, и он создавал оружие ужасающей мощи — оружие, которое могло унизить врага и разрушить чужие убеждения. Уверен, ты видел его работу».~
@8744 = ~«Э... это значит, что ты меня выслушаешь?»~
@8745 = ~«Хорошо. Ты выслушаешь меня?»~
@8746 = ~Оставить его в покое.~
@8747 = ~«Вовсе нет! Моя кузница построена не на ненависти, а на понимании. Я также учился у мастера-архона Терасафирея, который создал исцеляющее прикосновение спокойной мысли, идеи, которая успокоит любое шипящее бесовское сердце. Он достигал своих целей с помощью любви и преданности. Они сочетаются в моей работе, как в душах всех смертных сочетается демоническое и возвышенное».~
@8748 = ~«Каждое решение, каждое действие, каждое противодействие — все это закладывает фундамент, на котором строится что-нибудь другое. В таком случае, становится очевидным, что наш текущий высокий уровень бытия закладывает нам фундамент для чего-то большего. Что же это, как не божественность? Именно так я всегда это объяснял, и, откровенно говоря, я не настроен на философские дискуссии. Если хочешь подискутировать, найди фрактора, или еще кого-нибудь».~
@8749 = ~«Посмотрим. Ты меня выслушаешь?»~
@8750 = ~Оставить его в покое.~
@8751 = ~«Я ищу кое-кого по имени Фарод. Знаешь такого?»~
@8752 = ~«Я потерял дневник. Тебе он не попадался?»~
@8753 = ~«Ты можешь рассказать мне о Дакконе?»~
@8754 = ~«Тебе известен гитцерай по имени Даккон?»~
@8755 = ~«Ты можешь рассказать мне про этот город?»~
@8756 = ~«Так ты здесь создаешь оружие зла?»~
@8757 = ~«Что ты можешь рассказать о Сигиле?»~
@8758 = ~«Уверен, что видел. Ответь мне на пару вопросов».~
@8759 = ~«Должно быть, да. Прощай».~
@8760 = ~«У меня есть несколько... конкретных... вопросов об этом городе».~
@8761 = ~«Твои коллеги столь же искусны, как и ты?»~
@8762 = ~«Просто восхитительно! Можно задать тебе еще пару вопросов?»~
@8763 = ~Оставить его в покое.~
@8764 = ~«Я должен об этом поразмыслить. Прощай».~
@8765 = ~«Где мне найти фрактора?»~
@8766 = ~«Понятно. Ответь мне еще на несколько вопросов, ладно?»~
@8767 = ~«Понятно. Прощай».~
@8768 = ~«У меня есть другие вопросы...»~
@8769 = ~«У меня есть другие... конкретные... вопросы...»~
@8770 = ~Оставить его в покое.~
@8771 = ~«У меня есть другие вопросы...»~
@8772 = ~«У меня есть другие... конкретные... вопросы...»~
@8773 = ~Оставить его в покое.~
@8774 = ~Попробовать вспомнить перевод...~
@8775 = ~Попробовать вспомнить перевод...~
@8776 = ~«Прости?»~
@8777 = ~«Э... то есть, ты ответишь на вопрос, или?..»~
@8778 = ~«Тогда я уточню: ты можешь рассказать мне о Леди Боли?»~
@8779 = ~«Тогда я уточню: ты можешь рассказать мне что-нибудь о фракциях?»~
@8780 = ~«Тогда я уточню: ты можешь сказать мне, где расположен этот город?»~
@8781 = ~«Тогда я уточню: ты можешь подсказать, где здесь можно найти работу?»~
@8782 = ~«Тогда я уточню: ты можешь рассказать, что интересного в округе?»~
@8783 = ~«Неважно. Извини, что побеспокоил тебя».~
@8784 = ~«Тогда я уточню: ты можешь рассказать мне о Леди Боли?»~
@8785 = ~«Тогда я уточню: ты можешь рассказать мне что-нибудь о фракциях?»~
@8786 = ~«Тогда я уточню: ты можешь сказать мне, где расположен этот город?»~
@8787 = ~«Тогда я уточню: ты можешь подсказать, где здесь можно найти работу?»~
@8788 = ~«Тогда я уточню: ты можешь рассказать, что интересного в округе?»~
@8789 = ~«Неважно. Извини, что побеспокоил тебя».~
@8790 = ~«Я ищу кое-кого по имени Фарод. Знаешь такого?»~
@8791 = ~«Я потерял дневник. Тебе он не попадался?»~
@8792 = ~«Ты можешь рассказать мне о Дакконе?»~
@8793 = ~«Тебе известен гитцерай по имени Даккон?»~
@8794 = ~«Что ты можешь сказать о Леди Боли?»~
@8795 = ~«Ты можешь рассказать что-нибудь о фракциях?»~
@8796 = ~«Ты можешь сказать мне, где расположен этот город?»~
@8797 = ~«Ты можешь подсказать, где здесь можно найти работу?»~
@8798 = ~«Ты можешь рассказать, что интересного в округе?»~
@8799 = ~«Вопросов больше нет. Прощай».~
@8800 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8801 = ~«У меня есть другие... конкретные... вопросы о городе...»~
@8802 = ~Метеорная бомбардировка~
@8803 = ~Стрела смерти~
