@24750 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@24751 = ~«Анна, я просто хочу задать Феллу несколько вопросов. И мы тут же уберемся».~
@24752 = ~«Понятно. Хорошо, тогда уйдем».~
@24753 = ~«'Ее'?»~
@24754 = ~«'Ее'? Ты имеешь в виду Леди Боли?»~
@24755 = ~«Анна, я просто хочу задать Феллу несколько вопросов. И мы тут же уберемся».~
@24756 = ~«Понятно. Хорошо, тогда уйдем».~
@24757 = ~«Сперва я бы хотел поговорить с Феллом».~
@24758 = ~«Хорошо, идем».~
@24759 = ~«Сперва я бы хотел поговорить с Феллом».~
@24760 = ~«Понятно. Хорошо, тогда уйдем».~
@24761 = ~«*Спокойно*... ничего не случится. А теперь я поговорю с Феллом, и хочу, чтобы ты помолчала».~
@24762 = ~Обещание: «Анна, пока я здесь, тебе ничто не угрожает — я обещаю. Я просто хочу немного с ним поговорить».~
@24763 = ~Ложь, чтобы утихомирить ее: «Анна, пока я здесь, тебе ничто не угрожает — я обещаю. Я просто хочу немного с ним поговорить».~
@24764 = ~«Хорошо, хорошо. Мы уходим».~
@24765 = ~«Хорошо».~
@24766 = ~«Хорошо».~
@24767 = ~«А хочешь?»~
@24768 = ~«А хочешь?»~
@24769 = ~«Тогда сделай это».~
@24770 = ~«Тогда сделай это».~
@24771 = ~«Неважно. Идем отсюда».~
@24772 = ~«Понятно. Тогда попробую поговорить с ним сам...»~
@24773 = ~«Хорошо. Уходим».~
@24774 = ~«Спроси его, кто он такой».~
@24775 = ~«Спроси его, кто он такой».~
@24776 = ~«Спроси его, кто он такой».~
@24777 = ~«Спроси его, что это за место».~
@24778 = ~«Спроси его, что это за место».~
@24779 = ~«Спроси его, что это за место».~
@24780 = ~«Мне кажется, я знаю тебя, Фелл».~
@24781 = ~«Мне кажется, я знаю тебя, Фелл».~
@24782 = ~«Мне кажется, я знаю тебя, Фелл».~
@24783 = ~«Мне кажется, я знаю тебя, Фелл».~
