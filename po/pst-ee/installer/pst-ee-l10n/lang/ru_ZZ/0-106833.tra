@59159 = ~К северо-восточной части Улья~
@59160 = ~К юго-западной части Улья~
@59161 = ~Ночлежка~
@59162 = ~К северо-западной части Улья~
@59163 = ~Берлога Могильника~
@59164 = ~Лачуга повитухи~
@59165 = ~К Мусорным районам~
@59166 = ~Проход, забитый мусором~
@59167 = ~Даккон поворачивается к тебе, его глаза — словно полированный уголь. Его клинок мерцает, металл переливается, словно масляная пленка на пруду. Когда Даккон начинает говорить, голос у него ровный и сильный... в нем нет той хрипоты, которую ты слышал раньше. «Какова твоя воля?»~ [DAK205]
@59168 = ~«Даккон, я хотел бы *узнать* кое-что еще...»~
@59169 = ~«На этот раз ничего, Даккон. Идем».~
@59170 = ~Даккон поворачивается к тебе, его глаза похожи на полированный уголь. Когда ты обращаешься к нему, его клинок становится похожим на его глаза, затем он кивает. «Какова твоя воля?»~ [DAK205]
@59171 = ~«Даккон, я хотел бы *узнать* кое-что еще...»~
@59172 = ~«На этот раз ничего, Даккон. Идем».~
@59173 = ~Даккон медленно поворачивается к тебе, его глаза — словно два абсолютно черных камешка. Его лицо серое как пепел, а его клинок цвета засохшей крови. Когда он начинает говорит, он кажется *старым*... и сломленным. «Какова твоя воля?»~ [DAK205]
@59174 = ~«Даккон, я хотел бы *узнать* кое-что еще...»~
@59175 = ~«На этот раз ничего, Даккон. Идем».~
@59176 = ~«Я слушаю тебя».~
@59177 = ~«Твое лицо... незнакомо мне. Кто ты?»~
@59178 = ~«У меня есть несколько вопросов о гитцераях...»~
@59179 = ~«Я хотел спросить тебя о нашем путешествии...»~
@59180 = ~«Мы можем поговорить о твоих учениях?»~
@59181 = ~«Даккон... Равель назвала тебя рабом. Что она имела в виду?»~
@59182 = ~«Даккон, что такое Шракатлор?»~
@59183 = ~«Даккон, расскажи мне еще раз, как я спас тебя при Шракатлоре».~
@59184 = ~«Даккон, ты сказал, что это *я* тебе дал Круг Зертимона?»~
@59185 = ~«Расскажи мне о другом моем 'я'... о воплощении, с которым ты был знаком. Каким он был?»~
@59186 = ~«Каким образом ты оказался у меня в долгу, Даккон?»~
@59187 = ~«Неважно, Даккон. Идем».~
@59188 = ~«Гитцерай».~
@59189 = ~«Гитцерай?»~
@59190 = ~«Я хотел бы *узнать* кое-что еще...»~
@59191 = ~«Понятно. Идем».~
@59192 = ~«Гитцерай — один из Народа».~
@59193 = ~«Один из народа?»~
@59194 = ~«Я хотел бы *узнать* кое-что еще...»~
@59195 = ~«Понятно. Идем».~
@59196 = ~«Гитцерай».~
@59197 = ~«Ну да, но кто они такие, эти гитцераи?»~
@59198 = ~«А... хорошо. Я хотел бы *узнать* кое-что еще...»~
@59199 = ~«Понятно. Идем».~
@59200 = ~Даккон на мгновение умолкает, затем произносит: «Нет необходимости делать нашу историю *известной* тебе. Мы истечем кровью на клинке времени, прежде чем я изложу хоть часть историй нашего Народа».~
@59201 = ~«Да не нужны мне ваши истории... я хочу знать, что представляет из себя ваш народ на данный момент».~
@59202 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59203 = ~«Я хотел бы *узнать* кое-что еще...»~
@59204 = ~«Понятно. Идем».~
@59205 = ~Даккон на секунду умолкает. «*Узнай* это и прими в качестве ответа: Мы — Народ, создавший свой дом в переменчивом плане Лимбо». Ловким движением Даккон выхватывает клинок из-за спины и удерживает его перед собой.~
@59206 = ~Посмотреть, что произойдет.~
@59207 = ~«Неважно. У меня есть еще несколько вопросов о гитцераях...»~
@59208 = ~«Вообще-то, я хотел бы *узнать* кое-что еще...»~
@59209 = ~«Хорошо, Даккон. Идем».~
@59210 = ~«Там мы формируем материю Лимбо своим разумом. Мы выковываем города одной лишь мыслью». У тебя на глазах от центра к краям по поверхности клинка проходят несколько волн. Длина и высота волн в точности повторяют интонацию голоса Даккона. «Мы живем в хаосе, и только наше *знание* спасает нас. Мы — гитцераи».~
@59211 = ~«Как удивительный у тебя клинок... он двигался и менялся в ответ на твой голос».~
@59212 = ~«Неважно. У меня есть еще несколько вопросов о гитцераях...»~
@59213 = ~«Понятно. Я хотел бы *узнать* кое-что еще...»~
@59214 = ~«Понятно. Идем».~
@59215 = ~«Он *известен* под именем 'Сигил'. Среди Народа он *известен* как город, который *не знает* себя».~
@59216 = ~«Не знает себя? О чем это ты?»~
@59217 = ~«Я хотел бы *узнать* кое-что еще...»~
@59218 = ~«Понятно. Идем».~
@59219 = ~«Город существует, но *не знает* себя. Существование того, кто *не знает* себя, очень слабо».~
@59220 = ~«Как он может быть слабым?»~
@59221 = ~«Ты говоришь так, будто город живой».~
@59222 = ~«Я хотел бы *узнать* кое-что еще...»~
@59223 = ~«Понятно. Идем».~
@59224 = ~«Он может не осознавать и *не знать* себя в том смысле, в котором ты или я можем *знать* себя, он жив. Он растет, меняется и влияет на все разумы, которые живут в нем».~
@59225 = ~«Почему ты сказал, что город не знает себя?»~
@59226 = ~«Я хотел бы *узнать* кое-что еще...»~
@59227 = ~«Понятно. Идем».~
@59228 = ~«Город существует вопреки себе. Он находится вне Планов, и все же хочет быть одновременно всюду. Его стены являются дверьми, хотя он держит их запертыми. Подобное существование говорит о том, что он *не знает* себя. То, что *не знает* себя, является слабым».~
@59229 = ~«Что ты имел в виду, когда говорил, что этот город одновременно повсюду?»~
@59230 = ~«Стены являются дверьми?»~
@59231 = ~Правда: «А что, если город *не слаб*? Чтобы знать себя, вещи не нужны порядок и назначение. Что, если все эти противоречия являются силой, которую ты не можешь увидеть?»~
@59232 = ~Правда: «А что, если город *не слаб*? Чтобы знать себя, вещи не нужны порядок и назначение. Что, если все эти противоречия являются силой, которую ты не можешь увидеть?»~
@59233 = ~Правда: «А что, если город *не слаб*, и ты просто не знаешь причин его противоречий? Порядок есть во всем. Возможно, в основе лежит какой-то шаблон, который ты неспособен разобрать».~
@59234 = ~Правда: «А что, если город *не слаб*, и ты просто не знаешь причин его противоречий? Порядок есть во всем. Возможно, в основе лежит какой-то шаблон, который ты неспособен разобрать».~
@59235 = ~«Ты говоришь так, будто город живой».~
@59236 = ~«Я хотел бы *узнать* кое-что еще...»~
@59237 = ~«Понятно. Идем».~
@59238 = ~«Вопрос на твой вопрос. А что, если город слаб, и ты видишь, что его противоречия окружают тебя повсюду?»~
@59239 = ~Правда: «Вопрос на *твой* вопрос. Ты заявляешь, что город слаб. Ты охотнее принимаешь это, вместо того чтобы исследовать возможность того, что может существовать что-то более значительное. Из этого следует, что ты слаб... ты ищешь не знания, а удобные ответы».~
@59240 = ~Правда: «Вопрос на *твой* вопрос. Ты заявляешь, что город слаб. Ты охотнее принимаешь это, вместо того чтобы исследовать возможность того, что может существовать что-то более значительное. Из этого следует, что ты слаб... ты ищешь не знания, а удобные ответы».~
@59241 = ~«Когда ты сказал, что город одновременно повсюду, что ты имел ввиду?»~
@59242 = ~«Я хотел бы *узнать* кое-что еще...»~
@59243 = ~«Понятно. Идем».~
@59244 = ~Даккон умолкает. «Ответы на наши вопросы *неизвестны*. Но город все же существует. Вот и все».~
@59245 = ~«И все же я буду утверждать, чтобы мы *познаем* себя с помощью вопросов, которые мы задаем или не задаем. Если мы перестанем задавать вопросы и будем принимать только то, что понимаем...»~
@59246 = ~«И все же я буду утверждать, чтобы мы *познаем* себя с помощью вопросов, которые мы задаем или не задаем. Если мы перестанем задавать вопросы и будем принимать только то, что понимаем...»~
@59247 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59248 = ~«Тогда неважно. Идем дальше».~
@59249 = ~«Тогда мы перестанем *знать* себя, — голос Даккона стал чуть громче. — Эти слова уже были произнесены. Я слышал их и я их *знаю*».~
@59250 = ~«Где ты их слышал?»~
@59251 = ~«Я хотел бы *узнать* кое-что еще...»~
@59252 = ~«Неважно. Пошли».~
@59253 = ~«Эти слова — мои. Когда-то я *знал* их и *знал* их значение. Я не помнил их, пока ты их не произнес». Взгляд Даккона устремляется вдаль сквозь тебя, его клинок, перестав мерцать, лишается всех цветов и становится совершенно прозрачным.~
@59254 = ~«Даккон, как так случилось, что я знаю твои слова?»~
@59255 = ~«Даккон, я услышал эти слова от тебя, когда путешествовал с тобой?»~
@59256 = ~«Ясно... Я хотел бы *узнать* кое-что еще...»~
@59257 = ~«Неважно. Пошли».~
@59258 = ~«Я произносил эти слова, но они не принадлежат мне. Их могут *знать* другие, поскольку их *знание* есть в каждой вещи. Люди называют это *мудростью*».~
@59259 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59260 = ~«Понятно. Идем».~
@59261 = ~«Прошло много времени с тех пор, как мы обсуждали смысл подобных слов. В ту пору тяжесть лет была не такой сильной, как сейчас. Ступая по этому пути, я многое забыл».~
@59262 = ~«Даккон, кем я был... на кого... я был похож?»~
@59263 = ~«Я хотел бы *узнать* кое-что еще...»~
@59264 = ~«Понятно. Идем».~
@59265 = ~Даккон умолкает, его взгляд устремляется вдаль сквозь тебя.~
@59266 = ~«Даккон?»~
@59267 = ~«Тогда забудь. Я хочу *узнать* о других вещах...»~
@59268 = ~«Может, лучше об это не говорить. Пошли».~
@59269 = ~Даккон сказал, что он был знаком с моим прошлым воплощением... и что он не может сказать о нем много приятного. Он назвал его талантливым, но эгоцентричным и вероломным. Я начинаю представлять, сколько вреда могли принести планам мои другие я.~
@59270 = ~«*Знай*, что он был другим. *Знай*, что отличие было не в коже, не в оружии, не в носимом наряде. *Знай*, что он был другим по способу мышления и средствам, которыми он осуществлял свои задумки. Его ВОЛЯ стала материей. *Знай*, что он смотрел на других, но НЕ ВИДЕЛ их. Он лишь *знал*, какую пользу можно из них извлечь. Его сердце было вероломным и холодным, и этот холод никогда не обжигал его».~
@59271 = ~«Коснулось ли это тебя, Даккон? Предавал ли он тебя?»~
@59272 = ~«Ясно... Я хотел бы *узнать* кое-что еще...»~
@59273 = ~«Поговорим об этом в другой раз. Идем».~
@59274 = ~Клинок Даккона начинает выцветать, приобретая глухой ровный черный цвет. Ты видишь, как лезвие клинка покрывается выступами, похожими на зубы. Он произносит сквозь стиснутые зубы: «Я *не желаю*, чтобы ты *узнал* это».~
@59275 = ~«*Скажи* мне, Даккон. *Предавал* ли он тебя?»~
@59276 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59277 = ~«Тогда мы больше не будем об этом говорить. Пошли».~
@59278 = ~«*Знай*: было МНОГО предательств. Меня предавал только я сам. Никто другой».~
@59279 = ~«*Расскажи* мне, Даккон. Что это было за предательство?»~
@59280 = ~«Неважно. Я хотел бы *узнать* о другом...»~
@59281 = ~«Поговорим об этом в другой раз. Идем».~
@59282 = ~«Я дал ему свое СЛОВО. Я отдал СЕБЯ».~
@59283 = ~«О чем ты говоришь?»~
@59284 = ~«Неважно. Я хотел бы *узнать* о другом...»~
@59285 = ~«Поговорим об этом в другой раз. Идем».~
@59286 = ~Даккон рассказал о сущности своего рабства... Когда я спас ему жизнь, он пообещал служить мне до тех пор, пока я не умру. Но он не подозревал, что я бессмертен. Сделав это, он отдал мне остаток своей жизни.~
@59287 = ~«Народ не позволяет себе быть скованным другими поступками или цепями. Если мы оказываемся в подобной ловушке, мы ДЕЛАЕМ ВСЕ, чтобы освободиться, даже если из-за этого попадаем в другую ловушку. Ты оказал мне большую услугу. Сделав это, ты поработил меня. Я пытался освободить себя. *Знай*, что я отдал свое слово и себя самого, чтобы *действовать* во имя тебя до тех пор, пока ты не умрешь».~
@59288 = ~«Но... я не могу умереть».~
@59289 = ~«Ясно... Я хотел бы *узнать* кое-что еще...»~
@59290 = ~«Поговорим об этом в другой раз. Идем».~
@59291 = ~«Это не было *известно*. Я дал ему мое *слово*. Я отдал ему самого *себя*. *Знай*, что кроме моей жизни у меня не осталось ничего. *Знай*, что теперь я следую за тобой, лишь чтобы умереть».~
@59292 = ~«Что это была за услуга... которая заковала тебя?»~
@59293 = ~«Даккон, все не должно быть так... Я могу тебя освободить. Я больше не хочу, чтобы ты был рабом. Считай, что долг уплачен».~
@59294 = ~«Даккон, все не должно быть так... Я могу тебя освободить. Я больше не хочу, чтобы ты был рабом. Считай, что долг уплачен».~
@59295 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59296 = ~«Значит, тот другой я потребовал, чтобы ты поклялся служить ему до его смерти, и ты не знал, что он *бессмертен*? Прекрасно. Пошли... раб».~
@59297 = ~«Значит, тот другой я потребовал, чтобы ты поклялся служить ему до его смерти, и ты не знал, что он *бессмертен*? Прекрасно. Пошли... раб».~
@59298 = ~«Поговорим об этом в другой раз. Идем».~
@59299 = ~«Ты спас жизнь. В обмен твоя жизнь стала моей».~
@59300 = ~«Как я спас тебе жизнь?»~
@59301 = ~«Даккон, все не должно быть так... Я могу тебя освободить. Я больше не хочу, чтобы ты был рабом. Считай, что долг уплачен».~
@59302 = ~«Даккон, все не должно быть так... Я могу тебя освободить. Я больше не хочу, чтобы ты был рабом. Считай, что долг уплачен».~
@59303 = ~«Значит, тот другой я потребовал, чтобы ты поклялся служить ему до его смерти, и ты не знал, что он *бессмертен*? Прекрасно. Пошли... раб».~
@59304 = ~«Значит, тот другой я потребовал, чтобы ты поклялся служить ему до его смерти, и ты не знал, что он *бессмертен*? Прекрасно. Пошли... раб».~
@59305 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59306 = ~«Поговорим об этом в другой раз. Идем».~
@59307 = ~«Пребывая на плане Лимбо, Народ формирует города из хаоса своими мыслями. *Знай*, что там нет места рассеянному разуму». Даккон вытаскивает свой клинок из-за плеча и держит его перед собой. Под его взглядом клинок *заостряется*, становясь тонким как лист бумаги.~
@59308 = ~«Продолжай...»~
@59309 = ~«Думаю, я выслушал достаточно. Я хотел бы *узнать* о другом...»~
@59310 = ~«Поговорим об этом в другой раз. Идем».~
@59311 = ~«Рассеянный разум не сосредоточен. Рассеянный разум раскалывает стены и крушит камень». Пока Даккон говорит, его кромки его клинка начинают разъедаться, по краям металл плавится и испаряется. «Большое количество рассеянных разумов способно *разрушить* город».~
@59312 = ~«Понимаю. Продолжай...»~
@59313 = ~«Я выслушал достаточно. Я хотел бы *узнать* о другом...»~
@59314 = ~Гитьянки, не произнося ни слова, с горечью смотрит на тебя. Когда ты пытаешься заговорить с ним, он сплевывает на землю и отворачивается.~
@59315 = ~«Поговорим об этом в другой раз. Идем».~
@59316 = ~«Я *знаю* слова Зертимона уже давно. С помощью моего голоса многие *узнали* слова Зертимона. *Зерты* защищают свой народ от всех угроз, будь то угроза телу или угроза разуму. Они — путеводный камень в хаосе. Но случилось так, что я перестал *понимать* слова Зертимона, произнося их. Случилось так, что я перестал *знать* себя».~
@59317 = ~«Ну, тогда прощай».~
@59318 = ~«Значит... ты усомнился в словах?»~
@59319 = ~«Я выслушал достаточно. Я хотел бы *узнать* о другом...»~
@59320 = ~«Поговорим об этом в другой раз. Идем».~
@59321 = ~Перед тобой гитьянки с кожей болезненно-желтого оттенка, худым лицом и решительным взглядом, медленно слоняющийся из угла в угол. Ты физически ощущаешь его ярость. Взглянув на тебя, он злобно рычит: «Чего надо?»~
@59322 = ~«Нет». Голос Даккона становится резче, в ответ клинок становится *еще* острее. «Я *понимал* слова. Тем не менее, мое сердце чувствовало, что другие, возможно, не способны *понять* их так, как их *понимал* Зертимон. Таким образом, образовалась рассеянность. Мой разум, разделившись надвое, стал рассеянным, и те, кто видел во мне путеводный камень, стали такими же. Десятки, тысячи гитцераев... усомнились. В этот день Шракатлор пал».~
@59323 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59324 = ~«Значит, твои последователи тоже усомнились в словах, из-за чего город ослаб».~
@59325 = ~«Я выслушал достаточно. Я хотел бы *узнать* о другом...»~
@59326 = ~«Поговорим об этом в другой раз. Идем».~
@59327 = ~«Кто ты?»~
@59328 = ~«Что ты можешь сказать о Проклятом?»~
@59329 = ~«Ты что-нибудь слышал о дэва?»~
@59330 = ~«Пришли враги Зертимона. *Знай*, что они ненавидели его слово и Народ, придающий силу своим клинкам. *Знай*, что они почувствовали ослабший город и принесли войну. Много гитцераев утонуло в хаосе и под клинками наших врагов». На поверхности клинка появляются маленькие металлические шарики, как от ожога. «*Знай*, что это произошло очень давно».~
@59331 = ~«Ничего. Забудь».~
@59332 = ~«Что случилось с тобой?»~
@59333 = ~Назад на площадь Старьевщиков~
@59334 = ~«Я — Анизиус, а ты должен обращаться ко мне 'ваша честь'. Я один из лидеров этого города, поэтому заслуживаю уважения, — он присматривается к тебе. — Ты нездешний. Чего тебе нужно?»~
@59335 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59336 = ~Назад в Улей~
@59337 = ~«Что случилось с тобой?»~
@59338 = ~«Я ищу дэва».~
@59339 = ~«Я ищу потерянную вещь».~
@59340 = ~Назад в Проклятый~
@59341 = ~«Ничего. Прощай».~
@59342 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59343 = ~Портал назад во Двор Фарода~
@59344 = ~«Поговорим об этом в другой раз. Идем».~
@59345 = ~Он презрительно усмехается. «Спроси у того, у кого есть время. У меня дела чрезвычайной важности».~
@59346 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59347 = ~«Когда я пал со стен Шракатлора, *знай*, что мое я было сломлено. Мой клинок превратился в туман, мой разум рассеялся. Я дрейфовал по морям Лимбо, я хотел утонуть. Я умирал несколько дней, мой рассеянный разум плыл, но тут смерть наконец пришла ко мне. С твоей кожей и твоим голосом».~
@59348 = ~«Я?»~
@59349 = ~«Я выслушал достаточно. Я хотел бы *узнать* о другом...»~
@59350 = ~«Чрезвычайной важности?»~
@59351 = ~«Поговорим об этом в другой раз. Идем».~
@59352 = ~«Так кто ты на самом деле?»~
@59353 = ~«Ты попросил меня выслушать тебя».~
@59354 = ~«Я ищу дэва».~
@59355 = ~«И что я сказал?»~
@59356 = ~«Хорошо. Прощай».~
@59357 = ~«Неважно. Я хотел бы *узнать* о другом...»~
@59358 = ~~
@59359 = ~«Поговорим об этом в другой раз. Идем».~
@59360 = ~Даккон умолкает. «Я услышал твои слова. Хаос в моем разуме успокоился. Я снова *познал* себя».~
@59361 = ~«Так это от меня ты получил Круг?»~
@59362 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59363 = ~«Поговорим об этом в другой раз. Идем».~
@59364 = ~«Да. *Познав* его слова, я *познал* себя».~
@59365 = ~«Но *он* ли спас твою жизнь, Даккон? Или же ты еще сильнее рассеял себя, изучая Круг?»~
@59366 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59367 = ~«Это все, что я хотел узнать. Идем».~
@59368 = ~«Даккон, *зерт* Затонувшего Шракатлора, последний носитель клинка *карач*, *знай*, что я пришел к тебе со словами Зертимона, вырезанными волей не на хаосе, а на камне Неразрывного Круга. *Знай*, что слова Зертимона, вырезанные на этом камне, истинны, и *знай*, что твоему рассеянному разуму не нужно больше быть рассеянным. Все, что тебе нужно сделать — взять этот камень, и ты снова *познаешь* себя».~
@59369 = ~«Так это от *меня* ты получил Круг?»~
@59370 = ~«Ясно... Я хотел бы *узнать* кое-что еще...»~
@59371 = ~«Это все, что я хотел узнать. Идем».~
@59372 = ~Оказалось, что это *я* дал Даккону Неразрывный Круг Зертимона.~
@59373 = ~Даккон молчит, но его клинок корчится и извивается, словно в агонии. Он медлит со ответом, но потом мрачно произносит: «Он рассеял меня».~
@59374 = ~«Так *спас* ли я твою жизнь, Даккон? Или я всего лишь продлил твою агонию? Те слова... слова Зертимона... они, похоже, рассеяли тебя еще сильнее. Я вижу это, когда ты повторяешь его учения».~
@59375 = ~«Я так и знал. Я хотел бы *узнать* о другом...»~
@59376 = ~«Мы поговорим об этом в другой раз. А теперь идем».~
@59377 = ~Даккон молчит.~
@59378 = ~«Я говорю, что НИКОГДА не спасал тебя, Даккон... Я всего лишь спас тебя от смерти, для того, чтобы ты смог умереть еще раз. Если бы ты умер у Шракатлора, то познал бы покой».~
@59379 = ~«Твои слова несут тяжесть истины. Смерть, которой я мог умереть в Шракатлоре... она была бы последней смертью. Каждый прожитый с тех пор новый день — как новая смерть».~
@59380 = ~«Тебе больше не нужно служить мне, Даккон. Я никогда не спасал тебе жизнь, я всего лишь дважды убил тебя. Ты не обязан мне ничем».~
@59381 = ~«Такова сущность вещей. Я хотел бы *узнать* о другом...»~
@59382 = ~«Мы поговорим об этом после. Идем».~
@59383 = ~Даккон ждет.~
@59384 = ~«Можешь еще раз рассказать о гитцераях?»~
@59385 = ~«Ты особо подчеркиваешь слово 'известен'. Почему?»~
@59386 = ~«Что это за клинок у тебя?»~
@59387 = ~«У меня есть еще несколько вопросов о языке гитцераев...»~
@59388 = ~«Тогда у меня есть другие вопросы...»~
@59389 = ~«Неважно, Даккон. Идем».~
@59390 = ~Даккон ждет.~
@59391 = ~«Что ты можешь сказать о городе Сигиле?»~
@59392 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@59393 = ~«Я потерял дневник. Ты не знаешь, где я могу его найти?»~
@59394 = ~«Когда Фелл описывал татуировку на моей руке, ты сказал, что знал эти символы».~
@59395 = ~«Ты говорил, что когда-то у меня было четыре спутника. Кем они были?»~
@59396 = ~«Тогда у меня есть другие вопросы...»~
@59397 = ~«Неважно, Даккон. Идем».~
@59398 = ~«Нет...» Лицо Даккона искажено болью, он смотрит сквозь тебя. «Не твое слово имеет силу, и меня оно не освободит. Меня сковывает мое собственное слово. Это мои страдания. В сердце я *знаю*, что цепи все еще на мне. Словами их не разорвать».~
@59399 = ~«Есть ли какой-либо способ освободить тебя?»~
@59400 = ~«Тогда забудь. Я хочу *узнать* о других вещах...»~
@59401 = ~Его глаза сужаются. «Дэва? Зачем тебе дэва, и почему ты ищешь его в Проклятом?»~
@59402 = ~«Я пришел за мечом».~
@59403 = ~«Поговорим об этом в другой раз — вопрос еще не закрыт. Идем».~
@59404 = ~Даккон сказал, что единственный способ освободить его — моя окончательная смерть. Даже не знаю, как это можно сделать.~
@59405 = ~«Забудь об этом. Прощай».~
@59406 = ~«Ты должен умереть окончательно. Тем не менее, твой путь и путь смерти не пересекаются. Эта проблема *неразрешима*».~
@59407 = ~«Да. Я уже украл у тебя бинты. Неужели ты думаешь, что сможешь помешать мне украсть клинок, если я задамся такой целью?»~
@59408 = ~~
@59409 = ~Клятва: «Я обещаю, что разрешу ее, Даккон. Я найду способ освободить тебя».~
@59410 = ~«Я считаю, что он владеет тайной моей смертности».~
@59411 = ~«Я слышал, что один из них находится здесь. Ты что-нибудь знаешь об этом?»~
@59412 = ~«Ясно... Я хотел бы *узнать* кое-что еще...»~
@59413 = ~«Забудь. Друг передал мне, что ты нуждаешься в помощи».~
@59414 = ~«Поговорим об этом в другой раз — вопрос еще не закрыт. Идем».~
@59415 = ~«Забудь. Мне нужно идти. Прощай».~
@59416 = ~Я поклялся Даккону, что найду способ освободить его от рабства. Вместо того, чтобы поднять его дух, клятва подавила его еще сильнее.~
@59417 = ~«И что же это? Я, как городской лидер, мог бы помочь тебе в этом».~
@59418 = ~«Как городской лидер, ты, должно быть, нуждаешься во *мне*. Друг передал мне, что тебе нужна помощь».~
@59419 = ~«Я потерял свою смертность. Мне нужно ее найти».~
@59420 = ~«Ничего важного. Я смогу найти это сам».~
@59421 = ~«Ничего важного. Прощай».~
@59422 = ~Он внимательно смотрит на тебя, похоже, оценивая, и выносит тебе вердикт: «Ничего, в чем ты можешь посодействовать. А теперь посторонись. Мне нужно кое-что обдумать».~
@59423 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59424 = ~«Ладно. Прощай».~
@59425 = ~Голос Даккона становится неровным, словно его внезапно поразила болезнь. «*Знай*, что ты добавил к моим словам другие». Он выглядит измученным, его взгляд встречается с твоим. «Ты сковал нас обоих».~
@59426 = ~«Ясно... Я хотел бы *узнать* кое-что еще...»~
@59427 = ~Он смотрит на тебя так, словно ты перешел за грань безумия. «Тебе точно нужна помощь. Всего хорошего». Он высокомерно отворачивается от тебя.~
@59428 = ~«Поговорим об этом в другой раз — вопрос еще не закрыт. Идем».~
@59429 = ~~
@59430 = ~«Город создан из дверей. Эти двери ведут куда угодно».~
@59431 = ~«Прощай».~
@59432 = ~«А где эти двери?»~
@59433 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59434 = ~«Не думаю, что это так, — он продолжает смотреть на тебя. — Прошу прощения, но меня ждут дела чрезвычайной важности».~
@59435 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59436 = ~«Чрезвычайной важности?»~
@59437 = ~«Я хотел бы *узнать* кое-что еще...»~
@59438 = ~«Понятно. Прощай».~
@59439 = ~«Понятно. Идем».~
@59440 = ~Вход в Морг~
@59441 = ~«Тогда зачем ты прервал мои мысли? Следовало заковать тебя в кандалы! Прочь!» Он отворачивается от тебя.~
@59442 = ~«В этом городе они повсюду... — Даккон на секунду умолкает. — Говорят, что любое ограниченное пространство в городе, известном как Сигил, является дверью, которая куда-то ведет».~
@59443 = ~Монумент тленных~
@59444 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59445 = ~«Я не понимаю».~
@59446 = ~Бар собирателей пыли~
@59447 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59448 = ~«Ну, тогда прощай».~
@59449 = ~К юго-восточной части Улья.~
@59450 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59451 = ~«Отлично. Ты сможешь найти то, что ищешь, глубоко под Проклятым. Стража!» Вокруг тебя материализуются стражники. Внезапно что-то увесистое бьет тебя по затылку. Ты проваливаешься в темноту...~
@59452 = ~«Я хотел бы *узнать* кое-что еще...»~
@59453 = ~К переулку Опасных углов~
@59454 = ~«Проклятье...»~
@59455 = ~«Понятно. Идем».~
@59456 = ~«Представь себе дверь в дом. Убери дверь. Останется косяк. Пространство внутри косяка все равно является дверью».~
@59457 = ~«Но ведь это просто... пустое пространство».~
@59458 = ~Мавзолей~
@59459 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59460 = ~Он напрягается еще сильнее. «И что же тебе сказали?»~
@59461 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59462 = ~«То, что у тебя есть некоторые затруднения с политическими оппонентами».~
@59463 = ~«Я хотел бы *узнать* кое-что еще...»~
@59464 = ~Его глаза на долю секунды расширяются, после чего снова превращаются в две узкие щелочки. «Понятно. А ты, стало быть, собираешься помочь мне?»~
@59465 = ~«Понятно. Идем».~
@59466 = ~«Есть много дверей, которых ты никогда не увидишь. Ты можешь просто проходить сквозь них, даже *не зная* об их существовании. Они закрыты для твоего взгляда и осязания».~
@59467 = ~«И такие невидимые двери в Сигиле *повсюду*?»~
@59468 = ~«А это зависит от того, что тебе нужно от меня».~
@59469 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59470 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59471 = ~«Да».~
@59472 = ~«Я хотел бы *узнать* кое-что еще...»~
@59473 = ~«Нет».~
@59474 = ~«Понятно. Идем».~
@59475 = ~Говорят, что любое ограниченное пространство в городе, известном как Сигил, является дверью. Никто точно *не знает*. Двери перемещаются. Двери меняются. Двери пропадают. И все они заперты».~
@59476 = ~«Заперты?»~
@59477 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59478 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59479 = ~«Я хотел бы *узнать* кое-что еще...»~
@59480 = ~«Понятно. Идем».~
@59481 = ~«Пока у тебя нет подходящего ключа, двери остаются прозрачными. Когда у тебя есть ключ, двери становятся *известными* тебе».~
@59482 = ~«А как узнать, что это ключ?»~
@59483 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59484 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59485 = ~«Тогда ты для меня бесполезен. Сгинь!» Он отмахивается от тебя.~
@59486 = ~«Ну, тогда прощай».~
@59487 = ~«Я хотел бы *узнать* кое-что еще...»~
@59488 = ~«Понятно. Идем».~
@59489 = ~«У каждой двери есть свой ключ. Некоторые ключи *известны*, другие — нет».~
@59490 = ~«Это очень деликатное дело. Необходимо проучить мою соперницу. Ее вовсе необязательно убивать — на случай, если ты брезгуешь».~
@59491 = ~«Что это за ключи?»~
@59492 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59493 = ~«Тогда я займусь этим».~
@59494 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59495 = ~«Я хотел бы *узнать* кое-что еще...»~
@59496 = ~«Забудь».~
@59497 = ~«Понятно. Идем».~
@59498 = ~«Ключей, как и дверей, много. Необязательно они могут быть предметами из металла. Ключом может быть лязг мечей, капля крови, упавшая с языка умирающего человека, воспоминание о былой любви или проклятье, пущенное в небо. Когда ключ подходит к двери, она проявляется».~
@59499 = ~«Вот, что ты должен сделать: Женщина по имени Сиабха... Она продает свое влияние тому, кто больше даст, и подрывает мой авторитет перед бюргером этого города. Я хочу дискредитировать ее. Все, что тебе нужно сделать, — сказать капитану стражи, что она попыталась нанять тебя для нападения на меня. Ты будешь за это вознагражден. Если ты берешься за это, ее можно найти неподалеку от административного здания».~
@59500 = ~«Похоже, найти все эти ключи и двери будет довольно трудно».~
@59501 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59502 = ~«Я еще вернусь».~
@59503 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59504 = ~«Я хотел бы *узнать* кое-что еще...»~
@59505 = ~Анизиус, представитель власти Проклятого, желает дискредитировать с моей помощью своего политического оппонента, обманув капитана стражи. Оппонента зовут Сиабха, и ее можно найти неподалеку от Административного здания во Внутреннем Проклятом.~
@59506 = ~«Понятно. Идем».~
@59507 = ~«Подобная задача никогда не будет выполнена. Город, меняясь, меняет и двери. Ничто *известное* не остается *известным* надолго».~
@59508 = ~«Еще раз, почему ты сказал, что город слаб?»~
@59509 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59510 = ~«Я хотел бы *узнать* кое-что еще...»~
@59511 = ~«Понятно. Идем».~
@59512 = ~«Существование всех предметов, неважно, будь то здания или плоть, определяется *знанием* их самих».~
@59513 = ~«А если человек не знает себя?»~
@59514 = ~«Понятно. У меня есть еще несколько вопросов о гитцераях...»~
@59515 = ~Перед тобой гитьянки с кожей болезненно-желтого оттенка, худым лицом и решительным взглядом, медленно слоняющийся из угла в угол. Ты физически ощущаешь его ярость. Взглянув на тебя, он злобно рычит: «Чего надо?»~
@59516 = ~«У меня есть несколько вопросов к тебе...»~
@59517 = ~«Я хотел бы *узнать* кое-что еще...»~
@59518 = ~«Понятно. Идем».~
@59519 = ~Глаза гитьянки сужаются. «Я сумел отринуть ненависть к твоему народу. Я стал выше той мелочной вражды между нашими расам. За это меня изгнали, но если честно, мне от этого даже лучше. Сможешь ли ты сказать то же самое?»~
@59520 = ~«Когда разум *не знает* себя, он становится слабым. Когда разум слаб, то слаб и сам человек. Когда человек слаб, то все, к чему он прикоснется, становится слабым, — Даккон делает паузу. — Поэтому говорят: то, что видит слабый человек, ломают его руки».~
@59521 = ~«А ты знаешь себя?»~
@59522 = ~«Понятно. У меня есть еще несколько вопросов о гитцераях...»~
@59523 = ~«Я хотел бы *узнать* кое-что еще...»~
@59524 = ~«Понятно. Идем».~
@59525 = ~Даккон снова умолкает. Его угольно-черные глаза снова, как и при первой встрече, становятся непроницаемыми.~
@59526 = ~«Ладно, вы двое... Давайте покороче. У меня есть несколько вопросов».~
@59527 = ~«Забудь об этом. Мы уходим».~
@59528 = ~«Еще раз спрашиваю: ты знаешь себя?»~
@59529 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59530 = ~«В чем они заключаются?»~
@59531 = ~«Неважно. Я хотел бы *узнать* о другом...»~
@59532 = ~«Мы поговорим об этом в другой раз. А теперь идем».~
@59533 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59534 = ~Голос Даккона меняется: он похож на эхо от камня, упавшего в глубокое ущелье. Похоже, он заставляет себя произносить слова. «Я *не желаю*, чтобы ты *знал* это».~
@59535 = ~«Наверное, я был слишком вежлив, произнося это как вопрос. Рассказывай».~
@59536 = ~«Ладно. У меня еще другие вопросы про гитцераев...»~
@59537 = ~«Кто ты?»~
@59538 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59539 = ~«Понятно. Идем».~
@59540 = ~«Что ты можешь сказать о Проклятом?»~
@59541 = ~Даккон говорит медленно, будто вытягивая слова одно за другим. «Так... случилось, что я *не знаю* себя».~
@59542 = ~«Ты что-нибудь слышал о дэва?»~
@59543 = ~«Почему?»~
@59544 = ~«Ничего. Забудь».~
@59545 = ~Даккона переходит на шепот, похожий на шелест песка. «Я *не знаю* почему. Я *знаю*, что это произошло, но *не знаю*, как или когда... и как снова *познать* себя».~
@59546 = ~«Понятно... У меня есть еще несколько вопросов о гитцераях...»~
@59547 = ~«Чего надо, пес?»~
@59548 = ~«Тогда забудь. Я хочу *узнать* о других вещах...»~
@59549 = ~«Я передумал. Я помогу тебе. Что тебе нужно?»~
@59550 = ~«Мы поговорим об этом в другой раз. Пошли».~
@59551 = ~«Это клинок *карач*. Это предмет, позволяющий другим *знать* уровень владельца».~
@59552 = ~«*Карач*? Что это значит?»~
@59553 = ~«Ничего. Прощай».~
@59554 = ~«Он сделан из странного металла... это так завораживает — то, как он движется».~
@59555 = ~«Что за уровень он отражает?»~
@59556 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59557 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59558 = ~«Ну? Как продвигается дело?»~
@59559 = ~«Поговорим об этом в другой раз. Идем».~
@59560 = ~«Твоя соперница предложила мне большую сумму за то, чтобы я встал на ее сторону».~
@59561 = ~«Клинок — это символ, который носит *зерт*. *Зерт* — это тот, кто *знает* слова Зертимона. *Зная* слова Зертимона, он *познает* себя».~
@59562 = ~«Я поговорил с капитаном стражи, и он сказал, что отправит отряд, который отконвоирует ее в тюрьму».~
@59563 = ~«Зертимона?»~
@59564 = ~«Еще раз — что это за клинок?»~
@59565 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59566 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59567 = ~«Поговорим об этом в другой раз. Идем».~
@59568 = ~«Я работаю над этим. У меня есть несколько вопросов...»~
@59569 = ~«Зертимон основал нашу расу. Он *знал* гитцераев до того, как они *осознали* себя. Он определил Народ. Он дал им единый разум».~
@59570 = ~«Еще раз — что это за клинок?»~
@59571 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59572 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59573 = ~«Поговорим об этом в другой раз. Идем».~
@59574 = ~«Я работаю над этим. Я вернусь».~
@59575 = ~Даккон умолкает, пытаясь подобрать подходящие слова. «На вашем языке ближайший перевод звучит как 'материя хаоса'. Народ может придавать ему форму силой мысли».~
@59576 = ~«Народ?»~
@59577 = ~«Придавать форму силой мысли?»~
@59578 = ~Анизиус щедро заплатил за то, чтобы я передал Сиабху в руки стражи Проклятого — более чем достаточно за столь незначительную ложь.~
@59579 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59580 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59581 = ~«Поговорим об этом в другой раз. Идем».~
@59582 = ~«Что? Я заплачу вдвое больше!»~
@59583 = ~«Гитцерай».~
@59584 = ~«Кто такие гитцераи?»~
@59585 = ~«По рукам».~
@59586 = ~«Еще раз, кто такие гитцераи?»~
@59587 = ~«И ты говоришь, что гитцерай могут придавать форму этому *карачу*... силой мысли?»~
@59588 = ~«Посмотрим. Прощай».~
@59589 = ~«У меня есть другие вопросы о твоем народе...»~
@59590 = ~«Я в долгу у тебя, — он протягивает тебя тяжелый кошель с монетами. — А теперь исчезни».~
@59591 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59592 = ~«Прощай».~
@59593 = ~«Это все, что я хотел узнать. Идем».~
@59594 = ~«*Карачу* придает форму не жар, а *знание*. Это зеркало, которое отражает на своей поверхности и гранях волю владельца. Когда он *знает* себя, клинок тверд, тверже и прочнее стали. Когда он *не знает* себя, клинок похож на воду: он бесформен и слаб».~
@59595 = ~«Иди же! Прочь! Или я с тебя шкуру спущу!»~
@59596 = ~«Что за уровень отражает клинок?»~
@59597 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59598 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59599 = ~«Прощай».~
@59600 = ~«Это все, что я хотел узнать. Идем».~
@59601 = ~«Нам не о чем больше разговаривать. Наше общее дело закончено. Нельзя вызывать никаких подозрений. Оставь меня в покое».~
@59602 = ~«Мои *знания* Искусства, каким его *знают* люди, ограничены». Клинок Даккона выскальзывает из его руки, и он выставляет его перед собой круговым движением. «Однако я *знаю* достаточно. Я обучу тебя».~
@59603 = ~«Отлично. Прощай».~
@59604 = ~«Хорошо...»~
@59605 = ~«Почему ты так мне досаждаешь?»~
@59606 = ~«Друг передал мне, что ты нуждаешься в помощи».~
@59607 = ~«Мне он *неизвестен*».~
@59608 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59609 = ~«Кто ты?»~
@59610 = ~«Что ты можешь сказать о Проклятом?»~
@59611 = ~«Ты что-нибудь слышал о дэва?»~
@59612 = ~«Ничего. Забудь».~
@59613 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59614 = ~«Это все, что я хотел узнать. Идем».~
@59615 = ~«Где эта вещь, мне *неизвестно*».~
@59616 = ~«У меня есть другие вопросы о наших путешествиях...»~
@59617 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59618 = ~«Это все, что я хотел узнать. Идем».~
@59619 = ~Даккон морщится, как будто его ударили. «Я *не желаю*, чтобы мы говорили про это место».~
@59620 = ~«Даккон, *скажи* мне: что такое Шракатлора?»~
@59621 = ~«Тогда забудь. Я хочу *узнать* о других вещах...»~
@59622 = ~«Тогда мы поговорим об этом в другой раз. А теперь идем».~
@59623 = ~Даккон на миг умолкает. «*Знай*: это место, где я умер своей первой смертью».~
@59624 = ~«Что это за место?»~
@59625 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59626 = ~«Поговорим об этом в другой раз. Идем».~
@59627 = ~«Это один из величайших домов Народа. В своей жизни он получил много ран. Одна из них принадлежит моей руке».~
@59628 = ~«О чем это ты?»~
@59629 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59630 = ~«Поговорим об этом в другой раз. Идем».~
@59631 = ~TEMP~
@59632 = ~TEMP~
@59633 = ~TEMP~
@59634 = ~TEMP~
@59635 = ~Его низкий голос доносится из складок жира. «Меня зовут Кассий. Я был величайшим оружием покойного Лорда Бездны, и его наследники все еще разыскивают меня. Я — ужасная тайна из сердца планов хаоса, и я — хранитель этого клинка».~
@59636 = ~Произнося слова, ты чувствуешь странное покалывание, проходящее через затылок. Перед глазами все плывет... ты делаешь глубокий вздох и приходишь в себя. Почему-то ты чувствуешь тошноту, как будто окружающий мир начал вращаться вокруг тебя.~
@59637 = ~Его голос глух и низок. «Этот меч питает тюрьму Проклятого. Если забрать его, это освободит всех заключенных, приговоренных к забвению. Мне поручили предотвратить это. Тебе нужен клинок?»~
@59638 = ~«Как... тебе удалось выжить, Даккон?»~
@59639 = ~«Когда-то я был самым эффективным оружием во всей Бездне, созданным по воле моего господина. Я мог принимать облик смерти любого существа. Я убил больше врагов моего покойного господина, чем было мгновений в их жизни. Мой брат, моя бледная тень, мой Зекиель, продолжает убивать где-то в глубинах Бездны».~
@59640 = ~«Когда я пал со стен Шракатлора, *знай*, что мое я было сломлено. Мой клинок превратился в туман, мой разум рассеялся. Я дрейфовал по морям Лимбо, я хотел утонуть. Я умирал несколько дней, мой рассеянный разум плыл».~
@59641 = ~«Мой господин утонул в самом сердце Бездны, пока я был занят убийствами. Когда я вернулся, его уже не было, а его наследники заявили на меня права. Никому из них не удалось покорить меня, и потому я ушел. Моя работа мне нравится. Кто приходит, того я убиваю. Несложная задача».~
@59642 = ~«Как тебе удалось выжить?»~
@59643 = ~Он внимательно тебя изучает. Мгновение спустя, он произносит: «Я бы смог, хотя это была бы славная битва. Ты хочешь, чтобы я тебя убил?»~
@59644 = ~«Скажи, что ты пришел за клинком, и я тебя уничтожу».~
@59645 = ~Голос Кассия доносится из глубин его тучного туловища. «Тебе нужен клинок?»~
@59646 = ~«Если захочешь обрести истинную сущность клинка, возвращайся, и мы сразимся за него. Так или иначе, мы сразимся».~
@59647 = ~«Как тебе удалось выжить?»~
@59648 = ~«Тогда правила такие. Ты должен выбрать одно из трех: сила, ум или проворность. Если ты не справишься в чем-либо из этого, я тебя уничтожу».~
@59649 = ~«Тогда мы сразимся. Выиграешь — можешь забрать клинок с моего трупа. Проиграешь — я буду пировать на твоих костях».~
@59650 = ~«Думаю, я выслушал достаточно. Я хотел бы *узнать* о другом...»~
@59651 = ~«Тогда я загадаю тебе три загадки. Если не справишься — я тебя уничтожу, сделаю из твоего черепа волынку и целую вечность буду играть песню пыток на твоей душе».~
@59652 = ~«Поговорим об этом в другой раз. Идем».~
@59653 = ~«Тогда ты должен украсть моток бинтов из тайника в моем теле. Справишься — обратись ко мне снова, и я достану клинок из тайника. Если же не справишься, пламя Ямы покажется тебе милосердным по сравнению с теми муками, которые я тебе причиню. Желаешь начать?»~
@59654 = ~Когда Даккон рассказал мне про Шракатлор, я почувствовал головокружение. Почему-то мне кажется, что я что-то *знаю* об этом месте... вот только не знаю, что именно.~
@59655 = ~«Тогда забери их. В ином случае, я буду считать, что ты добываешь клинок другим путем».~
@59656 = ~«Я выстрадал. Будучи при смерти, я *познал* себя. Я выжил. Вот и все».~
@59657 = ~«Начнем с классической загадки: что ходит утром на четырех, в полдень на двух и вечером на трех?»~
@59658 = ~«Ясно. Я хотел бы *узнать* о другом...»~
@59659 = ~«Неверно. Ты погибнешь в страшных муках».~
@59660 = ~«Тогда мы поговорим об этом в другой раз. А теперь идем».~
@59661 = ~«Верно. Вторая загадка: Могу бурчать, но рта не раскрываю, могу быть пустым, но никогда не наполняюсь. Кто я?»~
@59662 = ~«Да. Третья загадка: Что летит и не стоит на месте? Что поглощает все, чего касается, но ничего не ест? Что нельзя одолжить, но всегда можно потерять? Что всегда кончается, и его не вернуть?»~
@59663 = ~«Ты победил меня. Твой вид заставил меня думать, что твой ум соответствует твоей обезображенной наружности. Я не справился с обязанностями, и отдаю тебе клинок. Я должен покинуть это место».~
@59664 = ~Даккон ждет.~
@59665 = ~«Твоя внешность скрывает твои навыки. Воистину, ты слишком ловкий вор, чтобы я смог тебе помешать. Вот ключ. Я должен покинуть это место, чтобы скрыть свой позор».~
@59666 = ~«Ты можешь научить меня оборотам речи твоего народа?»~
@59667 = ~«Что такое 'Выбор Тча'?»~
@59668 = ~«Еще раз, что такое 'выбор Тча'?»~
@59669 = ~«Что такое 'Катцнии-у-ворот'?»~
@59670 = ~«Ты был *оружием*?»~
@59671 = ~«На вид ты неопасен...»~
@59672 = ~«Что такое 'Тонущая Ачали'?»~
@59673 = ~«Я пришел за мечом».~
@59674 = ~«Понятно. Прощай».~
@59675 = ~«Вообще-то, у меня еще другие вопросы про гитцераев...»~
@59676 = ~«Неважно. Я хотел бы *узнать* о другом...»~
@59677 = ~«Мы поговорим о языке в другой раз. Пошли».~
@59678 = ~Даккон хмурится и сужает глаза. «Я хотел бы *знать*, как ты *узнал* это выражение».~
@59679 = ~«Ты сказал его, когда мы встретили того гитцерая. Я хотел бы *знать*, что ты подразумевал».~
@59680 = ~«Забудь. У меня есть другие вопросы о языке...»~
@59681 = ~«Это неважно. У меня есть другие вопросы о гитцераях...»~
@59682 = ~«Неважно. Я хотел бы *узнать* о другом...»~
@59683 = ~«Поговорим об этом в другой раз. Идем».~
@59684 = ~«Это выражение, *знающее* много толкований».~
@59685 = ~«Тогда расскажи мне одно из них».~
@59686 = ~«У меня есть другие вопросы о языке...»~
@59687 = ~«Это неважно. У меня есть другие вопросы о гитцераях...»~
@59688 = ~«Тогда забудь. Я хочу *узнать* о других вещах...»~
@59689 = ~«Поговорим об этом в другой раз. Идем».~
@59690 = ~«'Выбор Тча' подразумевает того, у кого не было выбора в действиях».~
@59691 = ~«Значит, когда я попросит тебя рассказать о гитцераях, у тебя не было другого выхода, кроме как сделать это? Но почему?»~
@59692 = ~«Значит, когда я попросит тебя рассказать о гитцераях, у тебя не было другого выхода, кроме как сделать это? Это потому что ты мой раб?»~
@59693 = ~«У меня есть другие вопросы о языке...»~
@59694 = ~«Это неважно. У меня есть другие вопросы о гитцераях...»~
@59695 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59696 = ~«Это все, что я хотел узнать. Идем».~
@59697 = ~Клинок Даккона покрывается волнами, и ты наблюдаешь, как его кромка сереет и тупеет. Он произносит сквозь стиснутые зубы: «Я *не желаю* говорить об этом».~
@59698 = ~«Я хочу услышать, что ты об этом скажешь... На самом деле, в том разговоре ты упомянул много вещей, которые меня заинтересовали».~
@59699 = ~«У меня есть другие вопросы о языке...»~
@59700 = ~«Тогда неважно. У меня есть другие вопросы о гитцераях...»~
@59701 = ~«Хорошо. Я хотел бы *узнать* кое-что еще...»~
@59702 = ~«Тогда не будем больше об этом. Идем».~
@59703 = ~«*Знай*, что твоя воля становится моей *волей*. Когда ты говоришь, *знай*: я должен тебя выслушать. *Знай*, что твои слова могут остановить мой клинок или направить его к чьему-то горлу».~
@59704 = ~«Что? Но почему?»~
@59705 = ~«Да».~
@59706 = ~«Нет».~
@59707 = ~«На самом деле, я просто хотел уйти».~
@59708 = ~«У меня есть другие вопросы о языке...»~
@59709 = ~«У меня есть еще несколько вопросов о гитцераях...»~
@59710 = ~«Почему ты ушел?»~
@59711 = ~«Хорошо. Что ж, я пришел за мечом».~
@59712 = ~«Ладно. Я уже ухожу».~
@59713 = ~«Тогда мы поговорим об этом в следующий раз. Я хотел бы *узнать* о другом...»~
@59714 = ~«Я порядком наслушался. Пошли».~
@59715 = ~«Я пришел за клинком».~
@59716 = ~Даккон смотрит сквозь тебя, как будто твой взгляд для него невыносим. «У нас один путь. Я прикован к тебе».~
@59717 = ~«Ты мог бы убить меня?»~
@59718 = ~«Ты мой раб?»~
@59719 = ~«Понятно. Прощай».~
@59720 = ~При слове «раб» лицо Даккона искажается от боли, как будто его ударили... как будто это слово — кинжал, который вонзился в самое сердце его страданий. ~
@59721 = ~«Но... почему, Даккон?»~
@59722 = ~«По правде говоря, я пришел за клинком».~
@59723 = ~«*Знай*: это... длинная история. *Знай*, что из нее ты не извлечешь ничего полезного».~
@59724 = ~«Я хотел бы, чтобы ты попробовал».~
@59725 = ~«Я хотел бы ее услышать».~
@59726 = ~«Нет. Вообще-то, я уже ухожу».~
@59727 = ~«Тогда неважно. У меня есть другие вопросы о языке...»~
@59728 = ~«Ну ладно. У меня есть другие вопросы о гитцераях...»~
@59729 = ~«Я пришел за клинком».~
@59730 = ~«Забудь. Я ухожу».~
@59731 = ~«Тогда забудь. Я хочу *узнать* о других вещах...»~
@59732 = ~«Тогда не будем больше об этом. Идем».~
@59733 = ~«Сперва расскажи о себе».~
@59734 = ~«Да».~
@59735 = ~«Да. Я уже украл у тебя бинты. Неужели ты думаешь, что сможешь помешать мне украсть клинок, если я задамся такой целью?»~
@59736 = ~«Отлично. Прощай».~
@59737 = ~Ради клинка я решил помериться силами. Кассий силен, и угрожает попировать на моих костях, если я проиграю.~
@59738 = ~Мы с Кассием решили испытать мою сообразительность. Он загадает мне три загадки. Если справлюсь — получу клинок. Если не справлюсь, он угрожает соорудить музыкальный инструмент из моих костей и души.~
@59739 = ~Мы с хранителем меча Кассием решили испытать мое проворство. Если я смогу выкрасть из его тучного туловища моток бинтов, мне следует снова поговорить с ним, и он отдаст мне клинок. Если я не справлюсь с этим, он угрожает уничтожить меня.~
@59740 = ~Я победил Кассия, хранителя клинка в тюрьме Проклятого, в умственной дуэли. Его вопросы были на удивление просты.~
@59741 = ~Я победил Кассия, хранителя клинка в тюрьме Проклятого, в дуэли на проворность. Он был удивительно медленным.~
@59742 = ~Похоже, я не понимаю, что означает Первый Круг в Неразрывном Круге Зертимона, или так говорит мне Даккон. Мне кажется, что смысл находится за тем, что начертано на камне... Возможно, мне придется немного разобраться с учением Зертимона, прежде чем я пойму Путь Зертимона.~
@59743 = ~Я пришел к пониманию Первого Круга Зертимона, использовав собственную мудрость при чтении текста. В ответ Даккон открыл мне следующий Круг Зертимона. Думаю, что он намерен обучать меня Неразрывному Кругу поэтапно, раскрывая каждый Круг после того, как я пойму предыдущий.~
@59744 = ~Даккон согласился обучать меня Пути Зертимона. Он раскрыл мне Неразрывный Круг Зертимона и сказал мне изучить его и *познать* историю Народа.~
@59745 = ~Отвратительный толстяк в центре тюрьмы вызвал меня на бой за клинок. Он сказал, что сущность клинка находится в нем, и если он мне нужен, мне придется с ним сразиться.~
@59746 = ~«Я выбираю силу».~
@59747 = ~«Я выбираю ум».~
@59748 = ~«Я выбираю проворность».~
@59749 = ~«Забудь. Я вернусь позже».~
