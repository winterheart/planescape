@16985 = ~«Это устройство закончат хоть когда-нибудь?»~
@16986 = ~«ТЫ ЧТО ТВОРИШЬ?»~
@16987 = ~«Скоро уже перерыв?»~
@16988 = ~«Почти закончил с этой стороны».~
@16989 = ~«УХ! Затягивай СИЛЬНЕЕ!»~
@16990 = ~«Забудь. Прощай, Скорбящий-по-деревьям».~
@16991 = ~«Улей — место Хаоса и упадка. Я надеюсь, что возрождение деревьев принесет сюда ощущение порядка».~
@16992 = ~«Запрошенное желание будет выполнено незамедлительно».~
@16993 = ~«Улей — место Хаоса и упадка. Я надеюсь, что возрождение деревьев принесет сюда ощущение порядка».~
