@9492 = ~0200dm9~
@9493 = ~0200df1~
@9494 = ~0200df2~
@9495 = ~0200df5~
@9496 = ~0200mrn1~
@9497 = ~«Добро пожаловать в 'Тлеющий труп'!»~
@9498 = ~0200mrn2~
@9499 = ~«Похоже, это действительно больно».~
@9500 = ~0200mrn3~
@9501 = ~0200mrn4~
@9502 = ~0200mid~
@9503 = ~0200thgv~
@9504 = ~«Угости девушку коктейлем, человек со шрамом!»~
@9505 = ~«Если заткнуть нос, то это неплохое место для берлоги».~
@9506 = ~«Ты бестолочь?»~
@9507 = ~«Пришел посмотреть, как он горит?»~
@9508 = ~«Что-то слишком безлюдно сегодня ночью... но не настолько безлюдно, как в Морге».~
@9509 = ~«Для планаров Сигил — всего лишь огромное крысиное гнездо».~
@9510 = ~«Ты в самом деле думаешь, что силы считают это важным?»~
@9511 = ~«О чем это ты?»~
@9512 = ~«Какое это отношение имеет к Сигилу?»~
@9513 = ~«Люди считают это место важным. А мы — всего лишь винтики в огромной машине. Мы — крысы».~
@9514 = ~«Нет. Это ТЫ крыса. Планы позволяют тебе быть настолько большим, насколько ты хочешь. А ты вообще ничего не хочешь».~
@9515 = ~«Не знаю, зачем я трачу на тебя свое время».~
@9516 = ~«И я тоже».~
@9517 = ~«Проклятье. Эта часть не подходит».~
@9518 = ~«На помощь! Пожалуйста, кто-нибудь, помогите!»~
@9519 = ~«Прыгай, лим-лим, прыгай!»~
@9520 = ~«Вооруженный вояка — *живой* вояка!»~
@9521 = ~«Холодная, острая как бритва сталь! Всего за несколько медяков!»~
@9522 = ~«Сталь не хуже, чем у клинков Боголюдей!»~
@9523 = ~«Лучшее оружие во всем Сигиле!»~
@9524 = ~«Если в них ткнуть угольком, то они могут прыгать аж на пятнадцать футов!»~
@9525 = ~«Смотрите, как эти восхитительные создания прыгают и танцуют!»~
@9526 = ~«Посмотрите на веселого лим-лима!»~
@9527 = ~«Оловянные кружки!»~
@9528 = ~«Латунные тарелки! Жестяные чаши!»~
@9529 = ~«Ешьте с посуды аристократов!»~
@9530 = ~«Пейте из кубков высочайших лордов!»~
@9531 = ~«Тарелки! Кувшины! Чаши! Кружки!»~
@9532 = ~«Вещи за смехотворную цену!»~
@9533 = ~«Честные сделки, большие скидки!»~
@9534 = ~«Не тратьте попусту свое время с этими мошенниками и лгунами!»~
@9535 = ~«Лучшие товары во всем Сигиле!»~
@9536 = ~«Свежие рыбьи головы!»~
@9537 = ~«Свеееежая рыбааа!»~
@9538 = ~«Рыбьи головы!»~
@9539 = ~0100dab4~
@9540 = ~0100dab3~
@9541 = ~0100dab2~
@9542 = ~0100dab1~
@9543 = ~«Гискорл продает одежду, покупает одежду».~
@9544 = ~«Гискорл стирает одежду, носит одежду».~
@9545 = ~«Гискорл продает одежду, покупает одежду».~
@9546 = ~«Я, Гискорл».~
@9547 = ~«Потратьте ваши деньги ради ваших ощущений!»~
@9548 = ~«Королевский пир за небольшую цену!»~
@9549 = ~«Образцы трав и специй, которые поразят вкус!»~
@9550 = ~«Зерно из Байтопии! Переменчивая специя из Лимбо!»~
@9551 = ~«Арборейские огненные семена! Фрукты из Элизиума!»~
@9552 = ~«За этими отличнейшими травами, специями и фруктами не нужно никуда путешествовать!»~
@9553 = ~Одержимый труп кричит нараспев, громкость и тон его голоса беспорядочно меняются. «ТЫ — ДУХ, Я — ЖИВОЙ, это ТЫ ответишь на вопросы мои!» Кажется, твой смущенный вид ему понравился. Он вставляет в рот свои костяные пальцы и растягивается его в зловещей усмешке, одержимо смеясь и высовывая мясистый белый язык.~
@9554 = ~На мгновение дух успокаивается, затем взрывается потоком громкого, сводящего с ума бессмысленного бормотания. Какофония сводит с ума, угрожая поставить тебя на колени. Так же внезапно, как и началось, все ... прекращается. Труп стоит, тихо подергиваясь.~
@9555 = ~Дух снова кричит нараспев: «На вопросы ЖИВЫХ МЕРТВЫЙ ответит. ТАК было, так ЕСТЬ и будет ТАК. На мои ОТВЕТЫ ты задашь вопросы!» Выражение твоего лица очень ему нравится; он пускается в такой дикий пляс, что ты уже начинаешь сомневаться, что труп вынесет такое обращение над собой. Пока он скачет, ты даже слышишь грохот и треск костей и звук лопающихся сухожилий.~
@9556 = ~Покидая тело, дух растягивает губы в понимающей улыбке. Его дикие сверкающие глаза впиваются в тебя пронизывающим взглядом психопата. Он шепчет одно единственное слово, старательно произнося каждую букву, будто перебирает жемчужное ожерелье: «Лимбо...» ~
@9557 = ~...и он уходит, оставляя тебя в нерешительности и некоторой запутанности. Зомби молча возвращается к своей работе.~
@9558 = ~Оставить духа в покое.~
@9559 = ~«Хорошо... задавай свои вопросы».~
@9560 = ~«Нет. Это я хотел задать *тебе* вопрос...»~
@9561 = ~Оставить в покое беспокойного духа.~
@9562 = ~«Я не совсем уловил последнюю часть. Ты можешь повторить это еще раз?»~
@9563 = ~«Я не понимаю. Тем не менее, у меня есть вопрос...»~
@9564 = ~«Я тебя не понимаю. Прощай».~
@9565 = ~«Ну хорошо... задавай свои вопросы».~
@9566 = ~«Ты не понимаешь. У меня вопрос к *тебе*...»~
@9567 = ~Махнуть рукой и оставить в покое бормочущего духа.~
@9568 = ~«Что?»~
@9569 = ~Не обращать на него внимания, отвернуться.~
@9570 = ~«*Вздох*...»~
