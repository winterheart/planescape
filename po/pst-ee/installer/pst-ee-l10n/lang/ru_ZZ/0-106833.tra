@35738 = ~«Спасибо, прощай».~
@35739 = ~«У меня есть несколько вопросов...» ~
@35740 = ~«Спасибо, прощай».~
@35741 = ~«О? И почему?»~
@35742 = ~«У меня есть несколько вопросов...» ~
@35743 = ~«Ясно. Я должен идти. Прощай».~
@35744 = ~«Какие тайны?»~
@35745 = ~«У меня есть несколько вопросов...» ~
@35746 = ~«Ясно. Я должен идти. Прощай».~
@35747 = ~«У меня есть другие вопросы...»~
@35748 = ~«Думаю, так оно и есть. Прощай».~
@35749 = ~«Я пытаюсь найти пропавший у нее документ».~
@35750 = ~«Неважно, у меня  к тебе есть другие вопросы».~
@35751 = ~«Ничего. Прощай».~
@35752 = ~«Убийцами милосердия?»~
@35753 = ~«Они могли что-нибудь упустить».~
@35754 = ~«У меня есть другие вопросы...»~
@35755 = ~«Я должен идти. Прощай».~
@35756 = ~«Они могли что-нибудь упустить».~
@35757 = ~«Понятно. У меня есть другие вопросы...»~
@35758 = ~«Кто-то мог выкрасть документ и уничтожить его. Таким образом, долг пришлось бы выплатить дважды...»~
@35759 = ~«Кто-то мог выкрасть документ... Может, даже уничтожить его».~
@35760 = ~~
@35761 = ~~
@35762 = ~Я думаю, что Байрон Пикит украл кое-какие документы у женщины по имени Трист. Без них она не может доказать, что выплатила долг, и ее должны продать в рабство, чтобы покрыть его.~
@35763 = ~«Да... как жаль. Тогда объясни, зачем продавать Трист в рабство? Разве она не могла выплатить тебе долг деньгами?»~
@35764 = ~«Что ж, если существуют какие-нибудь доказательства, я собираюсь найти их».~
@35765 = ~«У меня есть другие вопросы...»~
@35766 = ~«Думаю, я выслушал достаточно. Прощай».~
@35767 = ~Я сказал Байрону Пикиту, что собираюсь найти пропавший документ Трист.~
@35768 = ~«У меня есть другие вопросы...»~
@35769 = ~«Понятно. Мне нужно идти. Прощай».~
@35770 = ~Уйти.~
@35771 = ~Уйти.~
@35772 = ~«У меня свои причины».~
@35773 = ~«Он выкрал у меня череп».~
@35774 = ~«Неважно, прощай».~
@35775 = ~Уйти.~
@35776 = ~«Мне все равно нужно его найти».~
@35777 = ~«Каким же сильным должен быть этот человек?»~
@35778 = ~«Ясно. Я должен идти. Прощай».~
@35779 = ~«Мне все равно нужно его найти».~
@35780 = ~«Ясно. Я должен идти. Прощай».~
@35781 = ~«Почему?»~
@35782 = ~«Спасибо, я должен идти. Прощай».~
@35783 = ~«Где мне найти этого Лотара?»~
@35784 = ~«Спасибо, прощай».~
@35785 = ~«У меня есть несколько вопросов...» ~
@35786 = ~«У меня есть несколько вопросов...» ~
@35787 = ~«Я хотел бы поговорить с тобой насчет Трист».~
@35788 = ~«Неважно, прощай».~
@35789 = ~«Расскажи мне об открытом рынке».~
@35790 = ~«У меня есть другие вопросы...»~
@35791 = ~«Спасибо, прощай».~
@35792 = ~Ты видишь шумного аукциониста. Он ведет себя очень оживленно, много кричит и топает ногами. Похоже, он склонен к театральности: его лицо принимает множество странных выражений при каждом взмахе его рук...~
@35793 = ~Он бросает на тебя взгляд и делает толпе знак, что он берет перерыв. «О, шлю вам тысячу приветствий, сэр! — заметив твои шрамы, он запоздало реагирует. — Знаете ли, я окинул вас своим проницательным взглядом, и увидел человека, который пришел на рынок за целительными амулетами».~
@35794 = ~Он бросает на тебя изумленный взгляд, и грациозным жестом указывает на себя. «Есть ли у меня, Дерана, амулеты? — для эффектности он выдерживает паузу. — Нет, сэр... однако пусть вас не огорчает сей факт. У меня есть множество других товаров на продажу». Он указывает на заднюю часть помоста, где стоит группа людей в цепях.~
@35795 = ~Он качает головой. «Нет, сэр! Это не рабы, а слуги, работающие по договору. В большинстве своем они виновны в мелких преступлениях. Доход от их продажи идет на оплату их долга перед городом. По истечению срока своей службы они снова будут свободными гражданами».~
@35796 = ~Он дарит тебе ослепительную улыбку. «Я не тревожу себя такими мыслями. Моя задача — продавать их договора согласно постановлениям сигильского суда, — он понижает голос и наклоняется ближе к тебе. — А также отчислять процент за свои хлопоты, ну вы понимаете». Он выпрямляется.~
@35797 = ~Он качает головой. «Тогда вы тратите этим разговором свое и мое время».~
@35798 = ~Он широко улыбается, затем хохочет. «Отлично, покажите мне это доказательство». Он протягивает тебе руку.~
@35799 = ~Он открывает расписку и пробегается по ней. Через миг он вздыхает, складывает документ и прячет его в рубаху. «Похоже, суд должен принести свои извинения леди Трист. Отныне она свободна, и я приму все меры, чтобы к ней вернулись ее положение и имущество».~
@35800 = ~«Нет, это вам спасибо. Мало кто сделал бы то, что сделали вы, — он кланяется тебе. — Извините, мне нужно поговорить с леди Трист. Счастливо». Он направляется к Трист.~
@35801 = ~Он выразительно пожимает плечами. «Я точно не знаю, но думаю, это воровство, насилие и неспособность расплатиться с долгами. Это самые распространенные нарушения».~
@35802 = ~Он качает головой. «Нет времени на такую чепуху, дружище. Нужно делать дело! Говорите быстро!» ~
@35803 = ~Null node.~
@35804 = ~Он смотрит на тебя с притворным беспокойством. «То, что я могу рассказать вам, дружище, представляет опасность... Я не хочу подвергать вас риску».~
@35805 = ~Он издает громогласный хохот. «Хорошо, дружище. Лотар — повелитель и владелец знаменитых Костей Ночи. Мертвые из тамошней коллекции служат ему хранилищем тайных знаний. Все мертвецы Сигила и планов нашептывают ему тайны в его Салоне Черепов».~
@35806 = ~«Поищите в юго-восточной части района... вы наткнетесь на разрушенный дом, и там будет лестница из костей, ведущая вниз. Она должна привести вас в Салон Черепов».~
@35807 = ~Он улыбается. «Нет, дружище, у меня больше нет ответов для вас. Я и так сказал слишком много того, о чем не следует говорить. Я должен вернуться к своим покупателям». Он отворачивается от тебя.~
@35808 = ~«Череп? — похоже, ты его озадачил. — На них небольшой спрос, по крайней мере, на тех, которых отделили от тела...» Он хмурится, потом поворачивается к тебе; его голос драматично стихает. «Если только, конечно...»~
@35809 = ~«Ну, пропажа черепа может оказаться очень серьезным делом, и очень опасным. Видите ли, если кто-то хочет продать череп, выбор покупателей в Сигиле у него невелик... — он делает паузу. — И почти наверняка, дружище, одним из них окажется... — он смотрит налево, потом направо, потом обращается к тебе заговорщическим шепотом. — Сам Лотар, Повелитель Костей!»~
@35810 = ~Он грациозным жестом обводит вокруг себя. «Это, сэр, Нижний район. Жилище простого народа, мало чем интересное. Единственные вещи, стоящие упоминания — это Литейная, открытый рынок и осадная башня».~
@35811 = ~Он разводит руки и смотрит в небо. «Мастерская всего сущего, где сталь и душа человека превращаются в произведения искусства, в чьих стенах изменяется само мироздание... — он обращает свой взор на тебя. — Так говорят боголюди».~
@35812 = ~Он улыбается. «Благородная фракция: каждый может стать богом — нужно просто узнать достаточно много в течении своей жизни, и тогда ты вырастешь, станешь совершеннее и укрепишь свой дух! Можете себе представить более благородную фракцию?»~
@35813 = ~«Настоящая загадка, даже для меня. Однажды она попросту появилась из ниоткуда. Никто не может в нее войти, и никто ее не покидал».~
@35814 = ~«Рынок простирается на юге; он может удовлетворить почти любые запросы. Рекомендую посетить его».~
@35815 = ~Он громко смеется и разводит руки, будто хочет охватить весь город. «Знаменитый город золота, город с дверьми, ведущими куда угодно, — он улыбается и водит бровями, — и в который ведет каждая дверь! О Сигиле невозможно рассказать — его нужно прожить!»~
@35816 = ~Ты видишь аукциониста Дерана. Он улыбается, когда ты подходишь к нему. «Еще раз здравствуйте! Что я могу для вас сделать в этот славный задымленный денек?»~
@35817 = ~Он выдает печальную улыбку. «Я больше не стану отвечать на ваши вопросы, сэр. Я и так подверг нас обоих опасности, и не вижу причины продолжать в том же духе...»~
@35818 = ~«Меня зовут Деран, дружище! Как могло статься, что вы обо мне не слышали? Я оскорблен, еще как! — он улыбается еще сильнее, при этом изображая обиду. — Нет никого лучше и известнее, кто мог бы собрать вместе тех, которые нуждаются в людях, — он указывает на дальний конец помоста, где стоит группа людей в цепях. — Вы кого-нибудь хотите, дружище?»~
@35819 = ~Он недолго хмурится, потом пожимает плечами. «Хорошо, сэр. Что насчет Трист?»~
@35820 = ~Он хмурится. «Конечно, сэр... Если вы удовлетворяете требованиям, установленным судом Сигила, и можете позволить себе это». Он улыбается тебе.~
@35821 = ~Он начинает загибать пальцы на руке. «Во-первых, вы должны быть жителем Сигила. Во-вторых, вы должны представить доказательство постоянного места жительства, а также того, что вы можете предоставить слуге жилье и средства к существованию. И последнее: за вами не должно числиться преступлений».~
@35822 = ~Он дарит тебе широкую улыбку и указывает на толпу неподалеку. «Я начну торги с пяти сотен медяков, сэр».~
@35823 = ~Он смотрит на тебя с напускной печалью, качая головой. «Она будет продана тому, кто сделает наибольшую ставку, сэр. Таков закон».~
@35824 = ~Он смеется и насмешливо смотрит на тебя. «Как судебный представитель, я могу передать суду новое доказательство, и все обвинения против Трист будут пересмотрены. У вас есть такое доказательство?»~
@35825 = ~Он кивает. «Вы намерены искать эти доказательства от имени госпожи Трист?»~
@35826 = ~Он некоторое время внимательно смотрит на тебя, пытаясь оценить твою серьезность. «Хорошо. Я пока не буду выставлять Трист на аукцион, сэр. Удачи в поисках. А теперь оставьте меня и приступайте к делу».~
@35827 = ~Он вздыхает, потом мрачно смотрит на тебя. «А вы бы говорили иначе, будь вы на ее месте? — он качает головой. — Я слышал ее историю, сэр. И хотя я сочувствую леди, я мало что могу для нее сделать без оправдывающих ее доказательств».~
@35828 = ~Лестница на третий этаж~
@35829 = ~Лестница на второй этаж~
@35830 = ~Лестница на первый этаж~
@35831 = ~Лестница на второй этаж~
@35832 = ~На улицу Протяжных вздохов~
@35833 = ~Назад в Улей~
@35834 = ~«Приветствую».~
@35835 = ~Не обращать на него внимания.~
@35836 = ~«У тебя есть амулеты?»~
@35837 = ~«У меня есть несколько вопросов...» ~
@35838 = ~«Неважно. Прощай».~
@35839 = ~«Ты продаешь рабов?»~
@35840 = ~«У меня есть вопросы к тебе...»~
@35841 = ~«Я должен идти. Прощай».~
@35842 = ~Правда: «Мне это все равно кажется рабством».~
@35843 = ~Правда: «Похоже, это неплохой способ выплатить свой долг перед обществом».~
@35844 = ~Правда: «Как знаешь, мне все равно».~
@35845 = ~«Ты сказал, что они виновны в преступлениях, так в чем же они виновны?»~
@35846 = ~«У меня есть вопросы к тебе...»~
@35847 = ~«Я должен идти. Прощай».~
@35848 = ~«Ясно... У меня есть другие вопросы к тебе...»~
@35849 = ~«Я должен идти. Прощай».~
@35850 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@35851 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@35852 = ~«Я хотел бы спросить тебя насчет Трист».~
@35853 = ~«Кто ты?»~
@35854 = ~«Можешь рассказать об этом районе?»~
@35855 = ~«Что ты можешь рассказать о Сигиле?»~
@35856 = ~«Я должен идти. Прощай».~
@35857 = ~«Так уж вышло, что я люблю рисковать. Дерзай».~
@35858 = ~«Понятно. У меня есть другие вопросы...»~
@35859 = ~«Мне нужно идти. Прощай».~
@35860 = ~«Где можно найти это место?»~
@35861 = ~«Спасибо. У меня есть другие вопросы...»~
@35862 = ~«Я уже должен идти. Прощай».~
@35863 = ~«Понятно. Прощай».~
@35864 = ~«Продолжай...»~
@35865 = ~«Расскажи мне о Литейной».~
@35866 = ~«Расскажи мне об осадной башне».~
@35867 = ~«Расскажи мне об открытом рынке».~
@35868 = ~«У меня еще вопросы...»~
@35869 = ~«Спасибо, прощай».~
@35870 = ~«Боголюди?»~
@35871 = ~«Расскажи мне об осадной башне».~
@35872 = ~«Расскажи мне об открытом рынке».~
@35873 = ~«У меня еще вопросы...»~
@35874 = ~«Спасибо, прощай».~
@35875 = ~«Расскажи мне об осадной башне».~
@35876 = ~«Расскажи мне об открытом рынке».~
@35877 = ~«У меня еще вопросы...»~
@35878 = ~«Спасибо, прощай».~
@35879 = ~«Расскажи мне о Литейной».~
@35880 = ~«Расскажи мне об открытом рынке».~
@35881 = ~«У меня еще вопросы...»~
@35882 = ~«Спасибо, прощай».~
@35883 = ~«Расскажи мне о Литейной».~
@35884 = ~«Расскажи мне об осадной башне».~
@35885 = ~«У меня еще вопросы...»~
@35886 = ~«Спасибо, прощай».~
@35887 = ~«У меня еще вопросы...»~
@35888 = ~«Спасибо, прощай».~
@35889 = ~«У меня есть несколько вопросов...» ~
@35890 = ~«У меня есть несколько вопросов...» ~
@35891 = ~«Я хотел бы спросить тебя насчет Трист».~
@35892 = ~«Ничего, прощай».~
@35893 = ~Уйти.~
@35894 = ~«Ты продаешь рабов?»~
@35895 = ~«У меня есть другие вопросы...»~
@35896 = ~«Нет, спасибо, прощай».~
@35897 = ~«Могу ли я выкупить ее договор?»~
@35898 = ~«Она говорит, что она не должна быть здесь».~
@35899 = ~«У меня есть доказательство того, что она ни в чем невиновна».~
@35900 = ~«Неважно. Прощай».~
@35901 = ~«Каковы эти требования?»~
@35902 = ~«Неважно. Прощай».~
@35903 = ~«Понятно... Сколько стоит ее договор?»~
@35904 = ~«Что, если я могу доказать, что она невиновна в том, в чем ее обвиняют?»~
@35905 = ~«Неважно. Прощай».~
@35906 = ~«Что, если я хочу выкупить ее договор без торгов?»~
@35907 = ~«Ясно... Какие требования к тому, кто хочет купить слугу?»~
@35908 = ~«Что, если я могу доказать, что она невиновна в том, в чем ее обвиняют?»~
@35909 = ~«Неважно. Прощай».~
@35910 = ~«Не в этот раз».~
@35911 = ~«Да».~
@35912 = ~«Да».~
@35913 = ~«Я не знаю...» ~
@35914 = ~«Спасибо, прощай».~
@35915 = ~«Что, если я докажу, что она невиновна?»~
@35916 = ~«Хорошо, я собираюсь помочь ей».~
@35917 = ~«Ты прав, прощай».~
@35918 = ~Дать ему расписку.~
@35919 = ~«Неважно. Прощай».~
@35920 = ~«Спасибо, Деран».~
@35921 = ~«Прощай».~
@35922 = ~В ответ на твое приветствие человек немного поворачивается, как раз настолько, чтобы увидеть тебя. Ты замечаешь, что у него бледноватый оттенок лица и довольно изможденный вид. Он бросает на тебя бесстрастный взгляд. Похоже, хозяин лавки всего этого не замечает и продолжает лить потоки бесполезной болтовни.~
@35923 = ~Не обращать на него внимания.~
@35924 = ~«У меня есть несколько вопросов...» ~
@35925 = ~«Ты... в порядке?»~
@35926 = ~«Прощай».~
@35927 = ~Человек медленно поворачивается обратно к владельцу лавки и кивает в ответ на что-то. Кажется, кивок немного запоздал по отношению к разговору, но лавочник не придает этому значения. Человек медленно поворачивается к тебе, глядя на тебя без выражения.~
@35928 = ~«Ты... в порядке?»~
@35929 = ~«Неважно. Прощай».~
@35930 = ~Человек продолжает пристально смотреть на тебя и медленно кивает. Ты ожидаешь ответа, но он не отвечает, а только смотрит. Ты уже собираешься разочаровано отвернуться, как вдруг тебе начинает казаться, что ты улавливаешь идущий от него странный запах плесени.~
@35931 = ~Подойти поближе и принюхаться.~
@35932 = ~Не обращать на него внимания и уйти.~
@35933 = ~Ты подходишь и принюхиваешься к нему, не зная, чего ожидать. При этом все твои чувства заполняет запах плесени, запах, хорошо тебе знакомый со времен пребывания в морге. Это запах мертвой плоти, удерживаемой от разложения магией.~
@35934 = ~«Ты зомби, не так ли?»~
@35935 = ~«Ты зомби, не так ли?»~
@35936 = ~Человек снова медленно кивает тебе, затем переключает внимание на владельца лавки. Он не реагирует на все дальнейшие попытки заговорить с ним.~
@35937 = ~«Прощай».~
@35938 = ~Существо продолжает безучастно пялиться на тебя. Медленно, будто прилагая огромные усилия, он отвечает тебе. Только твоя способность разговаривать с мертвыми позволяет тебе понимать его. «Да... я... Димтри».~
@35939 = ~«Зачем ты здесь находишься, Димтри?»~
@35940 = ~«У меня есть несколько вопросов...» ~
@35941 = ~«Прощай».~
@35942 = ~Димтри медленно обращает взгляд на лавочника и делает немощный жест в его сторону. Расценив это как проявление интереса, лавочник удваивает свои усилия в донесении какой-то там истории бедному созданию. Димтри снова смотрит на тебя. «Хамрис... Он болтает... Хамрис никогда не умолкает... Бродит по городу... надоедает хозяину, надоедает всем подряд... Хозяин создает Димтри... Приказывает Димтри разговаривать с Хамрисом... Теперь Хамрис остается в лавке... Хозяин доволен... город доволен. Димтри опечален...»~
@35943 = ~«Я могу тебе чем-нибудь помочь, Димтри?»~
@35944 = ~«У меня есть вопросы к тебе...»~
@35945 = ~«Прощай, Димтри».~
@35946 = ~Существо умолкает, затем возобновляет свою долгую беседу с тобой. Ты почти различаешь в его голосе нотки мольбы. «Да... Найди хозяина... Себастиона... Попроси освободить меня... Пожалуйста... — он быстро поворачивается к Хамрису. — Прошу...»~
@35947 = ~«Почему бы мне просто не избавить тебя от страданий?»~
@35948 = ~«Не знаю... Я подумаю об этом. У меня есть еще вопросы...»~
@35949 = ~«Прощай».~
@35950 = ~Димтри с трудом качает тебе головой. «Нет... Хозяин оживит... Нужно попросить хозяина... Себастиона... пожалуйста». Он ждет твоего ответа.~
@35951 = ~«Конечно, Димтри. Посмотрим, что я смогу для тебя сделать».~
@35952 = ~«Извини, Димтри. Это не моя работа, понимаешь?»~
@35953 = ~«Не знаю... Я подумаю об этом. У меня есть еще вопросы...»~
@35954 = ~«Прощай».~
@35955 = ~Я согласился помочь зомби Димтри. Я должен найти некоего Себастиона и попросить его избавить Димтри от его теперешнего состояния.~
@35956 = ~Ты почти ощущаешь чувство облегчения, исходящее от зомби. «Димтри... благодарит тебя, друг...»~
@35957 = ~«Не за что. У меня несколько вопросов...»~
@35958 = ~«Прощай, Димтри».~
@35959 = ~Ты ощущаешь в воздухе чувство досады, когда Димтри отворачивается от тебя. Он снова начинает кивать лавочнику, который даже на секунду не остановил свой поток слов на протяжении всего вашего разговора.~
@35960 = ~Уйти.~
@35961 = ~Существо делает едва различимое движение плечами. «Ничего... не знаю... Димтри вызвал... хозяин... Был в темноте... мире.. покое... Потом Хамрис... Извини... помогу... если смогу...»~
@35962 = ~«Ты не знаешь, где мне найти Себастиона?»~
@35963 = ~«Понятно... Тогда прощай».~
@35964 = ~Высокий худощавый человек все еще разговаривает с лавочником. Тем не менее, из них двоих говорит только лавочник.~
@35965 = ~«Приветствую».~
@35966 = ~«Просто хотел оказать знак уважения... прощай».~
@35967 = ~«У меня есть несколько вопросов...» ~
@35968 = ~Игнорировать его.~
@35969 = ~Когда ты подходишь, Димтри слегка поворачивается к тебе. Ты чувствуешь, как в воздухе над ним повисло чувство ожидания. «Ты... нашел хозяина? Освободишь Димтри?»~
@35970 = ~«Ты не знаешь, где мне найти Себастиона?»~
@35971 = ~«Пока нет, Димтри. Я продолжаю работать над этим. Прощай».~
@35972 = ~Существо останавливается. «Не знаю... Помню голос... отдает приказ быть здесь... Иду к... Хамрису... Больше ничего... Извини».~
@35973 = ~«Понятно, что ж, прощай».~
@35974 = ~Когда ты подходишь, Димтри слегка поворачивается к тебе. Ты чувствуешь, как в воздухе над ним повисло чувство ожидания. «Ты... нашел хозяина? Освободишь Димтри?»~
@35975 = ~«Да, Димтри. Теперь я знаю, как тебя освободить».~
@35976 = ~«Не сейчас, я должен идти. Прощай».~
@35977 = ~Димтри поворачивается к тебе и показывает в твою сторону. «Пожалуйста, друг...»~
@35978 = ~Произнести слова, которым научил тебя Себастион.~
@35979 = ~«Не сейчас. Прощай».~
@35980 = ~Ты делаешь паузу, чтобы собраться с мыслями, затем осторожно произносишь слова, которым научил тебя Себастион. Ты протягиваешь руку и легонько касаешься лба Димтри.~
@35981 = ~«Покойся с миром, Димтри».~
@35982 = ~Со вздохом зомби оседает у твоих ног. Кажется, ты слышишь мимолетное *спасибо, друг*, когда он падает на землю.~
@35983 = ~Уйти.~
@35984 = ~Димтри поворачивается к тебе. «Ты... поможешь? Ты... найди Себастиона... освободи меня...»~
@35985 = ~«Хорошо, я помогу тебе».~
@35986 = ~«Нет, это не моя проблема».~
@35987 = ~«Не знаю, я подумаю над этим. Прощай».~
@35988 = ~Я встретил девушку по имени Карина. Она слишком много болтает и порой несет чепуху, и все же она милая. Она сказала мне, что ей одиноко.~
@35989 = ~Ты почти ощущаешь чувство облегчения, исходящее от зомби. «Димтри... благодарит тебя, друг...»~
@35990 = ~«Где я могу найти Себастиона?»~
@35991 = ~«Не за что. Прощай».~
@35992 = ~Димтри поворачивается к тебе. «Зачем ты здесь... Ты отказался помочь... Ты передумал... найди Себастиона... освободи меня... пожалуйста...»~
@35993 = ~«Хорошо, я помогу тебе».~
@35994 = ~«Нет, это не моя проблема».~
@35995 = ~«Не знаю, я подумаю над этим. Прощай».~
@35996 = ~Эта высокая стройная женщина, потягивающая вино из маленькой керамической чаши, похоже, кого-то ищет. Черты ее лица изящны и экзотичны, а ее уши, хотя и частично прикрытые волосами, заметно заострены на концах.~
@35997 = ~~
@35998 = ~«Приветствую».~
@35999 = ~~
@36000 = ~~
@36001 = ~Ты видишь девушку. У нее хмурое выражение лица; она выглядит расстроенной. Когда ты подходишь, она презрительно произносит: «И что же тебе понадобилось?»~
@36002 = ~«Приветствую».~
@36003 = ~Игнорировать ее.~
@36004 = ~Она хмурится и кладет руки на пояс. «Отвали, пень! Пойди-ка, прогуляйся по короткой дороге окружным путем».~
@36005 = ~«Что это значит?»~
@36006 = ~«У меня есть несколько вопросов...» ~
@36007 = ~«У тебя проблемы с общением».~
@36008 = ~«Хорошо, думаю, мне пора. Прощай».~
@36009 = ~Она обнажает зубы и делает тебе неприличный жест. «Это значит: исчезни, алкаш! Мне нечего тебе сказать». Она смотрит на тебя вызывающе.~
@36010 = ~«У меня есть несколько вопросов...» ~
@36011 = ~«Хорошо, думаю, мне пора. Прощай».~
@36012 = ~Она зловеще усмехается тебе. «А у меня есть для тебя ответ... Иди, посиди на коле!» Она показывает тебе еще один грубый жест.~
@36013 = ~«У тебя проблемы с общением».~
@36014 = ~«Хорошо, думаю, мне пора. Прощай».~
@36015 = ~Она смеется. «Ага, и это я еще не разогрелась. А теперь засунь себе этот кол туда, куда свет не попадает!»~
@36016 = ~«Хорошо, думаю, мне пора. Прощай».~
@36017 = ~Ты видишь девушку. У нее хмурое выражение лица; она выглядит расстроенной. Когда ты подходишь, она презрительно произносит: «Чего тебе на этот раз?»~
@36018 = ~«У меня есть несколько вопросов...» ~
@36019 = ~«Ничего, прощай».~
@36020 = ~Парнишка Лазло говорит, что знает о портале возле осадной башни. Он расположен на подъемном мосту или напоминающем его устройстве — он не смог толком объяснить. Интересно, куда ведет этот портал?~
@36021 = ~Ленни держит долговую расписку Трист на складе. Я могу забрать ее у служащего.~
@36022 = ~Ленни держит на складе доказательства незаконной деятельности Байрона Пикита. Он предложил мне передать их кому-нибудь в Гармониуме, кому я доверяю. Улики я могу получить, поговорив со служащим.~
@36023 = ~Корвус говорит, что Байрон Пикит — подозреваемый преступник. Он считается причастным к большинству преступлений в открытом рынке Нижнего района.~
@36024 = ~Корвус сказал, что доверяет Ленни настолько, чтобы повернуться к нему спиной.~
@36025 = ~Корвус говорит, что Ленни — профессиональный вор, который по нескольким причинам избежал поимки. Также он говорит, что Ленни кажется порядочным человеком, который никому не причинил бы вреда.~
@36026 = ~Похоже, Корвус без ума от девушки по имени Карина. Я сказал ему, что она одинока и нуждается в друге.~
@36027 = ~Стражник Гармониума Корвус, похоже, без ума от девушки по имени Карина. Я сказал ему, что она одинока и нуждается в друге.~
@36028 = ~Похоже, на складе есть какие-то проблемы. Если я хочу получить планы гробницы, мне следует разобраться, что там твориться, и решить эту проблему.~
@36029 = ~Кажется, я нанимал отца Хамриса на строительство гробницы, а потом убил его. Не знаю, зачем я это делал...~
@36030 = ~Крэддок потерял одного из своих рабочих, пьяницу по имени Джелай. Он сказал, что тот скорее всего находится у бара 'Тлеющий труп'.~
@36031 = ~Похоже, на складе есть какие-то проблемы. Если я хочу получить подушку, мне следует разобраться, что там твориться, и решить эту проблему.~
@36032 = ~Благодаря моим усилиям у Сибил появилась возможность безопасно покинуть Пристанище головорезов. Почему-то меня не покидает мысль, что скоро она снова впутается в неприятности.~
@36033 = ~В Пристанище головорезов я встретил девушку по имени Сибил. Вероятно, в Пристанище она попала в западню из-за хаоситеков, которые проводят нечто вроде собрания в комнате, которая ведет на улицу Протяжных Вздохов. Она рассказала мне о другой двери в эту комнату; через нее можно проскользнуть мимо головорезов без боя. Я согласился найти ключ от этой двери. Предположительно, его носит один из бандитов на верхних этажах Пристанища.~
@36034 = ~Ты видишь женщину, неспешно изучающую товары.~
@36035 = ~«Приветствую».~
@36036 = ~Не обращать внимания на женщину.~
@36037 = ~Она бросает на тебя быстрый взгляд. «Да, рубака?»~
@36038 = ~«У меня есть несколько вопросов...» ~
@36039 = ~«Неважно. Прощай».~
@36040 = ~Она отмахивается от тебя. «У меня нет времени на это, рубака. Оставь меня». Она отворачивается от тебя.~
@36041 = ~Уйти.~
@36042 = ~Покупательница, едва заметив твое приближение, отворачивается от тебя. Она игнорирует твои попытки начать разговор с ней.~
@36043 = ~Уйти.~
@36044 = ~Ты видишь мужчину, неспешно изучающего товары.~
@36045 = ~«Приветствую».~
@36046 = ~Не обращать внимания на мужчину.~
@36047 = ~Он бросает на тебя быстрый взгляд. «Да, рубака?»~
@36048 = ~«У меня есть несколько вопросов...» ~
@36049 = ~«Неважно. Прощай».~
@36050 = ~Он отмахивается от тебя. «У меня нет времени на это, рубака. Оставь меня». Он отворачивается от тебя.~
@36051 = ~Уйти.~
@36052 = ~Покупатель, едва заметив твое приближение, отворачивается от тебя. Он игнорирует твои попытки начать разговор с ним.~
@36053 = ~Уйти.~
@36054 = ~Ты видишь ящера с телом, как у змеи, четырьмя когтистыми лапами, кожаными крыльями и драконьей головой. Его тело покрыто чешуей отвратительного зеленого оттенка. Существо стоит прямо на задних лапах, удерживая равновесие с помощью цепкого хвоста. При твоем приближении его глаза сужаются, и оно начинает шипеть.~
@36055 = ~«Приветствую».~
@36056 = ~Не обращать внимания на существо.~
@36057 = ~Воздух вокруг существа начинает накаляться, а у его чешуи появляется тусклое свечение. Оно бросает на тебя голодный взгляд и, похоже, готово напасть. Внезапно оно испускает тяжелое шипение и принимает немного более расслабленную позу. «Ссссс! Иди. Гросссук не говорит, сказано ждать... Сссссс...» Оно глядит на тебя, мотая хвостом из стороны в сторону.~
@36058 = ~«Меня прислал Себастион».~
@36059 = ~«Что ты за существо?»~
@36060 = ~«Прощай».~
@36061 = ~Существо слегка расслабляется, и воздух вокруг остывает. Оно протягивает тебе когтистую лапу. «Сссссс. Дай Гросссуку информацию». Он выжидающе смотрит на тебя.~
@36062 = ~«Какую информацию?»~
@36063 = ~«Нет, Себастион послал меня убить тебя».~
@36064 = ~«У меня нет ее с собой. Пойду, достану. Прощай».~
@36065 = ~Трудно прочитать выражение лица рептилии, но ты уверен, что уже порядком надоел Гросуку. Его хвост начинает бешено мотаться, а воздух вокруг вновь накаляется. «Никаких вопросссов. Дай Гросссуку информацию или умри. Тогда Гросссук возьмет ее ссс твоего тела».~
@36066 = ~«Мне нужно знать, какая часть информации полагается тебе. Видишь ли, я выполняю поручения для нескольких людей».~
@36067 = ~«Вообще-то, Себастион послал меня убить тебя».~
@36068 = ~«У меня нет ее с собой. Пойду, достану. Прощай».~
@36069 = ~Он смотрит на тебя пару секунд, обдумывая это. Наконец он указывает на башню неподалеку. «Осссадная башня. Ссссс. Как пробратьссся внутрь. Сссебастион ссказал, что предссскажет путь... — Гросук делает шаг вперед и протягивает лапу. — Давай сссейчас же!»~
@36070 = ~«Ах, эта информация. Извини, Себастион хотел передать ее лично. Он скоро будет».~
@36071 = ~~
@36072 = ~Воздух вокруг Гросука начинает накаляться, а у его чешуи появляется тусклое свечение. Он бросает на тебя голодный взгляд и, похоже, готов напасть. Он открывает рот и обнажает несколько рядов бритвенно-острых зубов. «Нет... Гросссук думает, ты врешь! Давай Гросссуку информацию — умрешь быссстро. Не дашь — Гросссук расссстянет ссссмерть. Вытянет твои внутренноссссти. Покажет тебе!»~
@36073 = ~«Постой, у меня нет нужной тебе информации, но мне известно кое-что, стоящее моей жизни».~
@36074 = ~«Ладно, все равно Себастион послал меня убить тебя».~
@36075 = ~Гросук склоняет голову набок и глядит на тебя. Кажется, на миг он уходит в мысли. «Гросссук ссслушает. Полезная информация — оссстанешься жить, — он выдает тебе клыкастую улыбку. — Если нет — умрешь. Гроссссук дает ссслово».~
@36076 = ~«Себастион не может выполнить условия твоего контракта. Он послал меня убить тебя».~
@36077 = ~«Откуда мне знать, что ты сдержишь слово?»~
@36078 = ~«Забудь, все равно Себастион послал меня убить тебя».~
@36079 = ~Гросук некоторое время смотрит на тебя, потом испускает поток раздосадованного шипения. Он начинает стискивать когти и мотать хвостом туда-сюда. Ты замечаешь, что на конце его хвоста вдруг появляется зазубренный шип. «Да. Полезная информация. Гросссук держит ссслово — живи. Гросссук благодарит. Гроссук пошел: нужно говорить сссс Ссссебасстионом».~
@36080 = ~«Прощай».~
@36081 = ~Существо пялится на тебя. «Это сссоглашение между тобой и Гросссуком. Гросссук живет сссоглашениями на сссловах. Теперь говори».~
@36082 = ~«Себастион не может выполнить условия твоего контракта. Он послал меня убить тебя».~
@36083 = ~«Забудь, все равно Себастион послал меня убить тебя».~
@36084 = ~Без малейшего промедления существо набрасывается на тебя.~
@36085 = ~Защищаться.~
@36086 = ~Казалось бы, каждый мускул существа напрягся. Оно взрывается бурей шипения. Оно тянется к тебе, но останавливается. Его глаза сверкают ненавистью, когда оно произносит: «Гросссук не говорит. Ссссссссс. Повезло тебе. Уходи, пока везет. Оссстанешьсся — Гросссук порвет на часссти!»~
@36087 = ~Передразнить: «Гросссссук не говорит? Гросссссук говорит уж сссслишком много для того, кто не говорит».~
@36088 = ~«Меня прислал Себастион».~
@36089 = ~«Тогда прощай».~
@36090 = ~Существо склоняет голову набок и смотрит на тебя широко раскрытыми от удивления глазами. Через миг его глаза сужаются от ярости, его тело начинает трясти, его мышцы напрягаются, как стальные тросы. Ты слышишь хруст и, глянув вниз, замечаешь, что его когти впились в камни под ногами. Воздух вокруг существа накалился и почти что светится. «Иди... сссейчас же. Сссссссссссс!»~
@36091 = ~Напасть на него.~
@36092 = ~Уйти.~
@36093 = ~Ты видишь абишая Гросука. Похоже, его сердит твое присутствие. «Сссссссс... Ссснова ты. Иди. Гросссук убьет».~
@36094 = ~«Ты не самое дружелюбное существо, не так ли?»~
@36095 = ~«Меня прислал Себастион».~
@36096 = ~«Хорошо, прощай».~
@36097 = ~Гросук смотрит на тебя, стискивая когти. Его глаза превращаются в щелочки, и он наклоняется, чтобы посмотреть тебе прямо в глаза. «Нет, Гросссук не друг. Уходи!»~
@36098 = ~«Хорошо, прощай».~
@36099 = ~Ты видишь симпатичную девушку, облаченную в простую одежду. Она бродит по рынку и осматривает все подряд, но не делает покупок. Ты отмечаешь, что люди ее сторонятся, но стараются этого не показывать. Когда ты подходишь, она дарит тебе теплую улыбку.~
@36100 = ~«Приветствую».~
@36101 = ~Игнорировать ее.~
@36102 = ~Ее улыбка становится еще шире. «Привет, я Карина. Рада нашей встрече, рубака». Она продолжает улыбаться в ожидании твоего ответа.~
@36103 = ~«У меня есть несколько вопросов...» ~
@36104 = ~Она кивает. «Хорошо. Что ты хочешь знать?»~
@36105 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@36106 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@36107 = ~«Где мне купить оружие?»~
@36108 = ~«Где мне купить магические предметы?»~
@36109 = ~«Ты, э... любишь поболтать, не так ли?»~
@36110 = ~«Неважно. Прощай».~
@36111 = ~Она хмурится. «Лотар... Не знаю никого с именем Лотар. Я даже не припомню, чтобы слышала такое имя, — она смотрит на тебя встревожено. — Как ты сказал, 'Повелитель Костей'? Звучит жутковато, правда? И зачем кому-то называться таким именем?»~
@36112 = ~~
@36113 = ~«Ну... это производит впечатление...»~
@36114 = ~«Ну... думаю, чтобы отпугивать людей».~
@36115 = ~~
@36116 = ~«Череп? А зачем тебе эта штуковина? Какой-то нездоровый интерес, тебе не кажется? Ну ладно, если тебе нужен череп, думаю, ты сможешь достать его в Морге... хотя, может, и нет. Им не нравится выдавать такие штуки посторонним, так мне кажется... в любом случае, я не знаю, кто мог забрать у тебя череп. Зачем он тебе?»~
@36117 = ~~
@36118 = ~«Он мой друг».~
@36119 = ~«Он — ценное имущество»~
@36120 = ~~
@36121 = ~Она улыбается и показывает на один из прилавков. «Вон там Анце торгует оружием. Всеми видами. Ты воин? Глупый вопрос — конечно же, да. То есть, как ты не можешь не быть им со всеми этими шрамами... о, прости, мне не следует их упоминать. Ты ведь не обижаешься насчет их?»~
@36122 = ~~
@36123 = ~«Нет, я к ним уже привык».~
@36124 = ~«Да, так что больше о них не вспоминай».~
@36125 = ~~
@36126 = ~Она улыбается и показывает на один из прилавков. «Вон там Аалек торгует волшебными штуковинами. Ты маг? На мага ты не похож, хотя, пожалуй, внешность бывает обманчивой. На самом деле, я не знаю, как выглядят маги — вот только сейчас это поняла. А ты знаешь?»~
@36127 = ~~
@36128 = ~«Да. Они носят мантии с забавными символами и остроконечные шляпы».~
@36129 = ~«На самом деле, нет».~
@36130 = ~~
@36131 = ~Она кивает. «Да... Кажется, я поняла, о чем ты. В этом определенно что-то есть. Хм-м. Немного запутывает, если слишком долго об этом думать». Кажется, она задумалась.~
@36132 = ~«У меня есть несколько вопросов...» ~
@36133 = ~Она смотрит на тебя недоуменно. «Правда? Череп? Знаешь, это звучит странно. Никогда не слышала, чтобы кто-нибудь дружил с черепом. Я видела людей с домашними животными и прочей живностью, вот только не с черепами. Но ты и не говорил, что он — твой любимец. Ты сказал, что он твой друг, что еще более странно». Она останавливается, чтобы поразмыслить.~
@36134 = ~«У меня есть несколько вопросов...» ~
@36135 = ~Кажется, она успокоилась. «О, хорошо... Я не хотела ранить твои чувства, или чьи-то еще. Просто нужно следить за тем, что говоришь, правильно? То есть, люди-то разные, и никогда не угадаешь. Что-то одних задевает, других — нет. Так что... ну да ладно». Она останавливается, чтобы перевести дух, и улыбается тебе.~
@36136 = ~«У меня есть несколько вопросов...» ~
@36137 = ~«Правда? Полезно это узнать. То есть, я боюсь магов и хочу знать, какие они с виду. Думаю, это все из-за сил, которыми они обладают. Они могут делать по-настоящему невероятные штуки, и все такое, но ты не знаешь, как они выглядят. Воины и жрецы и... и... ну, знаешь, другие сильные люди попросту выглядят сильными, со всеми теми вещами на них, по которым видно, что они сильные. Не то что маги». Она умолкает.~
@36138 = ~«У меня еще несколько вопросов...»~
@36139 = ~Кажется, она ушла в мысли. Она потирает пальцем подбородок, потом, наконец, кивает. «Да... Думаю, ты прав. У меня аж мурашки по коже от мысли об этом. 'Повелитель Костей' — довольно-таки страшный титул. Не хотела бы я связываться с кем-то с таким титулом». Она продолжает размышлять.~
@36140 = ~«У меня есть несколько вопросов...» ~
@36141 = ~Она пожимает плечами. «О, ну... ладно, значит, ты хочешь иметь у себя череп — это ничего. Люди собирают самые странные вещи. Я сама этим не занимаюсь, но знакома с такими людьми. Из тех, кого я знаю, ты — единственный, кто собирает черепа. Может, и мне таким заняться...»~
@36142 = ~«У меня есть несколько вопросов...» ~
@36143 = ~Кажется, она огорчилась; она смотрит на тебя обеспокоенно. «Извини. Надеюсь, ты меня простишь. Я никого не хотела обижать, ранить чьи-то чувства, и все такое. То есть, мне не нравится, когда кто-нибудь делает мне больно, так зачем же делать больно другому? Наверно, им это тоже не нравится... если только они не какие-нибудь ненормальные... или еще чего». Она смотрит на тебя невинным взглядом.~
@36144 = ~«У меня еще несколько вопросов...»~
@36145 = ~Она приходит в волнение и указывает на тебя пальцем. «Вот видишь! Я это и имела в виду. У них вся эта ужасная сила, и они могут делать невероятные штуки, но этого не скажешь по их виду. Так что они могут подкрасться к тебе. То есть, жрецы, воины и прочие — все они носят эти заметные вещи, так что ты можешь узнать, кто они такие, и вести себя осторожно. Не то что маги». Она смотрит на тебя деловито.~
@36146 = ~«У меня есть несколько вопросов...» ~
@36147 = ~Она удрученно шаркает ножкой. «Я, э... Ну... Мне говорили, что я, наверное, говорю чуточку многовато, и, ну... Люди стараются меня избегать... и у меня вообще нет ни подруг, ни поклонников... порой мне так одиноко...» Ее голос становится все тише и тише, а потом и вовсе стихает. Она опускает глаза.~
@36148 = ~«Ну, понятно, почему оно так выходит».~
@36149 = ~«Мне кажется, ты неплохой человек, Карина. Вот мне ты нравишься».~
@36150 = ~«Прощай».~
@36151 = ~Поначалу она продолжает стоять и созерцать землю у ног. И тут ты замечаешь, что она тихонько всхлипывает. Она отворачивается и уходит.~
@36152 = ~Уйти.~
@36153 = ~Она смотрит на тебя с надеждой. «Правда? Спасибо тебе большое... Не знаю, как тебя звать».~
@36154 = ~Ложь: «Я Адан».~
@36155 = ~«Я не помню своего имени».~
@36156 = ~«Прощай, Карина».~
@36157 = ~Она улыбается. «Спасибо, Адан. Приятно знать, что у меня есть друг».~
@36158 = ~«Прощай, Карина».~
@36159 = ~Она хмурится, начинает было что-то говорить, потом передумывает. Она пожимает плечами. «Что такого в имени? Просто приятно знать, что у меня есть друг». Она улыбается.~
@36160 = ~«Прощай, Карина».~
@36161 = ~Ты видишь Карину. При твоем приближении она улыбается. «Привет. Как тебе этот чудный денек?»~
@36162 = ~«У меня есть несколько вопросов...» ~
@36163 = ~«Неважно. Прощай».~
@36164 = ~Карина улыбается; она выглядит оживленной. «Привет, друг. Рада снова тебя видеть».~
@36165 = ~«Просто хотел поздороваться, Карина. Хорошего тебе дня».~
@36166 = ~Карина замечает твое приближение и радостно улыбается тебе. «Привет, — кажется, она готова лопнуть от волнения. — Спасибо тебе огромное, рубака! Я так тебе благодарна за все, что ты сделал».~
@36167 = ~«А что я сделал, Карина?»~
@36168 = ~Она смеется. «Ты прислал ко мне Корвуса — он мне сам сказал. Он боялся ко мне подойти, думал, что у меня армия поклонников... ну, я хотела сказать: спасибо тебе». Она сжимает тебя в объятиях.~
@36169 = ~«Всегда пожалуйста, Карина. Желаю счастья вам обоим».~
@36170 = ~«Спасибо, рубака. Надеюсь, и ты найдешь свое счастье».~
@36171 = ~«Прощай».~
@36172 = ~В углу комнаты ты видишь фигуру, скрытую в тенях. При твоем приближении девушка делает шаг вперед, чтобы показать себя. Она одета в свободную тунику, что, вместе с короткой стрижкой и хрупким телосложением, делает ее больше похожей на мальчишку. «На твоем месте я бы туда не ходила». Она кивает в сторону двери в южной стене.~
@36173 = ~От твоего голоса она вздрагивает и прикладывает палец к губам, показывая, чтобы ты замолчать. На мгновение она умолкает, затем отвечает сдавленным голосом: «Целая куча тех воющих безумцев, вот что. Похоже, у них там что-то вроде собрания. Пока они не разойдутся, выбраться на улицу не получится».~
@36174 = ~«Меня зовут Сибил», — тихо шепчет она, затем сплевывает себе на ладонь и протягивает ее для рукопожатия.~
@36175 = ~«Ты здесь вместо эха? Да, воющих безумцев. Они из Голодных Псов Лающих, банды чокнутых бандитов-хаоситеков, которые свирепствуют в этой части Улья».~
@36176 = ~«Ты что, не понимаешь? Псы, они ведь даже более сумасшедшие, чем обычный хаосит. Член ты фракции или нет, войдешь туда — и ты покойник, в этом можешь не сомневаться».~
@36177 = ~«Я насчитала около дюжины. Правда, я смотрела через трещину в стене, так что могла нескольких не посчитать».~
@36178 = ~«Слушай, можешь играться в героев, если хочешь, но меня в это не впутывай. Я остаюсь здесь. Если те твари каким-то чудом не выпустят тебе кишки, может, еще увидимся». Она разворачивается и ускользает в тени в углу.~
@36179 = ~«Возможно, есть еще один способ пройти мимо этих тварей без боя. Существует еще одна дверь, ведущая в ту комнату. Из того, что мне удалось разглядеть, вдоль стены, где находится та дверь, стоят штабеля деревянных ящиков. Можно проскользнуть от *той* двери к выходу на другой стороне комнаты. Только есть одна проблема...»~
@36180 = ~«Дверь заперта... я проверяла. По моим догадкам, ключ у одного из бандитов этажом выше. Вот только я еще не настолько пустоголовая, чтобы пройти его искать». Она скрещивает руки на груди и выжидающе смотрит на тебя.~
@36181 = ~«А на что это похоже? Я прячусь. Я пришла сюда в поисках... еды, — когда она это говорит, ты замечаешь, как ее правая рука невольно тянется к мешочку на поясе. — Вот только в комнате напротив появились лающие придурки и решили устроить вечеринку у парадного входа. А теперь я здесь в западне и не могу выбраться».~
@36182 = ~«Ты здесь вместо эха? Да, воющих безумцев. Они из Голодных Псов Лающих, банды чокнутых бандитов-Хаоситеков, которые свирепствуют в этой части Улья».~
@36183 = ~«Ты что, не понимаешь? Псы, они ведь даже более сумасшедшие, чем обычный хаосит. Член ты фракции или нет, войдешь туда — и ты покойник, в этом можешь не сомневаться».~
@36184 = ~Она уже собирается ответить, но обрывает себя на полуслове. Некоторое время она пристально смотрит на тебя, затем пожимает плечами. «Ладно-ладно... в общем, я — воровка. Нужно же девушке как-то зарабатывать на жизнь. В конце концов, тебе-то что? Ты явно не из Гармониума, и ты уж точно не с теми дикарями».~
@36185 = ~«Ха! Ты не станешь этого делать. Эти скоты раскроят тебе череп раньше, чем рассмотрят тебя. Кроме того... я могу тебе помочь».~
@36186 = ~«Снова ты? — кажется, Сибил сердится и в то же время испытывает облегчение, увидев тебя. — Гореть мне в Бааторе, рубака! Ты не мог бы шуметь еще больше, как думаешь? Я слышала твои шаги до самого зала».~
@36187 = ~«Откуда мне знать? Почему бы тебе не пойти и не испытать его на двери? Я буду наблюдать отсюда через щелочку в двери. Если доберешься до улицы целым, я пойду сразу за тобой».~
@36188 = ~«Рубака, должна признаться... я под впечатлением. Я-то была уверена, что эти звери тебя здорово пожуют. Ну что ж, пожалуй, мне следует отблагодарить тебя, — на миг она умолкает, затем сует руку в мешочек и достает оттуда маленький зеленый драгоценный камешек. — Вот... он был на одном из Псов. Увидимся, рубака».~
@36189 = ~«Почему? Что за той дверью?»~
@36190 = ~«Кто ты?»~
@36191 = ~Проигнорировать девушку и пройти мимо.~
@36192 = ~«Воющих безумцев?»~
@36193 = ~«Кто ты?»~
@36194 = ~«Спасибо за предупреждение. Прощай».~
@36195 = ~«Что ты здесь делаешь?»~
@36196 = ~«Спасибо за предупреждение, Сибил. Прощай».~
@36197 = ~«Хаоситекты? Я член их фракции... они меня пропустят».~
@36198 = ~«Сколько их там?»~
@36199 = ~«Спасибо за предупреждение. Прощай».~
@36200 = ~«Кто ты?»~
@36201 = ~«Сколько их там?»~
@36202 = ~«Спасибо за предупреждение. Прощай».~
@36203 = ~«Около дюжины? Это вряд ли будет для меня проблемой».~
@36204 = ~«Похоже, нам придется пробиваться наружу».~
@36205 = ~«Можно пробраться на улицу каким-то другим путем?»~
@36206 = ~«Спасибо за предупреждение. Прощай».~
@36207 = ~«С другой стороны... может, мне и не стоит туда ходить».~
@36208 = ~«Тогда прощай».~
@36209 = ~«И что же это?»~
@36210 = ~«Всегда есть какие-нибудь проблемы... иначе было бы скучно».~
@36211 = ~«Неважно. У меня и так полно проблем».~
@36212 = ~«Если ключ там... я его найду. Счастливо».~
@36213 = ~«Неважно. Посмотрим, что у меня выйдет с теми психами».~
@36214 = ~«Лающие придурки?»~
@36215 = ~«Значит, еду искала? Что в мешке?»~
@36216 = ~«Ты врешь. Ты — воровка».~
@36217 = ~«Спасибо за предупреждение. Прощай».~
@36218 = ~«Хаоситекты? Я член их фракции... они меня пропустят».~
@36219 = ~«Сколько их там?»~
@36220 = ~«Спасибо за предупреждение. Прощай».~
@36221 = ~«Сколько их там?»~
@36222 = ~«Спасибо за предупреждение. Прощай».~
@36223 = ~«Ты права... И, кроме того, мне тут делать нечего. Ты знаешь, как еще можно добраться до улицы?»~
@36224 = ~«Я всегда могу выдать тебя бандитам... может, они ответят мне благосклонностью и пропустят меня».~
@36225 = ~«Сколько их там?»~
@36226 = ~«Неважно. Прощай».~
@36227 = ~«Помочь мне? Как?»~
@36228 = ~«Мне не нужна помощь какого-то вороватого отребья. Я собираюсь выдать тебя бандитам».~
@36229 = ~«Неважно. Посмотрим, что у меня выйдет с теми психами».~
@36230 = ~«Что за дверью?»~
@36231 = ~«Кто ты?»~
@36232 = ~«Что это за ключ, о котором ты говоришь?»~
@36233 = ~«Я позаботился о бандитах, которые преграждали выход. Теперь ты сможешь выбраться отсюда».~
@36234 = ~«Неважно. Прощай».~
@36235 = ~«Тогда прощай».~
@36236 = ~«Прощай, Сибил».~
@36237 = ~«Расскажи мне об этом Лотаре».~
@36238 = ~Ты видишь мужчину средних лет в пыльной одежде. Кажется, у него проблемы со здоровьем: у него желтая кожа, а на руках видны редкие прыщи.~
@36239 = ~Он поворачивается, окидывает тебя пустым взглядом и подозрительно прищуривается, оглядываясь по сторонам. «Чего хотел?» — говорит он скрипучим голосом.~
@36240 = ~Он снова смотрит на тебя. «Зачем ты мне надоедаешь? Я что, похож на осведомителя?»~
@36241 = ~Он смотрит на тебя и фыркает. «Вот повезло-то... убирайся. У меня нет на все это времени». Он отворачивается.~
@36242 = ~Он вздыхает. «Что ты хотел узнать?»~
@36243 = ~«Ничего такого, чего не исправит могила, — он кашляет и смотрит вверх. — В последнее время воздух на районе все хуже и хуже. По моим прикидкам, он придет в норму, как только решится проблема с Великой Литейной... или подует ветер со Шпиля».~
@36244 = ~«В основном это из-за всех этих порталов». Он заходится в припадке кашля, потом вновь сосредотачивает свое внимание на тебе.~
@36245 = ~«Тьма дверей в Нижние планы впускает сюда дурной воздух, испарения и тому подобное с черт-знает-какого уровня Бездны. Потому-то это и *Нижний* район, — он смеется. — Гулять по этому месту — все равно что дышать мукой. Соль, копоть, дым... все эти желтые покрывала дыма и жгучего серного газа, которые выплевывает этот район, — он дарит тебе редкозубую улыбку. — Чудненько, а?»~
@36246 = ~«Она прямо в центре района. Ищи трубы. Там боголюди делают кучу штук из железа; не черт-знает-что, но работает. Добавляет сюда дурной воздух».~
@36247 = ~«Верящие. Обосновались в Великой Литейной, грохочут, поют и болтают свои бредовые глупости о том, как стать силой через десять по десять помногу раз десять жизней, — он закатывает глаза, потом сплевывает коричневую массу. — Они только и делают, что терпят и батрачат... я батрачу раза в два больше, и все равно черта-с-два стану какой-нибудь силой, улавливаешь, пень?» Он глухо смеется.~
@36248 = ~«Временами с сигильского Шпиля дует ветер и уносит смог... — он оглядывается и кашляет. — Но ненадолго».~
@36249 = ~«А... — он смотрит на тебя, как на сумасшедшего. — Ты, что, невежда? Мастерские, лавки, склады — это все тут, — он косится на тебя, его взгляд слегка затуманен. — Ты ищешь что-то конкретное?»~
@36250 = ~Пару секунд он изучает тебя, затем смотрит на тебя понимающе. «Что, ищешь, где бы нагреть свою железяку? — он смеется, смех перерастает в кашель. — Таких мест поблизости нет. Можно поискать в других районах. Если ты, конечно, здесь за этим».~
@36251 = ~Он снова заходится хохотом, который переходит в еще более сильный приступ кашля. «Прости, рубака. Не бери в голову. Ты ищешь что-нибудь конкретное?»~
@36252 = ~«Если ищешь работу — тут тебе не повезло. Работы здесь едва местным хватает».~
@36253 = ~«Если нужно прикупить парочку вещей или провернуть сделку покруче, то я бы направился прямиком на открытый рынок». Он снова начинает кашлять.~
@36254 = ~Он дарит тебе недобрую улыбку. «Там продают и покупают, пень. Это ж рынок... что тут еще скажешь?»~
@36255 = ~«Э... — он на миг задумывается. — Ну, есть тут башня. Похоже, ее здесь часто вспоминают».~
@36256 = ~«Ха! — он смеется, но вскоре его смех переходит в кашель. — Одна из самых ужасных загадок этого района... слыхал байку, будто она однажды просто свалилась на Сигил, много лет назад; непонятно, откуда она взялась, как она сюда попала и как пробраться в эту чертову штуковину. Занимает здесь место, такая себе достопримечательность... все эти следы от кислоты и оружия... похоже, она видала не одну сотню войн, это уж точно».~
@36257 = ~Он ненадолго уходит в мысли, потом пожимает плечами. «Больше ничего интересного в голову не приходит».~
@36258 = ~Он начинает нервничать и оглядываться. «Ага... Слыхал о нем. Говорю тебе, с ним лучше не шутить. Его берлога — место, которое зовется *Кости Ночи* или еще как-то так».~
@36259 = ~Он хмурится. «Ну, это опасный разговор... если бы я *собирался* что-нибудь сказать, а я не собираюсь, я бы посоветовал присмотреться к развороченной постройке здесь, на районе. Может, там ты что и найдешь, а? — он пристально смотрит на тебя. — Только ты от меня этого не слышал, усек?»~
@36260 = ~Кажется, он чувствует себя немного неловко. «Значит, череп пропал? Хм, ну, ты от меня этого не слышал, но есть тут народ... — он смотрит по сторонам. — Зарабатывают на жизнь собиранием голов мертвецов. Работают на вояку по имени Лотар. Они его кличут *Повелитель Костей*».~
@36261 = ~Он смотрит на тебя хмуро. «Тот, к кому ты приходишь, чтобы задать кучу чертовых дурацких вопросов...» Он пристально смотрит на тебя.~
@36262 = ~Ты видишь мужчину средних лет в пыльной одежде. «Вернулся, а? — он хмуро смотрит на тебя. — Что теперь?»~
@36263 = ~Он делает тебе легкий поклон. «Зовут Корур. В свое время я был бойцом хоть куда... — он останавливается и вздыхает. — Ну, деньки-то эти уж давно прошли, но я до сих пор знаю пару трюков».~
@36264 = ~«Ну... отчего нет. Ты уверен, что хочешь сменить специализацию?»~
@36265 = ~«Приветствую».~
@36266 = ~Не обращать на него внимания.~
@36267 = ~«У меня есть несколько вопросов...» ~
@36268 = ~«Неважно, прощай».~
@36269 = ~«Ты тоже сойдешь».~
@36270 = ~«Похоже, ты — просвещенная личность, и я мог бы много чего от тебя узнать».~
@36271 = ~«Кто такой осведомитель?»~
@36272 = ~«Неважно, прощай».~
@36273 = ~Уйти.~
@36274 = ~«Кто ты?»~
@36275 = ~«Ты нормально себя чувствуешь?»~
@36276 = ~«Что ты можешь рассказать об этом районе?»~
@36277 = ~«Здесь есть на что посмотреть?»~
@36278 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@36279 = ~«У меня был череп, и его украли. Ты не знаешь, кто бы мог такое сделать?»~
@36280 = ~~
@36281 = ~«Что здесь с воздухом?»~
@36282 = ~«Расскажи мне о Литейной».~
@36283 = ~«Так что насчет ветра?»~
@36284 = ~«Понятно. У меня есть другие вопросы...»~
@36285 = ~«Я должен идти. Прощай».~
@36286 = ~«О чем это ты?»~
@36287 = ~«Понятно. У меня есть другие вопросы...»~
@36288 = ~«Я должен идти. Прощай».~
@36289 = ~«Э, да... ты упоминал Литейную».~
@36290 = ~«Что ты там говорил насчет ветра?»~
@36291 = ~«У меня есть другие вопросы...»~
@36292 = ~«Я должен идти. Прощай».~
@36293 = ~«Боголюди?»~
@36294 = ~«Что здесь с воздухом?»~
@36295 = ~«Ты что-то говорил насчет ветра...»~
@36296 = ~«У меня есть несколько вопросов...» ~
@36297 = ~«Я должен идти. Прощай».~
@36298 = ~«Что здесь с воздухом?»~
@36299 = ~«Ты что-то говорил насчет ветра...»~
@36300 = ~«У меня есть несколько вопросов...» ~
@36301 = ~«Я должен идти. Прощай».~
@36302 = ~«Что здесь с воздухом?»~
@36303 = ~«Расскажи мне об этой Литейной».~
@36304 = ~«У меня есть другие вопросы...»~
@36305 = ~«Я должен идти. Прощай».~
@36306 = ~«Чем здесь можно заняться?»~
@36307 = ~«У меня есть другие вопросы...»~
@36308 = ~«Я должен идти. Прощай».~
@36309 = ~«Что, прости?»~
@36310 = ~«Неплохо бы получить немного звенелок».~
@36311 = ~«Я хотел бы кое-что купить».~
@36312 = ~«У меня еще вопросы».~
@36313 = ~«Я должен идти. Прощай».~
@36314 = ~«Неплохо бы получить немного звенелок».~
@36315 = ~«Я хотел бы кое-что купить».~
@36316 = ~«У меня еще вопросы».~
@36317 = ~«Я должен идти. Прощай».~
@36318 = ~«Я хотел бы кое-что купить».~
@36319 = ~«У меня есть другие вопросы...»~
@36320 = ~«Я должен идти. Прощай».~
@36321 = ~«Что ты можешь рассказать о рынке?»~
@36322 = ~«У меня есть другие вопросы...»~
@36323 = ~«У меня есть другие вопросы...»~
@36324 = ~«Я должен идти. Прощай».~
@36325 = ~«У меня есть другие вопросы...»~
@36326 = ~«Я должен идти. Прощай».~
@36327 = ~«Расскажи мне о башне».~
@36328 = ~«Больше ничего не приходит на ум?»~
@36329 = ~«У меня к тебе еще несколько вопросов...»~
@36330 = ~«Я должен идти. Прощай».~
@36331 = ~«Больше ничего не приходит на ум?»~
@36332 = ~«У меня к тебе еще несколько вопросов...»~
@36333 = ~«Я должен идти. Прощай».~
@36334 = ~«У меня к тебе еще несколько вопросов...»~
@36335 = ~«Я должен идти. Прощай».~
@36336 = ~«Где можно найти это место?»~
@36337 = ~«Спасибо. У меня есть другие вопросы...»~
@36338 = ~«Я должен идти. Прощай».~
@36339 = ~«Где я могу найти этого Лотара?»~
@36340 = ~«Спасибо, прощай».~
@36341 = ~«У меня есть несколько вопросов...» ~
@36342 = ~«Я должен идти. Прощай».~
@36343 = ~«У меня есть несколько вопросов...» ~
@36344 = ~«Ты можешь обучить меня пути воина?»~
@36345 = ~«Ты можешь обучить меня пути воина?»~
@36346 = ~«Понятно. У меня есть другие вопросы...»~
@36347 = ~«Да, я уверен».~
@36348 = ~Он поворачивается и слегка улыбается, откладывая свою работу. «Привет... помощь нужна?»~
@36349 = ~«Да-да, буду рад помочь, если смогу... — похоже, паренек не прочь немного пофилонить. — Что у тебя за вопросы?»~
@36350 = ~«Это место? — он оглядывается. — Это открытый рынок. Куча покупателей и продавцов торгуют здесь дни напролет. Я тут уже порядочно времени, работаю тут под присмотром бати, — он выглядит немного отрешенным. — Когда-нибудь я займу его место».~
@36351 = ~Он гордо указывает на печь. «Печкой, она для... — он пожимает плечами. — Без понятия, зачем она нужна, но батя говорит, что важно, чтоб она всегда была полной и раскочегаренной». Он смахивает пот со лба и оглядывается по сторонам.~
@36352 = ~Он кивает. «Его зовут Анце, вон там его место, — он показывает на прилавок справа от печи. — Если у него чего-то не найдется, он сможет направить тебя куда надо».~
@36353 = ~Он ненадолго задумывается. «Здесь много чего есть: еда, выпивка, магия, оружие... может, ты хочешь пополнить припасы?»~
@36354 = ~«Ага, магия здесь есть, — он осматривается вокруг, затем указывает на дальний прилавок. — Это место Аалека, у него что-то должно быть».~
@36355 = ~«С этим тебе поможет мой батя, его место вот тут, — он указывает на прилавок справа от печи. — Его зовут Анце».~
@36356 = ~Он бросает на тебя странный взгляд и пожимает плечами. «Тогда тебе к Хамрису. Кажется, его лавка на юго-востоке отсюдова».~
@36357 = ~Он кивает. «О, да, это Нижний район. Здесь живет простой народ, типа нас с батей». Внезапно он округляет глаза и приходит в возбуждение. «А знаешь, почему его назвали Нижним районом?» ~
@36358 = ~«Ну, считается, что в районе целая куча порталов в Нижние планы: он весь ими продырявлен, прям как сыр, так вот. Так что я думаю, что из-за этого к нему и прицепилось это название». Он гордо улыбается.~
@36359 = ~Он пожимает плечами. «Это для меня такая же загадка, как и для тебя, рубака. Не уверен, есть ли тут какие-то причины, просто так вышло. Думаю, это либо воля Леди, либо воля случая». Он снова пожимает плечами.~
@36360 = ~Его глаза округляются. «Ага. Обычно они просто тут делают остановку...» Он обеспокоенно глотает.~
@36361 = ~«Ага, видел... — он останавливается и снова сглатывает. — Было это, кажись, на той неделе. Видел, как из портала вышла парочка абишаев. Они долго так между собой толковали, а потом один из них ушел назад. Тот, что остался, до сих пор здесь...» Он хмурится.~
@36362 = ~«Наверняка не знаю. Для меня это показалось шипением, или типа того, но мне кажется, что они говорили про башню». Он пожимает плечами.~
@36363 = ~«Ага, это одна из самых странных штуковин на районе. Никто точно не знает, сколько уже здесь стоит эта старая потрепанная башня... и знаешь что: в нее не проберешься. Запечатана почище пояса верности. Вот бы узнать, что в ней... — на мгновение он задумывается. — Абишай показывал на портал возле башни. Могу поспорить, что они ищут ключ».~
@36364 = ~«Ключ от портала, что ведет в башню. У каждого портала есть ключ, чтоб открыть его куда-нибудь. Это может быть жест, предмет, даже мысль... многие пытались пробраться в башню. Но сколько не пытаешься — все напрасно».~
@36365 = ~Он пожимает плечами. «Без понятия, рубака. Может быть...»~
@36366 = ~Он умолкает, чтобы немного поразмыслить. «Сзади на башне есть похожая на подъемный мост штуковина — это на западе от рынка. Там он и находится...» Он смотрит куда-то вдаль. ~
@36367 = ~«Центр планов, город, где переплетается почти все. Здесь не соскучишься, это уж точно. Закон здесь — Леди Боли, другие из нас по большей части стараются выжить в ее тени». Он хрипло смеется, прерываясь на кашель.~
@36368 = ~«Я мало что про нее знаю... она держит силы и нечисть подальше от Сигила, и ни с кем не разговаривает и не имеет дел... разве что с дабусами. И она чертовски быстро впишет тебя в книгу мертвых, если вздумаешь ей поклоняться или попробуешь навредить Сигилу. Ее лицо в окружении клинков — последнее, что ты увидишь...»~
@36369 = ~При упоминании лица, окруженного клинками, в твое сознание прорываются воспоминания. На мгновение ты оказываешься стоящим в темном переулке. Ты тяжело дышишь. В темноте к тебе приближается сверхъестественно красивая женщина с холодными глазами и лицом, окруженным клинками... внезапно воспоминание меркнет, и ты вновь разговариваешь с мальчишкой.~
@36370 = ~«Это все хворь из-за плохого воздуха. От дыма и фабричного смога в округе становится трудно дышать, — он пожимает плечами. — Иногда на улице лучше вообще не задерживаться — это когда смог задерживается слишком надолго... может выжечь глаза прямо из черепа — так говорят».~
@36371 = ~«Без понятия. Временами от Шпиля дует ветер и выгоняет смог из города, но это случается не так часто, как хотелось бы, — он прищуривается, оглядывается и пожимает плечами. — Думаю, это воля Леди. Смысла в этом немного, но с другой стороны, если хорошенько подумать, что-то в этом есть».~
@36372 = ~«Глядеть особо не на что... вот только Великая Литейная впечатляет, можешь сам заценить... ну, знаешь, дом верящих, — он задумывается. — Почти все интересные места в Верхних районах. Лучше было бы там и поглядеть... Слыхал, что там есть бордель, Фестхолл и еще парочка интересных мест. Точно не знаю: я всю жизнь прожил тут».~
@36373 = ~«Она примерно в центре района. Впечатляющая постройка, это уж точно. Ты ее не пропустишь, просто иди на север. Узнаешь ее по большим воротам», — он отмечает ее на твоей карте.~
@36374 = ~«У них куча имен: верящие, боголюди, верящие в Первопричину... мы их в основном зовем боголюдьми. Они обосновались в Великой Литейной, и похоже, что дела у них идут довольно неплохо. Приятная компания. Верят, что кто угодно может стать великим, чуть ли не силой, если изо всех сил будет стараться достичь этого. Это может означать, что тебе придется много раз начинать жизнь с нуля, но со временем ты все-таки добьешься своего».~
@36375 = ~Он улыбается. «А, я... и мой батя... мы Свободные... на самом деле, мы не совсем фракция... мы верим, что люди вольны делать то, что хотят. Мы — довольно-таки свободолюбивый народ, и мы не слишком одобряем создание других фракций или служение им».~
@36376 = ~Он глядит на тебя. «Фракции управляют почти что всем Сигилом и всеми каждодневными делами. Их целая куча: есть мертвяки, тленные, которые занимаются мертвецами на улицах, потом есть еще законники, которые придумывают законы, и чувствующие... много есть фракций. Здесь, в Нижнем районе, мы чаще всего имеем дело с верящими, боголюдьми, — он кивает вдаль. — Они обустроились в Великой Литейной, и они — довольно-таки приятная компания».~
@36377 = ~Он пожимает плечами. «Почти ничего. Мне это неинтересно, живу себе Свободным, да и все. В домах фракций найдется куча людей, которые смогут тебе все рассказать. Сходи и спроси у них».~
@36378 = ~Он приходит в возбуждение. «Значит, череп пропал! Могу поспорить, что знаю, что с ним сталось... есть на районе чувак, говорят, то ли маг, то ли жрец, который собирает черепа и ставит их на полки как книги. Они-то мертвые, но своим колдунством он заставляет их отвечать на вопросы, несмотря на то что они в книге мертвых».~
@36379 = ~Он хмурится. «Прям уж и не знаю. Слышал байку, вроде как он обосновался в разрушенном доме где-то в округе, но я там никогда не был, — он щелкает пальцами. — Хотя это могут знать другие... можно спросить Себастиона на этот счет».~
@36380 = ~Он показывает куда-то на запад. «Вернись на площадь и немного пройдись на северо-запад. Себастион обосновался возле похожей на подъемный мост штуковины».~
@36381 = ~«Рад встрече. У тебя есть вопросы, по которым я мог бы тебе помочь?»~
@36382 = ~В этой арке есть нечто... пугающе знакомое. Пространство между двумя черными колоннами наполнено леденящим холодом, словно арка граничит с другим, более холодным местом. По какой-то причине ты ЗНАЕШЬ, что это портал в Крепость сожалений... Теперь все, что нужно сделать, — это открыть его.~
@36383 = ~Стиснуть зубы и сорвать кожу с левого предплечья...~
@36384 = ~Оставить портал в покое... пока.~
@36385 = ~Игнорировать его.~
@36386 = ~«Да, у меня есть пара вопросов...»~
@36387 = ~«Нет, прощай».~
@36388 = ~«Что это за место?»~
@36389 = ~«Можешь рассказать об этом районе?»~
@36390 = ~~
@36391 = ~«Что ты можешь рассказать о Сигиле?»~
@36392 = ~«Почему у всех здесь желтая кожа?»~
@36393 = ~«Тут есть на что посмотреть?»~
@36394 = ~«У меня пропал череп... не знаешь, кому бы он мог понадобиться?»~
@36395 = ~«Я уже должен идти. Прощай».~
@36396 = ~«Чем ты здесь занимаешься?»~
@36397 = ~~
@36398 = ~«У меня есть несколько вопросов...» ~
@36399 = ~«Твой отец — один из здешних торговцев?»~
@36400 = ~«Понятно. У меня еще несколько вопросов...»~
@36401 = ~«Я должен идти. Прощай».~
@36402 = ~«Что здесь можно купить?»~
@36403 = ~Перед тобой стройная девушка-тифлинг, стоящая к тебе спиной. Ты замечаешь, что обе ее руки, а также перевернутый стол перед ней покрыты свежим слоем, скорее всего, розовой краски. Похоже, она не замечает твоего приближения.~
@36404 = ~От звука твоего голоса девушка поворачивает к тебе голову, чтобы разглядеть. Ее лицо, пусть немного грязное и заляпанное розовой краской, поразительно красиво. Она дарит тебе широкую озорную улыбку, затем возвращается к импровизированному полотну.~
@36405 = ~Похоже, девушка-тифлинг полностью поглощена своей работой. Она совершенно тебя не замечает.~
@36406 = ~«Приветствую».~
@36407 = ~Проигнорировать девушку и пройти мимо.~
@36408 = ~«У меня есть несколько вопросов...»~
@36409 = ~Оставить девушку наедине с ее рисунком.~
@36410 = ~Оставить девушку наедине с ее рисунком.~
@36411 = ~«Где можно купить магические вещи?»~
@36412 = ~«Где можно купить оружие?»~
@36413 = ~«Где можно купить подушку для гроба?»~
@36414 = ~«У меня еще несколько вопросов к тебе...»~
@36415 = ~«Я должен идти. Прощай».~
@36416 = ~«Где можно купить оружие?»~
@36417 = ~«Где можно купить подушку для гроба?»~
@36418 = ~«У меня еще несколько вопросов к тебе...»~
@36419 = ~«Я должен идти. Прощай».~
@36420 = ~«Где можно купить магические вещи?»~
@36421 = ~«Где можно купить подушку для гроба?»~
@36422 = ~«У меня еще несколько вопросов к тебе...»~
@36423 = ~«Я должен идти. Прощай».~
@36424 = ~«Где мне купить магические предметы?»~
@36425 = ~«Где мне купить оружие?»~
@36426 = ~«У меня еще несколько вопросов к тебе...»~
@36427 = ~«Я должен идти. Прощай».~
@36428 = ~«Нет, и почему же?»~
@36429 = ~«Меня это не интересует. У меня еще несколько вопросов...»~
@36430 = ~«Я должен идти. Прощай».~
@36431 = ~«Почему здесь так много порталов в Нижний планы?»~
@36432 = ~«Из этих порталов выходят какие-нибудь существа?»~
@36433 = ~«У меня еще несколько вопросов...»~
@36434 = ~«Из этих порталов выходят какие-нибудь существа?»~
@36435 = ~«Ты выглядишь взволнованным. Ты что-то видел?»~
@36436 = ~«Башню?»~
@36437 = ~«У меня еще несколько вопросов...»~
@36438 = ~«Где именно находится этот портал?»~
@36439 = ~«О чем это говорил абишай?»~
@36440 = ~«У меня еще несколько вопросов...»~
@36441 = ~«Я должен идти. Прощай».~
@36442 = ~«Расскажи мне о башне, которую ты упоминал».~
@36443 = ~«Да, немного».~
@36444 = ~«У меня еще несколько вопросов...»~
@36445 = ~«Я должен идти. Прощай».~
@36446 = ~«У меня есть несколько вопросов...» ~
@36447 = ~«Я должен идти. Прощай».~
@36448 = ~«Что ты можешь рассказать о Леди Боли?»~
@36449 = ~«Я должен идти. Прощай».~
@36450 = ~«Интересно...»~
@36451 = ~«У меня еще несколько вопросов...»~
@36452 = ~«Я должен идти. Прощай».~
@36453 = ~«И с этим ничего нельзя сделать?»~
@36454 = ~«У меня еще несколько вопросов...»~
@36455 = ~«Я должен идти. Прощай».~
@36456 = ~«Расскажи мне о Литейной».~
@36457 = ~«Расскажи мне о верящих».~
@36458 = ~«У меня есть другие вопросы...»~
@36459 = ~«Я должен идти. Прощай».~
@36460 = ~«Расскажи мне о верящих».~
@36461 = ~«Понятно. У меня есть другие вопросы».~
@36462 = ~«Я должен идти. Прощай».~
@36463 = ~«Расскажи мне о Литейной».~
@36464 = ~«Значит, они — еще одна местная фракция. А ты из какой фракции?»~
@36465 = ~«Интересно. У меня есть другие вопросы...»~
@36466 = ~«Я должен идти. Прощай».~
@36467 = ~«Какая польза от всех этих фракций?»~
@36468 = ~«У меня есть несколько вопросов...» ~
@36469 = ~«Я должен идти. Прощай».~
@36470 = ~«Что ты можешь рассказать о других фракциях?»~
@36471 = ~«У меня есть несколько вопросов...» ~
@36472 = ~«Я должен идти. Прощай».~
@36473 = ~«Что ты можешь рассказать об этой Литейной?»~
@36474 = ~«Понятно. У меня есть другие вопросы к тебе...»~
@36475 = ~«Я должен идти. Прощай».~
@36476 = ~«Где мне его найти?»~
@36477 = ~«Где мне найти Себастиона?»~
@36478 = ~«Понятно. У меня есть другие вопросы...»~
@36479 = ~«Я должен идти. Прощай».~
@36480 = ~«Спасибо. У меня есть другие вопросы...»~
@36481 = ~«Я должен идти. Прощай».~
@36482 = ~«Да...»~
@36483 = ~«Нет, прощай».~
@36484 = ~Ты видишь юношу с диковатой внешностью в дешевой одежде. Его глаза мечутся, изучая окрестности. Он замечает твое приближение и начинает осторожно тебя рассматривать.~
@36485 = ~Он осматривает тебя сверху донизу, затем оглядывается по сторонам. Взглянув на тебя снова, он зловеще усмехается. «Тебе лучше иметь хорошую причину беспокоить Ленни, пень».~
@36486 = ~Он смеется над тобой. «Я тебе не осведомитель. Если у тебя есть вопросы, найди себе одного из них, — его улыбка становится шире. — Лучше бы тебе отвалить, пока я не пустил тебе кровь».~
@36487 = ~Он перестает улыбаться и мрачно смотрит на тебя. «Нет, я не отвечаю на вопросы, пень. Я же сказал тебе найти себе осведомителя, так что проваливай». Он пристально смотрит на тебя.~
@36488 = ~Он перестает улыбаться и некоторое время тебя осматривает. Его взгляд задерживается на твоих шрамах, и он слегка сглатывает. Через миг его лицо мрачнеет, и он начинает нервничать. «Пикит... послал тебя? Зачем?»~
@36489 = ~Он хмурится. «Какие вопросы?..» Ты замечаешь, как он напрягается.~
@36490 = ~Он колеблется, затем немного расслабляется. У тебя создается впечатление, что он ожидал от тебя другого вопроса. Он улыбается тебе. «Значит, череп стащили? Ну, это не я — должно быть, это работа парней Лотара».~
@36491 = ~Он зловеще усмехается. «Повелитель Костей — так его зовут, им он и является. Он главный верховный жрец какой-то влиятельной силы, не знаю какой, — он смеется. — Он обосновался в месте под названием Кости Ночи».~
@36492 = ~Он хмурится. «Даже не знаю, хочу ли я быть на месте того, кто ответит на этот вопрос... — он некоторое время пристально смотрит на тебя, потом пожимает плечами. — Разрушенный дом к югу от осадной башни, не пропустишь». Он еще раз зловеще усмехается.~
@36493 = ~Он тяжело сглатывает и пялится на тебя. Ты замечаешь, что он весь напрягся, и уже готов ринуться. Он с невозмутимым видом кладет руку на пояс, но ты видишь, что он натянут как струна. «Не знаю, о чем ты, пень. Лучше тебе уйти».~
@36494 = ~Он тяжело сглатывает, уголок его глаза начинает подергиваться. Он глядит на шрамы, которыми покрыто твое тело, затем пытается встретиться с тобой взглядом... но не может. «Забрать их... Я... я уничтожил их после того, как стащил, как и велел мне Байрон». Наконец ваши взгляды встречаются.~
@36495 = ~Он еще секунду смотрит на тебя, потом резко разворачивается, чтобы убежать.~
@36496 = ~Как только он бросается бежать, ты делаешь прыжок и хватаешь его за руку. Он недолго сопротивляется, но не может с тобой справиться. Наконец он перестает сопротивляться твоей хватке. «Ладно, не уничтожал я их! Я отдам их тебе, только отпусти». Ты ослабляешь хватку.~
@36497 = ~Как только он бросается убегать, ты делаешь прыжок, чтобы схватить его. Он ловко отскакивает и начинает тебя оббегать. Видя, что твоя цель вот-вот убежит, ты делаешь еще один, еще более отчаянный выпад. Тебе не удается схватить его, однако ты сбиваешь его с ног тяжелым ударом. Благодаря приложенным усилиям ты не дал ему сбежать. «Ладно, не уничтожал я их! Я отдам их тебе, только отпусти».~
@36498 = ~Он вздыхает. «Я... у меня их нет с собой, — ты бросаешь на него мрачный взгляд и видишь страх на его лице. — Клянусь! У меня их нет! Я оставил их на складе!» Он продолжает глядеть на тебя, тяжело дыша.~
@36499 = ~Он печально качает головой. «Мы не можем: они на складе и в текущий момент недоступны. Ходят слухи, что у них сейчас что-то типа смены руководства... но я не знаю, правда ли это. В любом случае, я не могу достать бумаги». Он робко смотрит на тебя.~
@36500 = ~Он пожимает плечами. «Отлично. Полагаю, эта змея Пикит снова окажется в выигрыше...» Он вызывающе смотрит на тебя.~
@36501 = ~«Иди на склад и скажи служащему *я здесь за ссудой*, и он отдаст тебе бумаги. Бывай, пень». Внезапно он кидается и убегает.~
@36502 = ~Он фыркает и вызывающе смотрит на тебя. «Я их хранил, чтобы была возможность кинуть твоего босса Пикита и спасти Трист от аукциона! — он качает головой. — Прикрыть свой зад компроматом...»~
@36503 = ~«Да, кинуть, — он еще немного смотрит на тебя, потом до него доходит, что ты его не понял. — Это значит, что я собирался выдать его Гармониуму».~
@36504 = ~Он фыркает и вызывающе смотрит на тебя. «Я придержал их, чтобы была возможность кинуть твоего босса Пикита и спасти Трист от аукциона!»~
@36505 = ~Он смотрит на тебя с неким достоинством. «Может, я и вор, но у меня есть кое-какие правила. Я не стану убивать какого-нибудь бедолагу, и не стану делать то, что Пикит сделал с Трист и ее мужем, — он качает головой и отводит взгляд. — Я сказал твоему боссу, что он поступает неправильно, но он посмеялся надо мной».~
@36506 = ~Он недоверчиво смотрит на тебя. «Ты серьезно? Я думал... но ты же сказал... — он внимательно смотрит на тебя, потом начинает смеяться. — Ты меня провел, да так, что я сам тебе проболтался! — он качает головой и с уважением смотрит на тебя. — Хорошо сработано, рубака».~
@36507 = ~Он печально качает головой. «Мы не можем: они на складе и в текущий момент недоступны. Ходят слухи, что у них сейчас что-то типа смены руководства... но я не знаю, правда ли это. В любом случае, я не могу достать бумаги, — он робко смотрит на тебя. — Потому я и не смог сам помочь Трист, рубака. Я не могу достать эти чертовы бумаги».~
@36508 = ~Он улыбается тебе. «Иди на склад и скажи служащему *я здесь за ссудой*, и он отдаст тебе бумаги Трист. Если потом скажешь ему *я обставил Пикита*, он даст тебе премию...»~
@36509 = ~Он смеется. «Доказательства, рубака. Это надолго, очень надолго уберет Пикита с улиц, если ты отдашь их в правильные руки... — он на миг задумывается. — Если в Гармониуме есть кто-то, кому ты можешь доверять, отдай их ему».~
@36510 = ~Он хмурится. «Что ты имеешь в виду?»~
@36511 = ~«Ты уверен, что хочешь покинуть свою текущую специализацию и стать вором?»~
@36512 = ~Он оглядывается по сторонам и пожимает плечами. «Это Нижний район, жилище простого народа. Жизнь здесь не такая безнадежная, как в Улье, но и не настолько хороша, как в Чиновничьем районе, — он снова оглядывается. — Больше тут особо не о чем рассказывать».~
@36513 = ~Он качает головой и улыбается. «Полагаю, ты их назвал бы трущобами Сигила. Куче бедолаг там больше некуда податься, кроме как в книгу мертвых, — он умолкает. — Больше тут нечего сказать».~
@36514 = ~Он улыбается. «Название говорит само за себя, пень. Чиновники, чиновники и еще раз чиновники. Если хочешь накатать кляузу, или ее уже на тебя накатали — тебе туда самое место, — он пожимает плечами. — Больше тут нечего сказать».~
@36515 = ~Он улыбается и начинает грубо хохотать. «Большинство думает, что Сигил — центр мультивселенной. Лично я думаю, что это ее жопа, и все живущие здесь бедолаги — это дерьмо, которое из нее лезет». Он продолжает улыбаться тебе.~
@36516 = ~Ты видишь Ленни. Когда ты подходишь, он дарит тебе притворную улыбку. «Что ж, здравствуй, пень. Чему я обязан такому удовольствию?»~
@36517 = ~Ты видишь Ленни. Похоже, что он не очень-то рад тебя видеть. «Чего ты хочешь, пень?»~
@36518 = ~Он мрачнеет. «Никаких вопросов, никаких ответов. Возвращайся к своему боссу и передай ему, чтоб оставил меня в покое». Он пристально смотрит на тебя.~
@36519 = ~Он недоверчиво смотрит на тебя. «Ты серьезно? Я думал... но ты сказал... — он внимательно рассматривает тебя пару секунд, потом начинает смеяться. — Ты меня провел, да так, что я сам тебе проболтался! — он качает головой и с уважением смотрит на тебя. — Хорошо сработано, рубака, — он умолкает. — Как тебе идея обставить Пикита?»~
@36520 = ~Он улыбается. «Да, обставить его... Убрать его с улиц куда подальше, что-то типа того».~
@36521 = ~Он пожимает плечами. «Ну, тогда на этом все. Прощай, пень».~
@36522 = ~Ты видишь Ленни. Он улыбается при твоем приближении. «Привет, рубака. Что я могу для тебя сделать?»~
@36523 = ~«Я сказал тебе все, что знаю, рубака. У меня для тебя больше нет ответов».~
@36524 = ~Ты видишь Ленни. Он улыбается при твоем приближении. «Привет, рубака. Я слышал насчет Байрона, и несказанно этому рад, — он ухмыляется. — Что я могу для тебя сделать?»~
@36525 = ~«Приветствую».~
@36526 = ~Не обращать на него внимания.~
@36527 = ~«У меня есть несколько вопросов...» ~
@36528 = ~«Неважно, прощай».~
@36529 = ~«Мне всего лишь нужно задать тебе пару вопросов...»~
@36530 = ~«Что, если я скажу, что меня послал Байрон Пикит?»~
@36531 = ~«Неважно, прощай».~
@36532 = ~«Отлично, прощай».~
@36533 = ~«Он сказал, что ты можешь ответить мне на несколько вопросов...»~
@36534 = ~«Забудь, это не имеет значения. Прощай».~
@36535 = ~«У меня украли череп, и я хочу вернуть его. Ты не знаешь, кто бы мог это сделать?»~
@36536 = ~«Я хочу спросить тебя насчет бумаг, которые ты украл у Трист».~
@36537 = ~«Я заинтересован в изучении воровского искусства. Ты можешь меня обучить?»~
@36538 = ~«Что ты можешь рассказать об этом районе?»~
@36539 = ~«Неважно. Прощай».~
@36540 = ~«Кто такой Лотар?»~
@36541 = ~«Я слышал о Лотаре, мне лишь нужно найти его».~
@36542 = ~«У меня есть другие вопросы...»~
@36543 = ~«Спасибо, прощай».~
@36544 = ~«Где это место?»~
@36545 = ~«Понятно. У меня еще вопросы...»~
@36546 = ~«Спасибо, прощай».~
@36547 = ~«У меня еще немного вопросов...»~
@36548 = ~«Ладно, прощай».~
@36549 = ~Зловеще усмехнуться: «Ты знаешь, о чем я, Ленни. Байрон заставил тебя украсть у Трист кое-какие бумаги. Я пришел забрать их».~
@36550 = ~Правда: «Отдай мне бумаги, которые ты украл у Трист, иначе я тебя убью».~
@36551 = ~Блеф: «Отдай мне бумаги, которые ты украл у Трист, иначе я тебя убью».~
@36552 = ~«С меня хватит. Прощай».~
@36553 = ~«Правда? Тогда почему ты так нервничаешь, Ленни? Дай, угадаю: Байрон думает, что ты уничтожил бумаги, но, наверно, ты этого не сделал. Наверно, ты их припрятал. Небольшая подборка для шантажа?»~
@36554 = ~«Тогда почему ты так нервничаешь, Ленни? Думаю, что ты лжешь».~
@36555 = ~«Ясно. Я должен идти. Прощай».~
@36556 = ~Схватить его, пока он не убежал.~
@36557 = ~Схватить его, пока он не убежал.~
@36558 = ~Пусть уходит.~
@36559 = ~«Отдай их, Ленни».~
@36560 = ~«Зачем ты оставил их, Ленни? Надо полагать, для шантажа».~
@36561 = ~«Значит, ты их сохранил. Зачем?»~
@36562 = ~«Отдай их, Ленни».~
@36563 = ~«Зачем ты оставил их, Ленни? Надо полагать, для шантажа».~
@36564 = ~«Значит, ты их сохранил. Зачем?»~
@36565 = ~«Тогда пошли за ними».~
@36566 = ~«Я разобрался с этим небольшим дельцем — мы можем забирать бумаги».~
@36567 = ~«Я разберусь с этим и сам заберу бумаги».~
@36568 = ~«С меня хватит. Прощай».~
@36569 = ~«Просто пошли за бумагами, Ленни».~
@36570 = ~«Вообще-то, это Трист здесь в выигрыше, Ленни».~
@36571 = ~Уйти.~
@36572 = ~«Кинуть?»~
@36573 = ~«Зачем его кидать?»~
@36574 = ~«Между прочим, Пикит мне не босс».~
@36575 = ~«Зачем его кидать?»~
@36576 = ~«Между прочим, Пикит мне не босс».~
@36577 = ~«Кинуть?»~
@36578 = ~«Зачем его кидать?»~
@36579 = ~«Между прочим, Пикит мне не босс».~
@36580 = ~«Между прочим, Пикит мне не босс».~
@36581 = ~«Пошли, заберем бумаги, Ленни».~
@36582 = ~«Пошли, заберем бумаги, Ленни».~
@36583 = ~«Я разобрался с этим небольшим дельцем — мы можем забирать бумаги».~
@36584 = ~«Я разберусь с этим и сам заберу бумаги».~
@36585 = ~«С меня хватит. Прощай».~
@36586 = ~«Какую еще премию?»~
@36587 = ~«Его убрали с улиц, Ленни. Байрон мертв».~
@36588 = ~«Это не твое дело».~
@36589 = ~«Я не работаю на Пикита, Ленни».~
@36590 = ~«Да...»~
@36591 = ~«Что ты можешь сказать об Улье?»~
@36592 = ~«Что ты можешь рассказать о Чиновничьем районе?»~
@36593 = ~«У меня есть другие вопросы...»~
@36594 = ~«Спасибо, я уже должен идти. Прощай».~
@36595 = ~«Что ты можешь рассказать о Чиновничьем районе?»~
@36596 = ~«У меня есть другие вопросы...»~
@36597 = ~«Спасибо, я уже должен идти. Прощай».~
@36598 = ~«Что ты можешь сказать об Улье?»~
@36599 = ~«У меня есть другие вопросы...»~
@36600 = ~«Спасибо, я уже должен идти. Прощай».~
@36601 = ~«У меня есть другие вопросы...»~
@36602 = ~«Спасибо, я уже должен идти. Прощай».~
@36603 = ~«У меня есть несколько вопросов...» ~
@36604 = ~«Мне пора идти. Прощай».~
@36605 = ~«У меня есть несколько вопросов...» ~
@36606 = ~«Я хотел бы обучиться воровскому искусству. Ты можешь меня научить?»~
@36607 = ~«Ничего, прощай».~
@36608 = ~«Пикит мне не босс».~
@36609 = ~«Я заинтересован в изучении воровского искусства. Ты можешь меня обучить?»~
@36610 = ~«Отлично, прощай».~
@36611 = ~«Подставить?»~
@36612 = ~«Да, пожалуйста».~
@36613 = ~«Нет, мне теперь все равно — я получил то, за чем пришел».~
@36614 = ~«Я так не думаю, прощай».~
@36615 = ~«Да, пожалуйста».~
@36616 = ~«Нет, мне теперь все равно — я получил то, за чем пришел».~
@36617 = ~«Я так не думаю, прощай».~
@36618 = ~«Прощай».~
@36619 = ~«У меня есть несколько вопросов...» ~
@36620 = ~«Я заинтересован в изучении воровского искусства. Ты можешь меня обучить?»~
@36621 = ~«Ничего, прощай».~
@36622 = ~«Отлично, прощай».~
@36623 = ~«У меня есть несколько вопросов...» ~
@36624 = ~«Я заинтересован в изучении воровского искусства. Ты можешь меня обучить?»~
@36625 = ~«Ничего, прощай».~
@36626 = ~Заклинание искажено планом [Nameless One]~ [NAM125]
@36627 = ~Заклинание искажено планом [Morte]~
@36628 = ~Заклинание искажено планом [Annah]~
@36629 = ~Заклинание искажено планом [Dak'kon]~ [DAK150]
@36630 = ~Заклинание искажено планом [Fall-From-Grace]~ [FFG286]
@36631 = ~Заклинание искажено планом [Nordom]~
@36632 = ~Заклинание искажено планом [Ignus]~ [IGN205]
@36633 = ~Заклинание искажено планом [Vhailor]~
@36634 = ~Заклинание искажено планом [General, other NPC]~
@36635 = ~Заклинание разрушено [Nameless One]~ [NAM123]
@36636 = ~Заклинание разрушено [Morte]~
@36637 = ~Заклинание разрушено [Annah]~
@36638 = ~Заклинание разрушено [Dak'kon]~ [DAK148]
@36639 = ~Заклинание разрушено [Fall-From-Grace]~ [FFG287]
@36640 = ~Заклинание разрушено [Nordom]~
@36641 = ~Заклинание разрушено [Ignus]~ [IGN202]
@36642 = ~Заклинание разрушено [Vhailor]~
@36643 = ~Заклинание разрушено [General, other NPC]~
@36644 = ~Удар в спину! 2x [Annah]~ [ANA524B]
@36645 = ~Не обращать внимания на мужчину.~
@36646 = ~«Хамрис к твоим услугам. Член Гармониума и модельер гробов для недавно ушедших от нас. Кажется, я тебя знаю, или нет?.. — он умолкает на секунду. — В Гармониуме я хорошо запоминал имена, знаешь ли. Любого в районе мог по имени назвать...»~
@36647 = ~Ложь: «Меня зовут Адан».~
@36648 = ~«У меня есть несколько вопросов...» ~
@36649 = ~«Я должен идти. Прощай».~
@36650 = ~«Задавай». Он кивает тебе, широко улыбаясь.~
@36651 = ~«Мне нужно купить подушку для гроба».~
@36652 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@36653 = ~«У меня был череп, который украли. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@36654 = ~«Я потерял дневник. Тебе ничего такого не попадалось?»~
@36655 = ~«Я слышал, что твой отец умер. Ты можешь рассказать, как это случилось?»~
@36656 = ~«А кто это твой друг?»~
@36657 = ~«Можешь рассказать об этом районе?»~
@36658 = ~«Что ты можешь сказать о городе Сигиле?»~
@36659 = ~«Я должен идти, прощай».~
@36660 = ~Он кивает тебе: «Ага! Значит, пришел за покупками. Готов уверить тебя, всю работу я делаю с любовью. Главная ценность моей профессии гробовщика — делать гробы... и делать их хорошо. Это акт создания великолепия, каждая часть должна быть точно подогнана, чтобы целое было лучше. Как это похоже на метафору философии Гармониума... Мы создаем порядок, и он прекрасен...»~
@36661 = ~«Мне нужна только подушка...»~
@36662 = ~Он снова кивает тебе. «На сборку мне нужны доски стоимостью в пятьдесят медяков, хотя время сборки сюда не входит. Возможна побелка либо покраска в выбранный клиентом цвет. Обычно используются доски толщиной в одну шестнадцатую пяди, но можно взять и потолще, в зависимости от тела: хоронят человека или еще кого. Или если боятся, что покойник захочет выбраться». Он хохочет.~
@36663 = ~«Мне нужна только подушка...»~
@36664 = ~Он снова кивает тебе. «Некоторые предпочитают традиционную байтопийскую сосну, но я предпочитаю работать с арборейским дубом, потому что в нем чувствуется вес. Даже одна двадцатая дюйма дуба прочнее одной шестнадцатой пяди сосны...» Он делает паузу.~
@36665 = ~«Я говорю, мне нужна только подушка...»~
@36666 = ~«С меня достаточно. Прощай».~
@36667 = ~Он кивает тебе. «Кроме того, к общей сумме добавляется стоимость двух десятков стальных шурупов размером одна восьмая на один с четвертью дюйм. Они продаются в куче лавок неподалеку, так что достать их — не проблема. Также мне понадобится какие-нибудь гвозди, чтобы прибить внутреннюю обивку. Их лучше брать побольше. Также мне могут понадобиться рейки и скобы, в зависимости от того, что ты хочешь получить в итоге».~
@36668 = ~«Ты меня слышишь? Я говорю, мне нужна только подушка!»~
@36669 = ~«С меня достаточно. Прощай».~
@36670 = ~Он поглаживает рукой подбородок. «Хотя я предпочитаю натуральный цвет дерева, иногда некоторые клиенты хотят покрасить гроб в особый цвет или выполнить резьбу... Обычно я не делаю подобных украшений, несмотря на то что я в этом мастер, но уговор есть уговор... — он переводит дыхание. — А уж ручки — это вообще отдельная история...» Он кивает головой со знанием дела.~
@36671 = ~Вздох: «А что насчет ручек?»~
@36672 = ~«Если ты сейчас не заткнешься и не дашь мне подушку, то я тебя ударю... Больно».~
@36673 = ~«С меня достаточно. Прощай».~
@36674 = ~«Ручки очень важны: тут все зависит от того, кто будет нести гроб. Если у тебя есть умелые люди, способные нести гроб на плечах, то о ручках не стоит заботиться. Знаешь ли, профессиональные несуны ими вообще не пользуются. Но если гроб будут нести члены семьи и друзья, то ручки просто необходимы. Есть веревочные, а есть металлические...» Он удовлетворенно смотрит на тебя.~
@36675 = ~«Это все очень хорошо, но я пришел сюда за подушкой... У тебя они есть?»~
@36676 = ~«Позволь привести пример. Один из прекраснейших гробов, что я видел, был из сосны. Не знаю, где можно было достать такие доски — из Байтопии или еще откуда... Гроб был очень хорошо сделан и красиво отделан красным деревом. Вот только общий вид совершенно испортили грубые конопляные веревки. Конечно, несунам нужны были приспособления для переноски, но опошлить такой прекрасный гроб вульгарной веревкой...» Он качает головой.~
@36677 = ~«Уверен, что это все захватывающе, но мне нужна только подушка...»~
@36678 = ~«С меня достаточно. Прощай».~
@36679 = ~«А еще большое значение имеют мерки. Тут может быть много подводных камней, поэтому я всегда стараюсь сделать мерку лично, а то иногда клиент отказывается сообщать расу усопшего или забывает сообщить ширину бедер... А ведь все это очень важно. А если клиент все еще живой, я всегда стараюсь сделать так, чтобы он после смерти вошел в гроб как влитой, понимаешь? — он делает паузу. — А еще есть особенности сборки...»~
@36680 = ~«Хамрис...»~
@36681 = ~«Есть несколько способов соединить стенки гроба между собой и с дном. Некоторые используют рейки и скобы изнутри, привинчивая их шурупами. Еще можно воспользоваться способом 'демонический зуб', вырезав по краям шипы и выемки таким образом, чтобы они крепко сцеплялись, словно челюсти демона. Требует больше затрат и точности, но результат опрятный и очень прочный». Он снова переводит дыхание.~
@36682 = ~«Хамрис...»~
@36683 = ~«А еще крышка. У крышки должна быть кромка либо окантовка по краям, сделанная из прибитых дощечек или вырезанная прямо на дереве. Сначала нужно насверлить направляющих отверстий примерно в полупяди друг от друга, а потом вкрутить в них шурупы...» Ты поражаешься тому, что он даже и не собирается останавливаться.~
@36684 = ~«Если ты сейчас не заткнешься и не дашь мне подушку, то я тебя ударю... Больно».~
@36685 = ~«С меня достаточно. Прощай».~
@36686 = ~Кажется, ты наконец-то привлек его внимание. Он в смущении хмурит брови. «Прошу прощения?»~
@36687 = ~«Я сказал, что мне нужна подушка для гроба. Больше ничего, только подушка. У тебя они есть?»~
@36688 = ~Он с облегчением улыбается: «Подушка? А я-то подумал, что тебе нужен весь гроб, — он снова поглаживает подбородок. — Извини, но подушки у меня кончились. Не знаю, когда они у меня появятся: на складе все закрыто...»~
@36689 = ~«На складе?»~
@36690 = ~«Да, ты уже говорил об этой проблеме. Что там произошло, еще раз?»~
@36691 = ~«У меня есть другие вопросы...»~
@36692 = ~«С меня достаточно. Прощай».~
@36693 = ~«Да... На складе, где я храню свои товары, какие-то внутренние проблемы. Новое руководство или еще какая чепуха. И теперь я не могу пополнять свои запасы, — он хмурится. — Гармониум никогда бы не допустил, чтобы все шло настолько из рук вон плохо, что это доставляло клиентам неудобства...» Он умолкает в раздумьях, после чего смотрит на тебя. «Может быть, ты поможешь мне разобраться с этим?»~
@36694 = ~«Я разобрался со складом. Теперь пойду и заберу подушку».~
@36695 = ~«Похоже, у меня нет выбора, если я хочу заполучить подушку. Я сделаю это».~
@36696 = ~«Это не моя проблема... Почему ты не разберешься сам?»~
@36697 = ~«Я подумаю над этим. У меня есть еще вопросы».~
@36698 = ~«Мне нужно идти, прощай».~
@36699 = ~Он широко улыбается. «Великолепно. Если справишься с этой проблемой, то получишь свою подушку бесплатно... — его лицо снова становится как у лектора. — Хоть оплаты и не будет, но позволь мне рассказать о строении этих подушек...»~
@36700 = ~«Нет, спасибо! Лучше я займусь этим делом поскорее. Прощай».~
@36701 = ~«В другой раз. У меня есть несколько вопросов...» ~
@36702 = ~Он хмурится. «Я попробовал, но без успеха. Попробовал передать это дело в Гармониум, но в данном случае они ничем не могут помочь» Он бросает на тебя невинный взгляд и поднимает руки, словно сдаваясь. «Но если тебе в самом деле нужна подушка...» Он выжидающе смотрит на тебя.~
@36703 = ~«Хорошо. Я разберусь с этим делом».~
@36704 = ~«Я подумаю над этим. У меня есть еще вопросы...»~
@36705 = ~«Забудь. Прощай».~
@36706 = ~Он щелкает пальцами: «Ну конечно же! Адан! Знал, что вспомню тебя. Ну да ладно. Тебе нужны мои услуги?» Изучив тебя, он улыбается, пытаясь найти возможность удачно пошутить на твой счет. «Кажется, сэр, тебе в скором времени очень сильно пригодится гроб». Кажется, он очень доволен своим остроумием.~
@36707 = ~«У меня есть несколько вопросов...» ~
@36708 = ~«Я должен идти. Прощай».~
@36709 = ~Он крепко задумывается. «Не скажу, что не слышал об этом парне. Как ты сказал, Повелитель Костей? Очень запоминающаяся кличка, — он улыбается. — По правде говоря, такую же кличку ты можешь дать и мне, ведь я работаю с трупами. Правда, они все с плотью, но мне частенько приходилось делать гроб для голых костей. Был однажды парень, у которого кости были чем-то обчищены. Никак не могу понять только чем...»~
@36710 = ~Прервать: «У меня есть несколько вопросов...»~
@36711 = ~«Я должен идти. Прощай».~
@36712 = ~Удивленно подняв брови, он пожимает плечами. «Понятия не имею, кто мог сделать подобную вещь. Хотя мне приходилось хоронить не так уж много черепов. Понимаешь, большинство людей не собирается хоронить одни черепа в гробах, но у меня много историй о некоторых причудах насчет конструкции гроба. Некоторые хотели похоронить только череп, потому что остальную часть тела найти не удалось. Был один клиент, чье тело настолько было обезображено хаоситеками, что...»~
@36713 = ~Прервать: «Что за хаоситеки?»~
@36714 = ~Прервать: «У меня есть несколько вопросов...»~
@36715 = ~«Я должен идти. Прощай».~
@36716 = ~Перед тем, как ответить, он на некоторое время задумывается. «На этот вопрос невозможно ответить, приятель. Они — одна из фракций Сигила, которая верит в хаос, — еще немного подумав, он пожимает плечами. — Из того, что они лопочут, нельзя понять и половины. Они постоянно прерываются, перепрыгивают с темы на тему. Их разум, если он у них есть, очень запутан. Так вот, как я сказал...»~
@36717 = ~Прервать: «У меня есть несколько вопросов...»~
@36718 = ~«Я должен идти. Прощай».~
@36719 = ~Он пожимает плечами. «Не могу сказать, что видел... За исключением моего дневника. Я предпочитаю сохранять свои заметки и размышления, а потом читать их месяц спустя. Это так захватывает». Он кивает тебе, словно ты понимаешь, о чем он говорит.~
@36720 = ~«Это хорошо, но...»~
@36721 = ~Он продолжает занудствовать. «Я разговаривал с некоторыми печатниками из Чиновничьего района насчет издания моих записей. Я говорил, что в них есть очень интересные моменты о различных аспектах городской жизни, которые я приметил во время службы в Гармониуме. Даже без особой подготовки все они признали, что мой стиль весьма необычный... но и только. Гораздо проще зачитать их тебе напрямую. Некоторые очерки очень жизненные...»~
@36722 = ~«Хорошо, давай».~
@36723 = ~«Не сейчас, у меня есть еще вопросы».~
@36724 = ~«На сегодня достаточно. Прощай».~
@36725 = ~Хамрис зачитывает несколько эпизодов из своих однообразных записей, все они скучны. Ты уже начинаешь искать способ уйти, когда он что-то упоминает об исчезновении своего отца. Почему-то эта история приковывает твое внимание.~
@36726 = ~«Погоди, что ты говорил насчет исчезновения своего отца?»~
@36727 = ~«Это все хорошо, но меня есть еще вопросы...»~
@36728 = ~«На сегодня достаточно. Прощай».~
@36729 = ~Хамрис поднимает руку, прерывая твои попытки, и дочитывает очередной параграф своих бестолковых дневников. «Ну как тебе? Гораздо проницательнее, чем можно было ожидать от рядового члена Гармониума, да?» Он улыбается, совершенно проигнорировав твою попытку вмешаться.~
@36730 = ~«Да, очень проницательно. Ты сказал, что твой отец пропал?»~
@36731 = ~«По правде говоря, твои дневники... невозможно переварить за один присест. У меня есть несколько вопросов...»~
@36732 = ~«Твоего голоса я наслушался до конца своей жизни. Прощай».~
@36733 = ~Он кивает. «О, да. Много лет назад. Мой отец был талантливым каменщиком, он не только делал саркофаги, но и умел очень искусно конструировать гробницы. Люди со всего Сигила...» Комната вокруг тебя начинает расплываться, когда воспоминание врывается в твое сознание...~
@36734 = ~Расслабиться и попробовать вспомнить.~
@36735 = ~Подавить его и продолжить слушать Хамриса.~
@36736 = ~Ты оказываешься в этом самом магазине. Ты разговариваешь со стариком. В углу сидит и играет ребенок. На столе между тобой и владельцем магазина разложен план. Кажется, он объясняет некоторые сложности в конструкции гробницы. Ты пытаешься внимательно разглядеть планы, но твой взгляд темнеет.~
@36737 = ~Продолжить.~
@36738 = ~Когда зрение возвращается, ты оказываешься в пещере перед гробницей. Над собой ты замечаешь вырезанный в камне девиз «Построено на века». Владелец магазина с широкой улыбкой на лице стоит рядом с тобой. Он жестом зовет тебя и направляется в гробницу. Ты быстро идешь за ним по пятам, доставая клинок...~
@36739 = ~Продолжить.~
@36740 = ~Ты оказываешься в магазине Хамриса. Он обеспокоенно смотрит на тебя. «С тобой все в порядке?»~
@36741 = ~«Расскажи, что случилось с твоим отцом».~
@36742 = ~«Я в порядке. У меня есть несколько вопросов...»~
@36743 = ~«Нет, я должен идти. Прощай».~
@36744 = ~«Однажды он просто пропал, оставил большинство заказов незавершенными. Это очень прискорбно — мы еще долго расплачивались по долгам из-за его исчезновения, а у меня до сих пор остались некоторые счета. Но все же у меня есть способности к работе и...» Он вздыхает, отводя взгляд.~
@36745 = ~«Продолжай».~
@36746 = ~Он пожимает плечами. «Извини, я просто задумался... Исчезновение моего отца стало той причиной, почему я присоединился к Гармониуму, а потом покинул его. Сначала я горел желанием выяснить, что случилось с ним, а потом почувствовал, что должен продолжить дело его жизни, — вздыхает он. — Я так и не нашел ответов. Произошедшее так и осталось в тайне...»~
@36747 = ~«У твоего отца были планы гробниц, которые он построил?»~
@36748 = ~«У меня есть несколько вопросов...» ~
@36749 = ~«Мне пора уходить, прощай».~
@36750 = ~Он задумывает. «Да, были. Когда мне досталось его дело, я проверил все его записи. Они были очень обширны. А почему ты спрашиваешь?»~
@36751 = ~«Если я опишу тебе гробницу, ты сможешь ответить, является ли она работой твоего отца?»~
@36752 = ~«Просто так. У меня есть другие вопросы...»~
@36753 = ~«Неважно. Прощай».~
@36754 = ~Он хмуро пожимает плечами. «По крайней мере, можно попробовать. Тренировки в Гармониуме развили во мне острую память, так что я могу распознать работу отца, если ты дашь мне достаточно деталей». Он выжидающе смотрит на тебя.~
@36755 = ~Описать гробницу из твоего воспоминания.~
@36756 = ~«У меня есть другие вопросы...»~
@36757 = ~«Неважно, я должен идти. Прощай».~
@36758 = ~На некоторое время он задумывается. «Нет сомнения в том, что эта гробница является работой отца. Этот девиз был нашей семейной визитной карточкой на протяжении нескольких поколений, — умолкнув, он странно смотрит на тебя. — Что это за гробница, где она находится?»~
@36759 = ~Описать расположение.~
@36760 = ~«У меня есть другие вопросы...»~
@36761 = ~«Неважно, я должен идти. Прощай».~
@36762 = ~Ты подробно описываешь расположение, с удивлением отмечая имеющиеся знания об этом месте. Хамрис озабоченно смотрит на тебя. «Странно, что-то я не припомню в семейных записях того, что ему было разрешено там строить гробницу. Тленные очень щепетильны в вопросах, касающихся разрешений на строительство и владения землей, особенно под улицами Сигила...»~
@36763 = ~«Так ты узнаешь расположение?»~
@36764 = ~«У меня есть другие вопросы...»~
@36765 = ~«Неважно, я должен идти. Прощай».~
@36766 = ~Он энергично кивает. «О да. Очень напоминают катакомбы Затопленных Народов. Никогда сам там не был, но много раз слышал описания в годы моей службы в Гармониуме».~
@36767 = ~«Мне нужно знать, был ли план этой гробницы у твоего отца».~
@36768 = ~«У меня есть другие вопросы...»~
@36769 = ~«Неважно, я должен идти. Прощай».~
@36770 = ~«Да... На складе, где я храню свои товары, также хранятся мои деловые бумаги. Но у них какие-то внутренние проблемы. Новое руководство или еще какая чепуха. И теперь я не могу пополнять свои запасы. Сомнительно, что я смогу теперь забрать бумаги оттуда, — хмурится он. — Гармониум никогда бы не допустил, чтобы все шло настолько из рук вон плохо, что это доставляло клиентам неудобства...» Он умолкает в раздумьях, после чего смотрит на тебя. «Может быть, ты поможешь мне с этим разобраться?»~
@36771 = ~«На складе?»~
@36772 = ~«Да, ты уже говорил об этой проблеме. Что там произошло, еще раз?»~
@36773 = ~«У меня есть другие вопросы...»~
@36774 = ~«Неважно, я должен идти. Прощай».~
@36775 = ~«Да... На складе какие-то *внутренние проблемы*, что бы это ни значило. Я не могу ничего забрать со склада, пока все не нормализуется, — хмурится он. — Гармониум никогда бы не допустил, чтобы все шло настолько из рук вон плохо, что это доставляло клиентам неудобства...» Он умолкает в раздумьях, после чего смотрит на тебя. «Может быть, ты поможешь мне с этим разобраться?»~
@36776 = ~«Я разобрался со складом, теперь пойду и заберу оттуда планы».~
@36777 = ~«Похоже, у меня нет выбора, если я хочу заполучить планы. Я сделаю это».~
@36778 = ~«Это не моя проблема... Почему ты не разберешься сам?»~
@36779 = ~«Я подумаю над этим. У меня есть еще вопросы».~
@36780 = ~«Мне нужно идти, прощай».~
@36781 = ~Он широко улыбается. «Великолепно. Если справишься с этой проблемой, то получишь свои планы бесплатно... — его лицо снова становится как у лектора. — Хоть оплаты и не будет, но позволь мне рассказать о сложностях, которые сопровождают создание подобных планов...»~
@36782 = ~«Нет, спасибо! Лучше я займусь этим делом поскорее. Прощай».~
@36783 = ~«В другой раз. У меня есть несколько вопросов...» ~
@36784 = ~Он хмурится. «Я пытался, но без успеха. Попробовал передать это дело в Гармониум, но в данном случае они ничем не могут помочь» Он бросает на тебя невинный взгляд и поднимает руки, словно сдаваясь. «Но если тебе в самом деле нужны планы...» Он выжидающе смотрит на тебя.~
@36785 = ~«Хорошо. Я разберусь с этим делом».~
@36786 = ~«Я подумаю над этим. У меня есть еще вопросы...»~
@36787 = ~«Забудь. Прощай».~
@36788 = ~Он смотрит на тебя хмуро. «Он пропал много лет назад, поэтому я могу только предполагать, что он умер. Где ты это услышал?»~
@36789 = ~«Не помню. Ты сказал, он пропал?»~
@36790 = ~«Неважно. У меня есть другие вопросы...»~
@36791 = ~«Я должен идти. Прощай».~
@36792 = ~Он смотрит на покупателя. «Димтри? — он пожимает плечами, словно только его заметил. — Тихий, немногословный, верно, Димтри?» Димтри не отвечает и пялится таким же пустым взглядом. Несколько секунд спустя он кивает. Хамрис снова пожимает плечами, после чего возвращается к тебе. «Зашел однажды пару недель назад, теперь постоянно сюда наведывается. Ничего не покупает, но проблем от него нет никаких, так что я разрешаю ему оставаться. Он довольно безобидный. Понимаешь, когда я служил в Гармониуме, часть нашей работы заключалась в заботе о людях, предоставлении им убежища от хаоса улиц, приведения их в порядок...»~
@36793 = ~«Ты разве не знаешь, что он — зомби?»~
@36794 = ~«Понятно. У меня еще есть вопросы...»~
@36795 = ~«Я должен идти. Прощай».~
@36796 = ~Он хмурится, глядя на Димтри. «Что за чепуху ты мелешь? Димтри не зомби. Ну да, он молчалив и мало двигается, но это оттого, что он хороший слушатель...»~
@36797 = ~Ударить Димтри: «Смотри, Димтри — зомби».~
@36798 = ~«Неважно. У меня есть другие вопросы...»~
@36799 = ~«Я должен идти. Прощай».~
@36800 = ~Хамрис пораженно смотрит на тебя: «Что, во имя Гармониума, ты...» Ты отвешиваешь Димтри подзатыльник. Тот даже глазом не моргнул. Хамрис становится красным от злости. «Ты зашел слишком далеко! Я не позволю бить моих клиентов! Властью Гармониума я заключаю тебя под арест...» Он обрывает себя, не видя никакой реакции со стороны Димтри.~
@36801 = ~«Он зомби, Хамрис...»~
@36802 = ~Хамрис смущенно смотрит на Димтри. «Интересно, как он умер». Тебя не покидает чувство, что Хамрис все еще не понял этого. «Просто раньше он выглядел довольно живым, — он хмыкает, не находя больше слов. — Ну что ж, похоже, старине Димтри нужен гроб. Хорошо, что он оказался здесь. Ведь очень важно, какой гроб нужен...» Кажется, он снова собирается начать лекцию.~
@36803 = ~«У меня есть несколько вопросов...» ~
@36804 = ~«Мне пора идти. Прощай».~
@36805 = ~«Да, Нижний район... — он наклоняется вперед, словно объясняя что-то ребенку. — Знаешь, немногие из новоприбывших и даже из жителей района хорошо его знают. Большинство считает, что этот район называется так потому, что он не такой престижный по сравнению с другими, но это еще не все. Далеко не все. Знаешь ли ты, откуда пошло это название? А?» Он выжидающе смотрит на тебя.~
@36806 = ~«От всех этих порталов в Нижние планы?»~
@36807 = ~«Нет, я не знаю, откуда пошло это название».~
@36808 = ~«Меня не интересует происхождение названия, просто скажи, на что здесь можно посмотреть?»~
@36809 = ~Он кивает, несколько разочарованный тем, что ты уже знаешь. «Да, именно. Эти порталы в Нижние планы также являются причиной этого смога, — он смотрит вверх, на воображаемое небо над головой, — но я уверен, что ты уже знаком с досадными условиями этого района».~
@36810 = ~«Да, у меня есть еще вопросы...»~
@36811 = ~«Нет, расскажи мне об этом».~
@36812 = ~«От порталов в Нижние планы! Вот почему это место постоянно накрывает смог, заполняя все зловонным воздухом. К счастью, ветер со Шпиля периодически выдувает этот туман. Но все же слабым он может серьезно подкосить здоровье, — он печально качает головой. — Хорошо, что мои тренировки в Гармониуме подготовили меня ко всем видам опасных условий, а после путешествий по Нижним планам здешний смог можно легко переносить...»~
@36813 = ~«Что интересного можно увидеть в этом районе?»~
@36814 = ~«Понятно. У меня еще есть вопросы...»~
@36815 = ~«Я должен идти. Прощай».~
@36816 = ~Он широко улыбается. «Много всего разного. С чего же начать... Если отбросить все доменные печи, кузницы, пивоварни и перегонные заводы, разбросанные среди мусорных костров, не говоря уже о каморках алхимиков, крематориях, консервных цехах, углежогах и рассматривать район как целое, можно сказать, что... Здесь есть Литейная, осадная башня и...» Он останавливается в раздумьях.~
@36817 = ~«Расскажи мне о Литейной».~
@36818 = ~«Расскажи мне об осадной башне».~
@36819 = ~«У меня есть несколько вопросов...» ~
@36820 = ~«Я должен идти. Прощай».~
@36821 = ~«Великая Литейная является штаб-квартирой верящих в Первопричину, также известных среди обывателей под названием 'боголюди', поскольку их убеждения основываются на том, что каждый может постичь божественность, — он качает головой. — Великая Литейная сходна их философии: беспорядочное здание, не производящее ничего, кроме дыма — он смеется. — Вот когда ты видел в последний раз, чтобы хоть кто-нибудь из верящих в Первопричину вдруг ни с того ни с сего стал силой? За всю историю фракции такое ни разу не происходило».~
@36822 = ~«Расскажи мне о боголюдях».~
@36823 = ~«Расскажи мне об осадной башне».~
@36824 = ~«У меня есть несколько вопросов...» ~
@36825 = ~«Я должен идти. Прощай».~
@36826 = ~«Та страшная железная развалина? Это большая тайна района, но насчет нее у меня есть пара идей. Во-первых, насколько я знаю, она здесь была не всегда. Просто появилась однажды ночью, правда, никто не видел как. А ты видел, как она выглядит? Она определенно участвовала в битвах, которых некоторые даже себе вообразить не смогут. Вот я побывал в разных уголках Кровавой войны, даже с парочкой танарри довелось схлестнуться, когда положение становилось совсем отчаянным, а рядом со мной были только мои верные товарищи по Гармониуму... А тем следам на башне по меньшей мере несколько столетий». Он делает паузу.~
@36827 = ~«Продолжай».~
@36828 = ~«А теперь слушай внимательно. По своему опыту я могу распознать некоторые из тех следов, что украшают ее стены. Некоторые из них от кислотных взрывов, очевидно, сотворенных очень могущественными волшебниками. Некоторые оставлены зубастыми клинками танарри, другие похожи на следы от взрывов сфер лотов или плетей корнугонов баатезу. Но многое из того оружия, что видно на стенах башни, я вижу впервые в жизни, а уж я-то повидал оружия всякого со всех планов. Отсюда напрашивается вопрос — а что внутри башни? Вояки, которым удастся взломать эту башню, могут стать владельцами целого оружейного музея. Любопытно, правда?» Он смотрит на тебя.~
@36829 = ~«Расскажи мне о Литейной».~
@36830 = ~«У меня есть несколько вопросов...» ~
@36831 = ~«Я должен идти. Прощай».~
@36832 = ~«На самом деле, друг, 'боголюди' — это обывательское название их фракции. Настоящее имя их организации — верящие в Первопричину. Они опираются на интересную, но совершенно несостоятельную философию: они убеждены, что любой имеет возможность обрести статус божественности, просто работая над собой...» Он снисходительно качает головой.~
@36833 = ~«Продолжай».~
@36834 = ~«Как очень быстро показала моя служба в Гармониуме, очень многие никогда не достигнут божественности, неважно, сколько они при этом будут работать над собой... — усмехается он. — И все же верящие в Первопричину трудятся очень упорно... — он пожимает плечами — Да и их маленькая фракция довольно таки забавна».~
@36835 = ~«Расскажи мне об осадной башне».~
@36836 = ~«Ты можешь рассказать что-нибудь о других фракциях?»~
@36837 = ~«У меня есть несколько вопросов...» ~
@36838 = ~«Я должен идти. Прощай».~
@36839 = ~«Сигил... — он делает глубокий вздох. — Сигил — это город в центре всего, как многие верят. Это город дверей, в нем буквально сотни порталов. Это дом самой Леди Боли — он пожимает плечами. — Сигил... про него можно писать тома, и тома, и тома...»~
@36840 = ~«Расскажи мне о Леди Боли».~
@36841 = ~«Ты упомянул о порталах. Ты знаешь какой-нибудь?»~
@36842 = ~«У меня есть несколько вопросов...» ~
@36843 = ~«Я должен идти. Прощай».~
@36844 = ~«Леди Боли... — Хамрис слегка наклоняется, понизив голос. — Без сомнений, одна из величайших загадок мультивселенной. Думаю, она не оставила и тени сомнения, что женщины являются самыми опасными существами в мультивселенной...» Он вздыхает.~
@36845 = ~«Продолжай».~
@36846 = ~«Кто-то говорит, что она богиня, сила, избравшая Сигил своим домом. Правда в том, что она нарушает все правила сил, которые я встречал. Силам нужны поклонники, которые дают им силу, но Леди не нравятся поклонения. Такие люди заканчивают жизнь в ее тени, разрезанные на части невидимым клинками. Я повидал в своей жизни много ужасных вещей, которые могут вызвать дрожь в коленях и заставить потерять контроль над собой. Но они не идут ни в какое сравнение с тем, что делает Леди со своими жертвами».~
@36847 = ~«Интересно. А что еще ты можешь мне сказать?»~
@36848 = ~«У меня есть несколько вопросов...» ~
@36849 = ~«Я должен идти. Прощай».~
@36850 = ~«Еще она не терпит людей, которые решили поиграть в Сигиле в богов. Ты, может быть, не знал, но силы не могут войти в Сигил, ни Зевс, ни Ра, никто вообще. Говорят, что присутствие Леди каким-то образом держит их в стороне от этого места. Не могут, и все тут, а что они только не пробовали, ты не поверишь. Сигил похож на спелый плод, который каждый норовит сорвать, так что силы всегда ищут способ попасть в Сигил. Но пока им это не удается».~
@36851 = ~«Продолжай».~
@36852 = ~«Это еще не все. Леди не только держит их подальше от города, она еще бережет город от любого, кто пытается навредить ему изнутри. Определенно, тут она получает поддержку от нашей фракции, Гармониума, так как нам тоже нравится порядок. Но иногда какому-нибудь вояке взбредет в голову устроить резню на улицах, или решит он убить несколько дабусов, выплеснуть немного хаоса, или начнет колдовать заклинания массового уничтожения. Нехорошие вещи. Которые могут разозлить Леди. Ей не нравится, когда ее городу причиняют вред. И тогда за это она убивает... или заключает в лабиринт».~
@36853 = ~«В лабиринт?»~
@36854 = ~«У меня есть несколько вопросов...» ~
@36855 = ~«Я должен идти. Прощай».~
@36856 = ~«Ты еще не слышал про лабиринты? — он снисходительно смотрит на тебя. — Да ты совсем зеленый. У Леди есть тюрьмы в других измерениях, куда она помещает особо провинившихся. Понимаешь, она берет маленький кусочек Сигила, формирует из него лабиринт, а потом вырезает его из Сигила. Идешь ты домой ночью или проходишь дверной проем рядом с домом, а потом вдруг все меняется. Ты не узнаешь своего места. Ты в западне. Говорят, из лабиринта есть единственный выход, но ты скорее умрешь и истлеешь, прежде чем распутаешь эту загадку».~
@36857 = ~«У меня есть несколько вопросов...» ~
@36858 = ~«Я должен идти. Прощай».~
@36859 = ~Он улыбается тебе, готовясь к рассказу. «Ну конечно же, почему нет? Я могу рассказать немного о Гармониуме, убийцах милосердия или законниках. С кого начать?»~
@36860 = ~«С законников».~
@36861 = ~«С Гармониума».~
@36862 = ~«С убийц милосердия».~
@36863 = ~«У меня есть несколько вопросов...» ~
@36864 = ~«Я должен идти. Прощай».~
@36865 = ~Он кивает. «Их настоящее название — Братство Порядка. Они посвящают себя закону и знаниям. Большую часть своего времени они тратят на изыскания в нюансах какого-нибудь закона. Я сейчас говорю не о людских законах. Нет, их поиски производятся гораздо глубже. Они хотят знать, как и почему все происходит. Так как их призвание — закон, они также ведут суды в Сигиле и действуют в качестве законников, судей, адвокатов и так далее».~
@36866 = ~«Расскажи мне о другой фракции...»~
@36867 = ~«У меня есть несколько вопросов...» ~
@36868 = ~«Я должен идти. Прощай».~
@36869 = ~Он гордо выпячивает грудь. «Основной фракцией в Сигиле, конечно же, является Гармониум. Наша фракция призвана оберегать закон и порядок в Сигиле, и нет ничего важнее этого. Прогресс может быть достигнут только в состоянии мира и гармонии. Есть те, кто думает иначе, но они не имеют нашей решимости, и, следовательно, потерпят крах».~
@36870 = ~«Расскажи мне о другой фракции...»~
@36871 = ~«У меня есть несколько вопросов...» ~
@36872 = ~«Я должен идти. Прощай».~
@36873 = ~Он улыбается. «Убийцы милосердия опираются на правосудие. Правосудие есть во всем. Оно абсолютно и идеально. Они посвящают себя вынесению правосудия, но это должно делаться правильно, в соответствии с законами. Они крепко убеждены в то, что насаждение справедливости в мультивселенной может привести к искоренению зла и безупречности».~
@36874 = ~«Расскажи мне о другой фракции...»~
@36875 = ~«У меня есть несколько вопросов...» ~
@36876 = ~«Я должен идти. Прощай».~
@36877 = ~Он хохочет. «Порталы? Знаю ли я порталы? — он делает паузу. — Ну, лично не знаю, кроме самых известных. Я знаю, что их можно найти практически в каждом районе... Порталы — очень интересные штуки, иногда они меняют свое расположение, а иногда и просто пропадают... Их трудно отслеживать».~
@36878 = ~«У меня есть несколько вопросов...» ~
@36879 = ~«Я должен идти. Прощай».~
@36880 = ~«Здравствуй. Подбираешь себе гроб?» Он дружески улыбается тебе.~
@36881 = ~«У меня есть несколько вопросов...» ~
@36882 = ~«Я должен идти. Прощай».~
@36883 = ~Хамрис улыбается тебе. «Добрый день, сэр. Ты не надумал помочь мне с проблемой на складе?»~
@36884 = ~«Да, я помогу тебе».~
@36885 = ~«Нет, я все еще думаю об этом. Прощай».~
@36886 = ~«У меня есть несколько вопросов...» ~
@36887 = ~Хамрис улыбается тебе. «Добрый день, сэр. Ты не надумал помочь мне с проблемой на складе?»~
@36888 = ~«Да, я помогу тебе».~
@36889 = ~«Нет. Прощай».~
@36890 = ~«У меня есть несколько вопросов...» ~
@36891 = ~Хамрис улыбается тебе. «Добрый день, сэр. Ты еще не разобрался с ситуацией на складе?»~
@36892 = ~«Нет, я все еще работаю над этим. Прощай».~
@36893 = ~«Нет, но у меня есть вопросы к тебе...»~
@36894 = ~Хамрис улыбается тебе. «И снова привет, рубака. Забрал подушку, которую искал?»~
@36895 = ~«У меня есть несколько вопросов...» ~
@36896 = ~~
@36897 = ~Хамрис улыбается тебе. «Добрый день, сэр. Ты не надумал помочь мне с проблемой на складе?»~
@36898 = ~«УХОДИ. НЕ ИСПЫТЫВАЙ НАШЕ ТЕРПЕНИЕ».~
@36899 = ~«Уйти? Но...»~
@36900 = ~«МЫ ЗНАЕМ. УХОДИ».~
@36901 = ~«О Многоголосый повелитель, этот посягатель хочет многое вам поведать».~
@36902 = ~«Не позволяйте ложным воспоминаниям о жизни ввести себя в заблуждение».~
@36903 = ~«Нас выкинули из клубка жизни, связывающего нас. Мы впервые на свободе».~
@36904 = ~«Мы свободны делать ошибки. Мы свободны НЕ делать ошибки».~
@36905 = ~«Наши жизни теперь имеют больший смысл, чем когда-либо».~
@36906 = ~«Не поддавайтесь искушению творит зло. Сие существование для нас — дар. Не позволяйте страстям повелевать вами».~
@36907 = ~«Сохраняйте в душе спокойствие Безмолвного Короля. Он весьма доволен вами».~
@36908 = ~«Возвращайтесь к своей работе».~
@36909 = ~«Не... не знаю... жжотссся...»~
@36910 = ~«Помогите этим людям искупить долг перед обществом. Делайте ставки!»~
@36911 = ~«Сарос! Рад тебя видеть!»~
@36912 = ~«Да, я помогу тебе».~
@36913 = ~«Нет, я все еще думаю об этом. Прощай».~
@36914 = ~«У меня есть несколько вопросов...» ~
@36915 = ~Хамрис улыбается тебе. «Добрый день, сэр. Ты не надумал помочь мне с проблемой на складе?»~
@36916 = ~«Да, я помогу тебе».~
@36917 = ~«Нет, я все еще думаю об этом. Прощай».~
@36918 = ~«У меня есть несколько вопросов...» ~
@36919 = ~Он широко улыбается. «Великолепно. Я могу помочь тебе еще в чем-нибудь?»~
@36920 = ~«У меня есть несколько вопросов...» ~
@36921 = ~«Нет, прощай».~
@36922 = ~«Э-э... Тогда прощай».~
@36923 = ~«Э-э... Тогда прощай».~
@36924 = ~Удар в спину! 3x [Annah]~ [ANA522D]
@36925 = ~Удар в спину! 4x [Annah]~ [ANA522A]
@36926 = ~Удар в спину! 5x [Annah]~ [ANA522D]
@36927 = ~Удар в спину! 6x [Annah]~ [ANA522A]
@36928 = ~Удар в спину! 2x [General, other NPC]~
@36929 = ~Удар в спину! 3x [General, other NPC]~
@36930 = ~Удар в спину! 4x [General, other NPC]~
@36931 = ~Удар в спину! 5x [General, other NPC]~
@36932 = ~Удар в спину! 6x [General, other NPC]~
@36933 = ~Успешный взлом [Nameless One]~ [NAM105]
@36934 = ~Успешный взлом [Morte]~ [MRT415C]
@36935 = ~Успешный взлом [Annah]~ [ANA487G]
@36936 = ~Успешный взлом [Dak'kon]~ [DAK172]
@36937 = ~Успешный взлом [Fall-From-Grace]~
@36938 = ~Успешный взлом [Nordom]~ [NOR235]
@36939 = ~Успешный взлом [Ignus]~ [IGN222]
@36940 = ~Успешный взлом [Vhailor]~ [VHA228]
@36941 = ~Неудачный взлом [Nameless One]~ [NAM162]
@36942 = ~Неудачный взлом [Morte]~ [MRT417D]
@36943 = ~Неудачный взлом [Annah]~ [ANA554E]
@36944 = ~Неудачный взлом [Dak'kon]~ [DAK174]
@36945 = ~Неудачный взлом [Fall-From-Grace]~
