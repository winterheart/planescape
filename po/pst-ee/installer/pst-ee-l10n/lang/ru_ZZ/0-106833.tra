@42922 = ~~
@42923 = ~~
@42924 = ~~
@42925 = ~~
@42926 = ~~
@42927 = ~~
@42928 = ~~
@42929 = ~«Я бы посоветовал проигнорировать эту цыпочку... веди себя отстраненно и невозмутимо. Вот это уж точно добавит остроты в ваши отношения!»~
@42930 = ~«Доверься мне, малыш. Начни игнорировать ее, придумай какие-нибудь придирки, пусть гадает — и тогда она станет из кожи вон лезть, лишь бы понять, в чем дело. Верно, шеф?»~
@42931 = ~«Да... Она подумает, что что-то не так, и в кои-то веки он превратится из мишени в игрока».~
@42932 = ~«Нет... это плохая идея».~
@42933 = ~Повертеть игрушку и посмотреть, что из этого получится.~
@42934 = ~Повертеть игрушку и посмотреть, что из этого получится.~
@42935 = ~Повертеть игрушку и посмотреть, что из этого получится.~
@42936 = ~Согнуть левое колено, пока нога не согнется под углом пятнадцать градусов, расправить по максимуму оба крыла, потом повернуть правую руку в месте крепления на 180 градусов.~
@42937 = ~Повертеть игрушку и посмотреть, что из этого получится.~
@42938 = ~Ты сгибаешь и поворачиваешь разные шарнирные соединения игрушки, замечая, что конечности часто возвращаются в свое исходное положение. Наконец, когда ты сгибаешь ее левое колено, игрушка издает странный хлопок и дрожит в твоих руках...~
@42939 = ~~
@42940 = ~Повернуть левую руку.~
@42941 = ~~
@42942 = ~Повернуть правую руку.~
@42943 = ~Раскрыть левое крыло.~
@42944 = ~Раскрыть правое крыло.~
@42945 = ~~
@42946 = ~~
@42947 = ~Согнуть правое колено.~
@42948 = ~~
@42949 = ~Отложить куб.~
@42950 = ~Внезапно конечности игрушки с тихим клацаньем возвращаются в свои исходные положения.~
@42951 = ~~
@42952 = ~Повернуть левую руку.~
@42953 = ~~
@42954 = ~Повернуть правую руку.~
@42955 = ~Раскрыть левое крыло.~
@42956 = ~Раскрыть правое крыло.~
@42957 = ~Согнуть левое колено.~
@42958 = ~~
@42959 = ~Согнуть правое колено.~
@42960 = ~~
@42961 = ~Отложить куб.~
@42962 = ~Игрушка издает странный хлопок и дрожит в твоих руках.~
@42963 = ~~
@42964 = ~Повернуть левую руку.~
@42965 = ~~
@42966 = ~Повернуть правую руку.~
@42967 = ~Раскрыть левое крыло.~
@42968 = ~Раскрыть правое крыло.~
@42969 = ~~
@42970 = ~~
@42971 = ~Согнуть правое колено.~
@42972 = ~~
@42973 = ~Отложить куб.~
@42974 = ~Игрушка издает тихое жужжание.~
@42975 = ~~
@42976 = ~Повернуть левую руку.~
@42977 = ~~
@42978 = ~Повернуть правую руку.~
@42979 = ~~
@42980 = ~Раскрыть правое крыло.~
@42981 = ~~
@42982 = ~~
@42983 = ~Согнуть правое колено.~
@42984 = ~~
@42985 = ~Отложить куб.~
@42986 = ~Игрушка тихо гудит, становясь теплой на ощупь.~
@42987 = ~Повернуть левую руку.~
@42988 = ~~
@42989 = ~~
@42990 = ~Повернуть правую руку.~
@42991 = ~~
@42992 = ~~
@42993 = ~~
@42994 = ~~
@42995 = ~Согнуть правое колено.~
@42996 = ~~
@42997 = ~Отложить куб.~
@42998 = ~Слышится жужжание, *клац*, и вдруг в твоих руках вспыхивает ослепительно-белый свет...~
@42999 = ~«Чт!..»~
@43000 = ~Этот человек пристально всматривается в металлическую плиту, установленную на стене комнаты. Спустя минуту интенсивного сосредоточения, он взмахивает руками и произносит ряд впечатляющих «тайных слов»... но безуспешно. Тем не менее, он продолжает усердно практиковаться, не отвлекаясь на разговоры с тобой.~
@43001 = ~Уйти.~
@43002 = ~Этот человек несет стопку бумаг и развернутых свитков; время от времени он останавливается, чтобы заглянуть в них и прочитать вслух несколько отрывков, старательно выполняя при этом движения руками. Когда ты подходишь к нему, он поднимает на тебя взгляд. «Здравствуй...»~
@43003 = ~«Приветствую... что это за место?»~
@43004 = ~«Я просто проходил мимо. Прощай».~
@43005 = ~«Сюда могут приходить маги-новички для тренировок и учебы. Многие чародеи, будучи начинающими магами, сделали здесь свои первые шаги в Искусстве».~
@43006 = ~«Где учитель?»~
@43007 = ~«Это все, что я хотел узнать. Прощай».~
@43008 = ~«Я не знаю, куда делась леди Торнкомб. Советую поискать в сенсориумах... она там проводит много времени...» Нахмурившись, он тише добавляет: «Пожалуй, даже слишком много».~
@43009 = ~«Сенсориумах?»~
@43010 = ~«Это все, что я хотел узнать. Прощай».~
@43011 = ~«Спроси о них Сплинтера, прямо у входа в Фестхолл. Сам ты до них не доберешься, но он доставит тебя туда».~
@43012 = ~«Это все, что я хотел узнать. Прощай».~
@43013 = ~Этот человек пытается обчистить карманы манекена, подвешенного на раме и увешанного колокольчиками. Каждый раз, когда человек слишком грубо прикасается к манекену, тот громко звенит.~
@43014 = ~Уйти.~
@43015 = ~Этот человек небрежно обследует обвешанные колокольчиками тренировочные чучела, разбросанные по залу. Когда ты подходишь ближе, он смотрит на тебя. «Хм-м?»~
@43016 = ~«Что это за место?»~
@43017 = ~«Ничего... просто проходил мимо. Прощай».~
@43018 = ~«Это тренировочный зал воров. Вон те чучела служат для тренировки срезания кошельков и обчистки карманов».~
@43019 = ~«Где учитель?»~
@43020 = ~«Это все, что я хотел узнать. Прощай».~
@43021 = ~«Сейчас он, наверное, гуляет по району... кто-то его рассердил, да так, что он выбежал из Фестхолла, выражаясь так, что аж уши вяли. Его зовут Хейвлок, Илай Хейвлок. Он худощавый, среднего роста, темноволосый, смуглый и с резкими чертами лица».~
@43022 = ~«Это все, что я хотел узнать. Прощай».~
@43023 = ~Этот человек отрабатывает на деревянном чучеле разнообразные боевые приемы. Похоже, в текущий момент он слишком занят, чтобы говорить с тобой.~
@43024 = ~Уйти.~
@43025 = ~Этот человек тяжело дышит и весь блестит от пота, как будто он только что закончил какое-то тяжелое упражнение. При твоем приближении он оборачивается. «Да?»~
@43026 = ~«Что это за место?»~
@43027 = ~«Ничего... просто проходил мимо. Прощай».~
@43028 = ~Он кивает на тренировочные чучела. «Тренировочный зал воинов».~
@43029 = ~«Где учитель?»~
@43030 = ~«Это все, что я хотел узнать. Прощай».~
@43031 = ~«Ки-Саи? — он пожимает плечами, смахнув со лба пот. — Скорее всего, где-то в Фестхолле. Его трудно пропустить... его кожа сера как камень».~
@43032 = ~«Это все, что я хотел узнать. Прощай».~
@43033 = ~Он хмурится, на миг погрузившись в мысли. «Что ж, анархисты рассеяны по всему городу, гражданин. Пока они не нарушают закон, с ними практически ничего нельзя поделать».~
@43034 = ~«Я думал, что их считают опасным элементом, с которым нужно разбираться до того, как они натворят бед».~
@43035 = ~«Их предводительница попросила меня убить офицера Гармониума по имени Вортен, Третья ступень».~
@43036 = ~«Что ж, из авторитетного источника мне известно, что они несут ответственность за смерть Вортена, Третьей ступени».~
@43037 = ~«Что ж, из авторитетного источника мне известно, что они несут ответственность за смерть Вортена, Третьей ступени».~
@43038 = ~«Понятно. У меня есть другие вопросы...»~
@43039 = ~«Я должен идти, прощай».~
@43040 = ~Он вздыхает. «Я согласен с такой точкой зрения, гражданин. Тем не менее, лично я не считаю правильным бегать и сносить всем головы без доказательств. Если ты предоставишь мне причину, я прослежу, чтобы с этими анархистами разобрались. В противном случае, у них есть право на собрания».~
@43041 = ~«Понятно. У меня есть другие вопросы...»~
@43042 = ~«Я должен идти, прощай».~
@43043 = ~Он смотрит на тебя взволнованно. «Это очень серьезное обвинение, гражданин. Ты уверен, что хочешь сделать такое заявление?»~
@43044 = ~«Да».~
@43045 = ~«Нет, не думаю».~
@43046 = ~«Отлично. Я прослежу, чтобы с ними разобрались. Отличная работа, гражданин». Он улыбается тебе.~
@43047 = ~«Спасибо. Прощай».~
@43048 = ~Он пожимает плечами. «Тогда нам больше незачем обсуждать эту проблему».~
@43049 = ~«Отлично. Прощай».~
@43050 = ~«Откуда тебе это знать... если только ты не причастен к этому? — он внимательно смотрит на тебя перед тем, как продолжить. — Поскольку ты мне друг, я забуду, от кого я это услышал. Тем временем, я прослежу, чтобы с анархистами разобрались. До свидания, гражданин».~
@43051 = ~«Прощай».~
@43052 = ~«Прощай».~
@43053 = ~«Откуда тебе это знать... если только ты не причастен к этому? — он внимательно смотрит на тебя перед тем, как продолжить. — Я прослежу, чтобы с анархистами разобрались, гражданин. До свидания».~
@43054 = ~«Прощай».~
@43055 = ~«Спасибо тебе за помощь. Быть может, ты еще встретишь меня... или кого-нибудь из моих друзей. Мы повсюду».~
@43056 = ~«У меня к тебе вопрос...»~
@43057 = ~«Тогда прощай».~
@43058 = ~«Нам еще долго идти до склада. Чего ты хочешь?»~
@43059 = ~«У меня есть несколько вопросов...»~
@43060 = ~«Ничего».~
@43061 = ~Инженер глядит на тебя с презрением. «Вон отсюда! У меня нет времени на таких как ты!»~
@43062 = ~Напасть на нее.~
@43063 = ~Уйти.~
@43064 = ~Она смотрит на тебя — молча и отрешенно — в ожидании прибытия стражи.~
@43065 = ~«У меня к тебе вопрос...»~
@43066 = ~«Прощай».~
@43067 = ~Она продолжает пристально глядеть на тебя. «Сейчас у меня нет для тебя ответов. Возможно, они найдутся, когда ты вернешься».~
@43068 = ~«Тогда прощай».~
@43069 = ~«Ну так что, ты выяснил, как отсюда выбраться? Они не выпустят меня в таком виде. Мне нужна маскировка или что-то в этом роде».~
@43070 = ~«Есть идеи, как тебя замаскировать?»~
@43071 = ~«Я достал маскировку под кузнеца. Надень ее».~
@43072 = ~«Еще нет. У меня есть другие вопросы...»~
@43073 = ~«Еще нет. Прощай».~
@43074 = ~«Они позволяют кузнецам покидать это место. Пожалуй, если бы ты смог раздобыть мне полный набор кузнечного инструмента и еще пару вещей — не только инструменты, но и одежду... Понятия не имею, где тебе их искать. Больше не убивай людей, ладно? Здесь я посеяла уже достаточно смуты — нам не нужно, чтобы это разошлось по всему городу. Другими словами, не убивай кузнецов ради их одежды — в любом случае, я сомневаюсь, что она мне подойдет».~
@43075 = ~«Я достал маскировку под кузнеца. Надень ее».~
@43076 = ~«Ладно. Посмотрим, что я смогу сделать. Тем временем, ответь мне на несколько вопросов...»~
@43077 = ~«Ладно. Посмотрим, что я смогу сделать. Прощай».~
@43078 = ~«Я надену это, как только мы будем готовы идти. Ну так что? Тебе придется вывести меня».~
@43079 = ~«Ладно, пошли».~
@43080 = ~~
@43081 = ~~
@43082 = ~«Мы проследуем к главной двери, а потом отправимся к одному известному мне складу, где нас ждет несколько моих друзей. Ты готов?»~
@43083 = ~«Пошли».~
@43084 = ~«Что ты хочешь знать?»~
@43085 = ~«Расскажи мне о Революционной Лиге».~
@43086 = ~«Расскажи мне о боголюдях».~
@43087 = ~«Зачем тебе все эти разрушения?»~
@43088 = ~«Расскажи мне о себе».~
@43089 = ~«Что насчет Сароса?»~
@43090 = ~«Ничего. Прощай».~
@43091 = ~Она прищуривается, как бы оценивая тебя, и произносит: «Мы верим, что власть продажна по своей сути. Мы существуем, чтобы низвергать власть там, где она может появиться. Таким образом, главной целью для нас являются фракции Сигила — они монополизируют Город Дверей, город, который должен быть открыт для всех, кто в него попадает. Они же, напротив, подавляют всех, кто говорит свободно, и заставляют молчать тех, кто сам по себе. Структура власти Сигила должна быть уничтожена!»~
@43092 = ~«Какова структура Революционной Лиги?»~
@43093 = ~«И все же, как ты примкнула к этим людям?»~
@43094 = ~«Почему бы не сотрудничать с системой, чтобы ее изменить?»~
@43095 = ~«Как присоединиться к Революционной Лиге?»~
@43096 = ~«У меня есть другие вопросы...»~
@43097 = ~«Это все, что я хотел узнать. Прощай».~
@43098 = ~«Мой отец, член Свободной Лиги, был убит в споре с одним из Хранителей Рока. Убийцу так и не наказали. Моя мать требовала справедливости, но за это была задержана твердолобыми. Подкупленный судья признал ее виновной в нарушении спокойствия и распространении анархии, за что была казнена убийцами милосердия. Конечно же, я стала разыскивать анархистов: только у них были ответы, которые были нужны мне».~
@43099 = ~Повернуть правую руку.~
@43100 = ~«Почему бы не сотрудничать с системой, чтобы ее изменить?»~
@43101 = ~«Как присоединиться к Революционной Лиге?»~
@43102 = ~«У меня есть другие вопросы...»~
@43103 = ~«Это все, что я хотел узнать. Прощай».~
@43104 = ~«С этой системой? Ты испортишься еще до того, как сможешь хоть что-то изменить. Эта система не заинтересована в сотрудничестве с кем-либо, кто ослабляет ее. Такова людская природа: они хотят удерживать власть и укреплять ее, и неважно, кто при этом пострадает. Давай, скажи хоть слово против фракций — и станешь трупом, даже пикнуть не успеешь. Гораздо проще избавиться от нее целиком и создать новую».~
@43105 = ~«Но так пострадает множество невинных».~
@43106 = ~«Как ты присоединилась к анархистам?»~
@43107 = ~«Как присоединиться к Революционной Лиге?»~
@43108 = ~«У меня есть другие вопросы...»~
@43109 = ~«Это все, что я хотел узнать. Прощай».~
@43110 = ~Она, похоже, колеблется. «Присоединиться к нам? Хм-м-м. Ты натворил достаточно, чтобы впутаться во все это — на случай, если ты решишь выдать нас. Что ж, как бы там ни было, ты сделал для нас больше хорошего, чем плохого, — она умолкает, чтобы еще немного поразмыслить. — Ладно. Иди поговори с Нарушителем Пенном в типографии. Передай ему, что я сказала «город должен гореть». Он знает, что это значит, — она бросает на тебя тяжелый взгляд. — Но предупреждаю: если со мной хоть *что-нибудь* случится, эта фраза не будет и гроша ломанного стоить».~
@43111 = ~«Город должен гореть. Ладно. У меня еще несколько вопросов».~
@43112 = ~«Город должен гореть. Ладно. Прощай».~
@43113 = ~Она говорит с издевкой: «Если бы ты беспокоился о невинных, ты уж точно никогда не стал бы мне помогать. Как насчет всех тех рабочих, которых убил ТЫ, разрушив оружие в Литейной? В каждой войне страдают невинные; но, по крайней мере, пока ты с нами, у них есть шанс оправиться. Под властью фракций они все просто загнутся».~
@43114 = ~«Как ты присоединилась к анархистам?»~
@43115 = ~«Как присоединиться к Революционной Лиге?»~
@43116 = ~«У меня есть другие вопросы...»~
@43117 = ~«Это все, что я хотел узнать. Прощай».~
@43118 = ~«Мы поделены на ячейки, в каждой неопределенное количество членов. Люди из разных ячеек не знают друг друга, и таким образом мы исключаем предательство. Конечно, временами мы можем мешать друг другу, и все же мы довольно неплохо справляемся с деморализацией фракций-угнетателей, так что оно того стоит».~
@43119 = ~«А ты не думала, что, возможно, из-за действий твоей группы фракции становятся еще более воинственными и коррумпированными?»~
@43120 = ~«Как ты присоединилась к анархистам?»~
@43121 = ~«Почему бы не сотрудничать с системой, чтобы ее изменить?»~
@43122 = ~«Как присоединиться к Революционной Лиге?»~
@43123 = ~«У меня есть другие вопросы...»~
@43124 = ~«Это все, что я хотел узнать. Прощай».~
@43125 = ~«Нет. В конечном счете их лицемерие раскрывается, когда они пытаются уничтожить тех самых людей, которых они поклялись защищать. Те, кто заявили, что поддерживают строй Сигила, первыми разрушают его, лишь почувствовав угрозу. Мы показываем, насколько устарели их представления о власти. Мы — катализатор, но мы не причина».~
@43126 = ~«Как ты присоединилась к анархистам?»~
@43127 = ~«Почему бы не сотрудничать с системой, чтобы ее изменить?»~
@43128 = ~«Как присоединиться к Революционной Лиге?»~
@43129 = ~«У меня есть другие вопросы...»~
@43130 = ~«Это все, что я хотел узнать. Прощай».~
@43131 = ~«Боголюди? Ха. Большинство других фракций по крайней мере делают вид, что знают ответы. Боголюди и того хуже: они встают на пути любого, кто пытается выяснить, что же это за большая тайна, в то время как сами не имеют ни малейшего представления, в чем она заключается. Собаки на сене, все до единого. Что еще хуже, они загрязняют Нижний район, наполняя его этим смертоносным туманом, который уничтожает одного за другим всех старых и слабых. Они называют себя полезными, но правда в том, что они — всего лишь еще одна кучка торговцев смертью».~
@43132 = ~«Хорошо. У меня есть другие вопросы...»~
@43133 = ~«Понятно. Прощай».~
@43134 = ~«Потому что старый порядок должен быть низвергнут. Уничтожив часть штаб-квартиры фракции, я помогу людям потерять веру в боголюдей. Уничтожив ту ужасную машину, я помогу клиентам боголюдей потерять доверие к ним. Убив фрактора, я покажу другим, что начальство является мишенью, и никто не должен пытаться занять высокие чины в продажной системе, так как они могут стать следующими жертвами. Каждая из этих акций также служит символической цели. Ни одна из них не является разрушением ради разрушения. Иначе мы были бы не лучше Хранителей Рока».~
@43135 = ~«Кого?»~
@43136 = ~«У меня есть другие вопросы...»~
@43137 = ~«Прощай».~
@43138 = ~«Хранителей Рока. Кучка людей, думающих, что раз все разваливается, они обязаны позаботится о том, чтобы центр не сохранялся. Номинально мы в союзе с Хранителями Рока, но правда в том, что и они тоже падут. В конечном счете, они все падут».~
@43139 = ~«Хорошо. У меня есть другие вопросы...»~
@43140 = ~«Прощай».~
@43141 = ~«Я? Тут особо нечего рассказывать. Я поклялась, что увижу, как фракции будут низвергнуты, и прошла курс обучения на магического инженера, что делает меня ценным человеком для большинства из них. До боголюдей были другие, ну, знаешь — множество других. Я носила больше личин, чем могу вспомнить, и у меня было больше имен, чем записей в книге мертвых. Я даже не смогу назвать тебе имена всех тех, кого я предала».~
@43142 = ~«Похоже на настоящую жизнь. Ты счастлива?»~
@43143 = ~«Понятно. У меня есть другие вопросы».~
@43144 = ~«Это должно быть весело. Прощай».~
@43145 = ~Она издает короткий лающий смешок и горько произносит: «Счастлива? С каких это пор от счастья хоть какой-то прок?»~
@43146 = ~«Раз ты несчастна, почему бы тебе не бросить все это?»~
@43147 = ~«Да ни с каких. Счастье — ложный идеал, созданный для угнетения слабых и легковерных. Истинного счастья не существует».~
@43148 = ~«Ты права. Забудь. У меня есть еще вопросы...»~
@43149 = ~«Верно подмечено. Прощай».~
@43150 = ~«Бросить все это? И потерять шанс отомстить? Это то, чем я являюсь и что меня определяет. Это все равно что попросить тебя отрезать себе руку и жить без нее, — она смотрит на твои шрамы. — Хотя ты, пожалуй, способен и на такое».~
@43151 = ~«Значит, ты позволишь злобе и ненависти управлять собой?»~
@43152 = ~«Возможно. У меня есть другие вопросы».~
@43153 = ~«Возможно. Прощай».~
@43154 = ~«Это стало частью меня. Без них я становлюсь никем».~
@43155 = ~«Тогда выбери что-нибудь другое и стань чем-то большим».~
@43156 = ~ — получено ранение~
@43157 = ~«Тогда расти в себе злобу, и позволь ей управлять собой. Натвори еще больше бед. Мне все равно».~
@43158 = ~ — получено тяжелое ранение~
@43159 = ~ — смерть~
@43160 = ~«Да. У меня есть другие вопросы...»~
@43161 = ~ — цель пропала~
@43162 = ~ — оружие пропало~
@43163 = ~«Тогда прощай».~
@43164 = ~ — конец раунда~
@43165 = ~«Я... я не знаю как».~
@43166 = ~Эта дверь заперта.~
@43167 = ~«Попробуй. Попробуй — и увидишь».~
@43168 = ~«Тогда ты с тем же успехом можешь покончить с собой, потому что нет смысла жить, раз ты ничего не можешь изменить».~
@43169 = ~«Хорошо. У меня есть другие вопросы...»~
@43170 = ~«Тогда не пытайся. Прощай».~
@43171 = ~«Согласна. Нам говорят, что счастье — главная цель нашей борьбы, и все же достается оно далеко не всем... похоже, только идиотам и самодовольным типам, которые не способны открыть глаза на ужасы окружающего их мира. Я же говорю: лучше страдать, чем платить *такую* цену за счастье».~
@43172 = ~«Тоже верно. У меня есть другие вопросы...»~
@43173 = ~«Да. Прощай».~
@43174 = ~«Нет, не стоит. И эта апатия — как раз то, против чего мы боремся. Всего хорошего».~
@43175 = ~«Прощай».~
@43176 = ~«Я поразмыслю над этим. Я ничего не обещаю. Прощай, путник. Ты дал мне пищу для размышлений».~
@43177 = ~«Надеюсь на это. Прощай».~
@43178 = ~«Я поразмыслила и поняла, что я по крайней мере могу хоть что-нибудь изменить, и я в это верю. Этого для меня достаточно. Прощай».~
@43179 = ~«Прощай».~
@43180 = ~Она презрительно смотрит на тебя и ухмыляется. «Что, передумал, или тебе еще чего-то от меня понадобилось?»~
@43181 = ~«Я передумал. Я прикончу его».~
@43182 = ~«У меня есть другие вопросы...»~
@43183 = ~«Ничего. Забудь об этом. Прощай».~
@43184 = ~«У тебя уже была такая возможность. Ты действительно думаешь, что я теперь доверю тебе это? Я так не думаю. Убирайся прочь с глаз моих».~
@43185 = ~«Тогда ответь мне на несколько вопросов».~
@43186 = ~«Тогда прощай».~
@43187 = ~«Если ты не станешь помогать мне, зачем мне помогать тебе? Всего хорошего, сэр».~
@43188 = ~«Всего хорошего».~
@43189 = ~«Ты еще не записал имя Сандоза в книгу мертвых?»~
@43190 = ~«Да. Он мертв».~
@43191 = ~«Нет, пока нет. Сперва у меня есть другие вопросы».~
@43192 = ~«Еще нет. Прощай».~
@43193 = ~«Решил взяться за работу?»~
@43194 = ~«Да, я сделаю это».~
@43195 = ~«Нет, я не стану этого делать».~
@43196 = ~«Пока еще нет. У меня есть несколько вопросов...»~
@43197 = ~«Еще нет. Прощай».~
@43198 = ~«Мне необходимо, чтобы ты выполнил еще одно задание, а потом оставим боголюдей в этом беспорядке. Мне нужно, чтобы ты вывел меня отсюда: стража ищет, на кого бы свалить вину, и, могу поспорить, что это будешь не ты. Как только я исчезну, они поймут, что это я, а ты будешь вне подозрения. Что скажешь?»~
@43199 = ~«Дай мне немного времени подумать над этим».~
@43200 = ~«Да, я это сделаю. Что мне нужно делать?»~
@43201 = ~«Нет. Я думаю, что ты пытаешься меня подставить».~
@43202 = ~«Мне нужно выбраться из Литейной. Ты мне поможешь? Ответ нужен ПРЯМО СЕЙЧАС».~
@43203 = ~«А, дьявол с ним... по рукам».~
@43204 = ~«Нет. Я думаю, что ты пытаешься меня подставить».~
@43205 = ~«Я же сказал: мне нужно время. Прощай».~
@43206 = ~«Мне не о чем с тобой говорить, если только ты не поможешь мне выбраться».~
@43207 = ~«Тогда ладно. Я помогу тебе выбраться».~
@43208 = ~«Нет, я не буду».~
@43209 = ~~
@43210 = ~«Тогда мне больше нечего сказать».~
@43211 = ~«Тогда прощай».~
@43212 = ~«Еще вопросы? Тебе нечем заняться?»~
@43213 = ~«Расскажи мне о себе».~
@43214 = ~«К чему мне это делать?»~
@43215 = ~«К чему мне это делать?»~
@43216 = ~«И все же, что ты имеешь против боголюдей?»~
@43217 = ~«Неважно. Прощай».~
@43218 = ~«Меня зовут Бедай-Линн. Я магический инженер, — заметь, не маг, а теоретик — и я собираюсь позаботиться о том, чтобы у боголюдей не было шанса воспользоваться этим оружием или заключить договор на создание другого подобного ему».~
@43219 = ~«Зачем его убивать?»~
@43220 = ~«Зачем разрушать машину?»~
@43221 = ~«Ладно. У меня есть еще пара вопросов...»~
@43222 = ~«Понятно. Прощай».~
@43223 = ~«Потому что эти договора, которые боголюди подписывают со своими заказчиками, несут в себе зло. Боголюди позволили себе роскошь притворяться, что их действия не будут иметь последствий. Ну что ж, они их дождутся, и я собираюсь показать им, каким образом: я позабочусь о том, чтобы тот, кто прежде всего был в ответе за получение этого заказа, не дожил до того, чтобы повторить это снова».~
@43224 = ~«Ладно. Я сделаю это».~
@43225 = ~«Не думаю, что мне хочется этим заниматься».~
@43226 = ~«Хорошо. У меня есть другие вопросы...»~
@43227 = ~«Понятно. Прощай».~
@43228 = ~«Почему? Да потому что это оружие — инструмент дьяволов... в буквальном смысле. Нечистые собираются использовать его, чтобы сеять разруху и опустошение пред лицом мироздания, и неважно, сколько 'мирных' применений могло бы быть у этого устройства: никто не возместит страдания, которые оно причинит».~
@43229 = ~«Что насчет рабочих?»~
@43230 = ~«Хорошо. У меня есть другие вопросы...»~
@43231 = ~«Понятно. Прощай».~
@43232 = ~«Что я против них имею, так это то, что они так же слепы, как и все остальные фракции. Они держат город в железной хватке, и в то же время притворяются, что у них нет планов на него. Их жизнеутверждающая философия не распространяется на действительную поддержку жизни. Время дать им попробовать их же лекарство».~
@43233 = ~«Понятно. У меня есть другие вопросы...»~
@43234 = ~«Отлично. Прощай».~
@43235 = ~«Я слышала отсюда взрыв. Отличная работа. Тебя интересует еще одно задание?»~
@43236 = ~«Что это?»~
@43237 = ~«Почему тебя не убило взрывом вместе с остальными работниками проекта?»~
@43238 = ~«Фрактол, Сандоз... Ведь ты с ним знаком? Разработка той дьявольской машины — прежде всего его рук дело. Это он добился контракта и именно он пообещал, что это смертоносное оружие будет создано. На самом деле это он виноват в смерти всех тех инженеров. Он должен умереть».~
@43239 = ~«Я сделаю это».~
@43240 = ~«Ни за что. Погибло уже достаточно народу».~
@43241 = ~«Ты не хочешь за это браться? Очень жаль, ведь ты уже впутался в это дело. Ты действительно считаешь, что еще один труп что-нибудь изменит? Подумай о том, что ты уже сделал, и представь себе цену того, что ты сейчас остановишься. Если остановишься — все останется как прежде, а значит, ты убивал напрасно. Ты действительно хочешь прекратить убивать по указке фракции, или просто так болтаешь?»~
@43242 = ~«Я убью его».~
@43243 = ~«Нет, я не хочу его убивать».~
@43244 = ~«Хорошо. Его зовут Сандоз. Уверена, что ты с ним уже общался. Он ничего не заподозрит. Можешь не беспокоиться о тишине: Сандоз настолько шумный, что стражники не заменят небольшой возни. Просто возвращайся, когда закончишь, и я дам тебе еще одно задание — и потом все. А теперь — за дело!»~
@43245 = ~«Я передумал. Я не хочу его убивать».~
@43246 = ~«Отлично. Прощай».~
@43247 = ~Ее взгляд наполняется презрением. «Ты действительно слабее, чем я думала... да ты настоящий слабак. Что ж, счастливо оставаться. Больше не говори со мной». Она поворачивается к тебе спиной.~
@43248 = ~«Вот и отлично. Прощай».~
@43249 = ~«Ты еще не разрушил ту адскую машину?»~
@43250 = ~«Нет. Мне нужен символ, чтобы пройти за дверь».~
@43251 = ~«Нет. Я потерял символ, который мне нужен, чтобы пройти за дверь».~
@43252 = ~«Что насчет рабочих?»~
@43253 = ~«Еще нет. Но в скором времени я этим займусь. Можешь рассказать мне о ее слабых местах?»~
@43254 = ~«Тебе нужен символ? Тогда поговори с бригадиром литейной... по-моему, ее зовут Алисса Тилд. Или попробуй спросить у парня по имени Сарос. Я так понимаю, у него ловкие пальцы...»~
@43255 = ~«Хорошо. Какие у машины слабые места?»~
@43256 = ~«У меня есть другие вопросы...»~
@43257 = ~«Ладно, я это сделаю. Прощай».~
@43258 = ~«Тогда ты должен либо найти его, либо отыскать парня по имени Сарос или Алиссу Тилд, бригадира литейной. Если не удастся достать его у кого-то из них, тогда уж придется пробиться к машине. Я бы не советовала этого делать».~
@43259 = ~«Хорошо. Какие у машины слабые места?»~
@43260 = ~«У меня есть другие вопросы...»~
@43261 = ~«Ладно. Прощай».~
@43262 = ~«Думаю, тебе стоит сосредоточить свои усилия на огневом устройстве. Советую всунуть туда что-нибудь металлическое. Твердая сталь заискрит и вспыхнет, разрушив резонанс магического поля оружия, что приведет к самоуничтожению. Как только засунешь туда железяку, уходи. У тебя будет около получаса до того, как оно взорвется».~
@43263 = ~«Что насчет рабочих?»~
@43264 = ~«У меня есть другие вопросы...»~
@43265 = ~«Отлично. Прощай».~
@43266 = ~«Что насчет них? Они — рабы своей фракции, и фракция не будет оплакивать их утрату. Чего тебе волноваться?»~
@43267 = ~«Мне не все равно, потому что они невинны».~
@43268 = ~«У меня есть другие вопросы...»~
@43269 = ~«Ты права. Я вернусь с вестью об уничтожении машины».~
@43270 = ~«Невинны? Ха. Только в такой коррумпированной организации, как эта, ты можешь называть 'невинными' тех, кто работает над машинами смерти. Это просто смешно, — она умолкает, будто для того, чтобы очистить глотку от желчи. — Так ты уничтожишь машину или нет?»~
@43271 = ~«Нет. Они не заслуживают смерти».~
@43272 = ~«Ладно. Я вернусь с вестью о своем успехе».~
@43273 = ~«У тебя уже была такая возможность. Ты действительно думаешь, что я теперь доверю тебе это? Я так не думаю. Убирайся прочь с глаз моих».~
@43274 = ~«Тогда ответь мне на несколько вопросов».~
@43275 = ~«Тогда прощай».~
@43276 = ~«Тогда нам больше не о чем говорить. Держи язык за зубами насчет этого, и я никому не расскажу о твоем предательстве. Прощай. И больше ко мне не обращайся».~
@43277 = ~«Стой! Я передумал!»~
@43278 = ~«Тогда прощай».~
@43279 = ~«Теперь ты богочеловек. Ты все еще рад этому?»~
@43280 = ~«Да».~
@43281 = ~«На самом деле, нет».~
@43282 = ~«У меня есть несколько вопросов».~
@43283 = ~«Конечно. Прощай».~
@43284 = ~«Хорошо. Мне приятно, что ты рад своему выбору. Чем могу помочь?»~
@43285 = ~«У меня к тебе вопрос...»~
@43286 = ~«Ничем, спасибо. Прощай».~
@43287 = ~«Почему нет?»~
@43288 = ~«Это не то, что я представлял себе».~
@43289 = ~«Потому что я начинаю понимать, что это пустое название».~
@43290 = ~«Просто я недоволен».~
@43291 = ~«Вообще-то, думаю, что меня это вполне устраивает».~
@43292 = ~«Что у тебя за вопросы?»~
@43293 = ~«Расскажи мне о Великой Литейной».~
@43294 = ~«Расскажи мне, что ты знаешь об убийстве».~
@43295 = ~«Тильдон сказал, что ты анархистка».~
@43296 = ~«Тильдон сказал, что ты анархистка, и что ты пытаешься повесить на него преступление».~
@43297 = ~«Расскажи мне о проекте, над которым вы работаете».~
@43298 = ~«Расскажи о других людях».~
@43299 = ~«Кто ты?»~
@43300 = ~«Ничего. Забудь».~
@43301 = ~«Не все в этой жизни идет так, как мы хотим, и все мы бываем недовольны. Членство в фракции — нематериальная награда. Подумай над этим и приходи как-нибудь позже, ладно?»~
@43302 = ~«Конечно. Только у меня есть пара вопросов...»~
@43303 = ~«Конечно. Прощай».~
@43304 = ~«В таком случае, можешь ли ты утверждать, что предан боголюдям?»~
@43305 = ~Правда: «Да».~
@43306 = ~Ложь: «Да».~
@43307 = ~Правда: «Нет».~
@43308 = ~Ложь: «Нет».~
@43309 = ~«Не вижу, каким образом это тебя касается».~
@43310 = ~Она сдерживает зевоту. «Можешь спросить о Литейной кого-угодно здесь, и получишь тот же ответ. Почему ты думаешь, что я расскажу что-то новое? Спроси о чем-нибудь другом».~
@43311 = ~«Расскажи мне, что ты знаешь об убийстве».~
@43312 = ~«Тильдон сказал, что ты анархистка, и что ты пытаешься повесить на него преступление».~
@43313 = ~«Расскажи мне о проекте, над которым вы работаете».~
@43314 = ~«Расскажи о других людях».~
@43315 = ~«Ничего. Забудь».~
@43316 = ~«Посмотрим... Я попросила стражников уйти на ночь, поскольку работала в соседней комнате над одной деликатной технологией для проекта, и не хотела, чтобы их психическое излучение испортило одну сверхкритическую работу. Когда я выходила из комнаты, то к своему ужасу обнаружила труп. У меня нет алиби, и я понимаю, что нахожусь под подозрением — думаю, что ты уже знаешь, что я не давала согласия на то, чтобы отвечать под действием заклинания. Причина в том, что это может стать нарушением клятвы о неразглашении, которую я дала, чтобы защитить проект».~
@43317 = ~«Понятно. У меня есть другие вопросы».~
@43318 = ~«Думаю, я уточню это у Кельдора».~
@43319 = ~«Понятно. Прощай».~
@43320 = ~Она говорит с издевкой: «Анархистка? Да ты шутишь. У тебя есть какие-нибудь настоящие вопросы, или мне уже можно вернуться к работе?»~
@43321 = ~«У меня есть другие вопросы».~
@43322 = ~«Возвращайся к работе. Счастливо».~
@43323 = ~«Рассказать тебе о проекте, который мы поклялись завершить и защищать ценой своих жизней? Хм-м. Нет. Я так не думаю. В любом случае, не сейчас. Скажу лишь, что он значительный, и стоит тех усилий, которые мы прилагаем для его осуществления».~
@43324 = ~«Хорошо. Ответь тогда на другие вопросы...»~
@43325 = ~«Отлично. Прощай».~
@43326 = ~«Другие люди? Ну, здесь есть талантливый, но эксцентричный Нил Зандер, изгнанница-гитцерайка Келлера, Тильдон Серый, чье сердце не такое двусмысленное, как его имя, фрактор Кельдор, фрактор Сандоз, двое детей Сандоза, бригадиры, кузнецы и еще куча народу. Все они проходят мимо меня то туда, то сюда, и, честно говоря, я не слишком стараюсь узнать их получше. Они либо работают, либо не работают на меня, и, боюсь, это все, что меня интересует. Я очень предана своей работе».~
@43327 = ~«Хорошо. У меня есть другие вопросы...»~
@43328 = ~«Понятно. Прощай».~
@43329 = ~«Меня зовут Бедай-Линн. Я магический инженер, — заметь, не маг, а теоретик — и я собираюсь позаботиться о том, чтобы у боголюдей не было шанса воспользоваться этим оружием или заключить договор на создание другого подобного ему».~
@43330 = ~«Ладно. У меня есть еще пара вопросов...»~
@43331 = ~«Понятно. Прощай».~
@43332 = ~Она улыбается с удовлетворением. «Хорошо. Ударь машину в одно из ее слабых мест, и возвращайся, чтобы дать мне знать об этом».~
@43333 = ~«Какие у нее слабые места?»~
@43334 = ~«Я сообщу тебе, когда закончу. Тем временем, у меня есть еще несколько вопросов...»~
@43335 = ~«Зачем ты хочешь это сделать?»~
@43336 = ~«Пожалуй, я передумал. Я собираюсь тебя выдать».~
@43337 = ~«Конечно. Прощай».~
@43338 = ~«Скажи, твоя нехватка преданности достаточно сильна, что ты смог бы нанести боголюдям удар, если подвернется такой шанс?»~
@43339 = ~«Да».~
@43340 = ~«Конечно, нет!»~
@43341 = ~«Никаким, — она отворачивается от тебя. — Прощай».~
@43342 = ~«Прощай».~
@43343 = ~«Разве ты не догадался? Я дала клятву под ложным именем и ложной личиной. Я не тот человек, который дал клятву, так что я неуязвима. Теперь ты возьмешься за работу, или нет?»~
@43344 = ~«Что это?»~
@43345 = ~«Сделай это. Он подтвердит тебе то, что я сказала: он принимал у меня клятву, так что он знает ее силу».~
@43346 = ~«Хорошо. У меня есть другие вопросы...»~
@43347 = ~«Отлично. Прощай».~
@43348 = ~В ее глазах проскакивают искорки гнева, но насмешливое выражение заменяет их так быстро, что ты даже не уверен, видел ли их. «Анархистка? Да ты шутишь. У тебя есть какие-нибудь настоящие вопросы, или мне уже можно вернуться к работе?»~
@43349 = ~«Что это за вспышка ярости?»~
@43350 = ~«У меня есть еще пару вопросов...»~
@43351 = ~«Можешь возвращаться к своей работе. Счастливо».~
@43352 = ~«В таком случае, ты подошел к нужному человеку, — она улыбается она, ее глазах вспыхивают новым светом. — Как насчет того, чтобы ударить по военной машине баатезу и боголюдям одновременно?»~
@43353 = ~«О чем это ты?»~
@43354 = ~«Звучит не очень».~
@43355 = ~«Он был полезной пешкой, но дело в том, что он слишком скован своими личными связями, чтобы понять необходимость их уничтожения. Если он умрет, это будет небольшая потеря. Если он будет жив — тоже ничего. Я запомню его как парня, который выполнил свою роль, но у которого не хватило потенциала».~
@43356 = ~«Хорошо. Ответь мне на несколько вопросов».~
@43357 = ~«Как мило. Прощай».~
@43358 = ~«Ну ладно, ладно. Приятно видеть, что эта фракция не вскармливает предателей. Могу ли я еще чем-то помочь?»~
@43359 = ~«У меня есть другие вопросы...»~
@43360 = ~«Нет, спасибо. Прощай».~
@43361 = ~Она слегка улыбается. «Ты многое замечаешь, не так ли? Позволь мне пояснить это так: что бы ты почувствовал, если бы тебя незаслуженно обвинили? Мой гнев из-за этого, и больше не из-за чего». Она *кажется* честной насчет этого...~
@43362 = ~«Я на это не куплюсь».~
@43363 = ~«Хорошо. У меня есть другие вопросы...»~
@43364 = ~«Понятно. Прощай».~
@43365 = ~«Тебе придется, потому что других ответов ты не получишь, — она резко отворачивается от тебя. — Прощай».~
@43366 = ~«Прощай».~
@43367 = ~«Я имею в виду, что здесь в Литейной разрабатывается оружие невероятной силы, и оно финансируется баатезу — дьяволами, если хочешь. Его уничтожение позволит тебе не только ударить по фракции, которую ты отверг, но также расквасит нос всей расе нечистых. Что скажешь?»~
@43368 = ~«Я сделаю это».~
@43369 = ~«Нет. Я не буду этого делать».~
@43370 = ~«Тогда ты мне больше ни к чему. Держи язык за зубами, а я буду держать свой. Прощай».~
@43371 = ~«Прощай».~
@43372 = ~«Чего ты хочешь?»~
@43373 = ~«Расскажи мне о Великой Литейной».~
@43374 = ~«Расскажи мне, что ты знаешь об убийстве».~
@43375 = ~«Тильдон сказал, что ты анархистка, и что ты пытаешься повесить на него преступление».~
@43376 = ~«Тильдон сказал, что ты анархистка, и что ты пытаешься повесить на него преступление».~
@43377 = ~«Расскажи мне о проекте, над которым вы работаете».~
@43378 = ~«Расскажи о других людях».~
@43379 = ~«Кто ты?»~
@43380 = ~«Ничего. Забудь».~
@43381 = ~Ты видишь строгую женщину с огненно-рыжими волосами, туго завязанными на затылке, что придает ее лицу вытянутое нервозное выражение. Она кажется глубоко погруженной в размышления. При твоем приближении она бросает на тебя взгляд и говорит: «Я могу тебе чем-то помочь?»~
@43382 = ~«Да, у меня есть несколько вопросов».~
@43383 = ~«Нет, извини. Прощай».~
@43384 = ~Этот стройный молодой человек подходит к тебе с несколько озабоченным видом. «Тысяча извинений, сэр, но я тут разыскиваю одного человека, и я думаю, что ты мог бы мне помочь...»~
@43385 = ~«О? И как же?»~
@43386 = ~Этот добродушный старик лишь на миг бросает на тебя взгляд, после чего возвращается к своей декламации.~
@43387 = ~Поддразнить поэта.~
@43388 = ~Эта суровая с виду пожилая женщина, кажется, кого-то ищет. Когда ты подходишь, ее взгляд приковывается к твоему лицу. «Эй, ты... можно тебя на пару слов?»~
@43389 = ~«Разумеется...»~
@43390 = ~Эта высокая стройная женщина время от времени отрывает глаза от чаши с вином, чтобы окинуть взглядом окружающих ее посетителей и прохожих. Черты ее лица изящны и экзотичны, а ее золотистые глаза сверкают и искрятся при каждом ее взгляде.~
@43391 = ~«Приветствую...»~
@43392 = ~«Я бы хотел воспользоваться твоими целительскими умениями».~
@43393 = ~«Ничего, спасибо. Прощай».~
@43394 = ~«Я бы хотел воспользоваться твоими целительскими умениями».~
@43395 = ~«Забудь об этом. Прощай».~
@43396 = ~«Я бы хотел воспользоваться твоими целительскими умениями. Я о тебе слышал».~
@43397 = ~«Я бы хотел воспользоваться твоими целительскими умениями. Я о тебе слышал».~
@43398 = ~Кондитерская Квелла~
@43399 = ~Леди Торнкомб~
@43400 = ~Швейная мастерская Гонсалвиса~
@43401 = ~Антикварный магазин Вришики~
@43402 = ~Запасы Чувствующих~
@43403 = ~Добыча мертвых мародеров Гаэриена~
@43404 = ~Кости Ночи~
@43405 = ~«Эй, не трогай меня! Оставь меня в покое!»~
@43406 = ~«Я просто хотел... а, забудь».~
@43407 = ~«Значит, тебя поймали? Очень жаль».~
@43408 = ~«Прощай».~
@43409 = ~«Спасибо за сочувствие. Теперь я встану на стезю добродетели, ладно?»~
@43410 = ~«Конечно, Сарос. Ответь на пару вопросов, ладно?»~
@43411 = ~«Как угодно. Прощай».~
@43412 = ~«Что ты выяснил? Ты собираешься освободить меня?»~
@43413 = ~«Тильдон говорит, что ты подложил шило на место преступления, и что ты пытаешься его подставить из-за вашего с ним раздора».~
@43414 = ~«Тильдон говорит, что вы с Бедай-Линн — анархисты, и что ты пытаешься подставить его, потому что он отказался присоединиться к вам».~
@43415 = ~«Я выяснил достаточно, чтобы принять решение».~
@43416 = ~«Пока что нет. Тем не менее, у меня к тебе еще несколько вопросов».~
@43417 = ~«Еще нет. Прощай».~
@43418 = ~«Конечно. Все, что угодно...»~
@43419 = ~«Расскажи мне о себе».~
@43420 = ~«Расскажи мне о Великой Литейной».~
@43421 = ~«Расскажи мне о Великой Литейной».~
@43422 = ~«Расскажи мне об анархистах».~
@43423 = ~«Расскажи мне о людях здесь».~
@43424 = ~«Пока больше ничего. Прощай».~
@43425 = ~«Дай подумать... я вырос в Литейной со своей сестрой Сароссой. Мой отец, Сандоз, — здешний фрактор, и потому провел много времени вдали отсюда, пытаясь привлечь новообращенных и усилить влияние фракции. Моя сестра Саросса — вроде как колдунья, но она свое дело знает. Она знает, как делать людей такими, какими они есть на самом деле».~
@43426 = ~«О чем это ты?»~
@43427 = ~«О чем это ты?»~
@43428 = ~«Я это уже слышал. Ответь еще на пару вопросов, ладно?»~
@43429 = ~«Спасибо за уделенное время. Прощай».~
@43430 = ~«Оставь меня в покое. Мой отец мертв».~
@43431 = ~«У меня есть несколько вопросов».~
@43432 = ~«Отлично. Прощай».~
@43433 = ~«Я сказал: оставь меня в покое!»~
@43434 = ~«Ладно, ладно. Прощай».~
@43435 = ~«Я вырос здесь. Я играл в главном зале литейной и бегал по баракам. Здесь воняет и шумно, и люди здесь могут быть... людьми, как мне кажется... и все же это мой дом».~
@43436 = ~«Как трогательно. Ответь мне еще на пару вопросов...»~
@43437 = ~«Спасибо, Сарос. Прощай».~
@43438 = ~«Они все мертвы. Все, с кем я играл, когда был ребенком... все они погибли в том взрыве. К Литейной привыкаешь, как к дому, но теперь от этого только больнее. Можешь оставить меня в покое?»~
@43439 = ~«Тогда держись, парень. У меня есть еще несколько вопросов».~
@43440 = ~«Прощай».~
@43441 = ~«Мне не хотелось бы об этом говорить. Мне казалось, что они мне помогут и сделают мою жизнь увлекательной, но вместо этого они пошли против меня. Думаю, им приходится бы следить за собой, когда все против них... но я только хотел быть одним из них».~
@43442 = ~«Это ломает саму суть анархии, Сарос. Ты должен быть сам по себе».~
@43443 = ~«Это ломает саму суть анархии, Сарос. Ты должен быть сам по себе».~
@43444 = ~«Конечно. Ты же еще ребенок. Ты это переживешь. Ответь мне еще на несколько вопросов».~
@43445 = ~«Понимаю. Ты это переживешь. Счастливо».~
@43446 = ~Он пожимает плечами. «Они просто люди».~
@43447 = ~«Очень содержательно. Не мог бы ты ответить мне еще на пару вопросов?»~
@43448 = ~«Спасибо. Прощай».~
@43449 = ~«Значит, чтобы быть с ними, я не должен хотеть быть с ними?»~
@43450 = ~«Именно. Будучи самим собой, ты становишься чем-то большим, чем просто пешка. Подумай над этим. Прощай».~
@43451 = ~«Она может просто глянуть на кого-нибудь и увидеть, что нужно добавить, а что — забрать. Не знаю, как она это делает. Мой отец всегда говорил, что все дело тут в ее переходе на другой уровень. Он говорил, что *она* — прирожденный богочеловек».~
@43452 = ~«Спасибо. У меня есть другие вопросы...»~
@43453 = ~«Спасибо. Прощай».~
@43454 = ~«Ты это уже говорил! Не можешь придумать ничего пооригинальнее? И вообще,почему ты без конца говоришь одно и те же? Ты хочешь от меня чего-то еще?»~
@43455 = ~«Думаю, что нет. Прощай».~
@43456 = ~«Что ты хотел узнать?»~
@43457 = ~«Тильдон говорит, что ты подложил шило на место преступления, и что ты пытаешься его подставить из-за вашего с ним раздора».~
@43458 = ~«Тильдон говорит, что вы с Бедай-Линн — анархисты, и что ты пытаешься подставить его, потому что он отказался присоединиться к вам».~
@43459 = ~«Я выяснил достаточно, чтобы принять решение».~
@43460 = ~«Расскажи мне о себе».~
@43461 = ~«Расскажи мне о Великой Литейной».~
@43462 = ~«Расскажи мне о Великой Литейной».~
@43463 = ~«Расскажи мне об анархистах».~
@43464 = ~«Расскажи мне о людях здесь».~
@43465 = ~«Пока достаточно. Прощай».~
@43466 = ~«Конечно же, он будет так говорить! Ведь он виновен и хочет сбить тебя со следа! Я видел, как он убил того человека! Конечно, мы поссорились, но это вовсе не означает, что я желаю его смерти. То, что он полный придурок, вовсе не значит, что его нужно арестовать. Его следует арестовать за убийство Авильдона! Скажи ему, что у него нет доказательств!»~
@43467 = ~«Ну хорошо, у меня есть другие вопросы к тебе».~
@43468 = ~«Ну хорошо, у меня есть другие вопросы к тебе».~
@43469 = ~«Хорошо. Прощай».~
@43470 = ~Сарос бледнеет. «Она к этому непричастна. Я сам это сделал. Но правда в том, что это Тильдон толкнул Авильдона в механизм. Я оставил там шило, чтобы убедиться, что все узнают о том, что он был там, потому что я еще мальчишка, и никто бы мне не поверил. Понятно? Я признаю, что подбросил шило. Но сделал я это только чтобы убедиться, что он будет наказан за свое преступление».~
@43471 = ~«Тогда я приму решение, как рассказать об этом Кельдору».~
@43472 = ~«Почему? Почему же мне не думать, что ты делаешь это, чтобы отомстить ему за какое-то другое преступление?»~
@43473 = ~«Посмотрим на счет этого. Прощай».~
@43474 = ~«И какое же это решение?» Он, похоже, едва сдерживает слезы.~
@43475 = ~«Узнаешь, когда я с ним поговорю».~
@43476 = ~«Мне страшно. Я боюсь, что ты собираешься сделать меня убийцей, но это ведь не я!»~
@43477 = ~«На этот счет еще посмотрим. Ответь мне еще на несколько вопросов...»~
@43478 = ~«Если ты виновен, я так и сделаю. Прощай».~
@43479 = ~«Кажется, теперь здесь все идет не так... говорят, что это еще одно испытание жизни, но... я даже не знаю...»~
@43480 = ~«Тогда ответь мне на несколько вопросов».~
@43481 = ~«Везде есть трудности. Прощай».~
@43482 = ~«Я вырос здесь. Я играл в главном зале литейной и бегал по баракам. Здесь воняет и шумно, и люди могут быть такими как Тильдон... и все же это мой дом».~
@43483 = ~«Понятно. У меня есть еще вопросы...»~
@43484 = ~«Понятно. Прощай».~
@43485 = ~«Они... какие-то люди подходили поговорить со мной, и сказали, что я как раз тот, кто им нужен, потому что у меня есть доступ куда-угодно, и никто не обращает на меня внимание... я и представить себе не мог, что кому-то придется умереть. Я-то думал, что должен просто подсматривать и подслушивать. Но потом Тильдон толкнул Авильдона в механизм и сказал, что донесет на меня... а я ведь даже не знаю, кто со мной говорил!»~
@43486 = ~«Так вы с Бедай-Линн подставили Тильдона? Он говорит, что да. Похоже, он уверен, что она к этому тоже причастна».~
@43487 = ~«Так вы с Бедай-Линн подставили Тильдона? Он говорит, что да. Похоже, он уверен, что она к этому тоже причастна».~
@43488 = ~«Они — рабочие и кузнецы. Я думаю, намерения у них добрые, но они все такие серьезные и *скучные*. Им нужно стать хоть немного живее. Как, например, чувствующие».~
@43489 = ~«Тебе нравятся чувствующие, не так ли?»~
@43490 = ~«Понимаю, почему ты можешь так думать. У меня есть другие вопросы...»~
@43491 = ~«Спасибо за уделенное время. Прощай».~
@43492 = ~«Бедный кузнец... не могу поверить, что с ним такое случилось...»~
@43493 = ~«У тебя есть идеи на счет того, что там могло произойти, или хоть какие-то зацепки?»~
@43494 = ~«Это просто ужасно — быть вот так раздавленным в механизме. У меня к тебе несколько вопросов...»~
@43495 = ~«У тебя есть идеи на счет того, что там могло произойти, или хоть какие-то зацепки?»~
@43496 = ~«Кто тебе рассказал? Бригадир? Она права. Я иногда прихожу сюда по ночам, когда здесь никого нет, — он осторожно оглядывается, и наклоняется к тебе. — Я видел Тильдона, крадущегося оттуда. Я в этом уверен, потому что он кое-что обронил». Он дает тебе шило с надписью «Тильдон», вырезанной на деревянной рукоятке.~
@43497 = ~«Спасибо. Уверен, я еще вернусь, чтобы поговорить с тобой».~
@43498 = ~«Спрашивай что угодно».~
@43499 = ~«У тебя есть идеи на счет того, что там могло произойти, или хоть какие-то зацепки?»~
@43500 = ~«Расскажи мне о себе».~
@43501 = ~«Расскажи мне о Великой Литейной».~
@43502 = ~«Расскажи мне о Великой Литейной».~
@43503 = ~«Расскажи мне о людях здесь».~
@43504 = ~«Пока достаточно. Прощай».~
@43505 = ~«Потому что... потому что... я не знаю, к чему тебе так думать. Но обещаю... сходи поговори с ним и скажи ему то, что я сказал, а потом уж решай».~
@43506 = ~«Я этим займусь. Оставайся здесь».~
@43507 = ~«Они знают, что значит жить. Они знают, зачем это все. Не то что эти люди. Продолжают делать вид, что у всего есть какая-то большая и благородная цель, но я-то ее не вижу. Моя сестра говорит, что жизнь — нечто большее, чем то, что показывают нам наши чувства, но я не пойму, откуда ей это знать. Ведь все, что она знает, она получила через чувства. Просто не понимаю, зачем людям все это выдумывать».~
@43508 = ~«Кто твоя сестра?»~
@43509 = ~«Кто твоя сестра?»~
@43510 = ~«Хм-м. Понятно. У меня еще пару вопросов...»~
@43511 = ~«Спасибо за уделенное время. Прощай».~
@43512 = ~«Саросса? Она может просто глянуть на кого-то и увидеть, что нужно добавить, а что — забрать. Не знаю, как она это делает. Мой отец всегда говорил, что все дело тут в ее переходе на другой уровень. Он говорил, что *она* — прирожденный богочеловек».~
@43513 = ~«Интересно. Позволь мне задать еще несколько вопросов...»~
@43514 = ~«Спасибо. Прощай».~
@43515 = ~«Я? Я Сарос. Я вырос здесь. Бегал по Литейной, играл с оборудованием... Мне здесь все нравятся, не считая Тильдона. Он все говорит, что меня неправильно воспитали, и что мой отец — плохой родитель. Все, что я знаю, так это то, что Тильдон — самая большая сволочь из тех, что я когда-либо встречал».~
@43516 = ~«Уверен в этом. У меня есть пару вопросов...»~
@43517 = ~«Ясно. Прощай».~
@43518 = ~«Кажется, теперь здесь все идет не так... говорят, что это еще одно испытание жизни, но... я даже не знаю...»~
@43519 = ~«Тогда ответь мне на несколько вопросов».~
@43520 = ~«Везде есть трудности. Прощай».~
@43521 = ~«Я вырос здесь. Я играл в главном зале литейной и бегал по баракам. Здесь воняет и шумно, и люди могут быть такими как Тильдон... и все же это мой дом».~
@43522 = ~«Понятно. У меня есть еще вопросы...»~
@43523 = ~«Понятно. Прощай».~
@43524 = ~«Они — рабочие и кузнецы. Я думаю, намерения у них добрые, но они все такие серьезные и *скучные*. Им нужно стать хоть немного живее. Как, например, чувствующие».~
@43525 = ~«Тебе нравятся чувствующие, не так ли?»~
@43526 = ~«Понимаю, почему ты можешь так думать. У меня есть другие вопросы...»~
@43527 = ~«Спасибо за уделенное время. Прощай».~
@43528 = ~«Они знают, что значит жить. Они знают, зачем это все. Не то что эти люди. Продолжают делать вид, что у всего есть какая-то большая и благородная цель, но я-то ее не вижу. Моя сестра говорит, что жизнь — нечто большее, чем то, что показывают нам наши чувства, но я не пойму, откуда ей это знать. Ведь все, что она знает, она получила через чувства. Просто не понимаю, зачем людям все это выдумывать».~
@43529 = ~«Кто твоя сестра?»~
@43530 = ~«Кто твоя сестра?»~
@43531 = ~«Хм-м. Понятно. У меня еще пару вопросов...»~
@43532 = ~«Спасибо за уделенное время. Прощай».~
@43533 = ~~
@43534 = ~«Саросса? Она может просто глянуть на кого-то и увидеть, что нужно добавить, а что — забрать. Не знаю, как она это делает. Мой отец всегда говорил, что все дело тут в ее переходе на другой уровень. Он говорил, что *она* — прирожденный богочеловек».~
@43535 = ~«Интересно. Позволь мне задать еще несколько вопросов...»~
@43536 = ~«Спасибо. Прощай».~
@43537 = ~«А, снова ты? Чего тебе?»~
@43538 = ~«Я просто хотел задать пару вопросов...»~
@43539 = ~«Ничего. Прощай».~
@43540 = ~Ты видишь юношу со светло-русыми волосами. Он как раз на грани отрочества и юности, и по его глазам видно, что он пытается быть взрослым, насколько это возможно, не имея ни малейшего представления о том, что это такое; другими словами, он совсем наивный. «Привет, незнакомец. Чем я могу тебе помочь?»~
@43541 = ~«Ты не мог бы ответить мне на пару вопросов?»~
@43542 = ~«Ничего, спасибо. Прощай».~
@43543 = ~«Именно поэтому гиты и не должны размножаться. Они без конца твердят о чем-то, или о вере во что-то, или там 'где бы найти мозгососа или там гитьянки и убить их' и так далее и тому подобное. Я даже не уверен, что им доставляет удовольствие тыкать друг друга. Они сходят с ума и теряют голову, или наоборот — все время остаются такими прямыми и сосредоточенными, что забывают о чувстве юмора. Они болтают про концентрацию, единый разум и взаимное доверие, и при этом упоминают, что их раса раскололась вскоре после того, как они покончили с мозгососами. Теперь не говори мне, что религия и идеология не разрушит планы».~
@43544 = ~Даккон останавливает тебя на полпути к ней. «Я хотел бы, чтобы ты меня выслушал».~
@43545 = ~«В чем дело Даккон?»~
@43546 = ~«Нет. Молчи».~
@43547 = ~«Я желаю, чтобы мы не говорили с этой женщиной»~
@43548 = ~«Почему?»~
@43549 = ~«Я выслушал тебя. Но мы все равно с ней поговорим».~
@43550 = ~«Я выслушал тебя. Но мы все равно с ней поговорим».~
@43551 = ~«Тогда не говори с ней».~
@43552 = ~«Тогда не говори с ней».~
@43553 = ~«Что ж, не станем этого делать».~
@43554 = ~«Благодарю тебя».~
@43555 = ~«Не за что».~
@43556 = ~«Она — *зерт*. Наши воли — словно скрещенные клинки. Мы не понимаем друг друга».~
@43557 = ~«Твое желание принято к сведению. Но мы все равно с ней поговорим».~
@43558 = ~«Тогда не говори с ней».~
@43559 = ~«Что ж, не станем этого делать».~
@43560 = ~«Я... — голос Даккона дрожит. — Я *не желаю* делать этого».~
@43561 = ~«Даккон, это был приказ, и ты мой раб».~
@43562 = ~«Сделай это, Даккон».~
@43563 = ~«Хорошо. Но помни, что она идет по краю».~
@43564 = ~Даккон наносит ей удар клинком, и она падает на землю, истекая кровью. Кровь на лезвии клинка вскипает и испаряется, оставляя на нем черное пятно.~
@43565 = ~«Пошли».~
@43566 = ~Даккон вздыхает. «Вождям сотни лет, но нет часов, способных измерить этот рассказ. Эта вещь запутана, как корни Фрихиса, и распутать ее почти невозможно: это может никогда не случиться. Не суди меня поспешно».~
@43567 = ~Даккон нервно отступает. «Я не могу заставить его говорить что-либо. Я искренне желаю, чтобы он это сделал, и все же... его жизнь в его собственных руках».~
@43568 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43569 = ~«Я не буду говорить».~
@43570 = ~«Это не слова Зертимона, они не имеют убеждения. Это их искаженное эхо».~
@43571 = ~«Твои слова не несут мыслей Зертимона. Они сотканы из ярости и ненависти, будто отлитые в разуме самой Гит».~
@43572 = ~Будто поняв твой замысел, Даккон обращается к тебе, не сводя глаз с Киины: «Посторонись, и не стой на пути наших клинков».~
@43573 = ~«Даккон, я приказываю тебе прекратить это».~
@43574 = ~«Брось это, Даккон».~
@43575 = ~Все равно напасть на *зерта*.~
@43576 = ~Пусть дерутся.~
@43577 = ~«Твой разум отлит в форме Гит, Киина».~
@43578 = ~«Пошли, Даккон».~
@43579 = ~«Пошли, Даккон».~
@43580 = ~«Ты выслушаешь этого человека?»~
@43581 = ~«Он странствует со мной, Киина, последовательница Зертимона. Он пришел к тебе услышать слова Зертимона, которые тебе, как *зерту*, полагается передавать. Ты выслушаешь его?»~
@43582 = ~«Ты закроешь свой разум его словам? *Познай* свои слова, прежде чем ответить, Киина, *зерт* Зертимона».~
@43583 = ~«Этого достаточно, — Даккон поворачивается к тебе, говоря на твоем языке. — Она будет тебя учить».~
@43584 = ~Сражаться.~
@43585 = ~Сбежать.~
@43586 = ~У этой женщины кожа желтого оттенка и суровое лицо. Ее тело покрыто татуировками, на боку висит длинный клинок. Ее глаза — словно две маленькие черные жемчужины, которые следят за каждым твоим движением.~
@43587 = ~«Приветствую, звенящая мечом».~
@43588 = ~«Приветствую».~
@43589 = ~«Тебе знакома крепость Вристигор?»~
@43590 = ~«Кто ты?»~
@43591 = ~«Что ты можешь рассказать об этом месте?»~
@43592 = ~«Извини, обознался. Прощай».~
@43593 = ~У этой женщины кожа желтого оттенка и суровое лицо. Ее тело покрыто татуировками, на боку висит длинный клинок. Ее глаза — словно две маленькие черные жемчужины, которые следят за каждым твоим движением.~
@43594 = ~«Приветствую, звенящая мечом».~
@43595 = ~«Приветствую».~
@43596 = ~«Тебе знакома крепость Вристигор?»~
@43597 = ~«Кто ты?»~
@43598 = ~«Что ты можешь рассказать об этом месте?»~
@43599 = ~«Извини, обознался. Прощай».~
@43600 = ~«Среди Народа тебя... *знают* как друга. И все же я тебя *не знаю*. Я не могу тебе помочь».~
@43601 = ~«У меня всего лишь несколько вопросов...»~
@43602 = ~«Тебе знакома крепость Вристигор?»~
@43603 = ~«Тогда, может, в другой раз. Прощай».~
@43604 = ~Ее глаза блестят, когда она смотрит на тебя. «Услышь мои слова и *познай* мои мысли: я не могу тебе помочь. Уходи».~
@43605 = ~«Тебе знакома крепость Вристигор?»~
@43606 = ~«Отлично. Прощай».~
@43607 = ~«Я все еще тебя *не знаю*. *Знай*, что мне нечего тебе сказать».~
@43608 = ~«Тебе знакома крепость Вристигор?»~
@43609 = ~«Тогда прощай». ~
@43610 = ~«Я все еще тебя *не знаю*. *Знай*, что мне нечего тебе сказать».~
@43611 = ~«Тебе знакома крепость Вристигор?»~
@43612 = ~«Тогда прощай». ~
@43613 = ~Она слегка напрягается. «Откуда ты *знаешь* это название?»~
@43614 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43615 = ~«Из уличных слухов».~
@43616 = ~«Забудь».~
@43617 = ~Она бросает взгляд на твое лицо. Ты чувствуешь, как внимательно она на тебя смотрит. «*Знай*, что народ гитцераев благодарен тебе. Это не будет забыто. Закат над Хальдаром, путник: мне нужно предупредить свой народ».~
@43618 = ~«Тогда удачи тебе и прощай».~
@43619 = ~Ее взгляд ожесточается. «Скажи мне источник».~
@43620 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43621 = ~«Я не буду говорить».~
@43622 = ~«Да падет на тебя око Вилькара, если ты мне не расскажешь!»~
@43623 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43624 = ~«С чего мне тебе рассказывать?»~
@43625 = ~Шипя, она начинает чертить синим светом в воздухе перед тобой...~
@43626 = ~Сражаться.~
@43627 = ~Сбежать.~
@43628 = ~У этой женщины кожа желтого оттенка и суровое лицо. Ее тело покрыто татуировками, на боку висит длинный клинок. Ее глаза — словно две маленькие черные жемчужины, которые следят за каждым твоим движением. «Род Зеркай шлет тебе поклон. Мне *известны* твои мудрость и участие. Скажи, чем я могу тебе помочь».~
@43629 = ~«И путник доволен. Я надеялся, что ты сможешь ответить на пару вопросов».~
@43630 = ~«У меня есть пара вопросов, и я надеялся, что ты сможешь на них ответить».~
@43631 = ~«Кто ты?»~
@43632 = ~«Извини, обознался. Прощай».~
@43633 = ~«Говори. Я выслушаю тебя».~
@43634 = ~«Скажи, в чем отличия между гитьянки и гитцераями?»~
@43635 = ~«Скажи, в чем отличия между гитьянки и гитцераями?»~
@43636 = ~«Можешь научить меня фигурам речи гитцераев?»~
@43637 = ~«Можешь обучить меня Пути Зертимона?»~
@43638 = ~«Пока у меня больше нет вопросов. Спасибо за уделенное время».~
@43639 = ~«Я Киина. Я *зерт*. Я учу Пути Зертимона и веду Народ навстречу его судьбе».~
@43640 = ~«Скажи, в чем отличия между гитьянки и гитцераями?»~
@43641 = ~«Скажи, в чем отличия между гитьянки и гитцераями?»~
@43642 = ~«Можешь научить меня фигурам речи гитцераев?»~
@43643 = ~«Можешь обучить меня Пути Зертимона?»~
@43644 = ~«Пока у меня больше нет вопросов. Спасибо за уделенное время».~
@43645 = ~«Закат над Хальдаром, путник. Ты словно Элезпа на горе, храбрый и сильный».~
@43646 = ~«Я отобедал за столом Торига. Прощай». («Я благодарен».)~
@43647 = ~«Благодарю. Прощай».~
@43648 = ~«Приветствую, звенящий мечом».~
@43649 = ~«Здравствуй. У меня тут еще вопросы...»~
@43650 = ~«Здравствуй, Киина, и прощай».~
@43651 = ~Она бросает на тебя *тяжелый* взгляд. «Гит была великой воительницей, которая освободила наш народ от гнета *иллитидских* господ. Зертимон был ее помощником. После того как они освободили наш народ, Гит обратилась против Зертимона на Проклятых Равнинах. Слова были сказаны, сталь обнажена, и один народ стал двумя. Те, кто остались с сукой-королевой, назвали себя гитьянки. Те из нас, кто пошли путем Зертимона, остались верными Народу и взяли себе имя гитцерай».~
@43652 = ~«И поэтому вы друг друга так ненавидите?»~
@43653 = ~«Понятно. У меня есть другие вопросы...» ~
@43654 = ~«Благодарю. Прощай».~
@43655 = ~«Речь гитцераев основана на истории. Каждая вещь для нас — целая история. Метафора — могучий инструмент, вдохновляющий на подвиги наш народ и оберегающий против злых деяний. Когда мы говорим о столе Торига, мы вспоминаем, что Ториг был известен своей гостеприимностью и доброжелательностью. Когда мы говорим о сердце Селканта, и мы вспоминаем распутную и жестокую сущность Селканта. Ты понимаешь?»~
@43656 = ~«Да».~
@43657 = ~«Нет».~
@43658 = ~«Тогда я больше не могу учить тебя».~
@43659 = ~«Хорошо. У меня есть другие вопросы...»~
@43660 = ~«Тогда прощай». ~
@43661 = ~«Каждый из народов похож на пенанского мула — такой же упрямый, слепой и назойливый. А гитьянки в добавок ко всему еще и жестокие. Они ненавидят нас за то, что мы достигли высот в том, что недоступно их пониманию».~
@43662 = ~«Понятно. У меня есть другие вопросы...» ~
@43663 = ~«Понятно. Прощай».~
@43664 = ~Твое обучение началось:
Про мудрецов говорят: «написал книгу Вождей».
Чтобы обвинить кого-нибудь в предательстве, нужно вспомнить об «Оке Вилькара».
О щедрых людях говорят, что их «кладовые пусты».
Общепринятыми приветствиями являются «Приветствую, звенящий мечом» и «Род Зеркай шлет тебе поклон», на которые нужно отвечать «И путник доволен».
Твой разум наполняется подобным фразами.~
@43665 = ~«Спасибо тебе, Киина. У меня еще вопросы...»~
@43666 = ~«Спасибо тебе, Киина. Это было словно закат над Хальдаром». («Было очень приятно».)~
@43667 = ~«Я не могу. Ты слишком рассеянный, слишком... людской... чтобы *познать* Путь».~
@43668 = ~«Понятно. У меня есть другие вопросы...»~
@43669 = ~«Спасибо, Киина. Прощай».~
@43670 = ~У этой женщины кожа желтого оттенка и суровое лицо. Ее тело покрыто татуировками, на боку висит длинный клинок. Ее глаза — словно две маленькие черные жемчужины, которые следят за каждым твоим движением.~
@43671 = ~«Приветствую, звенящая мечом».~
@43672 = ~«Приветствую».~
@43673 = ~«Тебе знакома крепость Вристигор?»~
@43674 = ~«Кто ты?»~
@43675 = ~«Что ты можешь рассказать об этом месте?»~
@43676 = ~«Извини, обознался. Прощай».~
@43677 = ~Она спокойно следит за твоим приближением.~
@43678 = ~«Приветствую, звенящая мечом».~
@43679 = ~«Приветствую».~
@43680 = ~~
@43681 = ~~
@43682 = ~~
@43683 = ~~
@43684 = ~Она невозмутима. «Я... *не знаю* тебя. Эта встреча не принесет нам ничего хорошего. Прощай».~
@43685 = ~«Прощай».~
@43686 = ~«Я *не знаю* тебя, и все же ты обращаешься ко мне как представитель моего народа. Это неважно... Я не могу помочь тебе, путник. Прощай».~
@43687 = ~«Покрытая солью лодка отправляется в плаванье».~
@43688 = ~У этой женщины кожа желтого оттенка и суровое лицо. Ее тело покрыто татуировками, на боку висит длинный клинок. Ее глаза — словно две маленькие черные жемчужины, которые следят за каждым движением Даккона.~
@43689 = ~Когда вы возвращаетесь, *зерт* мрачно смотрит на Даккона. Она поворачивается к вам спиной, как бы провоцируя Даккона нанести удар.~
@43690 = ~«Даккон, срежь ее».~
@43691 = ~«Прекрати, Киина. Тебе знакома крепость Вристигор?»~
@43692 = ~«Тогда прощай». ~
@43693 = ~Когда вы подходите, она полностью игнорирует тебя. Даккон делает ей легкий поклон, на который она не обращает внимания. Она выпаливает в адрес Даккона вереницу резких слов, на которые он спокойно отвечает. Но это лишь приводит ее в бешенство.~
@43694 = ~«Даккон, ты можешь перевести мне?»~
@43695 = ~«Что она сказала?»~
@43696 = ~«Спроси ее, знакома ли ей крепость Вристигор».~
@43697 = ~Подождать.~
@43698 = ~«Пошли отсюда».~
@43699 = ~«Зачем ты оскорбляешь Неразрывный Круг Зертимона, продолжая носить его возле сердца? Ты не числишься среди Народа, предатель Шракатлора! Вожди и *зерты* сказали свое слово, и ему нужно подчиняться. Ты не можешь обращаться ко мне... или к любому другому *зерту*».~
@43700 = ~Даккон обрывает ее на полуслове натянуто-правильным поклоном. Она отворачивается от него и глядит на тебя. «Ты идешь в тени изгоя!»~
@43701 = ~«Идем».~
@43702 = ~«Ему не нужно переводить это для тебя. Я скажу тебе. Ты — человек, носящий рубаху из шрамов и крови, негоден для того, чтобы услышать слова Зертимона. Ты идешь в тени изгоя. Тем не менее, он убедил меня позволить тебе слушать меня. Я хочу *знать*, чего ты хочешь».~
@43703 = ~«У меня всего лишь несколько вопросов...»~
@43704 = ~«Тебе знакома крепость Вристигор?»~
@43705 = ~«Ничего. Прощай».~
@43706 = ~Она выглядит одновременно удивленной и испуганной. «Да, Даккон, бей, и пусть предательство переполнит твое сердце гитьянки». Она обнажает свое горло.~
@43707 = ~Она снова обращается к Даккону. «Ты повергнешь меня ради того, кто не из Народа? Его слова весят для тебя больше, чем слова *зерта*? Ты воистину потерян, Даккон. Как это могло случиться?»~
@43708 = ~«Ты сбился с пути, Даккон. *Знай*, я надеюсь, что ты найдешь свою дорогу. Мне тебя жаль. Прощай».~
@43709 = ~«Пошли, Даккон».~
@43710 = ~Она смотрит на тебя сурово. «Как ты, идущий в тени изгоя, *узнал* это название?»~
@43711 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43712 = ~«Из уличных слухов».~
@43713 = ~«Забудь».~
@43714 = ~«*Знай*... *знай*, что я тебе благодарна... тебе и этому *зерту*. *Знай*, что это не будет забыто, — она поворачивается к Даккону. — *Знай*, что это НЕ искупит падение Шракатлора. Решение Вождей все еще в силе».~
@43715 = ~«Эмм... Прощай».~
@43716 = ~«Эмм... Прощай».~
@43717 = ~«Я должна *знать*, где ты услышал это название».~
@43718 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43719 = ~«Разве я неясно выразился? Я не собираюсь тебе рассказывать».~
@43720 = ~«Глаз Вилькара! — она поворачивается к Даккону. — Заставь его говорить!»~
@43721 = ~«Тогда вы оба умрете». Она начинает чертить в воздухе заклинание.~
@43722 = ~Сражаться.~
@43723 = ~Сбежать.~
@43724 = ~После очередного резкого обмена репликами женщина прекращает разговор с Дакконом. «Я не буду тебя слушать. Ты будешь слушать меня, человек. Я *не знаю* тебя, но твой вид говорит о тебе много дурного. Твое тело — книга, написанная шрамами и кровью, и ты идешь в тени изгоя, который *не знает* ни Зертимона, ни себя. Говори!»~
@43725 = ~«Приветствую, звенящая мечом».~
@43726 = ~«Приветствую».~
@43727 = ~«В тени изгоя? Что ты имеешь в виду?»~
@43728 = ~«В тени изгоя? Что ты имеешь в виду?»~
@43729 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43730 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43731 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43732 = ~«Ты можешь научить меня языку гитцераев?»~
@43733 = ~«Можешь обучить меня Пути Зертимона?»~
@43734 = ~«Забудь. Прощай».~
@43735 = ~Она раздражительно шипит. «Твои любезности — пыль. Знак скорби приближается. Времени в обрез, человек. Я хочу *узнать* твои вопросы, а потом — чтобы ты ушел».~
@43736 = ~«Что ты имела в виду, говоря, что я иду в тени изгоя?»~
@43737 = ~«Что ты имела в виду, говоря, что я иду в тени изгоя?»~
@43738 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43739 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43740 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43741 = ~«Ты можешь научить меня языку гитцераев?»~
@43742 = ~«Можешь обучить меня Пути Зертимона?»~
@43743 = ~«Забудь. Прощай».~
@43744 = ~«Ты идешь с изгоем и *не знаешь* его истории? Он скор говорить о чем угодно, но о своем прошлом молчит? Спроси его о Шракатлоре, о падении могущественной крепости перед гитьянки, и увидишь, что раскроет тебе его рассеянный разум. Спроси его о словах Зертимона, и ты увидишь, что его *карач* мутен как туман».~
@43745 = ~«Нет сомнения в том, как произносить мысли Зертимона. Поколения *зертов*, словно камень Рракмы, единодушны по этому поводу. Твое положение несет в себе рассеянный разум. Это твои сомнения, эхо твоего собственного неверия».~
@43746 = ~«Ты будешь лежать в движущемся хаосе вместе с мертвецами Шракатлора, потому что видишь все оком Вилькара. Твой разум рассеян, твой *карач* слаб!»~
@43747 = ~Встать между их клинками.~
@43748 = ~«Даккон, прекрати сейчас же».~
@43749 = ~«Брось, Даккон».~
@43750 = ~Напасть на *зерта*.~
@43751 = ~«Пес! Продажный пес гитьянки!» Она бросается на тебя с мечом!~
@43752 = ~«Пришло время умирать, Киина».~
@43753 = ~Их клинки летят друг на друга в вихре движений!~
@43754 = ~Даккон с неохотой опускает клинок. Киина недоверчиво смотрит на него пару мгновений, затем расплывается в резкой усмешке. «Наконец-то правда. Твой разум не рассеян. Ты... *раб* этого человека. Он говорит с тобой со властностью Вождя, а ты его *слушаешься*».~
@43755 = ~«Его слова повторяют твои, и имеют форму Лимбо. Я не буду слушать тебя, Даккон».~
@43756 = ~«Слова Зертимона не для ушей людей. Их разум не един, и они несут раздор везде, где бы они ни были. А этот носит рубаху из шрамов и крови и странствует с предателем. Если ты просишь его выслушать, значит, в твоей груди бьется сердце Вилькара».~
@43757 = ~«Я не буду его слушать. Он будет слушать меня».~
@43758 = ~Женщина поворачивается к тебе. В ее черных глазах-жемчужинах виден опасный блеск. «Я *не знаю* тебя, но твой вид говорит о тебе много дурного. Твое тело — книга, написанная шрамами и кровью, и ты идешь в тени изгоя, который утверждает, что говорит за самого Зертимона. Говори!»~
@43759 = ~«Приветствую, звенящая мечом».~
@43760 = ~«Приветствую».~
@43761 = ~«В тени изгоя? Что ты имеешь в виду?»~
@43762 = ~«В тени изгоя? Что ты имеешь в виду?»~
@43763 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43764 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43765 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43766 = ~«Ты можешь научить меня языку гитцераев?»~
@43767 = ~«Можешь обучить меня Пути Зертимона?»~
@43768 = ~«Забудь. Прощай».~
@43769 = ~На миг она бросает на Даккона *тяжелый* взгляд. «Гит была великой воительницей, которая освободила наш народ от гнета *иллитидских* господ. Зертимон был ее помощником. После того как они освободили наш народ, Гит обратилась против Зертимона на Проклятых Равнинах. Слова были сказаны, сталь обнажена, и один народ стал двумя. Те, кто остались с сукой-королевой, назвали себя гитьянки. Те из нас, кто пошли путем Зертимона, остались верными Народу и взяли себе имя гитцерай».~
@43770 = ~«И поэтому вы друг друга так ненавидите?»~
@43771 = ~«Понятно. У меня есть другие вопросы...» ~
@43772 = ~«Благодарю. Прощай».~
@43773 = ~«Каждый из народов похож на пенанского мула — такой же упрямый, слепой и назойливый. А гитьянки в добавок ко всему еще и жестокие. Они ненавидят нас за то, что мы достигли высот в том, что недоступно их пониманию».~
@43774 = ~«Понятно. У меня есть другие вопросы...» ~
@43775 = ~«Понятно. Прощай».~
@43776 = ~«Тонущая Ачали! Спрашивай, и получишь ответы».~
@43777 = ~«Что ты имела в виду, говоря, что я иду в тени изгоя?»~
@43778 = ~«Что ты имела в виду, говоря, что я иду в тени изгоя?»~
@43779 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43780 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43781 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43782 = ~«Ты можешь научить меня языку гитцераев?»~
@43783 = ~«Можешь обучить меня Пути Зертимона?»~
@43784 = ~«Больше вопросов у меня нет. Прощай».~
@43785 = ~«Если твой спутник не утруждает себя этим, учить тебя буду я. Речь гитцераев основана на истории. Каждая вещь для нас — целая история. Метафора — могучий инструмент, вдохновляющий на подвиги наш народ и оберегающий против злых деяний. Когда мы говорим о столе Торига, мы вспоминаем, что Ториг был известен своей гостеприимностью и доброжелательностью. Когда мы говорим о сердце Селканта, и мы вспоминаем распутную и жестокую сущность Селканта. Ты понимаешь?»~
@43786 = ~«Да».~
@43787 = ~«Нет».~
@43788 = ~Твое обучение продолжается:
Мудрец «написал книгу Вождей».
Чтобы обвинить кого-нибудь в предательстве, нужно вспомнить об «Оке Вилькара».
О щедрых людях говорят, что их «кладовые пусты».
Общепринятыми приветствиями являются «Приветствую, звенящий мечом» и «Род Зеркай шлет тебе поклон», на которые нужно отвечать «И путник доволен».
Твой разум заполняется подобным фразами.~
@43789 = ~«У меня еще пара вопросов...»~
@43790 = ~«Спасибо. Прощай».~
@43791 = ~«Тогда я больше ничем не могу тебе помочь. Пусть твой спутник выскажется по этому поводу».~
@43792 = ~«У меня тут еще немного вопросов...»~
@43793 = ~«Может, я как-нибудь заставлю его это сделать — от тебя-то толку не добьешься. Прощай».~
@43794 = ~Ее взгляд становится суровым. «Ты странствуешь с тем, кто зовет себя *зертом* и читает мне морали, и в то же время просишь обучить тебя Пути? Проси *его* учить тебя — я не буду этого делать!»~
@43795 = ~~
@43796 = ~~
@43797 = ~~
@43798 = ~«Успокойся и ответь мне еще на пару вопросов».~
@43799 = ~«Может, я так и сделаю. Прощай».~
@43800 = ~«Ты вернулся мучить меня? Чего ты хочешь теперь?»~
@43801 = ~«Я просто хотел задать пару вопросов...»~
@43802 = ~«Группа гитьянки планирует налет на крепость Вристигор в течение недели. Как раз сейчас они на пути к ней».~
@43803 = ~«Ничего. Прощай».~
@43804 = ~При твоем приближении *зерт* нехотя кланяется тебе. «*Знай*, что твои слова спасли нас от трагедии. Мы дали клятву Золотой Руки, человек. Твой выбор себе попутчиков неудачен... — она бросает на Даккона взгляд. — Но ты показал себя другом Народа. Я выслушаю тебя». Несмотря на свои слова, она, похоже, не особо желает иметь с тобой дело.~
@43805 = ~«Что ты можешь сказать о Дакконе?»~
@43806 = ~«Что ты можешь сказать о Дакконе?»~
@43807 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43808 = ~«Ты можешь объяснить мне различия между гитцераями и гитьянки?»~
@43809 = ~«Ты можешь научить меня языку гитцераев?»~
@43810 = ~«Можешь обучить меня Пути Зертимона?»~
@43811 = ~«Больше вопросов у меня нет. Прощай».~
@43812 = ~«Приветствую».~
@43813 = ~«Тебе знакома крепость Вристигор?»~
@43814 = ~«Кто ты?»~
@43815 = ~«Что ты можешь рассказать об этом месте?»~
@43816 = ~«Извини, обознался. Прощай».~
@43817 = ~«Сомневаюсь. Прощай».~
@43818 = ~«Но если у тебя найдется хоть минутка... это займет совсем немного времени...»~
@43819 = ~«Ладно... что там у тебя?»~
@43820 = ~«Оставь меня в покое, мальчик. Прощай».~
@43821 = ~«Сэр, я посыльный, который ищет человека, по слухам, неспособного умереть... человека в шрамах, для которого смерть — не более чем обычная неприятность. Ты как раз подходишь тому смутному описанию, что мне дали, и мне интересно, ты ли это».~
@43822 = ~«Да, это я».~
@43823 = ~«Нет, это не я».~
@43824 = ~«А кто хочет это знать?»~
@43825 = ~Он кивает, затем низко кланяется тебе. «Для тебя есть послание. Меня прислала госпожа Джолми из дома Сирма, высокопоставленная дама. Госпожа Джолми встретится тобой в Городском Фестхолле, где она предложит тебе сделку, о которой я ничего не знаю. Если захочешь разыскать ее, то она носит зеленые шелка, отделанные золотом, и у нее волосы цвета вороненой стали. Таково мое сообщение... прощай».~
@43826 = ~«Постой... где этот Городской Фестхолл?»~
@43827 = ~«Прощай».~
@43828 = ~«В северо-восточном углу этой части Чиновничьего района, сэр. Большая постройка, ее не составит труда найти. Что ж, счастливо, сэр».~
@43829 = ~«Прощай».~
@43830 = ~«Очень жаль. До свиданья, сэр, прошу простить меня за причиненное беспокойство. Прощай».~
@43831 = ~«Прощай».~
@43832 = ~«Я работаю на богатую дворянку, Джолми Сирма, сэр».~
@43833 = ~«Я тот, кого ты ищешь».~
@43834 = ~«Что ж, ты принял меня за другого».~
@43835 = ~Юный посыльный отвешивает вежливый полупоклон. «Вот мы и встретились снова, сэр».~
@43836 = ~«Я хотел сообщить, что я и есть тот человек, которого ты ищешь».~
@43837 = ~«Да... Я просто проходил мимо. Прощай».~
@43838 = ~Поддразнить поэта.~
@43839 = ~Поддразнить поэта.~
@43840 = ~Уйти.~
@43841 = ~Ты начинаешь выкрикивать что-то вроде «Стихи — отстой!» и тому подобное, но лишь обращаешь на себя пару раздраженных взглядов... но не более.~
@43842 = ~Уйти.~
@43843 = ~Ты кричишь и глумишься над поэтом, высмеивая его стихотворный слог, внешний вид и вероятное домоседство. Ты обращаешь на себя несколько раздраженных взглядов и короткий сердитый взгляд самого поэта... но не более. ~
@43844 = ~Уйти.~
@43845 = ~Ты кричишь и глумишься над поэтом, высмеивая его стихотворный слог, внешний вид и вероятное домоседство. Ты дополняешь это тем, что перебиваешь пару его стихов, дополняя их своими собственными непристойными рифмами, что вызывает тихий смех зевак и заставляет старого поэта, изо всех сил старающегося не обращать на тебя внимание, оскалиться.~
@43846 = ~Уйти.~
@43847 = ~Старый поэт бросает на тебя хмурый взгляд и возвращается к декламации.~
@43848 = ~Подразнить поэта еще немного.~
@43849 = ~Подразнить поэта еще немного.~
@43850 = ~Подразнить поэта еще немного.~
@43851 = ~Уйти.~
@43852 = ~«Чего ты хочешь?»~
@43853 = ~«Да... ты Джолми, правильно? Я говорил с твоим посыльным».~
@43854 = ~«Нет, не сейчас. Прощай».~
@43855 = ~«Меня зовут Джолми, из благородного дома Сирма. Я ищу одного человека, который, как мне сказали, не может умереть... человека в ужасный шрамах, для которого смерть — не более чем обычная неприятность. То, что мне удалось собрать, вполне подходит под твое описание... ты и есть тот человек?»~
@43856 = ~«Да».~
@43857 = ~«Нет».~
@43858 = ~Она резко кивает. «В таком случае, прими мою благодарность за уделенное время. Прощай».~
@43859 = ~«Погоди... У меня есть несколько вопросов...»~
@43860 = ~«Прощай».~
@43861 = ~Джолми качает головой. «Здесь есть другие люди, могут ответить на твои вопросы. Прошу найти себе собеседника и предоставить меня моим поискам. Прощай».~
@43862 = ~«Вообще-то, я и *есть* человек, которого ты ищешь».~
@43863 = ~Уйти.~
@43864 = ~«В таком случае, я рада нашей встрече, — она делает легкий поклон. — Я хочу сделать тебе несколько необычное предложение... хотя и ты, согласись, человек необычный. Я дам тебе тысячу медных монет... за то, что ты разрешишь убить себя. Ты готов обсудить этот вопрос?»~
@43865 = ~«Конечно, почему бы и нет?»~
@43866 = ~«Конечно, почему бы и нет?»~
@43867 = ~«Конечно, почему бы и нет?»~
@43868 = ~«Но... зачем?»~
@43869 = ~«Нет, спасибо. Прощай».~
@43870 = ~Джолми и глазом не моргнула. «А почему бы и нет? Мне это показалось довольно занимательным — заплатить кому-то за разрешение убить его. Когда до меня впервые дошли слухи о твоем существовании, как я могла устоять? Итак... каков твой ответ? Стоит ли нам обсудить это более подробно?»~
@43871 = ~«Да. Давай обсудим детали».~
@43872 = ~«Да. Давай обсудим детали».~
@43873 = ~«Да. Давай обсудим детали».~
@43874 = ~«Одну минуту... где ты слышала такие слухи?»~
@43875 = ~«Я не стану этого делать. Прощай».~
@43876 = ~Джолми нахмуривается. «В Фестхолле много чего можно услышать. Как же тут *не услышишь*, рано или поздно, о таком человеке как ты? Еще раз спрашиваю: ты принимаешь мое предложение?»~
@43877 = ~«Да. Давай обсудим детали».~
@43878 = ~«Да. Давай обсудим детали».~
@43879 = ~«Да. Давай обсудим детали».~
@43880 = ~«Я не стану этого делать. Прощай».~
@43881 = ~После короткого обсуждения все свелось к следующим условиям: Джолми заплатит тебе тысячу медных монет; взамен ты позволишь ей вонзить кинжал в свое сердце. Она дождется твоего пробуждения и после этого заплатит тебе.

«Итак, ты согласен?»~
@43882 = ~~
@43883 = ~«Да... валяй».~
@43884 = ~«Нет, не думаю. Прощай».~
@43885 = ~После короткого обсуждения все свелось к следующим условиям: Джолми заплатит тебе полторы тысячи медных монет; взамен ты позволишь ей вонзить кинжал в свое сердце. Она дождется твоего пробуждения и после этого заплатит тебе.

«Итак, ты согласен?»~
@43886 = ~«Да... валяй».~
@43887 = ~«Нет, не думаю. Прощай».~
@43888 = ~После короткого обсуждения все свелось к следующим условиям: Джолми заплатит тебе две тысячи медных монет; взамен ты позволишь ей вонзить кинжал в свое сердце. Она дождется твоего пробуждения и после этого заплатит тебе.

«Итак, ты согласен?»~
@43889 = ~«Да... валяй».~
@43890 = ~«Нет, не думаю. Прощай».~
@43891 = ~Еще миг — и дело сделано... пока ты приходил в себя, она уже вытерла клинок и убрала его. После того, как ты подымаешься с пола Фестхолла, Джолми протягивает тебе несколько стопок медных монет, в то время как ты потираешь ноющую грудь. 

«Должна заметить: я несколько разочарована. Ну что ж... как бы там ни было, стоит потраченных денег. Прощай».~
@43892 = ~«Да... прощай».~
@43893 = ~Джолми обращает на тебя свой тяжелый взгляд. «Да?»~
@43894 = ~«Я тот, кого ты ищешь».~
@43895 = ~«У меня есть несколько вопросов...» ~
@43896 = ~«Ничего... Прощай».~
@43897 = ~Холодные глаза Джолми вспыхивают, когда она замечает твое приближение. «Итак, ты передумал на счет моего предложения? Тысячу монет за разрешение убить тебя?»~
@43898 = ~«Да. Давай обсудим это».~
@43899 = ~«Да. Давай обсудим это».~
@43900 = ~«Да. Давай обсудим это».~
@43901 = ~«Сперва скажи, зачем это тебе».~
@43902 = ~«Нет, спасибо. Прощай».~
@43903 = ~Джолми обращает на тебя свой тяжелый взгляд; когда она узнает твое лицо, ее глаза вспыхивают. «Да?»~
@43904 = ~«У меня есть несколько вопросов, Джолми...»~
@43905 = ~«Я просто проходил мимо... Прощай».~
@43906 = ~«Тьфу! — Анна усмехается Морту. — Хватит слюни пускать, хитрая черепушка».~
@43907 = ~«Подойди еще хоть на волосок, череп, и будешь собирать свои болтливые зубы по всей округе!»~
@43908 = ~«Ух ты».~
@43909 = ~«Ты Немель? Мне сказали, что ты знаешь волшебное слово к этому графину».~
@43910 = ~«Немель? Твоя подруга Эльвин ищет тебя».~
@43911 = ~«Ты кого-то ищешь?»~
@43912 = ~«У меня есть несколько вопросов...»~
@43913 = ~«Мне ничего не нужно, Немель. Прощай».~
@43914 = ~«Ух ты».~
@43915 = ~«Вай, что за горячая девчонка! Изголодалась по вниманию? Я мог бы и на тебя слюни попускать, раз уж ты ревнуешь...» Морт начинает подлетать к Анне, причмокивая...~
@43916 = ~Морт резко останавливается и отворачивается, что-то неразборчиво бормоча.~
@43917 = ~«Ты Немель? Мне сказали, что ты знаешь волшебное слово к этому графину».~
@43918 = ~«Немель? Твоя подруга Эльвин ищет тебя».~
@43919 = ~«Ты кого-то ищешь?»~
@43920 = ~«У меня есть несколько вопросов...»~
@43921 = ~«Мне ничего не нужно, Немель. Прощай».~
@43922 = ~«Да ладно, шеф... Уверен, мы ведь сможем *что-нибудь* придумать. А? А?»~
@43923 = ~«Забудь об этом, Морт. Идем».~
@43924 = ~«Приветствую».~
@43925 = ~«Приветствую».~
@43926 = ~Оставить женщину в покое.~
@43927 = ~Женщина поворачивается к тебе, ее фиолетовые глаза сверкают, как безупречные аметисты. Ее речь словно музыка; когда она говорит, тебе слышится слабый мелодичный перезвон сотен крохотных хрустальных колокольчиков. Каждое ее слово задерживается в твоих ушах, как будто они не хотят отпускать столь изысканные звуки. «Немель повернулась к суровому незнакомцу, покрытому шрамами. Она спросила, чего он от нее хочет».~
@43928 = ~«Ты Немель? Мне сказали, что ты знаешь волшебное слово к этому графину».~
@43929 = ~«Немель? Твоя подруга Эльвин ищет тебя».~
@43930 = ~«Ты кого-то ищешь?»~
@43931 = ~«У меня есть несколько вопросов...»~
@43932 = ~«На самом деле, ничего. Прощай».~
@43933 = ~Женщина поворачивается к тебе, ее фиолетовые глаза сверкают, как безупречные аметисты. Ее речь словно музыка; когда она говорит, тебе слышится слабый мелодичный перезвон сотен крохотных хрустальных колокольчиков. Каждое ее слово задерживается в твоих ушах, как будто они не хотят отпускать столь изысканные звуки. «Немель повернулась к суровому незнакомцу, покрытому шрамами. Она спросила, чего он от нее хочет».~
@43934 = ~Женщина поворачивается к тебе, ее фиолетовые глаза сверкают, как безупречные аметисты. Ее речь словно музыка; когда она говорит, тебе слышится слабый мелодичный перезвон сотен крохотных хрустальных колокольчиков. Каждое ее слово задерживается в твоих ушах, как будто они не хотят отпускать столь изысканные звуки. «Немель повернулась к суровому незнакомцу, покрытому шрамами. Она спросила, чего он от нее хочет».~
@43935 = ~Женщина не делает ни единого движения, чтобы прикоснуться к графину или осмотреть его — она лишь произносит: «Немель взяла его у незнакомца, повертела его в руках. Она подумала: видела ли она нечто подобное раньше? Возможно... да, теперь она вспомнила. Она вернула графин, прошептав ему кое-что на ухо...»~
@43936 = ~«Э...»~
@43937 = ~Ты понимаешь, что теперь тебе известно это слово — «Нильденосадж», — хотя ты уверен в том, что эта женщина ничего тебе не шептала, а лишь сказала, что сделала это. Она смотрит на тебя выжидающе. «Оставит ли теперь ее незнакомец, удовлетворенный тем, что она ему сказала?»~
@43938 = ~«Пока нет. Я нашел Эльвин».~
@43939 = ~«Пока нет. Тебя ищет твоя подруга, Эльвин».~
@43940 = ~«Пока еще нет. Ты кого-то ищешь?»~
@43941 = ~«Нет... У меня есть несколько вопросов».~
@43942 = ~«Да. Прощай».~
@43943 = ~Губы Немель образуют безупречную улыбку; от нее исходит заразительное счастье, обволакивая тебя, как благоухающее тепло. «Немель была очень рада услышать о своей подруге. Эльвин где-то поблизости?»~
@43944 = ~«Она возле другого кафе на восток отсюда, за этой частью района».~
@43945 = ~«Немель поблагодарила человека за чудесные новости. Скоро она навестит свою старую подругу, Эльвин. А теперь она отблагодарит незнакомца...»~
@43946 = ~«Нет, все нормально... Мне не нужно награды».~
@43947 = ~Подождать, пока она отблагодарит тебя.~
@43948 = ~Немель прикладывает указательный палец к губам, издавая тихое «ш-ш-ш».~
@43949 = ~«Она подойдет к незнакомцу поближе, положит руку ему на грудь и поцелует бледную грубую кожу его щеки. В него вольется жизнь, сделав его сильнее... и это будет ему наградой».~
@43950 = ~Подождать.~
@43951 = ~Внезапно у тебя появляется слабое щекочущее чувство на щеке и груди. Оно разносится по всему телу, и ты начинаешь чувствовать себя более сильным и живым.~
@43952 = ~«Спасибо. У меня есть другие вопросы».~
@43953 = ~«Спасибо, Немель. Прощай».~
@43954 = ~«Немель выслушала вопросы незнакомца, но не смогла ответить на них. Ему придется поискать ответы в другом месте».~
@43955 = ~«Но... Я даже не спросил...»~
@43956 = ~«Тогда прощай».~
@43957 = ~Немель улыбается тебе, медленно качая головой; твое лицо отражается в ее мерцающих глазах. «Раздраженный и сбитый с толку, он, наконец, сдался. Было ясно, что эта женщина не знала ничего, что могло бы ему пригодились... а даже если и знала, он бы не смог убедить ее поделится с ним».~
@43958 = ~«Что? Нет... позволь только кое-что у тебя спросить...»~
@43959 = ~«Тогда прощай».~
@43960 = ~Ты открываешь рот, но не можешь вымолвить и слова. Как бы ты не старался, ты не можешь задать ей вопрос. Немель грустно качает головой.~
@43961 = ~«Тогда прощай».~
@43962 = ~«'Где же она может быть?' — думала Немель. Ее спутница, Эльвин, должна была встретиться с ней здесь пару дней назад, — женщина печально вздыхает; воздух вокруг нее становится прохладным от ее грусти. — Сколько еще ей скитаться по этому огромному незнакомому городу, пока она не найдет свою лучшую подругу?»~
@43963 = ~«Я бы мог помочь тебе найти твою подругу. Как она выглядит?»~
@43964 = ~«Я мог бы найти ее для тебя... конечно, не за бесплатно».~
@43965 = ~«Надеюсь, ты ее найдешь. Счастливо».~
@43966 = ~Немель всплескивает руками и кивает тебе. «Она была бы так рада услышать новости про ее подругу! Она рассказала доброму незнакомцу, как выглядит Эльвин, чтобы он узнал ее, если встретит». В твоей голове появляется образ: женщина, похожая на Немель, но с золотистыми глазами и ярко-красными волосами.~
@43967 = ~«Вообще-то, я встречал эту женщину».~
@43968 = ~«Я вернусь, если разыщу ее. Прощай».~
@43969 = ~Немель говорит медленно, опустив взгляд: «Она знала, и незнакомец тоже вскоре узнает, что у нее ничего нет. Она не сможет ничего ему дать, чего бы он не потребовал».~
@43970 = ~«Тогда я сделаю это в качестве одолжения».~
@43971 = ~«Тогда забудь об этом. Прощай».~
@43972 = ~«Тогда забудь об этом. Прощай».~
@43973 = ~Женщина приветствует тебя, улыбаясь. Ее красота завораживает тебя не меньше, чем в первый раз. «И вновь она встретила незнакомца. 'Зачем, — подумала она, — ему приходить ко мне снова?'»~
@43974 = ~«Немель... Мне сказали, что ты знаешь волшебное слово к этому графину».~
@43975 = ~«Тебя ищет твоя подруга, Эльвин».~
@43976 = ~«Ты кого-то ищешь?»~
@43977 = ~«У меня есть несколько вопросов...»~
@43978 = ~«На самом деле, ничего. Прощай».~
@43979 = ~Женщина приветствует тебя, улыбаясь. Ее красота завораживает тебя не меньше, чем в первый раз. «Немель затаила дыхание, когда незнакомец приблизился к ней. 'Нашел ли он Эльвин?' — подумала она».~
@43980 = ~«Мне сказали, что ты знаешь волшебное слово к этому графину».~
@43981 = ~«Я нашел Эльвин. Она тоже тебя ищет».~
@43982 = ~«Я не нашел ее. У меня есть кое-какие вопросы...»~
@43983 = ~«Нет, я просто проходил мимо. Прощай».~
@43984 = ~Немель всплескивает руками и кивает тебе. Когда она, наконец, обращает на тебя взгляд, улыбаясь, тебя омывает волной удовольствия — эффект просто головокружительный. «Немель еще раз поблагодарила незнакомца. Она лишь надеялась, что он понимает, как она счастлива снова оказаться вместе с Эльвин».~
@43985 = ~~
@43986 = ~Женщина фыркает, ее глаза сверкают, словно пылающие точки чистой ненависти. Она говорит, словно читая из книги: «'Ты глупец, — воскликнула она. — Как ты посмел напасть на дочь Асахарма! Ты пес, — она посмотрела на него прищурено, — и умрешь как собака!'» Затем она бросает на тебя холодный взгляд, отпивая вино из чаши.~
@43987 = ~«А?..»~
@43988 = ~Проигнорировать ее, продолжить атаку.~
@43989 = ~Ты падаешь на землю, воя в агонии... твои внутренности словно превратились в кашу; ты начинаешь выплевывать большие сгустки темной дымящейся крови. В конце концов, ты оседаешь на мостовую, подергиваясь; твое тело покидают остатки жизни...~
@43990 = ~Пасть во тьму...~
@43991 = ~Этот статный юноша, похоже, погружен в собственные мысли. Лоб его нахмурен, а губы слегка изогнуты.~
@43992 = ~«Приветствую...»~
@43993 = ~Оставить его наедине со своими мыслями.~
@43994 = ~Этот юноша все еще имеет озабоченный вид. Он приветствует тебя, когда ты подходишь. «И вновь приветствую. Ты чего-нибудь хочешь от меня?»~
@43995 = ~«У меня есть несколько вопросов...» ~
@43996 = ~«Ничего, неважно. Прощай».~
@43997 = ~«Приветствую, сэр. Чего же ты жаждешь от меня?»~
@43998 = ~«У меня есть несколько вопросов...» ~
@43999 = ~«Ничего, неважно. Прощай».~
@44000 = ~«Да?»~
@44001 = ~«Кто ты?»~
@44002 = ~«Еще раз, кто ты?»~
@44003 = ~«Мне нужно поговорить с тобой о Джульетте».~
@44004 = ~«Мне нужно поговорить с тобой о Джульетте».~
@44005 = ~«Что ты здесь делаешь?»~
@44006 = ~«У меня несколько вопросов об этом месте...»~
@44007 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@44008 = ~«Ничего, неважно. Прощай».~
@44009 = ~«Я — Монтекки, фрактотум чувствующих».~
@44010 = ~«Фрактотум?»~
@44011 = ~«Чувствующих?»~
@44012 = ~«У меня есть другие вопросы...»~
@44013 = ~«Это все, что я хотел узнать. Прощай».~
@44014 = ~«Истинно так, сэр. 'Представитель', если соизволишь».~
@44015 = ~«Истинно так, сэр... Общество Восприятия. Сигильская фракция... самая крупная. Если желаешь разузнать о чувствующих побольше, поговори со Сплинтером. Ты найдешь его внутри прямо у входа в это здание».~
@44016 = ~«Ты упомянул чувствующих?»~
@44017 = ~«У меня есть другие вопросы...»~
@44018 = ~«Это все, что я хотел узнать. Прощай».~
@44019 = ~«Ты сказал «фрактотум»?»~
@44020 = ~«У меня есть другие вопросы...»~
@44021 = ~«Это все, что я хотел узнать. Прощай».~
@44022 = ~«Я состою на службе помощником одного из управителей фракции. Однако намного чаще, чем раньше, я пребываю в недоумении от этих странных поворотов судьбы».~
@44023 = ~«Например?..»~
@44024 = ~«Проблем женского характера».~
@44025 = ~«Понятно. У меня еще вопросы...»~
@44026 = ~«Это все, что я хотел узнать. Прощай».~
@44027 = ~«А в чем, собственно, проблема?»~
@44028 = ~«Ты женщина?»~
@44029 = ~«Понятно. У меня еще вопросы...»~
@44030 = ~«Это все, что я хотел узнать. Прощай».~
@44031 = ~Юноша надолго задерживает на тебе взгляд. «Нисколько».~
@44032 = ~«А в чем, собственно, проблема?»~
@44033 = ~«Так или иначе, у меня есть другие вопросы...»~
@44034 = ~«Это все, что я хотел узнать. Прощай».~
@44035 = ~«Я не понимаю, что ее беспокоит. Я пытался развеселить ее. Ума не приложу, в чем тут может быть дело».~
@44036 = ~«Как у вас двоих дела?»~
@44037 = ~«Очень жаль. У меня есть другие вопросы...»~
@44038 = ~«Удачи. Прощай».~
@44039 = ~«Не считая этой череды неудовольствий и банальностей, все просто великолепно! Все, что вращается вокруг нас, навевает такое спокойствие... наши семьи более чем удовлетворены нашим будущим союзом, ее родственники обожают меня. Все так, как и должно быть».~
@44040 = ~«Хмм. Возможно, в том-то и проблема, что проблем нет».~
@44041 = ~«Очень жаль. У меня есть другие вопросы...»~
@44042 = ~«Надеюсь, у вас все образуется. Счастливо».~
@44043 = ~«Что ты подразумеваешь под тем, что отсутствие проблем — это проблема? Прошу изъясняться яснее, сэр».~
@44044 = ~«Наверно, она хочет внести немного разнообразия в ваши отношения».~
@44045 = ~«Наверно, она хочет внести немного разнообразия в ваши отношения».~
@44046 = ~«Неважно. У меня есть другие вопросы...»~
@44047 = ~«Забудь. Счастливо».~
@44048 = ~«Откуда тебе известно, чего она желает?! — он начинает закипать. — Мы любим друг друга, невзирая на все обстоятельства, без всей этой мишуры, которой так полна незрелая любовь. Ты — мошенник и глупец, и я вызываю тебя на дуэль!»~
@44049 = ~«Погоди-ка... успокойся».~
@44050 = ~«Ты глупец, раз ввязываешься в драку со мной, однако я тебе преподам урок...»~
@44051 = ~«Довольно оскорблений, парень. У меня другие вопросы...»~
@44052 = ~«Придержи язык, не то я вырву его. Прощай».~
@44053 = ~«Прости меня... Мимолетная ярость заставила меня говорить подобным образом. Приношу свои глубочайшие извинения, сударь».~
@44054 = ~«Забудь об этом. Пустяки».~
@44055 = ~«Просто следи за собой. Драка со мной могла стать самой страшной ошибкой в твоей жизни».~
@44056 = ~Не обращать на его внимания и уйти.~
@44057 = ~«Ты воистину милосерден».~
@44058 = ~«У меня есть несколько вопросов...» ~
@44059 = ~«Я должен идти. Прощай».~
@44060 = ~«В таком случае, я буду следить за собой, сэр».~
@44061 = ~«У меня есть несколько вопросов...» ~
@44062 = ~«Я должен идти. Прощай».~
@44063 = ~«А?» Он смотрит на тебя озадаченно, даже слегка подозревающе.~
@44064 = ~«Я подслушал ее разговор в Борделе. Представляешь: у нее роман».~
@44065 = ~«Мне нужна ее любовь. И я требую, чтобы ты забрал назад свои лживые признания в любви, пока я не порубил тебя на мелкие кусочки».~
@44066 = ~«В принципе, это неважно. У меня есть несколько вопросов...»~
@44067 = ~«Тогда поговорим о ней позже. Счастливо».~
@44068 = ~«Ты лжешь. Тебе придется представить мне доказательства, прежде чем я поверю в твои заявления».~
@44069 = ~«Еще я нашел эти письма... на, почитай».~
@44070 = ~Ложь: «Я... видел, как она читала письма от него».~
@44071 = ~«Поговорим об этом позже. Прощай».~
@44072 = ~«Нет. Я отказываюсь принимать на веру обвинения... Я должен почувствовать вес этих писем в своей руке, прежде чем я дам оценку данной ситуации. Как только ты принесешь мне эти письма, мы продолжим разговор».~
@44073 = ~«Я вернусь, как только их найду. Прощай».~
@44074 = ~Он берет письма и перечитывает их. «Увы! Это правда! Она нашла себе другого, который искренне любит ее. Ах, видимо, таков удел чувствующих — испытывать душевные страдания. Принимая во внимание всю пылкость его слов, я обязан найти себе другую и отдать ее этому ее поклоннику».~
@44075 = ~«Погоди... это всего лишь розыгрыш».~
@44076 = ~«В таком случае, желаю тебе удачи. Прощай».~
@44077 = ~«Что? О чем это ты говоришь?»~
@44078 = ~«Она пытается таким образом разбудить в тебе страсть».~
@44079 = ~«Неважно... Прощай».~
@44080 = ~«Но почему она просто не сказала мне?»~
@44081 = ~«Не думаю, что ей это могло прийти в голову».~
@44082 = ~«Так для нее, наверное, проще».~
@44083 = ~«Видимо, нет. Так что же делать?»~
@44084 = ~«Отплати ей той же монетой...»~
@44085 = ~«Отплати ей той же монетой...»~
@44086 = ~«Думаю, ничего».~
@44087 = ~«Отлично. В таком случае, мне нужно задержаться и подготовить ответ».~
@44088 = ~«Надеюсь, ты сможешь все уладить. Прощай».~
@44089 = ~«Как пожелаешь. Счастливо».~
@44090 = ~«Как мне поступить, сэр?»~
@44091 = ~«Скажи, что ты устал от ваших с ней отношений, что она тебе больше не интересна».~
@44092 = ~«Скажи, что у тебя роман».~
@44093 = ~«Не уверен. Тебе решать».~
@44094 = ~«Говоришь, я должен притворится безразличным, чтобы подогреть ее интерес. Как иронично. Пожалуй, я приму твое предложение и просмотрю, что из этого выйдет».~
@44095 = ~«Удачи... Надеюсь, это сработает. Счастливо».~
@44096 = ~«Я должен идти. Прощай».~
@44097 = ~«Удачи... Надеюсь, это сработает. Счастливо».~
@44098 = ~«Я должен идти. Прощай».~
@44099 = ~«Подобный совет может быть опасен, но это, вне всякого сомнения, заставит ее пересмотреть наши отношения и попытаться сохранить их. Да будет так. Каким образом это можно осуществить?»~
@44100 = ~«Я это улажу. Я скажу, что застал тебя с другой женщиной».~
@44101 = ~«Не уверен. Тебе решать».~
@44102 = ~«Тогда хорошо. Пускай будет по-твоему».~
@44103 = ~«Хотя, если подумать, мне лучше дать тебе самому это уладить».~
@44104 = ~«Я обязательно скажу ей это при следующей встрече. Прощай».~
@44105 = ~«Я обязательно скажу ей это при следующей встрече. Прощай».~
@44106 = ~«В самом деле?»~
@44107 = ~«Да, мне это очень даже нравится».~
@44108 = ~«Удачи... Надеюсь, это сработает. Счастливо».~
@44109 = ~«Я должен идти. Прощай».~
@44110 = ~«Удачи... Надеюсь, это сработает. Счастливо».~
@44111 = ~«Я должен идти. Прощай».~
@44112 = ~«Ладно... что тогда, сэр?»~
@44113 = ~«Скажи, что ты устал от ваших с ней отношений, что она тебе больше не интересна».~
@44114 = ~«Скажи, что у тебя роман».~
@44115 = ~«Не уверен. Тебе решать».~
@44116 = ~«Но... я подумал, что мы можем говорить о чем угодно».~
@44117 = ~«Пожалуй, это именно то, что по своей сути не следовало бы обсуждать вообще».~
@44118 = ~«Ты, наверно, ошибся».~
@44119 = ~«Как же мне поступить, сэр?»~
@44120 = ~«Отплати ей той же монетой...»~
@44121 = ~«Отплати ей той же монетой...»~
@44122 = ~«Думаю, ничего».~
@44123 = ~«Ты любишь ее настолько, что будешь драться со мной?»~
@44124 = ~«Да».~
@44125 = ~«Нет, я ее не люблю, но буду за нее драться».~
@44126 = ~Он некоторое время изучает тебя. «Вижу, ты относишься к этому делу со всей страстью. А страсть появляется из любви. Ты любишь ее, и я не вправе лишать ей такой любви. Отныне я отказываюсь от притязаний на нее; поступай, как ты того пожелаешь».~
@44127 = ~«Секундочку... это все было розыгрышем».~
@44128 = ~«Э... тогда ладно. Прощай».~
@44129 = ~~
@44130 = ~«Розыгрыш? В каком смысле?»~
@44131 = ~«Она хотела подтолкнуть тебя на драку за нее».~
@44132 = ~«Неважно... Прощай».~
@44133 = ~«Да? Неужели она думает, что моя любовь столь безгранична, что я ввяжусь в драку с обезображенным шрамами человеком, имеющим твое телосложение? Вероятно, она слегка переоценила мою преданность к ней. Итак... как мы поступим с этим розыгрышем?»~
@44134 = ~«Отплати ей той же монетой...»~
@44135 = ~«Отплати ей той же монетой...»~
@44136 = ~«Думаю, ничего».~
@44137 = ~«Ах, но ты же понимаешь... вот она — страсть. А страсть происходит из любви. Ты любишь ее, и я не в праве лишать ей такой любви. Мне ли не знать ее красоты, ее сдержанности, ее добродетели, мне ли не знать ее способности побуждать мужчин к великим свершениям. Отныне я отказываюсь от притязаний на нее; поступай, как ты того пожелаешь».~
@44138 = ~«Секундочку... это все было розыгрышем».~
@44139 = ~«Э... тогда ладно. Прощай».~
@44140 = ~«О Городском Фестхолле? Тебе следует поговорить об этом со Сплинтером. Он стоит прямо у входа в это здание со внутренней стороны».~
@44141 = ~«У меня есть другие вопросы...»~
@44142 = ~«Это все, что я хотел узнать. Прощай».~
@44143 = ~«Хмм... легендарная ночная ведьма, нет? Тебе следует поговорить со Квеллом — он наиболее просвещен в такого рода вещах. Он в Фестхолле, хотя где — мне не ведомо».~
@44144 = ~«У меня есть другие вопросы...»~
@44145 = ~«Это все, что я хотел узнать. Прощай».~
@44146 = ~«И тебе доброго пути. А теперь мне нужно кое-чем заняться; если нам будет суждено встретиться вновь, мы продолжим наш разговор». Монтекки отвешивает поклон и поворачивается, чтобы уйти.~
@44147 = ~Уйти.~
@44148 = ~Оставить его в покое.~
@44149 = ~Мужчина будто не замечает твоего присутствия. Он продолжает работать над вышивкой, что-то бормоча себе под нос... когда он шьет, кажется, будто с кончика его иглы слетают и падают мерцающие пылинки света.~
@44150 = ~«Сэр, вы меня слышите?»~
@44151 = ~«Я сказал: 'Приветствую'».~
@44152 = ~«Сэр, вы меня слышите?»~
@44153 = ~«Я сказал: 'Приветствую'».~
@44154 = ~Уйти.~
@44155 = ~Человек не отрывает взгляд от работы и, противно нахмурившись, отвечает тебе: «Да-да... и я уверен, что вы по *крайне* срочному делу. А теперь не могли бы вы минутку помолчать...»~
@44156 = ~«У меня есть несколько вопросов...» ~
@44157 = ~Молча ждать.~
@44158 = ~Уйти.~
@44159 = ~~
@44160 = ~Он ухмыляется, но не отвечает.~
@44161 = ~«Я сказал: 'У меня есть несколько вопросов...'».~
@44162 = ~Молча ждать.~
@44163 = ~Его лицо начинает багроветь; он стискивает зубы, и все же не удостаивает тебя даже взглядом. «Меня не *волнуют* твои вопросы! А теперь замолчи и *покинь* мою лавку по-хорошему!»~
@44164 = ~«Отвечай на мои вопросы, *портной*... не то у тебя будут неприятности».~
@44165 = ~Молча ждать.~
@44166 = ~Уйти.~
@44167 = ~Он кидает работу в припадке ярости и кричит, брызжа слюной: «Хорошо, неприятности *будут*, когда зайдет стража, чтобы разорвать вас на кусочки! А теперь ВОН! ВОН! ВОН ИЗ МОЕЙ ЛАВКИ! Не то я позову Гармониум!»~
@44168 = ~«*Давай*, зови».~
@44169 = ~Уйти.~
@44170 = ~Наконец, он откладывает вышивку и поднимает на тебя взгляд. Однако, прежде чем ты успеваешь заговорить, он внезапно берет другую вещь и принимается работать над ней. И вновь при этом с ткани слетает нечто, похожее на крохотные цветные искорки.~
@44171 = ~«Послушайте, у меня всего лишь несколько вопросов...»~
@44172 = ~«Отвечай на мои вопросы, *портной*... не то у тебя будут неприятности».~
@44173 = ~Подождать еще немного.~
@44174 = ~Уйти.~
@44175 = ~Человек громко вздыхает. «Не сомневаюсь, что они у вас есть. А теперь не могли бы вы чуточку помолчать: уверен, что для вас не будет смертельным, если вы еще пару минут попридержите свой язык...»~
@44176 = ~«Отвечай на мои вопросы, *портной*... не то у тебя будут неприятности».~
@44177 = ~Подождать еще немного.~
@44178 = ~Уйти.~
@44179 = ~В конце концов, он заканчивает свою работу и откладывает ее, чтобы рассмотреть тебя. «Здравствуйте, я Гонсалвис. Итак, зачем вы хотели меня видеть?»~
@44180 = ~«У меня есть вопросы...» ~
@44181 = ~«Ничего, неважно. Прощайте».~
@44182 = ~«Хм-м? Надеюсь, это касательно одежды и тому подобного. Я не стану отвечать на какие-либо вопросы, не касающиеся меня или моей лавки, знаете ли».~
@44183 = ~«Я хотел бы купить костюм тленного».~
@44184 = ~«Я хотел бы купить какой-нибудь другой костюм».~
@44185 = ~«Что это был за свет, когда вы шили?»~
@44186 = ~«Какая магическая одежда у вас есть?»~
@44187 = ~~
@44188 = ~«Тогда прощайте». ~
@44189 = ~Null node.~
@44190 = ~~
@44191 = ~~
@44192 = ~~
@44193 = ~~
@44194 = ~Null node.~
@44195 = ~~
@44196 = ~~
@44197 = ~~
@44198 = ~«Это? Ничего особенного, сэр, всего лишь капелька Искусства, которое я время от времени вплетаю в ткань, когда мне этого хочется. Вещи, в которых я оставляю волшебство, — мои особые творения, и я их редко продаю».~
@44199 = ~«Какая магическая одежда у вас есть?»~
@44200 = ~«У меня есть другой вопрос...»~
@44201 = ~«Это все, что я хотел узнать. Прощайте».~
@44202 = ~Гонсалвис мрачно осматривает тебя. «Ничего, что подошло бы *вам*, это уж точно».~
@44203 = ~«Тем не менее, я хотел бы взглянуть на то, что вы предлагаете».~
@44204 = ~«Тогда вам повезло, сэр... У меня случайно есть один такой. Он стоит тридцать медных монет».~
@44205 = ~«Я возьму его».~
@44206 = ~«Хм-м... у меня не хватит денег. У меня другой вопрос...»~
@44207 = ~«На самом деле, неважно. У меня другой вопрос...»~
@44208 = ~«Тогда я, возможно, еще вернусь. Прощайте».~
@44209 = ~Гонсалвис достает из-под прилавка стопку аккуратно сложенной одежды. «Держите, сэр. Однако должен вас предупредить: если это для предстоящего маскарада лорда Ирда, то уже многие оделись как тленные».~
@44210 = ~«Буду иметь в виду. Прощайте, Гонсалвис».~
@44211 = ~Гонсалвис кивает и понимающе улыбается. «Похоже, костюм тленного стал слишком популярным, да? Что ж, так уж вышло, что у меня есть костюм богочеловека. Он будет стоить вам всего пятьдесят медяков».~
@44212 = ~«Я возьму его».~
@44213 = ~«Хм-м... у меня не хватит денег. У меня другой вопрос...»~
@44214 = ~«На самом деле, неважно. У меня другой вопрос...»~
@44215 = ~«Тогда я, возможно, еще вернусь. Прощайте».~
@44216 = ~Гонсалвис достает из-под прилавка стопку сложенной одежды, тяжелый кожаный фартук и рабочие ботинки. «Держите, сэр. Повеселитесь на маскараде».~
@44217 = ~«Спасибо, Гонсалвис. Прощайте».~
@44218 = ~Человек отрывает взгляд от работы и, казалось бы, впервые замечает Анну. Тихонько цокая, он качает головой. «Девочка, что, во имя сводящих с ума ветров Пандемониума, *нашло* на вас, что вы вот так нарядились?»~
@44219 = ~Он указывает на одежду Анны. «Кожа, мисс. Полная ее непрактичность. Обратите внимание на линию бюста, особенно на *несказанно удобные* стяжки корсажа крест-накрест. Ваше снаряжение было, *очевидно*, сшито скорее для удовлетворения чьей-то похоти, чем для вашего удобства. Даже если вы пытаетесь таким образом *высказаться* против власти и благопристойности, как и свойственно тифлингам, это послание уже давно причиняет вам большие неудобства...»~
@44220 = ~Попробовать прервать его.~
@44221 = ~Позволить им продолжить разговор.~
@44222 = ~Гонсалвис продолжает распекать Анну. «Я серьезно, вы выглядите скорее готовой к занятиям в Фестхолле, чем... — он хмурится. — Кстати, вы ведь не чувствующая, не так ли?»~
@44223 = ~Портной кивает. «Я так и думал. Вовсе нет. Может быть, вы позволите мне облачить вас в что-нибудь другое, немного скромнее...»~
@44224 = ~Попробовать прервать его.~
@44225 = ~Позволить им продолжить разговор.~
@44226 = ~«Как пожелаете, миледи, — Гонсалвис смотрит на тебя. — А теперь, сэр, раз моя работа была успешно и надолго прервана... Меня зовут Гонсалвис. Зачем вы хотели меня видеть?»~
@44227 = ~«У меня есть вопросы...» ~
@44228 = ~«Ничего, неважно. Прощайте».~
@44229 = ~Гонсалвис немедленно отрывается от работы и уважительно кланяется Падшей Грации, на что она отвечает тем же. «Приветствую, леди Грация. Чем я могу вам сегодня помочь? Тот заказ уже почти закончен...»~
@44230 = ~«Конечно! — Гонсалвис поворачивается к тебе. — Итак, сэр... зачем вы хотели меня видеть?»~
@44231 = ~«У меня есть вопросы...» ~
@44232 = ~«Ничего, неважно. Прощайте».~
@44233 = ~Портной все еще вышивает узоры на той же ткани, что и прежде. Похоже, он не обращает на тебя ни малейшего внимания.~
@44234 = ~«Приветствую...»~
@44235 = ~Оставить его в покое.~
@44236 = ~Гонсалвис откладывает свою работу и кивает тебе. «Вы снова пришли, сэр... хорошо. Чем я могу вам помочь?»~
@44237 = ~«У меня есть вопросы...» ~
@44238 = ~«Просто проходил мимо, Гонсалвис. Прощайте».~
@44239 = ~Ты видишь женщину средних лет; ее сочувственное лицо покрыто морщинками заботы. Выглядит она так, словно у нее была непростая жизнь. «Могу ли я чем-то помочь тебе, незнакомец?»~
@44240 = ~Портной ухмыляется тебе. «Советую вам *удалиться*, сэр, пока я снова не позвал стражу. Вы не сможете заслужить себе прощение за нанесенную мне обиду никакими словами или поступками. Прочь!»~
@44241 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44242 = ~«Вперед, зови стражу».~
@44243 = ~Уйти.~
@44244 = ~Морт подлетает поближе и шепчет: «Только не мне. Я могу помочь. А, шеф? Подмигну, подтолкну...»~
@44245 = ~Повергнутый в ужас, Морт встревает в разговор. «Нет! Мужик, ты *спятил*? Это же полный бред!»~
@44246 = ~«Вот ведь убогий *ублюдок*... — ворчит Анна. — Эй, ты! Мы больше не будем ждать, так что лучше тебе...»~
@44247 = ~«Кто ты?»~
@44248 = ~«Что это за место?»~
@44249 = ~«Я разыскиваю одного язвительного летающего черепа. Нигде такого не видела?»~
@44250 = ~Анна выглядит удивленной. «А? — ее удивление быстро сменяется неодобрением. — Ты это о *чем*?»~
@44251 = ~«Мне ничего не нужно. Извини. Прощай».~
@44252 = ~Анна, похоже, совсем растерялась. «Не-а, я не чувствующая...»~
@44253 = ~«Не-а, мне так больше нравится. Холода и жары я не боюсь, походу, из-за крови. И следи за тем, че ты там болтаешь про тифлингов, усек?»~
@44254 = ~«Помочь тебе найти что-нибудь?»~
@44255 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44256 = ~«Кто ты?»~
@44257 = ~«Что это за место?»~
@44258 = ~«Я разыскиваю одного язвительного летающего черепа. Нигде такого не видела?»~
@44259 = ~«Здравствуйте, мастер Гонсалвис».~
@44260 = ~«Мне ничего не нужно. Извини. Прощай».~
@44261 = ~«Нет нужды торопиться с моим заказом, мастер Гонсалвис: ваше искусство требует времени, и, несомненно, творения ваших рук еще порадуют нас. Однако я здесь не по этому поводу. Этот человек, — Падшая Грация кивает в твою сторону, — хотел бы с вами немного поговорить...»~
@44262 = ~«Так быстро вернулся? Разрушил чьи-то планы?»~
@44263 = ~«Еще нет. Мне просто нужны ответы на некоторые вопросы».~
@44264 = ~«Офицера Гармониума? Он мертв».~
@44265 = ~«Пока нет. Просто нужно задать пару вопросов».~
@44266 = ~«Еще нет. Просто нужно задать пару вопросов».~
@44267 = ~«Я работаю над этим. Прощай».~
@44268 = ~Она очень тщательно рассматривает тебя, бубня себе под нос что-то вроде «Нужно поскорее его сменить...». Потом собирается с мыслями и смотрит тебе прямо в глаза. «Значит, ты один из нас? Докажи это».~
@44269 = ~«Как?»~
@44270 = ~«Мне не нужно ничего тебе доказывать».~
@44271 = ~«Эту информацию мне дал Нарушитель Пенн. Он сказал, что тебе известно его имя».~
@44272 = ~«Я Леена. Присматриваю за этими двумя», — она махает рукой на своих товарищей.~
@44273 = ~«Чем ты здесь занимаешься?»~
@44274 = ~«Что это за место?»~
@44275 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44276 = ~«Спасибо. Прощай».~
@44277 = ~«Это склад. Я — бригадир. Сюда складывают вещи и отсюда их забирают... — она пожимает плечами. — На самом деле, говорить особо не о чем».~
@44278 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44279 = ~«Ясно. Благодарю. Прощай».~
@44280 = ~«Язвительный летающий череп? Извини, такого поблизости не видела. Если нужны черепа, советую заглянуть в Кости Ночи: похоже, ты неравнодушен к шрамам, а Лотар мог бы украсить тебя еще парочкой — ясно как ненависть балоров к пещерным демонам».~
@44281 = ~«Спасибо. Прощай».~
@44282 = ~«Ты достиг успеха в своем... деле? Только отвечай честно».~
@44283 = ~~
@44284 = ~Найти ангела, о котором говорила Равель.~
@44285 = ~Равель заявила, что она украла у меня смертность, но она, КОНЕЧНО ЖЕ, понятия не имела, где искать эту чертову штуку. Однако она сказала мне, что есть ангел,  «дэва», который может знать, что случилось с моей смертностью. Равель сказала, что все, что мне нужно — это покинуть ее лабиринт, и тогда я попаду в тюрьму, в которой он сидит.~
@44286 = ~Я нашел Триаса, ангела, о котором упоминала Равель, заключенного в Проклятом. Просто удивительно, как горожане обращаются с ангелом... это воистину город головорезов и предателей. Хотя не то чтобы он отличался от ДРУГИХ мест, в которых я побывал.~
@44287 = ~Убить крысу-оборотня в подвале Финеаса.~
@44288 = ~Я прибыл в Управление по борьбе с вредителями и заболеваниями, чтобы встретиться с Финеасом Т. Лортом. Он был сильно смятен и бормотал что-то насчет крысы-оборотня в его подвале. За вознаграждение я согласился убить существо.~
@44289 = ~Я убил крысу-оборотня и получил награду от Финеаса. Плата была скромной, учитывая то, сквозь что я ради этого прошел, но деньги — это деньги.~
@44290 = ~Найти Амариссу для Нодда.~
@44291 = ~Сборщик по имени Нодд попросил меня разыскать его сестру, Амариссу, и поговорить с ней. Он описал ее как привлекательную девушку, живущую где-то в Улье, с нежной кожей, черными волосами и всегда одевающуюся в синее. Я согласился помочь ему.~
@44292 = ~Я нашел сестру Нодда, Амариссу, и сообщил ему, где она находится.~
@44293 = ~Я нашел сестру Нодда, Амариссу, и сообщил ему, где она находится. Однако я солгал ему, сказав, что его сестра — грязная шлюха, отчего он сорвался и напал на меня.~
@44294 = ~Найти и вернуть «счастливый нож» Юхира.~
@44295 = ~Сборщик по имени Юхир сказал, что потерял свой «счастливый нож» внизу, в катакомбах по Сигилом: он всадил его в глаз упырю и убежал. Если он мне попадется, я мог бы вернуть его Юхиру.~
@44296 = ~Я нашел и вернул «счастливый нож» Юхиру.~
@44297 = ~Найти и уничтожить черепных крыс для Мертвых Народов.~
@44298 = ~Харгримм сказал, чтобы я огляделся в Мертвых Народах и перебил всех найденных черепных крыс.~
@44299 = ~Я сказал Харгримму, что нашел несколько черепных крыс в пределах Мертвых Народов и убил их. Он поблагодарил меня, но не более.~
@44300 = ~Черный Бутон желает, чтобы Гнилой Уильям был мертв.~
@44301 = ~~
@44302 = ~«Да. Он мертв».~
@44303 = ~Правда: «Еще нет».~
@44304 = ~Ложь: «Да, он мертв».~
@44305 = ~«М-м... еще раз, что я должен сделать?»~
@44306 = ~«Ты должен убрать эту самодовольную гармониумскую свинью Вортена. Пошел вон, хватит тратить мое время!»~
@44307 = ~«Я только хотел задать пару вопросов...»~
@44308 = ~«Тогда прощай».~
@44309 = ~Она отворачивается и начинает раздавать приказы своим подчиненным, игнорируя тебя.~
@44310 = ~«Тогда прощай».~
@44311 = ~«Пожалуйста, не лги мне. Это означает, что ты не уважаешь мои источники, и делает тебя еще более глупым в моих глазах. Сейчас же иди и займись своим заданием».~
@44312 = ~«Я только хотел задать пару вопросов!»~
@44313 = ~«Ну ладно. Я скоро вернусь».~
@44314 = ~«Хорошо, хорошо... он стал слишком глубоко под нас копать, хоть и не догадывался об этом. Это должно переключить внимание краснолатных угнетателей на другую цель, — ее глаза вспыхивают. — Ты доказал, что ты тот, за кого себя выдаешь. Чего тебе, собственно, было нужно?»~
@44315 = ~«Я хотел бы задать пару вопросов...»~
@44316 = ~«Место для отдыха».~
@44317 = ~«Я хотел бы купить некоторые вещи».~
@44318 = ~«Пока ничего, спасибо. Прощай».~
@44319 = ~«Что ты хотел узнать?»~
@44320 = ~«Мне нужно место для отдыха».~
@44321 = ~«Мне нужны кое-какие вещи».~
@44322 = ~«Расскажи мне немного о своей ячейке».~
@44323 = ~«Чего вы надеетесь здесь достичь?»~
@44324 = ~«Почему ты стала анархистом?»~
@44325 = ~«Что ты можешь мне рассказать о Революционной Лиге?»~
@44326 = ~«Пожалуй, больше ничего. Счастливо».~
@44327 = ~«Поговори с Коналлом, он вон там. Он у нас по этой части».~
@44328 = ~«Ладно. Тогда ответь еще на пару вопросов...»~
@44329 = ~«Спасибо».~
@44330 = ~Ее глаза расширяются. «Он типа важная шишка. По крайней мере, так говорят мои источники. Чего тебе нужно?»~
@44331 = ~«Мне нужны всего лишь несколько ответов...»~
@44332 = ~«Пока ничего. Просто хотел представиться. Счастливо».~
@44333 = ~«Вообще-то, нужно. А иначе как мы узнаем, что ты попросту не купил пароль у какого-нибудь болтуна, или что ты — не очередная трепливая костяная шкатулка. Вариант первый: ты докажешь свою преданность. Вариант второй: ты умрешь».~
@44334 = ~«Я докажу свою преданность».~
@44335 = ~«Попробуй меня убить. Я бросаю тебе вызов».~
@44336 = ~«Ладно». Она свистит своим товарищам, и они немедленно атакуют тебя!~
@44337 = ~Сражаться.~
@44338 = ~Сбежать.~
@44339 = ~«Есть тут такой себе офицер Гармониума по имени Вортен. Ты найдешь его в Нижнем районе у входа в Улей. Убери его и возвращайся с вестью о своем успехе, — она начинает поворачиваться, но останавливается. — И не пытайся соврать: у меня *повсюду* есть глаза».~
@44340 = ~«Я берусь за это».~
@44341 = ~«Забудь. Сначала тебе придется убить меня».~
@44342 = ~«Нас трое. Мы отчитываемся еще одному, но имени я не скажу; мы действуем независимо. Иногда кто-нибудь со стороны может свести нас еще с кем-то, и в зависимости от того, что мы знаем об этом человеке, мы либо помогаем ему, либо нет. Коналл — наш кладовщик, Отис — вышибала, а я — голова».~
@44343 = ~«Откуда вы знаете, кому можно доверять?»~
@44344 = ~«У меня есть еще пара вопросов...»~
@44345 = ~«Спасибо. Прощай».~
@44346 = ~«Мы собираемся свергнуть нынешнюю систему, уничтожить всю прогнившую структуру власти. Если угодно, мы хотим, чтобы правили кроткие».~
@44347 = ~«Хм-м. У меня есть еще вопросов...»~
@44348 = ~«Понятно. Спасибо».~
@44349 = ~«То есть ты предлагаешь не замечать семьи, раздавленные военной машиной Гармониума? Или моих друзей, которые слабеют и умирают от зловоний боголюдей? Или приводящих в уныние запросов Обреченных? Или чувствующих, которые потакают своим прихотям и пируют посреди чумы? А, ну тогда, пожалуй, просто так. К чему мне замечать что-то дурное в том, как обстоят дела?»~
@44350 = ~«Ладно. Ты можешь ответить еще на пару вопросов?»~
@44351 = ~«Спасибо. Прощай».~
@44352 = ~«Ты уже и так слишком много знаешь, особенно для того, кто не входит в нашу ячейку. Все работает так. Мы разбиваемся на ячейки, чтобы одна группа не смогла уничтожить другую по причине неосторожности или неудачи. Иногда мы мешаем друг другу, но в основном мы как заноза в лапе правящих фракций-угнетателей Сигила. Мы мешаем им настолько, что им приходится считаться с нами».~
@44353 = ~«Так как же вы поддерживаете связь друг с другом? У вас есть организация?»~
@44354 = ~«Звучит стояще... и опасно. У меня имеются несколько вопросов...»~
@44355 = ~«Спасибо. Прощай».~
@44356 = ~«Мы не знаем. Поэтому мы доверяем друг другу. И даже среди товарищей мы действуем осторожно. Мы никогда не доверяем по-настоящему. Это опасная игра, но нам необходимо играть в нее, если мы намерены получить свободу».~
@44357 = ~«Если вы не доверяете друг другу, откуда вам знать, насколько вы продвинулись вперед?»~
@44358 = ~«У меня есть еще пара вопросов...»~
@44359 = ~«Спасибо. Прощай».~
@44360 = ~«В данный момент у нас нет другой цели, кроме уничтожения существующих паразитических порядков. Сперва нужно свергнуть коррупцию. Исцеление сможет начаться лишь после того, как мы удалим яд из тела общества».~
@44361 = ~«Правильно. Тогда ответь мне еще на пару вопросов...»~
@44362 = ~«Спасибо. Прощай».~
@44363 = ~«У нас есть убежища, разбросанные по всему Великому Кольцу. По последним слухам, в самом лучшем из них — в Проклятом, привратном городе в Карцери — у нас есть очень сильная ячейка. Хотя они, наверное, не высунутся, если только не случится что-нибудь БОЛЬШОЕ. Тамошний город полон предателей, и лучше не высовываться, если люди так недоверчивы».~
@44364 = ~«Спасибо. У меня есть еще несколько вопросов».~
@44365 = ~«Спасибо. Прощай».~
@44366 = ~Перед тобой скрытный худощавый мужчина. Его длинные проворные пальцы подрагивают, а при разговоре он избегает твоего взгляда. «Ты напугал меня! Я... я тебя здесь раньше не видел, незнакомец. Что... что ты хочешь от меня?»~
@44367 = ~Этот грубый желтокожий мужчина некоторое время рассматривает тебя. Его глаза расширяются, и он выхватывает меч. «Пес! Пес-любитель гитцерай!» Он кидается на тебя!~
@44368 = ~Атаковать.~
@44369 = ~Сбежать.~
@44370 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44371 = ~«Кто ты?»~
@44372 = ~У этого мужчины грубая жесткая кожа с желтоватым оттенком и резкие черты лица. Его лицо угловатое, нос небольшой и высоко посажен, а уши заостренные на концах. Паутина татуировок и шрамов покрывает его тело. Он одет в странные яркие кожаные доспехи, которые, казалось бы, служат скорее для украшения, чем для боя. Его глаза — словно два маленьких черных камешка; они следят за твоим приближением. «Ты — человек, ищущий воспоминания, — говорит он равнодушно. — Я могу помочь тебе».~
@44373 = ~«Что это за место?»~
@44374 = ~«Ничего. Прощай».~
@44375 = ~«Ты ведь гитьянки?»~
@44376 = ~Бормотание тут же пропадает, и он начинает вести себя очень по-деловому. «Вот как. А он передал тебе секретное рукопожатие? Волшебное шифровальное кольцо? Ты знаешь секретный гимн ячейки? Тебя научили хоть чему-то из этого?» Какое-то время он осматривает тебя с головы до ног, затем говорит: «Очевидно, нет. В следующий раз пароль спрошу я, ладно? — он вздыхает. — Чего ты хочешь?»~
@44377 = ~«Я хотел бы купить пару вещей».~
@44378 = ~«Кто или что ты?»~
@44379 = ~«Мне нужно место, чтобы залечь на дно».~
@44380 = ~«Приветствую, звенящий мечом».~
@44381 = ~«Мне нужно расспросить тебя о твоей ячейке».~
@44382 = ~«Чего вы пытаетесь здесь достичь?»~
@44383 = ~«Почему ты стал анархистом?»~
@44384 = ~«Пожалуй, ничего. Прощай».~
@44385 = ~«Откуда тебе об этом известно?»~
@44386 = ~«Надеюсь, это придется тебе по вкусу».~
@44387 = ~«Ага, спасибо. Прощай».~
@44388 = ~«Как ты можешь мне помочь?»~
@44389 = ~«Ты знаешь первое правило тайного революционера?» Он ждет ровно столько, чтобы ты начал отвечать, и говорит: «Держи все в *тайне*. Я не выдаю секреты, приятель, и неважно, *кто* там тебя послал. Ладно, с этим мы разобрались. Чего еще ты хочешь?»~
@44390 = ~«Спасибо, меня это не интересует. Прощай».~
@44391 = ~У этого мужчины грубая жесткая кожа с желтоватым оттенком и резкие черты лица. Его лицо угловатое, нос небольшой и высоко посажен, а уши заостренные на концах. Паутина татуировок и шрамов покрывает его тело. Он одет в странные яркие кожаные доспехи, которые, казалось бы, служат скорее для украшения, чем для боя. Его глаза — словно два маленьких черных камешка; они следят за твоим приближением. «Ты — человек, ищущий воспоминания, — говорит он равнодушно. — Я могу помочь тебе».~
@44392 = ~«Ты ведь гитьянки?»~
@44393 = ~«Кто или что ты?»~
@44394 = ~«Приветствую, звенящий мечом».~
@44395 = ~«Я хотел бы купить пару вещей».~
@44396 = ~«Мне нужно место, чтобы залечь на дно».~
@44397 = ~«Чего вы пытаетесь здесь достичь?»~
@44398 = ~«Откуда тебе об этом известно?»~
@44399 = ~«Почему ты стал анархистом?»~
@44400 = ~«Пожалуй, ничего. Прощай».~
@44401 = ~«Как ты можешь мне помочь?»~
@44402 = ~«Спасибо, меня это не интересует. Прощай».~
@44403 = ~«Наши цели засекречены. В этом-то и есть суть подполья, согласен? Ты узнаешь об этом, когда сам увидишь, а увидишь ты это еще нескоро. Мы все делаем *осторожно*, ну, ты понимаешь, о чем я? И раз уж мы заговорили об осторожности, чего ты хочешь?»~
@44404 = ~«Я имею удовольствие быть представителем этого народа, — говорит он ровным голосом. — Тебе нужна моя помощь в восстановлении твоих воспоминаний?»~
@44405 = ~«Кто или что ты?»~
@44406 = ~«Хмм. Спасибо, не сегодня».~
@44407 = ~«Я — Йиминн. Я — гитьянки-ловец. Мой народ — несомненные повелители Астрального плана, куда уходят умирать боги и где воспоминания мертвых плавают словно листья в пруду. Мой долг в том, чтобы вылавливать сущность памяти мертвых и извлекать из нее информацию. Я могу найти твои воспоминания. Тебе нужно лишь заплатить».~
@44408 = ~«Какова же будет цена?»~
@44409 = ~«Я хотел бы купить пару вещей».~
@44410 = ~«Спасибо, меня это не интересует. Прощай».~
@44411 = ~«Мне нужно место, чтобы залечь на дно».~
@44412 = ~«Мне нужно расспросить тебя о твоей ячейке».~
@44413 = ~Его лицо моментально вытягивается, мышцы напрягаются, а рука непроизвольно тянется к рукоятке меча. «Ты обратился ко мне, как это делают гитцерайские псы. Было ли это невежество или оскорбление?»~
@44414 = ~«Почему ты стал анархистом?»~
@44415 = ~«Пожалуй, ничего. Прощай».~
@44416 = ~«Невежество».~
@44417 = ~«Оскорбление».~
@44418 = ~«Оглянись, пень. Ты видишь здесь кого-нибудь свободного? Ты видишь хоть хоть кого-то, кому никто не наступает ботинком на шею? Даже тех, кто считает себя важно шишкой, и то шпыняют. Эту систему нужно разрушить до основания».~
@44419 = ~«Ты не гитцерай?»~
@44420 = ~«И чем же ее заменить?»~
@44421 = ~«Похоже на довольно веский довод. Прощай».~
@44422 = ~«Ни то, ни другое».~
@44423 = ~«А это не мне решать, пень. Я хорош в том, чтобы разрушать и оставлять другим осколки. Я уничтожаю, чтобы другие могли создавать. У каждого своя специализация. Я — оптимист: я верю, что люди смогут создать что-нибудь хорошее. Но пока они не займутся этим, мне придется продолжать разрушать».~
@44424 = ~«И кто же решает, что есть хорошо? Что делает тебя таким особенным?»~
@44425 = ~«Просто у тебя такой вид. В моей профессии мы встречаем много таких как ты».~
@44426 = ~«Рад за тебя. Прощай».~
@44427 = ~«Особенным меня делает то, что я хочу хоть что-то с этим сделать. Право решать, что есть правильно, мне дает мое стремление к равенству. И я собираюсь продолжить свое дело, пока не перестану видеть, как какой-нибудь замухрышка из Улья строит из себя Золотого Повелителя».~
@44428 = ~«Отлично. Это все, что я хотел знать. Прощай».~
@44429 = ~«Я Коналл. Я здесь работаю».~
@44430 = ~«А что это за место?»~
@44431 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44432 = ~«Кто или что ты?»~
@44433 = ~Он внимательно смотрит на тебя, гадая, не шутишь ли ты. «Это Хранилище Девятого Мира, склад. Ты разве не прочитал вывеску, когда входил?»~
@44434 = ~«Оставь меня в покое. Мне неинтересно твое шарлатанство».~
@44435 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44436 = ~«Не очень внимательно. Кто ты?»~
@44437 = ~«Я ли не гитьянки? Не мы ли живем на полях Астрала? Я ловец воспоминаний, которые исчезают. Я знаю, как заманивать воспоминания. Я знаю, как ловить их, — он умолкает и с видом заговорщика наклоняется вперед. — Я знаю, как *восстановить* их. Все, что тебе нужно — это заплатить».~
@44438 = ~«Спасибо за ответ. Прощай».~
@44439 = ~«Какова цена?»~
@44440 = ~«Снова ты? Если чего-нибудь хочешь, пообщайся с головой у входа».~
@44441 = ~«Что ты можешь рассказать мне об Астральном плане?»~
@44442 = ~«Один мой... друг... сказал мне, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44443 = ~«Кто ты?»~
@44444 = ~«Что это за место?»~
@44445 = ~«Меня это не интересует. Прощай».~
@44446 = ~«Спасибо. Прощай».~
@44447 = ~«Помни о моем предложении, человек. Если пожелаешь вернуть свои воспоминания, можешь найти меня здесь. Запомни мои слова».~
@44448 = ~«Ты в беде? Тебе что-нибудь нужно?»~
@44449 = ~«Я хотел бы купить пару вещей».~
@44450 = ~«Конечно. Прощай».~
@44451 = ~«Мне нужно место, чтобы залечь на дно».~
@44452 = ~«Мне нужно расспросить тебя о твоей ячейке».~
@44453 = ~«Чего вы пытаетесь здесь достичь?»~
@44454 = ~«Почему ты стал анархистом?»~
@44455 = ~«Это дело всего лишь нескольких монет. Цена доступна. Я прошу сотню. Ты определишь ценность найденных мной воспоминаний и заплатишь соответственно».~
@44456 = ~«Пожалуй, ничего. Прощай».~
@44457 = ~«Звучит неплохо. Что я должен делать?»~
@44458 = ~«Может, позже. Прощай».~
@44459 = ~«Чтобы найти приманку для твоих воспоминаний, мне понадобятся кое-какие воспоминания из тех, которыми ты владеешь. Мне также необходимо тихое место, чтобы сосредоточиться. Если ты последуешь за мной, мы отправимся в одно такое место, и я вновь сделаю тебя единым. Мы пойдем одни, без попутчиков».~
@44460 = ~«Согласен. Пошли».~
@44461 = ~«Пожалуй, не сейчас».~
@44462 = ~«Я учуял твою ловушку, пес гитьянки. Твои хозяева-*иллитиды* должны были держать тебя в цепях».~
@44463 = ~Без единого слова, плавно как шелк, ловец достает свое оружие и подскакивает к тебе для атаки!~
@44464 = ~Сражаться.~
@44465 = ~Сбежать.~
@44466 = ~«Теперь можешь молить о прощении». Он неподвижно стоит, его глаза бегают по тебе.~
@44467 = ~«Приношу свои извинения».~
@44468 = ~«Молить? Тебя?»~
@44469 = ~«Что, тебе не нравится, когда тебя называют гитцерай?»~
@44470 = ~«Немыслимо».~
@44471 = ~«Да, — он скалится. — Ты произнес почти непростительное оскорбление. Можешь молить о прощении».~
@44472 = ~«Приношу свои извинения».~
@44473 = ~«Что, тебе не нравится, когда тебя называют гитцерай?»~
@44474 = ~«Немыслимо».~
@44475 = ~«Я — *гитьянки*. У меня нет ничего общего с гитцерайскими псами. Можешь ли ты сказать то же самое о себе?»~
@44476 = ~Правда: «Я знал нескольких гитцерай. Приятный народ».~
@44477 = ~Ложь: «Я знал нескольких гитцерай. Приятный народ».~
@44478 = ~Правда: «Нет, гитцерай для меня — меньше чем ничто».~
@44479 = ~Ложь: «Нет, гитцерай для меня — меньше чем ничто».~
@44480 = ~Правда: «Нет, гитцерай для меня — меньше чем ничто».~
@44481 = ~Ложь: «Нет, гитцерай для меня — меньше чем ничто».~
@44482 = ~Перед тобой громадный детина с тупым выражением лица и разинутым ртом. Его мускулы, однако, — зрелище воистину впечатляющее. Его мертвый взгляд неуклонно следует за тобой. «А?»~
@44483 = ~«Так ты на стороне гитцерайских псов? Да будет там же твой труп!» — он обнажает свой клинок и нападает!~
@44484 = ~Сражаться.~
@44485 = ~«Мне сказали, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44486 = ~«Кто ты?»~
@44487 = ~«Что это за место?»~
@44488 = ~Сбежать.~
@44489 = ~«Забудь. Счастливо».~
@44490 = ~«Тогда неважно. Это лишь тлен. Поговорим о других вещах. У тебя есть воспоминания, которые нужно вернуть. Я способен выловить их. Нам нужно лишь определить цену».~
@44491 = ~«Какова цена?»~
@44492 = ~«В данный момент меня это не интересует».~
@44493 = ~Его оскал не пропадает, а тело все еще напряжено. «Ты говоришь: они ничто для тебя. И все же обращаешься ко мне с их приветствием. Где же правда?»~
@44494 = ~«Ты меня подловил. Они неплохие люди».~
@44495 = ~«Они — ничто. Я признаю свое невежество, признаю, что выразился неправильно, и прошу прощения. Так лучше?»~
@44496 = ~«Это хорошо. У гитцерай кровь как вода, и семя их слабо. Давай обсудим другие вещи: у тебя есть воспоминания, и я могу вернуть их. Нам нужно лишь согласовать цену».~
@44497 = ~«Какова цена?»~
@44498 = ~«Теперь давай вернемся к тебе».~
@44499 = ~«Это должно быть одно из двух — либо расчет, либо невежество. Так что же?»~
@44500 = ~«Это невежество».~
@44501 = ~«Это оскорбление».~
@44502 = ~«Это не-место, место среди мест, где разум — единственное, что имеет значение. Это дом моего народа. Когда люди умирают, их души улетают во Внешние планы. Когда они проходят через Астральный план, их воспоминания покидают их и остаются дрейфовать в Серебряном море. Мне известен мой путь через это море. Я могу помочь возвратить потерянные тобой воспоминания. Все, что осталось — это определиться с ценой».~
@44503 = ~«Какова цена?»~
@44504 = ~«Ты ищешь воспоминания, не так ли, человек? Я могу вернуть их тебе. Похоже, что твоя потеря стала еще больше. Тебе нужно лишь немного заплатить за них».~
@44505 = ~«Теперь давай вернемся к тебе».~
@44506 = ~«Какова цена?»~
@44507 = ~«Расскажи мне побольше о твоем народе».~
@44508 = ~«Спасибо, не сегодня. Прощай».~
@44509 = ~«Ты ищешь воспоминания, не так ли, человек? Я могу вернуть их тебе. Похоже, что твоя потеря стала еще больше. Тебе нужно лишь немного заплатить за них».~
@44510 = ~«Какова цена?»~
@44511 = ~«Расскажи мне побольше о твоем народе».~
@44512 = ~«Спасибо, не сегодня. Прощай».~
@44513 = ~«Ответ может быть в утраченных тобой воспоминаниях. Начнем, и ты узнаешь».~
@44514 = ~«Какова цена?»~
@44515 = ~«Как они с этим связаны?»~
@44516 = ~«Пока не думаю, что мне это интересно».~
@44517 = ~«Когда изменишь свое мнение — а ты его изменишь, человек, — возвращайся сюда».~
@44518 = ~«Конечно. Прощай».~
@44519 = ~У этого мужчины грубая жесткая кожа с желтоватым оттенком и резкие черты лица. Его лицо угловатое, нос небольшой и высоко посажен, а уши заостренные на концах. Паутина татуировок и шрамов покрывает его тело. Он одет в странные яркие кожаные доспехи, которые, казалось бы, служат скорее для украшения, чем для боя. Его глаза — словно два маленьких черных камешка; они следят за твоим приближением. Когда ты раскрываешь рот, он останавливает тебя жестом: «Я не буду тебя слушать, человек. Не обращайся к одному из Народа».~
@44520 = ~«О чем ты говоришь?»~
@44521 = ~«У меня только пару вопросов...»~
@44522 = ~«Твой 'Народ' — собаки, которым никогда следовало срываться с поводка своих хозяев-*иллитидов*».~
@44523 = ~«Просто я хотел задать пару вопросов одному из благородных гитьянки».~
@44524 = ~«Вот и отлично».~
@44525 = ~«Я же сказал: больше со мной не говори. Неужели все люди такие же тупые как ты?»~
@44526 = ~«Мне просто нужны ответы на несколько вопросов...»~
@44527 = ~«Твой 'Народ' — собаки, которым никогда следовало срываться с поводка своих хозяев-*иллитидов*».~
@44528 = ~«Просто я хотел задать пару вопросов одному из благородных гитьянки».~
@44529 = ~«Тогда забудь».~
@44530 = ~Он смотрит на тебя равнодушно. Его рот вытягивается в тонкую линию. ~
@44531 = ~«Твой 'Народ' — собаки, которым никогда следовало срываться с поводка своих хозяев-*иллитидов*».~
@44532 = ~«Тогда прощай». ~
@44533 = ~Он умолкает на миг и смотрит тебе в глаза. «Я преклоняюсь перед твоим благородством, и все же мои знания будут для тебя как вода».~
@44534 = ~«Ты можешь рассказать мне о себе?»~
@44535 = ~«Ты можешь рассказать мне о своем народе?»~
@44536 = ~«Ты можешь рассказать мне о гитцерай?»~
@44537 = ~«Отлично. Прощай».~
@44538 = ~«Я — Йиминн, ловец. Я ловлю воспоминания мертвых, заключенные в Астральном плане».~
@44539 = ~«Ты можешь найти мои воспоминания?»~
@44540 = ~«Что ты можешь рассказать мне об Астральном плане?»~
@44541 = ~«Раз ты уважаешь мой народ, так почему же ты ничего о них не знаешь?» ~
@44542 = ~«Я хочу знать больше того, что уже знаю».~
@44543 = ~«Я всего лишь хотел с тобой поговорить».~
@44544 = ~«Они — наши отбросы. Они молят о пощаде. Их кровь жиже воды, как и их разум, — он скалит зубы. — Моя обязанность и мое удовольствие в том, чтобы предрекать их и их приспешников на мучительную гибель».~
@44545 = ~«Отлично. Можешь ли ты ответить еще на несколько вопросов?»~
@44546 = ~«Тогда прощай». ~
@44547 = ~«А?»~
@44548 = ~«Еще раз, кто ты?»~
@44549 = ~«Что это за место?»~
@44550 = ~«Мне сказали, что здесь я смогу найти ячейку анархистов. Пароль — 'затмение'».~
@44551 = ~«Ничего. Прощай».~
@44552 = ~«Не говорить со мной. Говорить Леена». Взмахом своей руки-колоды он указывает на женщину-бригадира.~
@44553 = ~«Всего лишь несколько вопросов?»~
@44554 = ~«Ладно. Прощай».~
@44555 = ~«НЕ ГОВОРИТЬ СО МНОЙ!» Кажется, он взволнован.~
@44556 = ~«Могу... не за бесплатно».~
@44557 = ~«Ну хорошо, хорошо. Прощай».~
@44558 = ~«Какова цена?»~
@44559 = ~«Я заплачу сколько угодно».~
@44560 = ~«Мы можем договориться по-другому?»~
@44561 = ~«Забудь. Лучше ответь мне на другие вопросы».~
@44562 = ~«Забудь. Прощай».~
@44563 = ~«Это не-место, место среди мест, где разум — единственное, что имеет значение. Это дом моего народа. Когда люди умирают, их души улетают во Внешние планы. Когда они проходят через Астральный план, их воспоминание покидают их и остаются дрейфовать в Серебряном море».~
@44564 = ~«Ясно. Ты не мог бы ответить еще на пару вопросов?»~
@44565 = ~«Спасибо. Прощай».~
@44566 = ~«Я уже ответил на твои вопросы. Не подходи ко мне снова».~
@44567 = ~«Тогда прощай». ~
@44568 = ~«Я больше не дам тебе ответов. Ты оказал мне уважение, и я отплатил тебе тем же».~
@44569 = ~«Раз так, тогда прощай».~
@44570 = ~«Моя цена — двести монет. На этот раз меньшего будет недостаточно».~
@44571 = ~«Вот. Возьми эти деньги».~
@44572 = ~«Это уж слишком. Может, ответишь еще на несколько вопросов...»~
@44573 = ~«Забудь. Прощай».~
@44574 = ~Гитьянки кладет твои монеты в карман. «Возвращайся сюда через неделю, и у меня будут воспоминания для тебя. Не опаздывай».~
@44575 = ~«Приветствую, почтенный гитьянки».~
@44576 = ~«Я хотел бы задать тебе несколько вопросов...»~
@44577 = ~«Отлично. Прощай».~
@44578 = ~«Извини, я, кажется, обознался. Прощай».~
@44579 = ~«Ты же не думаешь, что твои мелкие уловки затуманят мне взгляд? Ступай. Я отплатил за твое почтение ответами, и больше не буду с тобой разговаривать».~
@44580 = ~«Отлично. Прощай».~
@44581 = ~«Я не разговариваю с теми, кто не из Народа. Поговори с Йиминн, если хочешь пообщаться с нами». Он не сводит с тебя глаз.~
@44582 = ~«У меня всего лишь несколько вопросов...»~
@44583 = ~Настроение гитьянки сменилось на нечто значительно более уродливое, чем первоначальное высокомерие. «А теперь, человек, сбрось свою маску и расскажи, что ты говорил и делал для гитцерай в Сигильских стенах».~
@44584 = ~«Тогда прощай». ~
@44585 = ~В мгновение ока в его руках появляется меч. «Обращаешься ко мне, как к гитцерайскому псу? Извинись, не то я проткну тебя».~
@44586 = ~«Разве мы не должны были отправиться на поиски моих воспоминаний?»~
@44587 = ~«Извиняться? Перед тобой? Я так не думаю».~
@44588 = ~«Я не скажу тебе».~
@44589 = ~«Прошу прощения. Я подумал, что ты гитцерай».~
@44590 = ~«Я лишь облегчил боль гитцерайки».~
@44591 = ~«Приношу свои извинения».~
@44592 = ~Он склоняет голову, но не убирает руки с рукоятки меча.~
@44593 = ~«У меня есть к тебе несколько вопросов...»~
@44594 = ~«Я просто задал пару вопросов».~
@44595 = ~«Прощай».~
@44596 = ~«Я лгал им, чтобы запутать».~
@44597 = ~Сдавлено шипя, он кидается в атаку!~
@44598 = ~«Единственный путь для тебя в Астральный план — в цепях. У тебя есть еще один шанс поведать мне, что ты сказал и сделал для гитцерай в Сигильских стенах».~
@44599 = ~Сражаться.~
@44600 = ~Сбежать.~
@44601 = ~«Я не скажу тебе».~
@44602 = ~«Я не отвечаю на вопросы. Я рыцарь-гитьянки. Мои слова — это мои поступки. Поговори с Йиминном, или вообще не разговаривай с гитьянки».~
@44603 = ~«Я лишь облегчил боль гитцерайки».~
@44604 = ~«Йиминн? Ладно. Где мне его найти?»~
@44605 = ~«Я просто задал пару вопросов».~
@44606 = ~«Я лгал им, чтобы запутать».~
@44607 = ~«Тогда ты умрешь», — он обнажает оружие для атаки!~
@44608 = ~Сражаться.~
@44609 = ~~
@44610 = ~Дать им прикончить тебя.~
@44611 = ~«Ты лжешь, словно гитцерайский пес, человек. Ты — предатель и их шпион. Мы окажем тебе услугу, прикончив тебя», — он обнажает свое оружие.~
@44612 = ~Сражаться.~
@44613 = ~Дать им прикончить тебя.~
@44614 = ~«Это не так. Мы следили и подслушивали за тобой. Твои слова и стук сердца выдают тебя, человек. Приготовься умереть».~
@44615 = ~Сражаться.~
@44616 = ~Дать им прикончить тебя.~
@44617 = ~Клинок Йиминн перерезает тебе горло, и ты падаешь на землю, истекая кровью. Они стоят над тобой и снова начинают говорить. «Он что, действительно ничего не знал, Ал-мидил?»~
@44618 = ~«Если ты считаешь, что наших знаний достаточно, тогда идем. Собирай наших воинов и давай присоединимся к нашим в Лимбо».~
@44619 = ~У этого мужчины грубая жесткая кожа с желтоватым оттенком и резкие черты лица. Его лицо угловатое, нос небольшой и высоко посажен, а уши заостренные на концах. Паутина татуировок и шрамов покрывает его тело. Он одет в странные яркие кожаные доспехи, которые, казалось бы, служат скорее для украшения, чем для боя. Его глаза — словно два маленьких черных камешка; они следят за твоим приближением. Перед тем, как ты подходишь к нему, Даккон останавливается.~
@44620 = ~Гитьянки наблюдал за твоим приближением, и ты его, похоже, совсем не интересуешь. «Даккон-причитающий-на-стенах-Шракатлора... какой неожиданный сюрприз», — он достает свое оружие.~
@44621 = ~Когда ты возвращаешься, гитьянки, наблюдавший за вами все это время, обращается к вам. «Ты повернулся ко мне спиной, Даккон-причитающий-на-стенах-Шракатлора? Ты встретишься со мной с обнаженной сталью, или же я увижу, что ты носишь знак трусости у себя на спине», — он выхватывает свое оружие.~
@44622 = ~Гитьянки и Даккон незамедлительно начинают обмениваться ударами.~
@44623 = ~Напасть на гитьянки.~
@44624 = ~Дать им сразиться.~
@44625 = ~Когда Даккон кивает, гитьянки заливается грубым лающим смехом. «Ты ручной зверек этого человека, пес. Сперва предатель, а теперь еще и раб».~
@44626 = ~«Что ж, или ты замолчишь, или я отниму у тебя язык».~
@44627 = ~«Даккон, убей его».~
@44628 = ~Гитьянки кивает и ухмыляется Даккону. «Нет надобности говорить что-либо еще. Я передам слово от твоем рабском положении своему народу. Им это понравится».~
@44629 = ~«Хватит разговоров. Я ищу воспоминания».~
@44630 = ~«Довольно. Даккон, убей его».~
@44631 = ~«Довольно. Прощай».~
@44632 = ~«Воспоминания? Я нахожу их, паря в Астральном плане. Буду рад выловить их для тебя... не за бесплатно».~
@44633 = ~«Какова цена?»~
@44634 = ~«Забудь. Мы уходим».~
@44635 = ~«Даккон, убей его».~
@44636 = ~«Моя цена — двести монет. На этот раз меньшего будет недостаточно».~
@44637 = ~«Вот. Возьми эти деньги».~
@44638 = ~«Боюсь, у меня недостаточно денег. Мы, пожалуй, уйдем».~
@44639 = ~«Забудь. Мы уходим».~
@44640 = ~«Наше поле битвы — вся мультивселенная, пес. Нет святилищ. Нет мира. Ты умрешь». Гитьянки нападает!~
@44641 = ~Напасть на гитьянки.~
@44642 = ~Дать им сразиться.~
@44643 = ~«Уходишь? Нет. Вы не уйдете, пока я не получу сердце предателя Шракатлора». Гитьянки нападает!~
@44644 = ~Напасть на гитьянки.~
@44645 = ~Дать им сразиться.~
@44646 = ~«Тогда пойдем со мной, и оставь своего мальчика на побегушках».~
@44647 = ~«И ты получишь их сущность, когда я закончу».~
@44648 = ~«Посмотрим, гитцерайский пес!» Гитьянки яростно атакует Даккона.~
@44649 = ~Напасть на гитьянки.~
@44650 = ~Дать им сразиться.~
@44651 = ~«Я не советую разговаривать с этим гитьянки».~
@44652 = ~«Что за гитьянки?»~
@44653 = ~«Почему?»~
@44654 = ~«Гитьянки и гитцераи однажды были едины. Мы были рабами и едой *иллитидов*, мозгососов, которые обрекли наши жизни на служение им. Одна из наших предков, королева-воин Гит повела нас против *иллитидов*, и мы сбежали. С тех пор мы постоянно воюем с мозгососами. Но среди нас возникли разногласия, каково должно быть будущее Народа. На Проклятых равнинах наш лидер, Зертимон, произнес Предвестье Двух Небес, и обнажилась сталь. Одна раса стала двумя. Это раскол, который уже не может быть мирно решен».~
@44655 = ~«Мы все равно поговорим с ним».~
@44656 = ~«Мы все равно поговорим с ним».~
@44657 = ~«Тогда не будем об этом. Идем».~
@44658 = ~«*Знай*, что они — заклятые враги Народа. Заговорив друг с другом, мы обнажим клинки».~
@44659 = ~«Мы все равно поговорим с ним».~
@44660 = ~«Тогда не будем об этом. Идем».~
@44661 = ~Даккон кивает.~
@44662 = ~Даккон кивает.~
@44663 = ~Даккон тоже вынимает свой клинок. «Йиминн, твоя кровь будет разъедать уличные плиты».~
@44664 = ~Встать между ними: «Стоять!»~
@44665 = ~Встать между ними: «Стоять!»~
@44666 = ~Напасть на гитьянки.~
@44667 = ~Напасть на гитьянки.~
@44668 = ~Пусть дерутся.~
@44669 = ~Пусть дерутся.~
@44670 = ~Даккон обращается к тебе, не сводя глаз со своего противника: «Отойди сейчас же и не стой на пути наших клинков».~
@44671 = ~«Не приказывай мне, Даккон, иначе я прикажу тебе убить себя».~
@44672 = ~«Брось это, Даккон».~
@44673 = ~«Тогда продолжай».~
@44674 = ~Даккон говорит гитьянки: «Йиминн, это место не для битв».~
@44675 = ~«Я *знаю* вероломство гитьянки. Я буду его тенью в этом деле».~
@44676 = ~«Тень невозможно убить, пока ее владелец не падет. Я пойду без страха».~
@44677 = ~Морт закатывает глаза. «Нашествие дураков...»~
@44678 = ~«О, так ты гитьянки? Мне показалось, что я учуял на тебе вонь иллитидов. Или, может, это все твоя слабая кровь».~
@44679 = ~«Прощай».~
@44680 = ~«Больше не испытывай мое терпение. Уходи. Сейчас же».~
@44681 = ~«У меня всего лишь несколько вопросов...»~
@44682 = ~«Тогда прощай». ~
@44683 = ~Он смотрит на тебя беспристрастно. «Поищи его сам. А теперь уходи. Прекрати испытывать мое терпение».~
@44684 = ~«Тогда прощай». ~
@44685 = ~У этого мужчины бледно-желтая кожа и остроконечные уши. Его глаза — словно черные камушки. Он носит гибкую кольчугу, покрытую изысканной эмалью. Когда его глаза останавливаются на Дакконе, в его руках появляется клинок. «Гитцерайский пес! Подойди и отведай моего серебра!»~
@44686 = ~«Ты встал между нами, человек? Тогда ты тоже умрешь». Он кидается на тебя.~
@44687 = ~Сражаться.~
@44688 = ~Сбежать.~
@44689 = ~Оба гита кидаются друг на друга.~
@44690 = ~Напасть на гитьянки.~
@44691 = ~Дать им сразиться.~
@44692 = ~В руке Даккона появляется клинок. «Сегодня ты встретишься со своими предками, гитьянки».~
@44693 = ~«Хватит!»~
@44694 = ~Пусть дерутся.~
@44695 = ~«Его слова были словами врага народа. Даже если это не так, мы прижгли его невежество клеймом смерти. Оставим его здесь, чтоб о нем позаботились сборщики. В этом путешествии мы собрали достаточно сведений о гитцерайских собаках. Они потеряют еще одну крепость еще до того, как закончится седьмой день. Стены Вристигора падут».~
@44696 = ~Перед тобой куб с парой рук, ног и парой небольших крылышек по бокам. Спереди куба есть лицо, которое при твоем приближении фокусирует на тебе глаза.~
@44697 = ~«Приветствую».~
@44698 = ~Не обращать внимания на существо.~
@44699 = ~Существо фокусирует на тебе бесстрастные глаза. «Приветствуем вас, приключенец. Добро пожаловать в Рубикон, конструктор подземелий. Мы благодарим вас за выбор Рубикона в качестве приключений в подземельях. Вы можете попасть в Рубикон через эту дверь».~
@44700 = ~«Что такое Рубикон?»~
@44701 = ~«Что такое конструктор подземелий?»~
@44702 = ~«А, неважно, я ухожу. Прощай».~
@44703 = ~Существо молча смотрит на тебя.~
@44704 = ~«Что такое конструктор подземелий?»~
@44705 = ~«А, неважно, я ухожу. Прощай».~
@44706 = ~Существо, моргая, смотрит на тебя, но никоим образом не показывает, что услышал твой вопрос.~
@44707 = ~«Что такое Рубикон?»~
@44708 = ~«Что такое Рубикон?»~
@44709 = ~«А, неважно, я ухожу. Прощай».~
@44710 = ~Не обращать внимания на существо.~
@44711 = ~«Приветствуем». У существа монотонный, бесполый голос.~
@44712 = ~«У меня есть несколько вопросов...» ~
@44713 = ~«Неважно, я должен идти. Прощай».~
@44714 = ~Существо смотрит на тебя пустым взглядом. «Сформулируй свой вопрос».~
@44715 = ~«Кто ты?»~
@44716 = ~«Что ты такое?»~
@44717 = ~«Что это за место?»~
@44718 = ~«Что ты здесь делаешь?»~
@44719 = ~«Неважно, я должен идти. Прощай».~
@44720 = ~«Мы — модрон».~
@44721 = ~«Тебя зовут Модрон?»~
@44722 = ~«У меня есть несколько вопросов...» ~
@44723 = ~«Я должен идти. Прощай».~
@44724 = ~«Мы — модрон. У нас нет имен. Мы — модрон. Все, что ты видишь здесь, — модрон. Мы — одно целое».~
@44725 = ~«Ну хорошо. Вы все — модрон, но какое имя у *этого* модрона? С которым я разговариваю».~
@44726 = ~«У меня есть несколько вопросов...» ~
@44727 = ~«Я должен идти. Прощай».~
@44728 = ~Модрон начинает издавать щелкающие звуки. Со страдальческим выражением на лице он продолжает смотреть на тебя. «Мы... Я...» Он отводит от тебя взгляд, и щелчки затихают. «Мы — модрон. Наша единственная личность — модрон — единое целое. У нас нет имен».~
@44729 = ~«Тогда как вы отличаете модронов друг от друга?»~
@44730 = ~«У меня есть несколько вопросов...» ~
@44731 = ~«Я должен идти. Прощай».~
@44732 = ~Анализируя твой вопрос, модрон на некоторое время умолкает. «Мы знаем. Мы — модрон. Мы — часть целого. Как ты осознаешь ладонь частью руки, так и мы осознаем каждую часть единого целого».~
@44733 = ~«Понятно. У меня еще есть вопросы...»~
@44734 = ~«У меня есть несколько вопросов...» ~
@44735 = ~«Я должен идти. Прощай».~
@44736 = ~«Мы — модрон, мы — квадрон».~
@44737 = ~«Что такое модрон?»~
@44738 = ~«Что такое квадрон?»~
@44739 = ~«У меня есть несколько вопросов...» ~
@44740 = ~«Я должен идти. Прощай».~
@44741 = ~«Мы — модрон. Так идентифицируется наша раса».~
@44742 = ~«А что такое квадрон?»~
@44743 = ~«У меня есть несколько вопросов...» ~
@44744 = ~«Я должен идти. Прощай».~
@44745 = ~«Внутри нашей расы мы идентифицируемся как тип квадрон».~
@44746 = ~«А что такое модрон?»~
@44747 = ~«У меня есть несколько вопросов...» ~
@44748 = ~«Я должен идти. Прощай».~
@44749 = ~«Подземелье Рубикон».~
@44750 = ~«А что это на самом деле?»~
@44751 = ~«У меня есть несколько вопросов...» ~
@44752 = ~«Я должен идти. Прощай».~
@44753 = ~Хмурясь, модрон оглядывает комнату. «Мы должны знать... Мы — модрон. Мы — часть единого целого... Мы... Информация недоступна. Передайте свой запрос конструктору».~
@44754 = ~«Где я могу найти конструктора?»~
@44755 = ~«У меня есть несколько вопросов...» ~
@44756 = ~«Я должен идти. Прощай».~
@44757 = ~Модрон оглядывается по сторонам. «Мы не знаем. Информация недоступна... Мы находимся в тупиковой ситуации...»~
@44758 = ~«У меня есть несколько вопросов...» ~
@44759 = ~«Я должен идти. Прощай».~
@44760 = ~«Ожидаем инструкции».~
@44761 = ~«Инструкции чего?»~
@44762 = ~«У меня есть несколько вопросов...» ~
@44763 = ~«Я должен идти. Прощай».~
@44764 = ~Модрон одаривает тебя пустым взглядом. «Инструкции по поводу того, какие задачи необходимо выполнить».~
@44765 = ~«Что за задачи? Что вы здесь вообще делаете?»~
@44766 = ~«У меня есть несколько вопросов...» ~
@44767 = ~«Я должен идти. Прощай».~
@44768 = ~Перед тобой куб с парой рук, ног и парой небольших крылышек по бокам. Спереди у куба есть лицо, которое при твоем приближении фокусирует на тебе взгляд.~
@44769 = ~«Приветствую».~
@44770 = ~Не обращать внимания на существо.~
@44771 = ~«Приветствуем». У существа монотонный, бесполый голос.~
@44772 = ~«У меня есть несколько вопросов...» ~
@44773 = ~«Неважно, я должен идти. Прощай».~
@44774 = ~Существо смотрит на тебя пустым взглядом. «Сформулируй свой вопрос».~
@44775 = ~«Кто ты?»~
@44776 = ~«Что ты такое?»~
@44777 = ~«Что это за место?»~
@44778 = ~«Что это за место?»~
@44779 = ~«Что ты здесь делаешь?»~
@44780 = ~«Неважно, я должен идти. Прощай».~
@44781 = ~Прежде чем ответить, существо некоторое время внимательно на тебя смотрит. «Неизвестно... Существует затруднение...»~
@44782 = ~«То есть? Ты не знаешь, кто ты такой?»~
@44783 = ~«У меня есть несколько вопросов...» ~
@44784 = ~«Я должен идти. Прощай».~
@44785 = ~«Нет... Неизвестность существует... временами».~
@44786 = ~«Я тоже не могу вспомнить, кто я такой».~
@44787 = ~«У меня есть несколько вопросов...» ~
@44788 = ~«Я должен идти. Прощай».~
@44789 = ~«Я сочувствую тебе...» Он легко касается твоего плеча. Спустя мгновение он убирает руку.~
@44790 = ~«У меня есть несколько вопросов...» ~
@44791 = ~«Я должен идти. Прощай».~
@44792 = ~«Наша раса известна как модрон. Мы с плана порядка, Механуса».~
@44793 = ~«Что вы можете рассказать о Механусе?»~
@44794 = ~«У меня есть несколько вопросов...» ~
@44795 = ~«Я должен идти. Прощай».~
@44796 = ~«Место порядков... множества порядков. Хорошо структурированное...» Его голос затихает.~
@44797 = ~«У меня есть несколько вопросов...» ~
@44798 = ~«Я должен идти. Прощай».~
@44799 = ~Он озирается по сторонам. «Имитатор подземелья. Только нерабочий. Он сломался», — со вздохом произносит он.~
@44800 = ~«Что произошло?»~
@44801 = ~«Что за имитатор подземелий?»~
@44802 = ~«У меня есть несколько вопросов...» ~
@44803 = ~«Я должен идти. Прощай».~
@44804 = ~«Неизвестно. Он перестал работать».~
@44805 = ~«Что за имитатор подземелий?»~
@44806 = ~«У меня есть несколько вопросов...» ~
@44807 = ~«Я должен идти. Прощай».~
@44808 = ~Тяжело вздохнув, модрон смотрит на тебя. «Он имитирует подземелья. А ты как думаешь, что еще могут делать имитаторы подземелий?»~
@44809 = ~«Как он сломался?»~
@44810 = ~«У меня есть несколько вопросов...» ~
@44811 = ~«Я должен идти. Прощай».~
@44812 = ~Он хмуро смотрит на тебя. «Ты должен знать — ты исправил его».~
@44813 = ~«У меня есть несколько вопросов...» ~
@44814 = ~«Я должен идти. Прощай».~
@44815 = ~«Ожидаю... Думаю... Отвечаю на твои запросы...». Он бросает на тебя хмурый взгляд.~
@44816 = ~«О чем ты думаешь?»~
@44817 = ~«У меня есть несколько вопросов...» ~
@44818 = ~«Я должен идти. Прощай».~
@44819 = ~«О множестве загадок бытия...»~
@44820 = ~«У меня есть несколько вопросов...» ~
@44821 = ~«Я должен идти. Прощай».~
@44822 = ~Перед тобой куб с парой рук, ног и парой небольших крылышек по бокам. Спереди у куба есть лицо, которое при твоем приближении фокусирует на тебе взгляд.~
@44823 = ~«Приветствую».~
@44824 = ~Не обращать внимания на существо.~
@44825 = ~Он молча смотрит на тебя.~
@44826 = ~«У меня есть несколько вопросов...» ~
@44827 = ~«Неважно, я должен идти. Прощай».~
@44828 = ~Он продолжает неотрывно пялиться на тебя.~
@44829 = ~«Ты бы не мог ответить на несколько вопросов?»~
@44830 = ~«Неважно, я должен идти. Прощай».~
@44831 = ~Безучастные глаза продолжают смотреть на тебя.~
@44832 = ~«Неважно, я должен идти. Прощай».~
@44833 = ~«Приветствую».~
@44834 = ~Игнорировать его.~
@44835 = ~Он вздыхает. «Не хочу быть грубым, но я при исполнении, и у меня нет времени на вопросы». Он делает паузу. «Если тебе нужна информация, поговори с Эббом Коленоскрипом».~
@44836 = ~«Кто такой Эбб Коленоскрип?»~
@44837 = ~«Где я могу найти его?»~
@44838 = ~«У меня есть несколько вопросов...» ~
@44839 = ~«Неважно. Прощай».~
@44840 = ~«Неважно. Прощай».~
@44841 = ~«Это мой старый приятель. Думаю, он теперь решил стать осведомителем, так что теперь он сможет рассказать многое обо всем».~
@44842 = ~«Где можно найти его?»~
@44843 = ~«Неважно. Прощай».~
@44844 = ~Он задумывается. «Последний раз я слышал, что он обосновался в баре Тлеющий труп. Он находится где-то в Улье».~
@44845 = ~«Спасибо, прощай».~
@44846 = ~Ты видишь Вортена, офицера Гармониума Третьей ступени. При твоем приближении он бросает на тебя скучающий взгляд.~
@44847 = ~«У меня есть несколько вопросов...» ~
@44848 = ~«Неважно, прощай».~
@44849 = ~Оставить ее в покое.~
@44850 = ~«Ты чего-то *хочешь*... да-а-а? — она протягивает 'да', медленно и чувственно. — Я могу помочь. Назови свое желание — и я его исполню».~
@44851 = ~«Я хочу *тебя*».~
@44852 = ~«Мне нужно могущественное оружие».~
@44853 = ~«Мне нужны магические вещи».~
@44854 = ~«Мне нужны заклинания».~
@44855 = ~«Мне нужны знания. У меня есть несколько вопросов...»~
@44856 = ~«Я хочу вернуть свои воспоминания — все до одного».~
@44857 = ~«Что у тебя есть из того, что я мог бы захотеть?»~
@44858 = ~«Может, позже. Прощай».~
@44859 = ~Женщина игнорирует Морта: ее взгляд прикован к твоим глазам. Она улыбается в ожидании твоего ответа.~
@44860 = ~«Я хочу *тебя*».~
@44861 = ~«Мне нужно могущественное оружие».~
@44862 = ~«Мне нужны магические вещи».~
@44863 = ~«Мне нужны заклинания».~
@44864 = ~«Мне нужны знания. У меня есть несколько вопросов...»~
@44865 = ~«Я хочу вернуть свои воспоминания — все до одного».~
@44866 = ~«Что у тебя есть из того, что я мог бы захотеть?»~
@44867 = ~«Может, позже. Прощай».~
@44868 = ~Она облизывает губы и улыбается; ты чувствуешь, как твою грудь клонит, будто кто-то запустил в тебя руки, и вытягивает твои внутренности. «Простой запрос. У меня также есть просьба к тебе, путник: я прошу рассказать мне, объяснить, как ты хочешь меня. Позволь мне услышать твое желание... *тогда* я назову тебе цену».~
@44869 = ~«Я оговорился... я тебя не хочу».~
@44870 = ~«Я хочу тебя. Разве этого недостаточно?»~
@44871 = ~Описать, как ты ее хочешь.~
@44872 = ~Показать ей — физически, — что ты ее хочешь.~
@44873 = ~«Может, в другой раз. Прощай».~
@44874 = ~Ее улыбка меркнет, она выглядит застигнутой врасплох твоим ответом. «Ты хочешь подразнить меня, путник? Желание — не случайная эмоция... неужели ты *ничего* не хочешь?»~
@44875 = ~«Мне нужно кое-что еще...»~
@44876 = ~«Не сейчас. Прощай».~
@44877 = ~«Да? Ну, давай... расскажи мне...»~
@44878 = ~«Я хочу *тебя*».~
@44879 = ~«Мне нужно могущественное оружие».~
@44880 = ~«Мне нужны магические вещи».~
@44881 = ~«Мне нужны заклинания».~
@44882 = ~«Мне нужны знания. У меня есть несколько вопросов...»~
@44883 = ~«Я хочу вернуть свои воспоминания — все до одного».~
@44884 = ~«Что у тебя есть из того, что я мог бы захотеть?»~
@44885 = ~«Может, позже. Прощай».~
@44886 = ~Ее улыбка ожесточается. «Ты должен выразить свое желание голосом либо эмоцией, иначе для меня это не более чем пыль. Ты должен убедить меня, что ты в самом деле желаешь то, чем я могу наделить тебя, иначе оно не станет твоим».~
@44887 = ~Описать, как ты ее хочешь.~
@44888 = ~Показать ей — физически, — что ты ее хочешь.~
@44889 = ~«Может, в другой раз. Прощай».~
@44890 = ~Ты пытаешься схватить ее за плечи, но она быстро отступает, и ты хватаешь только воздух. «Недостаточно просто *хотеть* войти во дворец... просящий должен высказать свое желание, и только тогда ворота откроются. Говори».~
@44891 = ~«Я хочу тебя. Разве этого недостаточно?»~
@44892 = ~Описать, как ты ее хочешь.~
@44893 = ~«Может, в другой раз. Прощай».~
@44894 = ~Когда ты начинаешь говорить, ее улыбка тускнеет, и она, вся во внимании, наклоняется вперед; ее глаза пожирают твое лицо. Ее присутствие побуждает тебя говорить больше, чем обычно, и уже через несколько секунд ее глаза закрываются, и она резко вдыхает; ее глаза дрожат под закрытыми веками. Внезапно твое вожделение по ней начинает ослабевать... оно полностью исчезает, оставив за собой лишь холодную пустоту. Она вновь открывает глаза, улыбаясь; теперь у нее довольный вид.

«Что не так, путник? Ты больше не хочешь меня?..»~
@44895 = ~«Нет... нет, не хочу. Что ты со мной сделала?»~
@44896 = ~Она, похоже, сбита с толку. «Что ты имеешь в виду?» Несмотря на ее невинные манеры, ты уверен, что произошло нечто неестественное. Она каким-то образом высосала из тебя твое желание — выкрала его в какую-то жуткую коллекцию желаний или, возможно, поглотила его, — и оно исчезло... навсегда.

«Ну же. Ты хочешь чего-нибудь еще? Расскажи мне...»~
@44897 = ~«Я... лучше не буду. Прощай, Несбыточная Мечта».~
@44898 = ~Она изучает твое лицо. «Если тебе действительно нужны эти вещи, ты должен сперва удовлетворить мой запрос: ты должен рассказать мне, как ты хочешь эти вещи. Выскажи мне свое желание — и я назову тебе цену».~
@44899 = ~«Я оговорился... Мне не нужны эти вещи».~
@44900 = ~«Мне они нужны... разве этого недостаточно?»~
@44901 = ~Описать ей, как ты этого хочешь.~
@44902 = ~«Может, в другой раз. Прощай».~
@44903 = ~Ее улыбка меркнет. «Ты хочешь подразнить меня, путник? Желание — не случайная эмоция... неужели ты *ничего* не хочешь?» Она ждет, вновь изучая тебя.~
@44904 = ~«Мне нужно кое-что еще...»~
@44905 = ~«Не сейчас. Прощай».~
@44906 = ~Ее улыбка ожесточается. «Ты должен выразить свое желание голосом либо эмоцией, иначе для меня это ничто. Ты должен убедить меня, что ты в самом деле желаешь то, чем я могу наделить тебя, иначе оно не станет твоим».~
@44907 = ~«Я оговорился... Мне не нужны эти вещи».~
@44908 = ~Описать ей, как ты этого хочешь.~
@44909 = ~«Может, в другой раз. Прощай».~
@44910 = ~Когда ты начинаешь говорить, ее улыбка тускнеет, и она, вся во внимании, наклоняется вперед; ее глаза пожирают твое лицо. Ее присутствие побуждает тебя говорить больше, чем обычно, и уже через несколько секунд ее глаза закрываются, и она резко вдыхает; ее глаза дрожать под закрытыми веками. Внезапно твое желание начинает ослабевать... твое *хочу* полностью испаряется, оставив за собой лишь холодную пустоту. Она вновь открывает глаза, как только ты прекращаешь говорить.

«Что не так, путник? Эти вещи тебе больше не нужны?..»~
@44911 = ~«Нет... в смысле, да... что ты со мной сделала?»~
@44912 = ~Она, похоже, сбита с толку. «Что ты имеешь в виду?» Несмотря на ее невинные манеры, ты уверен, что произошло нечто неестественное. Она каким-то образом высосала из тебя твое желание, — выкрала его в какую-то жуткую коллекцию желаний или, возможно, поглотила его. Как только ты закончил описывать свое желание, у тебя появилась уверенность, что оно потеряно для тебя навсегда.

«Ну же. Ты хочешь чего-нибудь еще? Расскажи мне...»~
@44913 = ~«Я... лучше не буду. Прощай, Несбыточная Мечта».~
@44914 = ~Она нахмуривается, ненадолго посмотрев в сторону. «Знания... я не стремлюсь иметь дело с подобными вещами. Несомненно, у тебя есть какие-нибудь *другие* желания, какие-нибудь *другие* нужды, которыми ты можешь со мной поделиться...»~
@44915 = ~«Да, мне нужно еще кое-что...»~
@44916 = ~«Может, в другой раз. Прощай».~
@44917 = ~«Нет, не думаю, что мне хочется делиться этим с тобой. Счастливо».~
@44918 = ~«Все, чего бы ты не пожелал, доступно мне. То немногое, чем я не владею, я могу получить. Выскажи свое желание...»~
@44919 = ~«Есть *кое-что*, чего я хочу...»~
@44920 = ~«Может, в другой раз. Прощай».~
@44921 = ~Она улыбается. «В жизни многое может позабыться... а в нескольких жизнях — еще больше. Я *способна* помочь тебе, — она внимательно рассматривает твое лицо. — Объясни, как ты хочешь вернуть эти воспоминания. Выскажи мне свое желание — и я назову тебе цену».~
@44922 = ~«Я оговорился... Они мне не нужны».~
@44923 = ~«Как ты докажешь, что способна вернуть их мне?»~
@44924 = ~«Я хочу вернуть их... Разве этого недостаточно?»~
@44925 = ~Описать ей, как ты хочешь вернуть себе воспоминания.~
@44926 = ~«Может, в другой раз. Прощай».~
@44927 = ~Она, кажется, не двигается с места, но внезапно ее рука прикасается к твоему лбу и ведет пальцем вдоль виска. «Только это...» Ты ощущаешь, будто туман в твоей голове рассеялся, но лишь на мгновение, которого оказалось достаточно, чтобы мельком увидеть воспоминание... но прежде чем ты успеваешь сосредоточиться на нем, туман возвращается. «Только это. Скажи мне только, *почему* они тебе нужны; расскажи мне о своем желание — и я назову цену...»~
@44928 = ~«Я оговорился... Они мне не нужны».~
@44929 = ~«Я хочу вернуть их... Разве этого недостаточно?»~
@44930 = ~Описать ей, как ты хочешь вернуть себе воспоминания.~
@44931 = ~«Может, в другой раз. Прощай».~
@44932 = ~Ее улыбка ожесточается. «Ты должен выразить свое желание голосом либо эмоцией, иначе для меня это не более чем пыль. Ты должен убедить меня, что ты в самом деле желаешь то, чем я могу наделить тебя, иначе оно не станет твоим».~
@44933 = ~«Как ты докажешь, что способна вернуть их мне?»~
@44934 = ~Описать ей, как ты хочешь вернуть себе воспоминания.~
@44935 = ~«Может, в другой раз. Прощай».~
@44936 = ~Когда ты начинаешь говорить, ее улыбка тускнеет, и она, вся во внимании, наклоняется вперед; ее глаза пожирают твое лицо. Ее присутствие побуждает тебя говорить больше, чем обычно, и уже через несколько секунд ее глаза закрываются, и она резко вдыхает; ее глаза дрожать под закрытыми веками. Внезапно желание вернуть воспоминания начинает ослабевать... твое *хочу* полностью испаряется, оставив за собой лишь холодную пустоту. Она вновь открывает глаза, как только ты прекращаешь говорить.

«Что не так, путник? Ты больше не хочешь вернуть себе воспоминания?..»~
@44937 = ~«Нет... в смысле, да... что ты со мной сделала?»~
@44938 = ~Ты видишь Несбыточную Мечту. Когда ты подходишь, она поворачивается к тебе и улыбается.~
@44939 = ~«Приветствую...»~
@44940 = ~«Я просто проходил мимо. Прощай».~
@44941 = ~Ты видишь Несбыточную Мечту, которая то ли коллекционирует, и поглощает чужие желания, искореняя их из умов своих владельцев. Увидев тебя, она улыбается.~
@44942 = ~«У меня есть несколько вопросов...» ~
@44943 = ~«Я просто проходил мимо. Прощай».~
@44944 = ~«Обожа-а-аю Фестхолл».~
@44945 = ~Формирования~
@44946 = ~Легендарный злодей~
@44947 = ~Сказочный злодей~
@44948 = ~Обычный злодей~
@44949 = ~Злодейская кровь~
@44950 = ~Рыцарь легкой наживы~
@44951 = ~Негодяй~
@44952 = ~Посторонний~
@44953 = ~Рубака~
@44954 = ~Герой~
@44955 = ~Сказочный герой~
@44956 = ~Легендарный герой~
@44957 = ~Следовать~
@44958 = ~T~
@44959 = ~Собраться~
@44960 = ~4 и 2~
@44961 = ~3 на 2~
@44962 = ~Защищать~
@44963 = ~Ты проверил свое бессмертие не на том существе и был уничтожен.~
@44964 = ~Шеренга~
@44965 = ~V~
@44966 = ~Клин~
@44967 = ~S~
@44968 = ~Линия~
@44969 = ~Нет~
@44970 = ~Купить/продать~
@44971 = ~Опознать~
@44972 = ~Украсть~
@44973 = ~«Ну и тяжелые ящики!»~
@44974 = ~«Жду не дождусь выбраться отсюдова!»~
@44975 = ~«Ох, как спина болит!»~
@44976 = ~*Уф*~
@44977 = ~*Ворчание*~
@44978 = ~«Молодец!»~
@44979 = ~«Так держать!»~
@44980 = ~«Вот так. Не жалей сил!»~
@44981 = ~«У тебя отлично получается!»~
@44982 = ~«Ты отлично справляешься!»~
@44983 = ~«Впечатляюще!»~
@44984 = ~«Не жалей сил!»~
@44985 = ~«Хватит слоняться без дела!»~
@44986 = ~«Тебе платят не за то, чтобы стоять и бить баклуши!»~
@44987 = ~«Пошевеливайся!»~
@44988 = ~«БЕГОМ! БЕГОМ! БЕГОМ!»~
@44989 = ~Левая рука #985~
@44990 = ~Топор~
@44991 = ~Украшенная шкатулка~
@44992 = ~Рубин Моридора~
@44993 = ~На этой вонючей записке под текстом изображена странная диаграмма. Кажется, она указывает, что тебе следует загнуть уголки записки к центру. На каждом из уголков есть ряд странных отметок: одна отметка в верхнем правом, две — в нижнем правом, три — в нижнем левом и ни одной в верхнем левом.~
@44994 = ~Загнуть верхний правый уголок. ~
@44995 = ~Загнуть нижний правый уголок. ~
@44996 = ~Загнуть нижний левый уголок. ~
@44997 = ~Загнуть верхний левый уголок. ~
@44998 = ~Оставить записку в покое. ~
@44999 = ~Ты загибаешь уголок таким образом, чтобы он касался центра. ~
@45000 = ~Загнуть верхний правый уголок. ~
@45001 = ~Загнуть нижний правый уголок. ~
@45002 = ~Загнуть нижний правый уголок. ~
@45003 = ~Загнуть нижний левый уголок. ~
@45004 = ~Загнуть верхний левый уголок. ~
@45005 = ~Загнуть верхний левый уголок. ~
@45006 = ~Разложить записку, начать заново.~
@45007 = ~Марта качает головой. «Больше ничего, больше ничего, да, Марта? Может, попробуем еще где-нибудь, а, Марта?»~
@45008 = ~Разложить записку, оставить ее в покое.~
@45009 = ~«П... П... Проверим желудок...»~
@45010 = ~«Кы... Кы... Как насчет грудной клетки?..»~
@45011 = ~«Пы... пы... проверь внутренности... еще... раз...»~
@45012 = ~«Р... р... Расколи мне череп, ладно?»~
@45013 = ~«Ны... ны... нет, у меня есть еще пара вопросов...»~
@45014 = ~«Пы... пы... пока нет. Прощай».~
@45015 = ~Как только ты загибаешь верхний левый уголок, ты видишь, что верхний правый уголок разгибается сам по себе, возвращаясь в прежнее положение. ~
@45016 = ~Снова загнуть правый верхний уголок. ~
@45017 = ~Загнуть нижний правый уголок. ~
@45018 = ~Разложить записку, оставить ее в покое.~
@45019 = ~Как только ты загибаешь нижний левый уголок, на мгновение он остается в таком положении, но затем другие уголки разгибаются. Ничего не происходит. ~
@45020 = ~Снова осмотреть записку.~
@45021 = ~Отложить записку. ~
@45022 = ~Как только ты снова загибаешь верхний правый уголок, нижний левый уголок повторяет то же действие. Теперь все уголки касаются центра. Какое-то время ты наблюдаешь за тем, как уголки бумаги поднимаются, превращая записку в небольшую четырехугольную бумажную пирамидку. ~
@45023 = ~Разогнуть пирамидку. ~
@45024 = ~Ты отгибаешь стороны пирамидки, и бумага превращается в пыль. Внутри находится треугольная серьга. Она блестит и играет на свету. ~
@45025 = ~Взять треугольную серьгу...~
@45026 = ~Морт громко вздыхает. «Брось, шеф, мы что, и впрямь останемся на это?»~
@45027 = ~«Морт, просто немного помолчи. Я хочу послушать».~
@45028 = ~Не обращать внимания на Морта, продолжать слушать.~
@45029 = ~«Ты прав, Морт. Идем».~
@45030 = ~Продолжать слушать.~
@45031 = ~Покинуть лекционный зал.~
@45032 = ~Он говорит очень низким мрачным тоном. «Сегодня я расскажу о силе мировоззрения и веры, и о том, как они меняют планы».

«Прежде всего, я объясню концепцию мировоззрения».~
@45033 = ~Продолжать слушать.~
@45034 = ~Прекратить слушать и уйти.~
@45035 = ~«Мировоззрение — это обобщение чьих-либо убеждений, а также поступков, совершенных согласно этим убеждениям. По своей сути, преимущественно все существа ведут себя одним из трех способов: с добрыми намерениями, со злыми намерениями, или равнодушно — то есть нейтрально. В большинстве своем они выражают каждое из этих основных убеждений тремя различными путями: упорядоченно, хаотично или непредвзято, нейтрально. Таким образом, существует девять возможных основных мировоззрений».~
@45036 = ~Продолжать слушать.~
@45037 = ~Прекратить слушать и уйти.~
@45038 = ~«Девять мировоззрений включают в себя: упорядоченно-доброе, нейтрально-доброе и хаотично-доброе... упорядоченно-нейтральное, истинно-нейтральное и хаотично-нейтральное... и упорядоченно-злое, нейтрально-злое и хаотично-злое».

«Далее я расскажу о мировоззрении и порождаемых им взглядах... о том, как из них черпают силу сами боги, и о том, как убеждение может физически влиять на окружение».~
@45039 = ~Продолжать слушать.~
@45040 = ~Прекратить слушать и уйти.~
@45041 = ~«Божество должно иметь почитателей, поскольку именно их вера дает ему силу. Чем больше новообращенных, чем больше верующих в бога — тем больше силы получает этот бог».

«И наоборот, если никто не верит в божество, оно слабеет и умирает, присоединяясь к парящим в Астральном плане трупам других богов. Таким образом, можно убить божество, попросту забыв о нем».~
@45042 = ~Продолжать слушать.~
@45043 = ~Прекратить слушать и уйти.~
@45044 = ~«Тем не менее, значительно более яркий пример силы мировоззрения и убеждения можно увидеть в соскальзывании привратных городов».

«Однако сперва я дам определение привратным городам».~
@45045 = ~Продолжать слушать.~
@45046 = ~Прекратить слушать и уйти.~
@45047 = ~«Привратные города — это города на Внешних землях, практически нейтральной области, над центром которой и вращается Сигил. Они называются 'привратными городами', потому что их строят вокруг постоянных врат, или порталов, в один из Внешних планов».~
@45048 = ~Продолжать слушать.~
@45049 = ~Прекратить слушать и уйти.~
@45050 = ~«У каждого из этих Внешних планов свое мировоззрение. Бездна хаотичная и злая. Баатор упорядоченный и злой. Механус упорядоченно-нейтральный. Небесная гора упорядоченная и добрая. Опять-таки, Внешние земли истинно нейтральны, и не стремятся ни к порядку, ни к хаосу».

«'Соскальзывание' случается тогда, когда в регионе с разными убеждениями появляется высокая концентрация какого-то одного убеждения. Когда такое случается, это место сдвигается — или сползает — в план, соответствующий своему новому убеждению».~
@45051 = ~Продолжать слушать.~
@45052 = ~Прекратить слушать и уйти.~
@45053 = ~«Итак, в привратных городах обычно имеются сильные убеждения, соответствующие Внешнему плану за порталом, однако убеждения эти недостаточно сильны, чтобы город соскользнул во Внешний план».

«К примеру, город Костяк граничит с порталом в упорядоченно-злой план Баатор. Как и следовало ожидать, жители Костяка в основном упорядоченно-злые, однако в целом мировоззрение и убеждения всего города недостаточно сильны, чтобы Костяк соскользнул в Баатор».~
@45054 = ~Продолжать слушать.~
@45055 = ~Прекратить слушать и уйти.~
@45056 = ~«В Костяке, например, однажды могло бы возрасти количество упорядоченно-злых клириков, продвигающих свою темную веру и обращающих множество горожан в веру в их упорядоченно-злого бога. Если бы такое случилось, город бы, скорее всего, соскользнул с нейтральных Внешних земель, став частью упорядоченно-злого плана Баатор».

«Так могут передвигаться целые слои планов. И посему, многие войны — это вынужденные войны за убеждение и веру. Они — инструменты, с помощью которых можно захватывать и удерживать территории».~
@45057 = ~Продолжать слушать.~
@45058 = ~Прекратить слушать и уйти.~
@45059 = ~«Таким образом, в этом и заключается способность мировоззрения и убеждения менять планы. На этом лекция окончена».

«Пусть убеждения направляют ваши действия и меняют планы так, как вы того пожелаете. Всем до свидания».~
@45060 = ~Уйти.~
@45061 = ~Этот человек — худощавый, с острыми чертами лица, с желтой кожей, покрытой татуировками, — окидывает комнату и ее обитателей взглядом своих холодных черных глаз. Похоже, он ведет лекцию.~
@45062 = ~~
@45063 = ~Остаться на лекции.~
@45064 = ~~
@45065 = ~~
@45066 = ~~
@45067 = ~~
@45068 = ~~
@45069 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@45070 = ~«Итак... почему ты ходишь вдоль треугольника?»~
@45071 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45072 = ~Использовать на трупе свою способность «История костей».~
@45073 = ~«Было приятно с тобой поболтать. Прощай».~
@45074 = ~Оставить труп в покое.~
@45075 = ~Оставить труп в покое.~
@45076 = ~Твое первое впечатление от Мара: ему не помешало бы хорошенько помыться, чтобы избавиться от вони, которая вырубит любое обладающее обонянием существо. Ты практически видишь ее, она исходит от его тела зловещими желтыми облачками. Он отчаянно машет тебе, пытаясь заставить тебя приблизиться к нему и поговорить с ним.~
@45077 = ~Приблизиться к нему и выслушать его.~
@45078 = ~Я еще один персонаж Джейсона.~
@45079 = ~Что, правда?~
@45080 = ~Я один из персонажей Джейсона.~
@45081 = ~Ты уже это говорил.~
@45082 = ~Я один из персонажей Джейсона.~
@45083 = ~Уйти.~
@45084 = ~Я один из персонажей Джейсона.~
@45085 = ~«Мне сказали доставить тебе эту шкатулку».~
@45086 = ~Я один из персонажей Джейсона.~
@45087 = ~Как скажешь.~
@45088 = ~«Ха. Кажется, кто-то забыл приказать этому бедолаге прекратить следовать правилу трех».~
@45089 = ~«О чем это ты?»~
@45090 = ~~
@45091 = ~«У этих трупов котелок уже почти не варит, так что они могут выполнять не больше одного задания одновременно... если приказать им делать что-то, то они будут это делать до тех пор, пока кто-нибудь их не остановит. Этот бедолага, наверное, закончил свою работу, но сообщить об этом ему забыли».~
@45092 = ~«А кто отдает им приказы?»~
@45093 = ~«Ты что-то сказал про 'правило трех'. Что ты имел ввиду?»~
@45094 = ~«Ладно. Давай двигаться дальше».~
@45095 = ~«А? Ну, правило трех — это один из пресловутых законов планов, согласно которому все на свете случается по трое... или состоит из трех частей... или что всегда есть выбор из трех вариантов, ну и так далее».~
@45096 = ~«Ты так говоришь, как будто не очень веришь в это».~
@45097 = ~~
@45098 = ~«По мне, так все это фигня. Если ты возьмешь с потолка число, любое число, и попытаешься к нему приделать великий смысл, то ты всегда найдешь кучу каких-нибудь совпадений».~
@45099 = ~«Понятно. До этого ты говорил о том, что кто-то отдал этому трупу приказ, а потом забыл его остановить. А кто отдает трупам приказы?»~
@45100 = ~«Понятно. Я хочу еще намного осмотреть этого зомби...»~
@45101 = ~«Ладно. Давай двигаться дальше».~
@45102 = ~«Их выписал из книги мертвых либо один из здешних смотрителей, либо какой-то некромант. Скорее всего, это один из смотрителей... в конце концов, это им нужна дешевая рабочая сила».~
@45103 = ~«Понятно. А что ты там говорил до этого... про 'правило трех'?»~
@45104 = ~«Понятно. Я хочу еще намного осмотреть этого зомби...»~
@45105 = ~«Ладно. Давай двигаться дальше».~
@45106 = ~Оставить труп в покое.~
@45107 = ~Оставить труп в покое.~
@45108 = ~Ты протягиваешь руку и забираешь бинты из рук трупа. Труп даже не обратил на это внимания; он продолжает перевязывать тела.~
@45109 = ~Снова осмотреть труп. ~
@45110 = ~Оставить труп в покое.~
@45111 = ~Этот труп ходит от плиты к плите, перевязывая лежащих на них мертвецов. Он продолжает выполнять свои обязанности, даже без бинтов. На левом виске у него выбит номер «396», а его губы крепко зашиты. ~
@45112 = ~«Извини, что забрал те бинты. Просто мне они нужны больше, чем этим телам».~
@45113 = ~«Извини, что забрал те бинты. Просто мне они нужны больше, чем этим телам».~
@45114 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45115 = ~Использовать на трупе свою способность «История костей».~
@45116 = ~«Было приятно с тобой поболтать. Прощай».~
@45117 = ~Оставить труп в покое.~
@45118 = ~Заклинания~
@45119 = ~Напитки~
@45120 = ~Комнаты~
@45121 = ~Пожертвовать~
@45122 = ~«Хм-м. Если бы у меня было что-нибудь, чтобы разрезать эти швы...»~
@45123 = ~Оставить труп в покое.~
@45124 = ~Молочно-белые глаза трупа смотрят на тебя без выражения.~
@45125 = ~Оставить труп в покое.~
@45126 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@45127 = ~Оставить труп в покое.~
@45128 = ~На лбу этого трупа чернилами написан номер «1201», чернила стекли на глаза, щеки и челюсти, создавая впечатление, что он плачет. Его челюсть распахнута, из уголка рта течет струйка гноя.~
@45129 = ~«Извини, что срезал швы... Мне просто нужно было посмотреть, что у тебя во рту».~
@45130 = ~«Извини, что срезал швы... Мне просто нужно было посмотреть, что у тебя во рту».~
@45131 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45132 = ~Использовать на трупе свою способность «История костей».~
@45133 = ~«Было приятно поболтать с тобой. Прощай».~
@45134 = ~Оставить труп в покое.~
@45135 = ~«Что ты можешь рассказать о здешних посетителях?»~
@45136 = ~«Гилтспур, да? Дай-ка посмотреть». Он берет у тебя рекламный листок и хмуро смотрит на него. «Хорошо. Скажи ему, что я его вывешу. Еще что-нибудь?»~
@45137 = ~«Только несколько вопросов...»~
@45138 = ~«Больше ничего, спасибо. Прощай».~
@45139 = ~Сражаться.~
@45140 = ~Сбежать.~
@45141 = ~У этого мужчины желтый оттенок кожи и худощавое лицо, а тело покрыто татуировками и шрамами; на груди у него висит длинный клинок. Его глаза — словно два уголька. Он кланяется тебе, когда ты подходишь. «Приветствую, звенящий мечом. Мне *известно* о твоей своевременной наводке. Скажи, чего ты хочешь от меня».~
@45142 = ~«Кто ты?»~
@45143 = ~«Ты можешь присоединиться к моему отряду?»~
@45144 = ~«Где ты получил свои шрамы?»~
@45145 = ~«Где ты получил свои татуировки?»~
@45146 = ~«В чем разница между гитцераями и гитьянки?»~
@45147 = ~«В чем разница между гитцераями и гитьянки?»~
@45148 = ~«Ты можешь обучить меня своему языку?»~
@45149 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45150 = ~«Я не могу. У меня есть долг перед своим народом».~
@45151 = ~«Что это за долг?»~
@45152 = ~«Тогда я хотел бы задать тебе еще несколько вопросов».~
@45153 = ~«Задавай свои вопросы, но не уподобляйся тонущей Ачали: задавай их прямо и по сути».~
@45154 = ~«Кто ты?»~
@45155 = ~«Ты можешь присоединиться к моему отряду?»~
@45156 = ~«Где ты получил свои шрамы?»~
@45157 = ~«Где ты получил свои татуировки?»~
@45158 = ~«В чем разница между гитцераями и гитьянки?»~
@45159 = ~«В чем разница между гитцераями и гитьянки?»~
@45160 = ~«Ты можешь обучить меня своему языку?»~
@45161 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45162 = ~Он поднимает руки, почтительно прикладывает их к своему лицу, потом к груди. «Шрамы, украшающие мое лицо, получены в стычках в залах Ильсенсайна. Мой отряд рракма был едва не поглощен трусливыми *иллитидами*. Шрам на верхней части моего торса получен от неверного удара 'крадущего форму', клинка гитьянки, — он кивает на твои шрамы. — Поведай историю своих шрамов».~
@45163 = ~«Я не помню, как получил большинство из них».~
@45164 = ~«Они получены в столь многих битвах, что этот рассказ займет слишком много времени».~
@45165 = ~«Это всего лишь шрамы. У меня есть другие вопросы...»~
@45166 = ~«Это всего лишь шрамы. У меня есть другие вопросы...»~
@45167 = ~«Они рассказывают историю моего рода и даруют мне его силу и дух. Одна из них, наколотая Арджароком с острова Сеал, повествует о моем сородиче, Джиликаи, которых похоронил своих врагов в стенах Шракатлора. А вот эта сделана Феллом, ходящим дабусом, и рассказывает о нашей с Роджхи битве: на плане Лимбо мы победили семерых слаади, прежде чем восьмой заглушил разум Роджхи, — он кивает на твои татуировки. — Поведай историю своих татуировок».~
@45168 = ~«Они рассказывают о том, что я надеюсь осуществить».~
@45169 = ~«Они рассказывают о преодоленных мной препятствиях и хранят рассказы о моем прошлом, чтобы я не забыл его».~
@45170 = ~«Это всего лишь татуировки. Расскажи мне о Фелле».~
@45171 = ~«Это всего лишь татуировки. Расскажи мне о Фелле».~
@45172 = ~«Это всего лишь татуировки. У меня есть другие вопросы...»~
@45173 = ~«Это всего лишь татуировки. У меня есть другие вопросы...»~
@45174 = ~Он прищуривает глаза и сплевывает на землю. «Они кучка лживых вороватых продажных псов, которым нельзя доверять ни под каким предлогом. Если встретишь одного из них, вспомни урок сердца Селканта и ока Вилькара... и помни, что гитьянки втрое хуже».~
@45175 = ~«Что это за уроки?»~
@45176 = ~«Спасибо. У меня есть другие вопросы...»~
@45177 = ~«Спасибо. Прощай».~
@45178 = ~Он делает легкий поклон. «Если бы не мой долг перед народом, я бы с радостью сделал это. Но, как у гостя за столом Торига, моя тарелка полна. Я не могу. Может, тебе стоит попросить кого-то другого...»~
@45179 = ~«Все равно спасибо. У меня есть другие вопросы...»~
@45180 = ~«Все равно спасибо. Прощай».~
@45181 = ~«Селкант и Вилькар известны своей жестокостью и вероломством, и принадлежали к народу гитцераев. Но их деяния меркнут на фоне гитьянки, самых бессердечных подонков, когда-либо плававших по Серебряному морю».~
@45182 = ~«У меня есть еще несколько вопросов...»~
@45183 = ~«Спасибо за уделенное время. Прощай».~
@45184 = ~На миг он умолкает, и ты ощущаешь, что он недоволен ответом. «Тонущая Ачали, ну так задавай свои вопросы».~
@45185 = ~«Ты можешь присоединиться к моему отряду?»~
@45186 = ~«Где ты получил свои шрамы?»~
@45187 = ~«Где ты получил свои татуировки?»~
@45188 = ~«В чем разница между гитцераями и гитьянки?»~
@45189 = ~«Как ты попал сюда?»~
@45190 = ~«Ты оказался далеко от своего дома. Желаю удачи. Прощай».~
@45191 = ~«В чем разница между гитцераями и гитьянки?»~
@45192 = ~«Ты можешь обучить меня своему языку?»~
@45193 = ~«Я понял. Ты — один из невежд».~
@45194 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45195 = ~«Похоже на настоящее приключение. У меня есть другие вопросы к тебе».~
@45196 = ~«Желаю удачи. Она тебе понадобится. Прощай».~
@45197 = ~С гневом во глазах он отвешивает тебе поклон и произносит: «Твои слова не делают тебе чести. И выслушивание их не делает чести мне. Я больше не стану с тобой говорить». На миг он закрывает глаза, затем смотрит мимо тебя.~
@45198 = ~«Я хотел лишь задать пару вопросов...»~
@45199 = ~«Тогда прощай». ~
@45200 = ~Ударить его.~
@45201 = ~Выражение его лица слегка меняется; трудно сказать, смятение это или презрение. «Как шрамы могут умолчать о том, как они были получены?»~
@45202 = ~«Это всего лишь шрамы. У каждого они есть».~
@45203 = ~«Это всего лишь шрамы. У каждого они есть».~
@45204 = ~«Я лишился воспоминаний о них, а также о своем прошлом».~
@45205 = ~На миг он умолкает, переваривая это, затем говорит: «Что ж, стенания Тча. Я сожалею, что ты утратил память и прошлое».~
@45206 = ~«Спасибо. У меня есть еще несколько вопросов...»~
@45207 = ~«Спасибо. Прощай».~
@45208 = ~Он ждет пару секунд, затем закрывает глаза и делает еще один поклон. «Твои татуировки превращают будущее в настоящее и направляют его. В подобных татуировках кроется мудрость Вождей. Твои рассказы отмечены».~
@45209 = ~«Спасибо. Ты упоминал Фелла?»~
@45210 = ~«Спасибо. У меня есть другие вопросы...»~
@45211 = ~«Спасибо. Прощай».~
@45212 = ~Он закрывает глаза и делает поклон. «Твои рассказы отмечены, звенящий мечом».~
@45213 = ~«Как и твои. У меня есть другие вопросы...»~
@45214 = ~«У меня есть другие вопросы...»~
@45215 = ~«Как и твои. Прощай».~
@45216 = ~«Спасибо. Прощай».~
@45217 = ~«Ходящий дабус — мастер своего дела. Некоторые его татуировки рассказывают истории. Другие говорят о духе. Татуировки, которые Фелл наносит на кожу, придают силу телу и разуму, в зависимости от истории».~
@45218 = ~«Где мне найти Фелла?»~
@45219 = ~«Какого рода силу?»~
@45220 = ~«Спасибо. У меня есть другие вопросы...»~
@45221 = ~«Спасибо. Прощай».~
@45222 = ~«Он находится в Улье, на севере юго-восточной области. В этом городе плохо объясняют дорогу: как будто ты следуешь бредовым идеям Вождя, *не знающего* себя».~
@45223 = ~«Какого рода силу дают его татуировки?»~
@45224 = ~«У меня есть другие вопросы...»~
@45225 = ~«Спасибо. Прощай».~
@45226 = ~«Татуировка Роджхи, который лишил жизни семерых слаади, придает силу моим конечностям, когда я сталкиваюсь с непреодолимыми трудностями. Характер силы зависит от опыта: расскажи Феллу истории о себе, и татуировки подарят тебе свою силу, как только рассказы попадут на кожу».~
@45227 = ~«Где мне его найти?»~
@45228 = ~«Спасибо. У меня есть другие вопросы...»~
@45229 = ~«Спасибо. Прощай».~
@45230 = ~Он кивает тебе. «Я Хайлциин, воин гитцераев, прибыл сюда за припасами. Я обнаружил, что этот город — словно камень Трайигора: его часто восхваляют, но ценности в нем найдется немного».~
@45231 = ~«В чем разница между гитцераями и гитьянки?»~
@45232 = ~«В чем разница между гитцераями и гитьянки?»~
@45233 = ~«Ты можешь обучить меня своему языку?»~
@45234 = ~«У меня есть другие вопросы...»~
@45235 = ~«Спасибо. Прощай».~
@45236 = ~Он кивает тебе. «Твоя доблесть отмечена, звенящий мечом».~
@45237 = ~«Как и твоя. У меня есть другие вопросы...»~
@45238 = ~«У меня есть другие вопросы...»~
@45239 = ~«Как и твоя. Прощай».~
@45240 = ~«Спасибо. Прощай».~
@45241 = ~Хайлциин отвешивает тебе поклон. «Приветствую, звенящий мечом».~
@45242 = ~«Здравствуй. У меня есть несколько вопросов...»~
@45243 = ~«Нет, все в порядке... Мне уже пора...»~
@45244 = ~«Так пойди и помоги ему! Вперед!»~
@45245 = ~«Да вижу-вижу — не слепой!»~
@45246 = ~«Брока, у нас покупатель!»~
@45247 = ~«Здравствуй и прощай».~
@45248 = ~У этого мужчины желтый оттенок кожи и худощавое лицо. Его тело покрыто татуировками и шрамами; на груди у него висит длинный клинок. Его глаза — словно два уголька. Он кланяется тебе, когда ты подходишь. «Приветствую, звенящий мечом. Мне *известно* о твоей помощи моему народу. Скажи, чего ты хочешь от меня».~
@45249 = ~«Кто ты?»~
@45250 = ~«Ты можешь присоединиться к моему отряду?»~
@45251 = ~«Где ты получил свои шрамы?»~
@45252 = ~«Где ты получил свои татуировки?»~
@45253 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45254 = ~У этого мужчины желтый оттенок кожи и худощавое лицо. Его тело покрыто татуировками и шрамами; на груди у него висит длинный клинок. Его глаза — словно два уголька. Он кланяется тебе, когда ты подходишь. «Приветствую, звенящий мечом. Мне *известно* о твоей помощи моему народу. Скажи, чего ты хочешь от меня».~
@45255 = ~«Кто ты?»~
@45256 = ~«Ты можешь присоединиться к моему отряду?»~
@45257 = ~«Где ты получил свои шрамы?»~
@45258 = ~«Где ты получил свои татуировки?»~
@45259 = ~«В чем разница между гитцераями и гитьянки?»~
@45260 = ~«В чем разница между гитцераями и гитьянки?»~
@45261 = ~«Ты можешь обучить меня своему языку?»~
@45262 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45263 = ~Хайлциин отвешивает тебе поклон. «Приветствую, звенящий мечом».~
@45264 = ~«Здравствуй. У меня есть несколько вопросов...»~
@45265 = ~«Здравствуй и прощай».~
@45266 = ~Хайлциин отвешивает тебе поклон. «Приветствую, звенящий мечом».~
@45267 = ~«Здравствуй. У меня есть несколько вопросов...»~
@45268 = ~«Здравствуй и прощай».~
@45269 = ~У этого мужчины желтый оттенок кожи и худощавое лицо. Его тело покрыто татуировками и шрамами; на груди у него висит длинный клинок. Его глаза — словно два уголька. Он кланяется тебе, когда ты подходишь. «Я тебя *не знаю*... однако я буду говорить с тобой».~
@45270 = ~«Кто ты?»~
@45271 = ~«Где ты получил свои шрамы?»~
@45272 = ~«Где ты получил свои татуировки?»~
@45273 = ~«В чем разница между гитцераями и гитьянки?»~
@45274 = ~«В чем разница между гитцераями и гитьянки?»~
@45275 = ~«Ты можешь обучить меня своему языку?»~
@45276 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45277 = ~Хаилциин спокойно наблюдает за твоим приближением, потом лаконично произносит: «Приветствую, путник».~
@45278 = ~«Здравствуй. У меня есть несколько вопросов...»~
@45279 = ~«Здравствуй и прощай».~
@45280 = ~У этого мужчины желтый оттенок кожи и худощавое лицо. Его тело покрыто татуировками и шрамами; на груди у него висит длинный клинок. Его глаза — словно два уголька. Когда ты подходишь, он кланяется Даккону. «Мое почтение, *зерт*».~
@45281 = ~«Его слова *известны* мне, *зерт*. В отличие от его деяний. Его тень говорит о том, кто повидал сражений и одержал верх над каждым, кто выступал против него. Правильно ли я увидел его под этой оболочкой?»~
@45282 = ~«Я выслушаю его, *зерт*, — он поворачивается к тебе в ожидании вопросов. — Задавай свои вопросы. Направляй их так, как направлял бы свой разум».~
@45283 = ~«Кто ты?»~
@45284 = ~«Где ты получил свои шрамы?»~
@45285 = ~«Где ты получил свои татуировки?»~
@45286 = ~«Ты можешь обучить меня своему языку?»~
@45287 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45288 = ~«Что ж, спрашивай»~
@45289 = ~«Кто ты?»~
@45290 = ~«Где ты получил свои шрамы?»~
@45291 = ~«Где ты получил свои татуировки?»~
@45292 = ~«Ты можешь обучить меня своему языку?»~
@45293 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45294 = ~Он кивает тебе. «Я Хайлциин, воин гитцераев, прибыл сюда за припасами. Я обнаружил, что этот город словно камень Трайигора — его часто восхваляют, но ценности в нем найдется немного. Воздух здесь непригоден для нашего народа, а живущие здесь *не знают* себя. Они — пустые оболочки».~
@45295 = ~«Понятно. У меня есть другие вопросы...»~
@45296 = ~«И то правда. Прощай».~
@45297 = ~Он поднимает руки, почтительно прикладывает их к своему лицу, потом к груди. «Шрамы, украшающие мое лицо, получены в стычках в залах Ильсенсайна. Мой отряд рракма был едва не поглощен трусливыми *иллитидами*. Шрам на верхней части моего торса получен от неверного удара 'крадущего форму', клинка гитьянки, — он кивает на твои шрамы. — Поведай историю своих шрамов».~
@45298 = ~Выражение его лица слегка меняется; трудно сказать, смятение это или презрение. «Как шрамы могут умолчать о том, как они были получены?»~
@45299 = ~«Это всего лишь шрамы. У каждого они есть».~
@45300 = ~«Я лишился воспоминаний о них, а также о своем прошлом».~
@45301 = ~Он бросает на Даккона непонятный взгляд. У тебя появляется впечатление, что ты провалил своего рода испытание. «Ты хотел еще что-то *узнать*?»~
@45302 = ~«Да».~
@45303 = ~Купить~
@45304 = ~Продать~
@45305 = ~Украсть~
@45306 = ~Снять~
@45307 = ~Пожертвовать~
@45308 = ~Крестьянин~
@45309 = ~«Нет. Прощай».~
@45310 = ~Торговец~
@45311 = ~На миг он умолкает, переваривая это, затем говорит: «Что ж, стенания Тча. Я сожалею, что ты утратил память и прошлое».~
@45312 = ~«Спасибо. У меня есть еще несколько вопросов...»~
@45313 = ~Аристократ~
@45314 = ~«Спасибо. Прощай».~
@45315 = ~Он кивает тебе. «Твоя доблесть отмечена, звенящий мечом».~
@45316 = ~Король~
@45317 = ~«У меня есть другие вопросы...»~
@45318 = ~«Спасибо. Прощай».~
@45319 = ~«Они рассказывают историю моего рода и даруют мне его силу и дух. Одна из них, наколотая Арджароком с острова Сеал, повествует о моем сородиче, Джиликаи, которых похоронил своих врагов в стенах Шракатлора. А вот эта сделана Феллом, ходящим дабусом, и рассказывает о нашей с Роджхи битве: на плане Лимбо мы победили семерых слаади, прежде чем восьмой заглушил разум Роджхи, — он кивает на твои татуировки. — Поведай историю своих татуировок».~
@45320 = ~«Они рассказывают о том, что я надеюсь осуществить».~
@45321 = ~«Они рассказывают о преодоленных мной препятствиях и хранят рассказы о моем прошлом, чтобы я не забыл его».~
@45322 = ~«Это всего лишь татуировки. У меня есть другие вопросы...»~
@45323 = ~Он ждет пару секунд, затем закрывает глаза и делает еще один поклон. «Твои татуировки превращают будущее в настоящее и направляют его. В подобных татуировках кроется мудрость Вождей. Твои рассказы отмечены».~
@45324 = ~«Спасибо. Ты упоминал Фелла?»~
@45325 = ~«Спасибо. У меня есть другие вопросы...»~
@45326 = ~«Спасибо. Прощай».~
@45327 = ~Он закрывает глаза и делает поклон. «Твои рассказы отмечены, звенящий мечом».~
@45328 = ~«Спасибо. Ты упоминал Фелла?»~
@45329 = ~«У меня есть другие вопросы...»~
@45330 = ~«Спасибо. Прощай».~
@45331 = ~«Ходящий дабус — мастер своего дела. Некоторые его татуировки рассказывают истории. Другие говорят о духе. Татуировки, которые Фелл наносит на кожу, придают силу телу и разуму, в зависимости от истории».~
@45332 = ~«Где мне найти Фелла?»~
@45333 = ~«Какого рода силу?»~
@45334 = ~«Спасибо. У меня есть другие вопросы...»~
@45335 = ~«Спасибо. Прощай».~
@45336 = ~«Он находится в Улье, на севере юго-восточной области. В этом городе плохо объясняют дорогу: как будто ты следуешь бредовым идеям Вождя, *не знающего* себя».~
@45337 = ~«Какого рода силу дают его татуировки?»~
@45338 = ~«У меня есть другие вопросы...»~
@45339 = ~«Спасибо. Прощай».~
@45340 = ~«Татуировка Роджхи, который лишил жизни семерых слаади, придает силу моим конечностям, когда я сталкиваюсь с непреодолимыми трудностями. Характер силы зависит от опыта: расскажи Феллу истории о себе, и татуировки подарят тебе свою силу, как только рассказы попадут на кожу».~
@45341 = ~«Где мне его найти?»~
@45342 = ~«Спасибо. У меня есть другие вопросы...»~
@45343 = ~«Спасибо. Прощай».~
@45344 = ~Он делает легкий поклон. «С тобой находится непревзойденный мастер языка. Попроси его, и, возможно, он тебя обучит».~
@45345 = ~«Все равно спасибо. У меня есть другие вопросы...»~
@45346 = ~«Все равно спасибо. Прощай».~
@45347 = ~«Его слова *известны* мне, *зерт*, так же как и его своевременные действия касательно нашей крепости. Я выслушаю его».~
@45348 = ~«Кто ты?»~
@45349 = ~«Где ты получил свои шрамы?»~
@45350 = ~«Где ты получил свои татуировки?»~
@45351 = ~«Ты можешь обучить меня своему языку?»~
@45352 = ~«Мне ничего не нужно. Спасибо и прощай».~
@45353 = ~Хайлциин кланяется тебе, когда ты подходишь. «Ты делаешь мне честь своим возвращением».~
@45354 = ~«Спасибо. У меня есть пара вопросов...»~
@45355 = ~«Спасибо, но я должен идти. Прощай».~
@45356 = ~«Ты вернулся, *зерт*, вместе со своим человеком. Ты хочешь *знать* больше?»~
@45357 = ~«Да».~
@45358 = ~«Нет. Прощай».~
@45359 = ~«Я здесь, чтобы собрать припасы и созвать подкрепление. В последнее время гитьянки осмелели. Мы готовимся к кровавой войне».~
@45360 = ~«Звучит захватывающе. Я хотел бы задать тебе еще пару вопросов».~
@45361 = ~«Понятно. Прощай».~
@45362 = ~«Этот принадлежит к числу верных, — он делает поклон. — Я желаю, чтобы ты *знал*, что этот человек путешествует со мной. Выслушаешь ли ты его?»~
@45363 = ~«У меня всего лишь несколько вопросов...»~
@45364 = ~«У меня всего лишь несколько вопросов...»~
@45365 = ~«Твой вопрос к месту. Я желаю, чтобы ты *знал*, что у нас с ним один путь. Выслушаешь ли ты его?»~
@45366 = ~«Вопрос о шрамах — знак почтения. Это проявление уважения к твоей истории».~
@45367 = ~«Я не помню, как получил большинство из них».~
@45368 = ~«Они получены в столь многих битвах, что этот рассказ займет слишком много времени».~
@45369 = ~«Это всего лишь шрамы. У меня есть другие вопросы...»~
@45370 = ~Стеклянная бусинка~
@45371 = ~Ржавый кинжал~
@45372 = ~Планы гробницы~
@45373 = ~ПЛАНЫ ГРОБНИЦЫ
Вес: 0

Планы гробницы, сделанной под заказ. Наверху гордо выведены слова «Построено на века».~
@45374 = ~<ITEMNAME> — <ITEMCOST> мед.~
@45375 = ~Все отдыхают в гостинице на протяжении 8 часов и восстанавливают по <HP> очков жизни. Заклинания запомнены удачно.~
@45376 = ~Аола~
@45377 = ~Аола~
@45378 = ~Шиландра~
@45379 = ~Ты видишь высокую фигуру существа, возвышающегося перед тобой. Нижняя часть его тела напоминает козла. Тем не менее, выше передних ног явно различимы человеческие черты: мужской торс, руки и голова — все покрыто сверкающими доспехами. Глаза существа закрыты, похоже, он спит.~
@45380 = ~Существо отрывисто фыркает, но при это глаз не открывает. Определенно, спит оно крепко.~
@45381 = ~Получеловек-полукозел продолжает крепко спать. ~
@45382 = ~«Приветствую».~
@45383 = ~Пусть спит дальше.~
@45384 = ~Пусть спит дальше.~
@45385 = ~Пусть спит дальше.~
@45386 = ~«Что, если я куплю его у тебя?»~
@45387 = ~«Что, если я куплю его у тебя?»~
@45388 = ~Она глядит на тебя как на сумасшедшего. «Ты что, совсем сбрендил? Конечно, я не стану продавать свое имя!»~
@45389 = ~«Что, если я куплю его у тебя?»~
@45390 = ~«Потому что это мое имя, пень! Имена не продаются!»~
@45391 = ~«Почему?»~
@45392 = ~«Просто отдай мне имя и номер, иначе я вырву их из тебя. Поверь, тебе этого не захочется».~
@45393 = ~«Отлично, я обсужу с ним это. Но сначала ответь на мои вопросы».~
@45394 = ~«Отлично. Я обсужу с ним это».~
@45395 = ~«Имя не купишь ни за какие деньги. Номер не купишь ни за какие богатства. Монеты — скудное утешение за личность. Ты это, конечно же, понимаешь».~
@45396 = ~«Она предложила за них деньги».~
@45397 = ~«Да, я сделаю, что смогу сделать. Прощай».~
@45398 = ~Браскен~
@45399 = ~Задержать дыхание и уйти.~
@45400 = ~Приближаясь к Мару, ты готовишься к его зловонию. «Ты ведь сделаешь одолжение Мару, правда? Тебе нужно доставить шкатулку».~
@45401 = ~«Я доставлю твою посылку».~
@45402 = ~«Зачем для доставки этой посылки тебе нужен я?»~
@45403 = ~«Прощай».~
@45404 = ~При твоем приближении глаза Мара расширяются в изумлении. Он кричит тонким петушиным голосом: «Зачем ты приперся сюда?! Не возвращайся, пока не доставишь шкатулку».~
@45405 = ~«Тот, кому ты просил передать эту шкатулку, убежал. Что теперь?»~
@45406 = ~«Я избавился от шкатулки».~
@45407 = ~«Я убил демона из шкатулки».~
@45408 = ~«Я убил демона из шкатулки».~
@45409 = ~«Я открыл шкатулку, и из нее появился нечистый. Я убежал».~
@45410 = ~«Никому не нужна эта шкатулка. Забирай ее обратно».~
@45411 = ~«Я покинул Улей и ничего не произошло».~
@45412 = ~«Прощай».~
@45413 = ~«Да ты чокнутый идиот! Ты подписался под собственной смертью, открыв эту проклятую шкатулку! Беги, если жизнь тебе дорога!» Мар срывается с места.~
@45414 = ~«Прощай».~
@45415 = ~Куатраа~
@45416 = ~Куатраа~
@45417 = ~Власк~
@45418 = ~Власк~
@45419 = ~Этот покрытый швами труп вяло передвигается между двумя плитами. Номер «506» вышит у него на лбу... и на боку шеи... и на правой руке... В сущности, у этого трупа так много швов, что его кожа выглядит как причудливая карта улиц.~
@45420 = ~Осмотреть швы.~
@45421 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45422 = ~Использовать на трупе свою способность «История костей».~
@45423 = ~«Было приятно с тобой поболтать. Прощай».~
@45424 = ~Оставить зомби в покое.~
@45425 = ~Труп самозабвенно смотрит вперед.~
@45426 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@45427 = ~Швы опоясывают тело, пробегая по рукам через весь торс наверх по шее и скрываясь в копне белых волос. Проходя по пересечениям швов, ты замечаешь, что кто-то приколол иголку ко лбу... в иглу вдета нить, которая выходит из шва на черепе. Ты мог бы вытащить ее, если бы у тебя было что-нибудь, чтобы разрезать нить. ~
@45428 = ~Ты аккуратно срезаешь нить с помощью скальпеля, а затем выдергиваешь иголку, распуская швы. Кожа на лбу отваливается, обнажая белый как мел череп. К твоему удивлению, на нем выбит номер «78».~
@45429 = ~Этот покрытый швами труп вяло передвигается между двумя плитами. Хотя по всему телу у него вышит номер «506», в месте, где кожа отвалилась ото лба, на кости выбит номер «78». ~
@45430 = ~Этот человек выглядит очень занятым, расхаживая между коробками, подсчитывая их и записывая результат на кусок пергамента. Он недоволен тем, что ты его прерываешь. «Чего опять? Ты что, не видишь, что я занят важными вещами? Иди отвлекай кого-нибудь еще». ~
@45431 = ~«Я не хотел отвлекать. Прощай».~
@45432 = ~«Опять ты! Кажется, я уже говорил тебе не отвлекать меня».~
@45433 = ~«Мне сказали доставить тебе эту шкатулку».~
@45434 = ~«Я не хотел отвлекать. Прощай».~
@45435 = ~«Ну что же ты тогда сразу не сказал? Давай-ка посмотрим, что там у тебя для меня. Уверен, что ее нужно записать».~
@45436 = ~~
@45437 = ~«Мар сказал мне, чтобы я доставил тебе вот это».~
@45438 = ~Интерес на лице Куатраа сменяется диким ужасом, когда ты протягиваешь ему шкатулку. «Нет! Пожалуйста... убери это от меня!»~
@45439 = ~«Не понимаю... почему ты так боишься этой шкатулки?»~
@45440 = ~«Я сказал... п-п-проваливай! Смерть... зло... хотел п-п-провести Мара... не мог больше это вытерпеть. Пожалуйста... отдай это Браскену... он живет на юго-западе... в Улье... я... неееет!» Похоже, одного только вида шкатулки было достаточно, чтобы он с воплями выбежал из здания.~
@45441 = ~«Стой. Что я должен... сделать... с...» ~
@45442 = ~Браскен громким, оглушающим голосом задает вопрос: «Во имя бездны, что ты делаешь в моем доме?! Уходи, пока я не сделал тебя еще уродливее».~
@45443 = ~«Меня попросили доставить тебе эту шкатулку».~
@45444 = ~~
@45445 = ~«Прощай».~
@45446 = ~«Что?! Опять ты! Если ты здесь не по делу, советую немедленно покинуть мой дом».~
@45447 = ~«Мне сказали доставить тебе эту шкатулку».~
@45448 = ~«Прошу прощения, ошибся домом. Я уже ухожу».~
@45449 = ~«Исчезни, дурак! Я уже все сказал тебе о шкатулке Моридора».~
@45450 = ~«Прощай».~
@45451 = ~«По Улью ходят слухи, что какой-то рубака смог убить демона, сидевшего в шкатулке Моридора. Говорят, что битва с этим демоном оставила на его теле ужасные шрамы. Случаем, не ты ли тот рубака?»~
@45452 = ~«Ну да. А кто еще, по-твоему, смог бы сделать такое?»~
@45453 = ~Грохочущий хохот. «Твоя наглость сравнится лишь с твоей смелостью! Мне это нравится. Ты станешь легендой, когда о тебе разойдется народная молва. Позволь мне первым поздравить тебя. Заходи... выпьем вместе, расскажешь мне о своих похождениях».~
@45454 = ~«Буду рад пропустить с тобой пару кружек».~
@45455 = ~«Может, в другой раз. У меня еще много дел. Прощай».~
@45456 = ~«О, великий рубака вернулся. Не хочешь выпить? Мне бы очень хотелось послушать о твоих героических подвигах».~
@45457 = ~«Буду рад пропустить с тобой пару кружек».~
@45458 = ~«Может, в другой раз. У меня еще много дел. Прощай».~
@45459 = ~После нескольких кружек, песен и шуток Браскен тебе окончательно понравился. Фактически, в таком состоянии тебе бы понравился любой. Вскоре Браскен, пьяный вдрызг, сваливается на пол. Ты понимаешь, что пора уходить. ~
@45460 = ~«Прощай».~
@45461 = ~«Ох, моя голова! Мне кажется, это никогда не пройдет».~
@45462 = ~Оставить Браскена наедине с его головной болью.~
@45463 = ~«Ну чего же ты молчал? Давай ее сюда и можешь идти». Когда ты протягиваешь шкатулку Браскену, его выражение лица медленно меняется с предвкушающего в удивленное. «Ого! Нет, я не попадусь на эту уловку во второй раз. Забирай ее обратно и проваливай». ~
@45464 = ~«Я не понимаю, почему никто не хочет брать эту шкатулку? Сначала Куатраа, теперь ты».~
@45465 = ~«Ты сказал — Куатраа? — Браскен разразился громким хохотом. — Ну да, этот приятель и купил шкатулку у меня. Наверное, думал, что обставил меня на этой покупке. Готов поспорить, он думал, что один только камень из нее стоит гораздо дороже, чем он мне за нее заплатил. Бедняга, он даже не мог себе представить, во что вляпался, пока не стало слишком поздно».~
@45466 = ~«Да что такого ужасного в этой шкатулке?»~
@45467 = ~«То есть ты ничего не знаешь об этой шкатулке? Ну что ж, думаю, что хуже от того, что я скажу, тебе уже не будет. Для начала, чтобы ты там чего не надумал, проклятие этой шкатулки действует только на текущего владельца шкатулки, а чтобы им стать, нужно взять ее по доброй воле».~
@45468 = ~«Значит, просто выбросить эту шкатулку, пока кто-нибудь не найдет ее, не получится... а что в шкатулке?»~
@45469 = ~«А вот это хороший вопрос. Эта шкатулка появилась в Улье в стародавние времена. О ней витает много слухов. Ты ведь понимаешь, что при каждом пересказе истории истина искажалась все сильнее».~
@45470 = ~«Продолжай».~
@45471 = ~«Я слышал много историй об этой шкатулке, и все вокруг одно и той же темы. Эту вещицу люди назвали шкатулкой Моридора. Владелец шкатулки умирал, если он или кто-то другой открывал ее. Что касается содержимого, кто знает? Кто-то говорит, что там древний дракон, а кто-то — что злобная душа самого Моридора — я не могу сказать точно. Но уже просто взглянув на нее, любой скажет, что в ней что-то плохое, и будет глупо ее открывать».~
@45472 = ~«И что мне теперь делать с ней?»~
@45473 = ~«Я бы посоветовал тебе повидаться с Шиландрой. Она живет в северо-восточной части Улья. У нее я и 'выиграл' эту шкатулку. Кто знает, может, она знает больше о том, что с ней делать. Или ты можешь найти какого-нибудь пустоголового пня, который согласится взять ее у тебя. Тебе решать. Удачи».~
@45474 = ~«Прощай».~
@45475 = ~«Повсюду эта новость! Поздравляю, ты уничтожил проклятие шкатулки Моридора. Признаться, я немного сомневался в том, что такой уродливый пень как ты сможет сделать подобное. Не забывай, что я все еще считаю тебя уродливей задницы баку... но я уважаю то, что тебе удалось сделать. Заходи, выпей со мной, расскажешь, как это тебе удалось».~
@45476 = ~«Буду рад пропустить с тобой пару кружек».~
@45477 = ~«Может, в другой раз. У меня еще много дел. Прощай».~
@45478 = ~Оставить зомби в покое.~
@45479 = ~Оставить зомби в покое.~
@45480 = ~Разрезать швы скальпелем, затем вытащить иголку с ниткой. ~
@45481 = ~«Хм-м. Возможно, здесь есть что-нибудь, чем я смог бы срезать нитку... Я еще вернусь».~
@45482 = ~Снова осмотреть труп. ~
@45483 = ~Оставить труп в покое.~
@45484 = ~«Похоже, у тебя два разных обозначения, труп».~
@45485 = ~Нечистый дух из шкатулки Моридора~
@45486 = ~Нечистый дух из шкатулки Моридора~
@45487 = ~«Добро пожаловать в собор Аоскара. Ты пришел воздать хвалу Аоскару вместе со мной? Ты можешь стать вторым его последователем».~
@45488 = ~«Я пришел за советом по поводу шкатулки с нечистью».~
@45489 = ~«Почему здесь нет других последователей Аоскара?»~
@45490 = ~«Расскажи мне об Аоскаре побольше».~
@45491 = ~«Я хочу стать последователем Аоскара».~
@45492 = ~«Возможно, в другой раз. Прощай».~
@45493 = ~«Заблудшая душа вернулась. Так поблагодарим же Аоскара и воспоем твое возвращение. Надеюсь, ты все хорошо обдумал и решил присоединиться к моей пастве».~
@45494 = ~«Я пришел за советом по поводу шкатулки и демона».~
@45495 = ~«Какая еще паства? Я вижу здесь только тебя».~
@45496 = ~«Похоже, у тебя два разных обозначения, труп».~
@45497 = ~«Расскажи мне об Аоскаре побольше».~
@45498 = ~«Я хочу стать последователем Аоскара».~
@45499 = ~«Возможно, в другой раз. Прощай».~
@45500 = ~«Да вознаградит тебя Аоскар безопасной дорогой. Чем я могу помочь тебе?»~
@45501 = ~«Я хотел бы купить у тебя тот камень, который ты извлек из шкатулки Моридора».~
@45502 = ~«Похоже, у тебя два разных обозначения, труп».~
@45503 = ~«Расскажи мне об Аоскаре побольше».~
@45504 = ~«Почему здесь нет других последователей Аоскара?»~
@45505 = ~~
@45506 = ~«Я хочу стать последователем Аоскара».~
@45507 = ~«Что произошло? Не успел я и минуты побыть последователем, как вдруг оказываюсь в каком-то 'лабиринте'».~
@45508 = ~«Похоже, у тебя два разных обозначения, труп».~
@45509 = ~«На этот раз ничего. Прощай».~
@45510 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45511 = ~«Ты вернулся! Прошу прощения за мое удивление, но ты — первый последователь, который вернулся. Большинство просто исчезает. Чем я могу тебе помочь?»~
@45512 = ~Использовать на трупе свою способность «История костей».~
@45513 = ~«Было приятно с тобой поболтать. Прощай».~
@45514 = ~Оставить зомби в покое.~
@45515 = ~Этот труп, номер «985», встал как вкопанный; судя по состоянию его левой ноги, похоже, что его колено сгнило либо изъедено трупной плесенью. Труп неуверенно качается вперед и назад, пытаясь сохранить равновесие.~
@45516 = ~Толкнуть труп.~
@45517 = ~Толкнуть труп.~
@45518 = ~Помочь трупу остаться в равновесии.~
@45519 = ~Помочь трупу остаться в равновесии.~
@45520 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45521 = ~Использовать на трупе свою способность «История костей».~
@45522 = ~«Было приятно с тобой поболтать. Прощай».~
@45523 = ~Оставить труп в покое.~
@45524 = ~Труп самозабвенно смотрит вперед, не подавая никаких признаков того, что он тебя услышал.~
@45525 = ~Оставить труп в покое.~
@45526 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@45527 = ~Оставить труп в покое.~
@45528 = ~В левой ноге трупа раздается хруст, и тело падает, как срубленное дерево. Туловище ударяется о каменные плиты и раскалывается, как гнилая дыня; гной, булькая, вытекает из трещин. К твоему удивлению, никто даже не заметил падения мертвеца... и что еще более странно, левая нога продолжает стоять там, где стояло тело, словно по стойке «смирно». Спустя мгновенье, нога падает с сочным гулким ударом.~
@45529 = ~~
@45530 = ~Ты тянешься к левой руке трупа, желая помочь ему устоять. Но когда ты хватаешься за его руку, труп неожиданно кренится вправо, и ты скорее тянешь его, чем помогаешь удержаться...~
@45531 = ~Похоже, кто-то заменил этому трупу левую руку и ногу от другого тела. Левая нога короче, чем надо, но теперь, по крайней мере, труп может стоять.~
@45532 = ~«Извини, что сбил тебя с ног. Я случайно».~
@45533 = ~«Извини, что сбил тебя с ног. Я случайно».~
@45534 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@45535 = ~Использовать на трупе свою способность «История костей».~
@45536 = ~«Было приятно с тобой поболтать. Прощай».~
@45537 = ~Оставить труп в покое.~
@45538 = ~Ты тянешься к левой руке трупа, желая помочь ему устоять. Но когда ты хватаешься за его руку, труп неожиданно кренится вправо, и ты скорее тянешь его, чем помогаешь удержаться...~
@45539 = ~«Ой-ой...»~
@45540 = ~«Э... шеф... осторож...»~
@45541 = ~Ты видишь шумного румяного мужчину. Он кричит, да и вообще ведет себя так, как будто вот-вот начнется война, как будто у него что-то в кишках застряло, как будто... в общем, как будто он слишком возбужден, чтобы говорить обычным тоном.~
@45542 = ~Ты видишь шумного румяного мужчину. Он кричит, да и вообще ведет себя так, как будто вот-вот начнется война, как будто у него что-то в кишках застряло, как будто... в общем, как будто он слишком возбужден, чтобы говорить обычным тоном.~
@45543 = ~Ты видишь шумного румяного мужчину. Он кричит, да и вообще ведет себя так, как будто вот-вот начнется война, как будто у него что-то в кишках застряло, как будто... в общем, как будто он слишком возбужден, чтобы говорить обычным тоном.~
@45544 = ~Ты видишь шумного румяного мужчину. Он кричит и вообще ведет себя так, как будто вот-вот должна нагрянуть война, как будто у него что-то в кишках застряло, как будто... в общем, как будто он слишком возбужден, чтобы говорить обычным тоном. Его скорострельная манера разговора не дает его толком понять. «Вы, сэр, да, вы! Вам, кажется, что-то нужно! Я пока не уверен, что именно, но погодите, погодите минутку — и я мигом это выясню! Вам нужна комната? У меня есть комнаты! Вам нужны припасы? У меня есть припасы!»~
@45545 = ~«Что ты продаешь?»~
@45546 = ~«Сначала у меня несколько вопросов к тебе».~
@45547 = ~«Я хотел бы кое-что тебе продать».~
@45548 = ~«Спасибо за уделенное время, и все же... прощай».~
@45549 = ~Его скорострельная манера разговора не дает его толком понять. «Вы, сэр, да, вы! Вам, кажется, что-то нужно! Я пока не уверен, что именно, но погодите, погодите минутку — и я мигом это выясню! Вам нужна комната? У меня есть комнаты! Вам нужны припасы? У меня есть припасы!»~
@45550 = ~«Что ты продаешь?»~
@45551 = ~«Сначала у меня несколько вопросов к тебе».~
@45552 = ~«Я хотел бы кое-что тебе продать».~
@45553 = ~«Спасибо за уделенное время, и все же... прощай».~
@45554 = ~«Все, чего пожелаете, дружище! Время — деньги, так что давайте побыстрее!» ~
@45555 = ~«Я ищу летающий череп. Его у меня украли. Ты не знаешь, где мне его найти?»~
@45556 = ~«Расскажи мне об этом Повелителе Костей...»~
@45557 = ~«Кто ты и чем занимаешься?»~
@45558 = ~«Что это за место? Что ты можешь рассказать об этом районе?»~
@45559 = ~«Что ты можешь сказать о боголюдях?»~
@45560 = ~«Тут не найдется для меня работенки?»~
@45561 = ~«Объявление распечатано».~
@45562 = ~«Послание доставлено».~
@45563 = ~«Листок висит в Тлеющем трупе».~
@45564 = ~«У тебя найдется еще какая-нибудь работенка для меня?»~
@45565 = ~«Что ты продаешь?»~
@45566 = ~«Я хотел бы кое-что тебе продать».~
@45567 = ~«Забудь. Прощай».~
@45568 = ~«Тогда вы говорите с тем, с кем надо! Я продаю, я покупаю, я сдаю комнаты! Я могу достать вам почти что угодно! Что у вас?»~
@45569 = ~«У меня есть каменный лим-лим. Что ты мне за него дашь?»~
@45570 = ~«У меня есть каменный лим-лим. Что ты мне за него дашь?»~
@45571 = ~«Давай поторгуем».~
@45572 = ~«У тебя не найдется работы?»~
@45573 = ~«Объявление распечатано».~
@45574 = ~«Послание доставлено».~
@45575 = ~«Листок висит в Тлеющем трупе».~
@45576 = ~«У тебя найдется еще какая-нибудь работенка для меня?»~
@45577 = ~«Думаю, пока ничего. Ответь на пару вопросов...»~
@45578 = ~«Пока ничего. Прощай».~
@45579 = ~«Снова! Снова! Вы пришли ко мне снова! Должно быть, я могу сделать для вас то, что не по силам моему брату Дерану, а? Ха!»~
@45580 = ~«Я хотел бы кое-что купить».~
@45581 = ~«У меня есть вопросы к тебе».~
@45582 = ~«Я хочу поторговать».~
@45583 = ~«У тебя не найдется какой-нибудь работы?»~
@45584 = ~«Объявление распечатано».~
@45585 = ~«Послание доставлено».~
@45586 = ~«Листок висит в Тлеющем трупе».~
@45587 = ~«У тебя найдется еще какая-нибудь работенка для меня?»~
@45588 = ~«Прощай».~
@45589 = ~Его лицо мрачнеет. «Я могу сказать вам пароль и где его использовать. Как вам такое?»~
@45590 = ~«Скажи мне пароль».~
@45591 = ~«Ты не мог бы просто дать мне вместо этого денег?»~
@45592 = ~«Пока ничто из этого мне не подходит. Лучше ответь на пару вопросов».~
@45593 = ~«Меня это не интересует. Прощай».~
@45594 = ~«Могу дать за это семьдесят пять монет. Дружище, соглашайтесь либо отказывайтесь!»~
@45595 = ~«Я согласен. И еще ответь мне на пару вопросов...»~
@45596 = ~«Я отказываюсь. Ответь еще на пару вопросов..»~
@45597 = ~«Я согласен. Прощай».~
@45598 = ~«Я отказываюсь. Прощай».~
@45599 = ~«Я пришел за советом по поводу шкатулки и демона».~
@45600 = ~«Я хотел бы купить у тебя тот камень, который ты извлек из шкатулки Моридора».~
@45601 = ~«Расскажи мне об Аоскаре побольше».~
@45602 = ~«Что произошло? Не успел я и минуты побыть последователем, как вдруг оказываюсь в каком-то 'лабиринте'».~
@45603 = ~«На этот раз ничего. Прощай».~
@45604 = ~Похоже, Аола впал в глубокий транс. Единственное, что ты можешь от него услышать — это песнопения во славу Аоскара.~
@45605 = ~«Прощай».~
@45606 = ~Ты объясняешь ему свое затруднительное положение. Аола некоторое время обдумывает услышанное. «Я, скромный служитель великого Аоскара, воистину могу тебе помочь. Но прежде ты должен отдать мне шкатулку».~
@45607 = ~Отдать ему шкатулку.~
@45608 = ~Аола помещает шкатулку Моридора в проволочную пирамидку, затем начинает тихо молиться Аоскару. Вскоре стороны пирамидки заполняет уже знакомое свечение портала. Аола небрежно протягивает к шкатулке руку сквозь портал и с легким щелчком открывает ее.~
@45609 = ~Продолжить.~
@45610 = ~Ты вскрикиваешь, пытаясь помешать ему, но уже слишком поздно. Почти сразу же шкатулка начинает превращаться в блеклый дым, который постепенно заполняет всю пирамидку. Комнату охватывает ощущение немыслимого ужаса. Все, что тебе остается — бежать изо всех сил из помещения.~
@45611 = ~Продолжить.~
@45612 = ~Ты замечаешь, что завитки дыма, касающиеся сторон пирамиды, исчезают в кружащемся водовороте порталов. С последним завитком исчезает и ощущение ужаса. Аола немного нервно улыбается тебе. «Узри силу Аоскара, Хранителя Врат!»~
@45613 = ~«Уверен, что настолько могущественный нечистый дух, на заточение которого понадобилось так много заклинаний, без проблем сможет вернуться. И когда он это сделает, она будет искать тебя...»~
@45614 = ~Он ловко выхватывает у тебя окаменевшего лим-лима и шепчет тебе на ухо: «Пароль — 'затмение'. Он даст тебе доступ на склад Хранилище Девятого мира. Там находятся анархисты. Скажи им пароль, но не говори, кто тебе его сказал!»~
@45615 = ~«Я предусмотрел это. Каждая сторона пирамиды содержит портал на другой план. Я разбросал его сущность по самым удаленным уголкам мультивселенной. Знаешь ли ты, что некоторые существа считают демонов чем-то вроде деликатесов?» Сдавленно хихикая, он засовывает руку внутрь шкатулки и извлекает из пепла драгоценный камень, ранее инкрустированный в шкатулку. «Это воздаяние за мои услуги. Он поможет мне отстроить заново мой прекрасный собор».~
@45616 = ~«'Затмение'. Понятно. У меня еще вопросы...»~
@45617 = ~«Камень твой; ты заслужил его по праву. Прощай».~
@45618 = ~«Много лет назад у меня было много последователей. К сожалению, все они исчезли. Это довольно печально. Едва став посвященными, они пропадают. Позже начали ходить слухи, что причиной тому является сама Леди. И теперь сюда больше никто не приходит. Ты — первый, кого я вижу за последнее время».~
@45619 = ~«Я не боюсь. Я хочу стать последователем Аоскара».~
@45620 = ~«Расскажи мне об Аоскаре побольше».~
@45621 = ~«Леди... Я не хочу встречаться с ней. Лучше я пойду своей дорогой. Прощай».~
@45622 = ~«'Затмение'. Понятно. Прощай».~
@45623 = ~Тон Аолы становится льстивым. «Аоскар — Хранитель Врат. В Аоскаре заключается сила порталов, дверей и возможностей. Сигил, известный также как Город Дверей, был домом Аоскара до тех пор, пока он не был 'изгнан' этой проклятой Леди. С тех пор у Аоскара осталось здесь всего несколько поклонников, поскольку Леди запрещает это. Но скоро все изменится, я помогу людям узреть величие Аоскара. Она не сможет устоять перед волей народа!»~
@45624 = ~«Я хочу стать последователем Аоскара».~
@45625 = ~«Значит, череп? Да? Ха! Такими вещами торгуют только в одном месте из всех, что я знаю! Но... — он понижает тон. — Я не могу указать вам, где он... если только...»~
@45626 = ~«Почему здесь нет других последователей Аоскара?»~
@45627 = ~«Если только?»~
@45628 = ~«Забудь. Лучше ответь на пару вопросов...»~
@45629 = ~«Леди... Я не хочу встречаться с ней. Лучше я пойду своей дорогой. Прощай».~
@45630 = ~«Забудь. Прощай».~
@45631 = ~«Замечательно! Давно уже никто этого не просил». Аола заставляет тебя провести серию сложных ритуалов. «Теперь ты последователь Аоскара. Иди и неси слово обитателям Сигила, чтобы все узнали великолепие Аоскара!»~
@45632 = ~«Я не могу сказать вам, дружище, поскольку это поставило бы под угрозу вашу жизнь. Нет, сэр, наши с вами жизни слишком ценны, чтобы распрощаться с ними ради такой ничтожного кусочка информации!»~
@45633 = ~«Тебя заставят передумать десять монет?»~
@45634 = ~«Прощай».~
@45635 = ~«Тебе повезло: я еще не успел его продать. Ты получишь его по сходной цене в триста медяков».~
@45636 = ~«Беру».~
@45637 = ~«Что, если я отдам тебе все, что есть у меня в кошельке?»~
@45638 = ~«Я не могу себе этого позволить».~
@45639 = ~«Это грабеж... Я не стану столько платить».~
@45640 = ~«Что, если я буду тебе угрожать?»~
@45641 = ~«Да озарит тебя своей улыбкой Аоскар, бог порталов, дверей и 'возможностей'».~
@45642 = ~«Тогда забудь. Ответь мне еще на пару вопросов».~
@45643 = ~«Прощай».~
@45644 = ~«Тогда забудь об этом. Прощай».~
@45645 = ~«Это очень печально. Я не могу снизить цену. Заработай больше звенелок и возвращайся. Я буду счастлив придержать камень для тебя».~
@45646 = ~«Прощай».~
@45647 = ~«Ладно, — говорит он. — Слушайте меня, и слушайте внимательно, — он наклоняет голову к твоему уху и громко шепчет. — Только один человек из известных мне смеет торговать подобными оккультными вещами, и с этим человеком лучше не пересекаться! От него веет опасностью, и немногие осмеливаются называть его имя! Я говорю... — он умолкает, чтобы перейти к драматичному шепоту, — о Лотаре, Повелителе Костей!»~
@45648 = ~«Мне очень нужны деньги на ремонт моего собора. Ты еще не передумал? На рынке я могу получить за него как минимум столько же».~
@45649 = ~«Беру».~
@45650 = ~«Это еще кто?»~
@45651 = ~«Забудь об этом».~
@45652 = ~«Повелитель Костей! Хозяин Костей Ночи, владелец самой жуткой коллекции по эту сторону от дома Сета! На его полках лежат черепа, нашептывая свои тайны на ухо Лотару и всем, кто осмелился встретиться с ними. Там можно много о чем узнать... если только это не сведет вас с ума!»~
@45653 = ~«Ты не мог бы перейти к делу?»~
@45654 = ~«Похоже, что ты провалился куда-то через портал. Только опытные последователи Аоскара и сама Леди могут сделать подобное. Это объясняет исчезновение моих последователей. Я должен подумать над этим. Пожалуйста, оставь меня».~
@45655 = ~«И где это находится?»~
@45656 = ~«Что ему нужно от этих черепов?»~
@45657 = ~«Прощай».~
@45658 = ~«Спасибо. У меня есть другие вопросы...»~
@45659 = ~«Спасибо. Прощай».~
@45660 = ~Он прочищает горло. «Прошу прощения, что пытался немного приукрасить это для вас. Просто хотелось добавить немного остроты. Это в направлении от шпиля — там *можно* наткнуться на сгоревший остов дома. *Возможно*, там вы найдете лестницу из человеческих сухожилий, а может, просто деревянную, которая ведет вниз, все ниже и ниже и ниже и ниже, в самое сердце Сигила, и когда вы снова ступите на землю... вы *сможете* встретиться лицом к лицу с самим Лотаром!»~
@45661 = ~«А что он делает с черепами?»~
@45662 = ~«Спасибо. У меня есть другие вопросы...»~
@45663 = ~«Спасибо. Прощай».~
@45664 = ~«Это в направлении от шпиля — там *можно* наткнуться на руины дома. *Возможно*, там вы найдете лестницу из костей, ведущую вниз, в самое сердце Сигила, и эта лестница *может* привести вас в Салон Черепов, где вы встретитесь с самим Лотаром!»~
@45665 = ~«А что он делает с черепами?»~
@45666 = ~«Спасибо. У меня есть другие вопросы...»~
@45667 = ~«Спасибо. Прощай».~
@45668 = ~«Говорят, что мертвые молчат... однако в салоне Лотара мертвые раскрывают свои тайны его усердному уху! Больше мертвецов, больше историй, больше слухов... ну, и больше глаз раскрываются самому сердцу мультивселенной!» Чтобы подчеркнуть это, он водит бровями.~
@45669 = ~::Вздох:: «Спасибо. У меня еще несколько вопросов...»~
@45670 = ~::Вздох:: «Спасибо. Прощай».~
@45671 = ~«Я? Я аукционист Гилтспур, к вашим услугам! Я продаю, я покупаю, я предоставляю услуги и даю работу!»~
@45672 = ~«Я хотел бы кое-что продать».~
@45673 = ~«Я хотел бы кое-что купить».~
@45674 = ~«Как насчет пары вопросов?»~
@45675 = ~«Отлично, спасибо. Прощай».~
@45676 = ~«Это? Ну, это Нижний район! Дом для боголюдей, Великой Литейной и еще великого множества услуг! У нас есть все, что вам нужно!»~
@45677 = ~«Что ты можешь сказать о боголюдях?»~
@45678 = ~«Что ты можешь сказать о Литейной?»~
@45679 = ~«Ответь еще на пару вопросов...»~
@45680 = ~«Спасибо. Прощай».~
@45681 = ~«О, это группа людей, близкая мне по духу. Они говорят, что все мы сами себе боги, что в нашем духе заложена потенциальная божественность. От мелкого попрошайки и до великого царя — все мы лелеем богов в нашей груди! Кто бы мог придумать что-нибудь лучше?»~
@45682 = ~«Гармониум».~
@45683 = ~«Анархисты».~
@45684 = ~«Чувствующие».~
@45685 = ~«Тленные».~
@45686 = ~«Убийцы милосердия».~
@45687 = ~«Ага, неплохо! Хороший ответ!» Он хихикает.~
@45688 = ~«У меня еще вопросы...»~
@45689 = ~«Спасибо. Прощай».~
@45690 = ~«Для меня Литейная — не что иное как возможность! Место, где каждый может проверить свой характер металлом, место, где души нагреваются до предела и закаляются в воде знаний... или раскалываются о наковальню истины! — ненадолго тон его голоса приходит в норму. — Во всяком случае, так говорят боголюди».~
@45691 = ~«Что ты можешь сказать о боголюдях?»~
@45692 = ~«У меня есть другие вопросы...»~
@45693 = ~«Спасибо. Прощай».~
@45694 = ~«Несомненно, дружище! У меня есть для вас небольшое поручение, если вы за него возьметесь! Это принесет вам пятьдесят монет! Все, что нужно сделать — это отнести это объявление в типографию и попросить Нарушителя Пенна напечатать для меня сотню копий! Вот! Держите!» Он сует тебе в руку мятый листок бумаги.~
@45695 = ~«Хорошо. У меня есть другие вопросы».~
@45696 = ~«Что ж, спасибо. Прощай».~
@45697 = ~«Распечатано? Отлично! Я знал, что вы годитесь для этого дела! Вот, передайте это послание Кельдору Дурианскому в Литейной. Уверен, он будет рад его получить, а вы будете рады сотне монет, которую вы получите по возвращению».~
@45698 = ~«Хорошо. У меня есть другие вопросы».~
@45699 = ~«Что ж, спасибо. Прощай».~
@45700 = ~«Это было весьма быстро, не правда ли? Благодарю вас, дружище. Для вас еще одно задание за немалую сумму в двести монет! Просто отнесите этот рекламный листок Баркису в Тлеющий труп и попросите его где-нибудь его вывесить. Он мой старый друг, так что будет ему рад!»~
@45701 = ~«Хорошо. У меня есть другие вопросы».~
@45702 = ~«Что ж, спасибо. Прощай».~
@45703 = ~«Тогда, мой друг, у меня больше нет для вас работы. Благодарю вас!» Он поворачивается к толпе и начинает раззадоривать ее.~
@45704 = ~«У меня еще вопросы...»~
@45705 = ~«Тогда прощай». ~
@45706 = ~«Прошу прощения, дружище. У меня ничего больше нет... вы выполнили все мои поручения!» Он смеется.~
@45707 = ~«Тогда, может, ты мог бы ответить еще на несколько вопросов?..»~
@45708 = ~«Ну, тогда спасибо. Прощай».~
@45709 = ~«О-о, аукцион! Может, продадим здесь Анну».~
@45710 = ~«О-о, аукцион! Может, продадим здесь Даккона».~
@45711 = ~«О-о, аукцион! Может, подыщем мне здесь тело».~
@45712 = ~«Хорошо, Морт. Я не забуду об этом спросить».~
@45713 = ~«Тогда давай уходить отсюда».~
@45714 = ~«Должно быть, это любовь. Это ведь любовь, да, босс?»~
@45715 = ~«Прекратите, вы оба. Мне нужно задать несколько вопросов».~
@45716 = ~«Как скажешь, Морт. Давай оставим в покое этого парня».~
@45717 = ~В отличие от других сборщиков, одежды этого отличного качества. «А, еще один мертвец нанес нам визит. Прошу прощения за этот *беспорядок*. У моих коллег нет времени на уборку».~
@45718 = ~«Отсюда нет выхода...»~
@45719 = ~Власк сдавленно хихикает. «Снова ты! У меня и моих друзей очень мало постоянных клиентов. Перейдем сразу к делу: теперь цена составляет двести медяков за ключ».~
@45720 = ~«Я вернулся, чтобы убить тебя».~
@45721 = ~«Выпустить бы тебе кишки, череп, да нет их у тебя».~
@45722 = ~«Возьми деньги».~
@45723 = ~«У меня нет столько».~
@45724 = ~«Отчего же, есть. Дверь находится прямо здесь. Вот только тебе понадобится вот это, чтобы активировать портал». В руке он держит нечто, похожее на маленькую стеклянную бусину. «А теперь поговорим о цене».~
@45725 = ~«Лучше я тебя просто убью».~
@45726 = ~«Я слушаю».~
@45727 = ~«Все просто. Ты платишь мне и моим товарищам сто медяков. Я даю тебе ключ к порталу».~
@45728 = ~«А что, если я не хочу платить?»~
@45729 = ~«Вот деньги. Давай ключ».~
@45730 = ~Губы Даккона становятся еще тоньше, но он не отвечает.~
@45731 = ~«Прекрати, Морт. Мне нужно задать здесь пару вопросов».~
@45732 = ~«У меня нет столько».~
@45733 = ~«Давай тогда просто уйдем, ладно?»~
@45734 = ~«Тогда я и мои друзья просто продадим твое тело тленным. Так или иначе, мы свое получим».~
@45735 = ~«Лучше я тебя убью».~
@45736 = ~«Вот деньги. Давай ключ».~
@45737 = ~«У меня нет столько».~
@45738 = ~«Я со своими товарищами рад иметь дело с тобой. Просто раздави стеклянную бусину — и портал откроется».~
@45739 = ~«Прощай».~
@45740 = ~«Как жаль. Ребята, приготовьте этого для тленных».~
@45741 = ~«Приготовься к смерти...»~
@45742 = ~«Проклятие! На этот раз я почти-что сделала это. Разве ты не знаешь, что очень опасно прерывать заклинателей во время произношения заклинаний? Хорошо, что я просто тренировалась. Что тебе надо?»~
@45743 = ~«Я хочу узнать побольше об этой шкатулке».~
@45744 = ~«Прошу прощения за беспокойство. Прощай».~
@45745 = ~«Еще один обрыв! Теперь никто не может уединиться, даже в своем доме. Пожалуйста, уходи, пока я не позвала стражников... или нет, лучше я испробую мое новое заклинание на тебе». ~
@45746 = ~Этот тяжелый додекаэдр (размером с твои кулаки, сложенные вместе) кажется тебе необъяснимо знакомым. На ощупь он холодный и гладкий, но ты не можешь определить, металл это или камень. От этого предмета исходит некое неосязаемое «напряжение», как будто он в любой момент может выпрыгнуть из рук.~
@45747 = ~Внимательно осмотреть додекаэдр.~
@45748 = ~«Я хочу узнать побольше об этой шкатулке».~
@45749 = ~«Прошу прощения за беспокойство. Прощай».~
@45750 = ~«Ты уже и так отнял у меня много времени. Пожалуйста, уходи». ~
@45751 = ~Уйти.~
@45752 = ~«По Улью ходят слухи, что ты убил нечистого, который был заключен в шкатулке Моридора. Ты случайно не оставил какие-нибудь его части?»~
@45753 = ~«Кем ты являешься, раз собираешь подобные вещи?»~
@45754 = ~«Э... нет, не думал об этом». ~
@45755 = ~«Ходят слухи, что тебе удалось уничтожить шкатулку Моридора. Позволь мне тебя поздравить с этим. Но все же очень жаль, что я не сумела разгадать все заклинания, которые были использованы для заключения нечистого духа».~
@45756 = ~«Прощай».~
@45757 = ~Ты протягиваешь Шиландре шкатулку Моридора. «Ах да! Я хорошо помню эту шкатулку. Она однажды была моей. Что ты хочешь знать о ней?»~
@45758 = ~«Кто тебе ее дал?»~
@45759 = ~«Похоже, ты разбираешься в магии. Можешь сказать, что за заклинания наложены на эту шкатулку?»~
@45760 = ~«Ты знаешь историю этой шкатулки?»~
@45761 = ~«Что ты еще хочешь узнать?»~
@45762 = ~«Где ты ее нашла?»~
@45763 = ~«Похоже, ты разбираешься в магии. Можешь сказать, что за заклинания наложены на эту шкатулку?»~
@45764 = ~«Ты можешь снять заклинания с этой шкатулки?»~
@45765 = ~«Ты знаешь историю этой шкатулки?»~
@45766 = ~«Есть ли какой-нибудь способ избавиться от шкатулки Моридора, не причинив никому вреда?»~
@45767 = ~«Хм-м... Дай подумать. Я не помню, у кого я ее взяла. Помню только, что пошла на рынок для каких-то ингредиентов для заклинаний, когда кто-то предложил мне эту шкатулку. Осмотрев ее, я обнаружила, что она проклята, но я была заинтригована заклинаниями, наложенными на нее, и решила купить ее любой ценой».~
@45768 = ~«Если ты была так заинтригована этой шкатулкой, почему же ты решила от нее избавиться?»~
@45769 = ~«Я хотел бы задать другие вопросы...»~
@45770 = ~«Несколько лет я изучала шкатулку, пытаясь постичь ее секреты. На нее было наложено заклятие, на которое было наложено еще одно, а на него, в свою очередь, — третье. К моему удивлению, мои исследования показали, что все они являются заклинаниями для заточения нечисти».~
@45771 = ~«Нечисти? То есть, ты имеешь в виду, что в этой шкатулке заключены демоны?..»~
@45772 = ~«Нет! Не нечисти. Одного нечистого духа. И, судя по сложности и силе этих заклинаний, он является одним из самых сильных и значимых демонов в своем мире».~
@45773 = ~«Я хотел бы задать другие вопросы...»~
@45774 = ~«Значит, хочешь отделаться от этой шкатулки? Это заклинание — самое наихудшее из всех. Проще говоря, данное заклинание высасывает энергию из текущего владельца шкатулки и использует ее для подпитки одного из заклинаний заточения. Но это еще не самое худшее. Нечистый внутри способен чуять эту энергию и, скорее всего, выбравшись, будет охотиться на владельца. Владелец шкатулки всегда в проигрыше. Либо она высосет из тебя всю энергию, либо нечистый, сидящий внутри, убьет тебя».~
@45775 = ~«Понятно. Не против, если я задам тебе еще несколько вопросов...»~
@45776 = ~«Я была молодой и к тому же искала приключения на свою голову. Со своей ненасытной жаждой знаний я неосмотрительно сняла одно из заклинаний. Пристально осмотрев шкатулку еще раз, я поняла, что она теперь совершенно другая. Признаки разложения свидетельствовали о том, что заклинания слабеют. Я поняла, что если буду хранить эту шкатулку у себя, то окажусь в большой опасности. Поэтому, чтобы избавиться от нее, я объявила соревнование».~
@45777 = ~«Соревнование?»~
@45778 = ~«Я хотел бы задать другие вопросы...»~
@45779 = ~«Это был самый целесообразный способ отделаться от нее. Я просто созвала всех громил с Улья состязаться между собой, чтобы определить, кто из них самый лучший. У вояк ведь обычно большие мускулы, а вот с котелком не все так гладко, если ты понимаешь, о чем я. Вот они и налетели, как мухи на мед. Я предложила немного денег и шкатулку в качестве приза. Если не ошибаюсь, тогда в этом соревновании победил какой-то громила по имени Браскен».~
@45780 = ~«Я хотел бы задать другие вопросы...»~
@45781 = ~«Единственное, что мне удалось узнать, — это ее имя. Шкатулка Моридора. Кто такой Моридор и откуда появилась эта шкатулка — мне неизвестно».~
@45782 = ~«Я хотел бы задать другие вопросы...»~
@45783 = ~«Я недостаточно сильна для того, чтобы сразиться с подобным существом или изгнать его. Давно это было, но раньше посреди переулка Опасных углов стоял собор. Тебе может помочь жрец или кто-нибудь, способный черпать свою силу из более высокого источника».~
@45784 = ~«Ты мне очень помогла. Спасибо».~
@45785 = ~«Боюсь, что непосвященным в искусство магии это недоступно. Некоторые части очень ценны в качестве ингредиентов для создания заклинаний. Прошу прощения, но мне нужно попрактиковаться с этим заклинанием еще немного».~
@45786 = ~«Прощай».~
@45787 = ~«Мне нечего больше сказать тебе».~
@45788 = ~«Прощай».~
@45789 = ~Перед тобой миниатюрный человечек со слегка раскачивающейся походкой. В его говоре слышен почти комический акцент. «Во имя сил в их небесных жилищах, что это?»~
@45790 = ~~
@45791 = ~«Наш покупатель! Наш покупатель! Микка! Наш покупатель вернулся!»~
@45792 = ~~
@45793 = ~Миниатюрный человечек отвечает: «Конечно же, твои глаза видят покупателя! Они все время видят покупателей... покупателей на УЛИЦЕ! У нас нет покупателей, и никогда не будет. Это все тщетно и безнадежно... — он запинается, когда его взгляд натыкается на тебя. — Микка! У нас покупатель!»~
@45794 = ~~
@45795 = ~«Я ВИЖУ. Думаешь, я не вижу? Конечно же, вижу. Разве у меня нет глаз? — он поворачивается к тебе. — Чем мы можем помочь тебе сегодня?»~
@45796 = ~«Давай поговорим о торговле».~
@45797 = ~«Что ты можешь сказать об этом районе?»~
@45798 = ~«Что ты можешь рассказать о себе?»~
@45799 = ~«Кто она?»~
@45800 = ~«Что ты можешь рассказать о фракциях?»~
@45801 = ~«Ничего, спасибо. Прощай».~
@45802 = ~«Конечно, я готов к нему! Я всегда готов! К любому нашему покупателю! — он поворачивается к тебе. — Чем мы можем помочь тебе сегодня?»~
@45803 = ~«Давай поговорим о торговле».~
@45804 = ~«Что ты можешь сказать об этом районе?»~
@45805 = ~«Что ты можешь рассказать о себе?»~
@45806 = ~«Кто она?»~
@45807 = ~«Что ты можешь рассказать о фракциях?»~
@45808 = ~«Ничего, спасибо. Прощай».~
@45809 = ~«О, ты хочешь узнать об этом районе? Я могу рассказать о нем многое. Тут есть на что посмотреть...»~
@45810 = ~~
@45811 = ~«Я? Ты хочешь узнать обо мне? Микка, он хочет узнать обо мне».~
@45812 = ~~
@45813 = ~«Она? Она? Она моя верная жена вот уже сорок лет, она свет в моей жизни и величайший...»~
@45814 = ~~
@45815 = ~«Значит, о фракциях? Фракциях? Микка, он хочет узнать о фракциях. У нас...»~
@45816 = ~~
@45817 = ~«Я собирался рассказать ему о рынке, но теперь я расскажу ему о борделе тебе назло! А потом я расскажу ему о Городском Фестхолле, и даже не упомяну ни о каких других развлечениях!»
Эта парочка скатывается до словесной перепалки, игнорируя тебя.~
@45818 = ~«У меня еще несколько вопросов...»~
@45819 = ~«Я хотел бы кое-что купить...»~
@45820 = ~«Тогда прощай».~
@45821 = ~Они так заняты ссорой между собой, что даже не замечают тебя. Лавка быстро заполняется их словами.~
@45822 = ~Уйти.~
@45823 = ~«Это мне не хватает амбиций? Не хватает амбиций? Если бы у меня не было балласта в виде этой жены и этой жизни, я бы кем-нибудь да стал! Но нет, я лавочник, а не великий путешественник...» Эта парочка скатывается до словесной перепалки, игнорируя тебя.~
@45824 = ~«У меня еще несколько вопросов...»~
@45825 = ~«Я хотел бы кое-что купить...»~
@45826 = ~«Тогда прощай».~
@45827 = ~«...это если бы она уже не была такой! Да она — самая отъявленная пьяница по эту сторону Улья, сэр, и была такой уже многие ГОДЫ, говорю тебе, ГОДЫ. Да если бы река Океанус была из спирта, она бы выпила ее и все равно не напилась!»
Эта парочка продолжает скандалить, игнорирую тебя.~
@45828 = ~«У меня еще несколько вопросов...»~
@45829 = ~«Я хотел бы кое-что купить...»~
@45830 = ~«Тогда прощай».~
@45831 = ~«Я знаю, во что я верю: эта жизнь — мое наказание за что-то, что я натворил в прошлой жизни!»
Эта парочка начинает горячий спор, игнорируя тебя.~
@45832 = ~«У меня еще несколько вопросов...»~
@45833 = ~«Я хотел бы кое-что купить...»~
@45834 = ~«Тогда прощай».~
@45835 = ~«Ее вкусы распространяются на все, что может сделать ее живот еще больше. Все ее вкусы у нее во рту, да и там их у нее немного».~
@45836 = ~~
@45837 = ~Брока вклинивается в разговор и с явной иронией произносит: «Вот я и спрашиваю тебя: как же я тогда могу не ценить рот и фигуру столь прекрасного творения, как это? И правда, нет у меня ни вкуса, ни здравомыслия...»~
@45838 = ~~
@45839 = ~«В это действительно трудно поверить! Столько шансов упущено, а ведь я мог бы так прожить свою жизнь!»~
@45840 = ~~
@45841 = ~«Закрой свой рот! Я мужчина в большей степени, чем ты когда либо была! — он останавливается, еще раз обдумывает свои слова, и критически смотрит на жену. — Хотя нет. Пожалуй, усов у тебя побольше, чем у всех мужиков, что я видел...»~
@45842 = ~~
@45843 = ~«Добро пожаловать в Хранилище Девятого мира! Чем могу быть полезен в этот славный денек, сигилец?»~
@45844 = ~«Что это за место?»~
@45845 = ~«Что ты такое?»~
@45846 = ~«Слышал, тут какие-то проблемы с возвратом вещей».~
@45847 = ~«У меня есть несколько вопросов...»~
@45848 = ~«Дважды добро пожаловать в Хранилище Девятого мира! Чем могу быть полезен в этот славный денек, сигилец?»~
@45849 = ~«Что это за место?»~
@45850 = ~«Что ты такое?»~
@45851 = ~«Я хотел бы кое-что оставить на хранение».~
@45852 = ~«Я хотел бы кое-что забрать».~
@45853 = ~«Слышал, тут какие-то проблемы с возвратом вещей».~
@45854 = ~«Прощай».~
@45855 = ~«Хранилище Девятого мира с радостью служит складом Нижнему району и всем разумным существам Сигила! Наш девиз: 'Когда одного мира мало!' Мы предоставляем складское пространство тем, кому его не хватает. У нас конкурентные цены! У нас образцовое обслуживание! А наша учтивость по отношению к клиентам известна во всех планах!»~
@45856 = ~«Что ты такое?»~
@45857 = ~«Прощай».~
@45858 = ~«Я голос Хранилища Девятого мира. Я здесь, чтобы обслуживать вас, клиент. Скажите, что вам угодно!»~
@45859 = ~«Я хотел бы кое-что оставить на хранение».~
@45860 = ~«Я хотел бы кое-что забрать».~
@45861 = ~«Почему это место названо Хранилищем Девятого мира?»~
@45862 = ~«Это место и в правду велико как мир?»~
@45863 = ~«Неважно. Спасибо».~
@45864 = ~«Если честно — я без понятия! Полагаю, владельцы сочли это подходящим названием, или чем-то в этом роде».~
@45865 = ~«Я хотел бы кое-что оставить на хранение».~
@45866 = ~«Я хотел бы кое-что забрать».~
@45867 = ~«Это место и в правду велико как мир?»~
@45868 = ~«О. Прощай».~
@45869 = ~«Нет, это просто маркетинговое преувеличение. Здесь много места, но не настолько».~
@45870 = ~«Я хотел бы кое-что оставить на хранение».~
@45871 = ~«Я хотел бы кое-что забрать».~
@45872 = ~«Почему это место названо Хранилищем Девятого мира?»~
@45873 = ~«О. Прощай».~
@45874 = ~«Простите! Похоже, на данный момент мы переполнены! Могу ли я что-нибудь еще для вас сделать?»~
@45875 = ~«Я-то думал, что это, должно быть, огромный склад».~
@45876 = ~«Я хотел бы кое-что забрать».~
@45877 = ~«У меня еще несколько вопросов...»~
@45878 = ~«Нет. Прощай».~
@45879 = ~«Разумеется! Что я могу для вас сделать?»~
@45880 = ~«Что это за место?»~
@45881 = ~«Что ты такое?»~
@45882 = ~«Я хотел бы кое-что оставить на хранение».~
@45883 = ~«Я хотел бы кое-что забрать».~
@45884 = ~«Почему это место названо Хранилищем Девятого мира?»~
@45885 = ~«Это место и в правду велико как мир?»~
@45886 = ~«Слышал, тут какие-то проблемы с возвратом вещей».~
@45887 = ~«Неважно. Спасибо».~
@45888 = ~«Ну-у-у... да, — голос головы звучит слегка смущенно. — Только у нас закончилось место, да и вокруг творится что-то подозрительное, сам не знаю что. Суть проблемы такова: на самом деле мы больше не принимаем вещи на хранение».~
@45889 = ~«О. Тогда у меня есть пара вопросов...»~
@45890 = ~«Понятно. Тогда прощай».~
@45891 = ~«И что же в точности вы ищете?»~
@45892 = ~«Я ищу большую сумку с монетами».~
@45893 = ~«Я ищу большую сумку с монетами».~
@45894 = ~«Я здесь, чтобы забрать подушку для Хамриса-гробовщика».~
@45895 = ~«Мне сказали, что здесь я смогу забрать планы гробницы».~
@45896 = ~«Меня попросили передать, что я здесь за ссудой».~
@45897 = ~«Меня попросили передать, что я обставил Пикита».~
@45898 = ~«Меня попросили передать, что я обставил Пикита».~
@45899 = ~«Ничего. Однако у меня есть несколько вопросов...»~
@45900 = ~«Ничего. Прощай».~
@45901 = ~«Да. Мои хозяева тоже очень этим интересуются. Я бы выяснил, но я всего лишь большое заклинание, наложенное на голову! Я понятия не имею, что случилось со всем складским пространством. Сейчас мы открыты — на случай, если кто спросит! У вас не должно быть проблем с тем, чтобы что-нибудь забрать отсюда. Только спросите!»~
@45902 = ~«Тогда ладно. Я хотел бы кое-что забрать».~
@45903 = ~«В таком случае, у меня есть пара вопросов».~
@45904 = ~«Спасибо, так и сделаю. Но позже. Счастливо».~
@45905 = ~«Прощайте! Мы в Хранилище Девятого мира ценим ваш бизнес. Пожалуйста, возвращайтесь».~
@45906 = ~«Да уж, конечно».~
@45907 = ~«Прощай».~
@45908 = ~«Прошу прощения. Пожалуйста, не нападайте на голову».~
@45909 = ~«Ладно. Просто у меня есть несколько вопросов...»~
@45910 = ~«Ладно. Прощай».~
@45911 = ~«Простите, сэр! Эту вещь уже забрали! Не хотите забрать что-нибудь еще?»~
@45912 = ~«Да».~
@45913 = ~«Нет. Просто ответь на пару вопросов».~
@45914 = ~«Нет. Прощай».~
@45915 = ~«У нас есть сумка с монетами, похожая на описанную вами, сэр! Мне нужно узнать у вас только одно: сколько в ней монет?»~
@45916 = ~Почему-то эта сумма кажется верной... «1123 монеты».~
@45917 = ~«Держите, сэр! Спасибо за то, что храните свои вещи в Хранилище Девятого мира! Могу ли я принести вам что-нибудь еще?»~
@45918 = ~Почему-то эта сумма кажется верной... «1123 монеты».~
@45919 = ~Эта пухлая женщина с сердитым взглядом и гнусавым голосом вопит: «И что это тут у нас? Покупатель? Неужто мои глаза видят покупателя?»~
@45920 = ~~
@45921 = ~«Мертвый вернулся. Брока! Мертвый вернулся!»~
@45922 = ~~
@45923 = ~Его партнерша, миниатюрная женщина с неприятным голосом, окидывает тебя быстрым взглядом и отвечает: «Это покупатель, болван. Я уже давно об этом говорила! Я говорила, что у нас будут покупатели, а ты мне не верил — и вот он! Ты готов к нему... к этому ... ну... похожему на мертвеца человеку?»~
@45924 = ~~
@45925 = ~«У меня глаза на месте, как я могу не увидеть? Я вижу его, вижу, и перестань надоедать мне, старый высохший мешок с костями! — она оборачивается к тебе и понижает тон. — Чем тебе может помочь старая Микка?»~
@45926 = ~«Давай поговорим о торговле».~
@45927 = ~«Что ты можешь сказать об этом районе?»~
@45928 = ~«Что ты можешь рассказать о себе?»~
@45929 = ~«Кто он?»~
@45930 = ~Почему-то эта сумма кажется верной... «1123 монеты».~
@45931 = ~«Что ты можешь рассказать о фракциях?»~
@45932 = ~«Ничего, спасибо. Прощай».~
@45933 = ~«Я тебе об этом и говорила! — она понижает голос и поворачивается к тебе. — Чем мы можем тебе помочь?»~
@45934 = ~«Давай поговорим о торговле».~
@45935 = ~«Что ты можешь сказать об этом районе?»~
@45936 = ~«Что ты можешь рассказать о себе?»~
@45937 = ~Угадать: «1000 монет».~
@45938 = ~Угадать: «500 монет».~
@45939 = ~«Кто он?»~
@45940 = ~Угадать: «750 монет».~
@45941 = ~«Что ты можешь рассказать о фракциях?»~
@45942 = ~«Ничего, спасибо. Прощай».~
@45943 = ~Угадать: «331 монета».~
@45944 = ~«Уверена, мой муж будет более чем рад рассказать тебе о Городском Фестхолле и борделе... — она фыркает, — а вот у меня немного другие вкусы...»~
@45945 = ~Угадать: «2112 монеты».~
@45946 = ~~
@45947 = ~«Обо мне? Я прикована, словно к якорю, к этому ломбарду, с мужем, который совершенно меня не ценит...»~
@45948 = ~«Простите, сэр! Должно быть, это не ваша сумка! Могу ли я принести вам что-нибудь еще?»~
@45949 = ~~
@45950 = ~«Ответь мне еще на пару вопросов...»~
@45951 = ~«Он? Это Брока. Он мой муж вот уже сорок лет, хотя, учитывая его непостоянство, трудно поверить, что он не сбился с пути за все это время...»~
@45952 = ~«Нет, спасибо. Прощай».~
@45953 = ~~
@45954 = ~«Подушка? Конечно же, я могу дать вам подушку... большую КАМЕННУЮ подушку! Вот ваша подушка, господин Хамрис, и хорошего вам сна на ней! Могу ли я принести вам что-нибудь еще?»~
@45955 = ~«О фракциях? Фракциях? Ха. Все, что им удалось — это задавить налогами эту бедную лавку чуть ли ни до смерти. Они доведут нас к Улью, а то и к чему похуже, и делают Броку еще меньшим мужчиной, чем он есть...»~
@45956 = ~~
@45957 = ~«Ответь мне еще на пару вопросов...»~
@45958 = ~Микка вмешивается: «И первое что ты вспомнишь, несомненно, будет бордель, бордель для тебя, парень! Постоянно то бордель, то городской Фестхолл, и ни слова о рынке или...»~
@45959 = ~«Нет, спасибо. Прощай».~
@45960 = ~~
@45961 = ~«Он просто старается быть вежливым. Ему наплевать на тебя. Ты все равно ничего путного не скажешь. Ты владелец ломбарда, им и останешься, потому что тебе не хватает амбиций...»~
@45962 = ~«Планы гробницы? Вы не кажетесь мертвым, сэр, хотя если даже это и так, это меня не касается! Вот ваши планы, сэр! Могу ли я принести вам что-нибудь еще?»~
@45963 = ~~
@45964 = ~«...величайший подарок от жизни, правильно? Видишь ли, я спасла его от жизни, которую спланировали ему родители, а он пообещал увести меня от всего этого. И вместо этого, вместо этого он дал мне жизнь, которую ты видишь. Говорю тебе, этого достаточно, чтобы спиться...»~
@45965 = ~«Ответь мне еще на пару вопросов...»~
@45966 = ~~
@45967 = ~«У меня есть уши, и я слышу, что он говорит. Брока не водится с фракциями, потому что они знают, что он не способен держаться какого-либо убеждения настолько долго, чтобы поверить в него».~
@45968 = ~~
@45969 = ~«Я бы добавила 'слишком мало проницательности', потому что я поверила твоим обещаниям будущего, а теперь я...»

Эта парочка начинает бурно ссориться.~
@45970 = ~«У меня еще несколько вопросов...»~
@45971 = ~«Я хотел бы кое-что купить...»~
@45972 = ~«Тогда прощай». ~
@45973 = ~«А я-то думала, что брак сможет это вылечить, но эта надежда оказалась абсолютно напрасной. Ах!» Эта парочка затевает еще один нудной спор, игнорируя тебя.~
@45974 = ~«У меня еще несколько вопросов...»~
@45975 = ~«Я хотел бы кое-что купить...»~
@45976 = ~«Тогда прощай». ~
@45977 = ~«Не сомневаюсь, что козлы на ферме скучают по твоей трепетной заботе...» Брока багровеет, и парочка начинает, похоже, очень долгую ссору. Их внимание полностью приковано друг к другу, и тебя они игнорируют.~
@45978 = ~«Нет, спасибо. Прощай».~
@45979 = ~«У меня еще несколько вопросов...»~
@45980 = ~«Я хотел бы кое-что купить...»~
@45981 = ~«Тогда прощай». ~
@45982 = ~Пару секунд она ворчит что-то неразборчивое, затем выдает такую тираду, от которой у тебя уши пухнут, и вскоре Брока начинает ее перекрикивать. Тебя они игнорируют.~
@45983 = ~«У меня еще несколько вопросов...»~
@45984 = ~«Ответь мне еще на пару вопросов...»~
@45985 = ~«Я хотел бы кое-что купить...»~
@45986 = ~«Нет, спасибо. Прощай».~
@45987 = ~«Тогда прощай». ~
@45988 = ~Эта парочка ведет горячий спор. Они совершенно тебя не замечают, а их слова медленно заполняют пространство лавки.~
@45989 = ~«Тогда я зайду попозже. Прощайте».~
@45990 = ~«О-о-о! Один из моих тайных паролей! Вот нужные вам бумаги, сэр! Спасибо! Могу ли я принести вам что-нибудь еще?»~
@45991 = ~«Ничего. Прощай».~
@45992 = ~«Нет, спасибо. Прощай».~
@45993 = ~«Я, безусловно, надеюсь, что это так, сэр, что бы это не значило! Я всего лишь большая глупая каменная голова! Вот ваши бумаги, сэр, и вот еще! Спасибо! Могу ли я принести вам что-нибудь еще?»~
@45994 = ~«Ответь мне еще на пару вопросов...»~
@45995 = ~«Ничего. Прощай».~
@45996 = ~«Эй, смотри! Еще одна летающая голова».~
@45997 = ~[no text]~
@45998 = ~[no text]~
@45999 = ~[no text]~
@46000 = ~[no text]~
@46001 = ~[no text]~
@46002 = ~Nameless One Tired 4~ [NAM011]
@46003 = ~[no text]~
@46004 = ~Nameless One Bored 2~ [NAM013]
@46005 = ~Nameless One Dying 3~ [NAM023]
@46006 = ~Nameless One Hurt 3~ [NAM026]
@46007 = ~Nameless One Location, Negative Material Plane (The Underworld) 1~ [NAM028]
@46008 = ~Nameless One Action 1 1~ [NAM031]
@46009 = ~Nameless One Action 2 1~ [NAM032]
@46010 = ~Nameless One Action 3 1~ [NAM033A]
@46011 = ~[no text]~
@46012 = ~Эта пожилая женщина изучает тебя своими острыми серыми глазами... сначала лицо, потом руки и татуировки. «Приветствую, покрытый шрамами. Пришел поговорить с Элобранд, не так ли? Может, пришел узнать свою судьбу за ничтожные пять монет?»~
@46013 = ~«Да... поведай мне мою судьбу...»~
@46014 = ~«Нет, но у меня есть несколько вопросов...»~
@46015 = ~«Нет, спасибо. Прощай, Элобранд».~
@46016 = ~Элобранд прячет твои монеты в кошельке на поясе и берет твою руку. Она молчаливо изучает твою ладонь, сильно нахмурившись. Наконец, она произносит: «Видишь ли, есть такие редкие люди, которых называют бессудебными. Они бредут по жизни, делают все, что считают нужным, создавая свою собственную судьбу. У тебя нет судьбы, чтобы предсказать ее, покрытый шрамами... нет вообще. Мне нечего тебе сказать... так что вот твои монеты». Она возвращает пять монет.~
@46017 = ~«Понятно... У меня есть несколько вопросов...»~
@46018 = ~«Тогда прощай».~
@46019 = ~«Я не говорю о мирских делах, покрытый шрамами».~
@46020 = ~«Тогда, может, ты вот о чем скажешь: я прочел этот свиток, и в нем оказалась ловушка».~
@46021 = ~«Тогда поведай мне мою судьбу...»~
@46022 = ~«В таком случае, прощай».~
@46023 = ~«В таком случае, прощай».~
@46024 = ~«Погоди минутку, покрытый шрамами... — Элобранд притрагивается к твоей руке. — Однажды, давным давно, моя мать дала мне кое-что... свиток, запечатанный воском. Его доверил ей его один человек в капюшоне, сказав, что однажды такой человек, как ты, придет, сам того не хотя, и потребует его. Вот... я бы хотела, чтобы ты его взял».~
@46025 = ~«Что это?»~
@46026 = ~Элобранд, нахмурившись, качает головой. «Я не знаю. Она клялась, что никогда не читала его, а я по ее просьбе оставила печать нетронутой. Тот человек щедро ей заплатил за хранение свитка, но предупредил ее о страшных последствиях его вскрытия».~
@46027 = ~«Тогда спасибо. Прощай».~
@46028 = ~Ты видишь Элобранд, гадалку. «Вновь приветствую тебя, покрытый шрамами».~
@46029 = ~«Я прочел свиток — в нем была ловушка».~
@46030 = ~«У меня есть несколько вопросов, Элобранд...»~
@46031 = ~«Я просто проходил мимо. Прощай».~
@46032 = ~Элобранд кажется озадаченной. «Я... не знаю, что и сказать тебе, покрытый шрамами...»~
@46033 = ~«Ты могла бы начать с того, что рассказала мне, как именно он к тебе попал».~
@46034 = ~«Действительно, тут *не о чем* говорить. Прощай».~
@46035 = ~«Как я уже говорила... его мне дала моя мать. Ей его дал человек в капюшоне около пятидесяти лет назад. Он хорошо заплатил ей, но приказал не вскрывать его при любых обстоятельствах, — Элобранд вздыхает, посмотрев в сторону. — Она владела магией, была сильна в Искусстве, и все равно испугалась этого человека. Она говорила, что его глаза — по правде говоря, это все, что она в нем разглядела — наводили мысль о его безумии, и что кожа вокруг них была сморщенная и серая... прямо как у тебя. Больше я ничего о нем не знаю».~
@46036 = ~«Ну и ладно. Прощай».~
@46037 = ~Этот молодой мускулистый «громила», будучи достаточно крупным и хорошо вооруженным, чтобы быть опасным, все же кажется слишком чистым для обычного уличного хулигана. У него огромный топор в одной руке и стальной коробок в другой. Когда ты приближаешься к нему, он надувается и сердито смотрит на тебя. «На что уставился, 'бедолага'? 'Отвали', пока я тебя 'доходягой' не сделал!»~
@46038 = ~~
@46039 = ~~
@46040 = ~~
@46041 = ~~
@46042 = ~Он поглядывает на кинжалы Анны, но ничего не отвечает.~
@46043 = ~«Ты что-то уж *сильно* ухожен для бандита».~
@46044 = ~«Остынь... Я просто хочу задать пару вопросов...»~
@46045 = ~Уйти.~
@46046 = ~«Перестань трещать своей 'костяной шкатулкой', недоумок! Это *моя* территория, так что убирайся отсюда быстро, если не хочешь, чтобы мои 'знатоки' порвали тебя на клочки!»~
@46047 = ~~
@46048 = ~~
@46049 = ~~
@46050 = ~~
@46051 = ~Его лицо багровеет от злобы, он скрежещет зубами. «Ну все, ты таки допросился! Взять его, знатоки!» Он поднимает топор и бросается в атаку!~
@46052 = ~Сражаться.~
@46053 = ~Сбежать.~
@46054 = ~Он поднимает бровь и глядит на коробок, пожимая плечами. «Не знаю, у меня не выходит открыть эту 'чертову' штуку... Кажется, это 'чертова' говорящая голова, но я ее уронил, и она замолкла. Я надеялся продать ее в антикварной лавке, но Вриша ее 'черта с два' возьмет. Нужно? Отдаю за сотню медяков».~
@46055 = ~«Погоди, откуда он у тебя?»~
@46056 = ~«Это же голова от того тела из Фестхолла, так ведь?»~
@46057 = ~«Конечно, я его беру».~
@46058 = ~«Нет, спасибо. Прощай».~
@46059 = ~На миг лицо молодой громилы принимает робкое выражение; это выглядит смехотворно, учитывая его массивную фигуру. «Я его... нашел. Как будто это тебя касается, 'бедолага'! Он тебе нужен или нет? Гони сто монет, или я просто оставлю себе эту 'чертову' штуковину».~
@46060 = ~«Это же голова от того тела из Фестхолла, так ведь?»~
@46061 = ~«Конечно, я его беру».~
@46062 = ~«Нет, спасибо. Прощай».~
@46063 = ~Он рычит на тебя. Плюясь во все стороны, он выкрикивает: «Да с какого 'черта' мне знать! Какая разница?! Я просто нашел эту 'чертову' штуковину... а то, что я нахожу, я не выкидываю. Она моя по праву! Хочешь? *Купи*. Сто 'звенелок', 'пень'».~
@46064 = ~«Конечно, я его беру».~
@46065 = ~«Как насчет того, чтобы поспорить на нее?»~
@46066 = ~«Как насчет того, чтобы я просто избил тебя до потери сознания и забрал его?»~
@46067 = ~«Нет, спасибо. Прощай».~
@46068 = ~«А?»~
@46069 = ~«Спорим на нее. Правила такие: берешь топор и бьешь меня, куда тебе захочется. Если потом я смогу подняться и забрать коробок, он мой... в ином случае, можешь забрать с меня все, что захочешь».~
@46070 = ~«Неважно. Я просто куплю его».~
@46071 = ~«Забудь. Я просто изобью тебя до потери сознания и заберу его».~
@46072 = ~«Неважно. Прощай».~
@46073 = ~Он смотрит весьма скептически сначала на свой топор, потом на тебя.~
@46074 = ~«Что, боишься, что я что-то типа 'бессмертного', которому твой топор нипочем? *Погляди* на меня».~
@46075 = ~«Что, боишься, что я что-то типа 'бессмертного', которому твой топор нипочем? *Погляди* на меня».~
@46076 = ~«Неважно. Я просто куплю его».~
@46077 = ~«Забудь. Я просто изобью тебя до потери сознания и заберу его».~
@46078 = ~«Неважно. Прощай».~
@46079 = ~Бандит вонзает в тебя свой тяжелый топор, его лезвие рассекает плоть и кости в одном мощном ударе, убивая тебя.~
@46080 = ~Пасть во тьму...~
@46081 = ~Бандит вонзает в тебя свой тяжелый топор, его лезвие рассекает плоть и кости в одном мощном ударе. Ты, шатаясь, выкашливаешь из легких кровь, затем ухмыляешься молодому крепышу. Он шокированно глядит, как ты направляешься к нему за стальным коробком.~
@46082 = ~«Теперь я заберу коробок. Жаль, что ты не догадался, что я что-то типа 'бессмертного', которому твой топор не страшен, а? Счастливо».~
@46083 = ~Забрать коробок и оставить его стоять здесь в растерянности.~
@46084 = ~Крепкий молодой бандит хватает твои монеты и сует тебе коробок. «А теперь проваливай. 'Черта с два' я хочу с тобой дальше болтать, 'пень'».~
@46085 = ~«Да-да, как скажешь. Прощай».~
@46086 = ~Уйти.~
@46087 = ~Молодой громила презрительно усмехается, когда ты подходишь к нему. «Снова ты?! 'Отвали', 'пень'!»~
@46088 = ~«Ты кажешься слишком ухоженным для бандита».~
@46089 = ~«Остынь... Я просто хочу задать пару вопросов...»~
@46090 = ~Уйти.~
@46091 = ~Молодой громила презрительно усмехается, когда ты подходишь к нему. «Тряси своим 'чертовым' 'костяным коробком' сколько хочешь, 'пень'. Я с тобой не буду 'трепаться'».~
@46092 = ~«Как скажешь. Прощай».~
@46093 = ~Уйти.~
@46094 = ~«'Доходягой'? Что, во имя девяти планов Баатора, ты несешь, придурок? Доходягами становятся от пил, щипцов и киянок Твердолобых, бестолочь ты эдакая, пень пустоголовый».~
@46095 = ~Анна хихикает, качая головой. «Трясти, бедолага ты этакий. Трясти черепушкой. Хотела б я поглядеть, сколько ты протянешь в самой гуще Улья, с таким-то говором... — Анна поворачивается к тебе. — Ну все, валим отсюда. Нечего тратить время на этого типа-вояку с коротким корешком».~
@46096 = ~~
@46097 = ~«Ты кажешься слишком ухоженным для бандита».~
@46098 = ~«Остынь... Я просто хочу задать пару вопросов...»~
@46099 = ~Уйти.~
@46100 = ~«Просто интересно, что в том твоем коробке».~
@46101 = ~«Нет, пожалуй, я просто поброжу здесь поблизости».~
@46102 = ~«Хорошо, я ухожу. Прощай».~
@46103 = ~«Я — один из ребят, которые готовят для тебя камни переживаний».~
@46104 = ~«Тогда жду не дождусь, когда ты приступишь к работе!»~
@46105 = ~Этот сердитый на вид юноша кажется скорее не бандитом, а тем, кто пытается быть на него похожим. Он ухмыляется, когда ты подходишь. «'Отвали', 'пень'! Переговори с 'большими шишками', а я с тобой 'трещать' не буду».~
@46106 = ~«Э... Хорошо. Прощай».~
@46107 = ~Уйти.~
@46108 = ~Этот подавленный маленький человечек носится по антикварному магазину, протирая от пыли, каталогизируя и переставляя вещи по велению владелицы этого места. Ты отмечаешь, что он слегка пахнет луком. Когда ты приближаешься, он нервно поглядывает на тебя. «Прошу вас, сэр... Я не могу с вами говорить. Я занят, да и моя хозяйка этого попросту не позволяет...»~
@46109 = ~«У меня всего лишь несколько вопросов...»~
@46110 = ~«Тогда прощай». ~
@46111 = ~«Извините, сэр, но я не могу. Прошу вас, оставьте меня, пока моя хозяйка не заметила, что я с вами разговариваю...»~
@46112 = ~«Твоя хозяйка?»~
@46113 = ~«Тогда прощай». ~
@46114 = ~Маленький человечек кивает. «Да... Госпожа Вришика. Я Стендиш, ее слуга... ее раб. Я совершил преступление и был приговорен к рабству, а затем куплен в Нижнем районе, как и много других ее рабов... большинство из них она держит в своем имении. А теперь прошу, умоляю вас! Оставьте меня, иначе она рассердится и жестоко изобьет меня!»~
@46115 = ~«Ладно... прощай, Стендиш».~
@46116 = ~Этот невысокий мужчина ученого вида со строгим мрачным выражением на лице осматривает тебя сверху донизу. «Приветствую, я Финам. Я должен извиниться, сэр, но мне не нужны гости, приглашенные или *непрошенные*, так что если вы здесь не по делу, прошу вас удалиться».~
@46117 = ~«У меня есть несколько вопросов...»~
@46118 = ~«Тогда прощайте». ~
@46119 = ~Финам смотрит в твою сторону, хмурясь. «Решили снова почтить мой дом своим присутствием, не так ли? Что вам нужно от меня на этот раз?»~
@46120 = ~«У меня есть несколько вопросов...»~
@46121 = ~«По правде говоря, ничего. Прощайте».~
@46122 = ~«Хочу, чтобы вы знали, сэр: я ученый и лингвист. Я с радостью отвечу на любые вопросы касательно моей области изучения, языков и тому подобного, но по другим вопросам я не смогу вам помочь».~
@46123 = ~Разложить додекаэдр в страницу с «письменами» и спросить, может ли он их перевести.~
@46124 = ~«Тогда неважно. Прощайте».~
@46125 = ~Он берет разложенный додекаэдр и внимательно осматривает его. «Это давно умерший язык, практически никому неизвестный. Думаю, что мой отец, лингвист, как и я, знал этот язык, и вполне мог быть единственным в Сигиле человеком, понимавшим его. Я узнаю его по отцовским записям, но перевести не могу».~
@46126 = ~«У вас еще сохранились отцовские записи?»~
@46127 = ~«Так или иначе, спасибо. Прощайте».~
@46128 = ~Финам качает головой. «Если вы собрались что-нибудь переводить, от них вам пользы не будет... а те несколько настоящих книг, которые он посвятил этому языку, пропали, думаю, примерно в то же время, когда его убили».~
@46129 = ~«Вашего отца убили?»~
@46130 = ~«Очень жаль. Прощайте, Финам».~
@46131 = ~Финам кивает. «Его задушили. Он остался, чтобы дать кому-то частный урок (он обучал многим языкам, чтобы обеспечивать деньгами свои исследования), и его обнаружили мертвым в боковой комнате в Городском Фестхолле. Убийцу так и не нашли. Это произошло где-то... э... наверно, лет пятьдесят назад. Я был еще ребенком».~
@46132 = ~«Однако он знал этот язык и мог обучать ему?»~
@46133 = ~«Жаль. Прощайте, Финам».~
@46134 = ~«Конечно, он его знал, и смог бы обучить ему, будь он до сих пор жив. Говорят, мой отец был отличным учителем, — Финам печально вздыхает. — Я обладаю его склонностью к языкам, но, увы, у меня нет его терпеливости к другим».~
@46135 = ~«Его... передали в Морг?»~
@46136 = ~«Прощайте, Финам».~
@46137 = ~«Да нет... Его прах хранится здесь, — он указывает на бронзовую урну, стоящую на шкафу возле букета пурпурных цветов. — А что? — губы Финама изгибаются в кривой усмешке. — Вы некроскоп? Разговариваете с мертвыми? — внезапно он нахмуривается. — Я больше не желаю это обсуждать. Вам придется извинить меня, сэр... Прощайте».~
@46138 = ~«Прощайте, Финам».~
@46139 = ~Похоже, этот молодой актер слишком увлечен своим представлением, чтобы прерваться и поговорить с тобой. Ты замечаешь у его ног фетровую шляпу, в которой лежит немного медяков. Время от времени прохожие бросают в шляпу пару монет.~
@46140 = ~Бросить монету в шляпу.~
@46141 = ~Незаметно для всех украсть монеты из шляпы.~
@46142 = ~Незаметно для всех украсть монеты из шляпы.~
@46143 = ~Уйти.~
@46144 = ~Твоя монета падает в шляпу тихим *дзинь*. Актер, не прекращая представления, быстро кивает тебе в знак благодарности.~
@46145 = ~Незаметно для всех украсть монеты из шляпы.~
@46146 = ~Незаметно для всех украсть монеты из шляпы.~
@46147 = ~Уйти.~
@46148 = ~Делая вид, что ты интересуешься представлением, ты крадешь из шляпы актера около дюжины медных монет.~
@46149 = ~Тихо уйти.~
@46150 = ~Кто-то заметил твою попытку украсть деньги и начал звать стражников!~
@46151 = ~Уйти.~
@46152 = ~Похоже, этот молодой актер слишком увлечен своим представлением, чтобы прерваться и поговорить с тобой.~
@46153 = ~Уйти.~
@46154 = ~«Что это у тебя за кружка?»~
@46155 = ~«У меня есть несколько вопросов...» ~
@46156 = ~«Здравствуй и прощай».~
@46157 = ~Он печально качает головой, сделав еще один глоток эля. «Нет-нет... не нужно... искать здесь ответы... не надо».~
@46158 = ~«Что-то не так?»~
@46159 = ~«Что это у тебя за кружка?»~
@46160 = ~«Тогда прощай». ~
@46161 = ~Он вздыхает, прикрывает отрыжку рукой и кивает, еще раз приложившись к элю. «Ну ладно, да, что-то не так. Я пропал, я больше... не ученик. У меня было тяжелое похмелье, и я испортил... последний опыт моего наставника. Все из-за этой проклятой... выпивки! — он презрительно смотрит на кружку, которую держит руке, но уже через секунду выражение его лица смягчается, и он делает еще глоток. — Она все разрушает, эта чертова выпивка...»~
@46162 = ~«Так почему бы тебе не бросить пить?»~
@46163 = ~«Если ты слишком слаб, чтобы остановиться, ты сам в этом виноват. Прощай».~
@46164 = ~«Очень жаль. Прощай».~
@46165 = ~Он пожимает плечами и несчастно вздыхает. «Я просто... не могу. Я хотел бы, но не могу. Мне просто... *нужно* пить. Я пытаюсь держаться от нее подальше, но, в конце концов, желание... переполняет меня, и я не могу сопротивляться. Я стал... таким развалиной!» Он опрокидывает в рот последние капли эля и заказывает еще.~
@46166 = ~«Тут есть кое-кто, с кем тебе следовало бы переговорить... Несбыточная Мечта. Ты найдешь ее в Городском Фестхолле. Поговори с ней о своей любви к выпивке... и вскоре ты обнаружишь, что больше не хочешь пить».~
@46167 = ~«Понятно. Что это за кружка у тебя?»~
@46168 = ~«Если ты слишком слаб, чтобы остановиться, ты сам в этом виноват. Прощай».~
@46169 = ~«Очень жаль. Прощай».~
@46170 = ~Его взгляд проясняется. «Правда? Тогда мне сейчас же нужно пойти... поговорить с ней. Спасибо... сэр, — он останавливается, взглянув на пустую кружку. — Вот... Я бы хотел отдать тебе это. Мне она больше... не нужна». Он дает тебе кружку для эля, покрытую рунами.~
@46171 = ~«Спасибо... Прощай».~
@46172 = ~«Эта? — он глядит на оловянную кружку. — Выиграл в кости. Она заколдована... все, что в ней хранится, остается холодным как лед. В моем случае это... дешевый эль». Он хмурится, трет глаза и делает еще глоток.~
@46173 = ~«Что-то не так?»~
@46174 = ~«Это все, что я хотел узнать. Прощай».~
@46175 = ~На маленьком шкафчике стоит урна, заполненная прахом и обугленными осколками костей. На основании урны высечены слова «Фин Эндли — любимый муж, отец и знаток сотни языков».~
@46176 = ~Использовать на останках свою способность «История костей».~
@46177 = ~Уйти.~
@46178 = ~Прах будто бы слегка шевелится, словно от твоего дыхания. Из урны доносится далекий шепот: «Зачем, зачем меня призвали в этот прах, холодный и серый, словно сердце ведьмы?»~
@46179 = ~«Для ответов на вопросы, дух...»~
@46180 = ~«Просто так. Прощай, дух».~
@46181 = ~«Тогда спрашивай, чтобы я смог вернуться к своим спокойным размышлениям...»~
@46182 = ~«Кем ты был?»~
@46183 = ~Описать ему записи из раскрывающегося додекаэдра, спросить, знает ли он этот язык.~
@46184 = ~«Неважно. Прощай».~
@46185 = ~«Я был Фином, ученым-лингвистом. Я был убит — убит! — собственным учеником... убит для того, чтобы я никого не смог обучить тому языку, которому я его обучил. Это был язык Уйо, один из редчайших в мультивселенной. Я не знал никого, кто бы разговаривал на нем, кроме меня и того проклятого ученика-убийцы...»~
@46186 = ~Описать ему записи из раскрывающегося додекаэдра, спросить, знает ли он этот язык.~
@46187 = ~«Это все, что я хотел узнать. Прощай».~
@46188 = ~«Да, я знаю этот язык. Видишь ли, я был ученым-лингвистом. Я был убит — убит! — собственным учеником... убит для того, чтобы я никого не смог обучить тому языку, которому я его обучил. Это был язык Уйо, один из редчайших в мультивселенной. Я не знал никого, кто бы разговаривал на нем, не считая меня и того проклятого ученика-убийцы...»~
@46189 = ~«Значит, ты можешь научить меня этому мертвому языку?»~
@46190 = ~«Да, я могу обучить тебя этому языку... на самом деле, мне будет приятно сделать это, хотя бы в отместку тому ученику-убийце из прошлого. Для начала, скажи, какими языками ты *владеешь*...»~
@46191 = ~Изучить все, чему может научить тебя дух.~
@46192 = ~~
@46193 = ~Когда дух рассказывает тебе о забытом языке Уйо, ты начинаешь ощущать пульсацию в висках: это всплывают твои воспоминания... воспоминания об этом языке. Ты вспоминаешь буквы, слова, фразы, и вот язык снова раскрывается тебе во всей полноте, словно ветер со Шпиля разогнал покрывало ядовитого дыма Великой Литейной в твоем разуме.~
@46194 = ~Продолжить...~
@46195 = ~На поверхность всплывает еще одно воспоминание... более темное. Его присутствие почему-то беспокоит тебя, наполняет тебя тревогой и необъяснимым чувством вины...~
@46196 = ~Подавить воспоминание.~
@46197 = ~Позволить воспоминанию всплыть.~
@46198 = ~Наконец, ты вспоминаешь самого Фина Эндли. Ты вспоминаешь его мягкий голос, его добродушие, то, как он обучал тебя древнему языку Уйо. Еще ты вспоминаешь свою грубую ошрамованную руку, смыкающуюся на его хлипком горле, ломающую его кадык, чтобы тайны содержимого твоего дневника, спрятанного в напичканном ловушками додекаэдре-головоломке и написанного на малоизвестном языке Уйо, будут надежно и навсегда скрыты от пытливых глаз...~
@46199 = ~«Фин... я должен тебе признаться... я тот, кто убил тебя».~
@46200 = ~«Думаю, я уже достаточно понимаю язык. Спасибо, Фин, и прощай».~
@46201 = ~Какое-то время дух молчит, тихонько шурша прахом в урне. Когда он отвечает, его голос полон печали. «Но... почему... и зачем приходить ко мне снова? Разве ты *забыл* то, чему тебя учили?»~
@46202 = ~«Нет... то есть, да. Это трудно объяснить, но тебя, должно быть, убило мое прошлое 'я'. Каждый раз, умирая, я просыпаюсь, словно после долгого сна... и забываю все... кем я был и что я сделал...»~
@46203 = ~«Мне кажется, я понимаю... я чувствую твое раскаяние, и прощаю тебя. Да пребудет с тобой мир, старый ученик, и пускай в этой жизни ты будешь добрее, чем в той, в которой ты увидел мою смерть...»~
@46204 = ~«Спасибо, Фин. Прощай».~
@46205 = ~Дух, кажется, немного сметен твоим очевидным владением языком Сидхи. «Похоже, ты уже в некоторой степени владеешь этим языком, мой ученик...»~
@46206 = ~«Да... Мне кажется, я уже достаточно понимаю этот язык. Спасибо, Фин, и прощай».~
@46207 = ~Отложить его.~
@46208 = ~При внимательном осмотре ты понимаешь, что каждая из сторон додекаэдра — это пластина, которую можно крутить в разные стороны... похоже на головоломку или замок с шифром. Поскольку у каждой пятиугольной пластины есть пять положений, у додекаэдра не менее двухсот сорока четырех миллионов ста сорока тысяч шестисот двадцати пяти комбинаций. Чтобы перебрать их все, понадобится каждая секунда из следующих семидесяти семи лет. И все же тебе *может* попросту повезти, и ты наткнешься на решение за считанные минуты...~
@46209 = ~Повертеть его немного.~
@46210 = ~Просто отложить его.~
@46211 = ~По мере того, как ты методично вращаешь холодные серые грани додекаэдра, у тебя возникает странное ощущение в основании черепа. Твои руки движутся, словно сами по себе, поворачивая его и вращая его грани с механической точностью. Ты уже раньше это делал... когда-то ты знал комбинации... и еще ты вспомнил об определенных *опасностях*, скрытых в этом предмете. Однако ты не можешь вспомнить, что это: простые ловушки или что-нибудь более необычное.~
@46212 = ~Продолжить работать с додекаэдром.~
@46213 = ~Продолжить работать с додекаэдром.~
@46214 = ~Продолжить работать с додекаэдром.~
@46215 = ~Через минуту первые четыре грани, как тебе кажется, уже в правильных положениях. Взявшись за пятую сторону додекаэдра, ты вспоминаешь о хитрой ловушке с лезвиями, которая при срабатывании бьет по рукам слишком пытливого взломщика, рассекая запястья и отрезая пальцы. Ты обходишь ловушку, сделав правильное число поворотов. Определенно, ты уже ближе к разгадке тайны этого предмета.~
@46216 = ~Продолжить работать с додекаэдром.~
@46217 = ~Продолжить работать с додекаэдром.~
@46218 = ~Продолжить работать с додекаэдром.~
@46219 = ~Отложить додекаэдр.~
@46220 = ~Избежав выскакивающих лезвий, ты неспешно подбираешь положение последующих граней. Взявшись за девятую сторону додекаэдра, ты вдруг вспоминаешь вторую ловушку — потоки ядовитого газа, образующего клубящееся облако смертоносных едких испарений вокруг любопытного взломщика. Ты обходишь ловушку, сделав правильное число поворотов, уверенный в том, что вскоре ты раскроешь додекаэдр.~
@46221 = ~Продолжить работать с додекаэдром.~
@46222 = ~Продолжить работать с додекаэдром.~
@46223 = ~Продолжить работать с додекаэдром.~
@46224 = ~Отложить додекаэдр.~
@46225 = ~Ты обходишь ядовитую газовую ловушку и начинаешь подбирать позиции последних граней. Как раз, когда ты ставишь на место двенадцатый пятиугольник, ты вспоминаешь о спрятанных в додекаэдре колдовских рунах, которые поражают несведущих стрелами волшебных молний. Ты разряжаешь ловушку правильным количеством оборотов грани, додекаэдр щелкает и начинает раскрываться...~
@46226 = ~Через минуту первые четыре грани, как тебе кажется, уже в правильных положениях. Когда ты начинаешь крутить пятую сторону додекаэдра, из щелей между крутящимися гранями и додекаэдром выскакивают бритвенно-острые лезвия, полоснув тебя по запястьям и чуть не отрезав несколько пальцев. Стиснув зубы от боли, ты наклоняешься и подбираешь упавший додекаэдр... и вдруг вспоминаешь, как обойти данную ловушку.~
@46227 = ~Продолжить работать с додекаэдром.~
@46228 = ~Продолжить работать с додекаэдром.~
@46229 = ~Отложить додекаэдр.~
@46230 = ~Через минуту первые четыре грани, как тебе кажется, уже в правильных положениях. Когда ты начинаешь крутить пятую сторону додекаэдра, из щелей между крутящимися гранями и додекаэдром выскакивают бритвенно-острые лезвия, полоснув тебя по запястьям и отрезав несколько пальцев. Падая на землю, ты роняешь окровавленный додекаэдр; из ран на запястьях хлещет кровь... и вдруг, уже падая во тьму, ты вспоминаешь, как обойти данную ловушку.~
@46231 = ~Пасть во тьму...~
@46232 = ~Избежав выскакивающих лезвий, ты неспешно подбираешь положение последующих граней. Когда ты начинаешь крутить девятую сторону додекаэдра, в лицо тебе ударяют потоки ядовитого газа, образующего клубящееся облако смертоносных едких испарений. Почти ослепнув, испытывая сильное головокружение и болезненные рвотные позывы, ты, хотя уже и слишком поздно, но все же вспоминаешь, как избежать эту ловушку.~
@46233 = ~Продолжить работать с додекаэдром.~
@46234 = ~Продолжить работать с додекаэдром.~
@46235 = ~Отложить додекаэдр.~
@46236 = ~Избежав выскакивающих лезвий, ты неспешно подбираешь положения последующих граней. Когда ты начинаешь крутить девятую сторону додекаэдра, в лицо тебе ударяют потоки ядовитого газа, образующие клубящееся облако смертоносных едких испарений. Некоторое время ты бьешься в судорогах — почти ослепнув, испытывая сильное головокружение и болезненные рвотные позывы, перед самой смертью ты вспоминаешь, как обойти эту ловушку. Прижав додекаэдр к ошрамованной груди, ты падаешь замертво, корчась от агонии,~
@46237 = ~Ты обходишь ядовитую газовую ловушку и начинаешь подбирать позиции последних граней. Как раз, когда ты ставишь на место двенадцатый пятиугольник, колдовские руны, спрятанные в додекаэдре, высвобождают маленькую бурю магических молний. По твоим рукам пробегают потрескивающие разряды голубого света, оставляя за собой дымящиеся следы черной обугленной плоти.

Дождавшись окончания спазмов и поднявшись на ноги, ты вспоминаешь, как обойти эту ловушку. После окончательной донастройки двенадцатой грани додекаэдр щелкает и начинает раскрываться...~
@46238 = ~Ты обходишь ядовитую газовую ловушку и начинаешь подбирать позиции последних граней. Как раз, когда ты ставишь на место двенадцатый пятиугольник, колдовские руны, спрятанные в додекаэдре, высвобождают маленькую бурю магических молний. По твоим рукам пробегают потрескивающие разряды голубого света, оставляя за собой дымящиеся следы черной обугленной плоти. Рухнув на землю в судорогах, ты вспоминаешь, как обойти ловушку. Однако нанесенное увечье слишком велико, и ты умираешь от сильного шока и поражения нервной системы...~
@46239 = ~Додекаэдр разделяется раз, другой и, наконец, неведомым образом раскладывается в идеально-прямоугольную табличку размером с большую книгу. На ней выгравированы ряды причудливых символов. Они похожи на код или язык, который кажется тебе знакомым... однако ты его не знаешь. При дальнейшем изучении таблички ты обнаруживаешь, что если поворачивать пятиугольные грани, которые теперь находятся на обратной стороне таблички, на поверхности таблички показываются разные «страницы». До тебя, наконец, доходит, что додекаэдр — это какая-то книга или дневник.~
@46240 = ~«Хм-м... пока я не изучу этот язык, для меня он бесполезен».~
@46241 = ~Ты поднимаешь холодный серый додекаэдр, чтобы внимательно изучить его, теперь зная о ловушке с выскакивающими лезвиями, поджидающей неосторожного.~
@46242 = ~Поработать с додекаэдром еще немного.~
@46243 = ~Поработать с додекаэдром еще немного.~
@46244 = ~Поработать с додекаэдром еще немного.~
@46245 = ~Отложить додекаэдр.~
@46246 = ~Ты поднимаешь холодный серый додекаэдр, чтобы внимательно изучить его, теперь зная о ловушках с выскакивающими лезвиями и отравленным газом, поджидающих неосторожного.~
@46247 = ~Поработать с додекаэдром еще немного.~
@46248 = ~Поработать с додекаэдром еще немного.~
@46249 = ~Поработать с додекаэдром еще немного.~
@46250 = ~Отложить додекаэдр.~
@46251 = ~Ты поднимаешь холодный серый додекаэдр, чтобы внимательно изучить его, теперь зная о разных смертоносных ловушках, поджидающих неосторожного, а также о том, как обойти их все.~
@46252 = ~Разложить его.~
@46253 = ~Отложить додекаэдр.~
@46254 = ~Ты поднимаешь холодный серый додекаэдр, чтобы внимательно изучить его, теперь зная о разных смертоносных ловушках, поджидающих неосторожного, а также о том, как обойти их все. Изучив мертвый язык Уйо, ты, наконец, можешь расшифровать его содержание...~
@46255 = ~Разложить додекаэдр и прочесть его.~
@46256 = ~Отложить додекаэдр.~
@46257 = ~Табличка оказалась чем-то вроде дневника... который, похоже, принадлежал одному из предыдущих моих воплощений, и, к тому же, не самому здравомыслящему. В нем лишь несколько полностью понятных разделов.~
@46258 = ~Просмотреть его.~
@46259 = ~Отложить дневник.~
@46260 = ~Ты поднимаешь холодный серый додекаэдр — зашифрованный и начиненный ловушками дневник моего предыдущего воплощения.~
@46261 = ~Разложить дневник и пробежаться по нему глазами.~
@46262 = ~Отложить дневник.~
@46263 = ~Что ты хочешь прочесть?~
@46264 = ~Прочесть о «шепчущих тенях».~
@46265 = ~Прочесть о женщине-призраке.~
@46266 = ~Прочесть о чем-то, спрятанном в твоем собственном теле.~
@46267 = ~Прочесть какую-то параноидальную тираду.~
@46268 = ~Прочесть о «проклятых» татуировках.~
@46269 = ~Прочесть о снах и Равель.~
@46270 = ~Прочесть об опасности имен.~
@46271 = ~Прочесть об убийстве в Фестхолле.~
@46272 = ~Прочесть об убийстве того, кто пытался тебе помочь.~
@46273 = ~Прочесть загадочный ответ из неизвестного источника.~
@46274 = ~Прочесть что-то насчет наследства.~
@46275 = ~«Шепот не от ДВИЖЕНИЯ теней. Они ГОВОРЯТ, СГОВАРИВАЮТСЯ, ПЕРЕГОВАРИВАЮТСЯ между собой. Кое-что из того, что они говорят, я понимаю».~
@46276 = ~Прочесть еще что-нибудь.~
@46277 = ~Отложить дневник.~
@46278 = ~«Книга разговаривает со мной, нашептывает мне. Она говорит, чтобы я сторонился девушки-призрака, избегал ее. Я ЕЕ НЕ ЗНАЮ, а она меня МУЧАЕТ».~
@46279 = ~Прочесть еще что-нибудь.~
@46280 = ~Отложить дневник.~
@46281 = ~«Так что я ПРОГЛОТИЛ это в надежде на то, что оно ЗАСТРЯНЕТ в моих КИШКАХ. Если будет нужно, я могу заставить кого-нибудь ВЫНУТЬ это».~
@46282 = ~Прочесть еще что-нибудь.~
@46283 = ~«Я узнал, что МОЯ ЖИЗНЬ НЕ ПРИНАДЛЕЖИТ МНЕ. Я НЕ ПОЗВОЛЮ тебе заполучить ее...»

«Если она тебе нужна, ТЕБЕ придется вытянуть ее из моего РАЗБИТОГО ТЕЛА...»

«Это ТЫ УМРЕШЬ: если жизнь не принадлежит мне, то и ТЕБЕ ТОЖЕ».

«ТЫ В ОТВЕТЕ ЗА ЭТО ПРЕДАТЕЛЬСТВО ПЛОТИ, И ТЫ НЕ БУДЕШЬ ЖИТЬ, ЧТОБЫ НЕ ЖИТЬ МОЕЙ ЖИЗНЬЮ».~
@46284 = ~Отложить дневник.~
@46285 = ~Прочесть еще что-нибудь.~
@46286 = ~Отложить дневник.~
@46287 = ~«Проклятые ТАТУИРОВКИ не сходят с моей КОЖИ! Я пытался выжечь их — НЕ УДАЛОСЬ, не удалось! Я пытаюсь ПРИКРЫТЬ себя, но мне постоянно кажется, что люди ЧИТАЮТ мою ПЛОТЬ, читают меня как КНИГУ. По какой бы причине они не ПЯЛИЛИСЬ на меня, МНЕ ХОЧЕТСЯ ВЫРВАТЬ ИХ ГЛАЗА, выдернуть их из глазниц и РАЗДАВИТЬ ПЯТКОЙ...»~
@46288 = ~Прочесть еще что-нибудь.~
@46289 = ~Отложить дневник.~
@46290 = ~«ПОЧЕМУ МНЕ НИЧЕГО НЕ СНИТЬСЯ?!»

«Я использовал кубок Семира, чтобы увидеть СОН НАЯВУ. Я видел ВЕДЬМУ. Она ИСКУШАЛА меня, УГРОЖАЛА мне ТЕНЯМИ! Я никогда ее НЕ ВИДЕЛ, но она пришла ко мне ВО СНЕ. Я больше НЕ ДОЛЖЕН видеть сны. Я всегда должен быть НАЧЕКУ. Я УНИЧТОЖИЛ КУБОК».

«Она говорит, что она МОГУЩЕСТВЕННА, и что она меня ЗАПОЛУЧИТ, НАЙДЕТ МЕНЯ. Убирайся, ВЕДЬМА! Держись от меня ПОДАЛЬШЕ! Оставь меня в ПОКОЕ! Я НЕ ХОЧУ иметь с тобой дела!»~
@46291 = ~Продолжить чтение этой части дневника.~
@46292 = ~Прочесть еще что-нибудь.~
@46293 = ~Отложить дневник.~
@46294 = ~«Бойся ИМЕН. ИМЕНА имеют власть над личностью. ИМЕНА могут использоваться ДРУГИМИ как ОРУЖИЕ. Имена — это ПРИМАНКА, по которой ТЕБЯ МОГУТ ВЫСЛЕДИТЬ, НАЙТИ, ДОГНАТЬ везде на планах. Оставайся БЕЗЫМЯННЫМ — и ты будешь в БЕЗОПАСНОСТИ».~
@46295 = ~Прочесть еще что-нибудь.~
@46296 = ~Отложить дневник.~
@46297 = ~«Я пришел в Фестхолл, прослеживая путь моего ЛОЖНОГО Я в его залах. Как же это ОЧЕВИДНО, те, кого я не ЗНАЛ, — ФАЛЬШИВКИ, ПРИГЛАШАЛИ меня к себе, обращались со мной, как с ДРУГОМ, показывали мне СВОИ КОМНАТЫ, интересовались моими НУЖДАМИ. Я должен сдерживаться, чтобы не броситься на них. Слишком рано. Прежде всего, я должен был ЗАЩИТИТЬ свою ЛИЧНОСТЬ. Я нашел того единственного, кто знал язык Уйо, изучил этот язык как мог, а потом УБИЛ его. Потом я пошел в сенсориум и приготовил все ОСТАВШЕЕСЯ. Скоро, скоро...»~
@46298 = ~Прочесть еще что-нибудь.~
@46299 = ~Отложить дневник.~
@46300 = ~«Он НИЧЕМ не может помочь. Память УШЛА, сказал он, и НИКОГДА не вернется. Он говорит/лжет и сказал, что именно об этом он и говорил мне! ЛОЖЬ! Он сказал, что после каждой смерти мой разум СЛАБЕЕТ! ЛОЖЬ! Он сидел там, ТЕРЯЯ мое ДОВЕРИЕ с каждым словом.

Он сказал, что только после ЕЩЕ ТРЕХ СМЕРТЕЙ, ЕЩЕ ТРЕХ ЖИЗНЕЙ я получу выгоду от сохранения своих воспоминаний, но когда придет моя смерть, САМ Я УМРУ. УМРУ! Как бессмертный может УМЕРЕТЬ?! Он не смог ничего на это ответить, так что от него больше НЕТ ПРОКУ. Я ЗАРЕЗАЛ его, чтобы больше ни одно мое воплощение не воспользовалось его БЕСПОЛЕЗНОСТЬЮ».~
@46301 = ~И тогда ЖУТКИЕ ГОЛОВЫ сказали:

«ТЫ был РАЗДЕЛЕН. ТЫ — ОДИН ИЗ МНОГИХ человек (один из МНОГИХ ЧЕЛОВЕК?). Ты носишь много ИМЕН; каждое из них оставило шрам на твоем теле...»~
@46302 = ~Прочесть еще что-нибудь.~
@46303 = ~Отложить дневник.~
@46304 = ~Продолжить чтение этой части дневника.~
@46305 = ~Прочесть еще что-нибудь.~
@46306 = ~Отложить дневник.~
@46307 = ~ПОТЕРЯННЫЙ
БЕССМЕРТНЫЙ
КОНЕЦ ВОПЛОЩЕНИЙ
ЧЕЛОВЕК ТЫСЯЧИ СМЕРТЕЙ
ОБРЕЧЕННЫЙ ЖИТЬ
НЕУГОМОННЫЙ
ОДИН ИЗ МНОГИХ
ПЛЕННИК ЖИЗНИ
ПРИНОСЯЩИЙ ТЕНИ
УВЕЧНЫЙ
ПРИНОСЯЩИЙ БЕДЫ
ЙЕМЕТ~
@46308 = ~Продолжить чтение этой части дневника.~
@46309 = ~Прочесть еще что-нибудь.~
@46310 = ~Отложить дневник.~
@46311 = ~«ТЫ — серебряное зеркало, которое РАЗБИЛОСЬ, и его осколки разлетелись по всей истории.

Важен ЛИШЬ ОДИН ОСКОЛОК. Верни его, и твоя ЖИЗНЬ вернется к тебе. Будет назначена цена. Заплатив ее, ты купишь себе возможность. Без этой возможности ты ОБРЕЧЕН...»~
@46312 = ~Продолжить чтение этой части дневника.~
@46313 = ~Прочесть еще что-нибудь.~
@46314 = ~Отложить дневник.~
@46315 = ~«ТЫ ПОТЕРЯЛ ТО, ЧТО НИКОГДА НЕ ДОЛЖНО ОТДЕЛЯТЬСЯ ОТ ЧЕЛОВЕКА. ТВОЯ СМЕРТНОСТЬ ПОКИНУЛА ТЕБЯ. ПРОПАЛА. ОНА СУЩЕСТВУЕТ, НО ТЫ ДОЛЖЕН НАЙТИ ЕЕ, ПОКА ТЫ ЕЩЕ НЕ ПОТЕРЯЛ СВОЙ РАССУДОК».~
@46316 = ~Прочесть еще что-нибудь.~
@46317 = ~Отложить дневник.~
@46318 = ~«Ее голос провонял КОГТЯМИ зла, когтями, похожими на ПАУКОВ. Они ВПИЛИСЬ в мой мозг, и мне нужно ВЫКИНУТЬ ее из моего РАЗУМА. ПРОЧЬ! ПРОЧЬ, ведьма!»

«Она была МИФОМ, СКАЗКОЙ, которая в одиночку ВЫСТУПИЛА против ЛЕДИ БОЛИ! Как можно БОРОТЬСЯ с МИФОМ? У меня нет ОРУЖИЯ. Мне нужно оружие, которое УБЬЕТ ее, если она НАЙДЕТ МЕНЯ. Мне нужна СТРАТЕГИЯ, чтобы не проиграть, когда она ПРИДЕТ ЗА МНОЙ. Я должен ВСЕ ПРОДУМАТЬ И СПЛАНИРОВАТЬ. Я ОДЕРЖУ НАД НЕЙ ВЕРХ».~
@46319 = ~Прочесть еще что-нибудь.~
@46320 = ~Отложить дневник.~
@46321 = ~Пасть во тьму...~
@46322 = ~При твоем приближении он начинает заметно волноваться. «Спасибо, что остановился. Меня зовут Мар, я прошу тебя об одной услуге».~
@46323 = ~«Я слушаю».~
@46324 = ~«Прощай».~
@46325 = ~«Это вопрос жизни и смерти! Я должен доставить шкатулку, или мне придется несладко! Мне не повезло — я сильно подвернул ногу. Ты не мог бы помочь мне доставить эту шкатулку?»~
@46326 = ~«Я доставлю эту шкатулку».~
@46327 = ~«Нет».~
@46328 = ~Мар бережно достает небольшую шкатулку из складок своей рваной одежды. На какой-то миг ты видишь на его лице сожаление... но оно быстро исчезает; он смотрит на тебя и протягивает тебе шкатулку. Ее окружает легкое мерцание, когда вы с Маром вместе касаетесь ее. Мар издает легкий вздох облегчения, отдавая шкатулку на твое попечение.~
@46329 = ~«Что теперь?»~
@46330 = ~«Это нужно доставить Куатраа. Обычно его можно найти где-то в юго-восточной части Улья. Да, и попробуй сказать, что я тебя не предупредил: что бы ни случилось, НЕ ОТКРЫВАЙ ШКАТУЛКУ! И не покидай Улей с ней. А теперь шевелись!»~
@46331 = ~«Как только я доставлю шкатулку, я вернусь. Прощай».~
@46332 = ~Когда ты прерываешь этого человека, он поворачивается и кивает в вежливом приветствии. «Прошу прощения, сэр, но вы меня прервали. Если вы не против... прощайте». Он делает вежливый полупоклон и продолжает заниматься своими делами.~
@46333 = ~Уйти.~
@46334 = ~Джарим~
@46335 = ~Джарим~
@46336 = ~Мягкий голос этого человека дополняет его спокойные утонченные манеры. «Приветствую. Вы здесь, чтобы воспользоваться одним из камней переживаний?»~
@46337 = ~«Да».~
@46338 = ~Записка Гилтспура~
@46339 = ~Рекламный листок Гилтспура~
@46340 = ~Клыкастое зеркало~
@46341 = ~Рваная записка от Фарода~
@46342 = ~Татуировка Предателя~
@46343 = ~Татуировка спасителя~
@46344 = ~Татуировка Сказочницы~
@46345 = ~Татуировка поедателя паразитов~
@46346 = ~Татуировка восприятия~
@46347 = ~Татуировка Чувствующих~
@46348 = ~Татуировка плута~
@46349 = ~Объявление Гилтспура~
@46350 = ~РЕКЛАМНЫЙ ЛИСТОК ГИЛТСПУРА
Вес: 1

Это листок, который Гилтспур попросил тебя доставить Баркису в бар «Тлеющий труп». Это копия объявления, которое напечатал для него Пенн. Гилтспур, должно быть, сильно нуждается в посыльных, раз платит тебе за доставку две сотни монет.
~
@46351 = ~КЛЫКАСТОЕ ЗЕРКАЛО
Вес: 1

Это маленькое зеркальце состоит из посеребренного стекла, которое охватывают клыки, направленные от центра. Оно выглядит довольно дорогим... если не учитывать тот факт, что ты не можешь разглядеть в нем свое лицо.~
@46352 = ~РВАНАЯ ЗАПИСКА ОТ ФАРОДА
Вес: 0

Эту рваную записку ты получил от Фарода. В ней написано:

- Берегись ТЕНей
- Берегись мест, где ЖИВЕт ночь
- Они ждут
- Нет обычной темнаты
- Только ТеНИ~
@46353 = ~ТАТУИРОВКА ПРЕДАТЕЛЯ
Особенности:
   +1 к Силе
   +1 к Интеллекту
Вес: 0

Эта татуировка изображает поражение Триаса Предателя, и то, как ты нанес смертельный удар порочному дэва. Она показывает силу, которая была необходима для одержания победы над ним, и сообразительность, которая требовалась для того, чтобы перехитрить дэва.
~
@46354 = ~ТАТУИРОВКА СПАСИТЕЛЯ
Особенности:
   +2 к Мудрости
   +1 к Обаянию
   +1 к Удаче
Вес: 0

Эта татуировка рассказывает историю спасения Триаса-Предателя, и как ты увел его с пути зла к прощению. Она отражает твою мудрость и дар убеждения, и несет в себе благословение Триаса.
~
@46355 = ~ТАТУИРОВКА СКАЗОЧНИЦЫ
Особенности: 
   +1 к Обаянию
   +5 к Осведомленности
Вес: 0

С тех пор, как ты услышал истории Ив, ты можешь пользоваться этой татуировкой, чтобы использовать кое-что из ее знаний и опыта. Эта татуировка не только помогает тебе раскрывать истории нераспознанных предметов, которые ты находишь, но и делает тебя более интересной личностью, будто окружающие заранее откуда-то УЗНАЮТ, что тебе есть о чем рассказать.~
@46356 = ~ТАТУИРОВКА ВОСПРИЯТИЯ
Особенность:
   +1 к урону любой атакой
   +5% к урону от всех физических атак
THAC0: +1
Вес: 0
Используется только Чувствующими

Эта татуировка усиливает чувства игрока; в качестве побочного эффекта ее носитель может использовать свои усиленные чувства, чтобы находить уязвимые места цели и наносить больше урона. К несчастью, татуировка также усиливает все болевые ощущения ее носителя, так что он получает больше урона от физических атак. ~
@46357 = ~ОБЪЯВЛЕНИЕ ГИЛТСПУРА
Вес: 1

Это объявление Гилтспура, которое он попросил тебя доставить Нарушителю Пенну для распечатки. Здесь ничего необычного: маленькая рекламная заметка об аукционных услугах Гилтспура:

«ПРИХОДИТЕ, ПРИХОДИТЕ ВСЕ НА АУКЦИОН ГИЛТСПУРА»

И так далее... Текста не очень много, но он довольно точно отражает его личность.~
@46358 = ~~
@46359 = ~«Да».~
@46360 = ~«Нет, у меня есть несколько вопросов...»~
@46361 = ~«Нет. Прощай».~
@46362 = ~Человек кивает. «Это публичный сенсориум, в чьих комнатах хранятся записывающие камни или камни переживаний. Каждый из камней содержит определенное переживание, или ряд переживаний, которые пользователь переживает на себе. Чувствующим дозволено пользоваться ими в свое удовольствие, в то время как с посетителей взимается небольшая плата. Я ответил на ваш вопрос?»~
@46363 = ~«По большей части. Я хотел бы воспользоваться одним из камней прямо сейчас».~
@46364 = ~«По большей части. Я хотел бы воспользоваться одним из камней прямо сейчас».~
@46365 = ~«Нет...»~
@46366 = ~«Вполне. Прощай».~
@46367 = ~«Тогда я не могу вам помочь. Конечно, если только вы не хотите воспользоваться камнями...»~
@46368 = ~«Да».~
@46369 = ~«Да».~
@46370 = ~«Нет, спасибо. Прощай».~
@46371 = ~Человек улыбается и разъясняет тебе некоторые из тех разнообразных переживаний, который в данный момент доступны для тебя.

«Какое из них вам подойдет?»~
@46372 = ~«'Неизбежная боль'».~
@46373 = ~«'Нежная любовь'».~
@46374 = ~«'Жуткая скука'».~
@46375 = ~«'Крайнее удивление'».~
@46376 = ~«'Всепоглощающее нетерпение'».~
@46377 = ~«'Усталая капитуляция'».~
@46378 = ~«'Сверхъестественная похоть'».~
@46379 = ~«Собственно, а другие тут есть?»~
@46380 = ~«Не сейчас. Прощай».~
@46381 = ~Человек кивает и разъясняет несколько переживаний, доступных для тебя.

«Какое из них вам подойдет?»~
@46382 = ~«'Психоз'».~
@46383 = ~«'Мучительная зависть'».~
@46384 = ~«'Лютая ненависть'».~
@46385 = ~«'Чистое веселье'».~
@46386 = ~«'Удовольствие от испуга'».~
@46387 = ~«'Мрачная решительность'».~
@46388 = ~«'Полное недоумение'».~
@46389 = ~«Вообще-то, какие там были предыдущие?»~
@46390 = ~«А еще есть?»~
@46391 = ~«Не сейчас. Прощай».~
@46392 = ~Человек кивает, улыбаясь, и растолковывает оставшиеся из доступных в текущий момент переживаний.

«Какое из них вам подойдет?»~
@46393 = ~«'Горькое раскаяние'».~
@46394 = ~«'Потрясение и нарастающая жажда мести'».~
@46395 = ~«'Медленно накатывающий ужас'».~
@46396 = ~«'Неописуемое разочарование'».~
@46397 = ~«'Чрезвычайно важная тайна'».~
@46398 = ~«'Ликантропия'».~
@46399 = ~«Какие переживания ты описывал до того?»~
@46400 = ~«Не сейчас. Прощай».~
@46401 = ~«В текущий момент доступно больше дюжины обычных переживаний, а также шесть более 'экстравагантных'. Пользование обычными камнями стоит десять медных монет; более сложные обойдутся в пятьдесят медяков. Вы хотели бы послушать про обычные, или про экстравагантные переживания?»~
@46402 = ~«Обычные...»~
@46403 = ~«Экстравагантные...»~
@46404 = ~«На самом деле, никакие. Прощай».~
@46405 = ~Человек улыбается и разъясняет тебе некоторые из тех разнообразных переживаний, который в данный момент доступны для тебя.

«Какое из них вам подойдет?»~
@46406 = ~«'Неизбежная боль'».~
@46407 = ~«'Нежная любовь'».~
@46408 = ~«'Жуткая скука'».~
@46409 = ~«'Крайнее удивление'».~
@46410 = ~«'Всепоглощающее нетерпение'».~
@46411 = ~«'Усталая капитуляция'».~
@46412 = ~«'Сверхъестественная похоть'».~
@46413 = ~«Расскажи мне немного о других...»~
@46414 = ~«А на что, вообще, похожи экстравагантные?»~
@46415 = ~«Не сейчас. Прощай».~
@46416 = ~Человек кивает и объясняет несколько переживаний, доступных для тебя.

«Какое из них вам подойдет?»~
@46417 = ~«'Психоз'».~
@46418 = ~«'Мучительная зависть'».~
@46419 = ~«'Лютая ненависть'».~
@46420 = ~«'Чистое веселье'».~
@46421 = ~«'Удовольствие от испуга'».~
@46422 = ~«'Мрачная решительность'».~
@46423 = ~«'Полное недоумение'».~
@46424 = ~«Погоди... Опиши еще раз те, предыдущие...»~
@46425 = ~«Вообще-то, лучше расскажи об экстравагантных?»~
@46426 = ~«Не сейчас. Прощай».~
@46427 = ~Человек кивает, улыбаясь, и разъясняет более сложные переживания.

«Какое из них подойдет вам?»~
@46428 = ~«'Горькое раскаяние'».~
@46429 = ~«'Потрясение и нарастающая жажда мести'».~
@46430 = ~«'Медленно накатывающий ужас'».~
@46431 = ~«'Неописуемое разочарование'».~
@46432 = ~«'Чрезвычайно важная тайна'».~
@46433 = ~«'Ликантропия'».~
@46434 = ~«Вообще-то, лучше расскажи об обычных?»~
@46435 = ~«Не сейчас. Прощай».~
@46436 = ~«Отличный выбор. Камень, которым вы хотите воспользоваться, в одной из больших комнат: третья комната против часовой стрелки, начиная от лестницы. Он красно-оранжевого цвета».~
@46437 = ~«Спасибо. Прощай».~
@46438 = ~«Превосходно. Камень, которым вы хотите воспользоваться, в одной из больших комнат: вторая комната против часовой стрелки, начиная от лестницы. Он фиолетового цвета».~
@46439 = ~«Спасибо. Прощай».~
@46440 = ~«Чудесно. Камень, которым вы хотите воспользоваться, в одной из больших комнат: первая комната против часовой стрелки, начиная от лестницы. Он сине-фиолетового цвета».~
@46441 = ~«Спасибо. Прощай».~
@46442 = ~«Хорошо. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: первая комната по часовой стрелке, начиная от лестницы. Он желто-зеленого цвета».~
@46443 = ~«Спасибо. Прощай».~
@46444 = ~«Хороший выбор. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: вторая комната по часовой стрелке, начиная от лестницы. Он светло-голубого цвета».~
@46445 = ~«Спасибо. Прощай».~
@46446 = ~«Хороший выбор. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: третья комната по часовой стрелке, начиная от лестницы. Он фиолетового цвета».~
@46447 = ~«Спасибо. Прощай».~
@46448 = ~«Хороший выбор. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: четвертая комната по часовой стрелке, начиная от лестницы. Он желто-зеленого цвета».~
@46449 = ~«Спасибо. Прощай».~
@46450 = ~«Хороший выбор. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: пятая комната по часовой стрелке, начиная от лестницы. Он красно-оранжевого цвета».~
@46451 = ~«Спасибо. Прощай».~
@46452 = ~«Хороший выбор. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: шестая комната по часовой стрелке, начиная от лестницы. Он фиолетового цвета».~
@46453 = ~«Спасибо. Прощай».~
@46454 = ~«Хороший выбор. Камень, которым вы хотите воспользоваться, в одной из маленьких комнат: седьмая комната по часовой стрелке, начиная от лестницы. Он светло-голубого цвета».~
@46455 = ~«Спасибо. Прощай».~
@46456 = ~«Надеюсь, чувственный опыт пришелся вам по душе? Могу ли я быть еще чем-нибудь полезен?»~
@46457 = ~«Я хотел бы попробовать что-нибудь еще».~
@46458 = ~«Я хотел бы попробовать что-нибудь еще».~
@46459 = ~«У меня есть несколько вопросов...» ~
@46460 = ~«Ничего. Прощай».~
@46461 = ~«Теперь это не моя проблема. Шкатулка магически привязана к тебе до тех пор, пока она не будет доставлена. Советую тебе доставить ее хоть кому-то! И не подходи ко мне до тех пор, пока не избавишься от этой штуки!»~
@46462 = ~Кажется, теперь ты предоставлен сам себе. Куатраа ведь упоминал, что шкатулку нужно доставить кому-то еще?~
@46463 = ~Черт возьми, что же в этой шкатулке...~
@46464 = ~Мар в страхе отскакивает. «Нет! Я больше не притронусь этой проклятой шкатулке! Убери ее от меня! Ты добровольно взял шкатулку. Держи ее при себе или отдай кому-нибудь другому — теперь это не моя забота. Но я скажу тебе одну вещь: я лучше сдохну, чем снова свяжусь с этой шкатулкой! А теперь оставь меня в покое!»~
@46465 = ~«Как только я разберусь с этой шкатулкой, я вернусь и разберусь с тобой. Прощай».~
@46466 = ~«Я уже сказал все, что можно было сказать».~
@46467 = ~«Прощай».~
@46468 = ~«Очень приятно слышать это от тебя. До того, как ты меня убьешь за то, что я тебя обманом всучил тебе эту шкатулку, позволь мне все объяснить...»~
@46469 = ~«Ты — покойник».~
@46470 = ~«Я слушаю твои объяснения».~
@46471 = ~«Эта шкатулка была здесь с незапамятных времен, никто не помнит, как она появилась здесь. Поговаривают, что здесь была какая-то битва, а когда она закончилась, в эту шкатулку был заточен огромный демон. Другие говорят, что ее сделал злой волшебник, просто чтобы другим было плохо. Никто доподлинно не знает, что на самом деле таится за этой шкатулкой. Но все равно, если ее хозяин ее открывает — он умирает».~
@46472 = ~«А почему бы хозяину просто не спрятать шкатулку там, где ее никто не найдет?»~
@46473 = ~«Ничего не хочу об этом слышать. Как мне избавиться от нее?»~
@46474 = ~«Ну да, это вроде бы самое простое из всех решений. Да только кто сможет жить с этим смертельным проклятием над головой? Ведь надо все время проверять, чтобы эта чертова шкатулка никуда не пропала. Это любого сведет с ума».~
@46475 = ~«Почему я?»~
@46476 = ~«Во-первых, потому что я тебя раньше не видел. Видишь ли, мне нужен был пустоголовый пень вроде тебя, который бы *согласился* взять шкатулку и стать ее новым хозяином. Все здешние знают про эту шкатулку и ни за какие коврижки ее не возьмут. Во-вторых, если бы ты осмотрел ее как следует, ты бы заметил, что магия, наложенная на нее, слабеет. Я, как нынешний владелец шкатулки, должен был избавится от нее как можно скорее. Да и вообще, ты больше всех смахивал на того, кому уже пора в другой мир».~
@46477 = ~«Хочешь поговорить о другом мире? Еще слово — и сам туда отправишься».~
@46478 = ~«Кажется, я выбрал не того рубаку. Это ведь не причинило никаких неудобств такому как ты? В награду за причиненное беспокойство я могу предложить это оружие и немного звенелок для твоего кошелька. Это все, что у меня есть... забавно: все это мне дал тот крысеныш Куатраа, когда пытался всучить шкатулку».~
@46479 = ~«Я все равно убью тебя и заберу награду».~
@46480 = ~«Давай мне награду и уходи».~
@46481 = ~«Людям в округе станет легче на душе, когда они узнают, что ты уничтожил эту проклятую шкатулку. Спасибо тебе еще раз!»~
@46482 = ~«Рад был помочь. Прощай».~
@46483 = ~«Ты тупой идиот! Я же говорил тебе не покидать Улей! Быстрее, убирайся от меня подальше, пока оно не пришло за тобой!»~
@46484 = ~Мар убегает.~
@46485 = ~«Ты открыл шкатулку и все еще жив, чтобы рассказать мне об этом! Э-э... то есть, я же говорил тебе не открывать эту проклятую штуку. Ты не смог доставить шкатулку владельцу, поэтому боюсь, что ты ничего не получишь. А теперь убирайся вон с глаз моих».~
@46486 = ~«Прощай».~
@46487 = ~«Прощай».~
@46488 = ~«Я же предупреждал тебя не покидать Улей вместе с этой шкатулкой. Удивительно, как этот нечистый дух не порвал тебя на тряпки. И если ты пришел ко мне за оплатой, то я скажу тебе, что ты ее не получишь! Согласно сделке, ты должен был доставить шкатулку, а не убить нечистого, который был внутри».~
@46489 = ~«Прощай».~
@46490 = ~«Я уже сказал все, что можно было сказать».~
@46491 = ~«Прощай».~
@46492 = ~~
@46493 = ~Осмотреть объявление о приеме на работу.~
@46494 = ~~
@46495 = ~~
@46496 = ~Использовать на трупе свою способность «История костей».~
@46497 = ~Оставить труп в покое.~
@46498 = ~«ТРЕБУЕТСЯ: Крепкий человек, желающий расследовать дело безотлагательной важности для тленных. При успешном выполнении запрошенного задания будет выплачена соразмерная компенсация. Заинтересованным просьба встретиться с посвященным Норочжем в Баре собирателей пыли».~
@46499 = ~«Бар собирателей пыли?»~
@46500 = ~Зомби немедленно поднимает левую руку и указывает на здание перед тобой. Спустя мгновенье рука падает назад с сочным шлепком.~
@46501 = ~Осмотреть труп. ~
@46502 = ~Осмотреть труп. ~
@46503 = ~Осмотреть другие объявления...~
@46504 = ~Использовать на трупе свою способность «История костей».~
@46505 = ~Оставить труп в покое.~
@46506 = ~Осмотреть труп. ~
@46507 = ~Осмотреть труп. ~
@46508 = ~Осмотреть другие объявления.~
@46509 = ~Использовать на трупе свою способность «История костей».~
@46510 = ~«Э... Спасибо».~
@46511 = ~Ты видишь худого как тросточка человека в грязной черной мантии. Жесткие черные волосы шипастой короной окружают его голову, а белая, как у прокаженного, кожа лица сильно выделяется из общего образа. Он хмуро уставился на свою выпивку, что-то бормоча себе под нос. ~
@46512 = ~Ты видишь худого как тросточка тленного в грязной черной мантии. Жесткие черные волосы шипастой короной окружают его голову, а белая, как у прокаженного, кожа лица сильно выделяется из общего образа. Он хмуро уставился на свою выпивку, что-то бормоча себе под нос. ~
@46513 = ~Ты видишь Норочжа. Он вытянул одну из своих прядей и чешет ею прыщ на своем лице. Ты не можешь удержаться от мысли, что дреды ему подошли бы гораздо лучше. ~
@46514 = ~Тленный поднимает взгляд, моргает, затем осматривает тебя с ног до головы. Изучая тебя, он хватает один из своих прядей и указывает ею на себя. «Норочж. Посвященный. Тленный. Стражник».~
@46515 = ~Норочж качает головой, а затем снова возвращается к своей выпивке.~
@46516 = ~Норочж касается своего лица, проводя по морщинам пальцем. «Проблемы, да».~
@46517 = ~Тленный осматривает тебя с ног до головы. «Проблем много у меня. Помочь можешь ты. В мавзолее неспокойно, мертвые ходят, мертвые потревожены, тленные потревожены. Найди то, что нежить тревожит, и медяками я награжу».~
@46518 = ~Норочж кивает. «Найти его не могу я. Важно очень это для тленных».~
@46519 = ~Норочж снова кивает. «За то, что мои проблемы стали твоими, медяками платить готов я. Найди не-тленного, разберись с ним, потом возвращайся. Норочж ждать будет».~
@46520 = ~При этих словах с Норочжа спадает пелена озабоченности. «Тебя благодарю я». Он роется в мантии и вытаскивает небольшой мешочек, который протягивает тебе. «Медные монеты. Сто».~
@46521 = ~При этих словах с Норочжа спадает пелена озабоченности. «Тебя благодарю я». Он роется в мантии и вытаскивает небольшой мешочек, который протягивает тебе. «Медные монеты. Двести».~
@46522 = ~При этих словах с Норочжа спадает пелена озабоченности. «Тебя благодарю я». Он роется в мантии и вытаскивает небольшой мешочек, который протягивает тебе. «Медные монеты. Триста. И... — он снова роется в мантии и достает моток бинтов, — бинты эти тебе нужны больше, чем мне, по виду судя». ~
@46523 = ~«Эморик отправил тебя ко мне...» Он изучает тебя, затем вздыхает и указывает на себя. «Норочж — тленный. Стражник. Служу интересам тленных, защищаю интересы тленных, оберегаю *репутацию* тленных, — он снова вздыхает. — Воров в Улье много. Один вор одевается тленным, но не тленный он».~
@46524 = ~Норочж кивает. «Мавзолей за мемориалом тленных. Иди на север и запад от черного монумента, подойди к арке и сделай полукруг над сердцем этим пальцем, — он поднимет указательный палец правой руки, — в мавзолей тогда попадешь ты».~
@46525 = ~Норочж вздыхает, хватая одну из своих прядей. «Тленные поклялись не входить в мавзолей. Поклялись мертвым. Не могут. Только не-тленные могут входить».~
@46526 = ~«Приветствую».~
@46527 = ~«Норочж?»~
@46528 = ~Оставить его в покое.~
@46529 = ~«Приветствую».~
@46530 = ~«Норочж?»~
@46531 = ~Оставить его в покое.~
@46532 = ~«Я выяснил, что произошло в мавзолее. Теперь мертвые снова спят».~
@46533 = ~«Я выяснил, что произошло в мавзолее. Теперь мертвые снова спят».~
@46534 = ~«Я выяснил, что произошло в мавзолее. Теперь мертвые снова спят».~
@46535 = ~«Я нашел... не-тленного. Больше он не будет обчищать карманы в этом городе».~
@46536 = ~«Я нашел... не-тленного. Больше он не будет обчищать карманы в этом городе».~
@46537 = ~«Я нашел... не-тленного. Больше он не будет обчищать карманы в этом городе».~
@46538 = ~«Я нашел... не-тленного. После смерти он стал слишком занят, чтобы обчищать чьи-то карманы».~
@46539 = ~«Я нашел... не-тленного. После смерти он стал слишком занят, чтобы обчищать чьи-то карманы».~
