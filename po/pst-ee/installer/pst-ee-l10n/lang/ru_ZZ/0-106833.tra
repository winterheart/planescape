@27562 = ~«Ты говорил, что она полунечисть?»~
@27563 = ~«Где находится этот антикварный магазин?»~
@27564 = ~«Я хочу спросить о другом месте...»~
@27565 = ~«У меня есть другие вопросы...»~
@27566 = ~«Это все, что я хотел узнать. Прощай».~
@27567 = ~«Ты сказал, что ее товары с Нижних планов?»~
@27568 = ~«Где находится этот антикварный магазин?»~
@27569 = ~«Я хочу спросить о другом месте...»~
@27570 = ~«У меня есть другие вопросы...»~
@27571 = ~«Это все, что я хотел узнать. Прощай».~
@27572 = ~«Понятно. Продолжай».~
@27573 = ~«У меня есть другие вопросы...»~
@27574 = ~«Это все, что я хотел узнать. Прощай».~
@27575 = ~«Сенсориумы?»~
@27576 = ~«У меня есть другие вопросы...»~
@27577 = ~«Это все, что я хотел узнать. Прощай».~
@27578 = ~«Где находятся эти сенсориумы?»~
@27579 = ~«Эти переживания... это что-то вроде воспоминаний?»~
@27580 = ~«У меня есть другие вопросы...»~
@27581 = ~«Это все, что я хотел узнать. Прощай».~
@27582 = ~«Где находится Фестхолл?»~
@27583 = ~«Эти переживания... это что-то вроде воспоминаний?»~
@27584 = ~«У меня есть другие вопросы...»~
@27585 = ~«Это все, что я хотел узнать. Прощай».~
@27586 = ~«Заключены? Разве память или переживания не теряются, если поместить их в камень?»~
@27587 = ~«Где находятся эти сенсориумы?»~
@27588 = ~«У меня есть другие вопросы...»~
@27589 = ~«Это все, что я хотел узнать. Прощай».~
@27590 = ~«У меня есть другие вопросы...»~
@27591 = ~«Это все, что я хотел узнать. Прощай».~
@27592 = ~«Неважно. У меня есть другие вопросы...»~
@27593 = ~«Тогда неважно. Прощай».~
@27594 = ~«Именно так».~
@27595 = ~«На самом деле, нет... просто проходил мимо. Прощай».~
@27596 = ~«Я сказал, что я мертв! Мертв, мертв, ха-ха! Мертв, мертв, ха-ха...»~
@27597 = ~«Неважно. У меня есть другие вопросы...»~
@27598 = ~«Неважно. Прощай».~
@27599 = ~«Стой! Я ведь еще не сказал, *почему* я мертв...»~
@27600 = ~«Постой. У меня есть несколько вопросов...» ~
@27601 = ~«Тогда прощай». ~
@27602 = ~«Потому что я убил слишком много людей в своих прошлых жизнях».~
@27603 = ~«Тогда неважно. У меня есть другие вопросы...»~
@27604 = ~«Тогда прощай». ~
@27605 = ~Напасть на его.~
@27606 = ~Попытаться уйти до того, как кто-нибудь подоспеет.~
@27607 = ~«Каким образом?»~
@27608 = ~«У меня есть другие вопросы...»~
@27609 = ~«Это все, что я хотел узнать. Прощай».~
@27610 = ~«Не могу найти никакой работы».~
@27611 = ~«Ой, да ладно! Я бы даже во сне это смог выбросить не меньше девяти раз!»~
@27612 = ~«Вокруг так много мусора».~
@27613 = ~«Вот бы выпить чего-нибудь».~
@27614 = ~«Вот бы поесть чего-нибудь».~
@27615 = ~*Хрипит*~
@27616 = ~*Кашляет*~
@27617 = ~«Похоже, ночка будет холодной».~
@27618 = ~«Ну хорошо! Ты уверен, что у ТЕБЯ хватит медяков? Ха-ха-ха!»~
@27619 = ~Эта огромная фигура в красных доспехах стоит на месте, внимательно наблюдая за прохожими. Ты смутно припоминаешь, что его украшенная броня выдает в нем офицера Гармониума, из тех, что обеспечивают защиту правопорядка в городе.~
@27620 = ~Оставить его в покое.~
@27621 = ~Его глаза смотрят скорее на обитателей района, чем на тебя, когда он произносит: «Проходи».~
@27622 = ~Хотя большая часть его внимания все еще прикована к прохожим, он находит момент, чтобы взглянуть тебе в глаза. «Тебе здесь делать нечего. Проходи».~
@27623 = ~Он качает головой. «Тогда поговори с горожанами. У меня здесь служба... и я не стану ею пренебрегать, разговаривая с тобой или кем-то еще. А теперь проходи».~
@27624 = ~Он поднимает свое оружие. «Нужна помощь? Совершено преступление?»~
@27625 = ~Он вздыхает. «Я понимаю, что у тебя есть вопросы, и в другом месте и в другое время я бы не отказался тебе помочь. Но...» Он останавливается, чтобы глянуть на какого-то подозрительного типа, проходящего мимо, потом возвращается к тебе. «Но сейчас не то время и место... просто уходи. Сейчас же».~
@27626 = ~«Слушай, пень, мне...» Он останавливается, чтобы глянуть на какого-то подозрительного типа, проходящего мимо, потом возвращается к тебе. «Мне назначены определенные задачи, и я не смогу выполнить их, болтая с какими-то пустоголовыми бедолагами, которые ищут что-то или хотят пройти куда-то. Проходи».~
@27627 = ~Он пожимает плечами; его броня звенит от этого движения. «Ты волен стоять здесь, но не стоит надоедать закону. Советую тебе уйти, пока не приключилось никакой... беды. Прощай».~
@27628 = ~Этот офицер Гармониума наблюдает за улицей и людьми вокруг себя в поисках любых признаков неприятностей. Тебе кажется, что ты уже встречал этого человека раньше, но из-за большого шлема и одинаковой брони Гармониума их трудно различать между собой.~
@27629 = ~Ты узнаешь в этом человеке члена Гармониума, фракции, которая в последнее время разыскивает тебя. Похоже, он тебя еще не заметил.~
@27630 = ~Сквозь щели в его шлеме ты видишь, как его глаза расширяются. «Это он!» Он готовится напасть на тебя, крича: «Взять его, живым или мертвым!»~
@27631 = ~«Приветствую...»~
@27632 = ~«Приветствую...»~
@27633 = ~«У меня есть несколько вопросов...» ~
@27634 = ~Уйти.~
@27635 = ~«Мне нужно всего лишь несколько ответов...»~
@27636 = ~«Мне нужна твоя помощь...»~
@27637 = ~«А что, если мне нравится здесь стоять?»~
@27638 = ~Уйти.~
@27639 = ~«Но мне нужна твоя помощь...»~
@27640 = ~«А что, если мне нравится здесь стоять?»~
@27641 = ~Уйти.~
@27642 = ~«Ну... нет. Просто у меня есть пара вопросов».~
@27643 = ~«Ну... нет. Просто у меня есть пара вопросов».~
@27644 = ~«Нет, забудь об этом. Прощай»~
@27645 = ~«А что, если мне нравится здесь стоять?»~
@27646 = ~Уйти.~
@27647 = ~«А что, если мне нравится здесь стоять?»~
@27648 = ~Уйти.~
@27649 = ~Уйти.~
@27650 = ~«Приветствую...»~
@27651 = ~Оставить офицера в покое.~
@27652 = ~Уйти, пока он тебя не заметил.~
@27653 = ~Защищаться.~
@27654 = ~Эта хорошо одетая женщина отдыхает, наслаждаясь свежим воздухом и потягивая напиток, купленный в кафе неподалеку.~
@27655 = ~«Приветствую...»~
@27656 = ~«Приветствую...»~
@27657 = ~«Приветствую...»~
@27658 = ~Оставить женщину в покое.~
@27659 = ~Ее глаза немного расширяются, когда она замечает твое приближение. «А... приветствую вас, сэр». Она натянуто улыбается.~
@27660 = ~«У меня есть несколько вопросов...»~
@27661 = ~«Что-то не так с моим внешним видом?»~
@27662 = ~«Я должен идти. Прощай».~
@27663 = ~«Мне... мне неловко признать, что ваш вид меня просто ошарашил. Нечасто приходится общаться с людьми с такой... потрепанной... внешностью, — она с извиняющимся видом склоняет голову. — Надеюсь, я не обидела вас, сэр».~
@27664 = ~«Потрепанной?»~
@27665 = ~«У меня есть несколько вопросов...»~
@27666 = ~«Не беспокойся. Мне уже пора. Прощай».~
@27667 = ~«Быть может, 'бывалая' будет более подходящим словом? Ваша внешность, сэр... она, э, слегка потрепана. Должно быть, это несколько выделяет вас, вот и все. Но ведь Сигил полон странностей, не так ли? Просто Чиновничий район видел их меньше, чем остальная часть Сигила. Не учитывая Фестхолла, конечно».~
@27668 = ~«Чиновничий район?»~
@27669 = ~«Фестхолл?»~
@27670 = ~«Ты имеешь в виду, что я выгляжу как мертвый, так? Да, так и есть. Я мертвый!»~
@27671 = ~«Хм-м. У меня есть вопрос...»~
@27672 = ~«Кажется, понимаю. Прощай».~
@27673 = ~Она кивает. «Пожалуйста, задавайте».~
@27674 = ~«Что это за место?»~
@27675 = ~«Здесь есть что-нибудь интересное?»~
@27676 = ~«Где здесь можно найти работу?»~
@27677 = ~«Я хотел спросить об одном конкретном месте...»~
@27678 = ~«Мне просто нужно сориентироваться...»~
@27679 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@27680 = ~«Впрочем, не важно. Прощай».~
@27681 = ~Она присматривается, не шутишь ли ты, и, осознав, что ты говоришь всерьез, издает сдержанный смешок. «Вы в Чиновничьем районе, сэр».~
@27682 = ~«Что ты можешь рассказать об этом районе?»~
@27683 = ~«И то правда. На самом деле, у меня были еще вопросы...»~
@27684 = ~«Это все, что я хотел узнать. Прощай».~
@27685 = ~«Ну, большая часть района - там, где я бываю чаще всего в силу своих обязанностей - отведена под архивы и административные здания... правда, они в другой части района».~
@27686 = ~«Своих обязанностей?»~
@27687 = ~«Чем выделяется эта часть района?»~
@27688 = ~«У меня есть другие вопросы...»~
@27689 = ~«Это все, что я хотел узнать. Прощай».~
@27690 = ~«Конечно же, Городским Фестхоллом. И еще художественной галереей...»~
@27691 = ~«Продолжай...»~
@27692 = ~«У меня есть другие вопросы...»~
@27693 = ~«Это все, что я хотел узнать. Прощай».~
@27694 = ~«Из других интересных местечек - дом адвоката, аптека, Бордель утоления интеллектуальной страсти, катакомбы под районом и мастерская портного. И еще тот странный антикварный магазинчик».~
@27695 = ~«У меня есть другие вопросы...»~
@27696 = ~«Это все, что я хотел узнать. Прощай».~
@27697 = ~«Вы ищите временную работу, правильно? Похоже, вы не собираетесь здесь задерживаться... — она умолкает на секунду, осматривая тебя. — Что ж, я бы поспрашивала у адвоката, в аптеке или в Городском Фестхолле. Там для вас, несомненно, найдется какая-нибудь случайная работа».~
@27698 = ~«У меня есть другие вопросы...»~
@27699 = ~«Это все, что я хотел узнать. Прощай».~
@27700 = ~Она кивает, закатив глаза. «Моих обязанностей, сэр. Перед моим работодателем. Я работаю в одном из бесчисленных административных зданий этого района».~
@27701 = ~«Чем ты там занимаешься?»~
@27702 = ~«Так что же выделяет эту часть района?»~
@27703 = ~«У меня есть другие вопросы...»~
@27704 = ~«Это все, что я хотел узнать. Прощай».~
@27705 = ~«Пожалуйста, сэр, сделайте мне одолжение — не поднимайте эту тему, хорошо? — она улыбается, качая головой. — Только не здесь — здесь я пытаюсь хоть немного отдохнуть».~
@27706 = ~«Так что же выделяет эту часть района?»~
@27707 = ~«У меня есть другие вопросы...»~
@27708 = ~«Это все, что я хотел узнать. Прощай».~
@27709 = ~«Я расскажу все, что знаю...»~
@27710 = ~«Дом адвоката».~
@27711 = ~«Дом адвоката».~
@27712 = ~«Аптека».~
@27713 = ~«Художественная галерея».~
@27714 = ~«Бордель».~
@27715 = ~«Бордель».~
@27716 = ~«Подсигилье, Подземное царство».~
@27717 = ~«Городской Фестхолл».~
@27718 = ~«Антикварный магазин».~
@27719 = ~«Мастерская портного».~
@27720 = ~«Неважно. Позволь спросить кое о чем еще...»~
@27721 = ~«Ничего, неважно. Прощай».~
@27722 = ~«Адвокаты помогают в спорных делах, готовят официальные документы и действуют в качестве законных представителей своих клиентов. Один из них, Янис, живет неподалеку отсюда. Он весьма уважаем и заслуживает доверия. Он живет и работает в районе с очень давних пор».~
@27723 = ~«Как мне добраться до дома Яниса?»~
@27724 = ~«Я хочу спросить о другом месте...»~
@27725 = ~«У меня есть другие вопросы...»~
@27726 = ~«Это все, что я хотел узнать. Прощай».~
@27727 = ~«Адвокаты помогают в спорных делах, готовят официальные документы и действуют в качестве законных представителей своих клиентов».~
@27728 = ~Этот массивный человек в красных доспехах стоит на месте, очевидно, охраняя лестницу за собой. Ты смутно припоминаешь, что его украшенная броня указывает на офицера Гармониума, фракции, поддерживающей в городе порядок.~
@27729 = ~«Один из них, Янис, живет неподалеку отсюда. Он весьма уважаем и заслуживает доверия. Он живет и работает в районе с очень давних пор».~
@27730 = ~«Как мне добраться до дома Яниса?»~
@27731 = ~«Я хочу спросить о другом месте...»~
@27732 = ~«У меня есть другие вопросы...»~
@27733 = ~«Это все, что я хотел узнать. Прощай».~
@27734 = ~«В аптеке продают различные мази, снадобья, травы и тому подобное, — на секунду она нахмуривается. — Хозяева немного чокнутые, постоянно испытывают на себе свои товары. Хотя ребята они неплохие».~
@27735 = ~«Как мне попасть в аптеку?»~
@27736 = ~«Я хочу спросить о другом месте...»~
@27737 = ~«У меня есть другие вопросы...»~
@27738 = ~«Это все, что я хотел узнать. Прощай».~
@27739 = ~«Художественная галерея Иваны — просто захватывающее место. У нее собрана коллекция редчайших предметов искусства со всех планов».~
@27740 = ~«Как мне попасть в художественную галерею?»~
@27741 = ~«Я хочу спросить о другом месте...»~
@27742 = ~«У меня есть другие вопросы...»~
@27743 = ~«Это все, что я хотел узнать. Прощай».~
@27744 = ~«Заведение чувствующих, которое создано для ублажения человеческого ума и чувств. Им управляет суккуб по имени Падшая Грация, и весьма надлежаще».~
@27745 = ~«Чувствующих?»~
@27746 = ~«Как мне попасть в Бордель?»~
@27747 = ~«Я хочу спросить о другом месте...»~
@27748 = ~«У меня есть другие вопросы...»~
@27749 = ~«Это все, что я хотел узнать. Прощай».~
@27750 = ~«Заведение чувствующих, которое создано для ублажения человеческого ума и чувств. Им управляет суккуб, и весьма надлежаще», — она вежливо кивает Падшей Грации.~
@27751 = ~«Чувствующих?»~
@27752 = ~«Как мне попасть в Бордель?»~
@27753 = ~«Я хочу спросить о другом месте...»~
@27754 = ~«У меня есть другие вопросы...»~
@27755 = ~«Это все, что я хотел узнать. Прощай».~
@27756 = ~[no text]~
@27757 = ~[no text]~
@27758 = ~На ее лице появляется встревоженный взгляд. «Я нахожу весьма странным тот факт, что ни один из входов в это место не был закрыт. Насколько я понимаю, Подземное царство полно опасностей, угрожающих всем, кто туда попадает».~
@27759 = ~«Как мне туда попасть?»~
@27760 = ~«Я хочу спросить о другом месте...»~
@27761 = ~«У меня есть другие вопросы...»~
@27762 = ~«Это все, что я хотел узнать. Прощай».~
@27763 = ~«Одно из самых удивительных заведений Сигила... Это штаб-квартира фракции чувствующих, известная по всей мультивселенной своими концертами, выставками и лекциями. Однако самое удивительное у них — это их сенсориумы».~
@27764 = ~«Чувствующих?»~
@27765 = ~«Сенсориумы?»~
@27766 = ~«Где находится Фестхолл?»~
@27767 = ~«Я хочу спросить о другом месте...»~
@27768 = ~«У меня есть другие вопросы...»~
@27769 = ~«Это все, что я хотел узнать. Прощай».~
@27770 = ~«Не могу похвастаться, что я там бывала, но насколько я понимаю, им заправляет какая-то поставщица товаров... по сути, она полунечисть, чьи товары приходят с Нижних планов».~
@27771 = ~«Полунечисть?»~
@27772 = ~«Нижних планов?»~
@27773 = ~«Где можно найти это место?»~
@27774 = ~«Я хочу спросить о другом месте...»~
@27775 = ~«У меня есть другие вопросы...»~
@27776 = ~«Это все, что я хотел узнать. Прощай».~
@27777 = ~«Гонсалвис — великолепный портной, вот только у него пылкий нрав, и его легко обидеть. Должна предупредить вас, сэр: он судит людей по одежке, так что вам будет очень трудно с ним сдружиться».~
@27778 = ~«Где находится мастерская Гонсалвиса?»~
@27779 = ~«Я хочу спросить о другом месте...»~
@27780 = ~«У меня есть другие вопросы...»~
@27781 = ~«Это все, что я хотел узнать. Прощай».~
@27782 = ~«О? Куда?»~
@27783 = ~«Дом адвоката».~
@27784 = ~«Аптека».~
@27785 = ~«Художественная галерея».~
@27786 = ~«Бордель».~
@27787 = ~«Подсигилье, Подземное царство».~
@27788 = ~«Городской Фестхолл».~
@27789 = ~«Антикварный магазин».~
@27790 = ~«Мастерская портного».~
@27791 = ~«Неважно. Позволь спросить кое о чем еще...»~
@27792 = ~«Ничего, неважно. Прощай».~
@27793 = ~«Дом Яниса находится на юге от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Он будет на восточной стороне дороги».~
@27794 = ~«Что ты можешь рассказать об адвокате?»~
@27795 = ~«Что ты можешь рассказать об адвокате?»~
@27796 = ~«Спасибо. Позволь спросить о другом...»~
@27797 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27798 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к востоку от дороги. У нее фасад с южной стороны и три витражных окна».~
@27799 = ~«Что ты можешь рассказать об это месте?»~
@27800 = ~«Спасибо. Позволь спросить о другом...»~
@27801 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27802 = ~«Идите по дороге на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. На развилке сворачивайте на юг... там ее и найдете, к западу от дороги. Ее фасад обращен на юг, а черепица на крыше привалена крупными камнями».~
@27803 = ~«Что ты знаешь об этом месте?»~
@27804 = ~«Спасибо. Позволь спросить о другом...»~
@27805 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27806 = ~Она подчеркнуто хмурится, покачивая головой: «Это прямо на восток от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Большое круглое здание, вход - с юга».~
@27807 = ~«Что ты можешь сказать о Борделе?»~
@27808 = ~«Что ты можешь сказать о Борделе?»~
@27809 = ~«Спасибо. Позволь спросить о другом...»~
@27810 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27811 = ~Она пожимает плечами. «Не знаю. Однако если бы я нашла туда вход, я была бы весьма осторожной. Говорят, что еще никто не выходил из Подземного царства... включая тех, кто туда зашел».~
@27812 = ~«Что еще ты можешь сказать о нем?»~
@27813 = ~«Спасибо. Позволь спросить о другом...»~
@27814 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27815 = ~«Найти Фестхолл легче всего, сэр. Это огромное здание в северо-восточной части этого района».~
@27816 = ~«Что ты можешь рассказать о Фестхолле?»~
@27817 = ~«Спасибо. Позволь спросить о другом...»~
@27818 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27819 = ~«Он находится здесь, в юго-восточной части. Необычное здание, к нему ведет широкая лестница. Сама я никогда туда не ходила... От него мне становится не по себе».~
@27820 = ~«Что ты знаешь об этом месте?»~
@27821 = ~«Спасибо. Позволь спросить о другом...»~
@27822 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27823 = ~«Мастерская портного находится на северо-востоке от ворот в Нижний район, через которые вы, скорее всего, сюда и вошли. Это длинное здание, вход — с юга».~
@27824 = ~«Что ты можешь сказать об этом месте?»~
@27825 = ~«Спасибо. Позволь спросить о другом...»~
@27826 = ~«Понятно. Спасибо за уделенное время. Прощай».~
@27827 = ~Кивнув, она говорит шепотом: «Ну, знаете, сэр... Баатор, Бездна и тому подобное. Ужасные места».~
@27828 = ~«Ты говорила, что она полунечисть?»~
@27829 = ~«Где находится этот антикварный магазин?»~
@27830 = ~«Я хочу спросить о другом месте...»~
@27831 = ~«У меня есть другие вопросы...»~
@27832 = ~«Это все, что я хотел узнать. Прощай».~
@27833 = ~«Заметьте, не тифлинг, а настоящая полунечисть. Дочь инкуба и смертной женщины. Не хочу разносить сплетни, так что давайте не будем о ней говорить».~
@27834 = ~«Ты сказала, что ее товары с Нижних планов?»~
@27835 = ~«Где находится этот антикварный магазин?»~
@27836 = ~«Я хочу спросить о другом месте...»~
@27837 = ~«У меня есть другие вопросы...»~
@27838 = ~«Это все, что я хотел узнать. Прощай».~
@27839 = ~«Да. Их правильное название — 'Общество чувств'. Они верят, что истинную сущность мультивселенной можно постичь только с помощью непосредственных переживаний...»~
@27840 = ~«Понятно. Продолжай».~
@27841 = ~«У меня есть другие вопросы...»~
@27842 = ~«Это все, что я хотел узнать. Прощай».~
@27843 = ~«Они нашли способ делиться своими ощущениями с другими с помощью сенсориумов».~
@27844 = ~«Сенсориумы?»~
@27845 = ~«У меня есть другие вопросы...»~
@27846 = ~«Это все, что я хотел узнать. Прощай».~
@27847 = ~«Чувствующие создали средства, с помощью которых они могут сохранять свои переживания в камнях, что позволяет делиться ими с *другими*. Чувствующие странствуют по планам в поисках новых ощущений, чтобы потом делиться ими... практически все, что они чувствовали или ощущали, находится в их сенсориумах».~
@27848 = ~«Где находятся эти сенсориумы?»~
@27849 = ~«Эти переживания... это что-то вроде воспоминаний?»~
@27850 = ~«У меня есть другие вопросы...»~
@27851 = ~«Это все, что я хотел узнать. Прощай».~
@27852 = ~«В Городском Фестхолле. Там есть сенсориумы, открытые для всех, и сенсориумы, доступные только чувствующим. За их использование взимают небольшую плату, но для переживаний это более чем скромная цена».~
@27853 = ~«Где находится Фестхолл?»~
@27854 = ~«Эти переживания... это что-то вроде воспоминаний?»~
@27855 = ~«У меня есть другие вопросы...»~
@27856 = ~«Это все, что я хотел узнать. Прощай».~
@27857 = ~«В *некоторой* степени — да, только очень интенсивные... и в камне заключены не ваши, а чужие воспоминания».~
@27858 = ~«Заключены? Разве память или переживания не теряются, если поместить их в камень?»~
@27859 = ~«Где находятся эти сенсориумы?»~
@27860 = ~«У меня есть другие вопросы...»~
@27861 = ~«Это все, что я хотел узнать. Прощай».~
@27862 = ~«Нет... — она хмурится, — или, по крайней мере, я так думаю. Скорее всего, камень *копирует* чувственный опыт. Я себе это так представляю, но вам лучше расспросить об этом чувствующих для полной уверенности».~
@27863 = ~«У меня есть другие вопросы...»~
@27864 = ~«Это все, что я хотел узнать. Прощай».~
@27865 = ~«Имя звучит знакомо... это персонаж какой-то книги? Уж не злодейка из романа? Не могу вспомнить».~
@27866 = ~«Неважно. У меня есть другие вопросы...»~
@27867 = ~«Тогда неважно. Прощай».~
@27868 = ~«И снова рада встрече, сэр, — улыбается она, глядя на тебя поверх своей чашки, — снова вопросы?»~
@27869 = ~«Точно».~
@27870 = ~«Вообще-то, нет... просто проходил мимо. Прощай».~
@27871 = ~«Что, простите?» — недоуменно спрашивает она.~
@27872 = ~«Я сказал, что я мертв! Мертв, мертв, ха-ха! Мертв, мертв, ха-ха...»~
@27873 = ~«Неважно. У меня есть другие вопросы...»~
@27874 = ~«Неважно. Прощай».~
@27875 = ~Она выглядит встревоженной. «Ах, да... все мы там будем. Я должна идти, сэр. Кажется, у меня осталось одно неотложное дело».~
@27876 = ~«Стой! Я ведь еще не сказал, *почему* я мертв...»~
@27877 = ~«Постой. У меня есть несколько вопросов...» ~
@27878 = ~«Тогда прощай». ~
@27879 = ~Она отступает назад. «Должна признаться, что меня это нисколько не интересует, сэр», — говорит она, озираясь по сторонам в поисках помощи.~
@27880 = ~«Потому что я убил слишком много людей в своих прошлых жизнях».~
@27881 = ~«Тогда неважно. У меня есть другие вопросы...»~
@27882 = ~«Тогда прощай». ~
@27883 = ~Уронив чашку, она кричит: «Стража! Стража!»~
@27884 = ~ Атаковать ее.~
@27885 = ~Попытаться уйти до того, как кто-нибудь подоспеет.~
@27886 = ~«Они посвящают свои жизни переживанию всего, что только можно найти в мультивселенной. Они много путешествуют, как по планам, так и внутри своих мыслей и эмоций. Они пошли еще дальше, знаете ли...»~
@27887 = ~«То есть?»~
@27888 = ~«У меня есть другие вопросы...»~
@27889 = ~«Это все, что я хотел узнать. Прощай».~
@27890 = ~Ее глаза немного расширяются, когда она замечает твое приближение. Она натянуто улыбается. «А... приветствую... — неожиданно ее взгляд останавливается на Морте. — О! Какой симпатичненький мимир!»~
@27891 = ~«Мимир?»~
@27892 = ~«Правда, симпатичный? Ему так нравится, когда ему чешут макушку».~
@27893 = ~«Я бы не советовал его трогать: может укусить».~
@27894 = ~«Да-да. У меня есть несколько вопросов...»~
@27895 = ~«Что-то не так с моим внешним видом?»~
@27896 = ~«Нет. Прощай».~
@27897 = ~Женщина улыбается: «Как мило! Он еще и разговаривает!»~
@27898 = ~«Приветствую...»~
@27899 = ~«Нет, ни одному из тех, кого я видела, — качает она головой, — они же всего лишь предметы, разве не...»~
@27900 = ~Оставить его в покое.~
@27901 = ~«Несомненно, такое возможно». Женщина пожимает плечами.~
@27902 = ~«У меня есть несколько вопросов...»~
@27903 = ~«Я должен идти. Прощай».~
@27904 = ~«Правда? — все еще улыбаясь, недоверчиво спрашивает она. — Должно быть, вы шутите, сэр! Это же мимир...»~
@27905 = ~«То есть? Разве им это не нравится?»~
@27906 = ~«Нет, это правда. Попробуй».~
@27907 = ~«Забудь о нем. У меня есть другие вопросы...»~
@27908 = ~Она протягивает руку и осторожно гладит Морта... который, широко улыбаясь и постоянно тебе подмигивая, все время тычется носом ей в руку. Она натянуто смеется: «Как странно!»~
@27909 = ~«Да... что ж, у меня есть несколько вопросов...»~
@27910 = ~«А разве нет? Прощай».~
@27911 = ~Морт шипит в твое ухо: «Законник-крючкотвор».~
@27912 = ~«Это типа говорящей энциклопедии, шеф. На самом деле, мне не хочется об этом говорить».~
@27913 = ~Морт, многозначительно водя бровями, направляется к женщине. «А еще я могу...»~
@27914 = ~«Хватит, Морт».~
@27915 = ~«Да-да. Хорошо, — Морт закатывает глаза и начинает ворчать. — Тогда уж лучше быть *мертвым*...»~
@27916 = ~«Постой... ты сказала 'разговаривает сам'? А разве обычно они не разговаривают?»~
@27917 = ~«У меня есть несколько вопросов к этой женщине...»~
@27918 = ~Оставить женщину в покое.~
@27919 = ~Морт перебивает ее: «Понимаешь, шеф, есть много признаков *качественного* мимира. Некоторые — например, я — намного лучше других. Более... э-э... 'самосознательные', говоря научным языком».~
@27920 = ~«Хм-м».~
@27921 = ~«Понятно».~
@27922 = ~«Эй! Я всего лишь пытаюсь немного развлечься, шеф!»~
@27923 = ~Человек небрежным жестом указывает в сторону улицы. «Не задерживайтесь, сэр».~
@27924 = ~«Что ты здесь делаешь?»~
@27925 = ~«У меня есть несколько вопросов...» ~
@27926 = ~Уйти.~
@27927 = ~«Здесь не место для вопросов, сэр. Проходите».~
@27928 = ~«Что ты здесь делаешь?»~
@27929 = ~«Мне нужна всего-навсего пара ответов...»~
@27930 = ~«Мне нужна помощь...»~
@27931 = ~«А что, если мне хочется здесь стоять?»~
@27932 = ~Уйти.~
@27933 = ~Он качает головой. «Тогда поговорите с горожанами. У меня здесь работа... и я не стану пренебрегать ею ради разговора с вами или кем-нибудь другим, сэр. А теперь уходите».~
@27934 = ~«Можешь хотя бы сказать, что ты здесь делаешь?»~
@27935 = ~«Но мне нужна твоя помощь...»~
@27936 = ~«А что, если мне хочется здесь стоять?»~
@27937 = ~Уйти.~
@27938 = ~Он поднимает свое оружие. «Нужна помощь? Совершено преступление?»~
@27939 = ~«В общем... нет. Просто у меня есть парочка вопросов».~
@27940 = ~«В общем... нет. Просто у меня есть парочка вопросов».~
@27941 = ~«Нет, не бери в голову. Прощай».~
@27942 = ~Он вздыхает. «Я понимаю, что у вас есть вопросы, и я буду рад вам помочь, но не здесь и не сейчас. Сейчас... — он останавливается, чтобы с подозрением глянуть на лестницу, — не время и не место, так что... просто уходите, сэр. Сейчас же».~
@27943 = ~«Можешь хотя бы сказать, что ты здесь делаешь?»~
@27944 = ~«А что, если мне хочется здесь стоять?»~
@27945 = ~Уйти.~
@27946 = ~«Слушай, пень, у меня... — он прерывается, чтобы с подозрением взглянуть на лестницу, затем переключает внимание на тебя. — У меня есть дела, и мне их не закончить, пока я болтаю с каким бестолковым бедолагой, который ищет то-то или хочет попасть туда-то. Проходите».~
@27947 = ~«Можешь хотя бы сказать, что ты здесь делаешь?»~
@27948 = ~«А что, если мне хочется здесь стоять?»~
@27949 = ~Уйти.~
@27950 = ~Он пожимает плечами, от движения его броня бряцает. «Вы вольны оставаться тут, но не за тем, чтобы докучать закону. Советую вам уйти, пока не приключилось каких-нибудь... неприятностей. Прощайте».~
@27951 = ~«Можешь хотя бы сказать, что ты здесь делаешь?»~
@27952 = ~Уйти.~
@27953 = ~Этот офицер Гармониума, похоже, охраняет лестницу за ним. Тебе кажется, что ты уже с ним пересекался, но из-за огромного шлема и одинаковых доспехов Гармониума их трудно различать между собой.~
@27954 = ~«Приветствую...»~
@27955 = ~Оставить офицера в покое.~
@27956 = ~Ты узнаешь в этом человеке члена Гармониума, фракции, которая с недавних пор пытается тебя схватить. Похоже, он еще тебя не заметил.~
@27957 = ~«Приветствую...»~
@27958 = ~Уйти до того, он обратит на тебя внимание.~
@27959 = ~Сквозь щели в шлеме ты видишь, как его глаза расширяются. «Это он!» Он готовится к нападению, рыча: «Взять его, живым или мертвым!»~
@27960 = ~Защищаться.~
@27961 = ~Он указывает на лестницу возле него, которая, по всей видимости, спускается прямо под город. «Охраняю лестницу, сэр».~
@27962 = ~«Зачем? Куда она ведет?»~
@27963 = ~«У меня есть другие вопросы...»~
@27964 = ~«Это все, что я хотел узнать. Прощай».~
@27965 = ~«В Подземное Царство, — видя выражение твоего лица, он продолжает. — Подсигилье, возможно, вы слышали такое название».~
@27966 = ~«По каким причинам ты никого туда не пускаешь?»~
@27967 = ~«У меня есть другие вопросы...»~
@27968 = ~«Это все, что я хотел узнать. Прощай».~
@27969 = ~Он тихо смеется, пластины его брони грохочут от этого. «Я слежу за тем, что выходит *оттуда*, сэр. Твари, которым не *место* в Сигиле».~
@27970 = ~«А что там внизу творится?»~
@27971 = ~«У меня есть другие вопросы...»~
@27972 = ~«Это все, что я хотел узнать. Прощай».~
@27973 = ~«Не беспокойтесь на этот счет, — он бросает на тебя любопытный взгляд. — Вы что, собираетесь туда спуститься? Что ж, будьте предельно осторожны. Ходят слухи о самых ужасных тварях, обитающих внизу».~
@27974 = ~«Спасибо. У меня есть другие вопросы...»~
@27975 = ~«Спасибо за предупреждение. Прощай».~
@27976 = ~Этот худощавый мужчина с резкими чертами лица подбегает к тебе, пытаясь привлечь твое внимание. «О, сэр, сэр! Удели мне немного времени! Ты случайно не собираешься зайти к портному?»~
@27977 = ~Мужчина перебивает тебя: «Я спрашиваю это, потому что я, кажется, э, обидел его. Я заказал у этого вспыльчивого идиота костюм, но он вышвырнул меня из своей мастерской и больше не разговаривает со мной».~
@27978 = ~Человек внезапно сжимает кулаки и начинает трясти ими в воздухе. «Да что я такого сделал, чтобы заслужить такое обращение? Ничего! Я его *клиент*! Этот заносчивый клоун *обязан* обслужить меня!»~
@27979 = ~«Могу ли я уговорить тебя заглянуть туда и забрать мой костюм? Мне нужно на маскарад, и у меня нет времени заказывать его у другого портного».~
@27980 = ~«Да? — он снова сосредотачивается на тебе. — Ах, да! Ты...»~
@27981 = ~«Постой, постой, прошу тебя!»~
@27982 = ~«О, это просто отлично! Вот оно, это здание, вон там... — он указывает на длинное низкое строение на север от него. — Спасибо тебе!»~
@27983 = ~Он презрительно усмехается, закатывая глаза. «Свиноподобный грубиян! Я каким-то образом 'обидел' этого жирного, набитого роскошью нахала! Он запретил мне входить в его мастерскую, и отказывается со мной разговаривать. Представляешь?!»~
@27984 = ~«*Что*? Во имя сил, парень, ты просто забираешь *костюм*! Это не займет много времени! Я определенно не думаю, что такая незначительная услуга нуждается в оплате!»~
@27985 = ~«Погоди... — он громко вздыхает. — Раз так, плачу десять медяков за минутное поручение. Этого достаточно... 'сэр'?»~
@27986 = ~Он протягивает тебе монеты, что-то бормоча. «Длинное здание, вон там, — он указывает на длинное низкое строение, — на северо-востоке от ворот Нижнего района. Пожалуйста, поторопись».~
@27987 = ~Он кричит тебе вдогонку: «Ты... покромсанный бесполезный кусок мяса! Сморщенный шелудивый мешок отбросов! Вернись, жалкий разносчик заразы! Никто не смеет так вести себя с Малманером! Немедленно вернись, пока я не позвал стражу!»~
@27988 = ~Он кричит тебе вдогонку: «Ты... покромсанный бесполезный кусок мяса! Сморщенный шелудивый мешок отбросов! Вернись, жалкий разносчик заразы! Никто не смеет так вести себя с Малманером! Немедленно вернись, пока я не позвал стражу!»~
@27989 = ~«Пф!» Он выхватывает монеты с твоей руки и, сунув их в кошелек, уходит прочь.~
@27990 = ~Он потрясенно смотрит на тебя. «Ах ты... нахал...»~
@27991 = ~«Я тебе покажу! Стража! Стража!»~
@27992 = ~«Так-так, добрейший житель Сигила... — его голос полон едкого сарказма. — Я *так* благодарен тебе за помощь. Ах... постой... ведь ты мне не помог, не так ли? Пф».~
@27993 = ~Человек выжидающе смотрит на тебя. «Ну? Ну? Ты забрал у Гонсалвиса костюм?»~
@27994 = ~«Ну так займись этим, парень! Мне нужно на маскарад!»~
@27995 = ~Человек выжидающе смотрит на тебя. «Ну? Ну? Ты забрал у Гонсалвиса костюм?»~
@27996 = ~«*ЧТО*?! Пф! Ладно, ладно... возьми деньги и принеси мне, наконец, этот чертов костюм!» Он бросает тебе тридцать медных монет.~
@27997 = ~Он кричит тебе вдогонку: «Ты... покромсанный бесполезный кусок мяса! Сморщенный шелудивый мешок отбросов! Иди сюда, грязный разносчик заразы! Никто не смеет вести себя так с Малманером! Немедленно вернись, пока я не позвал стражу!»~
@27998 = ~Он кричит тебе вдогонку: «Ты... покромсанный бесполезный кусок мяса! Сморщенный шелудивый мешок отбросов! Вернись, жалкий разносчик заразы! Никто не смеет так вести себя с Малманером! Немедленно вернись, пока я не позвал стражу!»~
@27999 = ~Мужчина выглядит пораженным. «Немыслимо! Нелепо! Когда я заказывал его, мы договаривались о цене в тридцать медяков!»~
@28000 = ~Он смотрит на тебя с подозрением, затем уступает: «Ладно! Вот, держи. Просто достань мне этот чертов костюм!» Он бросает тебе пятьдесят медных монет.~
@28001 = ~Человек выжидающе смотрит на тебя. «Ну? Ну? Ты забрал у Гонсалвиса костюм?»~
@28002 = ~«Ладно, ладно! Вот, держи, — он бросает тебе тридцать медных монет. — А теперь мне нужно идти...»~
@28003 = ~Он смотрит на тебя с подозрением, сжав губы.~
@28004 = ~Мужчина выглядит пораженным. «Немыслимо! Нелепо! Когда я заказывал его, мы договаривались о цене в тридцать медяков!»~
@28005 = ~Он смотрит на тебя с подозрением, затем уступает: «Ладно! Вот, держи, — он бросает тебе пятьдесят медных монет. — А теперь мне нужно идти...»~
@28006 = ~Он смотрит на тебя с подозрением, сжав губы.~
@28007 = ~«Разве? Проклятье! Я не хочу прийти в таком *обыкновенном* наряде... Хм-м-м...»~
@28008 = ~«Наконец-то! — он выхватывает у тебя костюм. — А теперь мне нужно идти...»~
@28009 = ~Он с отвращением отступает. «Тьфу! Какая мерзость... погляди на них! Грязные, поеденные молью тряпки... и такая грубая ткань! Я не вынесу того, чтобы надеть эти лохмотья».~
@28010 = ~Он с отвращением отступает. «Тьфу! Какая мерзость... погляди на них! Грязные, поеденные молью тряпки... и такая грубая ткань! Я не вынесу того, чтобы надеть эти лохмотья, — он бросает на тебя подозрительный взгляд. — И что же *это* такое?»~
@28011 = ~«Пф!» Он отступает, что-то угрюмо бормоча.~
@28012 = ~«А что, неплохая идея! Скорее, посмотри, есть ли еще что-нибудь у этого пухлого простофили, ладно?»~
@28013 = ~Он закатывает глаза, презрительно усмехаясь тебе. «Я должен был догадаться! Держи, *корыстолюбец*. Надеюсь, этого хватит?» Он дает тебе двадцать медных монет.~
@28014 = ~Мужчина смотрит на тебя в ожидании. «Ну? Ну? Ты достал у него еще один костюм?»~
@28015 = ~Мужчина смотрит на тебя в ожидании. «Ну? Ну? Ты достал у него еще один костюм?»~
@28016 = ~Он рвет на себе волосы, крича: «О, как же силы все-таки любят унижать бедного благородного Малманера! Будь проклят этот маскарад, будь трижды проклят этот мерзкий портной! — он бросает тебе пятьдесят медных монет. — Иди!»~
@28017 = ~«Это... это... немыслимо! Полный абсурд! Кем он себя возомнил?! — внезапно он хмурится. — Если подумать, это звучит немного неправдоподобно, даже для Гонсалвиса». Он с подозрением смотрит на тебя.~
@28018 = ~Он смотрит на тебя с подозрением, затем уступает: «Хорошо! Держи. Только принеси мне тот другой костюм, и быстро!» Он бросает тебе восемьдесят медных монет.~
@28019 = ~Он смотрит на тебя с подозрением, сжав губы. Несомненно, он не верит ни единому твоему слову.~
@28020 = ~Null node.~
@28021 = ~Человек выжидающе смотрит на тебя. «Ну? Ну? Ты забрал у Гонсалвиса костюм?»~
@28022 = ~Он издает звук отвращения, выхватывает у тебя костюм и сует тебе в руку пятьдесят монет. «А теперь я должен идти...»~
@28023 = ~«Давно пора! — он выхватывает у тебя костюм. — А теперь я должен идти...»~
@28024 = ~«Это... это... немыслимо! Полный абсурд! Кем он себя возомнил?! — внезапно он хмурится. — Если подумать, это звучит немного неправдоподобно, даже для Гонсалвиса». Он с подозрением смотрит на тебя.~
@28025 = ~Он смотрит на тебя с подозрением, сжав губы.~
@28026 = ~Он смотрит на тебя с подозрением, затем уступает. Он издает звук отвращения, выхватывает у тебя костюм и сует тебе в руку восемьдесят монет. «А теперь я должен идти...»~
@28027 = ~«Я как...»~
@28028 = ~Игнорировать его и продолжать идти.~
@28029 = ~«И чт...»~
@28030 = ~«Чего ты от меня хочешь?»~
@28031 = ~«У меня нет на это времени. Прощай».~
@28032 = ~«Да. Я пойду и заберу его».~
@28033 = ~«Я сделаю это, но не за бесплатно».~
@28034 = ~«Почему ты просто не заберешь его сам?»~
@28035 = ~«Нет, у меня нет времени на это. Прощай».~
@28036 = ~Морт одобрительно кивает. «Эй, а этот парень не так уж плох».~
@28037 = ~Морт одобрительно кивает. «Эй, а этот парень не так уж плох».~
@28038 = ~«Ладно, вот... забирай свои деньги, Малманер».~
