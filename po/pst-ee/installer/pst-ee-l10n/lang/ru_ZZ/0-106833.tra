@46558 = ~«Нет, спасибо. Прощай».~
@46559 = ~«Не беспокойся — я уже нашел его. Больше он такого трюка не выкинет».~
@46560 = ~«Не беспокойся — я уже нашел его. Больше он такого трюка не выкинет».~
