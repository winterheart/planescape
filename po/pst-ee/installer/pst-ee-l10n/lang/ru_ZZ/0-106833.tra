@7890 = ~«Понятно... У меня еще вопросы...» ~
@7891 = ~«Думаю, я выслушал достаточно. Прощай».~
@7892 = ~«Зачем?»~
@7893 = ~«Кого именно вы оплакиваете?»~
@7894 = ~«Кого именно вы оплакиваете?»~
