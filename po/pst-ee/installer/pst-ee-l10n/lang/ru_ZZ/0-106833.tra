@31094 = ~Обшарить его карманы, пока он вещает.~
@31095 = ~«Я хочу знать больше о других фракциях».~
@31096 = ~На этот ящик нанесены символ черепа и надпись «Построено на века».~
@31097 = ~«У меня есть другие вопросы о Сигиле...»~
@31098 = ~«Позволь мне спросить кое о чем еще...»~
@31099 = ~Несмотря на то, что эти ящики расставлены в беспорядочной манере, все они оказываются последовательно пронумерованными.~
@31100 = ~«Это все, что я хотел узнать. Прощай».~
@31101 = ~«Что ж, я, к примеру, собираюсь раскрыть тайны мультивселенной, потерев себе живот домашним сыром и съев большое количество пресноводной рыбы. М-м-м... сыр».~
@31102 = ~«Что ж, я, к примеру, собираюсь раскрыть тайны мультивселенной, потерев себе живот домашним сыром и съев большое количество пресноводной рыбы. М-м-м... сыр».~
@31103 = ~«Я хочу знать больше о других фракциях».~
@31104 = ~«У меня есть другие вопросы о Сигиле...»~
@31105 = ~«Позволь мне спросить кое о чем еще...»~
@31106 = ~«Это все, что я хотел узнать. Прощай».~
@31107 = ~«Постой... Я хотел бы послушать о других фракциях...»~
@31108 = ~Контейнер странной формы, закрытый с помощью надежных креплений. Что бы это могло быть?~
@31109 = ~«Погоди. У меня еще вопросы о Сигиле...»~
@31110 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@31111 = ~«Прощай».~
@31112 = ~«Я хочу знать больше о других фракциях».~
@31113 = ~«У меня есть другие вопросы о Сигиле...»~
@31114 = ~«Позволь мне спросить кое о чем еще...»~
@31115 = ~«Это все, что я хотел узнать. Прощай».~
@31116 = ~«Я хочу знать больше о других фракциях».~
@31117 = ~«У меня есть другие вопросы о Сигиле...»~
@31118 = ~«Позволь мне спросить кое о чем еще...»~
@31119 = ~«Это все, что я хотел узнать. Прощай».~
@31120 = ~«Да. Ну же, скажи это: анархист».~
@31121 = ~Ложь: «Не... что? Не знаю, о чем ты говоришь».~
@31122 = ~Атаковать его.~
@31123 = ~Попытаться уйти, пока никто не пришел.~
@31124 = ~«Я, э, хотел бы послушать еще о других фракциях...»~
@31125 = ~«У меня есть другие вопросы о Сигиле...»~
@31126 = ~«Позволь мне спросить кое о чем еще...»~
@31127 = ~«Мне уже лучше идти. Прощай».~
@31128 = ~«Но *что* о ней известно?»~
@31129 = ~«У меня есть другие вопросы о Сигиле...»~
@31130 = ~«Позволь мне спросить кое о чем еще...»~
@31131 = ~«Это все, что я хотел узнать. Прощай».~
@31132 = ~Продолжить слушать.~
@31133 = ~Попробовать прервать его.~
@31134 = ~Обшарить его карманы, пока он вещает.~
@31135 = ~Продолжить слушать.~
@31136 = ~Попробовать прервать его.~
@31137 = ~Продолжить слушать.~
@31138 = ~Попробовать прервать его.~
@31139 = ~«Она отняла у силы власть над Сигилом? Откуда тебе это известно?»~
@31140 = ~«Ее вид сводит людей с ума?»~
@31141 = ~«У меня есть другие вопросы о Сигиле...»~
@31142 = ~«Позволь мне спросить кое о чем еще...»~
@31143 = ~«Это все, что я хотел узнать. Прощай».~
@31144 = ~«Говоришь, ее вид сводит людей с ума?»~
@31145 = ~«У меня есть другие вопросы о Сигиле...»~
@31146 = ~«Позволь мне спросить кое о чем еще...»~
@31147 = ~«Это все, что я хотел узнать. Прощай».~
@31148 = ~«Откуда тебе известно, что она создала Сигил?»~
@31149 = ~«У меня есть другие вопросы о Сигиле...»~
@31150 = ~«Позволь мне спросить кое о чем еще...»~
@31151 = ~«Это все, что я хотел узнать. Прощай».~
@31152 = ~Продолжить слушать.~
@31153 = ~Попробовать прервать его.~
@31154 = ~Обшарить его карманы, пока он вещает.~
@31155 = ~«Значит, ты смог бы что-нибудь разузнать про нее?»~
@31156 = ~«Лабиринт?»~
@31157 = ~«У меня есть другие вопросы...»~
@31158 = ~«Это все, что я хотел узнать. Прощай».~
@31159 = ~«Значит, ты смог бы что-нибудь разузнать про нее?»~
@31160 = ~Продолжить слушать.~
@31161 = ~Попробовать прервать его.~
@31162 = ~Обшарить его карманы, пока он вещает.~
@31163 = ~«Значит, ты смог бы что-нибудь разузнать про нее?»~
@31164 = ~«У меня есть другие вопросы...»~
@31165 = ~«Это все, что я хотел узнать. Прощай».~
@31166 = ~«У меня есть другие вопросы...»~
@31167 = ~«Это все, что я хотел узнать. Прощай».~
@31168 = ~Разложить додекаэдр в страницу с «записями» и спросить, сможет ли он что-нибудь разузнать о них.~
@31169 = ~«Я ищу сведения о ночной ведьме по имени Равель Заморочка».~
@31170 = ~«Я ищу сведения о любом покойнике, подходящем ко мне по описанию».~
@31171 = ~«Собственно, позволь мне спросить кое о чем еще».~
@31172 = ~«Если подумать, то ничего. Прощай».~
@31173 = ~«Спасибо. Могу ли я попросить тебя разузнать насчет других вещей?»~
@31174 = ~«Спасибо. У меня есть другие вопросы...»~
@31175 = ~«Я высоко ценю это. Прощай».~
@31176 = ~«Что-то вроде этого. Можешь проверить?»~
@31177 = ~«Большое спасибо. У меня есть другие вопросы...»~
@31178 = ~«Я высоко ценю это. Прощай».~
@31179 = ~«Она 'была заточена в лабиринт'?»~
@31180 = ~«Интересно. У меня есть другие вопросы...»~
@31181 = ~«Это все, что я хотел узнать. Прощай».~
@31182 = ~«Продолжай...»~
@31183 = ~Спрятать монеты в карман и продолжить слушать.~
@31184 = ~Спрятать монеты в карман и продолжить слушать.~
@31185 = ~Спрятать монеты в карман и продолжить слушать.~
@31186 = ~Спрятать монеты в карман и продолжить слушать.~
@31187 = ~Спрятать монеты в карман и продолжить слушать.~
@31188 = ~Спрятать монеты в карман и продолжить слушать.~
@31189 = ~Спрятать монеты в карман и продолжить слушать.~
@31190 = ~Спрятать монеты в карман и продолжить слушать.~
@31191 = ~Спрятать монеты в карман и продолжить слушать.~
@31192 = ~Спрятать монеты в карман и продолжить слушать.~
@31193 = ~Спрятать монеты в карман и продолжить слушать.~
@31194 = ~«А второй?»~
@31195 = ~«Как он умер?»~
@31196 = ~«Большое спасибо. У меня есть другие вопросы...»~
@31197 = ~«Я высоко ценю это. Прощай».~
@31198 = ~«Погоди... У меня есть несколько вопросов...»~
@31199 = ~«Да... Очень интересно... но я должен идти. Прощай».~
@31200 = ~«Погоди... У меня есть несколько вопросов...»~
@31201 = ~«Да... Очень интересно... но я должен идти. Прощай».~
