@7881 = ~«Кого именно вы оплакиваете?»~
@7882 = ~«Это все, что я хотел узнать. Прощай».~
@7883 = ~«Живых?»~
@7884 = ~«Кого именно вы оплакиваете?»~
@7885 = ~«Кого именно вы оплакиваете?»~
