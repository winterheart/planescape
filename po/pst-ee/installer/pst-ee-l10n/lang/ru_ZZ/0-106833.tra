@50217 = ~«Спроси его про Леди Боли».~
@50218 = ~Анна мотает головой. «Ну уж нет, не собираюсь я с тобой за компанию попасть в тень Леди, ни за что. Если будешь трещать о ней с ее народцем — привлечешь взгляд Леди».~
@50219 = ~«Слушай, просто задай вопрос о Леди, ладно?»~
@50220 = ~Она мотает головой. «Не-а, не хочу».~
@50221 = ~«Слушай, просто *сделай* это. Последний раз прошу».~
@50222 = ~Анна скрещивает руки, ее хвост начинает хлестать вперед-назад.~
@50223 = ~«Дай тогда я попробую...»~
