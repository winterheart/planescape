@33808 = ~«А что насчет того переулка, о котором ты говорил?»~
@33809 = ~«Это все, что я хотел узнать. Прощай».~
@33810 = ~«Где находится Управление по борьбе с вредителями и заболеваниями?»~
@33811 = ~«Где находится Рынок?»~
@33812 = ~«Куда ведут северные ворота?»~
@33813 = ~«Куда ведут юго-восточные ворота?»~
@33814 = ~«Это все, что я хотел узнать. Прощай».~
@33815 = ~Привлекательная, скудно одетая женщина, приближаясь, окликает тебя. «Прошу прощения, уважаемый сэр! Прошу прощения! Похоже, вы немного заплутали... Я возьму на себя смелость... не хотите ли вы воспользоваться услугами осведомителя? Всего один медяк, сэр...»~
@33816 = ~«Требуются ли вам услуги осведомителя, уважаемый сэр? Это будет стоить всего ничего — один медяк...»~
@33817 = ~«Проводник, сэр, который познакомит с этой частью Улья».~
@33818 = ~«Спасибо, сэр... эта звенелка была потрачена не зря, — она прячет монету в карман. — Из этого района есть два выхода, и оба находятся в западной части: один — на севере, другой — на юге. Здесь вниманием можно удостоить два места — бар 'Тлеющий труп' и тату-салон. И наконец, здесь расположен ряд строений, часто называемых Пристанищем головорезов... это очень, очень опасное место, сэр».~
@33819 = ~«Он находится в центре района, сэр... квадратное здание с куполообразной крышей. Пройдите по южной дороге, идущей с востока на запад: к югу вы увидите вход».~
@33820 = ~«Салон находится в восточной части, сэр... куполообразное здание с кованной металлической сетью наверху... вход — с юго-запада».~
@33821 = ~«В район Улья, в котором находится Морг, сэр. Также там находятся Бар собирателей пыли, мемориал тленных и мавзолей».~
@33822 = ~«Ворота ведут в тот район Улья, в котором находится Управление по борьбе с эпидемиями и заболеваниями, а также достаточно большой рынок».~
@33823 = ~Она кивает. «Это комплекс зданий к северу от сюда, сэр... Вам не следует ходить туда. Конечно же, если только не хотите подраться, сэр».~
@33824 = ~«Что за осведомитель?»~
@33825 = ~«Конечно... вот медяк».~
@33826 = ~«Больше ничего. Прощай».~
