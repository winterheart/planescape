@41505 = ~~
@41506 = ~«Да... У меня есть ключи от твоего сердца. Вот они».~
@41507 = ~«Э... Я вернусь, когда они будут у меня».~
@41508 = ~«Пожалуйста, Долора. У меня есть пара вопросов...»~
@41509 = ~«Рад был помочь. Прощай, Долора».~
@41510 = ~«Да-да, конечно. Моя награда?..»~
@41511 = ~«Теперь у меня есть несколько вопросов...»~
@41512 = ~«Точно. Прощай, Долора».~
@41513 = ~«Да... Вот они».~
@41514 = ~«Нет... Я вернусь, когда найду их».~
@41515 = ~«Я бы хотел узнать побольше о твоей сущности».~
@41516 = ~«Что ты здесь делаешь?»~
@41517 = ~«Что ты можешь сказать об этом месте?»~
@41518 = ~«Что ты можешь рассказать о молчаливой проститутке?»~
@41519 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@41520 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@41521 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@41522 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@41523 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
@41524 = ~«Ничего особенного. Прощай».~
@41525 = ~«А твой разум, чувства?»~
@41526 = ~«Для чего нужны ключи?»~
@41527 = ~«У меня есть другие вопросы...»~
@41528 = ~«Это все, что я хотел узнать. Прощай».~
@41529 = ~«Для чего нужны ключи?»~
@41530 = ~«У меня есть другие вопросы...»~
@41531 = ~«Это все, что я хотел узнать. Прощай».~
@41532 = ~«Как работает твой разум? Есть ли у тебя эмоции?»~
@41533 = ~«У меня есть другие вопросы...»~
@41534 = ~«Это все, что я хотел узнать. Прощай».~
