@19864 = ~Оба~
@19865 = ~Стражник выпрямляется. «Нашел, что Фарод хотел, пень?»~
@19866 = ~«Да».~
@19867 = ~«Пока нет».~
@19868 = ~«Покажи мне, пень, и тогда я открою ворота. Но не раньше, понятно?»~
@19869 = ~Показать ему.~
@19870 = ~«Ну хорошо, у меня его нет. Но у меня есть кое-что, что может заинтересовать тебя».~
@19871 = ~«Нет. Я вернусь позже».~
@19872 = ~«Если нет, так чего же ты тратишь мое время?» — фыркает он.~
@19873 = ~«Пока что нет, но у меня есть кое-что, что может заинтересовать тебя...»~
@19874 = ~«Ладно. Прощай».~
@19875 = ~«Хорошо. Давай, заходи».~
@19876 = ~«Спасибо».~
@19877 = ~«Да? И что же это может быть?»~
@19878 = ~«Звенелки. Как насчет одной монеты?»~
@19879 = ~«Звенелки. Как тебе сумма в десять монет?»~
@19880 = ~«Звенелки. Как насчет двадцати пяти монет?»~
@19881 = ~«Звенелки. Как насчет пятидесяти монет?»~
@19882 = ~«Звенелки. Как насчет пятидесяти монет?»~
@19883 = ~«Звенелки. Как насчет сотни монет?»~
@19884 = ~«Если подумать — ничего».~
@19885 = ~«Забудь».~
@19886 = ~«Тогда и взамен ты ничего не получишь, пень». Он сплевывает тебе под ноги.~
@19887 = ~«Тогда прощай». ~
@19888 = ~Он криво улыбается. «Да ты просто оскорбляешь меня, пень. Попробуй еще раз».~
@19889 = ~«Хорошо. Как насчет десяти монет?»~
@19890 = ~«Хорошо. Как насчет двадцати пяти монет?»~
@19891 = ~Короткий меч~
@19892 = ~«Хорошо. Как насчет пятидесяти?»~
@19893 = ~«Хорошо. Как насчет пятидесяти?»~
@19894 = ~Тупое оружие~
@19895 = ~«Хорошо. Как насчет сотни?»~
@19896 = ~«Забудь».~
@19897 = ~Топор~
@19898 = ~Стрелковое оружие~
@19899 = ~«Я так не думаю...»~
@19900 = ~«Хорошо. Как насчет двадцати пяти монет?»~
@19901 = ~«Хорошо. Как насчет пятидесяти?»~
@19902 = ~«Хорошо. Как насчет пятидесяти?»~
@19903 = ~«Хорошо. Как насчет сотни?»~
@19904 = ~«Забудь».~
@19905 = ~«Уже теплее, пень, но все еще холодно».~
@19906 = ~«Хорошо. Как насчет пятидесяти?»~
@19907 = ~«Хорошо. Как насчет пятидесяти?»~
@19908 = ~«Хорошо. Как насчет сотни?»~
@19909 = ~«Забудь».~
@19910 = ~Его ужасное лицо расплывается в улыбке. «Этого хватит. Давай их сюда, и я открою ворота».~
@19911 = ~«Кажется, у меня недостаточно монет».~
@19912 = ~Дать пятьдесят монет: «На, держи. Тут все».~
@19913 = ~Дать сорок монет: «На, держи. Тут все».~
@19914 = ~Протянуть ему монеты: «Бери их — они твои».~
@19915 = ~«Забудь. Я возвращаюсь в катакомбы».~
@19916 = ~Обдумав это, он отвечает: «Нет. Если хочешь войти, тебе нужно дать больше».~
@19917 = ~«Хорошо. Как насчет сотни?»~
@19918 = ~«Забудь».~
@19919 = ~«Это хорошо. Это замечательно. Давай их сюда, и я открою ворота».~
@19920 = ~«Кажется, у меня недостаточно монет».~
@19921 = ~Дать сто монет: «На, держи. Тут все».~
@19922 = ~Дать девяносто монет: «На, держи. Тут все». ~
@19923 = ~Протянуть ему монеты: «Бери их — они твои».~
@19924 = ~«Забудь. Я возвращаюсь в катакомбы».~
@19925 = ~Он взвешивает монеты в руке, просыпая их между пальцами, и говорит: «Кажется, тут все». Он открывает ворота.~
@19926 = ~«Увидимся».~
@19927 = ~«Очень жаль. Приходи, когда наберется. А пока и не пытайся пройти». Он отворачивается от тебя.~
@19928 = ~«Ну хорошо...»~
@19929 = ~Он тянется за твоими монетами сквозь ворота.~
@19930 = ~Схватить его за руку.~
@19931 = ~Схватить его за руку.~
@19932 = ~Схватить его за руку.~
@19933 = ~Схватить его за руку.~
@19934 = ~Дать пятьдесят монет: «На, держи. Тут все».~
@19935 = ~Дать сорок монет: «На, держи. Тут все».~
@19936 = ~«Кажется, у меня недостаточно монет».~
@19937 = ~«Забудь. Я собираюсь назад вниз».~
@19938 = ~Он тянется за твоими монетами сквозь ворота.~
@19939 = ~Схватить его за руку.~
@19940 = ~Схватить его за руку.~
@19941 = ~Схватить его за руку.~
@19942 = ~Схватить его за руку.~
@19943 = ~«Кажется, у меня недостаточно монет».~
@19944 = ~Дать сто монет: «На, держи. Тут все».~
@19945 = ~Дать девяносто монет: «На, держи. Тут все». ~
@19946 = ~«Забудь. Я возвращаюсь в катакомбы».~
@19947 = ~Ты ловко прижимаешь его руку к воротам и с хрустом выворачиваешь ее из сустава. Стражник кричит от мучительной боли.~
@19948 = ~«Впусти меня или я ее вырву с корнем!»~
@19949 = ~Отпустить его. «А теперь впусти меня, или я порву тебя на части. Мне надоело играть в твои игры».~
@19950 = ~Когда он тянется за монетами, ты хватаешь его за руку. Он пытается высвободиться из твоей хватки, но тебе в конце концов удается прижать руку к воротами и вывернуть ее. Он стонет от боли.~
@19951 = ~«Впусти меня или я ее вырву с корнем!»~
@19952 = ~Отпустить его. «А теперь впусти меня, или я порву тебя на части. Мне надоело играть в твои игры».~
@19953 = ~Он поспешно, пока ты не выполнил свою угрозу, открывает ворота. Пока ты проходишь, он старается держаться от тебя подальше.~
@19954 = ~«Еще раз мне попадешься — и твои части найдут в трех разных склепах. Уяснил? Хорошо».~
@19955 = ~«Ну как, усвоил урок? Посмотрим на твое поведение в следующий раз. Прощай».~
@19956 = ~Стражник грозно смотрит на тебя. «Чтобы попасть сюда, нужно заплатить двести. И не жульничать!»~
@19957 = ~«У меня нет столько».~
@19958 = ~«Хорошо. Держи».~
@19959 = ~«Тогда забудь об этом».~
@19960 = ~«Он забирает монеты и внимательно их пересчитывает. Окончательно убедившись в том, что ты его не обманул ни на одну монету, он открывает ворота. «Запомни, пень... Выход стоит столько же!»~
@19961 = ~«Да-да, как скажешь».~
@19962 = ~«У меня будет более чем достаточно».~
@19963 = ~Стражник слегка выпрямляется. «Нашел деньги, чтоб заплатить за проход?»~
@19964 = ~«Много народу не знает. Но это так».~
@19965 = ~«Заплатить? Сколько?»~
@19966 = ~«Не знал, что тут нужно платить за проход».~
@19967 = ~«Нет. Прощай».~
@19968 = ~«И сколько?»~
@19969 = ~«И сколько?»~
@19970 = ~«Тогда забудь об этом. Прощай».~
@19971 = ~«Для тебя? Пятьдесят монет».~
@19972 = ~«Пятьдесят? Не думаю, что смогу заплатить столько».~
@19973 = ~«Думаю, я смогу себе это позволить».~
@19974 = ~«Тогда забудь об этом».~
@19975 = ~«Для тебя? Сто монет».~
@19976 = ~«Сто? Не думаю, что смогу заплатить столько».~
@19977 = ~«Думаю, я смогу себе это позволить».~
@19978 = ~«Тогда забудь об этом».~
@19979 = ~«Чего тебе на этот раз?»~
@19980 = ~«Фарод разрешил мне спуститься в катакомбы. Открой мне ворота».~
@19981 = ~«Что находится за воротами?»~
@19982 = ~«Что находится за воротами?»~
@19983 = ~«Откроешь мне ворота еще раз?»~
@19984 = ~«Что ты можешь рассказать про место за воротами?»~
@19985 = ~«Я хотел бы спуститься туда».~
@19986 = ~«Кто ты?»~
@19987 = ~«Что ты делаешь?»~
@19988 = ~«Ничего. Прощай».~
@19989 = ~Ты видишь крупного человека, одетого в залатанные лохмотья и воняющего старым элем. Он очень большой — очевидно, его поставили на эту работу благодаря туше, но никак не мозгам. «Чего надо?»~
@19990 = ~«Фарод разрешил мне спуститься в катакомбы. Открой мне ворота».~
@19991 = ~«Что находится за воротами?»~
@19992 = ~«Что находится за воротами?»~
@19993 = ~«Что ты можешь рассказать про место за воротами?»~
@19994 = ~«Я хотел бы спуститься туда».~
@19995 = ~«Кто ты?»~
@19996 = ~«Что ты делаешь?»~
@19997 = ~«Ничего. Прощай».~
@19998 = ~Он открывает ворота. «Тогда пошевеливайся, пень, хватит тратить наше время попусту».~
@19999 = ~«Прощай».~
@20000 = ~«Катакомбы плачущих камней. Груды трупов, куча склепов для наживы».~
@20001 = ~«Почему их называют Катакомбами плачущих камней?»~
@20002 = ~«А что-нибудь определенное ты можешь сказать?»~
@20003 = ~«Спасибо. У меня есть другие вопросы...»~
@20004 = ~«Спасибо. Прощай».~
@20005 = ~«Там с потолка вода стекает, из-за чего кажется, что стены плачут. От этого имя и пошло».~
@20006 = ~«Понятно. Ответишь еще на пару вопросов?»~
@20007 = ~«Спасибо».~
@20008 = ~«Нет. Я там был всего пару раз... Туда за телами другие спускаются. Грис вот добра приносил больше всех. Похоже, он нарвался там на что-то, и теперь его вписали в книгу мертвых».~
@20009 = ~«Грис?»~
@20010 = ~«Понятно. У меня есть другие вопросы...» ~
@20011 = ~«Понятно. Прощай».~
@20012 = ~«Ага, Грис-Стервятник. Он с парой своих ребят пошел туда пару пиков назад, и с тех пор от них ни слуху ни духу. Если найдешь его тело, принеси его сюда, — он плотоядно улыбается. — За него мы сможем выручить у трухлявых немного звенелок».~
@20013 = ~«Ха. У меня есть несколько вопросов...»~
@20014 = ~«Ладно. Прощай».~
@20015 = ~Посмотрев на тебя, стражник ухмыляется. «Спальня твоей мамочки. Пришлось ограничить движение, а то, понимаешь ли, слишком много охотников туда, — хохочет он. — Отвали, пока не присоединился к трупам внизу».~
@20016 = ~«Просто ответь мне на другие вопросы...»~
@20017 = ~«Хорошо». ~
@20018 = ~Взглянув на тебя, стражник качает головой. «Да-да, нам всем не терпится туда попасть. Слушай. Ты определенно не отсюда. Так что задвинься».~
@20019 = ~«Тогда ответь мне на несколько вопросов».~
@20020 = ~«Отлично».~
@20021 = ~Взглянув на тебя, он молча открывает ворота.~
@20022 = ~«Прощай».~
@20023 = ~«Не твое собачье дело. Отвали».~
@20024 = ~«Сначала ответь мне на пару вопросов...»~
@20025 = ~«Спасибо... Приятель».~
@20026 = ~«А на что это, по-твоему, похоже? Стираю твое исподнее? Вали отсюда, тупой пень!»~
@20027 = ~«Еще один вопрос...»~
@20028 = ~«Как хочешь».~
@20029 = ~Изможденная женщина смотрит на тебя с ужасом на лице, и, прежде чем ты успеваешь заговорить, убегает.~
@20030 = ~«Тогда бывай...»~
@20031 = ~Женщина смотрит на тебя со страхом, ее глаза широко раскрыты. «Не подходи ко мне, пень, не то пострадаешь!»~
@20032 = ~«Успокойся. Я всего лишь хотел знать, кто ты».~
@20033 = ~«Эй, расслабься. Чем ты занимаешься?»~
@20034 = ~«Чего ты так боишься?»~
@20035 = ~«Хорошо. Прощай».~
@20036 = ~«Кто я? — она горько смеется. — С тем же успехом, рубака, ты мог бы спросить имя у песчинки, потому что я значу не больше».~
@20037 = ~«Воодушевляющая точка зрения. У меня есть пара вопросов...»~
@20038 = ~«Понятно. Прощай».~
@20039 = ~«Валяй... чего ты хочешь знать?»~
@20040 = ~«Кто ты?»~
@20041 = ~«Чем ты занимаешься?»~
@20042 = ~«Чего ты боишься?»~
@20043 = ~«Неважно. Прощай».~
@20044 = ~«Чем я занимаюсь? Ну, просто пытаюсь выжить в этой тяжелой жизни под площадью Старьевщиков. Стараюсь держаться подальше от тех, кто меня сюда затянул. Вот чем я занимаюсь».~
@20045 = ~«Хорошо. У меня еще вопросы...»~
@20046 = ~«Спасибо. Прощай».~
@20047 = ~«Просто хотела убедиться, что ты не одна из тех тварей, которые растерзали Фарода».~
@20048 = ~«Тварей? Каких еще тварей?»~
@20049 = ~«Фарод мертв?»~
@20050 = ~«Тогда у меня есть еще вопросы...»~
@20051 = ~«Понятно. Прощай».~
@20052 = ~«Ага, это были порождения ночи и тьмы, создания не-света, которые пробрались сюда и исчезли во дворе Фарода. Мне кажется, что я все еще слышу эхо от криков...»~
@20053 = ~«Ладно. Позволь мне спросить кое о чем еще...»~
@20054 = ~«Это все, что я хотел узнать. Прощай».~
@20055 = ~Она утирает сопли рукавом. «Чего тебе на этот раз?»~
@20056 = ~«Мне нужны ответы».~
@20057 = ~«Ничего. Прощай».~
@20058 = ~Перед тобой изможденная, потрепанная временем женщина с озабоченным лицом. Ее взгляд проницательный и усталый. Шмыгая носом, она произносит: «Чего тебе от меня надо?»~
@20059 = ~«Просто ответь на несколько вопросов...»~
@20060 = ~«Ничего. Прощай».~
@20061 = ~«Снова вернулся, а?» Он широко улыбается.~
@20062 = ~«А, это ты... снова». Он хмурится, глядя в сторону.~
@20063 = ~«У меня есть несколько вопросов...» ~
@20064 = ~«Я просто проходил мимо. Прощай».~
@20065 = ~«У меня есть несколько вопросов...» ~
@20066 = ~«Я просто проходил мимо. Прощай».~
@20067 = ~Когда ты подходишь, мужчина в лохмотьях со страхом на лице бросается наутек.~
@20068 = ~«Может, в другой раз...»~
@20069 = ~Оборванец глядит на тебя со страхом. Поняв, что ты не желаешь ему зла, он расправляет плечи. «Че надо, пень?»~
@20070 = ~«Кто ты?»~
@20071 = ~«Что ты делаешь?»~
@20072 = ~«Чего ты так боишься?»~
@20073 = ~«Ничего. Прощай».~
@20074 = ~«Это неважно, рубака. Уже давным-давно рыщу здесь по закоулкам... а, может, и мой батя тоже тут начинал. Так или эдак, я всего лишь один из тех, кто пытается хоть как-то выжить».~
@20075 = ~«Ладно. У меня есть другие вопросы к тебе».~
@20076 = ~«Понятно. Прощай».~
@20077 = ~«Живее, рубака. У меня тут куча голодных ртов».~
@20078 = ~«Кто ты?»~
@20079 = ~«Что ты делаешь?»~
@20080 = ~«Чего ты так боишься?»~
@20081 = ~«Тогда забудь об этом. Прощай».~
@20082 = ~«Пытаюсь выжить. А на что это похоже? Вот только одно мешает: постоянно донимают меня расспросами. Ты уже закончил?»~
@20083 = ~«Нет. У меня есть другие вопросы...»~
@20084 = ~«До скорого».~
@20085 = ~«Кроме дабусов, замуровавших это место, обчищающих нас Твердолобых, мертвяков из нижних катакомб, черепокрыс, пытающихся нас захватить, поножовщин между собой и голода? Если это не считать, то я боюсь тех тварей, которые прикончили Фарода».~
@20086 = ~«Тварей? Каких еще тварей?»~
@20087 = ~«Фарод мертв?»~
@20088 = ~«Тогда у меня есть другие вопросы...»~
@20089 = ~«Понятно. Прощай».~
@20090 = ~«Твари прямо из утробы Баатора — вот они кто... создания из самых темных кошмаров и страха, сотканного из чистой тени. Они схватили его и разорвали на части. Почти ничего от него не осталось. Что нашли — то и похоронили».~
@20091 = ~«Ладно. Тогда скажи мне еще кое-что...»~
@20092 = ~«Это все, что я хотел узнать. Прощай».~
@20093 = ~Он шумно кашляет в кулак. «Чего тебе на этот раз?»~
@20094 = ~«Мне нужны ответы».~
@20095 = ~«Ничего. Прощай».~
@20096 = ~Перед тобой оборванец, облаченный в латаные одежды. От него несет дымом и отбросами; кожа у него желтоватого оттенка. Он глядит на тебя искоса. «Чего тебе от меня нужно, рубака?»~
@20097 = ~«Просто ответь на несколько вопросов...»~
@20098 = ~«Ничего. Прощай».~
@20099 = ~«Опять?!»~
@20100 = ~«У меня есть вопросы...» ~
@20101 = ~«Ничего, я просто проходил мимо. Прощай».~
@20102 = ~Похоже, этот труп сгорбился под тяжестью страданий духа. ~
@20103 = ~«У меня есть несколько вопросов...» ~
@20104 = ~«Я просто проходил мимо. Прощай».~
@20105 = ~МИРОВОЗЗРЕНИЕ

Твое отношение к добру и злу, порядку и хаосу.~
@20106 = ~ФРАКЦИЯ

Группа субъектов со схожими убеждениями о природе мультивселенной. Убеждения являются силой на планах; если достаточное количество людей верят какую-либо идею, то она становится реальностью.~
@20107 = ~Здесь нет ответа.~
@20108 = ~Уйти.~
@20109 = ~Подавленный человек поднимает на тебя взгляд, в котором виден проблеск надежды, однако говорит он все так же бесстрастно. «Она отдала тебе мое имя и номер? Она предлагала деньги, не так ли? Я не могу жить. Без имени деньги ничего не значат. Верни мне мое имя. Она его отдала?» Его внимательный взгляд пробегает по твоему лицу.~
@20110 = ~«Да».~
@20111 = ~Ложь: «Еще нет».~
@20112 = ~«Еще нет».~
@20113 = ~«Еще нет. Я все еще работаю над этим. Прощай».~
@20114 = ~По его лицу пробегает волна мышечных спазмов. «Прости меня, — говорит он, — поскольку я подумал о тебе плохо. По твоему лицу я вижу, что у тебя есть мое имя и номер, и все же твой голос говорит, что это не так. Я спрашиваю еще раз: у тебя есть мое имя и номер?»~
@20115 = ~Ложь: «Нет».~
@20116 = ~«Да».~
@20117 = ~«Сперва ответь мне на пару вопросов, ладно?»~
@20118 = ~«Я могу спросить не более трех раз — таков закон. У тебя есть мое имя и номер?»~
@20119 = ~Ложь: «Нет».~
@20120 = ~«Да».~
@20121 = ~«Сперва ответь мне на пару вопросов, ладно?»~
@20122 = ~«Здесь нет справедливости. Я ошибся, и я больше не могу об этом говорить. Я ничто, и останусь таким навсегда. Больше мы не увидимся».~
@20123 = ~«Погоди, есть у меня твое имя с номером...»~
@20124 = ~«Ответь мне еще на пару вопросов, ладно?»~
@20125 = ~«Ладно, как знаешь».~
@20126 = ~Он качает головой и поворачивается, чтобы уйти.~
@20127 = ~«Тогда прощай». ~
@20128 = ~«Могу ли я их получить?»~
@20129 = ~«Что ты мне за них дашь?»~
@20130 = ~«Да. Тебя зовут Куу Йин. Держи свой номер».~
@20131 = ~«Нет».~
@20132 = ~«Я ничего не могу тебе дать, потому что у меня ничего нет. Ты дашь мне мое имя и номер?»~
@20133 = ~«Да. Тебя зовут Куу Йин. Держи свой номер».~
@20134 = ~«Нет».~
@20135 = ~«Благодарю тебя за имя и номер. Да. Куу Йин. Да. Но нет. Теперь я понимаю, что номер мне не нужен. В случае необходимости я найду себе новый номер. Я отдам тебе свой старый. Он может тебе помочь. Это покров закона. Это защита. Ты примешь его?»~
@20136 = ~«Да».~
@20137 = ~«Нет».~
@20138 = ~Он мрачно принимает их. «Спасибо тебе за имя и номер. Да. Куу Йин. Да. Благодарю тебя. Я буду помнить тебя». Он накидывает номер на шею, словно шарф, и тот погружается ему в кожу. Он собирается уходить.~
@20139 = ~«Постой. У меня есть другие вопросы...»~
@20140 = ~«Прощай».~
@20141 = ~«Пусть он согреет тебя. Верь в него. Он тебя защитит. Прощай». Он поворачивается и собирается уходить.~
@20142 = ~«Постой. У меня есть другие вопросы...»~
@20143 = ~«Прощай».~
@20144 = ~«Какие?»~
@20145 = ~«Расскажи мне о себе».~
@20146 = ~«Расскажи мне об этом месте».~
@20147 = ~«Чем ты занимаешься?»~
@20148 = ~«Ничего, забудь. Прощай».~
@20149 = ~«Я Куу Йин. Я попал сюда случайно. И теперь, раз я здесь, я собираюсь узнать больше. Я должен знать больше».~
@20150 = ~«У меня есть другие вопросы...»~
@20151 = ~«Удачи. Прощай».~
@20152 = ~«Я сам намерен это выяснить. Со своим именем я вновь личность. Я могу учиться. Этим я и займусь».~
@20153 = ~«У меня есть другие вопросы...»~
@20154 = ~«Удачи. Прощай».~
@20155 = ~«Готовлюсь предстать перед этим новым миром со моей старой личностью. Теперь, когда я знаю, что в нем скрыты ловушки, я намерен найти их. Теперь я готов к этому».~
@20156 = ~«У меня есть другие вопросы...»~
@20157 = ~«Удачи. Прощай».~
@20158 = ~Он накидывает номер на шею, словно шарф, и тот погружается ему в кожу. «Тогда я буду носить свой старый номер. Благодарю тебя. Прощай». Он разворачивается и идет к выходу.~
@20159 = ~«У меня есть другие вопросы...»~
@20160 = ~«Удачи. Прощай».~
@20161 = ~Когда ты подходишь, он произносит ровным тоном: «Я заклинаю тебя продолжить переговоры с той воровкой. Без имени и номера я ничто».~
@20162 = ~«Я уже иду, но сперва ответь на пару вопросов, ладно?»~
@20163 = ~«Отлично. Прощай».~
@20164 = ~«Что ты хочешь знать?»~
@20165 = ~«Расскажи мне о себе».~
@20166 = ~«Расскажи мне о себе».~
@20167 = ~«Расскажи мне об этом месте».~
@20168 = ~«Расскажи мне о Сигиле».~
@20169 = ~«Ничего. Прощай».~
@20170 = ~«Ничего. Прощай».~
@20171 = ~«Ты нашел женщину с моим именем и номером? Она скажет тебе, что получила их от меня, но это не так. Она их украла. Мне требуется мое имя и номер. Она где-то в деревне».~
@20172 = ~Ложь: «Пока нет».~
@20173 = ~«У меня есть твое имя и номер».~
@20174 = ~«Да. Она не хочет их отдавать».~
@20175 = ~«У меня их пока что нет».~
@20176 = ~На миг он бледнеет. «Она должна. Они мои. Она их у меня украла. Я прошу у тебя помощи».~
@20177 = ~«Ты ее получишь».~
@20178 = ~«Возможно, ты сможешь ответить на некоторые из моих вопросов...»~
@20179 = ~«Забудь».~
@20180 = ~«Я взываю о помощи. Любая оказанная тобой помощь будет вспоминаться с благодарностью. Прошу, помоги».~
@20181 = ~«Мы могли бы начать с ответов на мои вопросы...»~
@20182 = ~«Прощай».~
@20183 = ~«Когда-то я жил в стране металлических машин и дверей, которые открывались с помощью слов. Мне снятся древние города из металла и пустые оболочки — люди нашего народа. Там у меня были имя и номер, а теперь их у меня нет. Как и у других моих собратьев, это все, чем я располагаю. Они — все, что было у меня за всю мою жизнь. Их у меня украли. Без них я ничто. Я прошу тебя о помощи».~
@20184 = ~«Посмотрим, что я могу сделать. Ответь мне еще на пару вопросов...»~
@20185 = ~«У кого твое имя и номер?»~
@20186 = ~«Что ты мне дашь?»~
@20187 = ~«Посмотрим. Ответь мне еще на пару вопросов».~
@20188 = ~«Посмотрим. Прощай».~
@20189 = ~«Я попытаюсь. Прощай».~
@20190 = ~«Я ничего о нем не знаю. Я не знаю этого места. У меня нет имени. У меня нет номера. У меня нет воспоминаний об этом месте. Мне холодно. Мне страшно. Странное чувство — быть столь обнаженным. Боюсь, что я умру».~
@20191 = ~«О чем это ты?»~
@20192 = ~«О чем это ты?»~
@20193 = ~«У меня есть другие вопросы...»~
@20194 = ~«Хм. Интересно. Прощай».~
@20195 = ~«Хм. Интересно. Прощай».~
@20196 = ~«У меня ничего нет. Я прошу твоей помощи».~
@20197 = ~«Посмотрим, что я могу сделать. Ответь мне еще на пару вопросов...»~
@20198 = ~«Посмотрим. Ответь мне еще на пару вопросов».~
@20199 = ~«Тогда забудь об этом. Прощай».~
@20200 = ~«Я попытаюсь. Прощай».~
@20201 = ~«Та, которая когда-то звалась Радин. Она украла их у меня. Я предложил ей защиту моего имени и номера, и она украла их. Они мои по закону и праву. Найди ее. Она в этом поселке».~
@20202 = ~«Посмотрим, что я могу сделать. Ответь мне еще на пару вопросов...»~
@20203 = ~«Не унывай. Ответь мне еще на пару вопросов...»~
@20204 = ~«Посмотрим, что я смогу сделать».~
@20205 = ~«Не падай духом. Прощай».~
@20206 = ~Ты видишь серого человека с идеально-круглым лицом. Он смотрит на тебя без всякого выражения, и не произносит ни слова. Выглядит он так, будто голос у него безжизненный как пустынная равнина.~
@20207 = ~«Здравствуй. Надеюсь, ты сможешь ответить мне на пару вопросов...»~
@20208 = ~Оставить его в покое.~
@20209 = ~Увидев тебя, женщина издает пронзительный визг. Она поворачивается и начинает бежать, при этом татуировка на ее шее, казалось бы, слегка подрагивает.~
@20210 = ~«Ни с места...»~
@20211 = ~Позволить ей уйти.~
@20212 = ~Увидев тебя снова, она кривится. «Он снова отказался, не так ли? И ты, конечно же, пришел, чтобы забрать то, что принадлежит мне по праву».~
@20213 = ~«Принадлежит тебе по праву? У тебя нет права на это имя и номер. Ты их украла».~
@20214 = ~«Твоя жизнь не зависит от наличия номера, в отличие от его жизни. Даже если тебе больно с ним расставаться, тебе нужно это сделать. Так будет лучше для вас обоих».~
@20215 = ~«Отдай его, или я заберу его сам».~
@20216 = ~«Твоя жизнь не зависит от наличия этого номера. Заведи себе свой номер, если это тебя согреет».~
@20217 = ~«Забудь. Это не стоит моих стараний».~
@20218 = ~«Думаю, ты прав. Я поступила плохо, это так, и я не могу этого так оставить. Вот», — она срывает дергающуюся татуировку с шеи и дает ее тебе. При этом она вздрагивает. «Теперь ты можешь назвать ему его имя. Он был и будет зваться Куу Йин. А теперь позволь мне уйти».~
@20219 = ~«Вот тебе звенелки за беспокойство. Купи себе что-нибудь, чтоб согреться».~
@20220 = ~«Спасибо. У меня еще пара вопросов...»~
@20221 = ~«Спасибо. Прощай».~
@20222 = ~Она поеживается от твоей угрозы. «А он еще говорил, что этот номер защитит меня от злых людей. Забирай эту чертову штуку, и покончим с этим!» — она сдирает с горла дергающуюся татуировку, захватив с ней добрый шмат кожи, швыряет ее тебе и убегает.~
@20223 = ~Бежать за ней.~
@20224 = ~Позволить ей уйти.~
@20225 = ~«Спасибо, рубака, — она кладет деньги в карман, все больше тускнея оттого, что магия татуировки покидает ее. — Пожалуй, мне лучше уйти отсюда... благодаря звенелкам, что ты мне дал, возможно, мы когда-нибудь еще встретимся, при лучших обстоятельствах».~
@20226 = ~«Угу. Прощай, Радин».~
@20227 = ~«Больше не кради имен, Радин. Прощай».~
@20228 = ~Она поворачивается и бредет прочь. Она кажется безжизненной без той татуировки с номером, которая окружала ее ореолом загадочности. Больше ты ее не увидишь.~
@20229 = ~«Прощай».~
@20230 = ~Она безучастно наблюдает за твоим возвращением, затем стряхивает с себя оцепенение. При этом татуировка на ее шее извивается. «Снова ты, э, рубака? Я сказала, что не отдам тебе имя и номер. Мне с ними больше везет. Я хорошо за них заплачу, а он сможет сам себе купить новенькое имя — как насчет такого?»~
@20231 = ~«Сколько ты дашь?»~
@20232 = ~«Не думаю, что это прокатит. Отдай мне имя и номер».~
@20233 = ~«Как насчет добрых двадцати монет? Этого ему с головой хватит, пока он не найдет себе новое имя, а? Будь умницей, сходи к нему и выясни, согласен ли он».~
@20234 = ~«Просто отдай мне имя и номер, иначе я вырву их из тебя. Поверь, тебе этого не захочется».~
@20235 = ~«Отлично, я обсужу с ним это. Но сначала ответь на мои вопросы».~
@20236 = ~«Отлично. Я обсужу с ним это».~
@20237 = ~«Может, я тебе отвечу, а может и нет».~
@20238 = ~«Расскажи мне о себе».~
@20239 = ~«Расскажи мне об этом месте».~
@20240 = ~«Расскажи мне об этой татуировке».~
@20241 = ~«Еще раз, о какой сумме мы говорили?»~
@20242 = ~«Тогда забудь об этом».~
@20243 = ~«Я? Теперь у меня два имени, и я раскрою тебе только одно: не хочу, чтобы ты украл новое, хи-хи! Можешь звать меня Радин, лапочка, а то другое имя я буду держать у себя под боком».~
@20244 = ~«Человек, которому когда-то принадлежало это имя и номер, хочет вернуть их. Без них он умирает».~
@20245 = ~«Знаю, что тебе будет нелегко, и что тебе будет сложно расстаться с этим, но... будь умницей и верни ему имя и номер».~
@20246 = ~«Говоришь, два имени? Хорошо тебе, наверно».~
@20247 = ~«Не сомневаюсь. У меня есть другие вопросы...»~
@20248 = ~«Ладно. Прощай».~
@20249 = ~«Эта корчащаяся штука? Это идентификационный номер. Мой номер. Его дал мне один добрый человек, чтобы поддержать меня, замерзшую без защиты чисел. Теперь он у меня, и я счастливее, чем когда-либо в жизни».~
@20250 = ~«Тот человек хочет его вернуть».~
@20251 = ~«Интересно. Как он действует?»~
@20252 = ~«Понятно. У меня есть другие вопросы...» ~
@20253 = ~«Понятно. Прощай».~
@20254 = ~«Погребенная деревня? Думаю, вполне себе милое местечко, если не обращать внимания на вонь трупов, кучи мусора на крышах и постоянно шастающих тут и там крыс. Да еще и холодное, если у тебя одно имя и нет номера, это уж точно».~
@20255 = ~«Расскажи мне о твоем имени».~
@20256 = ~«Расскажи мне о номере».~
@20257 = ~«У меня есть другие вопросы...»~
@20258 = ~«Понятно. Прощай».~
@20259 = ~Ее тон становится более резким. «Что ж, он их не получит! Он предложил их мне, и я взяла их. Он ничего не говорил насчет *проката*, и он не говорил, что их нужно будет вернуть! Он их не получит! Можешь так ему и передать! Если ему так нужно имя, пусть берет мое... 'Радин' ему подойдет!»~
@20260 = ~«Тебе оно не подошло... почему же оно должно подойти ему?»~
@20261 = ~«Я ему передам. Дай мне еще пару ответов...»~
@20262 = ~«Я ему передам. Прощай».~
@20263 = ~«Ага, крошка, так и есть».~
@20264 = ~«Человек, которому когда-то принадлежало это имя и номер, хочет вернуть их. Без них он умирает».~
@20265 = ~«Знаю, что тебе будет нелегко, и что тебе будет сложно расстаться с этим, но... будь умницей и верни ему имя и номер».~
@20266 = ~«Можешь дать мне еще пару ответов?»~
@20267 = ~«Спасибо. Прощай».~
@20268 = ~«С номером ты в безопасности, с безопасностью приходит тепло, а с ним — уют. Номер может дать тебе все это, дорогуша, если ты уважаешь его силу».~
@20269 = ~«Человек, давший тебе номер, теперь хочет вернуть его обратно...»~
@20270 = ~«Понятно. У меня есть другие вопросы...» ~
@20271 = ~«Понятно. Прощай».~
@20272 = ~«Между именем от рождения и чужим именем целая пропасть, дорогуша. Новое отношение к старому имени может изменить все. Видишь, как у меня все сложилось?»~
@20273 = ~«Я поговорю с ним насчет этого. Но сперва ответь мне на несколько вопросов».~
@20274 = ~«Хорошо. Я с ним поговорю насчет этого. Счастливо».~
@20275 = ~К этой женщине вернулся ее удаленный взгляд, но на этот раз ее мысли блуждают не так далеко: ты ее и близко не застал врасплох. «Снова ты, а?»~
@20276 = ~«Ты Радин? Человек, у которого ты взяла имя, хочет вернуть его обратно».~
@20277 = ~«У меня есть к тебе другие вопросы...»~
@20278 = ~«Нет, извини. Прощай».~
@20279 = ~Ты видишь женщину в серых одеждах, с морщинистым лицом. Она смотрит куда-то вдаль, и кажется, будто под ее кожей бурлит жизненная сила, как будто ей дали новую жизнь. На ее шее наколота узорчатая татуировка. Когда ты обращаешься к ней, она вздрагивает. «А? Чего ты хочешь?»~
@20280 = ~«Я просто хочу задать тебе несколько вопросов...»~
@20281 = ~«Ничего. Прощай».~
@20282 = ~Этот скелет бормочет себе под нос, время от времени останавливаясь, чтобы почесать череп. Он довольно стар, так что на его костях не осталось плоти... только несколько цветных тряпок.~
@20283 = ~Он приветственно кивает в ответ, но не отвечает тебе.~
@20284 = ~Скелет поднимает на тебя взгляд и что-то раздражительно бормочет. «Не сейчас! Извини, но у меня тут просто *чудовищная* загадка, и я не могу ее разгадать!»~
@20285 = ~Он, похоже, удивлен. «Вот оно что? Попробовать желаешь, значит?»~
@20286 = ~«Отлично. Это все тот шутовской мешок с костями. Верно, ты видал его неподалеку. Не желает говорить ответ, и это меня просто *убивает*!»~
@20287 = ~Он кивает. «Вспомни слова, которые кончаются на '-люс'. Вот два из них — полюс и плюс. Всеобщий планарный язык содержит три слова... Какое третье слово? Оно употребляется в каждодневной речи. Если ты слушал внимательно, то я его уже произнес».~
@20288 = ~Он, похоже, не поверил. «*Что*? Но...»~
@20289 = ~[no text]~
@20290 = ~«Это же... это же... о-о-о! Подлая хитрость! У меня же ведь нет языка! — он застывает, потом заходится в смехе, аж пыль из челюстей идет. — Неплохо, да. Благодарствую!»~
@20291 = ~«Что, тоже в раздумьях? Скажи, коли разгадаешь... можешь еще попробовать вытрясти ее из того болтливого дурака, что ее подкинул!»~
@20292 = ~Скелет смотрит на тебя. «Ну как, разгадал ту подлую загадку?»~
@20293 = ~«Еще раз благодарствую, что разгадал ту загадку! Представляю, как мой 'друг' огорчится из-за этого!» Он хохочет от всего сердца.~
@20294 = ~«Но... но почему? Ладно тебе! Ты *должен* мне рассказать!»~
@20295 = ~Он раздосадовано скрежещет зубами. «Вот еще! Совсем как... как... этот пустослов! Да уж! Спасибо *тебе* за помощь!»~
@20296 = ~«Приветствую...»~
@20297 = ~Оставить скелет в покое.~
@20298 = ~«У меня есть несколько вопросов...» ~
@20299 = ~«Мне пора идти. Прощай».~
@20300 = ~«Что за загадка?»~
@20301 = ~«Тогда прощай». ~
@20302 = ~«Да, давай».~
@20303 = ~«Нет, не бери в голову. Прощай».~
@20304 = ~«Что ж, продолжай...»~
@20305 = ~«Конечно. Это язык».~
@20306 = ~«Это... э... хм».~
@20307 = ~«Я подумаю над этим. Прощай».~
@20308 = ~«Первые два предложения можно проигнорировать: они просто запутывают тебя. Вспомни: 'всеобщий — планарный — язык' содержит три слова... Третье слово — 'язык'».~
@20309 = ~Посмеяться и уйти.~
@20310 = ~«Конечно. Прощай».~
@20311 = ~«Прощай».~
@20312 = ~«Да. Это язык».~
@20313 = ~«Да, но я тебе не скажу».~
@20314 = ~Ложь: «Э... нет. Прощай».~
@20315 = ~«Нет. Повтори мне загадку».~
@20316 = ~«Еще нет. Прощай».~
@20317 = ~«Конечно. Прощай».~
@20318 = ~«Хорошо. Это язык».~
@20319 = ~«Хорошо. Это язык».~
@20320 = ~«Я обещал не рассказывать».~
@20321 = ~«Разве я должен? Счастливо».~
@20322 = ~«Ладно, ладно. Это 'язык'».~
@20323 = ~«Прошу прощения. Счастливо».~
@20324 = ~Этот скелет мотает головой и хихикает себе под нос. Временами он начинает громко хохотать, закусывая свою костлявую руку, чтобы остановиться. Он довольно стар, так что на его костях не осталось плоти... только несколько цветных тряпок.~
@20325 = ~«Ага, здравствуй!» Он давится от смеха, при каждом выдохе из него вылетают облачка пыли.~
@20326 = ~«Тебе бы поискать ответы в другом месте, мне неохота слушать твои вопросы, — он прикрывает рот, хихикая. — Знаю, это ужасно грубо, но тебе придется простить меня».~
@20327 = ~Он насмешливо хихикает. «Не думаю!» Выражения твоего лица только усиливает его смех, он начинает клацать зубами.~
@20328 = ~Смех внезапно прекращается. «Пф!» — скелет отворачивается от тебя.~
@20329 = ~Он кивает, хихикая. «Хочешь ее услыхать?»~
@20330 = ~«Гм! Так, вспомни слова, которые кончаются на '-люс'. Вот два из них — полюс и плюс. Всеобщий планарный язык содержит три слова... Какое третье слово? Оно употребляется в каждодневной речи. Если ты слушал внимательно, то я его уже произнес».~
@20331 = ~«А-а-а! Как ты узнал?!»~
@20332 = ~[no text]~
@20333 = ~«Эх, троллиные отбросы! А, ладно. Только больше никому не говори ответ. Хотя бы пообещай мне это, добро?»~
@20334 = ~«Потому что мне нравится, когда люди стоят в ступоре, гадая загадку целую вечность, — он злобно хихикает, прикрывая рот костлявой рукой. — Ну как, обещаешь?»~
@20335 = ~«Запомни... — он прерывается, чтобы похихикать. — Никому не говори ответ!»~
@20336 = ~«Злодей! Портишь мне веселье, гореть бы тебе в Бааторе! Плюнул бы в тебя, да нечем! Пф!» Скелет отворачивается от тебя.~
@20337 = ~«Погоди, погоди! Никому не говори ответ. Хотя бы пообещай, добро?»~
@20338 = ~Скелет взрывается в припадке язвительного хохота. Он тычет в тебя костлявым пальцем и держится за воображаемый живот, смеясь и клацая зубами.~
@20339 = ~«Не скажу! *Не скажу*!» Выражения твоего лица только усиливает его смех.~
@20340 = ~Смех внезапно прерывается. «Что это? — он прикладывает костлявую ладонь ребром к виску. — Я слышу... вызов? Да... да... давай! Но если ты проиграешь или уйдешь на полпути, я больше не буду с тобой разговаривать!»~
@20341 = ~Он энергично кивает.~
@20342 = ~«Просто, слишком просто! Фунт золота *всегда* дороже половины фунта! Глупо, глупо!» — хихикает он.~
@20343 = ~Скелет наклоняется и рисует на пыли простенькое личико. Указывая на него, он произносит: «Дядей и братьев нет у меня, но его отец — сын моего отца. Кто он, а?»~
@20344 = ~«Ха! Твоя очередь».~
@20345 = ~Скелет по-детски хихикает. «Неправда, неправда! Ответ — гроб, а свой-то я точно видел!»~
@20346 = ~«Какое слово из одиннадцати букв даже величайшие из смертных мудрецов произносят неправильно?»~
@20347 = ~Он грозит тебе кулаком. «О-о-о, проклятье! Давай».~
@20348 = ~«Э... хм. А... звезды! Звезды, хи-хи!»~
@20349 = ~Скелет хрустит пальцами. «Что было завтра, а будет вчера?»~
@20350 = ~«А-а-а! Да, точно, это сегодня. Теперь ты».~
@20351 = ~Скелет начинает саркастически хихикать, но вдруг останавливается. «А... э-э. Вот дела».~
@20352 = ~Скелет опускает голову. «Я... не знаю».~
@20353 = ~Он кивает. «Это язык. Первое предложение и половину второго можно проигнорировать: они просто запутывают тебя. Вспомни: 'всеобщий — планарный — язык' содержит три слова... Третье слово — 'язык', — он громко вздыхает. — Твой ответ?»~
@20354 = ~«Хм... занимательно. Так какой же ответ? Ой... погоди! Куда ты уходишь?»~
@20355 = ~Скелета трясет от оглушающего хохота. Его гогот эхом отражается от стен катакомб. Он весело крутит черепом, без конца клацая зубами.~
@20356 = ~«Приветствую...»~
@20357 = ~Не обращать на него внимания, пройти мимо.~
@20358 = ~«Я так понял, у тебя есть сложная загадка».~
@20359 = ~«Мне нужен ответ на одну из твоих загадок».~
@20360 = ~«У меня есть несколько вопросов...» ~
@20361 = ~«Мне пора идти. Прощай».~
@20362 = ~«Я так понял, у тебя есть сложная загадка».~
@20363 = ~«Мне нужен ответ на одну из твоих загадок».~
@20364 = ~«Хорошо, я найду кого-нибудь еще. Счастливо».~
@20365 = ~«И что за загадка?»~
@20366 = ~Правда: «Говори, иначе я разобью тебя на маленькие хихикающие кусочки».~
@20367 = ~Блеф: «Говори, иначе я разобью тебя на маленькие хихикающие кусочки».~
@20368 = ~«Тогда прощай». ~
@20369 = ~~
@20370 = ~Уйти.~
@20371 = ~«Да».~
@20372 = ~«Нет, прощай».~
@20373 = ~«Конечно. Это 'язык'».~
@20374 = ~«Это... э... хм».~
@20375 = ~«Я подумаю над этим. Прощай».~
@20376 = ~«Первые два предложения проигнорировать: они просто запутывают тебя. Вспомни: 'всеобщий — планарный — язык' содержит три слова... Третье слово — 'язык'».~
@20377 = ~Уйти, смеясь.~
@20378 = ~«Почему я не должен?»~
@20379 = ~«Конечно. Я обещаю никому не рассказывать. Прощай».~
@20380 = ~«Я не буду ничего обещать. Прощай».~
@20381 = ~«Конечно. Я обещаю никому не рассказывать. Прощай».~
@20382 = ~«Я не буду ничего обещать. Прощай».~
@20383 = ~«Хорошо, хорошо. Прощай».~
@20384 = ~Уйти.~
@20385 = ~«Почему я не должен?»~
@20386 = ~«Конечно. Я обещаю никому не рассказывать. Прощай».~
@20387 = ~«Я не буду ничего обещать. Прощай».~
@20388 = ~«Ладно, ладно, какой ответ?»~
@20389 = ~«Хе. Прощай».~
@20390 = ~«Что, если мне удастся поставить тебя в тупик? Тогда ты мне скажешь?»~
@20391 = ~Правда: «Говори, иначе я разобью тебя на маленькие хихикающие кусочки».~
@20392 = ~Блеф: «Говори, иначе я разобью тебя на маленькие хихикающие кусочки».~
@20393 = ~«Тогда прощай». ~
@20394 = ~«Хорошо. Давай начнем».~
@20395 = ~«Не бери в голову. Прощай».~
@20396 = ~«Хм. Что дороже: фунт золотых монет достоинством по сотне или полфунта по двести?»~
@20397 = ~«Не бери в голову. Прощай».~
@20398 = ~«Отлично. Твоя очередь».~
@20399 = ~«Не бери в голову. Прощай».~
@20400 = ~«Он твой сын».~
@20401 = ~«Я... не знаю». ~
@20402 = ~«Не бери в голову. Прощай».~
@20403 = ~«Кто сделал — тому не нужно, кто купил — тот не пользуется, кто пользуется — тот не видит. Что это?»~
@20404 = ~«Не бери в голову. Прощай».~
@20405 = ~«Хорошо. Теперь твоя очередь».~
@20406 = ~«Не бери в голову. Прощай».~
@20407 = ~«Хм. 'Неправильно'».~
@20408 = ~«Я... не знаю». ~
@20409 = ~«Не бери в голову. Прощай».~
@20410 = ~«Рассыпалось к ночи золотое зерно, глянули утром — нет ничего».~
@20411 = ~«Не бери в голову. Прощай».~
@20412 = ~«Да, верно. Загадывай».~
@20413 = ~«Не бери в голову. Прощай».~
@20414 = ~«Ответ... а! 'Сегодня'».~
@20415 = ~«Я... не знаю». ~
@20416 = ~«Не бери в голову. Прощай».~
@20417 = ~«Сейчас. Чем кончаются жизнь и смерть?»~
@20418 = ~«Не бери в голову. Прощай».~
@20419 = ~«Ну? Я жду ответа».~
@20420 = ~Самому издевательски посмеяться над ним.~
@20421 = ~Терпеливо ждать.~
@20422 = ~«Скажи мне ответ на твою первую загадку, а я скажу тебе ответ на свою».~
@20423 = ~«Мягким знаком».~
@20424 = ~«Без шансов, без шансов. Прощай».~
@20425 = ~«Хорошо. Мягким знаком».~
@20426 = ~Посмеяться и уйти.~
@20427 = ~~
@20428 = ~Уйти.~
@20429 = ~Карта мира~
@20430 = ~Задания~
@20431 = ~Ложь: «Я сожалею о прошлой грубости... Я хочу извиниться».~
@20432 = ~Похоже, что женщина тебя не слышит. Вместо этого она тяжелым шагом подходит к одному из длинных столов и начинает ковыряться в одном из трупов. «Ну же... — она клацает зубами. — Не усложняй все для Марты... он все усложняет, правда, Марта?... Да-да, так и есть...»~
@20433 = ~Судя по всему, что она выковыривает зубы у мертвеца изо рта... одними лишь руками и ногтями. Когда у нее не получается, она берет расколотое деревянное долото и киянку, и колотит по деснам, пока зуб не высвобождается, затем кладет его в сумку на поясе.~
@20434 = ~Ошарашенная, Марта отпрыгивает от трупа и пронзительно визжит. «А-а-ай!» Она переводит дух и начинает злобно шипеть... на мертвеца на столе. «Если ты не мертвый, мог бы раньше что-нибудь сказать, фальшивый грязный труп, да! Как тебе не *стыдно*?»~
@20435 = ~«Ха! — Марта упирает руки в бока и возмущенно пыхтит. — Как будто тебе есть *дело* до твоих зубов! Все гнилые, дырявые и коричневые как сироп — удивительно, как они еще не выпали из твоей черепушки! — она чешет голову. — Разве не так, Марта? Да, все сгнили и пропали...»~
@20436 = ~«Ха! Слышала, Марта? Слышала? — лицо Марты сморщивается как тряпка. — Да слышала, Марта, слышала!» Бормоча, она начинает молотить по трупу кулаками, с каждым ударом слышится мясистый *чвак*. «Значит, будешь преследовать *меня*?! Вот тебе! Получай!»~
@20437 = ~«Чертовы жмурики... — Марта глубоко вздыхает и роняет долото возле себя. — Это уже лучше, а, Марта? Да-да... мертвец затих... да».~
@20438 = ~Марта прищуривается и оборачивается. «А? Как это ты сюда так скоро добрался? — бормочет она. — Марта, как это ему удалось? Без понятия».~
@20439 = ~Марта продолжает бормотать себе под нос что-то насчет *трупов* и *благодарности*, но ты не можешь разобрать, что именно.~
@20440 = ~Марта прищуривается и оборачивается. «А? Как это ты сюда так скоро добрался? — бормочет она. — Марта, как это ему удалось? Без понятия».~
@20441 = ~«Марта, этот спросил, кем я была? Да, спросил, спросил... — она начинает говорить нараспев. — Никем, кроме себя. Я Марта, Марта-швея... хм-м-м... Мар-та, шве-я... Мар-та, шве-я...» Она поворачивается назад к мертвецу, напевая свое имя.~
@20442 = ~Пыхтя, Марта поворачивается назад к трупу. «Пытаюсь сделать так, чтобы этот пень отдал свои ниточки и зубки, а он никак не хочет со-труд-ничать... — она грозит трупу пальцем, как маленькому ребенку. — Упрямый как камень, правда, Марта? — она делает недовольную гримасу. — Да-да...»~
@20443 = ~«Марта, он задал вопрос?.. — Марта моргает, потом хмурится. — Да, Марта, он его задал — у него 'вопросительный' вид...»~
@20444 = ~«Нужно вытянуть ниточки и зубки... эй, Марта, может, поможешь мне... я и так тебе *помогаю*, старая ты дуреха... не нужно говорить со мной таким тоном... ага, вытягиваю ниточки и зубки. И штучки изнутри».~
@20445 = ~«Штучки».~
@20446 = ~«Я их заготавливаю — вот что я здесь делаю, — она чешет голову. — Да, Марта, так мы и делаем... ниточки от швов и зубки ценные: их можно обменять на дзынь-дзынь. 'Обирай трупы, которые мы тебе приносим, говорят они. Вынимай из трупов зубки, ниточки, штучки, обирай их дочиста, а потом мы продадим их трухлявым».~
@20447 = ~Марта хмурится. «Разве мы не сказали, что продаем их, Марта? — она хмурится еще сильнее, затем качает головой. — Да, Марта, мы сказали. Трухлявые скупают тела, но сначала мы снимаем с них все, что можем».~
@20448 = ~«Штучки, штучки... — она кособоко пожимает плечами. — Их забирают другие».~
@20449 = ~«Толстомордый жадный кабан Квинт, и еще один хромоногий, странноватый Фарод, так ведь, Марта? — она выдает чудаковатую улыбку и кивает. — Да, Марта, все так...»~
@20450 = ~Марта пожимает плечами. «Этот спрашивает, где Фарод? Он здесь, Марта, разве нет?.. — она кивает. — Да, Марта, Фарод здесь. В одном из здешних домов...»~
@20451 = ~«Продают. Продают за блестяшки».~
@20452 = ~Марта смотрит на тебя прищурено. «Хм-м, — она кивает. — Марта может это сделать, правда, Марта? Да, это можно».~
@20453 = ~Марта смотрит на тебя прищурено. «Хм-м, — она кивает. — Марта может это сделать, правда, Марта? Да, это можно... — она выставляет расколотое долото. — Где? Где...» Марта осматривает тебя, будто подыскивая подходящее место для вскрытия.~
@20454 = ~«Где? Где...» Марта осматривает тебя, будто подыскивая подходящее место для вскрытия.~
@20455 = ~Постепенно к тебе возвращается зрение... Марта стоит над тобой, качая головой. «Ничего, ничего не нашла, да, Марта? Нет, ничего, Марта, не повезло... Попробуем еще?»~
@20456 = ~Она выглядит озадаченной. «Купить? Звенелки? Разве ты не пришел кое-что забрать... ты ведь за этим сюда пришел? Забрать нитки, кости, шуршащие зубки?»~
@20457 = ~«Вот то, зачем ты пришел... — она передает тебе предметы. — Все, что есть. Все, что есть...»~
@20458 = ~Она пялится на монеты в твоей руке, будто не зная, что с ними сделать. «Блестяшки. Блестят... — она хмурится. — Еще раз, что они хотят, Марта? — бормочет она. — Марта... Марта, что они хотят?»~
@20459 = ~Марта кивает. «Марта дома, Марта здесь спит; да, ты можешь здесь поспать, если вдруг захочешь. Не думаю, что Марта будет против... ведь так, Марта? — она мотает головой. — Нет-нет, Марта, я не против, если ты не против...»~
@20460 = ~Когда ты произносишь это, Марта бросает на тебя взгляд. «Марта, этот задал вопрос?.. — Марта моргает, затем хмурится. — Да, Марта, он его задал: у него 'вопросительный' вид...»~
@20461 = ~«Штучки изнутри, штучки изнутри... да, Марта? — она кивает, потом качает головой. — Когда они в них есть, Марта, когда они в них есть...» ~
@20462 = ~Ты лежишь на столе, и последнее, что ты видишь — Марту, стоящую над тобой с долотом и киянкой наготове. Слышится резкий *хруст*, под твой вопль все покрывается тьмой.~
@20463 = ~Ты лежишь на столе, Марта стоит над тобой с долотом и киянкой наготове. Слышится *хруст*, когда она раскалывает тебе грудную клетку, и ты давишься своим криком, когда она начинает ковыряться в твоих легких... как только ты пытаешься вздохнуть, все немеет, и от боли у тебя мутнеет в глазах.~
@20464 = ~Ты лежишь на столе, над тобой стоит Марта с ржавым ножом наготове. Ты испытываешь пронзительную боль, когда она втыкает его в твой живот, а затем пилящим движением безжалостно разрезает его сверху донизу, раскрывая твои внутренности. Несмотря на боль, ты с нездоровым немым очарованием наблюдаешь, как она вынимает твои органы, мурлыкая себе под нос...~
@20465 = ~«О!» Ты испытываешь душераздирающую боль, когда Марта поднимает липкую массу твоих внутренностей, с которых стекает кровь и другие жидкости. «Погляди-ка, Марта... погляди на это... вижу-вижу, разрезай, разрезай...» Марта производит небольшой ловкий надрез на твоих внутренностях, и ты слышишь *дзинь*, как будто на пол упало что-то маленькое и металлическое. ~
@20466 = ~Марта бросает влажную массу тебе в живот и наклоняется, поднимая предмет... кажется, кольцо. Она бросает его тебе. «Прелесть-то какая, а, Марта? — она кивает. — Да, Марта, не стоит глотать такие вещи, нет, нет...»~
@20467 = ~«У меня ничего больше нет, так ведь, Марта? — она кивает. — Этот забрал все в последний раз, больше нет, больше нет...» ~
@20468 = ~Ты лежишь на столе, над тобой стоит Марта с ржавым ножом наготове. Ты испытываешь пронзительную боль, когда она втыкает его в твой живот, а затем пилящим движением безжалостно разрезает его сверху донизу, раскрывая твои внутренности. Несмотря на боль, ты с нездоровым немым очарованием наблюдаешь, как она вынимает твой желудок...~
@20469 = ~«Она же слепая и почти глухая».~
@20470 = ~«Мне кажется, она имеет в виду органы. Надеюсь, что она имеет в виду органы».~
@20471 = ~Морт поворачивается к Марте. «Да, 'штучки', — он поворачивается к тебе. — Все дело в смысле слов».~
@20472 = ~«Я *не собираюсь* на это смотреть».~
@20473 = ~«Приветствую».~
@20474 = ~Уйти.~
@20475 = ~«Здравствуй, Марта».~
@20476 = ~«Марта, у меня есть вопросы к тебе...»~
@20477 = ~Игнорировать Марту.~
@20478 = ~«Э... Приветствую?»~
@20479 = ~Наблюдать за тем, что она делает.~
@20480 = ~Наблюдать за тем, что она делает.~
@20481 = ~Игнорировать Марту.~
@20482 = ~«Э... чем это ты занимаешься?»~
@20483 = ~Не обращать внимания на Марту и изучить комнату.~
@20484 = ~Произнести: «Это *тебе* должно быть стыдно. Выламываешь мне зубы... ты что, не уважаешь мертвых?»~
@20485 = ~Произнести: «Это *тебе* должно быть стыдно. Вытягиваешь мои швы и зубы... ты что, не уважаешь мертвых?»~
@20486 = ~«Это сказал я, а не мертвец».~
@20487 = ~«Это сказал я, а не мертвец».~
@20488 = ~Игнорировать Марту.~
@20489 = ~Произнести: «Уууу... Марта, ты будешь *наказана* за свое злодейское выдирание зубов. Я буду *преследовать* тебя до конца твоих дней...»~
@20490 = ~«Это сказал я, а не мертвец».~
@20491 = ~«Это сказал я, а не мертвец».~
@20492 = ~Игнорировать Марту.~
@20493 = ~Произнести: «Уууу... прекрати... прекрати... я не буду тебя преследовать... прости меня...» ~
@20494 = ~«Это сказал я, а не мертвец».~
@20495 = ~«Это сказал я, а не мертвец».~
@20496 = ~Игнорировать Марту.~
@20497 = ~«Это сказал я, а не мертвец».~
@20498 = ~«Это сказал я, а не мертвец».~
@20499 = ~Игнорировать Марту.~
@20500 = ~«Кто ты?»~
@20501 = ~«Э... ладно. Мне нужно идти. Прощай».~
@20502 = ~«Кто ты?»~
@20503 = ~«Э... ладно. Мне нужно идти. Прощай».~
@20504 = ~«Чем ты занимаешься?»~
@20505 = ~«Чем ты занимаешься?»~
@20506 = ~«Э... ладно. Мне нужно идти. Прощай».~
@20507 = ~«Ниточки... и зубки? О чем это ты?»~
@20508 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20509 = ~«Э... ладно. Мне нужно идти. Прощай».~
@20510 = ~«Кто ты?»~
@20511 = ~«Чем ты занимаешься?»~
@20512 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20513 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20514 = ~«Ты можешь покопаться в моем теле — вдруг там что-нибудь есть?»~
@20515 = ~«Ты можешь покопаться в моем теле — вдруг там что-нибудь есть?»~
@20516 = ~«Можно здесь отдохнуть?»~
@20517 = ~«Ты вспарываешь у трупов швы... можно купить у тебя иголку и нитки?»~
@20518 = ~«Ты может дать мне что-нибудь из того, что ты вытащила из трупов?»~
@20519 = ~«Можно посмотреть, что ты вытащила из трупов за последнее время?»~
@20520 = ~«Ничего подобного. Мне нужно идти. Прощай».~
@20521 = ~«Штучки изнутри?»~
@20522 = ~«Штучки изнутри?»~
@20523 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20524 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20525 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20526 = ~«Э... ладно. Мне нужно идти. Прощай».~
@20527 = ~«Вы продаете трупы трухлявым?..»~
@20528 = ~«Кто говорит тебе делать это?»~
@20529 = ~«Что ты находишь в телах?»~
@20530 = ~«Ты находишь в трупах вещи? Можешь покопаться в моем теле — вдруг там что-нибудь есть?»~
@20531 = ~«Ты находишь в трупах вещи? Можешь покопаться в моем теле — вдруг там что-нибудь есть?»~
@20532 = ~«Ты вспарываешь у трупов швы... можно купить у тебя иголку и нитки?»~
@20533 = ~«Ты может дать мне что-нибудь из того, что ты вытащила из трупов?»~
@20534 = ~«Можно посмотреть, что ты вытащила из трупов за последнее время?»~
@20535 = ~«Ты не против, если я здесь отдохну?»~
@20536 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20537 = ~«Э... отлично. На том и распрощаемся».~
@20538 = ~Похоже, что Марта-швея занимается тем, что обрабатывает трупы, которые ей дают: вырывает их зубы, распарывает швы, обыскивает их снаружи и внутри в поисках любых ценностей, а затем зашивает.~
@20539 = ~«Кто сказал тебе обирать мертвецов?»~
@20540 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20541 = ~«Это все, что я хотел узнать. Прощай».~
@20542 = ~«Кто?»~
@20543 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20544 = ~«Это все, что я хотел узнать. Прощай».~
@20545 = ~«Фарод? Где он?»~
@20546 = ~«Что они делают с вещами, которые ты выковыриваешь из трупов?»~
@20547 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20548 = ~«Это все, что я хотел узнать. Прощай».~
@20549 = ~«Что они делают с вещами, которые ты выковыриваешь из трупов?»~
@20550 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20551 = ~«Это все, что я хотел узнать. Прощай».~
@20552 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20553 = ~«Это все, что я хотел узнать. Прощай».~
@20554 = ~«Проверим желудок...»~
@20555 = ~«Как насчет грудной клетки?..»~
@20556 = ~«Проверь внутренности... там может быть все что угодно».~
@20557 = ~«Можешь расколоть мне череп?».~
@20558 = ~«Неважно. У меня есть другие вопросы...»~
@20559 = ~«Э... неважно. Прощай».~
@20560 = ~«Проверим желудок...»~
@20561 = ~«Как насчет грудной клетки?..»~
@20562 = ~«Проверь внутренности... там может быть все что угодно».~
@20563 = ~«Можешь расколоть мне череп?».~
@20564 = ~«Неважно. У меня есть другие вопросы...»~
@20565 = ~«Э... неважно. Прощай».~
@20566 = ~«П... П... Проверим желудок...»~
@20567 = ~«Кы... Кы... Как насчет грудной клетки?..»~
@20568 = ~«Пы... пы... проверь внутренности... там может быть все что угодно».~
@20569 = ~«Р... р... Расколи мне череп, ладно?»~
@20570 = ~«Ны... ны... нет, у меня есть еще пара вопросов...»~
@20571 = ~«Пы... пы... пока нет. Прощай».~
@20572 = ~Ложь: «Да, я пришел их забрать».~
@20573 = ~«Нет, я не за ними пришел: я хочу кое-что у тебя купить».~
@20574 = ~«Нет, я не за ними пришел: я хочу кое-что у тебя купить... когда у меня появятся лишние деньги. А пока у меня несколько вопросов...»~
@20575 = ~«Неважно. У меня есть другие вопросы...»~
@20576 = ~«Э... неважно. Прощай».~
@20577 = ~«Спасибо. У меня есть другие вопросы...»~
@20578 = ~«Спасибо... это мне пригодится. Прощай».~
@20579 = ~«Можно посмотреть, что у тебя есть?»~
@20580 = ~«Неважно. У меня есть другие вопросы...»~
@20581 = ~«Э... неважно. Прощай».~
@20582 = ~Вы уверены, что хотите покинуть игру?~
@20583 = ~«Хорошо...»~
@20584 = ~«Мне пока не до отдыха. У меня есть несколько вопросов...»~
@20585 = ~«Пожалуй, я вернусь, когда мне нужно будет поспать. Счастливо».~
@20586 = ~«Кто ты?»~
@20587 = ~«Чем ты занимаешься?»~
@20588 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20589 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20590 = ~«Ты можешь покопаться в моем теле — вдруг там что-нибудь есть?»~
@20591 = ~«Ты можешь покопаться в моем теле — вдруг там что-нибудь есть?»~
@20592 = ~«Можно здесь отдохнуть?»~
@20593 = ~«Ты вспарываешь у трупов швы... можно купить у тебя иголку и нитки?»~
@20594 = ~«Ты может дать мне что-нибудь из того, что ты вытащила из трупов?»~
@20595 = ~«Можно посмотреть, что ты вытащила из трупов за последнее время?»~
@20596 = ~«Ничего подобного. Мне нужно идти. Прощай».~
@20597 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20598 = ~«Зачем ты достаешь из трупов зубы и швы?»~
@20599 = ~«Понятно... Могу ли я задать тебе пару вопросов?»~
@20600 = ~«Э... ладно. Мне нужно идти. Прощай».~
@20601 = ~Пасть во тьму...~
@20602 = ~Я попросил Марту... чокнутую швею из Погребенной деревни... поискать у меня в черепе какие-нибудь вещи. Она ничего не нашла.~
@20603 = ~Пасть во тьму...~
@20604 = ~Наблюдать...~
@20605 = ~Пасть во тьму...~
@20606 = ~«Э-э-э-экк...»~
@20607 = ~Я попросил Марту... чокнутую швею из Погребенной деревни... обыскать мои внутренности: вдруг там что-нибудь спрятано. Она нашла кольцо... и еще оставила мне кусок моих внутренностей.~
@20608 = ~«С-спасибо... там... еще... что-то... было?..»~
@20609 = ~«Хорошо. У меня есть другие вопросы...»~
@20610 = ~«Тогда неважно. Прощай».~
@20611 = ~Наблюдать...~
@20612 = ~«Марта, зачем ты достаешь из трупов зубы и швы?»~
@20613 = ~«Марта, зачем ты достаешь из трупов зубы и швы?»~
@20614 = ~«Э... ладно. Мне нужно идти, Марта. Прощай».~
@20615 = ~Тело неподвижно. Без тычков и уколов оно ничего не говорит и не делает.~
@20616 = ~«Это не очень-то похоже на зомби...»~
@20617 = ~Испустив пустой вздох, тело судорожно дергается, словно по нему идет электрический ток.~
@20618 = ~«Приветствую».~
@20619 = ~«Кто ты?»~
@20620 = ~«Мне нужно задать тебе несколько вопросов...»~
@20621 = ~«Приветствую».~
@20622 = ~«Н-н-н-х-г! Агх...» — бубнит тело своим разжиженным языком, но ты не можешь понять ни единого слова.~
@20623 = ~«Тогда забудь об этом...»~
@20624 = ~«Тогда забудь об этом...»~
@20625 = ~Анна нервно переминается с ноги на ногу. «Лучше не бесить мертвых. А то может беда приключиться».~
@20626 = ~«Все нормально. Это тело все равно ничего не скажет. Идем».~
@20627 = ~Анна нервно переминается с ноги на ногу. «Лучше не бесить мертвых. А то может беда приключиться».~
@20628 = ~«Возможно, у него есть ответы для нас».~
@20629 = ~«Ясен пень, здесь нет ничего интересного. Пойдем, а? От телеги с трупами ничего толкового не получишь».~
@20630 = ~«Идем».~
@20631 = ~«Кто ты?»~
@20632 = ~«Мне нужно задать тебе несколько вопросов...»~
@20633 = ~«Забудь».~
