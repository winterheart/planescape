@35274 = ~Этот труп женщины выглядит особенно отвратительно: он лишен ушей, носа и губ. Чтобы зашить рот, препарирующему пришлось стягивать кожу вокруг рта очень туго; через оставшуюся открытой щель все еще можно разглядеть ряд кривых желтых зубов. На лбу вырезан номер «891».~
@35275 = ~«Итак... чем занимаешься вечером?»~
@35276 = ~Труп продолжает пялиться на тебя.~
@35277 = ~«Тогда прощай». ~
@35278 = ~«Пссст. Видел, как она посмотрела на меня? А? Ты видел это? Как она огибала взглядом кривую моей затылочной кости?»~
@35279 = ~«О чем это ты *толкуешь*?»~
@35280 = ~«Чт... да ты что, ОСЛЕП?! Она меня изучала! Она бесстыдно меня ХОТЕЛА!»~
@35281 = ~«Скорее хотела, чтобы ты *исчез*. Да она была слишком занята МНОЙ, чтобы отвлекаться на какую-то болтающуюся голову с большим ртом».~
@35282 = ~«Тобой? Ага, конечно! Уж поверь мне, крошкам из могил нет дела до 'мускулатуры', 'у меня великолепное тело' и 'я весь в шрамах и круто выгляжу'. Им нужны парни с ДУШОЙ. Типа меня, шеф. А трупов вроде ТЕБЯ повсюду навалом, как грязи».~
@35283 = ~«Как знаешь, Морт. Идем».~
@35284 = ~«По-моему, у тебя слишком богатое воображение. Она зомби. Труп. Мертвая. Скорее всего, она тебя даже не заметила».~
@35285 = ~«Да-да-да, как пожелаешь. Если бы ты был настолько долго мертв, как я, ты бы улавливал сигналы. Для тебя они, наверно, слишком ТОНКИЕ, чтобы их уловить, но именно поэтому я буду проводить ночи напролет с сочной свежеумершей крошкой, а ты будешь бегать вокруг с воплями 'А?' 'Чего здесь творится?' 'Куда пропала моя па-па-память?'»~
@35286 = ~«Как знаешь, Морт. Идем».~
@35287 = ~«По-моему, тебе стоит время от времени отключать свое воображение».~
@35288 = ~«Как знаешь, Морт. Идем».~
@35289 = ~«Ты имеешь в виду этот бессмысленный пустой могильный взгляд?»~
@35290 = ~«Тогда прощай». ~
@35291 = ~«Тогда прощай». ~
@35292 = ~«Итак... чем занимаешься вечером?»~
@35293 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@35294 = ~Использовать на трупе свою способность «История костей».~
@35295 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35296 = ~«Тогда прощай». ~
@35297 = ~«Тогда прощай». ~
@35298 = ~«Тогда прощай». ~
@35299 = ~«Было приятно с тобой поболтать. Прощай».~
@35300 = ~Оставить труп в покое.~
@35301 = ~«Было приятно с тобой поболтать. Прощай».~
@35302 = ~Оставить труп в покое.~
@35303 = ~«Было приятно с тобой поболтать. Прощай».~
@35304 = ~Оставить труп в покое.~
@35305 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35306 = ~Этот оживленный скелет ужасно воняет, как будто бы его совсем недавно ободрали и препарировали. Его челюсти и основные суставы крепко связаны кожаными ремешками, поверх тела надет грубый комбинезон. На его лбу вырезан номер «1221».~
@35307 = ~«Прошу прощения, тебе не попадались другие скелеты?»~
@35308 = ~Скелет не отвечает.~
@35309 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@35310 = ~«Хм-м. Интересно, что подумает этот седобородый, если *я* возьму взаймы его тело...»~
@35311 = ~«Седобородый?»~
@35312 = ~«Седобородый... ну знаешь, старикашка, старичье, рухлядь... старый».~
@35313 = ~«Ну, не думаю, что у него есть хоть один аргумент против. Почему бы и не взять его тело?»~
@35314 = ~Морт изучает скелет, но затем качает головой. «Не... Мне нужно что-нибудь посвежее. И что-нибудь чуть более величественней... а этот какой-то весь скрипучий и в трещинах».~
@35315 = ~«А ты, значит, нет?»~
@35316 = ~«Ох, да ты просто кладезь хохм, — Морт свирепо смотрит на тебя. — Да и вообще. НА СЕБЯ посмотри. Зеркала молят о пощаде, когда ты проходишь мимо них».~
@35317 = ~«Да? Зато у *меня* все при себе».~
@35318 = ~Морт фыркает. Тебе совершенно непонятно, как это ему удалось без легких.~
@35319 = ~«Позволь мне сказать, Морт. Нет ничего лучше, чем ходить, размахивать руками, вдыхать свежий воздух через полные легкие. Иметь тело — это ОЧЕНЬ приятно».~
@35320 = ~«Да будет тебе известно, что помощь тебе в побеге из препараторской только что добавлена в растущий список моих сожалений, — Морт снова фыркает. — Надо было оставить тебя там гнить... подольше, то есть».~
@35321 = ~«Очень приятно это слышать. Идем».~
@35322 = ~«Идем».~
@35323 = ~«Идем».~
@35324 = ~«Ладно. Идем».~
@35325 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@35326 = ~«Не думаю, что он имеет что-то против».~
@35327 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@35328 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@35329 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@35330 = ~«Прошу прощения, тебе не попадались другие скелеты?»~
@35331 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать: не похоже, что у тебя есть что скрывать».~
@35332 = ~«Один вопрос: зачем комбинезон? То есть, я хочу сказать: не похоже, что у тебя есть что скрывать».~
@35333 = ~Использовать на скелете свою способность «История костей».~
@35334 = ~Скелет не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@35335 = ~Оставить скелет в покое.~
@35336 = ~Оставить скелет в покое.~
@35337 = ~Оставить скелет в покое.~
@35338 = ~Внимательно осмотреть скелет.~
@35339 = ~Кто-то позаботился о том, чтобы связать кости скелета кожаными ремнями, обвивающими тело на манер, напоминающий мускулы и сухожилия. Ремни привязаны к железными скобам, вбитым в суставы скелета. Кажется, этот скелет сослужил хорошую службу: кости растрескались, многочисленные трещины на них залиты вонючим клеем.~
@35340 = ~Попробовать вытащить скобы из суставов скелета.~
@35341 = ~«Эй, шеф. Это уже вандализм. Эти скобы — возможно, единственное, что не дает рассыпаться этому мешку с костями. Знаешь, с такими приятелями некромантия чудес не творит».~
@35342 = ~«И что?»~
@35343 = ~«Да нет, ничего». Морт делает странный жест. Тебе это кажется похожим на пожимание плечами. «Просто не был уверен, что ты это знаешь. Валяй, можешь попробовать».~
@35344 = ~Попробовать вытащить скобы из суставов скелета.~
@35345 = ~Ты тянешь за железные скобы, но тебе не хватает сил, чтобы вытащить их. Они накрепко забиты.~
@35346 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хм-м. Я еще вернусь, Костяшка».~
@35347 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хм-м. Я еще вернусь, Костяшка».~
@35348 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хм-м. Я еще вернусь, Костяшка».~
@35349 = ~Оставить скелет в покое.~
@35350 = ~Оставить скелет в покое.~
@35351 = ~Оставить скелет в покое.~
@35352 = ~Попробовать вытащить скобы из суставов скелета.~
@35353 = ~Ты тянешь за железные скобы изо всех сил, и через несколько мгновений вырываешь их из суставов. Скелет разваливается, некоторые из его костей продолжают шевелиться.~
@35354 = ~«Извини, Костяшка...»~
@35355 = ~Попробовать вытащить скобы из суставов скелета.~
@35356 = ~С помощью ломика ты вырываешь скобы из суставов. Скелет разваливается, хотя некоторые кости продолжают шевелиться.~
@35357 = ~«Извини, Костяшка...»~
@35358 = ~«Неважно, может быть, в другой раз».~
@35359 = ~«Неважно, может быть, в другой раз».~
@35360 = ~«О... Я не хотел ему навредить».~
@35361 = ~«Ну, тогда ладно. Может, в другой раз».~
@35362 = ~Попробовать вытащить скобы из суставов скелета.~
@35363 = ~Попробовать вытащить скобы из суставов скелета.~
@35364 = ~Попробовать вытащить скобы из суставов скелета.~
@35365 = ~«Не против, если я возьму немного ремешков и скоб?»~
@35366 = ~«Не против, если я возьму немного ремешков и скоб?»~
@35367 = ~«Не против, если я возьму немного ремешков и скоб?»~
@35368 = ~Оставить скелет в покое.~
