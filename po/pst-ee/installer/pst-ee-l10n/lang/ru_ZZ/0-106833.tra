@31209 = ~«Да... Очень интересно... но я должен идти. Прощай».~
@31210 = ~В этом окне содержатся параметры, управляющие свойствами звука в игре. Выберите параметр для отображения описания его действия.~
@31211 = ~STRREF_OPTIONS_HELP_GAMEPLAY~
@31212 = ~В этом окне содержатся параметры, изменяющие поведение игры. Выберите параметр для отображения описания его действия.~
@31213 = ~В этом окне содержатся параметры, управляющее объемом обратной связи в игре. Наведите указатель мыши на параметр для отображения описания его действия.~
@31214 = ~В этом окне содержатся параметры, определяющие, когда игра будет автоматически ставиться на паузу. Наведите указатель мыши на параметр для отображения описания его действия.~
@31215 = ~Если включить этот параметр, игра будет идти в полноэкранном режиме. В противном случае, игра будет идти в оконном режиме.~
@31216 = ~Если включить этот параметр, игра будет делать все отражения спрайтов программно, не используя аппаратное ускорение. Используй этот параметр только в случае, если графическая карта не поддерживает должным образом отражения спрайтов.~
@31217 = ~Всегда использовать дизеринг~
@31218 = ~Кровь~
@31219 = ~<WEAPONNAME>~
@31220 = ~Если включить этот параметр, игра будет выполнять полупрозрачный блиттинг спрайтов программно, не используя аппаратное ускорение. Используй этот параметр только в случае, если драйверы графической карты некорректно отрисовывают полупрозрачные спрайты.~
@31221 = ~Если включить этот параметр, игра будет выполнять непрозрачный блиттинг программно, не используя аппаратное ускорение. Используй этот параметр только в случае, если драйверы графической карты некорректно выполняют обычный блиттинг.~
@31222 = ~Если включить этот параметр, спрайты, перекрытые отсекающими полигонами, будут становиться полупрозрачными (дизеринг). Это улучшает видимость персонажей.~
@31223 = ~Если включить этот параметр, в игре будут показываться жестокие сцены. В противном случае, жестокие сцены показываться не будут.~
@31224 = ~Если включить этот параметр, игра будет использовать технологию Creative Labs EAX. Параметр неактивен, если в твоей системе нет звуковой карты с поддержкой EAX.~
@31225 = ~Управление громкостью музыки в игре.~
@31226 = ~Управление громкостью голосов в игре.~
@31227 = ~Управление громкостью звуковых эффектов окружения в игре.~
@31228 = ~Управление громкостью звуковых эффектов в игре.~
@31229 = ~Управление громкостью роликов в игре.~
@31230 = ~Этот параметр управляет скоростью пролистывания главного игрового экрана с помощью мыши.~
@31231 = ~Этот параметр управляет скоростью пролистывания главного игрового экрана с помощью клавиш стрелок на клавиатуре.~
@31232 = ~Этот параметр управляет задержкой перед появлением подсказок, если навести мышью на элемент управления. Если установить бегунок в крайнее левое положение, подсказки будут появляться мгновенно. Крайнее правое положение выключает подсказки.~
@31233 = ~Этот параметр определяет сложность игрового процесса. При перемещении бегунка влево противники будут наносить меньше урона, делая игру проще. При перемещении бегунка вправо противники будут наносить больше урона, делая игру сложнее.~
@31234 = ~Яркость~
@31235 = ~Он попросту отворачивается и уходит.~
@31236 = ~Этот гигант носит такие же гигантские, богато украшенные красные доспехи. Подходя к нему, даже сквозь щели в его шлеме ты видишь, как подозрительно он на тебя смотрит.~
@31237 = ~Неожиданно он поднимает оружие. «Так я и думал: ты — это он!» Он стремительно атакует тебя, подзывая криками других стражников.~
@31238 = ~«Приветствую».~
@31239 = ~Оставить его в покое.~
@31240 = ~«Минутку.. У меня несколько вопросы...»~
@31241 = ~«Прощай».~
@31242 = ~Уйти.~
@31243 = ~«Приветствую...»~
@31244 = ~Оставить его в покое.~
@31245 = ~Защищаться.~
@31246 = ~Убежать.~
@31247 = ~Все еще нет ответа. У тебя появляется ощущение, что Ки-Саи, возможно, испытывает твое терпение.~
@31248 = ~~
@31249 = ~~
@31250 = ~~
@31251 = ~Проходит несколько минут, но Ки-Саи все еще не дает ответ.~
@31252 = ~~
@31253 = ~~
@31254 = ~~
@31255 = ~~
@31256 = ~~
@31257 = ~Тихо подождать еще пару минут...~
@31258 = ~Тихо подождать еще пару минут...~
@31259 = ~Тихо подождать еще пару минут...~
@31260 = ~Сдаться и уйти.~
@31261 = ~«Хм?» — она убирает палец изо рта и приглаживает назад локон, опустившийся ей на глаза.~
@31262 = ~«Приветствую...»~
@31263 = ~Оставить женщину в покое.~
@31264 = ~«Вы случайно не леди Торнкомб?»~
@31265 = ~«У меня есть несколько вопросов...» ~
@31266 = ~«Не обращайте внимания. Прощайте».~
@31267 = ~Ее глаза моментально расширяются. Она отворачивается от тебя. «Нет-нет, это не я, сэр».~
@31268 = ~«Я все же думаю, что это вы, госпожа. Мне сказали, что вы наставница магов в Городском Фестхолле».~
@31269 = ~«Лгунья из вас неважная, знаете ли».~
@31270 = ~«Тогда кто вы, могу ли я поинтересоваться?»~
@31271 = ~«И все же у меня есть несколько вопросов...»~
@31272 = ~«Тогда мне нужно идти. Прощайте».~
@31273 = ~Леди Торнкомб угрюмо смотрит на тебя. «А хоть бы я и была той женщиной? Что с того?»~
@31274 = ~«Я надеялся пройти обучение магическим искусствам».~
@31275 = ~«Тогда у меня есть несколько вопросов к вам...»~
@31276 = ~«Ничего, неважно. Прощайте».~
@31277 = ~«Тогда я разобью ваши надежды. Я больше не хочу обучать магии... а теперь уходите, оставьте меня в покое».~
@31278 = ~«Но почему?»~
@31279 = ~«Перед тем, как уйти, я задам несколько вопросов...»~
@31280 = ~«Прощайте».~
@31281 = ~«Как будто это хоть как-то вас касается!»~
@31282 = ~«Но это так... Я хочу учиться, вы можете учить. Хотел бы я знать, как мне убедить вас обучать меня».~
@31283 = ~«Тогда ладно. Прощай».~
@31284 = ~Она качает головой. «Это не всегда так... маги физически немощны, наши заклинания — словно костыли, восполняющие нашу неполноценность. Когда магия потрачена, сама битва может еще продолжаться».~
@31285 = ~«Понятно. У меня есть другие вопросы...»~
@31286 = ~«Понимаю. Спасибо и прощайте».~
@31287 = ~«Хорошо, спрашивайте, что хотите». Голос ее звучит равнодушно.~
@31288 = ~«Вы случайно не леди Торнкомб?»~
@31289 = ~«Ки-Саи не хочет меня обучать... он говорит, что в бою магия эффективнее рукопашной схватки. Что вы об этом думаете?»~
@31290 = ~«У меня есть вопросы на счет вас...»~
@31291 = ~«У меня вопрос об этом месте...»~
@31292 = ~«Вообще-то, ничего особенного. Прощайте».~
@31293 = ~Она громко вздыхает и продолжает грызть ноготь на большом пальце. «Сомневаюсь, что вы можете предложить мне хоть что-то из того, что я не могу достать сама. Камни переживаний обеспечивают меня всем, чего я не могу купить на свое внушительное состояние».~
@31294 = ~«Камни переживаний?»~
@31295 = ~«Тогда ладно. Прощай».~
@31296 = ~«М-м-м, да... в каждом из камней записаны те или иные переживания. Когда я впервые пришла в эти залы, я проводила с ними мало времени. Только теперь я понимаю, как много всего пропустила...»~
@31297 = ~«Что же вы пропустили?»~
@31298 = ~«Тогда ладно. Прощай».~
@31299 = ~Леди Торнкомб, похоже, впала в зависимость от камней переживаний и предпочитает тратить свое время на испытание чужих переживаний, а не выполнение своих обязанностей в качестве наставника магии. Интересно, можно ли убедить ее продолжить обучение...~
@31300 = ~Она кивает, улыбаясь. Ее глаза принимают стеклянный блеск, она начинает вести себя напряженно. «Здесь, среди камней, можно прожить целую жизнь... одно изумительное впечатление за другим... их великолепие невозможно передать простыми словами. Попробуйте сами, сэр».~
@31301 = ~«Вы, кажется... пристрастились».~
@31302 = ~«Возможно, я так и сделаю. Прощайте».~
@31303 = ~Она сердито отвечает: «Вздор! Я могу остановиться в любую минуту! Я просто *решила* насладиться этим чудом. Зачем впустую тратить свое время на обучение неблагодарных подмастерьев-оболтусов, когда можно оставаться здесь, среди этих драгоценных камней, проживая по сотне новых жизней в день?»~
@31304 = ~«Не думаю, что камни здесь для этого. Может, вам следует поискать собственные переживания, которыми можно было бы поделиться?»~
@31305 = ~«Тогда неважно. Прощайте».~
@31306 = ~«Пф! *Ваше* мнение меня не сильно волнует. Прощайте».~
@31307 = ~Уйти.~
@31308 = ~Собираясь задать вопрос, ты понимаешь, что она и не смотрит на тебя... не говоря уже о том, чтобы обратить на тебя внимание.~
@31309 = ~«Привет? У меня вопрос...»~
@31310 = ~«Леди Торнкомб? Мой вопрос...»~
@31311 = ~Оставить ее.~
@31312 = ~Леди Торнкомб усмехается. «А вы — изуродованная шрамами человеческая развалина, больше похожая на труп с жалким подобием жизни. Убирайтесь сейчас же».~
@31313 = ~«Поговори со мной так — и *сама* станешь трупом».~
@31314 = ~«Погодите... Я надеялся получить обучение магическим искусствам».~
@31315 = ~«Еще нет. У меня есть другие вопросы к вам...»~
@31316 = ~«Ничего, неважно. Прощайте».~
@31317 = ~Она издевательски смеется над тобой. «Бейте себя в грудь перед тем, кто считает вас хоть немного страшным. Иначе мне это начнет казаться уже не забавным, а оскорбительным... и тогда лучше бы вас не было поблизости».~
@31318 = ~«Напротив, давай перейдем к сути, надменная ведьма».~
@31319 = ~«Я... не предполагал такого развития событий. Позвольте мне извиниться...»~
@31320 = ~«Я ухожу, потому что устал от тебя, и только. Прощай».~
@31321 = ~Просто уйти прочь.~
@31322 = ~Она качает головой с громким вздохом. «Я с радостью приму ваши извинения, если только вы оставите меня в покое».~
@31323 = ~«Но я ведь надеялся обучиться магическим искусствам».~
@31324 = ~«Минутку, у меня есть еще вопросы к вам...»~
@31325 = ~«Тогда я так и сделаю. Прощайте».~
@31326 = ~Я встретил леди Торнкомб, наставницу магов Чиновничьего района, в одном из множества сенсориумов Фестхолла. Она отказалась обучать меня... хотя я и не пойму, почему.~
@31327 = ~Она нервно улыбается. «Это неважно, уверяю вас».~
@31328 = ~«А вот я думаю что это вы. Вы — леди Торнкомб, наставница магов Городского Фестхолла».~
@31329 = ~«Лгунья из вас неважная, знаете ли».~
@31330 = ~«Можно узнать ваше имя?»~
@31331 = ~«И все же у меня есть несколько вопросов...»~
@31332 = ~«Тогда мне нужно идти. Прощайте».~
@31333 = ~«О... я, э... Адана?»~
@31334 = ~«Ну хватит всего этого. Думаю, мы *оба* знаем, кто вы, леди Торнкомб».~
@31335 = ~«На самом деле вы леди Торнкомб, наставница магов Городского Фестхолла. Я прав?»~
@31336 = ~«Лгунья из вас неважная, знаете ли».~
@31337 = ~Эта женщина все еще бесцельно бродит по сенсориуму, передвигаясь от камня к камню. При твоем приближении она окидывает тебя взглядом, но, по всей видимости, не узнает тебя.~
@31338 = ~«Вы случайно не леди Торнкомб?»~
@31339 = ~«У меня есть несколько вопросов...» ~
@31340 = ~«Не обращайте внимания. Прощайте».~
@31341 = ~Леди Торнкомб смотрит на тебя, прищурившись, будто пытаясь вспомнить, кто ты такой. Внезапно она многозначительно хмурится. «Это вы! Я надеялась, что вы больше не придете сюда, бесполезно пытаясь затащить меня в тренировочный зал... потому что я определенно туда не пойду».~
@31342 = ~«Мне просто интересно, знаете ли вы, как Салабеш рад вашему решению. Он претендует на место нового наставника магов».~
@31343 = ~«Вообще-то, у меня только несколько вопросов...»~
@31344 = ~«Нет. Прощайте».~
@31345 = ~«Салабеш?! Этот маленький пухлый простофиля... да со своим колдовством он не выберется даже из заплесневелого мешка! О каком это *решении* вы говорите?»~
@31346 = ~«Ну, о вашем решении остаться в сенсориумах и больше не обучать неопытных магов».~
@31347 = ~«Ни о каком; забудьте, что я говорил. Прощайте».~
@31348 = ~Океан-перед-бурей, череп чувствующей из коллекции Лотара, рассказал мне историю о Равель Заморочке и печально известном замысле этой ночной ведьмы.~
@31349 = ~Я рассказал леди Торнкомб о намерении Салабеша занять ее позицию наставника магов Городского Фестхолла... очевидно, они недолюбливают друг друга, и она быстро вернулась в тренировочный зал магов, чтобы разрушить его планы.~
@31350 = ~«Что?! Но... Я...»~
@31351 = ~«Да, леди Торнкомб?»~
@31352 = ~Она таращится на тебя. «Глупо. Весьма глупо. Если вы снова увидите Салабеша, передайте, чтобы он не беспокоился по этому поводу. Я немедленно возвращаюсь в тренировочный зал».~
@31353 = ~«Возможно, там и увидимся, леди Торнкомб. Прощайте».~
@31354 = ~Леди Торнкомб сердито смотрит на тебя. «У меня нет времени на разговоры... мы можем встретиться в тренировочном зале магов, если хотите. Прощайте».~
@31355 = ~Уйти.~
@31356 = ~Леди Торнкомб кивает тебе, но тебе неясно, узнала ли она тебя. Она разгладила свою одежду и волосы, и теперь у нее вид хоть и немолодой, но привлекательной аристократки... и все же она кажется отстраненной и слегка сметенной. «Здравствуйте... вы здесь, чтобы изучать магические искусства?»~
@31357 = ~«Да... каким заклинаниям вы можете меня научить?»~
@31358 = ~«Да».~
@31359 = ~«Нет, но у меня есть несколько вопросов...»~
@31360 = ~«Нет, не сейчас. Прощайте».~
@31361 = ~«Свое время и внимание я посвящаю своим ученикам, сэр. Предлагаю поговорить с одним из них... или, что было бы еще лучше, с кем-то менее занятым».~
@31362 = ~«Постойте. Меня не хочет обучать Ки-Саи... он говорит, что в бою заклинания эффективнее рукопашной схватки. Что вы об этом думаете?»~
@31363 = ~«Тогда прощайте».~
@31364 = ~«Свое время и внимание я посвящаю своим ученикам, сэр. Предлагаю поговорить с одним из них... или, что было бы еще лучше, с кем-то менее занятым».~
@31365 = ~Она качает головой. «Это не всегда так... маги физически немощны, наши заклинания — словно костыли, восполняющие нашу неполноценность. Когда магия потрачена, сама битва может еще продолжаться».~
@31366 = ~«Понимаю. Спасибо и прощайте».~
@31367 = ~Ты отвечаешь на последний из ее вопросов, и она удовлетворенно кивает. «Смею предположить, что вы — профессиональный маг, все верно?»~
@31368 = ~«Так и есть».~
@31369 = ~«Так и есть».~
@31370 = ~«Нет... это не так».~
@31371 = ~«Нет, пока нет... хотя я проходил обучение».~
@31372 = ~«Вообще-то, ничего особенного. Прощайте».~
@31373 = ~Она закрывает глаза и издает длинный низкий вздох. «Тогда чему же вы хотите у меня научиться? Больше не тратьте понапрасну время — мое и моих учеников! Прощайте».~
@31374 = ~«Постойте... а вы можете *сделать* из меня мага?»~
@31375 = ~«Постойте... я хочу снова встать на путь мага. Вы можете помочь мне?»~
@31376 = ~«До свиданья, леди Торнкомб».~
@31377 = ~«Хорошо. Ответьте на следующие вопросы...» Она начинает проверять твой интеллект и способность к рассуждению длинной чередой логических и словесных загадок...~
@31378 = ~Отвечать на ее вопросы как можно лучше.~
@31379 = ~Отвечать на ее вопросы как можно лучше.~
@31380 = ~«Извините, но вы попросту недостаточно умны, чтобы понять фундаментальные основы магии. Тем не менее, я желаю вам удачи в любом другом выбранном жизненном поприще. Прощайте».~
@31381 = ~«Э... Хорошо. Прощайте».~
@31382 = ~«Я определенно могла бы *попробовать*. Вы в самом деле хотите покинуть свою текущую специализацию?»~
@31383 = ~«Да, я хочу забросить меч ради магии и продолжить постижение Искусства».~
@31384 = ~«Да, я хочу оставить воровство и продолжить постижение Искусства».~
@31385 = ~«Да, я хочу забросить меч ради магии. Обучите меня пути Искусства».~
@31386 = ~«Да, я хочу оставить воровство и заняться изучением пути Искусства».~
@31387 = ~«Нет, думаю, не стоит. Прощайте».~
@31388 = ~«Хорошо. Вместе мы восстановим ваши познания Искусства... вскоре мы снова обратим вас на его путь».~
@31389 = ~Слушать и учиться.~
@31390 = ~«Я просто поражена! Если бы камни переживаний не раскрывали мне невозможное столько раз до этого, я бы не смогла поверить тому, как быстро вы вспомнили путь Искусства. Итак, вы готовы узнать, каким заклинаниям я могу вас обучить?»~
@31391 = ~«Да, пожалуйста, покажите мне».~
@31392 = ~«Не сейчас, но позже я вернусь. Прощайте».~
@31393 = ~«Итак, вы готовы узнать, каким заклинаниям я могу вас обучить?»~
@31394 = ~«Да, пожалуйста, покажите мне».~
@31395 = ~«Не сейчас, но позже я вернусь. Прощайте».~
@31396 = ~«Хорошо. Я научу вас тому, чему смогу, — на миг она останавливается, погрузившись в мысли. — Одного лишь таланта к Искусству недостаточно. Вам необходимы средства для его фокусировки — заклинания. Их чаще всего хранят в книге, хотя мне попадались маги, хранившие их в папирусных свитках, на каменных табличках... на расшитом шелке... на шкурах животных...» Ее глаза становятся стеклянными, и она начинает грызть ноготь на большом пальце.~
@31397 = ~«Леди Торнкомб? Вы что-то сказали?»~
@31398 = ~«М-м-м? Ах, простите... как я уже сказала, для Искусства нужна книга, или что-нибудь подобное, прежде чем вы начнете творить заклинания. Вы ведь умеете читать, не так ли?»~
@31399 = ~«Не знаю».~
@31400 = ~«Да».~
@31401 = ~«Тогда проверим еще раз, — она достает свиток из кожаной сумки, висящей у нее на боку. — Можете прочитать это мне?»~
@31402 = ~Осмотреть свиток.~
@31403 = ~Осмотреть свиток.~
@31404 = ~Надписи на свитке плывут у тебя перед глазами, каждый символ расплывается, как только ты пытаешься его прочесть. Почти инстинктивно ты расслабляешь глаза, позволив им охватить страницу целиком... и вдруг символы на ней сливаются: свиток перечисляет тайные знаки, магические компоненты и загадочные движения руками, используемые для контроля потока маны... похоже, это заклинание малого зачарования.~
@31405 = ~«Это ведь малое зачарование? Похоже на заклинание, делающее тебя более привлекательным для других, более обаятельным».~
@31406 = ~Надписи на свитке плывут у тебя перед глазами, каждый символ расплывается, как только ты пытаешься его прочесть.~
@31407 = ~Изучить символы, посмотреть, можешь ли ты расшифровать их.~
@31408 = ~«Я сдаюсь, леди Торнкомб... что означают эти надписи?»~
@31409 = ~Ты пристально рассматриваешь символы. И все же, как бы сильно ты не старался, надписи на свитке расплываются, изгибаются и скручиваются, как клубок змей. От одних лишь попыток уследить за их движениями твои глаза начинают болеть.~
@31410 = ~Продолжить изучать символы, пытаться разгадать их значение.~
@31411 = ~«Я сдаюсь, леди Торнкомб... что означают эти надписи?»~
@31412 = ~Ты продолжаешь изучать символы еще несколько минут, леди Торнкомб молча следит за тобой. В конце концов, она утрачивает интерес к этому занятию, и ее взгляд начинает блуждать по залу.~
@31413 = ~Продолжить изучать символы, пытаться разгадать их значение.~
@31414 = ~«Я сдаюсь, леди Торнкомб... что означают эти надписи?»~
@31415 = ~Ты уже готов сдаться и отвернуться, но тут ты расслабляешь глаза и охватываешь страницу целиком... неожиданно символы начинают сливаться. Свиток перечисляет тайные знаки, магические компоненты и загадочные движения руками, используемые для контроля потока маны... похоже, это малое заклятье.~
@31416 = ~«Это ведь малое зачарование? Похоже на заклинание, делающее тебя более привлекательным для других, более обаятельным».~
@31417 = ~Глаза леди Торнкомб расширяются. «Кто вы такой, чтобы обманывать меня?! — она выдергивает свиток из твоей руки. — Вы лгали мне? Вы все-таки маг? Или, может быть, нечистый дух? Отвечайте!»~
@31418 = ~«Что не так?»~
@31419 = ~«Нет, насколько я знаю. Что не так?»~
@31420 = ~Леди Торнкомб проверила меня... дала мне заклинание малого зачарования, написанное в свитке на языке Искусства. Мне удалось расшифровать его значение без обучения. Должно быть, когда-то в прошлом я изучал, как читать магию.~
@31421 = ~«Я не ожидала... хм-м... — она долго и пристально рассматривает тебя. — То, что вы прочитали, записано на языке *Искусства*. Не будь вы магом, для вас это был бы не более чем набор бессвязных символов, совершенно вам непонятных. И все же определенно ясно, как аморийское небо, что вы его поняли. Как?»~
@31422 = ~«Я действительно не знаю... Я просто *знал*, о чем тут говорится».~
@31423 = ~«Думаю, когда-то я помнил, но забыл... увидев символы, я просто дал встряску своей памяти».~
@31424 = ~«Или, возможно, это дар от природы... впрочем, неважно, — она улыбается тебе. — Вы сэкономили многие месяцы, а то и *годы* учебы. Итак... вы вполне можете читать заклинания, но есть ли у вас книга для них?»~
@31425 = ~«Книга заклинаний? Нет...»~
@31426 = ~«Тогда что это?» — она указывает на твой дневник.~
@31427 = ~«Это мой дневник. Я записываю туда заметки... о встреченных людях и тому подобном...»~
@31428 = ~«В таком случае, вы также можешь записывать туда и заклинания, — она неодобрительно смотрит на дневник. — Изорванная штука... но и он сойдет». Некоторое время она молча стоит и изучает твой дневник. Похоже, она углубилась в свои мысли и начала кусать ноготь на большом пальце.~
@31429 = ~Контраст~
@31430 = ~«Леди Торнкомб?..»~
@31431 = ~Управление яркостью в игре.~
@31432 = ~Она вновь сосредотачивается на тебе: «М-м? Ах... да. Итак, пока ваши заклинания в этой книге, в них нет силы — это просто слова. Искусство требует, чтобы вы заучивали заклинания — *запоминали* их, — перед тем как высвободить их силу. Это требует ясности ума, так что рекомендуется, чтобы вы прежде хорошо отдохнули. Все понятно?»~
@31433 = ~«Да, продолжайте».~
@31434 = ~«Думаю, основы я понял, леди Торнкомб».~
@31435 = ~«Превосходно. Запоминаемые заклинания следует выбирать *перед* сном, это крайне важно. Когда вы проснетесь, они освежатся в памяти, обогащенные маной и готовые для использования».~
@31436 = ~«Сколько заклинаний я могу сотворить?»~
@31437 = ~«Думаю, основы я понял, леди Торнкомб».~
@31438 = ~«Только одно, может, два заклинания, а потом вам снова понадобится отдых... у начинающего мага не найдется места в голове для большего количества. Пользуйтесь заклинаниями мудро, пока не станете более умелым в Искусстве... однако я бы посоветовала использовать их мудро даже тогда. С ростом опыта вы обнаружите, что способность запоминания заклинаний также возрастет».~
@31439 = ~«Хорошо... продолжайте...»~
@31440 = ~«Думаю, основы я понял, леди Торнкомб».~
@31441 = ~«Вы можете создавать лишь те заклинания, которые запомнили. Итак, если бы вы захотели воспользоваться Искусством для распознания, скажем, двух разных заколдованных предметов, вы должны запомнить заклинание Опознания... сколько раз?»~
@31442 = ~«Один раз».~
@31443 = ~«Два раза».~
@31444 = ~«Э...»~
@31445 = ~«Думаю, основы я понял, леди Торнкомб».~
@31446 = ~«Два раза! Чтобы создать заклинание *два раза*, нужно запомнить заклинание *дважды*».~
@31447 = ~«Понятно. Как мне достать еще заклинаний?»~
@31448 = ~«Думаю, основы я понял, леди Торнкомб».~
@31449 = ~Леди Торнкомб обучила меня азам Искусства. Она сказала, что перед отдыхом мне нужно подобрать заклинания, которые я хочу запомнить, открыв книгу заклинаний и выбрав их. Если мне нужно создать заклинание несколько раз, я должен запомнить заклинание несколько раз. Когда бы я не отдыхал, я просыпаюсь на следующее утро с готовыми к использованию заклинаниями в памяти. Она сказала, что каждый день я смогу творить лишь небольшое количество заклинаний, пока не стану более умелым в их использовании. Я также могу поискать в городе других учителей, которые могут обучить меня заклинаниям.~
@31450 = ~Леди Торнкомб кивает, улыбаясь: «Да, два раза, правильно».~
@31451 = ~«Как мне достать еще заклинаний?»~
@31452 = ~«Думаю, основы я понял, леди Торнкомб».~
@31453 = ~«Всегда ищите возможность научиться большему — даже обычные люди могут обучить некоторым простым чарам. Также существуют рецепты, книги, и даже еще более странные предметы с написанными на них заклинаниями. Если найдете что-нибудь подобное, просто изучите его внимательно и скопируйте заклинание в свою книгу, если хотите».~
@31454 = ~«Понятно».~
@31455 = ~«Думаю, основы я понял, леди Торнкомб».~
@31456 = ~«Возьмите эти свитки... простая магия, чтобы подогреть ваш интерес к Искусству, — она лукаво улыбается. — Возвращайтесь, когда станете опытнее... вы больше не можете обучаться здесь бесплатно, однако я могу продать вам более могущественные заклинания, когда вы сможете использовать их».~
@31457 = ~«Спасибо, леди Торнкомб. Прощайте».~
@31458 = ~«Тогда я вернусь позже. Прощайте».~
@31459 = ~Управление контрастом в игре.~
@31460 = ~Фоновые звуки~
@31461 = ~Эта книга огромна... должно быть, в ней содержатся тысячи имен.~
@31462 = ~Don't bother translating~
@31463 = ~Красивое серебряное зеркало.~
@31464 = ~Похоже, эти врата запечатаны. На них нет ни замка, ни чего-либо, что может их открыть.~
@31465 = ~Human Male Townie Damage 1~ [CON_05]
@31466 = ~Звуковые эффекты~
@31467 = ~Голос~
@31468 = ~Музыка~
@31469 = ~Ролики~
@31470 = ~Параметры автопаузы~
@31471 = ~Гаэриен~
@31472 = ~Сибил~
@31473 = ~Художница-тифлинг~
@31474 = ~Тиресиас~
@31475 = ~Анамоли~
@31476 = ~Стражник Погребенной деревни~
@31477 = ~Бариавр~
@31478 = ~Параметры обратной связи~
@31479 = ~Сложность~
@31480 = ~Прокрутка клавиатурой~
@31481 = ~Задержка подсказок~
@31482 = ~Прокрутка мышью~
@31483 = ~Вставьте диск Planescape: Torment номер~
@31484 = ~«Встань-ка подальше от меня, Морт».~ [ANA575F]
@31485 = ~«С тебя не убудет, если скажешь мне пару слов, бесовка».~ [MRT478]
@31486 = ~Это файл-пустышка для текста взаимодействий, связанных с Дакконом.~
@31487 = ~«Морт, мне просто интересно... что случилось с твоим телом?»~ [FFG326]
@31488 = ~«Я должен снова спросить: встречались ли мы прежде, Безымянный?»~ [VHA256A]
@31489 = ~Это файл-пустышка для текста взаимодействий, связанных с Игнусом.~
@31490 = ~«Внимание: Морт. Знаешь ли ты, что у меня шесть сторон?»~ [NOR311]
@31491 = ~«This is a test floater. Don't bother translating».~
@31492 = ~«Слишком много звенелок в карманах?»~
@31493 = ~Несколько осколков черного кристалла — или льда — кружат в ледяном потоке ветра, который исходит из богато украшенного основания. Каждый осколок кажется острым как бритва; было бы рискованно касаться или хватать их. Табличка на основании гласит «Темные птицы Окантуса».~
@31494 = ~Оставить осколки в покое.~
@31495 = ~Прикоснуться к одному из осколков.~
@31496 = ~Схватить один из осколков.~
@31497 = ~Словить один из осколков Кружкой ледяного эля.~
@31498 = ~Когда ты пытаешься прикоснуться к одному из кружащих осколков, твой палец попадает в ледяной поток ветра, идущий из основания. Он моментально покрывается коркой оцепеняющего льда, от чего ты сразу же одергиваешь его.~
@31499 = ~Оставить осколки в покое.~
@31500 = ~Вернуть палец назад и прикоснуться к одному из осколков.~
@31501 = ~Вернуть палец назад и прикоснуться к одному из осколков.~
@31502 = ~Схватить один из осколков.~
@31503 = ~Словить один из осколков Кружкой ледяного эля.~
@31504 = ~Ты суешь указательный палец в холодный поток ветра. Хотя ты этого еще не осознаешь, твой палец отмерзает. Когда один из черных осколков попадает в него, кончик пальца раскалывается с резким *хрум* и разлетается по полу галереи. Обычно такое ранение незначительно, но в твоем потрепанном состоянии оно приводит к твоей смерти.~
@31505 = ~Пасть во тьму...~
@31506 = ~Ты суешь указательный палец в холодный леденящий поток ветра. Незаметно для тебя, твой палец отмерзает. Когда один из черных осколков попадает в него, кончик пальца раскалывается с резким *хрум* и разлетается по полу галереи. Ледяные Темные птицы продолжают кружиться по своим орбитам, пока ты ждешь, как твой палец снова отрастет.~
@31507 = ~Словить один из осколков Кружкой ледяного эля.~
@31508 = ~Уйти в надежде на то, что никто ничего не заметил.~
@31509 = ~Когда ты пытаешься схватить один из кружащих осколков, твои пальцы попадают в ледяной поток ветра, идущий из основания. Они моментально покрываются коркой оцепеняющего льда, от чего ты сразу же одергиваешь руку.~
@31510 = ~Оставить осколки в покое.~
@31511 = ~Просто прикоснуться к одному из осколков.~
@31512 = ~Вернуть руку назад и схватить один из осколков.~
@31513 = ~Вернуть руку назад и схватить один из осколков.~
@31514 = ~Словить один из осколков Кружкой ледяного эля.~
@31515 = ~Ты суешь руку в холодный поток ветра. Когда ты хватаешь одну из Темных птиц, незаметно для тебя твоя рука полностью отмерзает. Когда другой черный осколок попадает в твой кулак, твоя рука с резким *хрум* откалывается по запястье и с грохотом падает на пол галереи. Уже порядком потрепанный и избитый, ты падаешь замертво.~
@31516 = ~Пасть во тьму...~
@31517 = ~Ты суешь руку в холодный поток ветра. Когда ты хватаешь одну из Темных птиц, незаметно для тебя твоя рука полностью отмерзает. Когда другой черный осколок попадает в твой кулак, твоя рука с резким *хрум* откалывается по запястье и с грохотом падает на пол галереи.~
@31518 = ~Быстро подобрать руку и воткнуть ее обратно!~
@31519 = ~Ты поднимаешь обледеневший кулак и суешь его в кровоточащий обрубок, замечая, что схваченная тобой Темная птица, бритвенно-острый осколок черного льда, уже полностью растаяла. Похоже, тебе следует поймать ее чем-то, что могло бы сохранять ее в холоде. В конце концов, когда твои ткани растают и восстанавливаются, к твоей руке возвращается тепло и чувствительность.~
@31520 = ~Словить один из осколков Кружкой ледяного эля.~
@31521 = ~Уйти в надежде на то, что никто ничего не заметил.~
@31522 = ~Ты «окунаешь» кружку в ледяной поток ветра, идущий из основания, зачерпнув маленький осколок с легким *дзынь*. Заглянув в кружку, ты видишь, что Темная птица — это бритвенно-острый кусок черного льда. Только волшебные свойства кружки не дают осколку растаять.~
@31523 = ~Уйти.~
@31524 = ~Статуя выглядит так, будто собирается сделать какое-то гневное заявление. Скульптор великолепно передал сущность ярости: должно быть, потребовались многие месяцы, чтобы правильно высечь одни только морщины напряжения на шее и лбу. Изваяние покрыто мелкими трещинами, а к пьедесталу прикреплена табличка.~
@31525 = ~Нижние планы рассеивают зло по всему мирозданию, заражая все, чего они касаются. Иногда они поглощают людей. Вернувшись, те носят отпечаток Нижних планов на своих лицах и душах, а иногда приносят детей. Детей, которых коснулись Нижние планы, называют тифлингами. Они рождаются с израненной душой, вне всякого сомнения, запятнанной злом. То, как другие реагируют на тифлингов, пока те взрослеют, ранит их еще больше. Тифлинги склонны к одиночеству, недоверчивы и недружелюбны, живут сами по себе. Если они и проявляют доверие, то делают это неохотно и лишь спустя длительное время; показывать доверие для них — большая редкость. ~
@31526 = ~Члены этой фракции, которую еще называют Революционной Лигой, стремятся поставить фракции Сигила на колени. Они противостоят диктатуре порядка любых видов и делают согласованные попытки свергнуть любое искусственное образование закона, встреченное ими. Они состоят из людей разных починов, но их объединяет ненависть к ловушкам организованного порядка всех видов. Поскольку все фракции Сигила презирают их, они имеют склонность собираться в небольшие ячейки, часто мешающие друг другу.~
@31527 = ~Сложно обоснованно называть хаоситеков фракцией, поскольку у фракции должна быть организация и порядок. Хаоситекты против всего этого. Они считают, что единственным ответом является хаос, что ничто ничего не значит, и что синие рыбки гармонизируют с деревьями. Они стремятся самовыражаться спонтанно и как можно более индивидуально, что, по иронии судьбы, нередко приводит к удивительно похожим проявлениям.~
@31528 = ~Одна из многочисленных фракций Сигила, чувствующие (или Общество Восприятия), верят, что единственный способ раскрыть истину мультивселенной — это испытать как можно больше всего с помощью собственных чувств. Они считают, что других путей познания действительности не существует. Их штаб-квартира располагается в Городском Фестхолле в Чиновничьем районе. Они предлагают любопытствующим широкий выбор впечатлений.~
@31529 = ~В любом обществе найдутся люди, которые не могут жить по законам, установленным этим обществом. Может, они чувствуют себя подавленно и угнетенно. Может, они попали на улицу, не имея других вариантов. Может, они просто обижены. Какой бы ни была причина, довольно многие из них скатываются до преступной жизни, зарабатывая на жизнь за счет других. С тобой тоже такое случалось. Но это не значит, что ты станешь оправдывать их, если они попытаются нажиться на *тебе*. ~
@31530 = ~Намазать статую мазью Горгоны.~
@31531 = ~Прочитать табличку.~
@31532 = ~Осмотреть трещины.~
@31533 = ~Оставить статую в покое.~
@31534 = ~Табличка гласит: «Считается, что эта статуя — конечная судьба этерсерийского чародея Гангройгидона. Атакованный враждебным конклавом чародеев, находясь в пике ужасного безумия, он был лишен свободы заклинанием, которое обратило его плоть в камень. Говорят, будто Гангройгидон застыл с последним страшным проклятием на губах, столь ужасным, что ему *никогда* не следовало слетать с уст живого человека».~
@31535 = ~Намазать статую мазью Горгоны.~
@31536 = ~Осмотреть статую.~
@31537 = ~Оставить статую в покое.~
@31538 = ~Ты тщательно изучаешь трещины, идущие по поверхности статуи, словно сеть тонких черных сосудов. В одном месте, на внутренней стороне руки, есть участок, где кусок камня уже готов отвалиться.~
@31539 = ~Отломить кусок.~
@31540 = ~Отломить кусок.~
@31541 = ~Прочитать табличку.~
@31542 = ~Оставить статую в покое.~
@31543 = ~Ты крепко хватаешь место на предплечье, где образовалась трещина, и бьешь по нему своим кузнечным молотом. Слышится звук удара металла о камень, и от статуи отпадает обломок размером с кинжал.~
@31544 = ~«Есть...»~
@31545 = ~Когда обломок отпадает, ты чувствуешь, как по тыльной стороне твоей руки начинает течь вода... взяв обломок руки, ты видишь, как глаза статуи наполняются слезами. Ты быстро — и бесшумно — возвращаешь обломок на место и отворачиваешься от плачущего изваяния.~
@31546 = ~Намазать статую мазью Горгоны.~
@31547 = ~Осмотреть статую.~
@31548 = ~Прочитать табличку.~
@31549 = ~Оставить статую в покое.~
@31550 = ~Ты крепко хватаешь место на предплечье, где образовалась трещина, и резко дергаешь — но безуспешно. Чтобы отколоть камень, тебе нужен молоток небольшого размера: из-за ограниченного пространства между рукой и телом статуи большой молот (например, боевой) не подойдет.~
@31551 = ~Намазать статую мазью Горгоны.~
@31552 = ~Осмотреть статую.~
@31553 = ~Общество Восприятия~
@31554 = ~Бариавр~
@31555 = ~Горожанин из низшего сословия~
@31556 = ~Прочитать табличку.~
@31557 = ~Оставить статую в покое.~
@31558 = ~Ты обмазываешь изваяние зловонной мазью. Вокруг него появляется странное мерцание, и ты наблюдаешь, как статуя делает вдох, и глаза Гангройгидона наполняются пылающим мстительным безумством. ~
@31559 = ~«Приветствую...»~
@31560 = ~Прикрыть уши.~
@31561 = ~Бежать как сумасшедший.~
@31562 = ~Прежде чем ты успеваешь что-нибудь предпринять, с губ чародея срывается пламенный поток слов. При этом ты чувствуешь мучительное ощущение, будто тебя окатывает стремительной волной чудовищной жары, которая покрывает твою кожу как ожог. Тебя ослепляет: твои глаза, вылетев из орбит, лопаются, как разбитые яйца... ты слышишь, как кто-то кричит, и вдруг осознаешь, что это ты...~
@31563 = ~Подождать, пока этот кошмар закончится.~
@31564 = ~Пасть во тьму, став жертвой страшного проклятья Гангройгидона.~
@31565 = ~Последнее, что ты слышишь, даже сквозь собственный крик, — это ликующий возглас Морта...~
@31566 = ~«Клянусь шипастыми сиськами Леди, вот это...»

Внезапно все стихает. Остатки твоих чувств меркнут и покидают тебя.
~ [MRT387]
@31567 = ~Пасть во тьму, став жертвой страшного проклятья Гангройгидона.~
@31568 = ~Вставьте диск Planescape: Torment DVD~
@31569 = ~в устройство~
@31570 = ~Неверный диск в устройстве~
@31571 = ~В устройстве нет диска~
@31572 = ~Planescape: Torment~
@31573 = ~Planescape: Torment не может быть запущен в текущей глубине цветности. Рабочий стол должен быть в глубине цветности 16, 24 либо 32 бит.~
@31574 = ~Planescape: Torment не может установить эксклюзивный режим полного экрана DirectDraw.~
@31575 = ~Ты действительно хочешь выйти из Planescape: Torment?~
@31576 = ~На жестком диске недостаточно места для сохранения игры.~
@31577 = ~На жестком диске недостаточно свободного места для сохранения игры. Продолжить?~
@31578 = ~В устройстве нет диска. Вставьте Диск 1 в устройство.~
@31579 = ~Череп вяло вздыхает и произносит знойным голосом: «Зачем тревожишь мой покой? Столько всего случилось в последнее время, и хоть я рада переживаниям, должна признаться, что жажду чувства покоя».~
@31580 = ~Левая серьга~
@31581 = ~«Расскажи мне о себе».~
@31582 = ~«Что ты здесь делаешь?»~
@31583 = ~«Что ты можешь рассказать о Лотаре?»~
@31584 = ~«Как насчет всех этих черепов на полке?»~
@31585 = ~«Тогда можешь отдыхать дальше. Прощай».~
@31586 = ~«Я... была... Океаном-перед-бурей, чувствующей. Увы, теперь я всего лишь украшение».~
@31587 = ~«Чувствующей? Что это?»~
@31588 = ~«Тяжело тебе, наверно... здесь немного переживаний, да?»~
@31589 = ~«Что ты можешь рассказать о Лотаре?»~
@31590 = ~«Что ты здесь делаешь?»~
@31591 = ~«Что ты знаешь о других черепах?»~
@31592 = ~«Что ты можешь сказать обо всех этих черепах на полке?»~
@31593 = ~«Ясно. Предоставлю тебя этому занятию. Прощай».~
@31594 = ~«Ну, я лежу на полке, собираю пыль, пока кому-нибудь из крысиных слуг Лотара не приходит в голову протереть меня. Отвечаю на вопросы Лотара и... в этом, собственно, и весь смысл моего ничтожного существования».~
@31595 = ~«Нет, я имел в виду, 'как ты сюда попала'?»~
@31596 = ~«Нет, я имел в виду, 'как ты сюда попала'?»~
@31597 = ~«Какие-такие вопросы?»~
@31598 = ~«Расскажи мне о себе».~
@31599 = ~«Что ты можешь рассказать о Лотаре?»~
@31600 = ~«Как насчет всех этих черепов на полке?»~
@31601 = ~«Что ты можешь сказать обо всех этих черепах на полке?»~
@31602 = ~«Тогда не буду тебя беспокоить. Прощай».~
@31603 = ~«Ничего из того, что он сам не захочет тебе рассказать. Поскольку я подозреваю, что другие черепа могут донести на меня, если я скажу чего лишнего, я просто промолчу. И пока ты не спросил, да, я настолько боюсь его».~
@31604 = ~«Что он может тебе сделать?»~
@31605 = ~«Расскажи мне о себе».~
@31606 = ~«Что ты здесь делаешь?»~
@31607 = ~«Как насчет всех этих черепов на полке?»~
@31608 = ~«Что ты можешь сказать обо всех этих черепах на полке?»~
@31609 = ~«Тогда можешь отдыхать дальше. Прощай».~
@31610 = ~«О, они не более чем развлечение от скуки. Тут есть крысооборотень Гоатскомб, анархист Гримскальп, старый маг и наемный убийца Штерн. Не знаю, чем он там занимался, но по своей сути он злой».~
@31611 = ~«Прагматик? Значит, из-за этого удар в спину кажется тебе решением всех проблем?»~
@31612 = ~Океан-перед-бурей переключается на тебя. «Вот видишь? Злой по своей сути».~
@31613 = ~«Расскажи мне о себе».~
@31614 = ~«Что ты здесь делаешь?»~
@31615 = ~«Что ты можешь рассказать о Лотаре?»~
@31616 = ~«Да, я понимаю. Прощай».~
@31617 = ~«Чувствующий — это член Общества Восприятия, одной из фракций Сигила, расположившейся в Городском Фестхолле в Чиновничьем районе. Она утверждает, что вселенную можно понять и управлять ею только с помощью чувств, и поэтому мы должны собрать как можно больше разных переживаний. Мне кажется, что я уже достигла предела в сидении на пыльной полке: у меня низкий порог скуки».~
@31618 = ~«Могу я что-нибудь для тебя сделать?»~
@31619 = ~«Что ты здесь делаешь?»~
@31620 = ~«Что ты можешь рассказать о Лотаре?»~
@31621 = ~«Как насчет всех этих черепов на полке?»~
@31622 = ~«Что ты можешь сказать обо всех этих черепах на полке?»~
@31623 = ~«Жаль это слышать. Прощай».~
@31624 = ~«Нет, но спасибо, что спросил. Однажды я столкнула себя с полки и разбилась. Следующее, что помню — это что я снова на полке, и нас всех поприклеивали. Когда Лотар от меня устанет, он от меня избавится».~
@31625 = ~«Что ты здесь делаешь?»~
@31626 = ~«Что ты можешь рассказать о Лотаре?»~
@31627 = ~«Как насчет всех этих черепов на полке?»~
@31628 = ~«Что ты можешь сказать обо всех этих черепах на полке?»~
@31629 = ~«Тогда удачи. Прощай».~
@31630 = ~Череп смотрит на тебя. «Точно. А тут еще ты трешься, — он делает более длинную паузу. — Уходи».~
@31631 = ~«Ладно тебе, я просто пошутил...»~
@31632 = ~«Ладно. Прощай».~
@31633 = ~«Это долгая история, и я не собираюсь ничего тебе рассказывать до тех пор, пока ты не выполнишь задание Лотара».~
@31634 = ~«Что он может тебе сделать?»~
@31635 = ~«Можешь мне рассказать».~
@31636 = ~«Тогда расскажи мне о себе».~
@31637 = ~«Что ты можешь рассказать о Лотаре?»~
@31638 = ~«Ну ладно. Что ты можешь рассказать обо всех этих черепах на полке?»~
@31639 = ~«Ну ладно. Что ты можешь рассказать обо всех этих черепах на полке?»~
@31640 = ~«Тогда не буду тебя беспокоить. Прощай».~
@31641 = ~«Это долгая история, связанная с Равель Заморочкой, ночной ведьмой. Хочешь услышать ее полностью?»~
@31642 = ~«Да».~
@31643 = ~«Не очень».~
@31644 = ~Если бы череп мог, он бы пожал плечами. «Ничего, кроме того, что я тебе уже рассказала».~
@31645 = ~«Тогда расскажи мне о себе».~
@31646 = ~«Что ты можешь рассказать о Лотаре?»~
@31647 = ~«Отлично. Прощай».~
@31648 = ~Дух-страж~
@31649 = ~Череп смотрит на тебя, и у тебя складывается впечатление, что он дрожит. «Даже без нервных окончаний можно испытать немало боли. Не всякая боль физическая, и не все эмоции рождаются в голове. К ним относятся ощущения, которые я бы не пожелала пережить заново, — она умолкает. — На этом разговор окончен. Прощай».~
@31650 = ~«Ответь еще на пару вопросов...»~
@31651 = ~Безымянный~
@31652 = ~Мелкий головорез~
@31653 = ~Крупный головорез~
@31654 = ~Горожанка из высшего сословия~
@31655 = ~Горожанин из высшего сословия~
@31656 = ~Торговец~
@31657 = ~Стражник~
@31658 = ~Некромант~
@31659 = ~Дух-страж~
@31660 = ~«Прощай».~
@31661 = ~«О, про разные вещи... переживания, которые я испытывала, политику чувствующих — к несчастью, эти знания уже устарели! Впечатления о людях, бывающих здесь, и еще много чего. Вопросы разные, и это я ценю больше, чем ты себе представляешь. Если тебе больше нечего у меня спросить, тогда, полагаю, я вернусь к покою. Прощай».~
@31662 = ~«Нет, погоди, еще пара вопросов...»~
@31663 = ~«Прощай».~
@31664 = ~Череп смотрит на тебя без выражения и молчит.~
@31665 = ~«Ну и ладно. Прощай».~
@31666 = ~«Тогда я вернусь к покою. Прощай».~
@31667 = ~«Нет, погоди, ответь еще на несколько вопросов...»~
@31668 = ~«Прощай».~
@31669 = ~«Не будет от тебя покоя...»~
@31670 = ~«Расскажи мне о себе».~
@31671 = ~«Что ты здесь делаешь?»~
@31672 = ~«Что ты можешь рассказать о Лотаре?»~
@31673 = ~«Как насчет всех этих черепов на полке?»~
@31674 = ~«Что ты можешь сказать обо всех этих черепах на полке?»~
@31675 = ~«Думаю, это можно устроить. Прощай».~
@31676 = ~«Хорошо. Я работала в Городском Фестхолле, штаб-квартире чувствующих, в сенсориумах. Равель Заморочка, будь проклята ее черная душа, приходила туда за ответами на попадавшиеся ей загадки. Она была мастером по части разгадывания загадок, которые ставили в тупик наши лучшие умы, а ее заставляли лишь ненадолго задуматься. И тут она столкнулась с трудностями, которые требовали ответов извне. Я слышала, будто она пришла, чтобы раскрыть тайны самого Сигила».~
@31677 = ~«Продолжай».~
@31678 = ~«Мне это уже надоело. Прощай».~
@31679 = ~«Она была ужасно уродлива, и не беспокоилась о том, чтобы скрыть свою внешность — я слышала, что она так и делает, вернее, ДЕЛАЛА время от времени. И эта дьявольская внешность отпугивала многих потенциальных членов фракции. Тем не менее, мне нужно было спросить у нее, что она задумала, и может ли она научить меня тому, что знает» .~
@31680 = ~«Звучит так, будто это оказалось ошибкой».~
@31681 = ~«Думаю, я получил представление. Прощай».~
@31682 = ~«Так оно и оказалось. Поскольку она жила загадками и обменивалась ими, она предложила мне сделку. Если она ответит на мой вопрос, я должна буду согласиться ответить на один из ее вопросов. Если я ошибусь, моя жизнь перейдет в ее руки. Я согласилась. Она рассказала мне, что собирается раскрыть загадку Клетки, чтобы открыть ее для всех желающих: сил, нечисти, небожителей, модронов и слаади, не говоря уж о внутрипланарных существах. Самым важным для нее было то, что все должны узнать, что загадку, столько времени ставящую всех в тупик, распутала Равель».~
@31683 = ~«Что произошло дальше?»~
@31684 = ~«Понятно. Прощай».~
@31685 = ~«Она задала свой вопрос. Я не смогла на него ответить, хотя она и уверяла меня, что ответ так же очевиден, как и нос на ее лице. Когда на следующее утро мои товарищи-чувствующие зашли в сенсориум, они застали меня кричащей. Я умоляла убить себя, и они выполнили мою просьбу. Никому и в голову ни пришло, что я наслаждалась своим новым переживанием: настолько ужасным оно было. И... вот я здесь. Теперь мне нужно отдохнуть».~
@31686 = ~«Что это был за вопрос?»~
@31687 = ~«Ответишь еще на парочку вопросов?»~
@31688 = ~«Хорошо. Спасибо за рассказ. Прощай».~
@31689 = ~«Он был таким: что может изменить сущность человека? Я хорошо обдумала его и ответила: любовь. Она сказала, что люди слишком себялюбивы, чтобы их могла изменить такая простая вещь, как любовь. И она... она... Мне нужно отдохнуть».

В глубине твоего разума всплывает образ крючконосой старухи с черной, как смоль, кожей, задающая тебе похожий вопрос... но ты не в силах вспомнить, что ты ответил.~
@31690 = ~«Ответишь еще на парочку вопросов?»~
@31691 = ~«Сочувствую. Прощай».~
@31692 = ~«Злой? Еще чего! Я всего лишь прагматик».~
@31693 = ~«А разве это не отличное решение? Оно всегда срабатывало. И, как я выяснил, яд и магия справляются с этой задачей в одинаковой степени хорошо».~
@31694 = ~Этот череп обращается к тебе низким голосом в шутливой манере: «Ты пришел познать истину? У меня ее полным-полно».~
@31695 = ~«Расскажи мне о себе».~
@31696 = ~«Как ты попал сюда?»~
@31697 = ~«Что ты можешь сказать о Лотаре?»~
@31698 = ~«Что ты можешь рассказать о других черепах?»~
@31699 = ~«Забудь. Извини, что занял твое время. Прощай».~
@31700 = ~«Пришел за чем-то большим, чем наставление на праведный путь, а? Ты по адресу!»~
@31701 = ~«Расскажи мне о себе».~
@31702 = ~«Как ты попал сюда?»~
@31703 = ~«Что ты можешь сказать о Лотаре?»~
@31704 = ~«Что ты можешь рассказать о других черепах?»~
@31705 = ~«Забудь. Извини, что занял твое время. Прощай».~
@31706 = ~«О себе? Я Штерн, один из величайших деятелей в сфере обеспечения личного покоя путем кардинального перераспределения враждебных действий».~
@31707 = ~«Забавно, что ты об этом спрашиваешь. Однажды мне дали черную книгу, чтобы я постиг ее тайны. Я раскрыл ее могущество ужасной ценой (которую я с радостью заплатил бы снова!) и стал намного сильнее. Вот только я не учел, что книга предаст меня сопливой крыске, которая одолела меня полчищем грызунов и заживо обглодала мне кости. Книга прошла через руки нескольких последователей, каждого из которых она предавала, пока она не оказалась в руках крысочеловека Мантуока. Если найдешь эту книгу, прими предлагаемое ею могущество и избавься от нее, пока с тобой не случилось то же самое».~
@31708 = ~«Я буду начеку. Расскажи мне о себе».~
@31709 = ~«Спасибо. Что ты можешь рассказать мне о Лотаре?»~
@31710 = ~«Хорошо... что ты можешь рассказать о других черепах?»~
@31711 = ~«Ужасная история. Прощай».~
@31712 = ~Штерн, череп наемного убийцы из коллекции Лотара, рассказал мне о книге, которую носит крысооборотень Мантуок. Он предупредил, что я должен опасаться могущества, предлагаемого книгой.~
@31713 = ~«Что я могу рассказать о Лотаре? Ничего я не скажу. Даже это жалкое существование лучше, чем то, что он обещает со мной сделать, если я разболтаю его тайны».~
@31714 = ~«Можешь мне рассказать...»~
@31715 = ~«Ну, ладно. Расскажи мне о себе».~
@31716 = ~«Ладно. Тогда как ты здесь оказался?»~
@31717 = ~«Так что же ты можешь рассказать мне о других черепах?»~
@31718 = ~«Тогда забудь. Прощай».~
@31719 = ~«Об этих черепах я не могу рассказать ничего хорошего. Они мне душу не изливают; на самом деле, мы практически не разговаривали между собой до тех пор, пока не пришел ты. Возможно, — произносит он насмешливым тоном, — в самом твоем присутствии есть нечто особенное».~
@31720 = ~«Возможно. Расскажи мне о себе».~
@31721 = ~«Несомненно. Как ты сюда попал?»~
@31722 = ~«Точно. Достаточно будет рассказать мне о Лотаре».~
@31723 = ~«Совершенно верно, но уже скоро я лишу тебя своего общества. Прощай».~
@31724 = ~«Если тебе будет угодно так это называть, Гримскальп, — Штерн переключается на тебя. — Я был лучшим среди многих — так говорили».~
@31725 = ~«Тогда как тебя сюда занесло?»~
@31726 = ~«Что с тобой случилось?»~
@31727 = ~У тебя создается отчетливое впечатление, что череп Штерна насмехается над тобой. «Ради твоего расположения? Да ну. Ты не сможешь мне предложить ничего, что убедило бы меня предать Лотара. Сгинь!»~
@31728 = ~«Тогда просто ответь еще на пару вопросов...»~
@31729 = ~«Тогда прощай».~
@31730 = ~«Не буду». Череп замыкается в себе. Ты чувствуешь, как сила его личности исчезает.~
@31731 = ~«Тогда ладно».~
@31732 = ~Изо рта этого черепа доносится шипение: «Ты имеешь в виду, что ты — волшебник, убийца и отравитель».~
@31733 = ~Голос этого черепа низок и скрипуч, словно скрежет камня по металлу. «Мне... мне кажется, что я уже видел тебя, незнакомец».~
@31734 = ~«Где ты меня видел?»~
@31735 = ~Некоторые ребята просто напросто крупные от рождения. Кое-кто из них пользуется своими ненормальными физическими данными, чтобы запугивать других, и они идут по жизни, терроризируя тех, кто поменьше. Они имеют склонность пользоваться не мозгами, и грубой силой, и что печально, слишком часто это сходит им с рук.~
@31736 = ~Тот, кто знает, как правильно использовать власть и богатство, создает себе привилегии, собственные законы. При правильном использовании он может приумножать богатство и власть бесконечное число раз, не давая подняться менее удачливым, а иногда и делая из них жертв.

В Сигиле это значит, что ты обязательно столкнешься с высокомерным племенем людей, которые обычно ограничиваются только тем, что «правильно» и «прилично». Эта женщина — хороший тому пример.~
@31737 = ~Тот, кто знает, как правильно использовать власть и богатство, создает себе привилегии, собственные законы. При правильном использовании он может приумножать богатство и власть бесконечное число раз, не давая подняться менее удачливым, а иногда и делая из них жертв.

В Сигиле это значит, что ты обязательно столкнешься с высокомерным племенем людей, которые обычно ограничиваются только тем, что «правильно» и «прилично». Этот мужчина — хороший тому пример.~
@31738 = ~У тебя нет имени. Ты очнулся без памяти на плите в Морге в Сигиле, покрытый шрамами и татуировками. Кто сделал это с тобой, и почему? Ты не знаешь... пока. Но рано или поздно ты это выяснишь.~
@31739 = ~Самые жалкие из всех несчастных сигильцев, они пали так низко, как только можно. Для большинства из них смерть была бы утешением. Они делают все, что необходимо для выживания, неважно, насколько низкой может быть эта жизнь.~
@31740 = ~Самые жалкие из всех несчастных сигильцев, они пали так низко, как только можно. Для большинства из них смерть была бы утешением. Они делают все, что необходимо для выживания, неважно, насколько низкой может быть эта жизнь.~
@31741 = ~В Сигиле повитухи исполняют множество ролей. Они служат хранилищами знаний, будь то деторождение или травы от лихорадки. Кое-кто из них знает даже больше, скрывая магические знания под личиной старушечьей мудрости. Все они приносят пользу.~
@31742 = ~Полулюди-полукозлы, повадки соответствующие. Бариавры — драчливые воины из расы кочевников, прямолинейный народ с жаждой жизни. Судя по тому, что ты видел, они избегают общения.~
@31743 = ~«Вполне возможно, но у меня на это нет времени».~
@31744 = ~«А, снова ты? Что на этот раз тебе от меня нужно?»~
@31745 = ~«Ты сказал, что ты меня уже видел. Где?»~
@31746 = ~«Расскажи мне о себе».~
@31747 = ~«Как ты сюда попал?»~
@31748 = ~«Расскажи мне о Лотаре».~
@31749 = ~«Расскажи мне о других черепах».~
@31750 = ~«Ничего. Прощай».~
@31751 = ~«В Проклятом. Привратном городе в Карцери».~
@31752 = ~«Проклятом? Привратном городе? Карцери?»~
@31753 = ~«Что я там делал?»~
@31754 = ~«Я? Я Гримскальп. Раньше был анархистом, из Революционной лиги. У нас были секреты и ячейки. Мы хотели перевернуть с ног на голову саму сущность планов, чтобы все могли жить свободно. У нас были тайны некоторых фрактолов, и мы были готовы сделать ход. Но нас предала другая фракция. Я был смертельно ранен, а Лотар был до смерти охоч до моих секретов. Хорошо, что большая часть уже неактуальна: обаянию Лотара невозможно сопротивляться».~
@31755 = ~«Что ты можешь рассказать об анархистах?»~
@31756 = ~«Расскажи мне о Лотаре».~
@31757 = ~«Расскажи мне о других черепах».~
@31758 = ~«Спасибо. Прощай».~
@31759 = ~«Предательство. Я должен был это предвидеть, учитывая, кем я являюсь. Или, по крайней мере, кем я был».~
@31760 = ~«Кем ты был?»~
@31761 = ~«Возможно. Прощай».~
@31762 = ~«Я пролил свет на многие тайны, но я не собираюсь ими жертвовать. В руках Лотара я видел ужас, который мог бы посрамить даже жестокие правила Гармониума. Он знает мои секреты лучше, чем я его, и будь я проклят, если отдам их кому-нибудь еще. Даже тебе. Особенно тебе».~
@31763 = ~«Почему? Ты что-то обо мне знаешь?»~
@31764 = ~«Почему? Ты что-то обо мне знаешь?»~
@31765 = ~«Тогда расскажи мне о себе».~
@31766 = ~«И как ты попал сюда?»~
@31767 = ~«Что ты можешь рассказать мне об остальных черепах?»~
@31768 = ~«Хорошо. Прощай».~
@31769 = ~«О них? Они всего лишь инструменты, хоть и не знают этого. Их мечты приземлены и эгоистичны. За своими помыслами они не видят общей картины. Они ничего не видят перед собой. Они бесполезны. Я не разговариваю с ними».~
@31770 = ~«Понятно. Тогда расскажи о себе».~
@31771 = ~«И как тогда ты сюда попал?»~
@31772 = ~«А что же Лотар?»~
@31773 = ~«Это все, что я хотел узнать. Прощай».~
@31774 = ~«Ты что, пустоголовый? Это привратный город на краю Внешних земель, вход в тюремный план Карцери. Это место предателей и изменников, там заговоров, что у баатезу за пазухой. Близость к Карцери влияет на сущность этого местечка. Не удивлюсь, если город уже сползает».~
@31775 = ~«Сползает? О чем это ты?»~
@31776 = ~«Что я там делал?»~
@31777 = ~«Спасибо. Прощай».~
@31778 = ~«Что ты там делал? Ты что-то там болтал о пне, который пытается тебя убить и вечно забредает не в то место. Ты был ну настолько спятившим, что я со своими друзьями тебя завернул. Оставил в тебе заточку и забрал твои вещички. Это было как раз перед тем, как меня предали, но я успел-таки кое-что припрятать».~
@31779 = ~«Что ты можешь сказать о Проклятом?»~
@31780 = ~«Где?»~
@31781 = ~«Где?»~
@31782 = ~«Где?»~
@31783 = ~«О. Что ж, спасибо. Прощай».~
@31784 = ~«Мне известно, что ты чем-то важен Лотару, и он хочет кое-что о тебе выяснить. Ты похож на головоломку. Он интересуется тобой, парень, и хочет ответы на свои вопросы. Он следит за тобой. Еще я знаю, что ты — старый путешественник: тебя уже видели прежде».~
@31785 = ~«Что ты знаешь обо мне?»~
@31786 = ~Некоторые люди посвящают себя жизни клинка, думая мускулами. Другие делают воровскую карьеру, позволяя своим пальцам говорить за себя. И все же большинство не занимается чем-то конкретным, бездумно плетется сквозь скуку своих обыденных жизней. Но только не волшебники. Волшебник стремится понять и пропустить через свое тело энергию мультивселенной, изучая тайны мироздания и манипулируя ими для достижения собственных целей. Они — опасные враги, поскольку они многое понимают и стремятся постичь еще больше. Кое-кто из них — обычные маги-недоучки. Кое-кто достигает истинного величия. Все они — потенциальная угроза.~
@31787 = ~Это надменное призрачное существо утверждает, что является моей *смертностью*. Оно охотилось за мной на протяжении множества моих жизней, посылало тени убить меня, заставляло меня забыть, *мучило* меня. Оно желает только наблюдать, как я страдаю, сломленный и забытый, при этом пребывая в покое и изоляции в Крепости сожалений. Я больше не дам ему возможность причинить мне вред.~
@31788 = ~Это загадочное призрачное существо нанесло Равель смертельный удар в последние мгновения ее пребывания в Черношипном лабиринте. Кто этот враг — неизвестно.~
@31789 = ~Это надменное призрачное существо утверждает, что является моей *смертностью*. Оно охотилось за мной на протяжении множества моих жизней, посылало тени убить меня, заставляло меня забыть, *мучило* меня. Оно желает только наблюдать, как я страдаю, сломленный и забытый, при этом пребывая в покое и изоляции в Крепости сожалений. Я больше не дам ему возможность причинить мне вред.~
@31790 = ~Убежденный Металл, гигантский железный голем, который трудится в загадочной осадной башне посреди Сигила, представляет собой металл, в который вдохнула жизнь страсть к разрушению. Он просто огромен, и похоже, что его цель состоит в создании вооружения.~
@31791 = ~~
@31792 = ~~
@31793 = ~Кажется, торговцы были всегда и везде. Их ненасытная страсть к деньгам и вещам вызывает жалость, тем не менее, их жадность отражает отношения в человеческой душе. В Сигиле, как и в других местах, они продают все, что кто-либо желает купить.~
@31794 = ~«Я запомню это. Прощай».~
@31795 = ~«Я уже рассказал почти все твоему другу. Ты чем-то важен Лотару, и он хочет кое-что о тебе выяснить. Ты похож на головоломку. Он интересуется тобой, парень, и хочет ответы на свои вопросы. Он следит за тобой. Еще я знаю, что ты — старый путешественник: тебя уже видели прежде».~
@31796 = ~«Что ты знаешь обо мне?»~
@31797 = ~«Я запомню это. Прощай».~
@31798 = ~«Мы — тайное сообщество, состоящее из ячеек, которые работают обособленно или получают директивы через сеть информаторов от руководителей, остающихся в тени. Наша цель — искоренить структуры власти, избавить людей от лжи политиканов и властей, позволить им жить свободно. Мы работаем в тайне — работали в тайне — и постоянно меняли порядки, чтобы избежать внедрения. Мое время прошло десятки лет назад, и все мои секреты больше не актуальны, за исключением лиц, которых я смог запомнить, да и те уже успели смениться».~
@31799 = ~«Вы похожи на кучку параноиков».~
@31800 = ~«Это все, что я хотел узнать. Прощай».~
@31801 = ~«Если бы организация, в которой ты состоишь, была взращена на интригах, внедрениях и ненависти к состоявшимся властолюбцам, тебе бы тоже пришлось быть осторожным. Когда за тобой на самом деле охотятся — это не паранойя. Мы считаем, что только любители ведут двойную игру, — череп окидывает тебя невозмутимым взглядом. — Думаю, с тобой я закончил. Прощай».~
@31802 = ~«Прощай».~
@31803 = ~«Не скажу. Может, когда-нибудь я верну себе тело и схожу за ним, а может, и нет. Ну а сейчас меня несказанно радует твой озадаченный вид. Удачи в поисках». Череп умолкает, и никакая лесть не может заставить его заговорить снова.~
@31804 = ~«Сволочь».~
@31805 = ~У тебя создается впечатление, будто череп окидывает тебя внимательным взглядом. «Ты ведь один из братьев, да? У меня нюх на такие вещи. По крайней мере, раньше был. И я думаю, что ты один из нас. Ну хорошо. Оно находится на складе. Поговори с его владельцем и скажи, что я прислал тебя. Не говори, что я уже мертв, и он охотно отдаст тебе его».~
@31806 = ~«Я запомню это. Спасибо. Хотя меня и не радует тот факт, что ты убил меня. Прощай».~
@31807 = ~«Когда убеждения привратного города приближаются к убеждениям пограничного плана, силы этих убеждений становится достаточно, чтобы план смог поглотить его целиком. Это происходит постоянно, по крайней мере, везде, где вовлечены анархисты». Последнюю фразу они произносит со зловещей гордостью.~
@31808 = ~«Расскажи мне об анархистах».~
@31809 = ~«Спасибо. Прощай».~
@31810 = ~Этот череп странной формы пронзительно хихикает перед тем, как заговорить с тобой. «Ч-ч-чем могу п-п-помочь?»~
@31811 = ~«Кто ты?»~
@31812 = ~«Как ты попал сюда?»~
@31813 = ~«Что ты можешь сказать о Лотаре?»~
@31814 = ~«Что ты можешь сказать о других черепах на этой полке?»~
@31815 = ~«Нет. Прощай».~
@31816 = ~«С-с-снова ты?»~
@31817 = ~«Кто ты?»~
@31818 = ~«Как ты попал сюда?»~
@31819 = ~«Что ты можешь сказать о Лотаре?»~
@31820 = ~«Что ты можешь сказать о других черепах на этой полке?»~
@31821 = ~«Ненадолго. Прощай».~
@31822 = ~«Я Г-г-гоатскомб. Я был крысооборотнем».~
@31823 = ~«КРЫСО-оборотнем? И сколько этих оборотней на свете?»~
@31824 = ~«Как-то н-н-неловко об этом говорить. Я был в крысиной форме, искал еду в Тлеющем трупе, и тут... скажем т-т-так, я не ожидал, что у официантки ок-к-кажется с-с-серебряная вилка. Мантуок н-н-наткнулся на меня, корчащегося в агонии — и я ок-к-казался тут».~
@31825 = ~«Что ты можешь сказать о Мантуоке?»~
@31826 = ~«Что ты можешь рассказать о других черепах?»~
@31827 = ~«Что ты можешь сказать о Лотаре?»~
@31828 = ~«Понятно. Что ж, прощай».~
@31829 = ~Череп Гоатскомба не издает ни звука. Ты уверен, что если бы у него были глаза, они бы бегали от ужаса. «Уходи...» — шепчет череп. Он отказывается продолжать разговор.~
@31830 = ~«Тогда прощай».~
@31831 = ~«Они все т-т-таки критиканы. Т-т-только потому, что большинство из них — ч-ч-человеческие черепа, они с-с-считают, что ч-ч-чем-то лучше меня. Я их н-н-НЕНАВИЖУ».~
@31832 = ~«Вот так здоровые отношения. Расскажи мне о себе, ты не против?»~
@31833 = ~«Как мило. И как ты здесь оказался?»~
@31834 = ~«Тогда Лотар, должно быть, нравится тебе?»~
@31835 = ~«Рад за тебя. Прощай».~
@31836 = ~«О, н-н-немало. В-в-вороны, в-в-волки, м-м-медведи, б-б-барсуки... даже к-к-крокодилы! Похоже, что у всех животных в Звериных землях есть с-с-сородичи-оборотни. Это д-д-довольно интересно, правда».~
@31837 = ~«Есть здесь поблизости какие-нибудь крысооборотни?»~
@31838 = ~«Как убить оборотня?»~
@31839 = ~«Да, очень интересно. Прощай».~
@31840 = ~«Жалкий м-м-маг-недоучка! Алк-к-каш! Это я сделал его таким, какой он есть. М-м-м-много лет назад он был всего лишь в-в-вонючим двуногим. Я наткнулся на его и зак-к-кусил его н-н-ногой. На вкус как маринованное м-м-мясо. Я еще м-много дней п-п-потом ходил пьяный. А потом он н-н-нарисовывается с какой-то чудо-к-к-книжкой — и вот я уже в-в-в-вчерашний мусор и украшение на п-п-полке. Ублюдок».~
@31841 = ~«Ты знаешь какие-нибудь его секреты?»~
@31842 = ~«Как мне его убить?»~
@31843 = ~«Нелегкая у тебя жизнь. Прощай».~
@31844 = ~«М-м-мантуок и его банда. Это я сделал его таким, и ч-ч-ч-чем он мне отплатил? Пошел и продал меня Л-л-лотару! Но это ничего... я с-с-слил боссу все его секреты. Мантуок м-м-может считать себя в безопасности, но Лотар-то в-в-все знает».~
@31845 = ~«Что ты можешь рассказать о Мантуоке?»~
@31846 = ~«Например?»~
@31847 = ~«Как мне его убить?»~
@31848 = ~«Хорошо. Прощай».~
@31849 = ~«Убить л-л-ликантропа просто: н-н-найди серебряное или м-м-магическое оружие, и проткни его! Обычное оружие действует не так хорошо... Однажды меня всего утыкали с-с-с-стрелами. Было больно, д-д-да и только. Я был похож на д-д-д-дикобраза!»~
@31850 = ~«Спасибо. Прощай».~
@31851 = ~«Его с-с-секрет в том, что он работает и на Лотара, и на М-м-м-многоединого, коллективный разум черепокрыс. Не знаю, что он там з-з-адумал, н-н-но... это и н-н-н-неважно, потому что я уже в-в-все рассказал Лотару».~
@31852 = ~«Понятно. Спасибо и прощай».~
@31853 = ~Покупательница~
@31854 = ~Покупатель~
@31855 = ~Рыночный рабочий~
@31856 = ~Анце~
@31857 = ~Аалек~
@31858 = ~Уголек~
@31859 = ~Дриксел~
@31860 = ~Корвус~
@31861 = ~Лазло~
@31862 = ~Карина~
@31863 = ~Страган Темнорунный~
@31864 = ~Взгляд Лотара сердито сверкает. «Значит, убиваешь моих слуг? Дай мне череп». Он внимательно осматривает череп и произносит: «Я могу учуять его предательство через его кость. Он был осторожным, но недостаточно, да? Не бойся, я отниму у него его тайны и разберусь с его двуличной сущностью».~
@31865 = ~«У меня много вопросов».~
@31866 = ~Этот узкоглазый мужчина с резкими чертами лица прочесывает окрестности рассеянным безразличным взглядом, время от времени останавливаясь, чтобы поковыряться в ногтях. Несмотря на то, что одет он в шелковые и вельветовые одежды, ему удается казаться отталкивающим и весьма опасным человеком.~
@31867 = ~«Ни за что».~
@31868 = ~«Ты что, думаешь, я тут брожу по району, чтобы раздавать тайны незнакомцам? Проваливай сейчас же».~
@31869 = ~«По рукам».~
@31870 = ~Он намеренно игнорирует тебя.~
@31871 = ~«Ха, — пару секунд он молча стоит, потом выдает кривую улыбку. — Неплохо, — некоторое время он тебя рассматривает. — Я наставник из Городского Фестхолла. Зовут Хейвлок, Илай Хейвлок. Я разведчик-ветеран и преподаю искусство уловки».~
@31872 = ~Илай делает кислую мину. «Даже не знаю. Хватит с меня мелких карманников и любопытных чувствующих». Почти что про себя он добавляет: «Не знаю, зачем я вообще на это соглашался».~
@31873 = ~«Хм-м...»~
@31874 = ~Лотар поручил мне найти другой череп, чтобы заменить тот, которого я не нашел в моей гробнице с ловушками.~
@31875 = ~Лотар сказал, чтобы я нашел другой череп, чтобы заменить тот, которого я не нашел в гробнице с ловушками.~
@31876 = ~Гнилой Уильям предложил мне 200 монет за смерть Кристалл, предводительницы противоборствующей банды в переулке Опасных углов. Я согласился.~
@31877 = ~Гнилой Уильям предложил мне 300 монет за смерть Кристалл, предводительницы противоборствующей банды в переулке Опасных Углов. Я согласился.~
@31878 = ~Гнилой Уильям попросил меня убить Черного Бутона, убийцу, который обычно бродит по переулку Опасных Углов.~
@31879 = ~Кристалл, предводительница Бритвенных Ангелов с переулка Опасных углов, попросила меня уничтожить ее главного соперника, человека по имени Гнилой Уильям. В обмен на это в будущем я смогу свободно ходить по переулку.~
@31880 = ~Некто по имени Байрон Пикит, возможно, ведет темные дела. Похоже на то, что он мог убить торговца по имени Зак, а затем украсть какие-то документы у его вдовы Трист. Без этих документов Трист не может доказать, что погасила заем, и поэтому ее продали в рабство, чтобы покрыть долг. Возможно, мне стоит с этим разобраться.~
@31881 = ~Я пообещал помочь призраку, стоящему на страже в Мавзолее. Похоже, что сюда проник некромант, который огородился во внутренней комнате сильными чарами для защиты от призрака. Должно быть, это он в ответе за «живых мертвецов», которые беспокоят Норочжа.~
@31882 = ~Лотар предложил мне посетить Городской Фестхолл в поисках ответов на вопросы о Равель Заморочке.~
@31883 = ~Илай кивает, обдумав сказанное тобой. «Да... нет смысла это отрицать. Хотя, когда смотришь на это с такой точки зрения, становится даже немного грустно».~
@31884 = ~На миг он поднимает брови от удивления, затем сердито хмурится. «Ищешь неприятностей, а? Иди поиграйся с тенью Леди, пень. Отвали!»~
@31885 = ~«Ха! И снова ты прав, — он по-дружески толкает тебя кулаком в плечо. — Спасибо, знаток, — неожиданно он смотрит вдаль. — Что ж... Довольно тратить время. Я направляюсь в Фестхолл. Если ты все еще хочешь учиться — там ты меня и найдешь».~
@31886 = ~«Нет... Хватит с меня мелких карманников и будущих грабителей».~
@31887 = ~Он кривится и смотрит в небо. «Пф... думаю, много чего, — он смотрит тебе прямо в глаза. — Тем не менее, для тебя я упрощу задачу — звенелки. Если хочешь учиться, это будет тебе кое-чего стоить. Я скорее ущипну Леди за зад, чем стану учить очередного пня задарма!»~
@31888 = ~Илай пожимает плечами. «Черт, я даже не знаю. Пять сотен монет — разумная цена... Я — разведчик-*ветеран*, знаешь ли... я пять раз бывал на Войне Лжи! У меня немало опыта, которым я мог бы поделиться...»~
@31889 = ~Он качает головой. «Нет. Я хочу пять сотен — ты заплатишь пять сотен».~
@31890 = ~Он закатывает глаза. «Ты что, спятил, пень? Черта-с-два! Моя цена — пять сотен, ни больше, ни меньше».~
@31891 = ~«Если вернешься, цену ты знаешь — пять сотен медных монет. Прощай, рубака».~
@31892 = ~«По рукам, — вы обмениваетесь рукопожатием. — Они у тебя с собой?»~
@31893 = ~Он берет у тебя стопки монет и прячет их в тунику. «Встретимся в Городском Фестхолле, там я буду обучать тебя. А пока прощай, рубака».~
@31894 = ~«Если вернешься, цену ты знаешь — три сотни медных монет. Прощай, рубака».~
@31895 = ~Он ухмыляется. «Да, это я...»~
@31896 = ~Этот узкоглазый мужчина с резкими чертами лица прочесывает окрестности рассеянным безразличным взглядом, время от времени останавливаясь, чтобы поковыряться в ногтях. Он обнаруживает твое приближение и поворачивается к тебе. «Все вынюхиваешь? — он хмурится. — Чего тебе?»~
@31897 = ~«Мне кажется, что это ловушка для отпугивания грабителей могил, которые охотятся на такие склепы».~
@31898 = ~«Это была моя собственная гробница».~
@31899 = ~Илай видит твое приближение, но выражение его лица невозможно разобрать. Интересно, видит ли он тебя своими узкими черными глазами. «Хм-м?»~
@31900 = ~«И все же ты добыл интересные сведения... кое-что из сказанного тобой об этом склепе кажется многообещающим. Я подумаю над этим, и тебе советую сделать то же самое, — он отворачивается и тут же поворачивается к тебе назад. — Принеси мне другой череп, и наш договор будет на тех же условиях. И не пытайся подсунуть мне обычный череп: я в этом разбираюсь. Возвращайся, когда добудешь мне что-нибудь ценное».~
@31901 = ~«Отлично. Прощай».~
@31902 = ~«Твоя гробница? ТВОЯ гробница? — он внимательно осматривает тебя. — Надо будет разузнать об этом побольше. Принеси мне другой череп, потому что непохоже, что ты готов отдать мне свой, и тогда мы посмотрим, на какие вопросы я смогу ответить. Наше соглашение останется таким же, как и прежде. И не пытайся подсунуть мне обычный череп: я в этом разбираюсь. Возвращайся, когда добудешь мне что-нибудь ценное».~
@31903 = ~«У тебя звенелки есть?»~
@31904 = ~«Я направляюсь в тренировочный зал разведчиков в Городском Фестхолле, рубака. Если хочешь поболтать или потренироваться, там и увидимся. Прощай».~
@31905 = ~«Отлично. Прощай».~
@31906 = ~«Ого, глядите, кто пришел! — Илай по-озорному улыбается тебе. — Добро пожаловать на мою территорию, рубака. Готов учиться?»~
@31907 = ~«Ладно-ладно. Вот... давай посмотрим, можешь ли ты забрать это у меня из руки, рубака». Он протягивает руку: на ладони лежит медная монета.~
@31908 = ~Твоя рука выстреливает, выхватывая монету из его ладони с такой скоростью, что ты потрясен не меньше, чем Илай. «О Силы! Да ты шустрее, чем кажешься, рубака...»~
@31909 = ~Ты выбрасываешь руку... но Илай слишком быстр. «Довольно неплохо, рубака. Продолжим».~
@31910 = ~Ты делаешь нелепую попытку схватить монету Илая. Он хмурится, печально качая головой.~
@31911 = ~«Извини, рубака... Мне неловко об этом говорить, но ты просто слишком медленный, чтобы продолжать работать в этом направлении. Тем не менее, удачи тебе, чем бы ты не занялся... прощай».~
@31912 = ~«Извини, рубака... Мне неловко об этом говорить, но ты просто слишком медленный, чтобы продолжать работать в этом направлении. Слушай, мне кажется неправильным брать твои звенелки, так что вот... забери их. И удачи тебе, чем бы ты не занялся... прощай».~
@31913 = ~«Итак, начнем, рубака. Я обучу тебя шести основным искусствам уловки: как двигаться незаметно, используя тени для укрытия, взлому замков и карманному воровству, обнаружению и обезвреживанию ловушек, и тому, как устраивать засады и бить врагов в спину из укрытия».~
@31914 = ~«Умение двигаться бесшумно, укрываясь в тенях, высоко ценится. Многих врагов можно избежать, попросту оставаясь незамеченным. Кроме того, нападение на врага из укрытия дает разведчику большие преимущества, о чем я расскажу позже. Но запомни, рубака: разведчик не может скрыться, если враг его уже заметил».~
@31915 = ~«Нередко разведчик обнаруживает, что путь ему преграждает запертый портал, или вещи либо документы, жизненно важные для его миссии, спрятаны в закрытой емкости. В такие минуты на помощь приходит умение взламывать замки. Тем не менее, рекомендуется всегда проверять такие замки на наличие ловушек, о которых я расскажу позже».~
@31916 = ~«Иногда предмет или документ, жизненно важный для миссии разведчика, враги держат при себе. В такие минуты разведчик должен прибегнуть к карманному воровству, подкравшись поближе и украв предмет. Однако разведчик должен всегда быть готовым к схватке или погоне, если его попытка окажется неудачной».~
@31917 = ~«Нередко разведчик обнаруживает, что враги установили ловушки в месте, которое нужно пересечь, или на емкости, которую нужно открыть. Подобные ловушки всегда хорошо прячутся; разведчик должен осторожно приблизиться к месту или предмету и использовать умение находить все подозрительное. Будь терпеливым... иногда хватает нескольких секунд, чтобы обнаружить ловушку».~
@31918 = ~«Как только разведчик *находит* ловушку, ему нужно либо обойти ее, либо попытаться обезвредить. Однако, пытаясь обезвредить ловушку, ему нужно быть крайне осторожным, так как всегда есть шанс того, что она сработает во время обезвреживания».~
@31919 = ~«Последнее, чему я тебя научу, — это коронный маневр разведчика... удар со спины. Если разведчик встретит врага и нападет на него, все еще находясь в укрытии, его первый удар будет более точным и *сильным*. Становясь более опытным, разведчик становится еще смертоноснее, нападая из теней. Однако запомни... нападая из укрытия, разведчик обнаруживает себя перед врагами».~
@31920 = ~Илай кивает. «Хорошо, рубака... для начала, ты должен расслабиться. Ты чересчур напряжен. Порой тебе придется полагаться на свои инстинкты, верить своей интуиции...»

Твое обучение на вора начинается.~
@31921 = ~Илай кивает. «Итак, ты понимаешь, что ты получишь, бросив свою текущую специальность, правильно? Ты готов это сделать?»~
@31922 = ~После длительного периода обучения Илай удовлетворенно кивает тебе. «Должен сказать, рубака: еще ни разу мне не попадался более способный ученик. Мне почти кажется, что ты это все уже раньше делал!»~
@31923 = ~После длительного периода обучения Илай удовлетворенно кивает тебе. «Должен сказать, рубака: еще ни разу мне не попадался более способный ученик. Мне почти кажется, что ты это все уже раньше делал!» Когда Илай говорит это, ты начинаешь понимать, что *занимался* этим раньше... что однажды ты уже владел всеми этими умениями, и обучение снова пробудило их.~
@31924 = ~После длительного периода обучения Илай удовлетворенно кивает тебе. «Должен сказать, рубака: еще ни разу мне не попадался более способный ученик. Мне почти кажется, что ты это все уже раньше делал!» Когда Илай говорит это, ты начинаешь понимать, что *занимался* этим раньше... что однажды ты уже владел всеми этими умениями.~
@31925 = ~Расплывчатые воспоминания того, как ты прятался в темных проходах и обходил смертоносные ловушки, помогают тебе вспомнить достаточно, чтобы «изучить» сверх того, чему обучил тебя Илай.~
@31926 = ~«Если ты уже обучен, я мало чему могу тебя научить, рубака. Однако, если ты сбился с пути разведчика, я всегда могу снова показать тебе этот путь».~
@31927 = ~«Итак, ты понимаешь, что должен бросить свою текущую специальность, правильно? Ты готов сделать это?»~
@31928 = ~«Хорошо, хорошо! Тогда давай начнем обучение... приведем в порядок твои заброшенные навыки!»~
@31929 = ~«Должен сказать, ты быстро схватываешь, рубака, — он с любопытством рассматривает тебя темными щелками своих глаз, затем качает головой. — Ну, вот и все — ты готов».~
@31930 = ~Илай останавливается, чтобы кивнуть тебе. «Привет, рубака. Тебе что-то нужно?»~
@31931 = ~Мужчина грозит тебе пальцем. «Следи за собой, пень... да за такое любой знаток прикончил бы тебя или позвал твердолобых. Проваливай сейчас же, пока я не передумал и не обнажил сталь».~
@31932 = ~Илай горько смеется, качая головой. «Неплохая попытка, рубака... вовсе неплохая».~
@31933 = ~Илай горько смеется, качая головой. «Неплохая попытка, рубака... вовсе неплохая».~
@31934 = ~«Да-да... а теперь сгинь, пока твои подстрекательства не начали меня доставать».~
@31935 = ~Он качает головой. «Это не так, рубака. Даже я вынужден признать, что битву все еще нужно выиграть. Было бы ошибкой полагаться только на воровство».~
@31936 = ~Он качает головой. «Ни один разведчик, даже я, не овладел скрытностью в такой мере. И от некоторых врагов невозможно скрыться: твой запах и даже мысли выдадут тебя».~
@31937 = ~«Приветствую...»~
@31938 = ~Оставить мужчину в покое.~
@31939 = ~«Не спеши. Ты Илай Хейвлок?»~
@31940 = ~«Не спеши. У меня есть несколько вопросов...»~
@31941 = ~«На твоем месте я бы следил за языком».~
@31942 = ~Уйти.~
@31943 = ~«Тогда *зачем* ты здесь? Чтобы грубить прохожим?»~
@31944 = ~«Тогда *зачем* ты здесь? Чтобы грубить прохожим?»~
@31945 = ~«На твоем месте я бы следил за языком».~
@31946 = ~Уйти.~
@31947 = ~Схватить его и немного потрясти, чтобы разговорить.~
@31948 = ~Уйти.~
@31949 = ~«В смысле, воровство?»~
@31950 = ~«Ты мог бы обучить меня?»~
@31951 = ~«Мне это тоже нравится. Прощай, Илай».~
@31952 = ~«Прошу прощения, не хотел тебя обидеть. Ты мог бы меня обучить?»~
@31953 = ~«Тем не менее, ты мог бы меня обучить?»~
@31954 = ~«Понятно. Прощай, Илай».~
@31955 = ~«Наверно, из-за того, что, обучая других, ты показываешь им свои собственные умения».~
@31956 = ~«Что мне сделать, чтобы уговорить тебя?»~
@31957 = ~«Тогда прощай». ~
@31958 = ~«И в то же время ты защищаешь благородный статус своих умений, уверяя их, что ты не просто вор, а разведчик и шпион, мастер уловки».~
@31959 = ~«Я так не думаю. Представителей твоей профессии часто понимаются неправильно, и несправедливо причисляют их к той же категории, что и разбойников с бандитами. Нет ничего плохого в том, чтобы развеивать ложные убеждения».~
@31960 = ~«Ты прав: на это жалко смотреть».~
@31961 = ~Уйти.~
@31962 = ~«Пожалуй, там и увидимся, Илай. Счастливо».~
@31963 = ~«Что мне сделать, чтобы уговорить тебя?»~
@31964 = ~«Тогда прощай». ~
@31965 = ~«Сколько?»~
@31966 = ~«Забудь. Прощай».~
@31967 = ~«Позволь мне помочь решить эту проблему!»~
@31968 = ~«У меня одни из лучших цен во всех районах!»~
@31969 = ~«Ты будешь бестолочью, если пойдешь в другое место, пень!»~
@31970 = ~«Ты выглядишь так, как будто тебе не помешало оружие получше, рубака!»~
@31971 = ~«По рукам».~
@31972 = ~«Как насчет трех сотен?»~
@31973 = ~«Как насчет трех сотен?»~
@31974 = ~«Давай, подходи сюда и найди своим медякам хорошее применение!»~
@31975 = ~«Как насчет двух сотен?»~
@31976 = ~«Оружие на продажу! Оружие на продажу!»~
@31977 = ~«Во имя сил и их матерей, что *это*, черт возьми?»~
@31978 = ~«Забудь. Прощай».~
@31979 = ~«Тогда по рукам».~
@31980 = ~«Тогда забудь об этом. Прощай».~
@31981 = ~«Ладно, как насчет трех сотен?»~
@31982 = ~«Ладно, как насчет трех сотен?»~
@31983 = ~«Тогда забудь об этом. Прощай».~
@31984 = ~Уйти.~
@31985 = ~«Да... держи».~
@31986 = ~«Нет... не сейчас».~
@31987 = ~«Да... держи».~
@31988 = ~«Нет... не сейчас».~
@31989 = ~«На самом деле, в данный момент я не хочу обучаться. Прощай».~
@31990 = ~«Там и увидимся, Илай. Счастливо».~
@31991 = ~«Прощай, Илай».~
@31992 = ~«Ки-Саи не хочет обучать меня на воина... Он утверждает, что я могу просто украсть оружие противника, оставив его безоружным. Что ты об этом думаешь?»~
@31993 = ~«Ки-Саи все еще не хочет обучать меня на воина... Он утверждает, что я могу скрываться от врагов, и таким образом оставаться неуязвимым. Что ты об этом думаешь?»~
@31994 = ~«Ты мог бы выучить меня на вора?»~
@31995 = ~«Это все, что я хотел узнать. Прощай».~
@31996 = ~«Интересно, не ты ли Илай Хейвлок».~
@31997 = ~«У меня есть несколько вопросов...» ~
@31998 = ~«Ничего. Прощай».~
@31999 = ~«Ки-Саи не хочет обучать меня на воина... Он утверждает, что я могу просто украсть оружие противника, оставив его безоружным. Что ты об этом думаешь?»~
@32000 = ~«Ки-Саи все еще не хочет обучать меня на воина... Он утверждает, что я могу скрываться от врагов, и таким образом оставаться неуязвимым. Что ты об этом думаешь?»~
@32001 = ~«Илай... ты мог бы обучить меня?»~
@32002 = ~«Я просто проходил мимо. Прощай, Илай».~
@32003 = ~«Все пятьсот монет... держи».~
@32004 = ~«Нет... не сейчас».~
@32005 = ~«Все триста монет... держи».~
@32006 = ~«Нет... не сейчас».~
@32007 = ~«На самом деле, в данный момент я не хочу обучаться. Прощай».~
@32008 = ~«Прощай, Илай».~
@32009 = ~«Не сейчас. Ки-Саи не хочет обучать меня на воина... Он утверждает, что я могу просто украсть оружие противника, оставив его безоружным. Что ты об этом думаешь?»~
@32010 = ~«Не сейчас. Ки-Саи не хочет обучать меня на воина... Он утверждает, что я могу скрываться от врагов, и таким образом оставаться неуязвимым. Что ты об этом думаешь?»~
@32011 = ~«Да».~
@32012 = ~«Да».~
@32013 = ~«Нет, не сейчас, Илай. Прощай».~
@32014 = ~Схватить монету.~
@32015 = ~Попробовать схватить монету.~
@32016 = ~Попробовать схватить монету.~
@32017 = ~«Спасибо».~
@32018 = ~«Хорошо...»~
@32019 = ~«Что?»~
@32020 = ~«Что?»~
@32021 = ~«Понятно... Тогда прощай, Илай».~
@32022 = ~«Понятно... Тогда прощай, Илай».~
@32023 = ~«Понятно... Тогда прощай, Илай».~
@32024 = ~«Продолжай..»~
@32025 = ~«Думаю, основы я знаю, Илай. Давай перейдем к обучению».~
@32026 = ~«Продолжай..»~
@32027 = ~«Думаю, основы я знаю, Илай. Давай перейдем к обучению».~
@32028 = ~«Продолжай..»~
@32029 = ~«Продолжай..»~
@32030 = ~«Думаю, основы я знаю, Илай. Давай перейдем к обучению».~
@32031 = ~«Продолжай..»~
@32032 = ~«Думаю, основы я знаю, Илай. Давай перейдем к обучению».~
@32033 = ~«Продолжай..»~
@32034 = ~«Ладно, Илай. Займемся обучением».~
@32035 = ~Выучить все, что сможешь.~
@32036 = ~Выучить все, что сможешь.~
@32037 = ~Выучить все, что сможешь.~
@32038 = ~Выучить все, что сможешь.~
@32039 = ~«Да».~
@32040 = ~«Нет, лучше не надо. Может, в другой раз... Прощай, Илай».~
@32041 = ~«Пожалуй, я знал, Илай, но просто забыл. Спасибо и прощай»~
@32042 = ~«Пожалуй, я знал, Илай, но просто забыл. Спасибо и прощай»~
@32043 = ~«Пожалуй, я знал, Илай, но просто забыл. Спасибо и прощай»~
@32044 = ~Уйти.~
@32045 = ~«Я снова хочу постигнуть путь уловок, Илай».~
@32046 = ~«Понимаю. Прощай, Илай».~
@32047 = ~«Да, я больше не хочу быть воином».~
@32048 = ~«Да, я больше не хочу быть магом».~
@32049 = ~«Вообще-то, не сейчас. Прощай, Илай».~
@32050 = ~Учиться, чтобы снова стать вором.~
@32051 = ~«Спасибо, Илай. Прощай».~
@32052 = ~«Ки-Саи не хочет обучать меня на воина... Он утверждает, что я могу просто украсть оружие противника, оставив его безоружным. Что ты об этом думаешь?»~
@32053 = ~«Ки-Саи все еще не хочет обучать меня на воина... Он утверждает, что я могу скрываться от врагов, и таким образом оставаться неуязвимым. Что ты об этом думаешь?»~
@32054 = ~«Нет... просто мимо проходил. Прощай, Илай».~
@32055 = ~«Давай, доставай свой меч — я воткну его тебе в череп».~
@32056 = ~Уйти.~
@32057 = ~«Э... спасибо».~
@32058 = ~«Э... спасибо».~
@32059 = ~«Э... спасибо».~
@32060 = ~«Спасибо, Илай. Прощай».~
@32061 = ~«Прощай, Илай».~
@32062 = ~«Спасибо, Илай. Прощай».~
@32063 = ~«Спасибо, Илай. Прощай».~
@32064 = ~Сильный запах алкоголя окружает эту девушку. Несмотря на темную кожу, ты видишь, что ее лицо — прекрасное, но жестокое — покраснело. Она стройна, но мускулиста. На ней экзотичные украшения и прозрачные шелковые одежды. Многочисленные шрамы пересекаются на ее бедрах и предплечьях; они похожи на боевые ранения.~
@32065 = ~«Приветствую...»~
@32066 = ~Когда ты подходишь, молодой вельможа ухмыляется, но не произносит ни слова.~
@32067 = ~«Приветствую...»~
@32068 = ~Привет, доктор Ник!~ [TESTBEAT]
@32069 = ~Он намеренно тебя игнорирует.~
@32070 = ~Когда ты подходишь, молодой вельможа избегает встретиться с тобой взглядом. Он хихикает в ладонь, тряся головой.~
@32071 = ~Он закатывает глаза и жестом гонит тебя прочь, не желая отвечать на твое приветствие ни единым словом.~
@32072 = ~Молодой вельможа вежливо кивает в знак приветствия, но отказывается поддерживать с тобой разговор.~
@32073 = ~Оставить его в покое.~
@32074 = ~Уйти.~
@32075 = ~«Приветствую...»~
@32076 = ~Оставить его в покое.~
@32077 = ~Уйти.~
@32078 = ~Уйти.~
@32079 = ~Human Male Thug Damage 1~ [CON_06]
@32080 = ~::Пьяный хохот::~
@32081 = ~Human Female Townie Damage 1~ [CON_07]
@32082 = ~«Эй, *братец*... Я хочу поговорить с тобой».~
@32083 = ~«*Братец*, удели минуту своего времени!»~
@32084 = ~Human Male Townie Death~ [CON_08]
@32085 = ~«Чтоб меня Леди ослепила: теперь по улицам Сигила разгуливают трупы?»~
@32086 = ~Human Female Townie Death~ [CON_09]
@32087 = ~«Что *это* за трупная вонь?!»~
@32088 = ~«Смотри! Вот так зверюга!»~
@32089 = ~Dustmen Male Damage 1~ [CON_05]
@32090 = ~Dustmen Male Death~ [CON_08]
@32091 = ~Dustmen Female Damage 1~ [CON_07]
@32092 = ~Dustmen Female Death~ [CON_09]
@32093 = ~Abishai Damage 1~ [ABISH06]
@32094 = ~Abishai Battle Cry 1 (Approach 1)~ [ABISH01]
@32095 = ~Cranium Rat Death~ [CRRAT08]
@32096 = ~Drone Heavy Battle Cry 1 (Approach 1)~ [DRONH01]
@32097 = ~Drone Heavy Battle Cry 2 (Approach 2)~ [DRONH02]
@32098 = ~Cranium Rat Damage 2~ [CRRAT07]
@32099 = ~Skeleton Worker Battle Cry 1 (Approach 1)~ [SKELW01]
@32100 = ~Cornugon Death~ [CORNU08]
@32101 = ~Cranium Rat Battle Cry 1 (Approach 1)~ [CRRAT01]
@32102 = ~Giant Armored Skeleton Battle Cry 1 (Approach 1)~ [ARMSK01]
@32103 = ~Cornugon Battle Cry 2 (Approach 2)~ [CORNU02]
@32104 = ~Cornugon Damage 2~ [CORNU07]
@32105 = ~Abishai Battle Cry 2 (Approach 2)~ [ABISH02]
@32106 = ~Прекратить слушать, уйти.~
@32107 = ~Он начинает речь унылым тоном: «Смерть. Вот что ждет вас в конце жизненного пути». Он слегка прокашливается, театрально вскинув брови и взмахнув руками. «Но смерть — это *не конец*! Это только начало!»~
@32108 = ~Продолжать слушать.~
@32109 = ~Покинуть лекционный зал.~
@32110 = ~«Ведь когда вы умрете, вы не перестанете существовать, нет! Это далеко не так! Внешние планы будут рады принять вас в свое лоно! Новая жизнь... которую вы *никогда* не знали, ждет вас там!»~
@32111 = ~Продолжать слушать.~
@32112 = ~Прекратить слушать, уйти.~
@32113 = ~«Вы сбросите с себя рваные лохмотья этой жизни и станете одними из верующих — просителями! Став *просителем* на Внешнем плане, вы заживете *истинной* жизнью!»~
@32114 = ~Прекратить слушать, уйти.~
@32115 = ~Продолжать слушать.~
@32116 = ~«Если вы были благочестивым человеком, непоколебимым в милосердии и доброй воле к своим ближним, то, возможно, белоснежные склоны Небесной горы примут вас после смерти. Ваш дух будет пребывать там в виде просителя в красотах золотых рассветов, ласкового солнечного света...» Он мечтательно вздыхает.~
@32117 = ~Продолжать слушать.~
@32118 = ~Прекратить слушать, уйти.~
@32119 = ~«Или же вы жили жизнью предателя, лжеца, изменника, готового на все ради своих интересов. Холодный, кроваво-красный Карцери, план, куда низвергаются все предатели после смерти, станет вам клеткой. Будучи просителем на этом плане, вы будете жить жизнью вероломства и предательства, лжи и обмана, жизнью, где ничему нельзя верить».~
@32120 = ~Продолжать слушать.~
@32121 = ~Прекратить слушать, уйти.~
@32122 = ~Он склоняется вперед, его взгляд метается из стороны в сторону. «А *возможно* вы жили жизнью кровожадного злодея, презирающего близких, втаптывающего других ради своих утех, не взирая ни на что...»~
@32123 = ~Продолжать слушать.~
@32124 = ~Прекратить слушать, уйти.~
@32125 = ~«...тогда, вероятно, один из Нижних планов — Баатор или хаотично кружащиеся слои Бездны — примут вас! На этот план попадут души, злые по своей *сути*, и большинство из них будет обречено на безумную жестокость и муки, или же на рабство в ужасной, — он театрально понижает голос, — Кровавой войне».~
@32126 = ~Продолжать слушать.~
@32127 = ~Прекратить слушать, уйти.~
@32128 = ~«Неважно, куда вы попадете, важно только одно: вы начнете *новую* жизнь. Новую жизнь, дорогие сигильцы!»~
@32129 = ~Продолжать слушать.~
@32130 = ~Прекратить слушать, уйти.~
@32131 = ~«Вы сможете начать заново, не мучаясь с памятью старой жизни. Здесь у вашей души только одна отДУШИна, — он улыбается собственной шутке, — *слиться* с вашим новым планом, став *одним* целым с идеалами и сущностью самого плана!»~
@32132 = ~Продолжать слушать.~
@32133 = ~Прекратить слушать, уйти.~
@32134 = ~«Вы должны стать одним из жителей, просителем этого плана или, в идеальном случае, одним из строительных блоков фундамента, на котором зиждиться сам план! В этом заключается цель *всех* просителей! Чтобы выполнить свою цель, вы, — для предания выразительности он хлопает в ладони, — ДОЛЖНЫ — *хлопок* — ДЕРЖАТЬСЯ — *хлопок* — СВОИХ — *хлопок* — ИДЕАЛОВ!»~
@32135 = ~Продолжать слушать.~
@32136 = ~Прекратить слушать, уйти.~
@32137 = ~«Ваших идеалов! Добро или зло, порядок или хаос, а, может, что-то между ними! Попав на подходящий по мировоззрению план, вы завершите свой путь, став частью... самого... *плана*! Это почетное существование, дорогие сигильцы!»~
@32138 = ~Продолжать слушать.~
@32139 = ~Прекратить слушать, уйти.~
@32140 = ~«Вот что ждет вас *после* 'смерти', дорогие слушатели! Следите за тем, как проживаете свою жизнь, но знайте, что после нее вас ждет *не забвение*!»~
@32141 = ~Продолжать слушать.~
@32142 = ~Прекратить слушать, уйти.~
@32143 = ~«А теперь я отвечу на любые ваши вопросы. Есть желающие?»~
@32144 = ~«У меня есть вопрос...»~
@32145 = ~Тихо ждать.~
@32146 = ~«Если вопросов нет, тогда завершим выступление... на этот раз. Я продолжу свои чтения в Зале, и, возможно, спустя несколько лет... я встречу *вас* в качестве просителя по ту сторону Смерти!»~
@32147 = ~Прекратить слушать, уйти.~
@32148 = ~Немного нахмурившись, докладчик поворачивается в сторону Морта. Он вытягивает шею, пытаясь узнать, кто это сказал. «Вопрос? Вопрос от одного из живущих?»~
@32149 = ~Он кивает, словно ставя тебя на свое место. «А теперь я отвечу на любые ваши вопросы. Есть желающие?»~
@32150 = ~«У меня есть вопрос...»~
@32151 = ~Тихо ждать.~
@32152 = ~Он указывает тебе продолжать.~
@32153 = ~«Как определить, на какой план ты попадешь после смерти?»~
@32154 = ~~
@32155 = ~~
@32156 = ~~
@32157 = ~«Что, если кто-то не может умереть?»~
@32158 = ~«Объясни мне, что такое 'мировоззрение'».~
@32159 = ~«Тленные говорят, что *эта* жизнь — та, в которой мы закончим существование после смерти».~
@32160 = ~«Докажи сказанное».~
@32161 = ~«Расскажи мне о Кровавой войне».~
@32162 = ~«Я хочу спросить об одном из упомянутых планов».~
@32163 = ~«На самом деле, неважно. Вопросов нет».~
@32164 = ~«Если вопросов больше нет...»~
@32165 = ~Собраться уходить.~
@32166 = ~Собраться уходить.~
@32167 = ~Собраться уходить.~
@32168 = ~«По вашему мировоззрению, конечно же! Хорошие люди попадают на Верхние планы, а *плохие* — низвергаются в Нижние... — он закатывает глаза, театрально прикладывая руку к сердцу. — Да смилостивятся силы над их душами».~
@32169 = ~«А куда попадают нейтральные люди?»~
@32170 = ~«У меня другой вопрос...»~
@32171 = ~«Это все, что я хотел узнать».~
@32172 = ~Он приподнимает бровь. «Отличный вопрос, просто отличный! — чтобы привлечь внимание аудитории, он поднимает палец. — Ответ таков: дух, живший полностью нейтральной жизнью, не склонившийся ни к добру, ни к злу, станет просителем *Внешних земель*, земель, окружающих Сигил. Для них нет плана, кроме той земли, что лежит под нашим небом, и частью которой является Шпиль».~
@32173 = ~«У меня другой вопрос...»~
@32174 = ~«Это все, что я хотел узнать».~
@32175 = ~«Проситель — это тот, кем вы станете, прибыв после своей смерти на новый План. Будучи просителем, вы забудете прошлую жизнь, посвятив себя полностью новой. И целью новой жизни является?..» — он с улыбкой ждет твоего ответа.~
@32176 = ~«Объединение с планом».~
@32177 = ~«Отвечай на свой вопрос. Даже не пробуй проверять меня».~
@32178 = ~«Не опекай меня, бездарь».~
@32179 = ~«Хорошо! Похоже, хоть часть моих слов задержалась-таки в ваших головах!» Слушатели сдавленно хихикают.~
@32180 = ~«У меня другой вопрос...»~
@32181 = ~«Слыхал что-нибудь о Грисе?»~
@32182 = ~«Это все, что я хотел узнать».~
@32183 = ~«Пф. Ну и оставайтесь тогда в невежестве».~
@32184 = ~«Что, у него был приступ?»~
@32185 = ~«У меня другой вопрос...»~
@32186 = ~«Это все, что я хотел узнать».~
@32187 = ~«Ну в прошлый раз он не вернулся».~
@32188 = ~После этих слов он чувствует себя несколько неуютно. «Что ж... да».~
@32189 = ~«Похоже, он дал дуба».~
@32190 = ~«Каким образом?»~
@32191 = ~«Ага. Как жаль, правда?»~
@32192 = ~«Что происходит, когда они умирают?»~
@32193 = ~«У меня другой вопрос...»~
@32194 = ~«Это все, что я хотел узнать».~
@32195 = ~«Потому что...»~
@32196 = ~«Почему ты все еще здесь?»~
@32197 = ~Он чувствует себя еще неуютнее. «Ну... по естественным причинам, конечно же».~
@32198 = ~«Что происходит, когда они умирают?»~
@32199 = ~«У меня другой вопрос...»~
@32200 = ~«Хм-м?»~
@32201 = ~«Это все, что я хотел узнать».~
@32202 = ~«... кто-то найдет этого пня там внизу, и мы сможем поживиться хорошими вещичками».~
@32203 = ~Он чувствует себя еще неуютнее. «Ну... объединяются с планом».~
@32204 = ~«А что если проситель умер на плане, отличного от своего домашнего плана?»~
@32205 = ~«И как они могут умереть?»~
@32206 = ~«Ха-ха! Мой карман немного ЛЕГЧЕ, чем обычно».~
@32207 = ~«У меня другой вопрос...»~
@32208 = ~«Это все, что я хотел узнать».~
@32209 = ~Он чувствует себя очень неуютно. «Э... ну, тогда *это* будет концом жизни... м-м, но просители никогда не захотят покинуть свой домашний план, дружище!» Он осознает, что попал в ловушку. «Даже если такое случится, м-м, они умрут в забвении».~
@32210 = ~«Хм-м. У меня другой вопрос...»~
@32211 = ~«Ах, да. Он был хорошим парнем, этот Грис. Очень хорошим для некоторых вещей».~
@32212 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32213 = ~Он вскидывает бровь. «Что, прошу прощения?»~
@32214 = ~«Я *сказал*, почему просители теряют свою память после смерти?»~
@32215 = ~«Учитывая новые медяки в моих карманах!»~
@32216 = ~«Забудь. У меня есть другие вопросы...»~
@32217 = ~«Неважно. У меня больше нет вопросов».~
@32218 = ~«Вы двое, не хотите сделать свою любовь вечной? Я бы мог подсобить...»~
@32219 = ~Он чувствует себя неуютно. «Э... ну, знаете ли, кто захочет таскаться с такой вещью как память?» Слушатели начинают перешептываться.~
@32220 = ~«Я хочу».~
@32221 = ~«Но *почему* они теряют свою память?»~
@32222 = ~«Хм-м. У меня другой вопрос...»~
@32223 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32224 = ~Докладчик самодовольно ухмыляется. «Глядя на вас, сэр, я не удивляюсь почему!» Слушатели хихикают.~
@32225 = ~«Так *почему* же они теряют свою память?»~
@32226 = ~«Хм-м. У меня другой вопрос...»~
@32227 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32228 = ~«Я...» — он хмурится, пытаясь что-то сказать, но останавливается. Спустя мгновение он продолжает, осторожно подбирая слова. «Я думаю, потому что вы должны начать заново: душа просителя чиста, когда прибывает на новый план».~
@32229 = ~«И почему это должно случаться, если весь твой жизненный опыт как раз и определяет, на какой план ты попадешь?»~
@32230 = ~«Никто из вас не хочет заложить свое тело?»~
@32231 = ~«Это не ответ».~
@32232 = ~«Это... отвратительно. Похоже на несмешную шутку».~
@32233 = ~«Хм-м. У меня другой вопрос...»~
@32234 = ~«О, не может быть, сборщик. Возвращайся в катакомбы».~
@32235 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32236 = ~Он чувствует себя очень неуютно. «Ну... я...» Он умолкает. «Хмм. Я не знаю».~
@32237 = ~«Это не ответ».~
@32238 = ~«Хорошо... У меня есть другой вопрос...»~
@32239 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32240 = ~Он начинает немного злиться. «А у вас есть ответ *получше*, дружище? Может быть, поделитесь им?» Зрители разом поворачиваются к тебе.~
@32241 = ~«Я не помню, откуда я это узнал, но припоминаю, что слышал, будто воспоминания дрейфуют по Астральному плану в виде 'сущности воспоминаний'».~
@32242 = ~«Нет... у меня нет».~
@32243 = ~Один из слушателей кричит: «Он прав!»

Докладчик поворачивается к нему лицом. «Э, что ж, возможно, это так. Тогда возникает вопрос: является ли жизненный путь воспоминаний важнее самой новой жизни?»~
@32244 = ~Правда: «Да, это так».~
@32245 = ~Правда: «Нет».~
@32246 = ~«Я не знаю».~
@32247 = ~Он раздраженно говорит: «Тогда все ясно: просто не умирай, дружище». Слушатели хихикают.~
@32248 = ~«Хм-м. У меня другой вопрос...»~
@32249 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32250 = ~Он делает подчеркнутый полупоклон: «Тогда задавайте!»~
@32251 = ~«Хм-м. У меня другой вопрос...»~
@32252 = ~«Я тоже так думаю. Что ж, это все, что я хотел знать».~
@32253 = ~Он усмехается. «Да, я так и *думал*, что ваш ответ будет таким».~
@32254 = ~«Хм-м. У меня другой вопрос...»~
@32255 = ~«У меня больше нет вопросов».~
@32256 = ~«Но по сравнению с жизнью, которая ждет вас на новом плане, это незначительно!»~
@32257 = ~«Но почему это должно случаться, если весь твой жизненный опыт как раз и определяет, на какой план ты попадешь?»~
@32258 = ~«Это не ответ».~
@32259 = ~«Хм-м. У меня другой вопрос...»~
@32260 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32261 = ~Он смеется. «Вздор! Все *умирают*, приятель. Даже боги смертны».~
@32262 = ~«Я не могу умереть».~
@32263 = ~«Но а если *предположить*, что кто-то не может умереть».~
@32264 = ~«Хм-м. У меня другой вопрос...»~
@32265 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32266 = ~«О, правда? Смотрите все, только здесь и сегодня: величайший бессмертный снизошел до нас своим присутствием! Приветствую тебя, о бессмертный!» Слушатели хохочут.~
@32267 = ~«Я могу доказать это».~
@32268 = ~«Забудь. У меня есть другие вопросы...»~
@32269 = ~«Неважно. У меня больше нет вопросов».~
@32270 = ~«О, докажи! Докажи!» Слушатели смеются еще громче. «Внимание! Только сейчас и только сегодня! Редчайшая наглядная демонстрация моей лекции! Подойди же сюда, о бессмертный, и мы узнаем: кто будет прав, а кто — мертв!»~
@32271 = ~Убить себя, затем восстать.~
@32272 = ~«Забудь об этом».~
@32273 = ~«Тогда, следуя моим *высказываниям*, он никогда не достигнет Внешних планов и никогда не станет просителем».~
@32274 = ~«Я не могу умереть».~
@32275 = ~«Хм-м. У меня другой вопрос...»~
@32276 = ~«Понятно. Что ж, это все, что я хотел узнать».~
@32277 = ~«Прошу прощения, я не объяснил смысл для всех слушателей: 'мировоззрение' — это ваша духовная принадлежность к добру или злу, порядку или хаосу. Мировоззрение — это способ вашего *существования*. И как следствие — способ определения назначения после вашей смерти».~
@32278 = ~«У меня другой вопрос...»~
@32279 = ~«Это все, что я хотел узнать».~
@32280 = ~Докладчик насмешливо цокает языком... некоторые из слушателей вторят ему вслед. «Просителей — бесчисленное множество, мой друг, *тленные* — всего лишь капля в море тех, кто не согласен с... 'философией' тленных».~
@32281 = ~«У меня другой вопрос...»~
@32282 = ~«Это все, что я хотел узнать».~
@32283 = ~«Что?» Докладчик захвачен врасплох. «И как я могу это сделать?»~
@32284 = ~«Умри. Сейчас. Здесь».~
@32285 = ~«Забудь. У меня есть другие вопросы...»~
@32286 = ~«Неважно. У меня больше нет вопросов».~
@32287 = ~Слушатели замолкают. Чувствуя давление, докладчик легко вздыхает. «Ну... — его неожиданно озаряет. — Если ты будешь первым, то я повторю за тобой». Слушатели тихо хихикают.~
@32288 = ~«Договорились».~
@32289 = ~«Забудь. У меня есть другие вопросы...»~
@32290 = ~«Неважно. У меня больше нет вопросов».~
@32291 = ~«Хорошо! — напряженное лицо докладчика озаряется облегчением. — Идем сюда на сцену, мой друг!» С улыбкой он поворачивается к зрителям. «Только здесь и сейчас, дорогие сигильцы! Сегодня и только сегодня вы увидите наглядную иллюстрацию того, как стать просителем».~
@32292 = ~Убить себя, затем восстать.~
@32293 = ~«Забудь об этом».~
@32294 = ~«Силы небесные!..» — с побледневшим лицом докладчик отступает назад.~
@32295 = ~«Думаю, теперь есть только один способ доказать *свою* точку зрения...»~
@32296 = ~«Твоя очередь».~
@32297 = ~Просто улыбнуться ему.~
@32298 = ~«Э...» Слушатели завороженно замерли в ожидании. «Что ж...»~
@32299 = ~«Давай, умирай. Здесь. Сейчас. Докажи, что твои слова истинны. Начни свою жизнь просителя».~
@32300 = ~Блеф: «Убей себя, или это сделаю я».~
@32301 = ~Правда: «Убей себя, или это сделаю я».~
@32302 = ~Он задыхается. «Ну... э... хм-м-м». Он слабо продолжает: «Ну, должен признать, что я еще не *совсем* готов покинуть эту жизнь».~
@32303 = ~Убить его.~
@32304 = ~Сделать угрожающий жест, остановившись на *волосок* от его шеи.~
@32305 = ~«Значит, эта прекрасная новая жизнь на Внешних планах может быть не совсем такой, как предполагается?»~
@32306 = ~«Так я и *думал*, ты, напыщенный тупоголовый шарлатан».~
@32307 = ~Докладчик отскакивает с испуганными глазами и гортанным криком... ты слышишь, как он обделался.~
@32308 = ~«Значит, эта прекрасная новая жизнь на Внешних планах может быть не совсем такой, как предполагается?»~
@32309 = ~«Так я и *думал*, ты, напыщенный тупоголовый шарлатан».~
@32310 = ~Докладчик боится своего притворства, однако альтернатива страшит его еще больше. «Пожалуй, нет, — он быстро оглядывается на слушателей, — Э... ну, определенно не *сейчас*».~
@32311 = ~«Так я и думал. У меня другой вопрос...»~
@32312 = ~«Так я и думал. У меня больше нет вопросов».~
@32313 = ~«Э... да». Докладчик похож на пугало, он полностью побежден. «Хм-м-м. Да».~
@32314 = ~«У меня другой вопрос...»~
@32315 = ~«У меня больше нет вопросов».~
@32316 = ~«Разве ты о ней не слышал, о пустоголовый? О войне между баатезу и танарри? Столетий не хватит на то, чтобы описать этот конфликт. Поищи кого-нибудь другого, эта лекция не об этом».~
@32317 = ~«У меня другой вопрос...»~
@32318 = ~«У меня больше нет вопросов».~
@32319 = ~«О? О каком?»~
@32320 = ~«О Бездне...»~
@32321 = ~«О Бааторе...»~
@32322 = ~«О Карцери...»~
@32323 = ~«О Небесной горе...»~
@32324 = ~«Неважно. У меня есть другой вопрос...»~
@32325 = ~«Забудь. У меня больше нет вопросов».~
@32326 = ~«Это план, состоящий из шести сотен слоев терзающего хаоса и зла. Дом демонических танарри! — он делает театральный жест. — Но вам следует поискать более сведущего в планах, нежели я».~
@32327 = ~«У меня другой вопрос...»~
@32328 = ~«У меня больше нет вопросов».~
@32329 = ~«План законопослушного зла, поделенный на девять частей. — прищелкнув языком, он делает театральный жест. — Дом демонических баатезу! Только подпишите с ними договор, и тут же окажетесь в цепях их интриг на всю жизнь!» Он улыбается. «Но вам следует поискать более сведущего в планах, нежели я».~
@32330 = ~«У меня другой вопрос...»~
@32331 = ~«У меня больше нет вопросов».~
@32332 = ~«Тюремный план, холодный, грубый и окрашенный в красное. Предатели и лжецы находят там свое пристанище... говорят, там были заключены Титаны, сброшенные с Олимпа!» Он делает театральный жест. «Но вам следует поискать более сведущего в планах, нежели я».~
@32333 = ~«У меня другой вопрос...»~
@32334 = ~«У меня больше нет вопросов».~
@32335 = ~«Небесная гора, план вечного добра и согласия. — он хлопает в ладони, вознося песнь. — Где дэва парят в небесах, а благородные архоны правят справедливо... идеал доброты!» Он улыбается. «Но вам следует поискать более сведущего в планах, нежели я».~
@32336 = ~«У меня другой вопрос...»~
@32337 = ~«У меня больше нет вопросов».~
@32338 = ~«...тогда завершим выступление на этот раз. Я продолжу свои чтения в Зале, и, возможно, спустя несколько лет... я встречу *вас* в качестве просителя по ту сторону Смерти!»~
@32339 = ~Прекратить слушать, уйти.~
@32340 = ~Похоже, ему не терпится закончить. «...тогда завершим выступление... м-м, я продолжу свои чтения здесь, в Зале, так что... э... расскажите об этом своим друзьям».~
@32341 = ~Прекратить слушать, уйти.~
@32342 = ~Похоже, ему не терпится закончить. «...тогда завершим выступление... м-м, я продолжу свои чтения здесь, в Зале, так что... э... расскажите об этом своим друзьям».~
@32343 = ~Прекратить слушать, уйти.~
@32344 = ~Кто-то выкрикивает с места: «Непременно! Тогда они точно увидят, как тебя опять изваляют в грязи!» Комната наполняется смехом...~
@32345 = ~«Э... хм-м».~
@32346 = ~Уйти.~
@32347 = ~~
@32348 = ~~
@32349 = ~~
@32350 = ~~
@32351 = ~~
@32352 = ~~
@32353 = ~~
@32354 = ~~
@32355 = ~~
@32356 = ~~
@32357 = ~~
@32358 = ~~
@32359 = ~~
@32360 = ~~
@32361 = ~~
@32362 = ~~
@32363 = ~~
@32364 = ~~
@32365 = ~~
@32366 = ~~
@32367 = ~«'Тайнах'?! Секундочку! Мы же не собираемся *слушать* этого пустомелю? Да ладно... пойдем лучше найдем парочку цыпочек-чувствующих, которые еще ни разу не пробовали пламенной страсти от прикосновения губ черепа». Он в предвкушении водит бровями.~
@32368 = ~«Тише, Морт. Мы подождем... по крайней мере немного».~
@32369 = ~Не обращать внимания на Морта, продолжать слушать.~
@32370 = ~«Ты прав, Морт, идем отсюда».~
@32371 = ~Шепот Морта: «Начало новых страданий».~
@32372 = ~Молча кивнуть Морту.~
@32373 = ~«Морт, помолчи».~
@32374 = ~Не обращать внимания на Морта, продолжать слушать.~
@32375 = ~«Точно. Пошли отсюда, Морт».~
@32376 = ~Шепот Морта: «Ага, как же».~
@32377 = ~Молча кивнуть Морту.~
@32378 = ~«Морт, тише».~
@32379 = ~Не обращать внимания на Морта, продолжать слушать.~
@32380 = ~«Точно. Пошли отсюда, Морт».~
@32381 = ~Шепот Морта: «И бесконечной скуки».~
@32382 = ~Молча кивнуть Морту.~
@32383 = ~«Морт, пожалуйста, тише».~
@32384 = ~Не обращать внимания на Морта, продолжать слушать.~
@32385 = ~«Точно. Пошли отсюда, Морт».~
@32386 = ~Шепот Морта: «Кажется, теперь мы оба знаем, куда отправимся после смерти».~
@32387 = ~Молча кивнуть Морту.~
@32388 = ~«Морт, хватит болтать».~
@32389 = ~Не обращать внимания на Морта, продолжать слушать.~
@32390 = ~«Точно. Пошли отсюда, Морт».~
@32391 = ~Шепот Морта: «Это если только повезет».~
@32392 = ~Молча кивнуть Морту.~
@32393 = ~«Хватит, Морт».~
@32394 = ~Не обращать внимания на Морта, продолжать слушать.~
@32395 = ~«Точно. Пошли отсюда, Морт».~
@32396 = ~Шепот Морта: «И это типа стимул? Чтобы вляпаться в это *опять*? Ха, не могу дождаться, когда я снова стану летающим черепом. Ура! Забей на этого неудачника. Походу, он еще сам никогда не умирал, верно?»~
@32397 = ~Молча кивнуть Морту.~
@32398 = ~«Хватит, Морт. Тише».~
@32399 = ~Не обращать внимания на Морта, продолжать слушать.~
@32400 = ~«Точно. Пошли отсюда, Морт».~
@32401 = ~Шепот Морта: «А, еще один дешевый лозунг».~
@32402 = ~Молча кивнуть Морту.~
@32403 = ~«Морт, помолчи».~
@32404 = ~Не обращать внимания на Морта, продолжать слушать.~
@32405 = ~«Точно. Пошли отсюда, Морт».~
@32406 = ~Морт громко кричит: «Что за фигня!»~
@32407 = ~Морт, увильнув от взгляда докладчика, поворачивается к тебе и шепотом произносит: «Давай, шеф. Задай ему жару по этому поводу».~
@32408 = ~«Да, у меня есть вопрос...»~
@32409 = ~«Вопросов нет. Мой приятель ошибся».~
@32410 = ~«Отлично! Еще одна смерть! Подпишите меня!» Среди слушателей раздается хохот. Докладчик выглядит сердитым.~
@32411 = ~«Что происходит, когда они умирают?»~
@32412 = ~«У меня есть другие вопросы...»~
@32413 = ~«Это все, что я хотел узнать».~
@32414 = ~«Что, работу ищешь? У меня для тебя есть дельце... при условии, что ты не прочь повозиться со жмуриками».~
@32415 = ~«Сколько тебе еще осталось?»~
@32416 = ~«Я не собираюсь уходить отсюда без звенелок...»~
@32417 = ~«Хм-м... Убедись, что давление не слишком высокое».~
@32418 = ~«Смотри, не обожгись!»~
@32419 = ~«Как идет работа?»~
@32420 = ~«Неплохо».~
@32421 = ~«Осторожно».~
@32422 = ~«Убедись, что ты делаешь это правильно».~
@32423 = ~«Как все продвигается?»~
@32424 = ~«Осведомитель! Осведомитель!»~
@32425 = ~«Осведомитель! Узнайте куда идти всего за один медяк!»~
@32426 = ~«Какие планы на завтра?»~
@32427 = ~«Вычеркни это из моего списка».~
@32428 = ~«Что там дальше у меня по списку?»~
@32429 = ~«Я должен убедиться, что у нас достаточно сырья».~
@32430 = ~«Мне нужно узнать, когда придет следующая смена».~
@32431 = ~Охранять~
@32432 = ~Деревенский головорез~
@32433 = ~Деревенский головорез~
@32434 = ~Посреди коридора из мрака в материализуется призрачная фигура, которая быстро преграждает тебе путь. Она парит над землей, некогда человеческие черты лица искажены гневом. «Осквернители! Убирайтесь отсюда! Сейчас же!»~
@32435 = ~Внезапно воздух вокруг становиться ледяным. Перед тобой снова предстает Призрачный Страж. Он парит к тебе, его призрачная мантия развевается на неосязаемом ветру.~
@32436 = ~«Убирайтесь немедля!» Его гулкий голос эхом разноситься по коридорам. «Это место запрещено для всех живых. Уходите, пока еще в силах».~
@32437 = ~«Какая дерзость!» От оглушающего вопля призрака ты непроизвольно закрываешь уши. «Вас предупреждали... Я больше не позволю вам тревожить покой этого священного места».~
@32438 = ~«Ищи свои ответы где-нибудь еще. Это место — прибежище для мертвых. И я не позволю еще одному нахальному смертному нарушать их покой!»~
@32439 = ~«Раз уж ты спрашиваешь... да, сюда проник еще один непрошеный гость, который до сих пор оскверняет эти священные залы». Гнев в голосе призрака утихает. Очевидно, мысль об этом его весьма огорчает. «Души моих братьев и сестер молят о спокойствии».~
@32440 = ~«Это трусливый злодей, который обладает исключительной властью над умершими. Он что-то здесь ищет... но что это и для чего это ему понадобилось, мне не известно».~
@32441 = ~«Я не могу. Этот трус забаррикадировался во внутренних покоях Мавзолея. Он создал сильные охраняющие чары, которые не позволяют мне попасть внутрь. Оттуда при помощи своей черной магии он пробуждает моих братьев от забвения и подчиняет их своей злодейской воле».~
@32442 = ~В течении нескольких продолжительных мгновений призрак не произносит ни слова. Ты почти ощущаешь вес его безжизненного взора. «Да... ты бы мог преуспеть там, где я оказался бессилен. Если ты пообещаешь расправиться с этим негодяем, я дозволю тебе пройти. Твое слово?»~
@32443 = ~«Быть посему». Призрак медленно растворяется в воздухе, оставляя лишь бестелесное эхо своего голоса. «Но будь осторожен... ступай тихо в этих залах, если не хочешь присоединиться к вечному покою других».~
@32444 = ~«Приветствую».~
@32445 = ~Быстро уйти.~
@32446 = ~«Постой, дух. У меня есть несколько вопросов...»~
@32447 = ~«Постой, дух. Я хочу помочь избавиться от твоего непрошеного гостя».~
@32448 = ~«Неважно. Прощай».~
@32449 = ~«Сперва я бы хотел задать пару вопросов...»~
@32450 = ~«Я хожу, где мне вздумается... прочь с дороги, дух».~
@32451 = ~«Как пожелаешь. Прощай».~
@32452 = ~«Больше не позволишь? Здесь был еще кто-то?»~
@32453 = ~«Ну-ну. Иди-ка ты лучше детишек попугай».~
@32454 = ~«Хотя, если подумать... Лучше я, пожалуй, пойду. Прощай».~
@32455 = ~«Еще одному? Здесь был еще кто-то?»~
@32456 = ~«Я хожу, где мне вздумается... прочь с дороги, дух».~
@32457 = ~«Как пожелаешь. Прощай».~
@32458 = ~«Кто этот непрошеный гость?»~
@32459 = ~«Почему же ты не выдворишь его отсюда?»~
@32460 = ~«Хотя, если подумать... Лучше я, пожалуй, пойду. Прощай».~
@32461 = ~«Почему же ты не выдворишь его отсюда?»~
@32462 = ~«Хотя, если подумать... Лучше я, пожалуй, пойду. Прощай».~
@32463 = ~«Возможно, я смогу помочь тебе...»~
@32464 = ~«Похоже, тебе нужна помощь одного непрошеного гостя, чтобы избавиться от другого».~
@32465 = ~«Хотя, если подумать... Лучше я, пожалуй, пойду. Прощай».~
@32466 = ~«Я сделаю это».~
@32467 = ~«Хотя, если подумать... Лучше я, пожалуй, пойду. Прощай».~
@32468 = ~Едва ты ты ступаешь в коридор, как перед тобой материализуется Призрачный Страж. Его призрачное лицо с благодарностью обращено к тебе. «Спасибо тебе. Ты оказал мне огромную услугу. Мои братья вновь могут покойно отдыхать. Ступай с миром... друг». Призрак растворяется в воздухе. Ты остаешься один в заброшенных залах Мавзолея.~
@32469 = ~Уйти.~
@32470 = ~Перед тобой мужчина среднего роста в длинной, иссиня черной мантии. Аккуратно прибранные волосы и элегантно подстриженная бородка подчеркивают его красивое лицо. Заметив твое присутствие, он прекращает писать, откладывает в сторону книгу и с улыбкой уверенно шагает к тебе. «Впечатляюще... Должен признать, я не думал, что ты доберешься так далеко».~
@32471 = ~«Кто я такой — для тебя не имеет значения. Что мне нужно — вот что тебя должно беспокоить в первую очередь», — говорит он, зачарованно осматривая тебя с ног до головы.~
@32472 = ~Он делает шаг назад, вскинув бровь. «Мне нужна... твоя кровь».~
@32473 = ~Едва начав отвечать, мужчина внезапно умолкает. На его лице возникает дьявольская улыбка, и он начинает хохотать. «Да... можно и так сказать». Он хохочет над своей, известной только ему шутке, все громче и громче. Ты замечаешь, что его руки приходят в движение: он медленно машет ими вперед и назад, оставляя в воздухе замысловатые узоры.~
@32474 = ~«Правда? Ну что ж, тогда приложи к этому все усилия». Самодовольно улыбаясь, он поднимает руки перед собой. Он медленно машет ими вперед и назад, оставляя в воздухе замысловатые узоры.~
@32475 = ~«Боюсь, что ты никуда не пойдешь». Самодовольно улыбаясь, он поднимает руки перед собой. Он медленно машет ими вперед и назад, оставляя в воздухе замысловатые узоры.~
@32476 = ~«Рад, что обманул твои ожидания... так это ты источник всех этих ходячих мертвецов?»~
@32477 = ~«Глупый некромант! Я пришел сюда, чтобы прекратить твое осквернение этого места».~
@32478 = ~«Прошу прощения за беспокойство. Прощай».~
@32479 = ~«Хорошо... и что тебе нужно?»~
@32480 = ~«Ты ошибаешься. Что тебе нужно — меня *не интересует*... Я здесь, чтобы убить тебя».~
@32481 = ~«Неважно. Я должен идти».~
@32482 = ~«Это что-то типа угрозы?»~
@32483 = ~«Какое совпадение... Я тоже пришел за твоей кровью. Приготовься к смерти!»~
@32484 = ~«Э-э... Меня это не интересует. Прощай».~
@32485 = ~Атаковать.~
@32486 = ~Истинная Тень~
@32487 = ~Куу Йин~
@32488 = ~Радин~
@32489 = ~Юхир~
@32490 = ~Головорез Мусорных районов~
@32491 = ~«Что за грязная тварь породила *тебя* на свет, братец? — она строит гримасу отвращения, затем хрипло хохочет. — И что за вонь! Ты один из мертвых ублюдков?» Ты замечаешь изогнутый кинжал на ее бедре; ее рука свободно держится за эфес.~
@32492 = ~«Что за грязная тварь породила *тебя* на свет, братец? — она строит гримасу отвращения, затем хрипло хохочет. — И что за вонь! Ты один из мертвых ублюдков?» Ты замечаешь изогнутый кинжал на ее бедре; ее рука свободно держится за эфес.~
@32493 = ~«О, на *это* стоит посмотреть. Скажи-ка, 'братец', это не ты смердишь, как сточная канава Улья? Или это сточная канава смердит как *ты*?»~
@32494 = ~Женщина удивленно моргает.~
@32495 = ~Она медленно обводит тебя взглядом, затем улыбается. «Кажется, твои тяжелые раны повредили тебе рассудок, братец, — девушка хохочет. — Я не твоя подруга, и никогда не стану причислять себя к таким как ты».~
@32496 = ~Некоторое время она недоуменно слушает тебя, затем с рычанием выхватывает свое оружие.~
@32497 = ~Она задыхается от потрясения. «Идиот... ты с ума сошел? Стража скорее поверит мне, чем тебе!»~
@32498 = ~Она злобно смотрит на тебя, скрежеща зубами. «Надейся, что в следующий раз мы больше не встретимся, *пес*!» Она отворачиваться и стремительно уходит.~
@32499 = ~Она пялится на тебя, скаля зубы. «Тогда забудем об этом и разойдемся в разные стороны».~
@32500 = ~«О, конечно же. Но сперва, — она выдерживает паузу, ее губы сжимаются в кривой улыбке, — один вопрос: удастся ли хоть кому-то за свою жизнь стать таким же уродливым, как ты?»~
@32501 = ~Секунду она изумленно пялится на тебя, после чего рычит и выхватывает кинжал...~
@32502 = ~«Не поворачивайся ко мне спиной, пес. Твое присутствие на этой улице глубоко меня оскорбило. Ты должен искупить свою вину, — она выставляет одну ногу вперед. — Вылижи мой сапог, избавь меня от своего присутствия — и будешь прощен».~
@32503 = ~Ты уже собираешься уходить, когда она рычит и выхватывает кинжал...~
@32504 = ~Ее пронзительный хохот, злорадный и насмешливый, эхом прокатывается по улицам. «А теперь пошел вон, трус. Осмелишься заговорить со мной еще раз — и мой клинок проткнет тебе сердце прежде, чем твои слова достигнут моих ушей».~
@32505 = ~«Свиньи! — визжит она. — Я вас обоих уничтожу!»~
@32506 = ~Когда ты склоняешься перед девушкой, она кладет руки на бедра и откидывает голову. Ее пронзительный хохот, злорадный и насмешливый, эхом прокатывается по улицам.~
@32507 = ~Ты пытаешься схватить ее... но она ловко уклоняется от твоей хватки. «Ты заплатишь за это *жизнью*, пес!» Она начинает вынимать кинжал...~
@32508 = ~Ты хватаешь ее за ноги и вгрызаешься зубами в икру. Она верещит от боли, отскакивает от тебя и выхватывает свой кинжал: похоже, твой укус быстро привел ее в себя. «Великие Силы, ты что, *СПЯТИЛ*?!»~
@32509 = ~Она заметно вздрагивает, смесь разочарования и отвращения ползет по ее лицу. «Тьфу! Глаза бы мои тебя не видели! Тварь...» Она разворачивается, чтобы уйти.~
@32510 = ~Ты хватаешь ее за лодыжки и изо всех сил тянешь на себя. На какое-то мгновение она зависает в воздухе с широко раскрытым в виде буквы «О» ртом, а затем падает на землю с болезненным *стуком*. Она тут же вскакивает на ноги, с дикими от бешенства глазами. «Я *убью* тебя!» Она выхватывает кинжал...~
@32511 = ~«Дела хуже *некуда*, братец, — она морщится от отвращения. — Меня буквально начинает тошнить от одного твоего вида».~
@32512 = ~«О, нет-нет... Я никогда не стану такой как ты, братец. Лишь *немногие* люди на обед едят собственные фекалии».~
@32513 = ~«Я думаю, братец, правильным будет вопрос 'что здесь так *воняет*'? — она нюхает воздух, затем с отвращением морщит нос. — Ой, так это же ты! Точно, ты, протухший труп!»~
@32514 = ~«Что за грязная тварь породила *тебя* на свет, братец? — она строит гримасу отвращения, затем хрипло хохочет. — И что за вонь! Ты один из мертвых ублюдков?» Ты замечаешь изогнутый кинжал на ее бедре; ее рука свободно держится за эфес...~
@32515 = ~Девушка на миг смущается, затем узнает Падшую Грацию. Похоже, она ошеломлена и сконфужена. «Госпожа Грация! Я вас и не заметила... стыдно признавать это, ибо ваш благородный вид очевиден даже для тупиц».~
@32516 = ~Она пристыжена. «Да, госпожа... Я сожалею, что подобные слова были сказаны в вашем присутствии».~
@32517 = ~«Э... — она хмурится, затем к ней снова возвращается самообладание. — В любом случае, что заставило вас покинуть заведение, госпожа? Какие-то дела?»~
@32518 = ~Сархава низко кланяется. «Тогда позвольте мне раскланяться в извинениях, госпожа Грация, перед вами и вашими спутниками. Мои слова были необдуманны. Выпивка заставила меня нести вздор; и я переполнена стыдом за низость, в которой я предстала в глазах своего давнего учителя». Она кланяется, разворачивается и уходит.~
@32519 = ~«Так-так... кто это у нас? Маленький тифлинг, королева трущоб, выползшая из Улья? — девушка надувает губы, будто разговаривая с ребенком. — Ты потерялась, крошка? О, гляньте! У нее есть хвостик! Как... мило!»~
@32520 = ~«Ну, бесенок, не балуй». Похоже, девушку не особенно заботит то, что Анна выхватила оружие, она продолжает оскорбительно сюсюкаться: «Поосторожней там, а то еще оторву твой хвостик и скормлю его своим собакам».~
@32521 = ~«Ты грязное отродье Нижних планов, ублюдочная мразь, которую даже танарри не станут держать своих клетках!» Она выхватывает кинжал.~
@32522 = ~«А *это* еще что такое?! Гит? Так *далеко* от бурлящей помойной ямы Лимбо, сортира всех планов?» Она сужает глаза, ожидая ответа Даккона.~
@32523 = ~Она хмурится. «Я думала, гит, твоему сброду гораздо приятнее находится дома, среди плотоядных жаб, резвящихся в супе Лимбо».~
@32524 = ~Она ждет ответа, затем продолжает дразнить Даккона: «Почему бы тебе не вернуться в Лимбо, гит? — она задумывается на мгновение, поглаживая свой подбородок. — Или твои сородичи живут в Астральном плане? Я вас все время путаю — гитьянки, гитцераи, кто вас разберет...»~
@32525 = ~Неожиданно девушка улыбается. «О! Расскажи мне шутку, гит! — она радостно хлопает в ладоши. — Озари меня знаменитым чувством юмора твоей расы, *гитьянки*!»~
@32526 = ~Она презрительно ухмыляется Даккону. «А когда я наткнулась на тебя на улицах Сигила, гит, молодая Сархава глянула на грязного гита и сказала 'тут даже спорить не о чем'. Ты всего лишь безбожный пес *гитьянки*, который порочно поклоняется ублюдкам своей расы и спит с лягушками, — она сжимает рукоять кинжала. — Доставай свой хрупкий кусок металла, грязный гит».~
@32527 = ~Она ждет, но Даккон остается безмолвен. «Надеюсь, мозгососы все еще держат вас в рабстве, гит, так что мультивселенная может не бояться того, что ваша раса размножится».~
@32528 = ~Даккон стоит безмолвно словно камень. Девушка рычит, готовая наброситься на него. «Тогда катись в Баатор, трус!»~
@32529 = ~Застигнутая врасплох, девушка не отвечает.~
@32530 = ~«Что... да как ты...»~
@32531 = ~«Я... я...»~
@32532 = ~Девушка выхватывает клинок и, рыча как разъяренный зверь, кидается на Морта.~
@32533 = ~Девушка отказывается с тобой говорить.~
@32534 = ~Девушка жестоко скалится и выставляет вперед ступню своей ноги. «Снова пришел лизнуть мой сапог, пес? Так вот, не выйдет! Разве я тебе не приказала со мной не говорить? Пошел вон, пока я не обнажила сталь».~
@32535 = ~Сархава приветствует тебя кивком, но не говорит с тобой.~
@32536 = ~«Приветствую...»~
@32537 = ~«Приветствую...»~
@32538 = ~«Приветствую...»~
@32539 = ~«Приветствую...»~
@32540 = ~Держаться от женщины подальше.~
@32541 = ~«*Что* ты сказала, девчонка?»~
@32542 = ~Блеф: «Адана? Это ты?»~
@32543 = ~«В чем дело?»~
@32544 = ~«Мне не до споров с тобой. Оставь меня в покое и ступай своей дорогой».~
@32545 = ~Атаковать ее.~
@32546 = ~Не обращать внимания на нее и уйти.~
@32547 = ~«*Что* ты сказала, девчонка?»~
@32548 = ~Блеф: «Адана? Это ты?»~
@32549 = ~«В чем дело?»~
@32550 = ~«Мне не до споров с тобой. Оставь меня в покое и ступай своей дорогой».~
@32551 = ~Атаковать ее.~
@32552 = ~Не обращать внимания на нее и уйти.~
@32553 = ~«Адана? Разве ты меня не помнишь?»~
@32554 = ~«Я же сказал тебе, Адана: я никогда тебя не любил и никогда не полюблю. Каким бы ни было наслаждение, которое ты мне дала, она не стоит страданий твоей близости. А теперь оставь меня».~
@32555 = ~«О... прошу прощения. Мне показалось, что ты Адана, но ты в два раза уродливее и воняешь в два раза хуже, чем она».~
@32556 = ~«Неважно. Прощай».~
@32557 = ~«О... прошу прощения. Мне показалось, что ты Адана, но ты в два раза уродливее и воняешь в два раза хуже, чем она».~
@32558 = ~«Неважно. Прощай».~
@32559 = ~Драться с ней.~
@32560 = ~Позвать стражников.~
@32561 = ~«Ты пьяна, а шрамы говорят о том, что ты не прочь подраться... наверное, у тебя и репутация соответствующая. Так что они вполне могут поверить».~
@32562 = ~«Ты пьяна, а шрамы говорят о том, что ты не прочь подраться. Так что они вполне могут поверить».~
@32563 = ~«О, надеюсь, что *да*...»~
@32564 = ~Зевнуть ей вслед, будто от скуки.~
@32565 = ~«Прощай».~
@32566 = ~«Согласен, ты и так уже много моего времени потратила. Прощай».~
@32567 = ~«Согласен. Прощай».~
@32568 = ~«Да... Ты тому подтверждение».~
@32569 = ~Атаковать ее.~
@32570 = ~Уйти.~
@32571 = ~Драться с ней.~
@32572 = ~Позвать стражников.~
@32573 = ~Склониться и облизать ее сапог.~
@32574 = ~Склониться и облизать ее сапог.~
@32575 = ~Склониться и облизать ее сапог.~
@32576 = ~Склониться к ее сапогу, дождаться возможности застать ее врасплох.~
@32577 = ~Атаковать ее.~
@32578 = ~Игнорировать ее угрозы и уйти.~
@32579 = ~Драться с ней.~
@32580 = ~Позвать стражников.~
@32581 = ~«Ну все, мне это надоело. Посмотрим, как ты владеешь своим маленьким ножичком, девчонка».~
@32582 = ~Уйти.~
@32583 = ~Откусить от ее оголенной ноги кусок.~
@32584 = ~Откусить от ее оголенной ноги кусок.~
@32585 = ~Схватить ее за ноги и с силой дернуть.~
@32586 = ~Схватить ее за ноги и с силой дернуть.~
@32587 = ~Просто облизать ее сапог.~
@32588 = ~Драться с ней.~
@32589 = ~Позвать стражников.~
@32590 = ~Улыбнуться ей, слизать кровь с губ.~
@32591 = ~«Сегодня я сапог лизать не буду, девчонка. А теперь ступай, пока я не начал откусывать от тебя куски побольше».~
@32592 = ~Просто пройти мимо.~
@32593 = ~Издать чавкающие звуки ей вслед.~
@32594 = ~Издать чавкающие звуки ей вслед.~
@32595 = ~«Прощай».~
@32596 = ~«Прощай».~
@32597 = ~Дать ей спокойно уйти.~
@32598 = ~Дать ей спокойно уйти.~
@32599 = ~Драться с ней.~
@32600 = ~Позвать стражников.~
@32601 = ~«Разве это сказала не твоя мамаша, когда родила тебя на свет?»~
@32602 = ~«Я бы на твоем месте ушел, девочка, пока ты не закончила как я».~
@32603 = ~Атаковать ее.~
@32604 = ~Не обращать внимания на нее и уйти.~
@32605 = ~«Открой свой рот еще раз, девчонка, и я позабочусь о том, чтобы у тебя появился к нему аппетит».~
@32606 = ~«Если бы мне понадобились фекалии, я бы выжал твою голову, девчонка».~
@32607 = ~Атаковать ее.~
@32608 = ~Не обращать внимания на нее и уйти.~
@32609 = ~Блеф: «Стой... Я вспомнил тебя. Адана!»~
@32610 = ~Блеф: «Стой... Я вспомнил тебя. Адана!»~
@32611 = ~«В чем дело?»~
@32612 = ~«Мне не до споров с тобой. Оставь меня в покое и ступай своей дорогой».~
@32613 = ~Атаковать ее.~
@32614 = ~Не обращать внимания на нее и уйти.~
@32615 = ~«Очевидно, девочка, твой уровень — ниже тупицы».~
@32616 = ~Позволить Грации продолжить разговор.~
@32617 = ~Уйти.~
@32618 = ~«Довольно, девчонка. Извинись перед ней, или я начну отрезать куски от *тебя*».~
@32619 = ~«Довольно, девчонка. Извинись перед ней, или я начну отрезать куски от *тебя*».~
@32620 = ~Позволить Анне с этим разобраться.~
@32621 = ~«Идем, Анна. Она того не стоит».~
@32622 = ~«Вложи в ножны клинок, девчонка, или я вложу его в твое тело».~
@32623 = ~«Вложи в ножны клинок, девчонка, или я вложу его в твое тело».~
@32624 = ~Позвать стражников.~
@32625 = ~Пусть все идет своим чередом.~
@32626 = ~«Возможно, *ты* почувствуешь себя дома в Морге, девчонка».~
@32627 = ~«Возможно, *ты* почувствуешь себя дома в Морге, девчонка».~
@32628 = ~Позволить Даккону с этим разобраться.~
@32629 = ~Продолжить.~
@32630 = ~«Этого более чем достаточно, девчонка. Замолчи».~
@32631 = ~«Этого более чем достаточно, девчонка. Замолчи».~
@32632 = ~Атаковать ее самому.~
@32633 = ~«Атакуй ее, Даккон».~
@32634 = ~Ждать реакции Даккона.~
@32635 = ~«Этого более чем достаточно, девчонка. Замолчи».~
@32636 = ~«Этого более чем достаточно, девчонка. Замолчи».~
@32637 = ~Атаковать ее самому.~
@32638 = ~«Атакуй ее, Даккон».~
@32639 = ~Ждать реакции Даккона.~
@32640 = ~Помочь Даккону сражаться с ней.~
@32641 = ~Позвать стражников.~
@32642 = ~Пусть все идет своим чередом.~
@32643 = ~Помочь Морту драться с ней.~
@32644 = ~Позвать стражников.~
@32645 = ~Пусть все идет своим чередом.~
@32646 = ~Уйти.~
@32647 = ~«Ты мне надоела, девчонка... доставай клинок».~
@32648 = ~Остаться и драться с ней.~
@32649 = ~Уйти.~
@32650 = ~Уйти.~
@32651 = ~«Хочешь, я отшлепаю эту пустоголовую цыпочку, шеф?»~
@32652 = ~«Обожаю твои пустоголовые приемчики, шеф».~
@32653 = ~Когда ты становишься на колени перед женщиной, Морт кричит: «Шеф! Ты шутишь надо мной! То есть, я хочу сказать, ты же не будешь *этого* делать...»~
@32654 = ~«В этом есть что-то... но все же...»~
@32655 = ~Морт сдавленно смеется и щелкает зубами. «Просто обычный дамский угодник, а, шеф?»~
@32656 = ~«Ой-ой...»~
@32657 = ~Морт подмигивает тебе и кричит девушке: «Эй, ты! Да-да, ты, маленькая дерзкая грубиянка... смотреть на меня, когда я с тобой разговариваю! Чего это ты такая кислая, а?»~
@32658 = ~«Ааа, наверное, штаны у Пустынной принцессы от того, что султан хотел себе сыночка? Скажи-ка мне, 'принцесса Пустыни', ты так все ночи проводишь, за выпивкой и в драках, в окружении кучи хитрых подхалимов? Наверное, ты так пытаешься оправдать свое существование перед разочарованным отцом?»~
@32659 = ~«Ты что, вправду думаешь, что от твоих мелких скандальчиков ты станешь о себе лучшего мнения? Думаешь, ты чего-то *стоишь*? А ВОТ И НЕТ! И если тебе, бедняжка, стало легче от того, кто ты *на самом деле*, то я посоветую тебе сдаться, вернуться домой, выйти замуж и податься в какой-нибудь придворный гарем!»~
@32660 = ~Морт поворачивается к тебе. «Видишь, шеф, я *знаю*, как это все обычно случается. *Всем* известно, что Морт прав в данном вопросе. О нет, только не это, бедная маленькая Пустынная принцесса, оскорбленная, униженн...»~
@32661 = ~«И никакого милосердия, Морт».~
@32662 = ~«Нет, Морт... Я справлюсь с этим».~
@32663 = ~Не обращать внимания на Морта, вылизать сапог девушки.~
@32664 = ~«Просто я не хочу никаких неприятностей, Морт. Если мы будем не осторожны, то я смогу позвать стражу».~
@32665 = ~«Ты прав, Морт. Идем».~
@32666 = ~«Забудь, Морт. Послушайте, мадам... Давайте прекратим это, пока я не позвал стражу».~
@32667 = ~«Ты прав, Морт. Пошли отсюда».~
@32668 = ~Когда ты становишься на колени перед женщиной, Анна яростно сплевывает. «Ты же это *несерьезно*! Прирежь эту шлюху, недоумок! Дай-ка, я сама это сделаю...»~
@32669 = ~Ты прикрываешь собой женщину. Анна потрясенно смотрит на тебя. «Да... ты... совсем *рехнулся*?»~
@32670 = ~Анна делает кислое выражение лица и плюет девушке под ноги. Довольно неожиданно, но та не отвечает атакой. «Блевотина, вот что это такое... блевотина». Она продолжает что-то ворчать про себя. Ты успеваешь только разобрать слова «вялый» и «корешок».~
@32671 = ~Анна яростно смотрит на Грацию и Сархаву.~
@32672 = ~Анна багровеет, клинки выскакивают из ее кулаков.~
@32673 = ~«Да у тебя острый язычок, девчушка». Анна сплевывает и затачивает лезвия друг о друга. «Интересно, насколько мило будут выглядеть твои дешевые стекляшки и блядские шмотки, когда ты будешь дохлая валяться на улице!»~
@32674 = ~«Анна, стой!»~
@32675 = ~«За один медяк — по всем направлением! Осведомитель!»~
@32676 = ~«*Неееет!*»~
@32677 = ~«Я убью тебя, обещаю!»~
@32678 = ~«Я до тебя еще доберусь!»~
@32679 = ~«Я тебе сердце вырежу, мудила!»~
@32680 = ~«Ты у меня кровью харкать будешь!»~
@32681 = ~«Хм-м-м...»~
@32682 = ~«Псст... сюда».~
@32683 = ~«Молча стены повторяют пророчества хаоса».~
@32684 = ~«Начертаны предзнаменования на стенах словами».~
@32685 = ~«Я? Откуда мне знать, что это не ТЫ сделал, четвероногая куча дерьма!»~
@32686 = ~«Так-так-так...»~
@32687 = ~«Ну что, снял с того пня немного меди?»~
@32688 = ~«Кто ты?»~
@32689 = ~«Анна, стой!»~
@32690 = ~Встать между Анной и девушкой.~
@32691 = ~Присоединиться к Анне и напасть на девушку.~
@32692 = ~Позволить Анне закончить.~
@32693 = ~«Это не Улей, Анна... мы не можем просто так кидаться в бой по любой прихоти. Если мы не будем соблюдать осторожность, то позовут стражу».~
@32694 = ~«Ладно, Анна. Просто уйдем».~
@32695 = ~«Послушайте, мадам... нам не нужны неприятности. Давайте прекратим это, пока я сам не позвал стражу».~
@32696 = ~«Ладно, Анна. Просто уйдем».~
@32697 = ~«Сархава? Сархава Вджул, это ты?»~
@32698 = ~Грация едва заметно кивает. «Твоя речь весьма и весьма изыскана, в отличие от только что услышанного мной».~
@32699 = ~«Я сожалею, что они вообще были произнесены». Ее тон почти не изменился, однако похоже, что утонченное замечание прошлось по лицу девушки как плетка. «Очень больно видеть, что моя бывшая ученица ведет себя так...»~
@32700 = ~«Это мои спутники, с которыми я путешествую. Я бы хотела, чтобы ты была с ними так же вежлива, как и со мной. Это знак отличия и обязанность... благородных от рождения».~
@32701 = ~Продолжить.~
@32702 = ~Продолжить.~
@32703 = ~Даккон даже не подает виду, что обратил внимания на девушку. Он просто смотрит вперед.~
@32704 = ~От Даккона по-прежнему нет ответа. Для него девушка словно не существует.~
@32705 = ~Неожиданно Даккон начинает говорить глубоким баритоном, словно читая нотации малому ребенку. «Когда Зертимон вступил на Глинистую равнину, и гитцераи пересеклись с людьми, он сказал, что они достойны восхищения в своих достижениях, однако им будет гораздо труднее бороться с собственным невежеством...»~
@32706 = ~Даккон продолжает свою «шутку»: «Как и все люди, сказал Зертимон, они говорят много, а делают мало, и потому их пример представляет собой опасность. Человечество — это ночной кошмар во плоти, угроза без настоящей истории, неспособная учиться на своих ошибках».~
@32707 = ~Прекратить слушать, уйти.~
@32708 = ~Неожиданно мужчина окидывает публику взглядом своих черных глаз, как будто что-то ищет. «И еще: если среди вас есть танарри или баатезу, то попрошу убрать за дверь свои чешуйчатые бока. Я не позволю вашему мерзкому брату сидеть здесь, а потом слушать ваши бредовые возражения...»~
@32709 = ~Продолжать слушать.~
@32710 = ~Прекратить слушать, уйти.~
@32711 = ~«...потому что тут мы не выясняем, кто прав на самом деле». Позади себя ты слышишь, как нечто массивное покидает лекционный зал. «Это будет просто рассказ о Кровавой войне с человечьей точки зрения. Не будет выгораживания какой-либо из сторон, потому что они *все* в этом по-своему замешаны».~
@32712 = ~Продолжать слушать.~
@32713 = ~Прекратить слушать, уйти.~
@32714 = ~Лектор мрачнеет. «Так вот... оставшиеся из вас хотят послушать пару историй о Кровавой войне... байки о *войне*. Как пить дать, хотите послушать об *ужасах* войны. О летающих крепостях, сплетенных из человеческой кожи! О полях боя размером с планы, где велась Кровавая война!»~
@32715 = ~Продолжать слушать.~
@32716 = ~Продолжать слушать.~
@32717 = ~Прекратить слушать, уйти.~
@32718 = ~Он обнажает пожелтевшие зубы: «Байки о нечисти, которая впивается клыками в другую нечисть! Грар! Ррар-р-р-р!» Его рык стихает, и он выглядит неожиданно скучающим.~
@32719 = ~Продолжать слушать.~
@32720 = ~Прекратить слушать, уйти.~
@32721 = ~«Что ж, дайте-ка, я раскрою вам глаза и сломаю ваши костяные коробки: задерживаться на этом дерьме мы не будем — это все вонючая куча бредятины». Он насмешливо сплевывает, бешено вращая глазами.~
@32722 = ~Продолжать слушать.~
@32723 = ~Прекратить слушать, уйти.~
@32724 = ~«Скажу вам только *вот* что: вы и *представить* себе не можете масштабы Кровавой войны. Ничто из того, что вы слышали, видели, в чем участвовали — *ничто* с ней не сравнится: продолжительность, число 'легионов', размах кровопролития... ничто с ней не сравнится, пни. Пытаться ее представить — и думать забудьте. Хотите совет? Все просто: держитесь подальше от этого большого кровавого месива».~
@32725 = ~Продолжать слушать.~
@32726 = ~Прекратить слушать, уйти.~
@32727 = ~«Вот все, что вам нужно знать: нечистые мочат нечистых. Баатезу рубят танарри, танарри кромсают баатезу. Прямо сейчас, — он снова сплевывает. — И никто не побеждает. Не думаю, что хоть кто-то *может* победить. Величайший тупик по эту сторону вечности... и слава силам за это».~
@32728 = ~Продолжать слушать.~
@32729 = ~Прекратить слушать, уйти.~
@32730 = ~«Это все, — он пожимает плечами. — Это все. Теперь я отвечу на любые ваши вопросы...»~
@32731 = ~Задать вопрос.~
@32732 = ~Продолжать молчать.~
@32733 = ~«Хорошо... тогда вот еще что напоследок. Кой-кто из вас — чувствующие, так что скажу вам вот еще что: не подписывайтесь на то, чтобы увидеть эту чертову Кровавую войну такой, какой она есть. Не будьте сбрендившими идиотами. Если хочется прочувствовать ее — пользуйтесь камнями переживаний, но держитесь чертовски далеко от всего, связанного с реальной Кровавой войной».~
@32734 = ~Продолжать слушать.~
@32735 = ~Прекратить слушать, уйти.~
@32736 = ~«Оно того не стоит. Это... — на миг лицо его перекашивается от сильной боли; он, казалось бы, готов разрыдаться. — ...не стоит того, и точка. На том и закончим, так что бывайте здоровы».~
@32737 = ~Уйти.~
@32738 = ~«Что у тебя за вопрос, рубака?»~
@32739 = ~«Можешь рассказать чуть побольше о самой Кровавой войне?»~
@32740 = ~«Из-за чего развязалась Кровавая война?»~
@32741 = ~«Как можно наняться на Кровавую войну?»~
@32742 = ~«Где проходили сражения Кровавой войны?»~
@32743 = ~«Как выжить в Кровавой войне?»~
@32744 = ~«Опиши танарри».~
@32745 = ~«Опиши баатезу».~
@32746 = ~«Значит, о самой Кровавой войне ты нам ничего не расскажешь?»~
@32747 = ~«Хочешь знать, как выжить в Кровавой войне? Три правила, рубака...» Он поднимает покалеченную руку, на которой только два пальца.~
@32748 = ~«Продолжай...»~
@32749 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32750 = ~«Вообще-то, неважно. Вопросов больше нет».~
@32751 = ~«Во-первых, держись от нее подальше. Во-вторых, держись от нее как можно далеко. И наконец... держись от нее дальше всего».~
@32752 = ~«Продолжай...»~
@32753 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32754 = ~«Вообще-то, неважно. Вопросов больше нет».~
@32755 = ~«Если тебе придется хоть каким-то боком столкнуться с войной, дай себе воображаемый пинок под зад и беги что есть мочи. Если бежать ты не можешь — лежи, *не дыша*, и молись, чтоб она прошла мимо, — некоторое время он молчит. — Вот только нет места, куда бы она не дошла, и тебе почти-что некуда от нее бежать».~
@32756 = ~«Если бежать некуда, то почему нечистые не воюют в Сигиле?»~
@32757 = ~«Что-нибудь еще?»~
@32758 = ~«Позволь мне спросить еще кое о чем...»~
@32759 = ~«У меня больше нет вопросов».~
@32760 = ~«Да: ни под каким предлогом не *говори* о на эту тему *ни с кем* из нечисти... или с дэва и архонами. Просто не говори о ней — и точка: никогда не знаешь, с кем, черт подери, ты треплешься на самом деле. Все они немерено обижаются, когда речь заходит о войне. Это же смысл их жизни».~
@32761 = ~«Что-нибудь еще?»~
@32762 = ~«Позволь мне спросить еще кое о чем...»~
@32763 = ~«У меня больше нет вопросов».~
@32764 = ~Он кивает. «Не лезь в порталы, если только не знаешь чертовски точно, куда они ведут. Ты, может статься, и не слыхал историй о бестолковых гуляках по планам, которые зашли в портал и попали прямиком в гущу битвы Кровавой войны. Знаешь, почему ты о них не слышал? Потому что эти бедолаги сдохли, сдохли, *сдохли*».~
@32765 = ~«Что-нибудь еще?»~
@32766 = ~Бросить ее.~
@32767 = ~«Позволь мне спросить еще кое о чем...»~
@32768 = ~«У меня больше нет вопросов».~
@32769 = ~«И ни в коем случае не подписывайся на службу, неважно, сколько там звенелок они тебе покажут. Верная смерть и запись на службу в Кровавой войне — одно и тоже, рубака».~
@32770 = ~«Это еще почему?»~
@32771 = ~«Позволь мне спросить еще кое о чем...»~
@32772 = ~«У меня больше нет вопросов».~
@32773 = ~«Скорей всего, когда ты подпишешься, они обставят все так, что служба твоя будет длиться до тех пор, пока время не сотрется в порошок. Даже смерть тебя не освободит: тебя затянут Нижние планы, и ты станешь похуже, чем был до того. А потом они вцепятся в тебя когтями на веки вечные».~
@32774 = ~«Как же тебе удалось *уйти* со службы?»~
@32775 = ~«Значит, умереть в Кровавой войне было бы особенно плохой штукой?»~
@32776 = ~«Позволь мне спросить еще кое о чем...»~
@32777 = ~«У меня больше нет вопросов».~
@32778 = ~«Если ты злой — по-любому. Если добрый, попадешь на другой план, и там начнется твоя загробная жизнь. И все же ты будешь жмуриком. Что до меня, то я еще не избавился от всей злобы в своей душе, так что если б я помер на Нижних планах — был бы я их с потрохами».~
@32779 = ~«Когда ты умираешь, то переходишь на другой план? Как ты можешь это объяснить?»~
@32780 = ~«Как же тебе удалось *уйти* со службы?»~
@32781 = ~«Позволь мне спросить еще кое о чем...»~
@32782 = ~«У меня больше нет вопросов».~
@32783 = ~«Если хочешь разузнать об этом, сходи поговори с тем другим лектором, что толкует о смерти. Не могу я объяснить это так же складно, как и он, хотя он и дважды дурень, и может ошпарить тебя жаром из своей пасти».~
@32784 = ~«Как же тебе удалось *уйти* со службы?»~
@32785 = ~«Позволь мне спросить еще кое о чем...»~
@32786 = ~«У меня больше нет вопросов».~
@32787 = ~Глазное яблоко~
@32788 = ~«Да брось, рубака, слушай: они тут бились... уже несколько раз. Порой нам немного достается от Кровавой войны. Наша Леди Боли, хвала ее стальному сердцу, гасит этот пожар...»~
@32789 = ~«Продолжай...»~
@32790 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32791 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32792 = ~«*Временами*... — ухмыляется он. — Бывали ужасные времена, такие-чертовски-страшные-что-аж-мочишься-в-штаны времена, когда они громили, жгли, продирались сквозь целые сигильские кварталы, пока она наконец не решалась убраться в доме, — он цокает языком и цинично подмигивает. — Так что она не всегда так уже рвется остановить Кровавую войну, как это может показаться, сечешь?»~
@32793 = ~«Почему нечистые просто не взяли Сигил?»~
@32794 = ~«Позволь мне спросить еще кое о чем...»~
@32795 = ~Увеличительная линза~
@32796 = ~Шлем~
@32797 = ~Татуировка~
@32798 = ~Грудь~
@32799 = ~Зубы~
@32800 = ~Палец~
@32801 = ~Рука~
@32802 = ~Запястье~
@32803 = ~Арбалет~
@32804 = ~Арбалетная стрела~
@32805 = ~«У меня больше нет вопросов».~
@32806 = ~Он начинает смеяться, но смех его переходит в мокрый кашель. «Пойми меня правильно: Сигил нужен и танарри, и баатезу, еще как нужен. Это же ценнейший плацдарм во всей чертовой мультивселенной: Клетка — это ведь Город Дверей, ведущих *куда угодно*. Ты не можешь сбрасывать это со счетов, и если участвуешь в Кровавой войне и хочешь победить — ты *должен* захватить его».~
@32807 = ~«Продолжай...»~
@32808 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32809 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32810 = ~Мужчина снова кашляет. «Просто нечистые не собираются *захватывать* его, пока при власти Леди, вот и все. Она тверда как камень, ее ножи искромсают тебя похлеще, чем клыки любого нечистого. А от этого бесовские стручки в узел скручивает, да так, что ты и представить себе не можешь. Одной единственной безмолвной Леди с руками, спрятанными в рукавах, достаточно, чтобы в одиночку сдерживать натиск Кровавой войны». Он горько смеется.~
@32811 = ~«Но ведь нечистых все же допускают в Сигил?»~
@32812 = ~«Позволь мне спросить еще кое о чем...»~
@32813 = ~«У меня больше нет вопросов».~
@32814 = ~«О, чертовски верно. На улицах им не дозволено буянить... больше меры. Сигил, в качестве нейтральной территории, позволяет им трясти своими черепушками, не пытаясь замочить друг дружку. Иногда они здесь треплются. Вот только такой мир долго не подержится...»~
@32815 = ~«Продолжай...»~
@32816 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32817 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32818 = ~«К тому же, то, что они не могут кромсать друг друга на улицах, вовсе не означает, что они не могут тут шпионить, вербовать и строить козни. Здесь они воюют словами, пень. Порой доходит до угроз. Еще здесь есть их убежища. Места, где они могут дать остыть своим когтям перед следующей стычкой...»~
@32819 = ~«Продолжай...»~
@32820 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32821 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32822 = ~«И еще они любят тут вербовать. Ищут новичков с планов с тягой к наживе в сердце, которых они могут сделать частью своей славной армии, — он останавливается, чтобы рассмотреть тебя поближе. — Быть может, они и тебя когда-то завербовали, а, рубака? Ты, похоже, знаком с Войной не понаслышке».~
@32823 = ~«Сомневаюсь».~
@32824 = ~«Может быть».~
@32825 = ~«Сомневаюсь».~
@32826 = ~Главные ворота Морга~
@32827 = ~Главный зал~
@32828 = ~Лестница на второй этаж~
@32829 = ~Северо-западный Мемориальный зал~
@32830 = ~Центральная комната~
@32831 = ~Лестница на второй этаж~
@32832 = ~Юго-восточный Мемориальный зал~
@32833 = ~Юго-западная препараторская~
@32834 = ~Вход в Мавзолей~
@32835 = ~Лестница~
@32836 = ~Приемная~
@32837 = ~Северо-восточная препараторская~
@32838 = ~Лестница~
@32839 = ~Юго-восточная препараторская~
@32840 = ~Южная кладовая~
@32841 = ~Лестница на второй этаж~
@32842 = ~Северная кладовая~
@32843 = ~Крематорий~
@32844 = ~Лестница на второй этаж~
@32845 = ~Вниз в подвал борделя~
@32846 = ~Покои Ив~
@32847 = ~Покои Кимаскси~
@32848 = ~Покои Долоры~
@32849 = ~Покои Кесай-Серри~
@32850 = ~Покои Мариссы~
@32851 = ~Во внутреннее помещение~
@32852 = ~Покои Вивьен~
@32853 = ~Покои Экко~
@32854 = ~Головорез Мусорных районов~
@32855 = ~Цельный хрустальный резервуар с несколькими рыбками, застывшими внутри.~
@32856 = ~Воздух, гулко выходящий из этой колоссальной печи, нестерпимо горяч. Еще несколько шагов в сторону арки — и твои волосы и кожа загорятся.~
@32857 = ~Правая серьга~
@32858 = ~Кастет~
@32859 = ~Медяки~
@32860 = ~Долговая расписка~
@32861 = ~Укус тропотоки~
@32862 = ~Кулак зомби, слабый (удар)~
@32863 = ~Предмет +1 к невосприимчивости~
@32864 = ~Серьга анархиста #1~
@32865 = ~Серьга анархиста #2~
@32866 = ~Серьга анархиста #3~
@32867 = ~Дневник Страгана~
@32868 = ~Ключ Пристанища~
@32869 = ~Серповидный топор~
@32870 = ~Это невидимое оружие, которым пользуется тропотока. Оно причиняет 2-16 очков рубящего урона.~
@32871 = ~КЛЮЧ ПРИСТАНИЩА
Вес: 0

Этот обыкновенный маленький ключ изготовлен из кованого железа и, похоже, не имеет какой-то особой ценности.~
@32872 = ~Это невидимое дробящее оружие для крепких созданий 4-6 уровня.~
@32873 = ~Это невидимое дробящее оружие для средних созданий 1-3 уровня.~
@32874 = ~Это невидимое дробящее оружие для средних созданий 7-9 уровня.~
@32875 = ~Это невидимое дробящее оружие для средних созданий 10-13 уровня.~
@32876 = ~Это невидимое колющее оружие для средних созданий 1-3 уровня.~
@32877 = ~Это невидимое колющее оружие для средних созданий 4-6 уровня.~
@32878 = ~Это невидимое колющее оружие для средних созданий 7-9 уровня.~
@32879 = ~Это невидимое колющее оружие для средних созданий 10-13 уровня.~
@32880 = ~Это невидимое рубящее оружие для средних созданий 1-3 уровня.~
@32881 = ~Это невидимое рубящее оружие для средних созданий 4-6 уровня.~
@32882 = ~ДНЕВНИК СТРАГАНА
Вес: 1

Эта книга в кожаном переплете потрескалась и износилась со временем. На обложке выжжено нечто вроде герба. Ты можешь разобрать ряды переплетенных треугольников, окружающих инициалы СТ. Записи на страницах заметно потускнели, однако последние несколько заметок, кажется, сделаны недавно.

День 2-й 127-го года правления фрактола Хашкара:

Наконец-то я нашел ее! Теперь я владею пропавшей страницей гримуара Ап-Таржа. Как я и предполагал, в ней описаны компоненты, необходимые для создания конечного заклинания превращения. У меня есть все, кроме одного компонента. Капля крови бессмертного — вот все, что стоит между мной и вечным могуществом лича. Но где же мне найти такую диковинку? Возможно, ответ следует искать в прорицаниях.

День 14-й 127-го года правления фрактола Хашкара:

Спустя дни утомительных порицательных заклинаний, я, наконец, нашел ответы. Прорицание открыло, что бессмертный находится где-то в древнем мавзолее, расположенном в сигильском Улье. Нужно поторопиться. Нужно найти это создание и взять его кровь, пока оно не скрылось.

День 15-й 127-го года правления фрактола Хашкара:

Я прибыл в Мавзолей. И тут же был атакован тенью, сторожившей захороненные в этом месте останки. Мне удалось ускользнуть от духа и пробраться в что-то типа внутреннего святилища. Защитившись несколькими малыми заклятьями опеки, дабы предотвратить дальнейшие задержки из-за сверхъестественных придурков, я потрудился поднять нескольких местных, чтобы они помогли в поисках бессмертного. Если прорицание было точным и бессмертный здесь, то он, вероятно, захоронен в одном из множества склепов, окружающих эти помещения. Теперь это всего лишь дело времени.

День 17-й 127-го года правления фрактола Хашкара:

Я не одинок. Кто-то вошел в мавзолей и столкнулся с моими слугами. Не его ли я ищу? Прорицание показало лишь то, что я найду бессмертного здесь. Быть может, МОЕ присутствие в этом месте побудило того, кого я ищу, на поиски МЕНЯ? Что за приятный поворот событий, я должен

Чернила этой записи все еще не высохли.~
@32883 = ~РЖАВЫЙ КИНЖАЛ
Урон: 1-3 колющий
Особенности: хрупкий, может сломаться
Скорость: 2
Вес: 1
Специализация: клинковые
Не используется жрецами

Это небольшой ржавый кинжал. Его лезвие сколото, а рукоятка болтается; вряд ли он выдержит постоянное использование, не сломавшись при этом.~
@32884 = ~«Может быть».~
@32885 = ~«Возможно. Позволь мне спросить кое о чем еще...»~
@32886 = ~«Возможно. В таком случае, у меня больше нет вопросов».~
@32887 = ~«Война оставляет на тебе шрамы, рубака. Уж ты бы *знал*. Ты бы знал, что *никогда* не захочешь вернуться туда».~
@32888 = ~«А они часто берут наемников?»~
@32889 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32890 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32891 = ~Он мрачно кивает. «В этом можешь быть уверен. Сигил — лучший источник мяса на всех планах. Могу поспорить, что прочесывать Первичные планеты в поисках их обитателей... слишком уж хлопотно».~
@32892 = ~«Итак, будут еще советы, как выжить на Войне?»~
@32893 = ~«Позволь мне спросить еще кое о чем...»~
@32894 = ~«У меня больше нет вопросов».~
@32895 = ~«Если только ты им не нужен, шансов у тебя немного. Никогда не слышал, чтобы такое проделывали подлые наемники или кто-то, кого они реально хотят удержать в своих когтях. Перехитрить танарри рискованно, но возможно... баатезу со своими договорами намного опасней. Подпишись под таким — и будешь проклят на всю жизнь...»~
@32896 = ~«Продолжай...»~
@32897 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32898 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32899 = ~«Можно попробовать подмазать, попробовать кинуть их, и они могут позволить тебе сбежать... но куда ты подашься? Вокруг одни преисподние...»~
@32900 = ~«И умереть на Кровавой войне было бы *особенно* плохой штукой?»~
@32901 = ~«Итак, как же ты сбежал с Кровавой войны?»~
@32902 = ~«Позволь мне спросить еще кое о чем...»~
@32903 = ~«У меня больше нет вопросов».~
@32904 = ~«Если коротко: Кровавая война уже идет черт-знает-сколько, и продолжится, пока этот черт-знает-сколько не попадет самолично в книгу мертвых. Танарри, сторонники *хаоса* и зла, пытаются выбить зеленое дерьмо из баатезу, сторонников *порядка* и зла. Они кромсают друг друга из-за разных взглядов на то, каким *должно* быть зло. Ха!»~
@32905 = ~«Что, по-твоему, случилось бы, если бы кто-то остановил Кровавую войну?»~
@32906 = ~«Позволь мне спросить еще кое о чем...»~
@32907 = ~«У меня больше нет вопросов».~
@32908 = ~«Да ты ни черта не смыслишь в войне! Она черт-знает-какая *большая*. Ты камешек, песчинка в океане, который сам — песчинка в другом океане, а тот — песчинка в еще одном океане, и так далее, аж до прихода вонючей каровы. Твоя цель как песчинки — чтоб тебя не заметили и не затянули на дно вместе с другими отбросами...»~
@32909 = ~«Продолжай...»~
@32910 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32911 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32912 = ~«Даже если б ты мог чем-то помочь — а ведь ты *ничем* не поможешь, — тебе не следует даже *пробовать*, ведь тогда обрушатся сами планы».~
@32913 = ~«Обрушатся сами планы? Почему?»~
@32914 = ~«Позволь мне спросить еще кое о чем...»~
@32915 = ~«У меня больше нет вопросов».~
@32916 = ~Он поднимает руки как колонны. «Кровавая война — что-то типа здоровенной кровавой балки, подпирающей планы... выбей ее — и обрушится куча планов. Война несет на себе много багажа, — внезапно он вскрикивает, как осел, и горько смеется. — Это самое большое и грязное вьючное животное на планах...»~
@32917 = ~«Продолжай...»~
@32918 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32919 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32920 = ~Он цинично усмехается. «Да и кроме этого, как кто-то сказал, войны *хороши* для бизнеса, — он глухо смеется, затем принимает такой вид, будто готов вот-вот расплакаться. — А... не бери в голову... еще вопросы?»~
@32921 = ~«Ты в порядке? Кажется, ты чем-то огорчен...»~
@32922 = ~«Да, у меня еще один вопрос...»~
@32923 = ~«Нет, больше вопросов нет».~
@32924 = ~Мужчина печально усмехается. «Да-да... послушай-ка, рубака: я не жрец, да и не хотел бы им быть, но учти вот что: не допускай зла в свое сердце. Коли помрешь со злобой в сердце, душа твоя попадет на Нижние планы, и там ты станешь просителем...»~
@32925 = ~«Продолжай...»~
@32926 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32927 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32928 = ~«Знаешь, что происходит потом? В Бездне и Бааторе просителей превращают в пехоту... их заставляют сражаться на Кровавой войне целую вечность, — он посмеивается, качая головой. — Вот в этом-то и весь секрет того, почему баатезу и танарри пытаются испортить все, до чего могут дотянуться: им нужно больше воинов. Вот тебе мой совет: не допускай зла в свое сердце, пень».~
@32929 = ~«Позволь мне спросить еще кое о чем...»~
@32930 = ~«У меня больше нет вопросов».~
@32931 = ~«Ну, ладно, дай объясню тебе, что для них значит 'мясо'. Они собирают вместе кучку подлых наемников-смертных — парочку миллионов, например. Затем дают им порубить друг друга без особого резона в какой-нибудь бессмысленной битве за какой-то забытый силами клочок земли. Угадай, куда уйдут *все* эти души?»~
@32932 = ~«Куда?»~
@32933 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32934 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32935 = ~«Их души попадают на план зла, за который они сражались, и там их вырывают из планарного бульона и снова возвращают в бой в качестве лемуров, манов или еще каких-то чертовых уродов, которыми становятся эти бесовские кучки дерьма. Чем больше этих чертовых просителей они получают, тем больше у них войск».~
@32936 = ~«Позволь мне спросить еще кое о чем...»~
@32937 = ~«У меня больше нет вопросов».~
@32938 = ~«Ты прав, что сразу интересуешься, кто заварил эту чертову старую кашу: что заставило нечистых скрестить рога, кусать и царапать друг дружку, что, если ни единственная причина их существования...»~
@32939 = ~«Продолжай...»~
@32940 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32941 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32942 = ~«Все просто: они повстречались, — вздыхает он. — Однажды танарри и баатезу наткнулись друг на друга, как два поддатых фанатика, и начали драться. Вот так просто, — он нахмуривается. — Ну...»~
@32943 = ~«Продолжай...»~
@32944 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32945 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32946 = ~«Не, забей: представь двух наклюканных *жрецов*, каждый из которых считает, что *только* он знает как жить. А теперь покрой этих жрецов чешуей, когтями и рогами, чтоб от них воняло на три лиги, и посади их в такую вот малюпусенькую чертову камеру... вот теперь ты хорошо себе представляешь, какая у них будет любовь. И вот тебе, пожалуйста! Начало Кровавой войны».~
@32947 = ~«Зачем двум *злым* расам сражаться между собой?»~
@32948 = ~«Позволь мне спросить еще кое о чем...»~
@32949 = ~«У меня больше нет вопросов».~
@32950 = ~«Одни считают, что зло должно быть педантичным и упорядоченным. Другие считают, что зло должно быть хаосом, неистово несущимся по планам. Все они — зло, только это еще не значит, что они по всем пунктам согласны. Вражда, вражда... каждый из них хочет уничтожить другого, чтоб остался только его 'сорт' зла. Они ненавидят друг друга, как... как...»~
@32951 = ~«Продолжай...»~
@32952 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32953 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32954 = ~Мужчина кивает. «Обычно они не платят столько, сколько танарри, но они не нарушают своих письменных соглашений. Однако, они умные — в тысячу *тысяч* раз умнее танарри, а договора они заключают с самого начала времен. Знают они, как облапошить с помощью слов, это уж точно. Подпишись — и, скорей всего, останешься в их легионах на века...»~
@32955 = ~«Продолжай...»~
@32956 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@32957 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@32958 = ~«Они строят планы как чертовы ублюдки. В продумывание и подготовку одного стратегически важного сражения они вкладывают больше усилий, чем большинство человеческих армий — во всю военную кампанию, — он фыркает и чешет подбородок. — По обыкновению они собирают свои войска на Авернусе, первом слое Баатора».~
@32959 = ~«На что похож Авернус?»~
@32960 = ~«Какой он, Авернус?»~
@32961 = ~«Какие виды войск участвуют в Кровавой войне?»~
@32962 = ~«Позволь мне спросить еще кое о чем...»~
@32963 = ~«У меня больше нет вопросов».~
@32964 = ~«Авернус? Пф... — мужчина кривится, будто воспоминания об этом месте вызывает у него физическую боль. — Там живут проклятые и те, кто на них охотится. Земля в красных прожилках, с ядовитыми песками и палящим огнем, который ревет над просторами. Таким я запомнил Авернус, слой Баатора. Ужасное местечко».~
@32965 = ~«Какие виды войск участвуют в Кровавой войне?»~
@32966 = ~«Позволь мне спросить еще кое о чем...»~
@32967 = ~«У меня больше нет вопросов».~
@32968 = ~«Все виды, не считая разных мертвых пней со всех планов. Абишаи и корнугоны, лемуры и нупперибо, суккубы... перечислять можно еще долго».~
@32969 = ~«Расскажи мне об абишаях».~
@32970 = ~«Расскажи мне о корнугонах».~
@32971 = ~«Расскажи мне о лемурах».~
@32972 = ~«Расскажи мне о нупперибо».~
@32973 = ~«Расскажи мне о суккубах».~
@32974 = ~«Расскажи мне о суккубах».~
@32975 = ~«Позволь мне спросить еще кое о чем...»~
@32976 = ~«У меня больше нет вопросов».~
@32977 = ~«Они рядовые в большинстве армий баатезу. Разные они бывают, и те, что с черной чешуей, — самые распространенные и самые слабые».~
@32978 = ~«Какие еще виды войск участвуют в Кровавой войне?»~
@32979 = ~«Позволь мне спросить еще кое о чем...»~
@32980 = ~«У меня больше нет вопросов».~
@32981 = ~«Корнугоны *чертовски* крутые, рубака. Нечасто встретишь больше, чем по одному, хотя временами они собираются в элитные пешие отряды. Обычно они ведут в бой более слабые силы, типа абишаев и наемников-смертных».~
@32982 = ~«Какие еще виды войск участвуют в Кровавой войне?»~
@32983 = ~«Позволь мне спросить еще кое о чем...»~
@32984 = ~«У меня больше нет вопросов».~
@32985 = ~«Лемуры — это такие... штуки... с виду как расплавленные люди. Мелкие надоедливые сволочи, умеют восстанавливаться, даже когда мочишь их. Им плевать на опасность и боль, так что они никогда не бегут с поля боя. В основном годятся на то, чтобы дохнуть в первых рядах, не более того».~
@32986 = ~«Какие еще виды войск участвуют в Кровавой войне?»~
@32987 = ~«Позволь мне спросить еще кое о чем...»~
@32988 = ~«У меня больше нет вопросов».~
@32989 = ~«Маленькие жирные засранцы с вот такими вот ма-аленькими головешками. Глухие, слепые и тупые, и нужны, чтобы дохнуть на передовой. Вот только непросто их замочить... даже самый мелкий кусочек может вырасти до целой твари, если ему позволить».~
@32990 = ~«Какие еще виды войск участвуют в Кровавой войне?»~
@32991 = ~«Позволь мне спросить еще кое о чем...»~
@32992 = ~«У меня больше нет вопросов».~
@32993 = ~«Танарри, красивые, да вот только смертельно злые. Они соблазняют смертных и затягивают их в Бездну, — он кивает Падшей Грации. — Без обид, сударыня».~
@32994 = ~Не обращать внимания на сборщика, пройти мимо.~
@32995 = ~«Я так не думаю...»~
@32996 = ~Подавить воспоминание.~
@32997 = ~«Танарри, красивые, да вот только смертельно злые. Они соблазняют смертных и затягивают их в Бездну... чем больше просителей — тем больше пушечного мяса для войны».~
@32998 = ~«Какие еще виды войск участвуют в Кровавой войне?»~
@32999 = ~«Позволь мне спросить еще кое о чем...»~
@33000 = ~«У меня больше нет вопросов».~
@33001 = ~«Да много где... *обычно* — на Нижних планах. Вдоль реки Стикс... в девяти слоях Баатора, в четырех печах Геенны, в Серой пустоши, в холодном красном Карцери — тюремном плане, и чертовом бездонном колодце с нечистью — и в Бездне». Почему-то Серая пустошь звучит для тебя знакомо...~
@33002 = ~«Расскажи мне о Серой пустоши».~
@33003 = ~«Позволь мне спросить еще кое о чем...»~
@33004 = ~«У меня больше нет вопросов».~
@33005 = ~«Еще она зовется 'Сумраками', — он пожимает плечами, затем вздрагивает, будто по привычке. — Серая во всех смыслах. Цвета там жгут тебе глаза; она кричит, кричит слишком громко, а твои мечты притягиваются и поглощаются землей, теряются навсегда. Там правят только ночные ведьмы... Серые леди пустоши».~
@33006 = ~«Позволь мне спросить еще кое о чем...»~
@33007 = ~«У меня больше нет вопросов».~
@33008 = ~Мужчина кивает. «Танарри платят лучше, чем баатезу, вот только неплохо бы тебе запастись двумя или тремя головами, и еще кучей глаз по всему телу: не стоит поворачиваться к ним спиной. Они — хаос, с теми еще тараканами в голове. Доверие и умение держать слово у них не в почете...»~
@33009 = ~«Продолжай...»~
@33010 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@33011 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@33012 = ~Он шмыгает носом, затем пожимает плечами. «Да им все равно, что происходит, лишь бы *что-нибудь* происходило, и это связано со злом. По большей части они нападают на баатезу, лишь бы не перебить друг друга».~
@33013 = ~«Позволь мне спросить еще кое о чем...»~
@33014 = ~«У меня больше нет вопросов».~
@33015 = ~«Знаешь, сюда всегда приходит какой-нибудь тупоголовый пень и спрашивает насчет работы на Кровавой войне. Хочет пару звенелок, хочет быструю работенку, а потом зажить счастливо. Быть может, и я был одним из этих недоумков. Быть может, и я был наемником, который услышал, что на этой войне можно срубить немного звенелок. Это заинтересовало меня...»~
@33016 = ~«Продолжай...»~
@33017 = ~«Постой... Позволь мне спросить кое о чем еще...»~
@33018 = ~«Ладно, неважно. У меня больше нет вопросов...»~
@33019 = ~«Это все меня вот чему научило: мы похожи на муравьев, которые хороводы водят вокруг пяток чертовых танцующих богов. Я видел больших парней, которые кричали, что они крутые солдаты... — он качает головой. — *Бумажные* солдаты. Войны для них — как *топка*. Они либо очнутся, либо *сгорят*».~
@33020 = ~«Как же ты выжил в Кровавой войне?»~
@33021 = ~«Позволь мне спросить еще кое о чем...»~
@33022 = ~«У меня больше нет вопросов».~
@33023 = ~Он заламывает руки, пытаясь подобрать правильные слова. «Видишь ли, они ненавидят не так как *мы*. Да мы понятия не имеем, что *значит* ненависть. У нас одно, *одно* слово для ненависти. У них... — он понижает тон. — Тысячи тысяч, их значения перемешивают и сваливают в кучу как... трупы. *Вот* почему они дерутся».~
@33024 = ~«Позволь мне спросить еще кое о чем...»~
@33025 = ~«У меня больше нет вопросов».~
@33026 = ~Лицо мужчины мрачнеет. «Я... ну, это как раз то, о чем бы я не хотел трепаться, рубака. Достаточно будет сказать, что приходится делать всякое, лишь бы сбежать с Войны».~
@33027 = ~«В таком случае, позволь мне спросить кое о чем еще...»~
@33028 = ~«Тогда у меня больше нет вопросов».~
@33029 = ~«Война оставляет на тебе шрамы, рубака. Ты бы *знал*. Ты бы знал, что *никогда* не захочешь возвратиться туда». Когда ты обдумываешь его слова, твои виски начинают болезненно пульсировать... на поверхность всплывают воспоминания...~
@33030 = ~Попытаться вспомнить.~
@33031 = ~Попытаться вспомнить.~
@33032 = ~Попытаться вспомнить.~
@33033 = ~Текущее мировоззрение:~
@33034 = ~Проиграть ролики~
@33035 = ~«Рубака? Тебе там не поплохело, случаем?»~
@33036 = ~Лекционный зал начинает меркнуть, и в твоей голове появляется кошмарное видение... Видение места, где времена года несравнимы с любыми из тех, которые ты видел и о которых слышал. Места, где молитвы остаются неуслышанными, падая на землю как камни... Где голубоватые молнии вспыхивают там, где когда-то было небо. Но теперь оно бурлит под твоими ногами и ревет от малейшего прикосновения...~
@33037 = ~Ты бежишь во главе большого отряда людей через темные каньоны, где стены влажно колышутся и пульсируют словно сердце, и одеждой тебе служит лишь твоя собственная кровь. Наконец вы попадаете в место, где пепельно-серая местность извивается как клубок змей, обвиваясь вокруг твоих лодыжек и нашептывая твою злобу земле. Вы движетесь бесшумно, без остановок, через эту бесцветную землю, где усталость, казалось, *ожила*, и охотится за тобой, как тень над пустошью, хлеща тебя отчаяньем...~
@33038 = ~[no text]~
@33039 = ~Со временем ты со следующими за тобой оборванцами подходишь к ведьме, которая восседает на куче гигантских извивающихся личинок и ковыряется в одной из этих покрытых слизью штук сломанным когтем. Ты указываешь одному из своих людей подбежать и поговорить с ней; скрипучий голос ведьмы доносится до твоих ушей...~
@33040 = ~Ветеран Голодных Псов~
@33041 = ~~
@33042 = ~Едва ты входишь, как к тебе приближается сборщик средних лет, одетый в лохмотья. «Я... — хмыкнув, он быстро тебя оглядывает, — тебя не знаю».~
@33043 = ~Сборщик продолжает пялиться на тебя.~
@33044 = ~«Приветствую».~
@33045 = ~Меня не колышет, чего ты там ищешь, пень, — он сплевывает. — Что меня колышет, так это то, что ты все еще дышишь в моем присутствии».~
@33046 = ~Едва завидев твое приближение, сборщик с отвращением окидывает тебя взглядом. «Больше никаких слов, рубака. Сейчас ты поймешь, что здесь они ничего не стоят». Он достает из кармана нож: «Боюсь, что только твое тело имеет здесь цену».~
@33047 = ~«Как по мне, пень, проблема в том... что ты все еще дышишь в моем присутствии». Он сплевывает.~
@33048 = ~Уходя, ты замечаешь, что сборщик достает нож из кармана. «Не знаю, чего ты думал, когда шел сюда, рубака, но единственное место, куда ты теперь попадешь — это Морг».~
@33049 = ~«Не могу сказать, что и я тебя знаю».~
@33050 = ~«Я просто проходил мимо».~
@33051 = ~Не обращать внимания на сборщика, пройти мимо.~
@33052 = ~«Тебе не встречался где-нибудь поблизости дневник?»~
@33053 = ~«Я разыскиваю мужчину по имени Фарод».~
@33054 = ~«Какие-то проблемы?»~
@33055 = ~Не обращать внимания на сборщика, пройти мимо.~
@33056 = ~«Я буду говорить с ним, — сказала она и захихикала. Глаза ее мерцают, когда она указывает мужчине на тебя. — С красавчиком, ведущим вашу колонну оборванцев. Я буду говорить с ним...» И это все, что ты можешь вспомнить.~
@33057 = ~У этого коренастого сутулого старика по-прежнему широкие плечи и ошрамованные мозолистые руки работника или воина. Аура усталого разочарования, казалось бы, нависает над ним. Похоже, в данный момент он читает лекцию.~
@33058 = ~«Если ты меня не пропустишь, сборщик, то один из нас попадет в Морг, и это точно буду не я».~
@33059 = ~Лицо Гизиса мрачнеет. «Отвали! Больше я тебе и слова об этом не скажу!»~
@33060 = ~[no text]~
@33061 = ~[no text]~
@33062 = ~[no text]~
@33063 = ~Лицо мужчины багровеет от гнева. «Следи за языком, рубака! Это ложь! Подлая, грязная ложь! Ты че, *сбрендил* — трепаться с нечистью о Войне и верить всем ее словам?!»~
@33064 = ~«Я тебе скажу, что случилось, пень! — он вздыхает и немного успокаивается. — Я был в числе остатков Роты Пылающего Чучела... пятерых, оставшихся от изначально пятидесяти трех смертных наемников. Мы разбили лагерь где-то в Авернусе, ожидая подкрепления для предстоящей битвы...»~
@33065 = ~«Ну, моя служба подходила к концу... фактически, я мог уйти сразу же после битвы. Проблема была в том, что умри я там — остался бы у них навеки. Слишком много черноты, слишком много зла было в моем сердце. Я бы закончил просителем в Бааторе, вечным солдатом той войны». Он содрогается от этой мысли.~
@33066 = ~«Я и еще двое парней сбежали как собаки — вот что случилось. Мы неслись по плану несколько дней, пока не наткнулись на тот громадный столб из живых голов... кошмарное было зрелище... они все бормотали и шептались, приглашали подойти поближе. Той ночью я умыкнул от остальных и пришел поговорить со столбом».~
@33067 = ~Гизис закрывает глаза и трет виски. «Я... я спросил у столба: как мне сбежать с Баатора... и он ответил мне — в обмен на двух моих собратьев, — на миг он замолкает, впившись в костяшки пальцев, будто бы пытаясь сдержать слезы. — Для меня... в то время... это было как дважды два».~
@33068 = ~Он кивает. «Не знаю, смогу ли я простить себя. Теперь я просто солдат, ищущий, где бы помереть. Пытаюсь стереть пятно зла, очистить свое нутро, прежде чем умру и вернусь на Кровавую войну. Читаю здесь лекции, чтобы предостеречь людей от всего этого, чтоб никому не пришлось делать такой выбор».~
@33069 = ~Он кивает. «Не знаю, смогу ли я простить себя. Теперь я просто солдат, ищущий, где бы помереть. Пытаюсь стереть пятно зла, очистить свое нутро, прежде чем умру и вернусь на Кровавую войну. Читаю здесь лекции, чтобы предостеречь людей от всего этого, чтоб никому не пришлось делать такой выбор».~
@33070 = ~«Я и не говорю, что это правильно, пень, но ты же не можешь отрицать того, что такое мог бы сделать кто угодно. Я называю это *выживанием*, а не убийством... а теперь оставь меня. Старина Гизис больше не хочет делится с *тобой* подноготной».~
@33071 = ~Гизис кривится, качая головой. «Ты... ну ты и урод, пень. Вот, бери все, что я накопил за все эти годы... только держи свое хлебало на замке. У меня такое чувство, что если б я загнулся тогда, на Кровавой войне, я знаю, кто бы был там со мной...» Он протягивает немного монет и еще пригоршню предметов.~
@33072 = ~~
@33073 = ~«Кровавая война? Это еще скучней, чем слушать, как законники декламируют законы. Давай-ка найдем пару молоденьких чувствующих, нуждающихся в просвещении по части любовных страстей!» В предвкушении он водит бровями.~
@33074 = ~«Нет, Морт... Я хочу послушать это».~
@33075 = ~Не обращать внимания на Морта, продолжать слушать.~
@33076 = ~«Ладно, Морт, пошли».~
@33077 = ~ПАРАМЕТРЫ ОБРАТНОЙ СВЯЗИ~
@33078 = ~Авторы~
@33079 = ~Твоя Сила средняя.~
@33080 = ~«А вот мне несложно представить, чтобы женщина смогла остановить Кровавую войну».~
@33081 = ~«Да ничего. Ты абсолютно прав».~
@33082 = ~«Но ведь нечистых все еще пускают в Сигил?»~
@33083 = ~«Позволь мне спросить еще кое о чем...»~
@33084 = ~«У меня больше нет вопросов».~
@33085 = ~«Какие еще рода войск участвуют в Кровавой войне?»~
@33086 = ~«Позволь мне спросить еще кое о чем...»~
@33087 = ~«У меня больше нет вопросов».~
@33088 = ~«Собственно говоря, вопросов больше нет».~
@33089 = ~«Почему нечисть просто не взяла Сигил?»~
@33090 = ~Твоя угроза охладила его пыл. «Вали отсюда, рубака! — шипит он. — Я бы на твоем месте следил за собой».~
@33091 = ~В ответ на твою угрозу сборщик достает из кармана нож. «Придется не согласиться с тобой, пень. Это ТЫ скоро станешь звенелками в моем кармане!»~
@33092 = ~Похоже, твои слова вразумили сборщика: он разворачивается и уходит. «Следи за собой, рубака. Большинство здесь говорит сперва ножами, а уж потом — черепушками. Будешь и дальше здесь торчать — и я с тобой так поболтаю».~
@33093 = ~«Если ты меня не пропустишь, сборщик, то один из нас попадет в Морг, и это точно буду не я».~
@33094 = ~«Собирать тела до того, как они умерли — верный способ повидаться с Леди».~
@33095 = ~«Тогда я оставлю тебя, пень».~
@33096 = ~Атаковать сборщика.~
@33097 = ~«Если ты меня не пропустишь, сборщик, то один из нас попадет в Морг, и это точно буду не я».~
@33098 = ~«Да... Со мной все в порядке. Итак, нечистые часто берут наемников?»~
@33099 = ~«Я в порядке. Позволь мне спросить кое о чем еще...»~
@33100 = ~«Я в порядке. У меня к тебе больше нет вопросов».~
@33101 = ~«Если ты меня не пропустишь, сборщик, то один из нас попадет в Морг, и это точно буду не я».~
@33102 = ~Продолжить вспоминать...~
@33103 = ~«Собирать тела до того, как они умерли — хороший способ повидаться с Леди».~
@33104 = ~«Тогда я оставлю тебя, пень».~
@33105 = ~Атаковать сборщика.~
@33106 = ~Не обращать внимания на сборщика, пройти мимо.~
@33107 = ~«Я так не думаю...»~
@33108 = ~«Аналогично...»~
@33109 = ~«Ну попробуй...»~
@33110 = ~«Как скажешь...»~
@33111 = ~~
@33112 = ~Продолжить вспоминать...~
@33113 = ~Продолжить вспоминать...~
@33114 = ~Остаться на лекции.~
@33115 = ~Остаться на лекции.~
@33116 = ~~
@33117 = ~~
@33118 = ~~
@33119 = ~~
@33120 = ~~
@33121 = ~~
@33122 = ~~
@33123 = ~~
@33124 = ~«Это то, что она мне сказала. Я не говорил, что поверил этому».~
@33125 = ~«Что случилось потом?»~
@33126 = ~«Забудь,что я упоминал об этом. У меня есть другие вопросы...»~
@33127 = ~«Продолжай...»~
@33128 = ~«Пожалуй, я выслушаю оставшуюся часть в другой раз. Прощай».~
@33129 = ~«Что произошло?»~
@33130 = ~«Пожалуй, я выслушаю оставшуюся часть в другой раз. Прощай».~
@33131 = ~«И?..»~
@33132 = ~«Пожалуй, я выслушаю оставшуюся часть в другой раз. Прощай».~
@33133 = ~«Мне все равно кажется, будто ты их убил».~
@33134 = ~«Это ужасно — быть вынужденным делать такой выбор».~
@33135 = ~«Понятно... Но мне все еще кажется, будто ты убил тех двоих».~
@33136 = ~«Понятно... Но мне все еще кажется, будто ты убил тех двоих».~
@33137 = ~«Я понимаю, Гизис».~
@33138 = ~«Может, мне стоит пустить слух, Гизис: уверен, все будут рады узнать, как *именно* ты пережил Войну».~
@33139 = ~«Так-то лучше».~
@33140 = ~«Тебе что, разжевать, старик? Это шантаж. Мне что-нибудь нужно в обмен на молчание».~
@33141 = ~«Ничего... забудь, что я говорил».~
@33142 = ~«Не дождешься, Гизис. А теперь заканчивай свою лекцию».~
@33143 = ~~
@33144 = ~Покупатель~
@33145 = ~Кузнец Литейной~
@33146 = ~Изрисованный головорез~
@33147 = ~Маг Голодных Псов~
@33148 = ~Слепой головорез~
@33149 = ~Член банды Голодных Псов Лающих~
@33150 = ~Ветеран Голодных Псов~
@33151 = ~Волшебник~
@33152 = ~Мужчина пятится назад со смешанным выражением страха и отвращения на лице. «От... отвали! Оставь меня в покое!»~
@33153 = ~Позволить ему уйти.~
@33154 = ~При твоем приближении глаза мужчины расширяются, и он быстро отводит взгляд. «У меня нет ничего ценного, рубака, честно! Оставь человека в покое!»~
@33155 = ~Позволить ему уйти.~
@33156 = ~«Отвали! Я не желаю ничего иметь общего с тобой!»~
@33157 = ~Уйти.~
@33158 = ~Мужчина с большим усилием пытается игнорировать тебя. Чем настойчивей ты пытаешься привлечь его внимание, тем очевидней становится то, что он не желает с тобой общаться.~
@33159 = ~Уйти.~
@33160 = ~«Кажись, ты долго жил в Улье, или еще хуже — всю свою жизнь, рубака. Так что, бедолага, проваливай и оставь меня в покое!»~
@33161 = ~Уйти.~
@33162 = ~«Ты выглядишь измотанным, пень. Если тебе нужно отдохнуть, подыщи себе берлогу в Ночлежке... она прямо посреди этого района. А теперь оставь меня. Я не собираюсь тратить попусту время на твои вопросы».~
@33163 = ~Уйти.~
@33164 = ~«Ты еще не бывал в Баре собирателей пыли, пень? Просто ты мне напомнил тамошних рабочих...» Он громко хохочет.~
@33165 = ~Уйти.~
@33166 = ~Мужчина жует нечто, напоминающее крысу на палочке. «Чего тебе, пень? Никогда раньше не видел приготовленную крысу? Тебе сойдет, и на вкус она тоже ничего! Если голоден, поговори с Креденом... он стоит у Офиса по контролю паразитов и эпидемий».~
@33167 = ~Уйти.~
@33168 = ~«Еще не встречался с Голодными Псами? На твоем бы месте я бы с этими умалишенными не пересекался... кровавые отморозки, вот они кто!»~
@33169 = ~Уйти.~
@33170 = ~«Я ничего не знаю, пень... отвали».~
@33171 = ~Уйти.~
@33172 = ~Мужчина осматривает тебя, затем проводит полукруг над своим сердцем. «Я не встреваю в твои дела, знаток, ты не встреваешь в моим. Прощай».~
@33173 = ~Позволить ему уйти.~
@33174 = ~При твоем приближении мужчина начинает хмуриться. «У меня нет времени трясти черепушкой с какими-то проходимцами, рубака. И тем более это не самое безопасное занятие в Улье. Гуляй себе мимо».~
@33175 = ~«Тогда прощай». ~
@33176 = ~«Жизнь в Улье полна несправедливости, скажу я тебе».~
@33177 = ~Уйти.~
@33178 = ~«Ты выглядишь измотанным, пень. Если тебе нужно отдохнуть, подыщи себе берлогу в Ночлежке... она прямо посреди этого района. А теперь оставь меня. Я не собираюсь тратить попусту время на твои вопросы».~
@33179 = ~Уйти.~
@33180 = ~«Ты еще не бывал в Баре собирателей пыли, пень? Просто ты мне напомнил тамошних рабочих...» Он громко хохочет.~
@33181 = ~Уйти.~
@33182 = ~Мужчина жует нечто, напоминающее крысу на палочке. «Чего тебе, пень? Никогда раньше не видел приготовленную крысу? Тебе сойдет, и на вкус она тоже ничего! Если голоден, поговори с Креденом... он стоит у Офиса по контролю паразитов и эпидемий».~
@33183 = ~«Я хочу повидаться с Дейонаррой».~
@33184 = ~«Значит, туда и направлюсь. Прощай».~
@33185 = ~«Я хочу повидаться с Дейонаррой».~
@33186 = ~«Я хочу повидаться с Соэго».~
@33187 = ~«Я хочу повидаться с Соэго».~
@33188 = ~«Я его уже нашел, но все равно спасибо. Прощай».~
@33189 = ~Ложь: «Э-э... Адана. Он все еще работает здесь?..»~
@33190 = ~Ложь: «Э-э... Адана. Он все еще работает здесь?..»~
@33191 = ~«Ой, нет. Я оговорился».~
@33192 = ~«Слыхал о переулке Опасных углов? Раньше там был целый жилой квартал, но потом его сожгли дотла. Ничего не осталось, кроме кучи шныряющих бандитов».~
@33193 = ~«Да, я уже был там».~
@33194 = ~Уйти.~
@33195 = ~«Если ты сможешь перенести смрад, то где-то здесь должен быть старина Вонючка, который может рассказать много интересных историй».~
@33196 = ~«Наверное, мне стоит поискать его. Прощай».~
@33197 = ~«Да, я уже виделся с ним. Прощай».~
@33198 = ~«Тлеющий труп — моя самая любимая таверна в Улье... Иногда там бывает жарковато, хотя это, скорее всего, из-за тлеющего трупа».~
@33199 = ~«Теперь там больше нет трупа. Прощай».~
@33200 = ~«Ага, только я уже был там. Прощай».~
@33201 = ~Уйти.~
@33202 = ~Мужчина кивает тебе. «Приветствую, рубака. Я бы помог тебе, если смог... но я не знаю ничего для тебя полезного».~
@33203 = ~«Все равно спасибо. Прощай».~
@33204 = ~«Спасибо за информацию. Я поговорю с ним».~
@33205 = ~«Ненавижу это место... хотел бы я иметь достаточно звенелок, чтобы убраться куда-нибудь из Улья. Мой тебе совет, рубака, вали отсюда, как только сможешь».~
@33206 = ~Уйти.~
@33207 = ~«Будь осторожен, пень... насилие — это образ жизни в Улье».~
@33208 = ~Уйти.~
@33209 = ~«Ты выглядишь измотанным, пень. Если тебе нужно отдохнуть, подыщи себе берлогу в Ночлежке... она прямо посреди этого района. А теперь оставь меня. Я не собираюсь тратить попусту время на твои вопросы».~
@33210 = ~Уйти.~
@33211 = ~«Я слышал о тебе, пень... ты — тот, кто спрашивает всех о Фароде, верно? Если ты еще не нашел его, попробуй поискать его на севере отсюда, на площади Старьевщиков».~
@33212 = ~«Значит, туда и направлюсь. Прощай».~
@33213 = ~«Я его уже нашел, но все равно спасибо. Прощай».~
@33214 = ~«Однажды я встретил знатока, Порфирона... он может обучить любого сражаться».~
@33215 = ~«Возможно, я поищу его. Прощай».~
@33216 = ~«Да, я уже виделся с ним. Прощай».~
@33217 = ~«Если ищешь какое-нибудь направление, разыщи указатель. Он стоит у Бара собирателей пыли».~
@33218 = ~Уйти.~
@33219 = ~«Слыхал о переулке Опасных углов? Раньше там был целый жилой квартал, но потом его сожгли дотла. Ничего не осталось, кроме кучи шныряющих бандитов».~
@33220 = ~«Да, я был там. Прощай».~
@33221 = ~Уйти.~
@33222 = ~«Много людей приходят сюда, чтобы оплакивать своих умерших... в Мемориале тленных есть странный тленный, который может сказать тебе, умер ли кто-то или нет. Или похоронить его имя, если ты захочешь увековечить его».~
@33223 = ~«Практически каждый тленный в Сигиле проводит свое свободное время в Баре собирателей пыли. Если ты ищешь кого-нибудь из них, то лучше начинать поиски оттуда».~
@33224 = ~«Я хочу повидаться с Соэго».~
@33225 = ~Уйти.~
@33226 = ~«Я хочу повидаться с Соэго».~
@33227 = ~Ложь: «Э-э... с Аданом. Он все еще работает здесь?..»~
@33228 = ~Мужчина жует нечто, напоминающее крысу на палочке. «Чего тебе, пень? Никогда раньше не видел приготовленную крысу? Тебе сойдет, и на вкус она тоже ничего! Если голоден, поговори с Креденом... он стоит у Офиса по контролю паразитов и эпидемий».~
@33229 = ~Ложь: «Э-э... с Аданом. Он все еще работает здесь?..»~
@33230 = ~Уйти.~
@33231 = ~«Ой, нет. Я оговорился».~
@33232 = ~«Если ты сможешь перенести смрад, то где-то здесь должен быть старина Вонючка, который может рассказать много интересных историй».~
@33233 = ~«Наверное, мне стоит поискать его. Прощай».~
@33234 = ~«Да, я уже виделся с ним. Прощай».~
@33235 = ~«Все, что ты можешь пожелать, можно найти на здешнем Рынке».~
@33236 = ~Уйти.~
@33237 = ~«Слыхал про Профиру на Рынке? Если она права, а не полоумная, как многие говорят, то в Сигиле наступит беспорядок».~
@33238 = ~Уйти.~
@33239 = ~«Слыхал о переулке Опасных углов? Раньше там был целый жилой квартал, но потом его сожгли дотла. Ничего не осталось, кроме кучи шныряющих бандитов».~
@33240 = ~«Да, я уже был там».~
@33241 = ~Уйти.~
@33242 = ~«Еще не встречался с Голодными Псами? На твоем бы месте я бы с этими умалишенными не пересекался... кровавые отморозки, вот они кто!»~
@33243 = ~Уйти.~
@33244 = ~«Тлеющий труп — моя самая любимая таверна в Улье... Иногда там бывает жарковато, хотя это, скорее всего, из-за тлеющего трупа».~
@33245 = ~«Спасибо за информацию. Я поговорю с ним».~
@33246 = ~«Теперь там больше нет трупа. Прощай».~
@33247 = ~«Ага, только я уже был там. Прощай».~
@33248 = ~Уйти.~
@33249 = ~«Встречался с пустоголовым «Оплакивающим»? Вот ведь тупица... Как будто кому-то есть дело до этих деревьев. Хотел бы я знать, какой недоумок их вообще посадил здесь».~
@33250 = ~Уйти.~
@33251 = ~«Могу лишь сказать тебе, рубака, чтобы ты получше следил за своим кошельком... Мне кажется, здесь очень много карманников».~
@33252 = ~«Спасибо. Прощай».~
@33253 = ~«Тут в окрестностях все время бегает одна тронутая... говорят, она невежда, которая слетела с катушек, пытаясь найти способ вернуться к себе домой».~
@33254 = ~«Да... Скорее всего, она уже дома или на полпути к нему. Прощай».~
@33255 = ~«Я встречался с ней. Ее зовут Ингресс. Прощай».~
@33256 = ~Уйти.~
@33257 = ~«Если у тебя есть время и немного звенелок в кармане, найди Гаоху на Рынке».~
@33258 = ~Уйти.~
@33259 = ~«Какие у тебя интересные татуировки тут, рубака. Знаешь, здесь рядом есть салон... которым заправляет дабус, который разбирается в них!»~
@33260 = ~«Я знаю. Его зовут Фелл. Прощай».~
@33261 = ~«Да, я был там. Прощай».~
@33262 = ~«Тогда, может быть, я схожу туда. Прощай».~
@33263 = ~«Тлиум! Я думал, что мы больше не увидимся. Как давно это было? Четыре года? Ну и вид у тебя... ладно, проехали. Вот та сотня медяков, которую я должен тебе. Я бы вернул тебе их раньше, но ты как будто испарился из Сигила! А теперь пора прощаться, Тлиум... удачи!»~
@33264 = ~«Э...»~
@33265 = ~Позволить ему уйти.~
@33266 = ~Глаза мужчины широко раскрыты, лицо налилось кровью. «С-с-силы небес и преисподней... говорили, что ты вернешься, н-н-но я не верил!» Он срывается с места.~
@33267 = ~Попробовать схватить его.~
@33268 = ~Позволить ему уйти.~
@33269 = ~Мужчина косится на тебя. «Моррик? Ты ли это?»~
@33270 = ~Ложь: «Да... Я — Моррик».~
@33271 = ~«Может быть...»~
@33272 = ~«Извини, нет».~
@33273 = ~«Тогда прошу прощения, рубака. Прощай».~
@33274 = ~«Прощай».~
@33275 = ~«Разве я тебе не говорил тебе не возвращаться в Сигил?.. Если Аматэль узнает, что ты вернулся, то ты — покойник! Как бы то ни было, твой свиток все еще у меня. Вот... возьми и уйди от меня, пока нас не увидели вместе».~
@33276 = ~«Но...»~
@33277 = ~«Спасибо... Прощай».~
@33278 = ~Мужчина разевает рот от удивления и показывает на Морта. «Ух ты, гляди! Летающий череп!»~
@33279 = ~«Чееего?! Нарываешься на то, чтобы тебе выбили пару зубов, болтающаяся черепушка?» Мужчина угрожающе делает шаг в сторону Морта.~
@33280 = ~Остановить мужчину.~
@33281 = ~Позволить Морту расправиться с ним.~
@33282 = ~Ты становишься между Мортом и мужчиной; он хмуро смотрит на тебя, но затем отступает. «Только время на тебя тратить!» Он разворачивается и уходит прочь.~
@33283 = ~Позволить ему уйти.~
@33284 = ~Мужчина хмуро смотрит на Морта, потом на тебя, затем мотает головой. «Только время на вас тратить!» Он поворачивается и уходит прочь.~
@33285 = ~Позволить ему уйти.~
@33286 = ~«Анна! Что это ты делаешь с *этой* вонючей кучей навоза? Я думал, ты — *моя* девушка...» Мужчина громко гогочет, хлопая себя по бедрам.~
@33287 = ~«А, это все пустые слова, Анна... все *слова*... тебе никогда не найти мужчину, который *по-настоящему* удовлетворит тебя! Иди сюда, подари мне долгий смачный поцелуй, моя маленькая грязная принцесса тифлингов!» Он пытается ущипнуть Анну.~
@33288 = ~Этому человеку больше нечего тебе рассказать.~
@33289 = ~Уйти.~
@33290 = ~Этот человек не сообщит тебе больше ничего важного.~
@33291 = ~Уйти.~
@33292 = ~Этот человек не сообщит тебе больше ничего интересного.~
@33293 = ~Уйти.~
@33294 = ~Этому человеку больше нечего тебе сказать.~
@33295 = ~Уйти.~
@33296 = ~«Заткнись, куча дерьма! Разве я те не говорила никогда больше со мной не базарить? Одной Леди известно, как тебе удалось в тот раз угадать мое имя!»~
@33297 = ~«Теперь не говори, что я не предупреждала тебя, жмурик!» Клинки Анны устремляются в объятья человека...~
@33298 = ~Тоже атаковать его.~
@33299 = ~Позволить Анне закончить.~
@33300 = ~Морт закатывает глаза и кричит. «Ух ты! Смотри! Говорящая какашка!»~
@33301 = ~Морт качает в твою сторону, обращаясь к мужчине: «Я показывал на этого огромного пня, знаток... не на тебя! Без обид, ага?»~
@33302 = ~«Полегче, Морт...»~
@33303 = ~Не обращать внимания на Морта.~
@33304 = ~Глаза женщины наполняются страхом при твоем приближении. «Уйди от меня! Прочь! Оставь меня в покое, или я закричу! Клянусь!»~
@33305 = ~Позволить ей уйти.~
@33306 = ~При твоем приближении женщина начинает озираться по сторонам, пытаясь выявить кого-нибудь крадущегося. «Я... я ничего не знаю, рубака, пожалуйста, оставь меня в покое!»~
@33307 = ~Уйти.~
@33308 = ~«Иди-ка ты донимать кого-нибудь еще, неудачник! У меня нет времени для таких как ты...»~
@33309 = ~Уйти.~
@33310 = ~Женщина от страха не может вымолвить ни слова.~
@33311 = ~Уйти.~
@33312 = ~Осознав, что ты направляешься к ней, женщина бледнеет и начинает искать свой кинжал. «Не хочу иметь с тобой ничего общего! Уходи!»~
@33313 = ~Уйти.~
@33314 = ~«Ты — тот пень, который ищет Фарода! Еще не нашел его? Если нет, то можешь попробовать поискать к северу отсюда на площади Старьевщиков».~
@33315 = ~«Значит, туда и направлюсь. Прощай».~
@33316 = ~«Если ты окажешься в Баре собирателей пыли, пень, не удивляйся, если они примут тебя за своего!» Женщина хмыкает и начинает хихикать.~
@33317 = ~Уйти.~
@33318 = ~Женщина смакует нечто, напоминающее крысу на палочке. Заметив, что ты наблюдаешь за ней, она подозрительно сужает глаза. «Если тебе они нравятся, поговори с Креденом, и хватит на меня пялится! Он стоит у Офиса по контролю паразитов и эпидемий».~
@33319 = ~Уйти.~
@33320 = ~«Если ты встретишь кучку бегающих и воющих сумасшедших, держись от них подальше! Эти Голодные Псы меня так пугают...»~
@33321 = ~Уйти.~
@33322 = ~«Я ничем не могу помочь тебе... так что оставь меня в покое».~
@33323 = ~Уйти.~
@33324 = ~Женщина поднимает брови при твоем приближении. «Я занимаюсь своими делами, пень... и тебе следует заниматься тем же — держись подальше от проблем, ладно? Пока-пока».~
@33325 = ~«Прощай».~
@33326 = ~При твоем приближении женщина начинает хмуриться. «У меня нет времени болтать с какими-то проходимцами, пень. И тем более это не самое безопасное занятие в Улье. Гуляй себе мимо».~
@33327 = ~«В таком случае, прощай».~
@33328 = ~Женщина жалобно вздыхает. «Нет ничего хуже жизни в Улье. Тебя могут прописать в книгу мертвых только за то, что ты глянула в сторону какого-нибудь пня».~
@33329 = ~Уйти.~
@33330 = ~«Похоже, тебе не помешает немного отдохнуть в Ночлежке, рубака. Если интересно, она посреди этой части Улья».~
@33331 = ~Уйти.~
@33332 = ~«Если ты окажешься в Баре собирателей пыли, пень, не удивляйся, если они примут тебя за своего!» Женщина хмыкает и начинает хихикать.~
@33333 = ~Уйти.~
@33334 = ~Женщина смакует нечто, напоминающее крысу на палочке. Заметив, что ты наблюдаешь за ней, она подозрительно сужает глаза. «Если тебе они нравятся, поговори с Креденом, и хватит на меня пялится! Он стоит у Офиса по контролю паразитов и эпидемий».~
@33335 = ~Уйти.~
@33336 = ~«Если ты встретишь кучку бегающих и воющих сумасшедших, держись от них подальше! Эти Голодные Псы меня так пугают...»~
@33337 = ~Уйти.~
@33338 = ~«Ты — тот пень, который ищет Фарода! Еще не нашел его? Если нет, то можешь попробовать поискать к северу отсюда на площади Старьевщиков».~
@33339 = ~«Значит, туда и направлюсь. Прощай».~
@33340 = ~«Я его уже нашел, но все равно спасибо. Прощай».~
@33341 = ~«Если не хочешь нарваться на проблемы, держись подальше от выжженного переулка, что к северо-западу отсюда».~
@33342 = ~«Да, я уже был там. Прощай».~
@33343 = ~Уйти.~
@33344 = ~«Если не хочешь нарваться на неприятности, держись подальше от выжженной улицы, что к северо-западу отсюда».~
@33345 = ~«Да, я уже был там. Прощай».~
@33346 = ~Уйти.~
@33347 = ~«Где-то поблизости бродит бедняга по имени Вонючка... если увидишь его рядом, и в кармане водится пара-тройка монет, то он сочинит тебе отличный рассказ».~
@33348 = ~«Наверное, мне стоит поискать его. Прощай».~
@33349 = ~«Да, я уже виделся с ним. Прощай».~
@33350 = ~Уйти.~
@33351 = ~«Ты уже был в «Тлеющем Трупе»? Неплохая таверна, только горящий человек немного меня нервирует».~
@33352 = ~«Его здесь больше нет. Прощай».~
@33353 = ~«Привет, знаток, — женщина дарит тебе робкую улыбку. — Слушай... Я тут хотела немного выпить, развеяться... как насчет присоединиться?»~
@33354 = ~«Может, в другой раз... сейчас я очень занят. Прости».~
@33355 = ~«Я не могу представить, что буду растить здесь ребенка. Быть может, когда-нибудь моя семья сможет покинуть это ужасное место».~
@33356 = ~Уйти.~
@33357 = ~Женщина улыбается тебе. «Нет, я не могу помочь тебе... если бы могла, то обязательно помогла бы».~
@33358 = ~«Все равно спасибо. Прощай».~
@33359 = ~«Похоже, тебе не помешает немного отдохнуть в Ночлежке, рубака. Если интересно, она посреди этой части Улья».~
@33360 = ~Уйти.~
@33361 = ~«Да, я уже виделся с ним. Прощай».~
@33362 = ~«Ты — тот пень, который ищет Фарода! Еще не нашел его? Если нет, то можешь попробовать поискать к северу отсюда на площади Старьевщиков».~
@33363 = ~«Значит, туда и направлюсь. Прощай».~
@33364 = ~«Я его уже нашел, но все равно спасибо. Прощай».~
@33365 = ~«Я вчера видела человека по имени Порфирон, всего в татуировках. Он сказал, что он какой-то там монах, воитель... только не хочет драться».~
@33366 = ~«Возможно, я поищу его. Прощай».~
@33367 = ~«Если ты ищешь дорогу куда-нибудь, рубака, найди указатель у Бара собирателей пыли».~
@33368 = ~Уйти.~
@33369 = ~Уйти.~
@33370 = ~«Если не хочешь нарваться на неприятности, держись подальше от выжженной улицы, что к северо-западу отсюда».~
@33371 = ~«Да, я уже был там. Прощай».~
@33372 = ~Уйти.~
@33373 = ~«Много народу ходит поминать своих усопших в Мемориал тленных... там есть тленный, который может вписать в Мемориал любое имя для тебя, или сказать, умер ли тот, кого ты ищешь».~
@33374 = ~«Да, его зовут «Смерть-Имен». Прощай».~
@33375 = ~«Тленные сторонятся ото всех таверн в Улье... кроме Собирателей Пыли. Там вообще трудно кого-нибудь встретить, *кроме* мертвяков».~
@33376 = ~Уйти.~
@33377 = ~Женщина смакует нечто, напоминающее крысу на палочке. Заметив, что ты наблюдаешь за ней, она подозрительно сужает глаза. «Если тебе они нравятся, поговори с Креденом, и хватит на меня пялится! Он стоит у Офиса по контролю паразитов и эпидемий».~
@33378 = ~Уйти.~
@33379 = ~«Да, я уже виделся с ним. Прощай».~
@33380 = ~«Где-то поблизости бродит бедняга по имени Вонючка... если увидишь его рядом, и в кармане водится пара-тройка монет, то он сочинит тебе отличный рассказ».~
@33381 = ~«Наверное, мне стоит поискать его. Прощай».~
@33382 = ~«Как давно ты бывал на рынке, рубака? Здесь есть все, что нужно телу».~
@33383 = ~Уйти.~
@33384 = ~«Надеюсь, Профира ошибается... Ты не слышал ее предсказаний? Обычна она выкрикивает их на Рынке...»~
@33385 = ~Уйти.~
@33386 = ~Уйти.~
@33387 = ~«Если не хочешь нарваться на неприятности, держись подальше от выжженной улицы, что к северо-востоку отсюда».~
@33388 = ~«Да, я уже был там. Прощай».~
@33389 = ~«Если ты встретишь кучку бегающих и воющих сумасшедших, держись от них подальше! Эти Голодные Псы меня так пугают...»~
@33390 = ~«Ага, только я уже был там. Прощай».~
@33391 = ~Уйти.~
@33392 = ~Уйти.~
@33393 = ~«Ты уже был в «Тлеющем Трупе»? Неплохая таверна, только горящий человек немного меня нервирует».~
@33394 = ~«Его здесь больше нет. Прощай».~
@33395 = ~«Недавно я видела мужчину, которого зовут Скорбящий-по-деревьям... кажется, он двинулся насчет поиска людей, которые будут заботиться о здешних деревьях. Уж лучше бы он больше времени уделял помощи здешним людям».~
@33396 = ~Уйти.~
@33397 = ~«Единственное, чем я могу тебе помочь, так это предупредить о здешних ворах, рубака... Я слышала, в этой части Улья много карманников».~
@33398 = ~«Спасибо. Прощай».~
@33399 = ~«Я встречался с ней. Ее зовут Ингресс. Прощай».~
@33400 = ~Уйти.~
@33401 = ~«Недавно я видела несчастную чокнутую крошку, которая все носилась вокруг и что-то кричала. Удивительно, что эта полоумная еще не сдохла от голода и не кокнула себя».~
@33402 = ~«Да... Скорее всего, она уже дома или на полпути к нему. Прощай».~
@33403 = ~«Держись подальше от Гаохи на Рынке. Мой муж вечно просаживает кучу звенелок, когда делает ставки у этого трижды проклятого гита!»~
@33404 = ~Уйти.~
@33405 = ~«Нет, я никогда не был там»~
@33406 = ~«Возможно и так. Прощай».~
@33407 = ~«Ух ты, какие татуировки! Прямо как те, которые делают в здешнем салоне в Улье. Ты знаешь, им заправляет дабус!»~
@33408 = ~«Да, я знаю. Его зовут Фелл».~
@33409 = ~«Да, я знаю это место».~
@33410 = ~«Ослепи меня, Леди! Я уже видела тебя, рубака, но не думала, что увижу тебя еще раз! Сигил гораздо меньше, чем я думала».~
@33411 = ~«Ты знаешь меня?»~
@33412 = ~Терпеливо ждать.~
@33413 = ~Она нервно улыбается. «Знаю ли я тебя? Неа, но, как я уже сказала, я видела тебя. Это было в прошлом году... поздно ночью, в самый антипик... я искала свою сестру, когда появился ты, бешеный и весь в мыле. Ты споткнулся и уронил вот это, прямо мне под ноги, и потом убежал. Я хранила это на счастье, думала, что сама судьба положила это к моим ногам, — она вынимает внушительных размеров кинжал. — Вот... раз я снова встретилась с тобой, возьми его назад, рубака. Прощай».~
@33414 = ~«Спасибо... Прощай».~
@33415 = ~Похоже, женщина сразу тебя узнала. В ужасе она делает шаг назад. «После всего этого времени... ты, *ублюдок*! Чтоб тебя забрала вся нечисть Баатора! Однажды ты пожалеешь о том, что ты сделал с Аэрин... *клянусь* всеми силами!» Она разворачивается и убегает.~
@33416 = ~«Постой...»~
@33417 = ~Позволить ей уйти.~
@33418 = ~Позволить ей уйти.~
@33419 = ~«Но...»~
@33420 = ~«Ну вот, мой черный день настал. Ты оказался рядом. Я уж начала думать, что ты никогда не подойдешь, знаток». Она начинает рыться в своей поясной сумке.~
@33421 = ~«Постой... Наверное, ты ошиблась...»~
@33422 = ~«Нет, рубака... то были славные времена, но теперь нам лучше не светиться. У него были друзья, скорее всего, они догадываются, что произошло на самом деле. Мы не должны больше встречаться».~
@33423 = ~Морт закатывает глаза и кричит. «Ух ты! Смотри! Говорящая какашка!»~
@33424 = ~«Теперь он труп, куда уж мертвее — как ты и сказал... и он мне таким нравится. Держи свои кровавые деньги, рубака... вот кольцо, которое я обещала. Удачи».~
@33425 = ~«Погоди секунду... У меня есть несколько вопросов...» ~
@33426 = ~«Нет, рубака... то были славные времена, но теперь нам лучше не светиться. У него были друзья, и, скорее всего, они догадываются, что произошло на самом деле. Мы не должны больше встречаться».~
@33427 = ~«Но...»~
@33428 = ~Уйти.~
@33429 = ~Морт качает в твою сторону, обращаясь к мужчине: «Я показывал на этого огромного пня, знаток... не на тебя! Без обид, ага?»~
@33430 = ~«Полегче, Морт...»~
@33431 = ~Она странно смотрит на тебя, косится на татуировки на твоем предплечье, затем пожимает плечами. «А они тебе очень идут, рубака. Удачи...»~
@33432 = ~Позволить ей уйти.~
@33433 = ~Не обращать внимания на Морта.~
@33434 = ~Этой женщине больше нечего тебе рассказать.~
@33435 = ~«Заткнись, куча дерьма! Разве я те не говорила никогда больше со мной не базарить? Одной Леди известно, как тебе удалось в тот раз угадать мое имя!»~
@33436 = ~Эта женщина не сообщит тебе больше ничего важного.~
@33437 = ~«Теперь не говори, что я не предупреждала тебя, жмурик!» Клинки Анны устремляются в объятья человека...~
@33438 = ~Тоже атаковать его.~
@33439 = ~Позволить Анне закончить.~
@33440 = ~Твоя Сила выше средней.~
@33441 = ~Твоя Сила гораздо выше средней. Ты получаешь +<STAT_STRVAL1> к урону в рукопашной.~
@33442 = ~Твоя исключительная сила дает тебе +<STAT_STRVAL1> к вероятности попадания и +<STAT_STRVAL2> к урону в рукопашной.~
@33443 = ~Твоя героическая Сила дает тебе +<STAT_STRVAL1> к вероятности попадания и +<STAT_STRVAL2> к урону в рукопашной.~
@33444 = ~Твой Интеллект средний.~
@33445 = ~Твой Интеллект выше среднего.~
@33446 = ~Твой Интеллект исключителен.~
@33447 = ~У тебя Интеллект гения. ~
@33448 = ~«Я его уже нашел, но все равно спасибо. Прощай».~
@33449 = ~«Ага, только я уже был там. Прощай».~
@33450 = ~«Тогда прощай».~
@33451 = ~Уйти.~
@33452 = ~Твоя Мудрость средняя. ~
@33453 = ~Твоя Мудрость выше средней.~
@33454 = ~Ты обладаешь исключительными Мудростью и силой воли. ~
@33455 = ~Твоя Мудрость соизмерима с героической.~
@33456 = ~Твоя Ловкость средняя.~
@33457 = ~Твоя Ловкость выше средней.~
@33458 = ~Твоя исключительная Ловкость дает тебе бонус +<STAT_DEXVAL1> к Классу Брони.~
@33459 = ~Твоя Ловкость соизмерима с героической, дающая тебе бонус +<STAT_DEXVAL1> к Классу Брони.~
@33460 = ~Твое Телосложение среднее.~
@33461 = ~Твое Телосложение выше среднего.~
@33462 = ~Твое исключительное Телосложение дает тебе +<STAT_CONVAL1> к жизни за каждый уровень.~
@33463 = ~Твое героическое Телосложение дает тебе +<STAT_CONVAL1> к жизни за каждый уровень.~
@33464 = ~Твое Обаяние ниже среднего.~
@33465 = ~Твое Обаяние среднее.~
@33466 = ~Твое Обаяние выше среднего.~
@33467 = ~Твое Обаяние исключительно.~
@33468 = ~Твое Обаяние соизмеримо с героическим.~
@33469 = ~Эта женщина не сообщит тебе больше ничего интересного.~
@33470 = ~Этой женщине больше нечего тебе сказать.~
@33471 = ~Уйти.~
@33472 = ~«Нет. Прощай».~
@33473 = ~Долора~
@33474 = ~Майт~
@33475 = ~Тарин~
@33476 = ~Биш~
@33477 = ~Изрисованный головорез~
@33478 = ~Маг Голодных Псов~
@33479 = ~«В таком случае, прощай».~
@33480 = ~Уйти.~
@33481 = ~«Ага! Хватит на новый ножик!»~
@33482 = ~«Слыхал, вчера ночью ты напоролся на Заточек».~
@33483 = ~«Ага, пошинковал их в капусту!»~
@33484 = ~«Хорошую кликуху себе выбрал Гнилой, а?»~
@33485 = ~«Да, от него гнилью несет, как от сборщика! Ха-ха-ха!»~
@33486 = ~«Все еще водишь шашни с той девчонкой-тифлингом?»~
@33487 = ~«Эй, не суй свой нос куда не надо, понял?»~
@33488 = ~«В последнее время здесь проходит маловато бестолковых пней».~
@33489 = ~«Ага. Я уж начал думать, не податься ли нам куда-нибудь с переулка за звенелками».~
@33490 = ~«С виду ты как будто валялся на помойке Старьевщиков!»~
@33491 = ~«Пошел к черту!»~
@33492 = ~«Фу! Пень, ты что, спишь со сборщиком?»~
@33493 = ~«А ты нюхаешь дырку в своей заднице, ублюдок!» ~
@33494 = ~«Силенок-то у тебя поменьше, чем у тленного, рубака!»~
@33495 = ~«Отвали, чертов недотепа!»~
@33496 = ~«Слышал, у Кристалл есть одна штучка для твоей задницы!»~
@33497 = ~«Вот как? Ну, тогда я обязательно ее прихвачу, прежде чем притащу тебе ее голову!»~
@33498 = ~«Эй, ты!»~
@33499 = ~«Там мой брат и мой парень... они дерутся! Просто повздорили немного, но я-то знаю, что они могут прирезать друг друга и глазом не моргнув! Помоги остановить их, прошу тебя!»~
@33500 = ~«Тысяча благодарностей, знаток! Они дерутся прямо тут!»~
@33501 = ~«Я дам тебе звенелки, знаток... у меня есть сто монет... только останови их!»~
@33502 = ~«Спасибо, рубака, что остановил драку. Я боялась, что они убьют друг друга. Не хочу потерять ни своего брата, ни моего любимого Майта».~
@33503 = ~Радость на лице девушки тут же пропадает. «Где мы, по-твоему находимся, рубака? В районе Леди? Все, что я зарабатываю, я трачу на пропитание моей семьи! Извини, но я не могу *наградить* тебя... моя благодарность — это все, что у меня есть». Девушка сердито отводит от тебя взгляд.~
@33504 = ~«Пожалуйста, рубака! Останови их!»~
@33505 = ~«Спасибо, рубака, что остановил драку. Я боялась, что они убьют друг друга. Не хочу потерять ни своего брата, ни моего любимого Майта».~
@33506 = ~Кивая, она снимает с себя потускневший серебряный браслет: «Держи, рубака... Это единственное мое сокровище. Но их жизни мне дороже...» Она горестно вздыхает.~
@33507 = ~Взгляд девушки проясняется. «Спасибо тебе, рубака! Да минует тебя тень Леди!»~
@33508 = ~«Спасибо еще раз, рубака, что остановил ту драку».~
@33509 = ~«В чем дело?»~
@33510 = ~«Извини, но это не моя проблема. Прощай».~
@33511 = ~«Я немедленно с ними переговорю...»~
@33512 = ~«Я могу остановить их, но не буду ничего делать за просто так...»~
@33513 = ~«Извини, но это не моя проблема. Прощай».~
@33514 = ~«Я вернусь, как только поговорю с ними».~
@33515 = ~«Я вернусь, как только поговорю с ними».~
@33516 = ~«Хотя, если подумать, это меня совсем не касается. Прощай».~
@33517 = ~«С этим не было никаких проблем. Прощай».~
@33518 = ~«Неплохо бы выразить признательность в иной форме...»~
@33519 = ~Уйти.~
@33520 = ~«Я попытаюсь...»~
@33521 = ~«Вообще-то, я решил, что это меня совсем не касается. Прощай».~
@33522 = ~«Был рад помочь. Прощай».~
@33523 = ~«Неплохо бы выразить признательность в иной форме...»~
@33524 = ~«Да-да, конечно. А теперь моя награда...»~
@33525 = ~«Постой... возьми его назад. Пусть браслет останется у тебя».~
@33526 = ~«Прощай».~
@33527 = ~«Конечно... Прощай».~
@33528 = ~«Нет проблем. Прощай».~
@33529 = ~Этот потрепанный головорез прямо-таки нарывается на неприятности.~
@33530 = ~Мужчина смотрит поверх тебя и сплевывает тебе под ноги. «Чего? Неприятностей захотелось, да?»~
@33531 = ~«Тем хуже для тебя, бедолага... Потому что ты на них нарвался!» Мужчина вынимает длинный нож...~
@33532 = ~«Приветствую...»~
@33533 = ~«Стой!»~
@33534 = ~Оставить его в покое.~
@33535 = ~«Ага... Готов?»~
@33536 = ~«Ну здравствуй, пень!»~
@33537 = ~«Нет... Просто у меня есть несколько вопросов...»~
@33538 = ~«Нет. Прощай».~
@33539 = ~«Это научит тебя не разрисовывать людей, пока те спят!»~
@33540 = ~Сражаться.~
@33541 = ~Сбежать.~
@33542 = ~Хмурая гримаса этого головореза похожа на гротескную маску. Когда ты подходишь к нему, он сужает глаза.~
@33543 = ~«Заткни свою глотку, ты уродский ублюдок! Тебе никто не разрешал говорить со мной! Свали, пока я не пустил тебе кровь!»~
@33544 = ~«Только попробуй — и у тебя появится парочка новых дырок».~
@33545 = ~«Приветствую...»~
@33546 = ~Оставить его в покое.~
@33547 = ~Уйти.~
@33548 = ~«Подвязки Шивы! *Это* еще что за вонючка?»~
@33549 = ~«Может, стоит обчистить этот жалкий труп и притащить его назад за награду, а?» Он смотрит на своего приятеля, водя бровями.~
@33550 = ~Мужчина поднимает брови. «Хе! Он сказал 'прочь с дороги'...»~
@33551 = ~Мужчина поднимает руки. «Погоди, рубака! Мы просто пошутили! Иди куда шел...»~
@33552 = ~Его лицо внезапно мрачнеет, губы искривляются в усмешке. «Посмотрим, как ты с этим справишься, труп!»~
@33553 = ~«Эй, чувак, хватит трясти черепушкой. Оставим в покое этого пня. Ну же».~
@33554 = ~Они оба достают ножи...~
@33555 = ~«Нет, болван! Он просто... просто...»~
@33556 = ~«Ого! Поглядите-ка на *это*!»~
@33557 = ~«Пф... Похоже, от трухлявых сбежал один из жмуриков!» Он злобно смеется.~
@33558 = ~«И *зачем* нам это делать, а?»~
@33559 = ~«Да, рубака... пошутили, просто пошутили».~
@33560 = ~Они оба достают ножи...~
@33561 = ~«Не нужны?! Что ж, очень жаль, потому что...»~
@33562 = ~«Не нужны?! Что ж, очень жаль, потому что ты только что на них нарвался!»~
@33563 = ~«Э... — он смотрит на своего приятеля. — Эй, чувак, тебе не кажется, что он и вправду...»~
@33564 = ~Мужчина отступает на шаг. «Чувак, дурная примета — связываться с жмуриком трухлявых... пошли-ка отсюда...» Они оба поворачиваются и поспешно отступают.~
@33565 = ~«Как забавно... а теперь прочь с дороги».~
@33566 = ~«Прочь с дороги, не то я прикончу вас обоих».~
@33567 = ~«Прочь с дороги, не то я прикончу вас обоих».~
@33568 = ~«Мне не нужны неприятности... просто дайте мне пройти».~
@33569 = ~«Мне не нужны неприятности... просто дайте мне пройти».~
@33570 = ~Простонать, как нежить: «У-у-у...»~
@33571 = ~Пусть уходят.~
@33572 = ~Сражаться с ними.~
@33573 = ~Сбежать.~
@33574 = ~Посмотреть на них голодным взглядом, пуская слюни.~
@33575 = ~«Прочь с дороги, не то я прикончу вас обоих».~
@33576 = ~«Прочь с дороги, не то я прикончу вас обоих».~
@33577 = ~«Просто дайте мне пройти. Мне не нужны неприятности».~
@33578 = ~«Просто дайте мне пройти. Мне не нужны неприятности».~
@33579 = ~«Потому что если вы этого не сделаете, я прикончу вас обоих».~
@33580 = ~«Потому что если вы этого не сделаете, я прикончу вас обоих».~
@33581 = ~«Потому что мне не нужны неприятности... просто дайте мне пройти».~
@33582 = ~«Потому что мне не нужны неприятности... просто дайте мне пройти».~
@33583 = ~«Ну что ж... Я все равно прикончу вас обоих».~
@33584 = ~Пусть уходят.~
@33585 = ~Драться с ними.~
@33586 = ~Сбежать.~
@33587 = ~Это один двух парней, кричащих друг на друга, и машущих перед собой оружием. Похоже, они в любой момент готовы вгрызться друг другу в глотки.~
@33588 = ~Раскрасневшее от метаемых проклятий лицо парня обращается к тебе. «Чего надо?! Не видишь, я *занят*, пустоголовый?»~
@33589 = ~«Не твое дело, пень. Отвали!»~
@33590 = ~«Нет, не можешь! Этот сукин сын сует свой вонючий нос в наши с Элис отношения, но теперь-то я этот нос укорочу маленько! Тебя это не касается, так что держись в сторонке!»~
@33591 = ~Парень неожиданно затихает. «Элис тебя позвала, да? Не знаю, кто ты такой, пень, но что-то не пойму, как это ты вдруг решил нас остановить!»~
@33592 = ~«Что, ты *рехнулся*, рубака? Погляди на себя... может ты и весь шрамах, да только меня этим не напугаешь! Хватит трясти черепушкой и *свали* отсюдова!»~
@33593 = ~«Не лезь не в свое дело! Иди, окунись в куче навоза, пень!»~
@33594 = ~Парень быстро оглядывает тебя с ног до головы. «Э-э-э... ну это... Конечно же, всяко лучше нам с этим бедолагой переговорить насчет этого. Да и Элис будет рада...»~
@33595 = ~Немного похмурившись, парень кивает головой. «Да, ты прав, рубака... Я хотел с ним подраться, чтобы вырвать ее из тени братца. А теперь становлюсь не лучше, чем он, — вздыхает он. — Наверное, стоит решить проблему с этим бедолагой по-другому...»~
@33596 = ~Возлюбленный Элис, кивая, улыбается тебе. «Спасибо, что вмешался в нашу драку... Ты очень порядочный рубака».~
@33597 = ~«Спасибо. Прощай».~
@33598 = ~«Приветствую...»~
@33599 = ~Держаться от них на расстоянии.~
@33600 = ~«Твоя девушка попросила меня остановить вас обоих».~
@33601 = ~«Мне интересно, почему вы деретесь».~
@33602 = ~«Тогда прощай». ~
@33603 = ~«Твоя девушка попросила меня остановить вас обоих».~
@33604 = ~«Может быть, я смогу разрешить спор?»~
@33605 = ~«Тогда прощай». ~
@33606 = ~«Твоя девушка попросила меня остановить вас обоих».~
@33607 = ~«Тогда прощай». ~
@33608 = ~«Жестоко избив вас обоих, если придется».~
@33609 = ~«Жестоко избив вас обоих, если придется».~
@33610 = ~«Жестоко избив вас обоих, если придется».~
@33611 = ~«Жестоко избив вас обоих, если придется».~
@33612 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33613 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33614 = ~«Да я и не собирался. Прощай».~
@33615 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33616 = ~«Послушай, Элис не хочет, чтобы вы поранили друг друга... Вы что, не можете разобраться в проблеме, не причиняя ей страданий?»~
@33617 = ~«Отлично... Прощай».~
@33618 = ~«Хватит драться или я жестоко изобью вас обоих».~
@33619 = ~«Хватит драться или я жестоко изобью вас обоих».~
@33620 = ~«Хватит драться или я жестоко изобью вас обоих».~
@33621 = ~«Хватит драться или я жестоко изобью вас обоих».~
@33622 = ~«Отлично... Прощай».~
@33623 = ~«Рад, что ты подходишь к проблеме с этой стороны. Прощай».~
@33624 = ~«Рад, что ты подходишь к проблеме с этой стороны. Прощай».~
@33625 = ~Это один из двух парней, кричащих друг на друга и машущих оружием. Похоже, они в любой момент готовы вгрызться друг другу в глотки.~
@33626 = ~Раскрасневшее от перенапряжения в перепалке лицо парня обращается к тебе. «Чего надо?! Не видишь, я *занят*, пустоголовый?»~
@33627 = ~«Не твое дело, пень. Отвали!»~
@33628 = ~«Нет, не можешь! Этот сукин сын мешает мою сеструху с *грязью*, но теперь-то он за это поплатится! Тебя это не касается, так что держись в сторонке!»~
@33629 = ~Парень неожиданно затихает. «Элис тебя позвала, да? Не знаю, кто ты такой, пень, но что-то не пойму, как это ты вдруг решил нас остановить!»~
@33630 = ~«Ты что, *рехнулся*, рубака? Погляди на себя... может, ты и весь шрамах, да только меня этим не напугаешь! Хватит трясти черепушкой, *сваливай* отсюдова!»~
@33631 = ~«Не лезь не в свое дело! Иди, окунись в кучу навоза, пень!»~
@33632 = ~Парень быстро оглядывает тебя с ног до головы. «Э-э-э... ну это... Конечно же, всяко лучше нам с этим бедолагой переговорить насчет этого. Да и Элис будет рада...»~
@33633 = ~Немного похмурившись, парень кивает головой. «Да, ты прав, рубака... Я хотел защитить ее интересы, а вышло так, что совсем о ней не подумал, — он вздыхает. — Наверное, стоит решить проблему с этим бедолагой по-другому...»~
@33634 = ~Брат Элис доброжелательно кивает тебе: «Спасибо, что помог с тем делом... ты хороший рубака».~
@33635 = ~«Приветствую...»~
@33636 = ~«Приветствую...»~
@33637 = ~Держаться от них на расстоянии.~
