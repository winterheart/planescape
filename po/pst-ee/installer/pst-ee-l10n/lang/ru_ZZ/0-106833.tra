@8904 = ~«И Даккон — *зерт*?»~
@8905 = ~«Понятно. У меня есть другие вопросы...» ~
@8906 = ~«Понятно. У меня есть другие... конкретные... вопросы...»~
@8907 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8908 = ~«Да?»~
@8909 = ~Подождать, пока он объяснит.~
@8910 = ~«Неважно. У меня есть другие вопросы...»~
@8911 = ~«Неважно. У меня есть другие... конкретные... вопросы...»~
@8912 = ~«Неважно. Извини, что побеспокоил тебя».~
@8913 = ~«Понятно. У меня есть другие вопросы...» ~
@8914 = ~«Понятно. У меня есть другие... конкретные... вопросы...»~
@8915 = ~«Спасибо... Это все, что я хотел узнать. Прощай».~
@8916 = ~«Род Зеркай шлет тебе поклон».~
@8917 = ~«Приветствую, звенящий мечом».~
@8918 = ~«Приветствую».~
@8919 = ~«Приветствую».~
@8920 = ~«Приветствую».~
@8921 = ~Оставить гита в покое.~
@8922 = ~«И путник доволен».~
@8923 = ~«Я хотел бы узнать этот город. Выслушаешь меня?»~
@8924 = ~Оставить гита в покое.~
@8925 = ~«Я хотел бы узнать этот город. Выслушаешь меня?»~
@8926 = ~Оставить гита в покое.~
@8927 = ~«Хорошо. У меня есть другие вопросы...»~
@8928 = ~Оставить его в покое.~
@8929 = ~«Род Зеркай шлет тебе поклон».~
@8930 = ~«Приветствую, звенящий мечом».~
@8931 = ~«Приветствую».~
@8932 = ~«Приветствую».~
@8933 = ~Оставить гита в покое.~
@8934 = ~«Э... что он говорит, Даккон?»~
@8935 = ~«Не бери в голову, Даккон. Пошли».~
@8936 = ~«Даккон, ты можешь задать ему пару вопросов для меня?»~
@8937 = ~«Не бери в голову, Даккон. Пошли».~
@8938 = ~Не отвечать.~
@8939 = ~«Хорошо. У меня есть другие вопросы...»~
@8940 = ~Оставить его в покое.~
@8941 = ~Подождать ответ Даккона.~
@8942 = ~«Даккон, забудь об этом. Пошли».~
@8943 = ~Попытаться перевести...~
@8944 = ~«Даккон, забудь об этом. Пошли».~
@8945 = ~Подождать ответ Даккона.~
@8946 = ~«Даккон, забудь об этом. Пошли».~
@8947 = ~Прервать: «Даккон повинуется. Он мой раб».~
@8948 = ~Прервать: «Да, Даккон получает от меня приказы. Он мой слуга».~
@8949 = ~Прервать: «Я его лидер. Даккон следует за мной в моем путешествии».~
@8950 = ~Посмотреть, что скажет Даккон...~
@8951 = ~Посмотреть, что скажет Даккон...~
@8952 = ~«Даккон, забудь об этом. Пошли».~
@8953 = ~Слушать.~
@8954 = ~«Даккон, забудь об этом. Пошли».~
@8955 = ~«Этот твой взгляд начинает меня злить. Так, обращайся ко мне, а не к моему рабу. Ты будешь отвечать на мои вопросы или нет?»~
@8956 = ~«Я бы предпочел, чтобы ты обращался ко мне, а не к моему товарищу. Ты ответишь на мои вопросы или нет?»~
@8957 = ~«Что-то не так?»~
@8958 = ~«Не бери в голову, Даккон. Пошли».~
@8959 = ~«Испугался, пес гитьянки? Нападай, если посмеешь».~
@8960 = ~«Испугался, пес гит? Нападай, если посмеешь».~
@8961 = ~Пусть уходит.~
@8962 = ~Напасть на гита, пока он собирается уйти.~
@8963 = ~«Говори со мной, а не с ним, гит».~
@8964 = ~«Что-то не так?»~
@8965 = ~Посмотреть, что скажет Даккон.~
@8966 = ~«Не бери в голову, Даккон. Пошли».~
@8967 = ~«Давай. Нападай на меня, гит. Посмотрим, что будет дальше».~
@8968 = ~«Если он сделает еще хоть шаг ко мне, Даккон, я хочу, чтобы ты его убил».~
@8969 = ~«Успокойтесь вы оба. Я просто хочу задать пару вопросов».~
@8970 = ~Посмотреть, что скажет Даккон...~
@8971 = ~Посмотреть, что скажет Даккон...~
@8972 = ~Напасть на гита, пока он отвлекся.~
@8973 = ~«Давай, пес гитьянки. Нападай, если осмелишься».~
@8974 = ~«Давай, пес гит. Нападай, если осмелишься».~
@8975 = ~Подождать и посмотреть, чем это закончится...~
@8976 = ~Подождать и посмотреть, чем это закончится...~
@8977 = ~Напасть на гита, пока он отвлекся.~
@8978 = ~«Род Зеркай шлет тебе поклон».~
@8979 = ~«Приветствую, звенящий мечом».~
@8980 = ~«Приветствую».~
@8981 = ~Оставить гита в покое.~
@8982 = ~Ложь: «Ты спрашиваешь человека, путешествующего с *зертом*-гитцераем, убивал ли он гитцераев? Должно быть, ты обознался».~
@8983 = ~Ложь: «Должно быть, это ошибка. Я ни разу не нападал на представителей вашего народа».~
@8984 = ~Ложь: «Я ни на кого не нападал. Наверно, ты спутал меня с кем-то».~
@8985 = ~Напасть на него первым.~
@8986 = ~Не обращать внимания на гита и уйти.~
@8987 = ~Ложь: «Послушай, это огромный город. Я не тот, кого ты ищешь. Я не желаю зла ни тебе, ни твоему народу».~
@8988 = ~Напасть на него первым.~
@8989 = ~«Вообще-то, ты тогда был прав. Я просто ждал, пока ты утратишь бдительность...»~
@8990 = ~«Вообще-то, ты тогда был прав. Я просто ждал, пока ты утратишь бдительность...»~
@8991 = ~«Уж постарайся. Прощай».~
@8992 = ~«Даккон, скажи ему, что он ошибся».~
@8993 = ~Напасть на него, пока он смотрит на Даккона.~
@8994 = ~«О, да, это так. Знай свое место, Даккон. Ты мой раб, и *будешь* мне подчиняться».~
@8995 = ~«О, да, это так. Я больше не в силах стоять здесь и слушать, как вы, гитские собаки, лаете друг на друга».~
@8996 = ~«Если я тебя оскорбил, прошу прощения. Ты простишь меня?»~
@8997 = ~«Неважно, Даккон. Идем».~
@8998 = ~Посмотреть, что предпримет гит.~
@8999 = ~«Мы заодно, гит. Советую тебе сдаться».~
@9000 = ~«Еще один шаг в мою сторону, гит, и он нападет на тебя. Если пройдешь через него, клянусь, я тебя убью. А теперь сдавайся».~
@9001 = ~«Довольно. Пришло время тебе умереть, гит».~
@9002 = ~Посмотреть, что предпримет гит.~
@9003 = ~«Мы заодно, гит. Советую тебе сдаться. Прошу тебя в последний раз».~
@9004 = ~«Еще один шаг в мою сторону, гит, и он нападет на тебя. Если пройдешь через него, клянусь, я тебя убью. А теперь сдавайся».~
@9005 = ~«Довольно. Пришло время тебе умереть, гит».~
@9006 = ~Подождать...~
@9007 = ~«Выбор за тобой, гит. Ты хочешь, чтобы сегодня тут была пролита кровь?»~
@9008 = ~«Довольно. Пришло время тебе умереть, гит».~
@9009 = ~«Что он сказал, Даккон?»~
@9010 = ~«Даккон, брось. Пошли».~
@9011 = ~Слушать.~
@9012 = ~«Даккон, брось. Пошли».~
@9013 = ~Слушать.~
@9014 = ~«Даккон, брось. Пошли».~
@9015 = ~Подождать.~
@9016 = ~«Даккон, брось. Пошли».~
@9017 = ~«Ты мог бы его спросить...»~
@9018 = ~«Даккон, брось. Пошли».~
@9019 = ~«Видишь? Теперь ты опустишь свой клинок?»~
@9020 = ~Напасть на гита, пока он смотрит на Даккона.~
@9021 = ~«Что он сказал?»~
@9022 = ~«Неважно, Даккон. Идем».~
@9023 = ~«Это гит?»~
@9024 = ~«Это гит?»~
@9025 = ~«Я пока еще не готов уйти. Сначала я задам ему пару вопросов...»~
@9026 = ~Оставить гита в покое.~
@9027 = ~«Я пока еще не готов уйти. Сначала я задам ему пару вопросов...»~
@9028 = ~Оставить гита в покое.~
@9029 = ~«Это гит?»~
@9030 = ~«Это гит?»~
@9031 = ~«Я пока еще не готов уйти. Сначала я задам ему пару вопросов...»~
@9032 = ~Оставить гита в покое.~
@9033 = ~«Я пока еще не готов уйти. Сначала я задам ему пару вопросов...»~
@9034 = ~Оставить гита в покое.~
@9035 = ~«Я пока еще не готов уйти. Сначала я задам ему пару вопросов...»~
@9036 = ~Оставить гита в покое.~
@9037 = ~Отойти в сторону и позволить ему пройти.~
@9038 = ~Крэддок~
@9039 = ~Пьяница~
@9040 = ~Железная Гвоздинка~
@9041 = ~Профира~
@9042 = ~Чернорабочий~
@9043 = ~Креден~
@9044 = ~Посетитель «Тлеющего трупа»~
@9045 = ~Бариавр~
@9046 = ~Гит-торговец~
@9047 = ~Вонючий житель Улья~
@9048 = ~Торговец из Улья~
@9049 = ~Надсмотрщик~
@9050 = ~Оружейник~
@9051 = ~Мусорщик из Улья~
@9052 = ~Пьяница~
@9053 = ~Гадалка~
@9054 = ~Цеховой бригадир~
@9055 = ~Женщина, похожая на ведьму~
@9056 = ~Человек с диким взглядом~
@9057 = ~Фрактор боголюдей~
@9058 = ~Чернорабочий~
@9059 = ~Посетитель, убийца милосердия~
@9060 = ~Несколько мгновений дух удовлетворенно улыбается. Он собирается, закладывает одну руку за спину и начинает тихо, нараспев декламировать:

«Сян цзянь ши нань, бе и нань
Дун фэн у ли, бай хуа цань
Чунь цань дао сы, сы фань цзинь
Да цзю чэн хуй, лэй ши гань».

Сказав это, он принимает довольный вид, терпеливо ожидая твоей реакции.~
@9061 = ~Ты открываешь рот, чтобы задать вопрос, но дух опережает тебя, начав тихо, нараспев декламировать:

«Сян цзянь ши нань, бе и нань
Дун фэн у ли, бай хуа цань
Чунь цань дао сы, сы фань цзинь
Да цзю чэн хуй, лэй ши гань».

Сказав это, он принимает довольный вид, терпеливо ожидая твоей реакции.~
@9062 = ~Дух на некоторое время умолкает, словно чтобы поразмыслить. Затем он начинает говорить, с сильным акцентом, и все же с весьма изысканным произношением. «Прости меня, достопочтенный господин. Прошло немало времени с тех пор, как я говорил на твоем языке. Не сомневаюсь, что мой дух был призван сюда, чтобы отвечать на твои вопросы. Что же ты хотел узнать от меня?»~
@9063 = ~«Трудно объяснить, кто я... а вот кем я *был* — нет. Я был известен как Чжуань Бэй, наставник и телохранитель Лю Сиси, дочери Цензора Ши-аня».~
@9064 = ~«Я родом из места под названием Шоу Лунь... места, которое я когда-то считал центром вселенной» Похоже, на него накатили теплые воспоминания. «Столько мест, столько миров. Раньше я считал себя довольно образованным человеком, и все же перед смертью я знал слишком мало...»~
@9065 = ~«Я был убит одним из тех, с кем я попал в этот мир. Я охотился за ним в этом городе многие недели — за это время я успел изучить ваш язык, — но он нашел меня первым. Он профессиональный убийца; он застигнул меня врасплох и убил меня во сне».~
@9066 = ~«Об этом здании? Совершенно ничего. Я слышал о нем, знаю, что мое тело работает здесь, но это все». «Я довольно мало знаю об этом великом городе, 'Сигиле'. Недели, проведенные здесь, я потратил на поиски людей, с которыми попал в этот мир, и на изучение языка; хоть это и огорчало меня, но времени на другие вещи у меня не было. А ведь я мог познать мириады чудес этого места...»~
@9067 = ~«Нет, это имя ничего для меня не значит. Я прошу прощения, но в данном вопросе я тебе не помощник».~
@9068 = ~На миг тебе кажется, что дух огорчен.

«Я... Мой дух находится во владениях прославленного магистрата Яньвана, в Дворце Правосудия».~
@9069 = ~«Да. Там, откуда я родом, это встречается не так уж редко. Моей обязанностью было все время находиться рядом с госпожой Лю, и не только оберегать ее, но и обучать. Я был уважаемым учителем, а также фехтовальщиком. Возможно, я послужил бы ей лучше, будь я лучшим фехтовальщиком...»~
@9070 = ~«Впечатляюще? Да, как для меня, то даже слишком. Я... я подвел госпожу Лю и Цензора в своей миссии».~
@9071 = ~Дух кивает с неожиданной грацией, как для иссохшего трупа. «Пожалуйста, спрашивай все, что пожелаешь».~
@9072 = ~«Ну, видишь ли... — дух на время умолкает в раздумьях, потирая иссохшие руки трупа. — Прибыв туда, после недолгого ожидания меня должны были сопроводить в мое конечное, *истинное* место назначения. Тем не менее, пока меня вели по дворцу, началась какая-то суматоха, и меня оставили в комнате, пообещав, что тотчас же вернутся».~
@9073 = ~«Я расскажу тебе всю историю. Как наставник и телохранитель Лю Сиси, я, конечно же, отвечал за ее безопасность и образование. Одним ясным вечером мы стояли на балконе, выходившем во внутренний двор, где я показывал ей различные созвездия».~
@9074 = ~«Ах, это. Однажды ночью я встретил на улице девушку. Она принадлежала к организации под названием Тленные, той самой, что присматривает за этим комплексом».
«Она сделала мне предложение, согласно которому в обмен за небольшую сумму мое тело может быть... использовано... здесь после моей кончины».
~
@9075 = ~«На самом деле, лингвистика всегда представляла для меня большой интерес. Будучи студентом, я обнаружил, что могу без особых проблем изучать новые наречия».~
@9076 = ~«Видишь ли... за мной так никто и не вернулся. Я терпеливо ждал несколько дней, но безуспешно. В конце концов, я покинул комнату и стал бродить по дворцу в надежде на то, что кто-нибудь проведет меня...» Он тихо вздыхает, выдыхая легкое облачко бальзамирующей жидкости. «Там 9001 комната, и в каждой из них меня направляли в другую. Я словно навеки попал в трясину».~
@9077 = ~«Не могу сказать. Все это сильно огорчает меня!» Он умолкает, чтобы восстановить самообладание. При этом его закостеневшие суставы и сухожилия тихонько поскрипывают. ~
@9078 = ~«Да-да, конечно. Пока мы стояли, с крыши над балконом внезапно спрыгнули двое убийц, скорее всего, чтобы убить или похитить госпожу Лю. Позвав стражу, я обнажил свой клинок и бросился на ее защиту. В разгар битвы перила балкона обломились, и мы вчетвером упали в Нефритовый Портал».~
@9079 = ~«Пожалуй, только сначала... В конце концов, эта идея немного жутковата. Но поговорив с ней немного, я понял, что они, тленные, разделяют со мной взгляды на смерть. Мое тело? Это всего лишь оболочка, не более. Я верю, что их 'Истинная Смерть' будет тем достойным местом, которого лично я когда-нибудь достигну... полностью освободившись и отделившись от материального мира. И если мое тело, служившее этой цели в качестве моей смертной оболочки, сможет служить здесь каким-нибудь целям, тем лучше». Дух учтиво улыбается тебе.~
@9080 = ~«О! Прошу прощения за упущение... Нефритовый Портал — это круглый водоем во внутреннем дворе. Он выложен зелеными и белыми стеатитами и назван Порталом из-за того, что время от времени в отражении его мерцающих вод можно увидеть совершенно другое место».~
@9081 = ~«Твое предложение великодушно. Но я боюсь, что здесь ничего нельзя поделать... Я уверен, что со временем все-таки найду свой путь. Так или иначе, благодарю тебя».~
@9082 = ~Дух недовольно смотрит на тебя, в глазах трупа вспыхивает призрачный огонек. Кажется, ты его оскорбил.~
@9083 = ~«Ах, это... э-э... это стихи. Трудно перевести. Может, есть другой вопрос?» Он неловко улыбается.~
@9084 = ~«Как я уже сказал, мы упали в Нефритовый Портал. Я даже и не предполагал, что он *на самом* деле был порталом, во всех смыслах этого слова, и все же это так! Неожиданно я очутился в незнакомом переулке, лежащий со сломанной ногой. Придя в себя, я успел увидеть, как убийцы убегают, унося на плечах Лю Сиси».~
@9085 = ~«Хорошо». Он ненадолго задумывается, барабаня длинными костлявыми пальцами трупа. Затем он начинает декламировать в более твердом, выверенном ритме:

«Как встречаться нам тяжело, так тяжело расставаться.
Ветер жизни лишился сил, все цветы увядают.
Лишь когда шелкопряд умрет, нити дум прекратятся.
Лишь когда фитиль догорит, слезы свечи иссякнут».

Он учтиво улыбается тебе.~
@9086 = ~«Ну, мне стыдно признаться, но это было деликатной попыткой сказать... сказать, что, наверно, лучше бы тебе оставить в покое души мертвых. У меня больше нет желания быть частью этого, — дух делает широкий жест, охватывая все, что находится вокруг него, — мира».~
@9087 = ~«А... э-э... нет. Я не хотел быть столь прямолинеен, чтобы избежать конфронтации. Это всего лишь означает, что у меня нет больше желания быть частью этого, — дух делает широкий жест, охватывая все, что находится вокруг него, — мира».~
@9088 = ~«Ну, это почти все. Мне пришлось хромать с болью в ноге, пока я не нашел того, кто вылечил мою ногу. Он взял в качестве платы все те небольшие накопления, что у меня были. У этого целителя и у других людей я научился здешнему языку, не переставая разыскивать двух убийц и свою подопечную».~
@9089 = ~«Я поймал одного из них, но он не пожелал говорить. Я казнил его и положил его голову в шелковый мешок, чтобы преподнести ее Цензору, когда я вернусь назад с его дочерью, — на миг он мрачнеет, потом продолжает. — Другой убийца... ускользнул от меня. Даже больше: он убил меня, прежде чем я смог убить его и спасти свою подопечную. Мне жаль, но теперь для меня уже все кончено».~
@9090 = ~«Нет, но я был уверен, что смог бы найти способ. Хотя теперь это под сомнением».~
@9091 = ~«Твое предложение отличает в тебе благородного человека... тем не менее, прошло не меньше семидесяти пяти лет с тех пор, как я был убит. Человек, убивший меня, давно уже мертв, и Сиси, скорее всего, тоже».~
@9092 = ~«Убийца похож на меня внешне, над бровью у него татуировка лотоса». Заметив твое смятение, он добавляет: «Это такой цветок с семью лепестками. Лю Сиси — это молодая девушка, ей всего лишь четырнадцать лет. Возможно, она или убийца знают путь назад и как снова активировать портал».~
@9093 = ~«Ты добрый и благородный человек. Однако не делай этого для меня... девушка и ее отец — вот кому нужна твоя помощь».~
@9094 = ~«Я определенно не ожидал увидеть тебя снова, — дух учтиво кланяется, но его лицо остается непроницаемым. — Что тебе нужно от меня?»~
@9095 = ~Оставить труп в покое.~
@9096 = ~«У меня есть вопросы...» ~
@9097 = ~Оставить духа.~
@9098 = ~«Я... э-э...»~
@9099 = ~«Я понятия не имею, о чем ты говоришь... Ты вообще понял, что я говорю?»~
@9100 = ~«Я не понимаю тебя. Прощай».~
@9101 = ~«Я... э-э...»~
@9102 = ~«Я понятия не имею, о чем ты говоришь... Ты вообще понял, что я говорю?»~
@9103 = ~«Я не понимаю тебя. Прощай».~
@9104 = ~«Так кто ты?»~
@9105 = ~«Откуда ты?»~
@9106 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9107 = ~«Где ты... где находится твой дух... сейчас?»~
@9108 = ~«Что ты знаешь об этом месте?»~
@9109 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9110 = ~«Ничего, неважно».~
@9111 = ~«Наставник *и* телохранитель?»~
@9112 = ~«Хм-м. Звучит впечатляюще».~
@9113 = ~«Понятно. У меня есть другие вопросы...»~
@9114 = ~«Это все, что я хотел узнать. Прощай».~
@9115 = ~«А как ты попал сюда из этого 'Шоу Луня'?»~
@9116 = ~«Понятно. У меня есть другие вопросы...»~
@9117 = ~«Это все, что я хотел узнать. Прощай».~
@9118 = ~«Попал в этот мир?»~
@9119 = ~«Охотился за убийцами?»~
@9120 = ~«Понятно, но ты знаешь, как твое тело стало здесь работать?»~
@9121 = ~«Ты говоришь достаточно хорошо для того, кто так недолго изучал язык».~
@9122 = ~«Понятно. У меня есть другие вопросы...»~
@9123 = ~«Это все, что я хотел узнать. Прощай».~
@9124 = ~«Твое тело служит здесь? Как это могло случиться?»~
@9125 = ~«Попал в этот мир?»~
@9126 = ~«Ты говоришь достаточно хорошо для того, кто так недолго изучал язык».~
@9127 = ~«Понятно. У меня есть другие вопросы...»~
@9128 = ~«Хорошо. Возможно, мы еще встретимся».~
@9129 = ~«Понимаю. У меня еще вопросы...»~
@9130 = ~«Хорошо. Возможно, мы еще встретимся».~
@9131 = ~«Что-то не так? Это плохое место?»~
@9132 = ~«Понимаю. У меня еще вопросы...»~
@9133 = ~«Это все, что я хотел узнать. Прощай».~
@9134 = ~«Послужить ей лучше? Ты чем-то ей не услужил?»~
@9135 = ~«Возможно. У меня есть еще вопросы...»~
@9136 = ~«Это все, что я хотел узнать. Прощай».~
@9137 = ~«Каким образом?»~
@9138 = ~«У меня есть еще вопросы...» ~
@9139 = ~«Ясно. Возможно, мы еще встретимся».~
@9140 = ~«Так кто ты?»~
@9141 = ~«Откуда ты?»~
@9142 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9143 = ~«Где ты... где находится твой дух... сейчас?»~
@9144 = ~«Что ты знаешь об этом месте?»~
@9145 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9146 = ~«Что ты сказал, когда впервые появился здесь?»~
@9147 = ~«Неважно. Прощай».~
@9148 = ~«И?..»~
@9149 = ~«Конечное место назначения? Куда тебя послали?»~
@9150 = ~«Постой... Перед тем, как ты продолжишь, у меня есть еще вопросы...»~
@9151 = ~«Возможно, я выслушаю оставшуюся часть в другой раз. Прощай».~
@9152 = ~«Пожалуйста, продолжай».~
@9153 = ~«Наставник *и* телохранитель?»~
@9154 = ~«Возможно, я выслушаю оставшуюся часть в другой раз. Прощай».~
@9155 = ~«И это не кажется тебе немного странным?»~
@9156 = ~«Понятно. Еще вопрос, если можно...»~
@9157 = ~«Это все, что я хотел узнать. Прощай».~
@9158 = ~«Тогда это все объясняет. Еще один вопрос...»~
@9159 = ~«Понятно. Спасибо за разговор. Прощай».~
@9160 = ~«Понятно. Тогда у меня есть другой вопрос...»~
@9161 = ~«Я могу чем-нибудь помочь?»~
@9162 = ~«Несчастный глупец... Представляю, как долго тебе придется там бродить!»~
@9163 = ~«Желаю тебе удачи. Прощай».~
@9164 = ~«Пожалуйста, продолжай свой рассказ».~
@9165 = ~«Могу себе представить... У меня есть другой вопрос...»~
@9166 = ~«Возможно, я выслушаю оставшуюся часть в другой раз. Прощай».~
@9167 = ~«Куда? В Нефритовый Портал?»~
@9168 = ~«Постой... Перед тем, как ты продолжишь, у меня есть еще вопросы...»~
@9169 = ~«Возможно, я выслушаю оставшуюся часть в другой раз. Прощай».~
@9170 = ~«Мне ясны твои доводы. Еще один вопрос...»~
@9171 = ~«Интересно. Теперь мне лучше уйти. Прощай».~
@9172 = ~«Понятно. Пожалуйста, продолжай свой рассказ».~
@9173 = ~«Перед тем, как ты продолжишь, у меня есть другие вопросы...»~
@9174 = ~«Пока это все, что я хотел знать. Прощай».~
@9175 = ~«Несомненно. У меня еще вопрос...»~
@9176 = ~«Не стоит беспокоиться. Теперь мне лучше уйти. Прощай».~
@9177 = ~«Прошу прощения. Можно спросить тебя кое-что еще?»~
@9178 = ~Отойти, оставить парящего духа.~
@9179 = ~«Да... да, конечно же».~
@9180 = ~«Нет... но я хотел бы побольше знать об этих стихах».~
@9181 = ~«Нет. Собственно, пожалуй, мне уже пора идти. Прощай».~
@9182 = ~«Очень странно. Пожалуйста, продолжай».~
@9183 = ~«Перед тем, как ты продолжишь, я хотел бы задать другие вопросы...»~
@9184 = ~«Понятно. Спасибо тебе, но мне уже пора».~
@9185 = ~«Ах... У меня есть другой вопрос».~
@9186 = ~«Интересно. А что это означает?»~
@9187 = ~«Значит, говоришь, я должен оставить твой дух в покое? Я оскорбил тебя, вызвав сюда?»~
@9188 = ~«О. Спасибо, что разъяснил мне это. Прощай».~
@9189 = ~«Хм-м. Ясно. У меня есть еще кое-какие вопросы».~
@9190 = ~«Я понимаю. В таком случае, прощай».~
@9191 = ~«Хм-м. Ясно. У меня есть еще кое-какие вопросы...»~
@9192 = ~«Я понимаю. В таком случае, прощай».~
@9193 = ~«Значит, ты их не нашел?»~
@9194 = ~«Хм-м. Знаешь, довольно странно, что ты смог так быстро изучить язык...»~
@9195 = ~«Перед тем, как ты продолжишь, я хотел бы задать другие вопросы...»~
@9196 = ~«Я выслушаю оставшуюся часть истории в другой раз. Прощай».~
@9197 = ~«А ты хоть знал, как вернуться назад, на родину, если бы спас эту... 'Сиси'?»~
@9198 = ~«Занятная история. Тем не менее, у меня есть еще вопросы...»~
@9199 = ~«Восхитительно. Теперь мне следует оставить тебя. Прощай».~
@9200 = ~«Возможно, они все еще в городе. Может быть, я смогу найти и спасти эту девушку».~
@9201 = ~«Похоже, тебе легко забыть о своем долге только лишь потому, что ты мертв. Не представляю, как бы я смог допустить подобное».~
@9202 = ~«Интересно. Позволь мне спросить кое о чем еще...»~
@9203 = ~«Хм-м. Мне пора. Удачи тебе».~
@9204 = ~~
@9205 = ~«Хм-м. Тогда неважно. У меня есть другой вопрос...»~
@9206 = ~«Тогда неважно. Прощай».~
@9207 = ~«Если встречу ее — сделаю все, что в моих силах, чтобы помочь ей — в память о тебе».~
@9208 = ~«Неважно. У меня нет времени на это».~
@9209 = ~«Хорошо. У меня есть другой вопрос...»~
@9210 = ~«Это все, что мне нужно. Прощай».~
@9211 = ~«Хорошо. У меня еще один вопрос...»~
@9212 = ~«Я понимаю. Прощай, дух».~
@9213 = ~«Вопрос...»~
@9214 = ~«Ничего, я оставляю тебя в покое».~
@9215 = ~Контракт Смерти Ангиара~
@9216 = ~Полэкс~
@9217 = ~Кулон Йемета~
@9218 = ~Фальшивый Контракт Смерти~
@9219 = ~Контракт Смерти Медноглазого~
@9220 = ~Отпугнуть нежить~
@9221 = ~Пробное описание~
@9222 = ~Несчастное место~
@9223 = ~0100dab1~
@9224 = ~Внезапно дух обращает на тебя внимание. Он сверкает обезоруживающе-дружелюбной улыбкой, разрывая при этом все швы на рту. Удивившись, он касается руками своих губ, затем пожимает плечами и приветственно кивает. «Где... где я? Какое странное место. Я тебя знаю?» Он осторожно кашляет, потирая окоченевшую глотку.~
@9225 = ~Дружелюбность духа моментально испаряется. Он хмурится, разорванные швы лохмотьями свешиваются с его серых иссохших губ. «Хорошо, спрашивай, что хотел». Он отстраняет взгляд: ему явно скучно.~
@9226 = ~«Меня зовут Асонж. Я могу уйти?»~
@9227 = ~«Не могу вспомнить. Что-нибудь еще?»~
@9228 = ~Дух пожимает плечами и смотрит вверх. «Точно не скажу. Да и какая вообще разница?» Он печально сжимает свои губы и бросает на тебя тяжелый взгляд; призрачные искорки в его глазах сверкают гневом. «Что-нибудь еще?»~
@9229 = ~«Мой дух на Арборее... — он на минуту умолкает, теряясь в теплых воспоминаниях. — В данный момент я жажду вернуться домой, подальше от твоего эгоистичного, самовольного и довольно скучного любопытства. Могу ли я вернуться?»~
@9230 = ~Дух окидывает тебя раздраженным взглядом. «Нет, конечно же!» Он раздосадовано мотает головой, от этого движения разорванные швы качаются туда-сюда.~
@9231 = ~«Нет». Похоже, ты мало его интересуешь.~
@9232 = ~Дух шумно вздыхает, наполняя воздух запахом формальдегида из легких трупа. «Да-да... спрашивай».~
@9233 = ~«Тебе, дорогой мой приятель, остается только предполагать, как и мне. Мне уже пора, если ты не против».~
@9234 = ~Он немного обдумывает это, затем начинает хохотать. «Да! Это все объясняет, не так ли? Постой, я знаю тебя?» Он склоняет голову набок, внимательно смотря на тебя. Похоже, для него опознание твоей личности — своего рода увлекательная игра.~
@9235 = ~Дух пожимает плечами и улыбается, слегка посмеиваясь. «Возможно, ты прав! Что ты хочешь узнать от меня?» Он начинает рассеянно вытягивать остатки швов из своих губ и бросать их на пол, один за одним. ~
@9236 = ~«Меня зовут Асонж. А как тебя?»~
@9237 = ~«Я отовсюду! По правде говоря, я не знаю, откуда я родом. В жизни я много путешествовал, и могу назвать своим домом многие места. Сейчас передо мной Арборея...» Дух выглядит довольным.~
@9238 = ~Улыбка духа угасает, и он на мгновенье выглядит озадаченным. «Странно... Я не знаю! Я точно не знаю, как умер, правда, — он пожимает плечами. — Неважно!» Его радостная улыбка возвращается, сверкая даже несмотря на то, что она находится на высохшем лице трупа.~
@9239 = ~«В Арборее! О более удивительном месте я и не мечтал. Нигде в моей смертной жизни я встречал места, столь чувственного... столь величественного... — он умолкает, теряясь в приятных воспоминаниях. — Прекрасные земли, прекрасный народ. Если честно, я уже скучаю по ней!»~
@9240 = ~«Не так уж и много. Я подписал контракт с тленной, подчинившись внезапному порыву... Она показала мне какое-то ужасное место, и сказала, что мое тело будет поднято и использовано в качестве работника. Я подумал: ведь оно мне не понадобится, когда я перейду в следующую жизнь, так почему бы и нет? Можно перехватить немного серебра и потратить его на женщин и вино!» Он тихонько смеется от этой мысли, в его глазах сверкают веселые призрачные искорки.~
@9241 = ~Дух на минуту задумывается. «Нет, боюсь, что не слышал об этом человеке. Он твой друг?»~
@9242 = ~Он выглядит удивленным. «Как странно! Мне очень жаль. Я ведь должен тебя *как-то* называть, верно?» Дух выжидающе смотрит на тебя.~
@9243 = ~«Конечно. Спрашивай!» Он довольно улыбается, с интересом ожидая твоего вопроса. Последний шов был убран, и теперь его улыбка не такая зловещая.~
@9244 = ~Дух, чувствуя твои колебания, начинает хохотать. «Вот ведь бедолага! Ну пусть будет Адан, приятель. Так какие у тебя вопросы?»~
@9245 = ~«О Сигиле, что ли? — увидев твой кивок, труп растягивает улыбку до ушей. — О, я не собираюсь портить тебе впечатление! Иди и разведай его сам! Затеряйся в его улочках, тавернах, среди людей... но будь внимателен! Это место не только удивительно, но и опасно. Но ведь это и делает все таким захватывающим, не так ли?»~
@9246 = ~Оставить духа.~
@9247 = ~«Ты здесь, чтобы отвечать на *мои* вопросы, дух».~
@9248 = ~«Ты... по крайней мере твои останки... находятся в морге».~
@9249 = ~«Нет, сомневаюсь, что мы знакомы. У меня вопрос к тебе...»~
@9250 = ~«Вряд ли. Прощай».~
@9251 = ~«Так кто ты?»~
@9252 = ~«Откуда ты?»~
@9253 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9254 = ~«Где ты... где находится твой дух... сейчас?»~
@9255 = ~«Что ты знаешь об этом месте?»~
@9256 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9257 = ~«Ничего, неважно».~
@9258 = ~«Нет, у меня есть другие вопросы...»~
@9259 = ~«Это все, что я хотел узнать. Прощай».~
@9260 = ~«Да, еще один вопрос...»~
@9261 = ~«Это все, что я хотел узнать. Прощай».~
@9262 = ~«Да, еще один вопрос...»~
@9263 = ~«Это все, что я хотел узнать. Прощай».~
@9264 = ~«Нет, у меня есть другие вопросы...»~
@9265 = ~«Да. Прощай».~
@9266 = ~«Тогда как же твое тело попало сюда на работу в эти унылые залы?»~
@9267 = ~«У меня есть другие вопросы...»~
@9268 = ~«Это все, что я хотел узнать. Прощай».~
@9269 = ~«Тогда у меня есть другой вопрос...»~
@9270 = ~«Это все, что я хотел узнать. Прощай».~
@9271 = ~«Так кто ты?»~
@9272 = ~«Откуда ты?»~
@9273 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9274 = ~«Где ты... где находится твой дух... сейчас?»~
@9275 = ~«Что ты знаешь об этом месте?»~
@9276 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9277 = ~«Ничего, неважно».~
@9278 = ~«Нет, у меня есть другие вопросы...»~
@9279 = ~«Это все, что я хотел узнать. Прощай».~
@9280 = ~«Нет, сомневаюсь, что мы знакомы. У меня вопрос к тебе...»~
@9281 = ~«Вряд ли. Прощай».~
@9282 = ~«Так кто ты?»~
@9283 = ~«Меня зовут Асонж».~
@9284 = ~«У меня есть другие вопросы...»~
@9285 = ~«Это все, что я хотел узнать. Прощай».~
@9286 = ~«Так кто ты?»~
@9287 = ~«Откуда ты?»~
@9288 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9289 = ~«Я... не знаю».~
@9290 = ~«Я скажу тебе в другой раз. У меня есть вопрос...»~
@9291 = ~«Может быть в другой раз. Прощай».~
@9292 = ~«Понятно. У меня есть другой вопрос...»~
@9293 = ~«Это все, что я хотел узнать. Прощай».~
@9294 = ~«У меня есть другие вопросы...»~
@9295 = ~«Это все, что я хотел узнать. Прощай».~
@9296 = ~«Понятно. У меня есть другой вопрос...»~
@9297 = ~«Это все, что я хотел узнать. Прощай».~
@9298 = ~«Ты что-нибудь знаешь о городе, окружающем Морг?»~
@9299 = ~«Понятно. У меня есть другой вопрос...»~
@9300 = ~«Это все, что я хотел узнать. Прощай».~
@9301 = ~«Возможно. У меня есть другой вопрос...»~
@9302 = ~«Не знаю. Прощай».~
@9303 = ~«Можешь называть меня, как хочешь. У меня есть вопрос...»~
@9304 = ~Придумать имя: «Ну, не знаю... 'Адан'?»~
@9305 = ~«Нет, это неважно. Прощай».~
@9306 = ~«Так кто ты?»~
@9307 = ~«Так кто ты?»~
@9308 = ~«Откуда ты?»~
@9309 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9310 = ~«Где ты... где находится твой дух... сейчас?»~
@9311 = ~«Что ты знаешь об этом месте?»~
@9312 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9313 = ~«Да, есть...»~
@9314 = ~«Нет, нету. Прощай».~
@9315 = ~«Да... наверное. У меня есть другой вопрос...»~
@9316 = ~«Возможно. Прощай».~
@9317 = ~«Где ты... где находится твой дух... сейчас?»~
@9318 = ~«Что ты знаешь об этом месте?»~
@9319 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9320 = ~«Ничего, неважно».~
@9321 = ~«Ничего, неважно».~
@9322 = ~«Дай нам знать, если найдешь что-нибудь».~
@9323 = ~«Нет, спасибо. Я пас».~
@9324 = ~«Похоже, это никогда не закончится».~
@9325 = ~«Давай».~
@9326 = ~«Почему бы тебе не присесть и не расслабиться? Рано или поздно он все равно объявится».~
@9327 = ~«Знаю, знаю. Просто я не хочу упустить его».~
@9328 = ~«Ты слишком нетерпеливый. Он придет. Наберись терпения, маленький охотник».~
@9329 = ~«Крысочки! Свежие крысочки!»~
@9330 = ~«Думаешь, ты найдешь его здесь?»~
@9331 = ~«Бездари...»~
@9332 = ~«Побыстрее с этими ящиками!»~
@9333 = ~«Эй, законник... историю за звенелки? А?»~
@9334 = ~«Рассказы-за-монетки... Рассказы-за-монетки...»~
@9335 = ~«Закажи выпивку и успокойся, охотник».~
@9336 = ~«Я его не видел».~
@9337 = ~«Только не задерживайся слишком долго».~
@9338 = ~Этот человек смотрит на тебя странными выпученными глазами. Глаза у него просто *огромные*... настолько большие, что, кажется, они вот-вот выпадут из орбит и покатятся по мостовой. При твоем приближении он начинает неистово кивать, по-птичьи двигая головой взад-вперед... приблизившись к нему, ты неожиданно замечаешь запах мочи и экскрементов, окружающий его.~
@9339 = ~«Приветствую».~
@9340 = ~Человек шмыгает носом, сморкается в рукав, затем открывает рот, обнажая свои почерневшие гнилые десны. «Что, братец, рассказы-за-монетки?» Его дыхание зловонно; пахнет так, будто он держит во рту гнилое мясо. «Рассказы-за-монетки?»~
@9341 = ~«Кто ты?»~
@9342 = ~Этот человек презрительно смеривает тебя взглядом, когда ты подходишь к нем. «Я Крэддок, босс этой пыльной оравы слабоумных. А теперь пшел вон. Мне нужно работать с этими увальнями, на тебя у меня нет времени».~
@9343 = ~«Ну ладно... Крэд-ТИН».~
@9344 = ~«А у тебя острый глаз, рубака! Я продаю мозгогрызунов... Уверен, ты найдешь их намного приятнее на вкус, по сравнению с обычными крысами. Очень вкусные, правда-правда!» Он снова предлагает их тебе, призывно помахивая шестом прямо у тебя перед носом... крысы покачиваются на крючках из стороны в сторону, подвешенные, как маленькие говяжьи тушки.~
@9345 = ~«Пока нет».~
@9346 = ~Эта широкоплечая женщина шатается между больших балок, лежащих на улице. Она пинает по ним подкованным железом башмаком, время от времени голыми руками выпрямляя и вытаскивая из досок гвозди. Она оценивающе их разглядывает, а затем бросает в кожаную сумку на ремне.~
@9347 = ~Выжидающий взгляд пропадает с его лица, будто ему дали пощечину. «Оба? Я-то что сделал?»~
@9348 = ~Перед тобой тощий усталый мужчина. Его одежда воняет грязью и потом, и он, похоже, запыхался. Он не обращает внимания на твое приближение... он похож на одного из обычных рабочих с рыночной площади.~
@9349 = ~Оставить его в покое.~
@9350 = ~Этот мужчина целиком поглощен изучением товаров, выставленных на прилавках рынка. При твоем приближении он даже не обращает на тебя внимания.~
@9351 = ~«Ой... Прошу прощения за беспокойство».~
@9352 = ~Эта женщина не обращает на тебя внимания. Кажется, она очень увлечена тем, что торговцы выставили на продажу.~
@9353 = ~Позволить ей заниматься своими покупками.~
@9354 = ~Эта угрюмая женщина удостаивает тебя лишь мимолетным взглядом, после чего возвращается к своим тирадам на помосте. Ее мощный голос разносится по рынку, пробиваясь даже через гомон торговцев и топот ног.~
@9355 = ~Оставить ее в покое.~
@9356 = ~Перед тобой худощавый желтокожий человекоподобный незнакомец, полностью покрытый татуировками. Его брови подчеркнуты угольно-черными линиями, а зубы заточены под клыки. Завидев тебя, он призывно машет тебе, поигрывая игральными костями в руке.~
@9357 = ~«Приветствую...»~
@9358 = ~Этот парень, похоже, очарован тем, что говорит женщина. Кажется, он даже не заметил того, что ты говоришь с ним.~
@9359 = ~«Ну и неважно».~
@9360 = ~Похоже, эта женщина загипнотизирована тем, что вот-вот скажет другая женщина. Она не замечает, что ты обращаешься к ней.~
@9361 = ~«Ну и неважно».~
@9362 = ~Этот житель Улья наблюдает за работой дабуса. Он чешет затылок и поворачивается к тебе. «Клянусь жизнью Леди, не могу себе уяснить, что они делают с этим домом... эти дабусы без конца что-то сносят и отстраивают заново... не пойму, к чему все это».~
@9363 = ~«Тогда не волнуйся об этом».~
@9364 = ~Этот краснолицый старик кричит в толпу вокруг него. Когда ты подходишь, в его глазах появляется надежда. «Уделишь минутку... или поделишься монеткой... за одни из лучших товаров по эту сторону Сигила, а, братец?»~
@9365 = ~«Посмотрю, что тут у тебя, после того как посоветуюсь с Робом Холлоувеем насчет купеческих лавок».~
@9366 = ~«Пф. Посоветуйся и возвращайся».~
@9367 = ~«Так и сделаю».~
@9368 = ~Эта женщина с простоватым лицом кричит в толпу, окружающую ее. Когда ты подходишь, она улыбается и протягивает горсть чего-то вроде дохлых крыс и птиц. «Проголодался, голубчик?»~
@9369 = ~«Не сегодня, спасибо».~
@9370 = ~При твоем приближении этот мужчина круто разворачивается и кланяется. «Братец... вне всякого сомнения, ты ищешь лучшие товары во всем Сигиле. Ты пришел по адресу».~
@9371 = ~«Э-э... Подожду, пока у тебя не появятся товары».~
@9372 = ~Когда ты подходишь, эта женщина осматривает тебя, упирает руки в бока и насмешливо говорит: «Не красавчик? Может, у тебя найдется пара монет и ты захочешь чего-нибудь купить у странствующей жестянщицы, а?»~
@9373 = ~«Неинтересно... замухрышка».~
@9374 = ~Лающий Дикарь~
@9375 = ~Адизоэль Эриане-Ард~
@9376 = ~Гаоха~
@9377 = ~Скорбящий-по-деревьям~
@9378 = ~Торговец из Улья~
@9379 = ~0200dab1~
@9380 = ~«Великая тьма ниспадет на этот город!»~
@9381 = ~«Я вижу конец!»~
@9382 = ~«Этот Хамрису точно понравится...»~
@9383 = ~«Проверь, чтобы с этими ящиками было все в порядке, быстро!»~
@9384 = ~«Сигил не спит, так что пошевеливайтесь, недотепы!»~
@9385 = ~«За этот можно получить кучу звенелок...»~
@9386 = ~«Вкусные крысочки! Прямо из подвала!»~
@9387 = ~«Кому крысочек? Восхитительные крысочки!»~
@9388 = ~«Покупайте крысочек!»~
@9389 = ~«Пряные крысочки! Вареные крысочки! Запеченные крысочки!»~
@9390 = ~«Фаршированные крысочки! Две за три медяка!»~
@9391 = ~«Крысы! Выпотрошенные, без хвостов и лап!»~
@9392 = ~«Печеные крысочки! Две за три медяка!»~
@9393 = ~«Крысочки! Свежие крысочки!»~
@9394 = ~«Вот еще один прелестный...»~
@9395 = ~«Гвозди, гвозди...»~
@9396 = ~«Вот еще один хороший...»~
@9397 = ~«Прелестные гвозди...»~
@9398 = ~Дух открывает один глаз, белым пятном выделяющимся на серой и сморщенной плоти. Он медленно поворачивает к тебе голову;  обожженная и израненная плоть его лица и шеи туго натянута на кости. Наконец, ему удается выдавить слова из поврежденной глотки: «Нет. Не... в порядке... ты... чертов... пустоголовый».~
@9399 = ~«Хе, хехе-ХУРХ!» — хохот духа резко прерывается тяжелыми спазмами, и он изрыгает поток бальзамирующей жидкости и черной гнили. Корчась от боли, дух начинает безудержно кашлять, периодически сплевывая желтоватую жидкость и оборванные швы с губ.~
@9400 = ~Ужасный кашель духа наконец-то утихает. «Нет, пень... ты... не можешь. Если... если только не махнешь в Баатор и не спасешь меня, я попал... по полной. Настало время... покаяться», — дух закрывает глаз и откидывает голову на пол.~
@9401 = ~Дух издает хлюпающее рычание, потемневшие губы обнажают неровные желтые зубы. «Ну... ну погоди у меня... как только выберусь из этой дыры... я... с тобой первым разберусь, пень...»~
@9402 = ~Духу издает утробное рычание и плюет в тебя. Мерзкая жидкость приземляется в нескольких дюймах от твоих ног. Полностью обессилев, существо падает назад на пол: жизнь снова покинула тело.~
@9403 = ~Ты резко бьешь мертвеца по почкам, но безуспешно: духа ты не задел. «Хе, хе-хе-хе», — ехидно булькает существо, после чего, наконец, полностью покидает тело. Ты стоишь со смутным ощущением неудовлетворенности.~
@9404 = ~«Что... да чего тебе *вообще* от меня надо, пень?» Дух все еще изредка подергивается, хлопая себя по телу, как будто пытается сбить языки пламени.~
@9405 = ~«Не твое дело... оставь меня... в покое...»~
@9406 = ~«А? Во имя сил, да кому это... надо? Ну, из Сигила, ты... неудачник».~
@9407 = ~«А ты как думаешь, бестолочь? — вспышка гнева вызвала у духа резкий болезненный кашель. — Продал мясо... в обмен на пару звенелок. Чертовым трухлякам... И тут же, представляешь, ТУТ ЖЕ какой-то тупоголовый маг решил сжечь Улей дотла, а я оказался в самом пекле!» Дух что-то злобно бормочет, изрыгая жидкость из уголков рта.~
@9408 = ~«А ты... ты как думаешь, недоумок? В Бааторе, в вонючей дыре под названием Флегетос. Огонь, огонь... огонь... я без конца горю. Я сгорел заживо при жизни, теперь я горю после смерти. Аргх! — дух яростно скрежещет зубами. — Какая жестокая ирония! Когда я выберусь отсюда, уж я-то самолично отправлю немного бедолаг в эту чертову дыру. Хе, хе-хе-хе... *буль*».~
@9409 = ~«Заслужить? ЭТО? Да ничего! Я... *гуэк*... ничего не сделал. Просто пытался сводить концы с концами... как и все остальные... А потом ПУФ! Этот козлина-маг начинает жечь весь Улей!»~
@9410 = ~«Ничего. Ничего я не скажу *тебе*, пень. Просто... просто оставь меня гореть дальше...»~
@9411 = ~«Кого? Чего? Нет! С чего... с чего ты решил, что я бы тебе сказал, если бы знал, ты... пустоголовый пень? Пф...»~
@9412 = ~«Месть, пустая твоя башка! Я доберусь... до всех доберусь, кто перешел мне дорогу. Особенно до того мага! Буду отрывать от него по кусочку и запихивать ему прямо в глотку! А потом сброшу его по кускам в эту вонючую дыру! Его и еще кого-нибудь, для... для ровного счета! Хе, хе-хе-хе...»~
@9413 = ~«У меня есть вопросы к тебе...»~
@9414 = ~Оставить горящего духа.~
@9415 = ~«Я могу тебе чем-нибудь помочь?»~
@9416 = ~«У меня вопрос...»~
@9417 = ~«Поделом тебе, вонючий дымящийся кусок мяса. Скорее всего, ты заслужил такую участь. Прощай».~
@9418 = ~Оставить измученного духа.~
@9419 = ~Терпеливо ждать окончания процесса.~
@9420 = ~«Ты злобный ничтожный человек. Ты заслужил свою участь».~
@9421 = ~«У меня есть другие вопросы...»~
@9422 = ~Оставить измученного духа его страданиям.~
@9423 = ~«Понятно. У меня есть другой вопрос...»~
@9424 = ~«Ладно. Прощай».~
@9425 = ~«Да пожалуйста. Я не из тех, кто боится таких как ты».~
@9426 = ~Ударить его.~
@9427 = ~Не обращать внимания на бедолагу, отвернуться и уйти.~
@9428 = ~«Кто ты?»~
@9429 = ~«Откуда ты?»~
@9430 = ~«Как ты попал сюда? То есть, как стал зомби?»~
@9431 = ~«Где ты... где находится твой дух... сейчас?»~
@9432 = ~«Что же ты натворил, чтобы заслужить такие муки?»~
@9433 = ~«Что ты знаешь об этом месте?»~
@9434 = ~«Ты знаешь кого-нибудь по имени Фарод?»~
@9435 = ~«Ничего, неважно».~
@9436 = ~«Нет. У меня другой вопрос...»~
@9437 = ~«Тогда прощай». ~
@9438 = ~«У меня есть другие вопросы...»~
@9439 = ~«Это все, что я хотел узнать. Прощай».~
@9440 = ~«Волшебник сжег Улей?»~
@9441 = ~«У меня есть другие вопросы...»~
@9442 = ~«Почему ты хочешь навязать свою судьбу другим?»~
@9443 = ~«У меня есть другие вопросы...»~
@9444 = ~«Это все, что я хотел узнать. Прощай».~
@9445 = ~«Маг... сжег... Улей?»~
@9446 = ~«Понятно. У меня есть другой вопрос...»~
@9447 = ~«Хорошо. Тогда у меня другой вопрос...»~
@9448 = ~«Тогда прощай». ~
@9449 = ~«Хорошо. У меня есть другие вопросы...»~
@9450 = ~«Это все, что я хотел узнать. Прощай».~
@9451 = ~«Понятно. У меня к тебе еще вопросы...»~
@9452 = ~«Это все, что я хотел узнать. Прощай».~
@9453 = ~«Горе тем, кто слышит, но не слушает!»~
@9454 = ~«Все они окажутся в лабиринтах!~
@9455 = ~«Падет тень Леди, и вместе с ней падут люди!»~
@9456 = ~«Пять лет проклятья!»~
@9457 = ~«Фракции будут вышвырнуты отсюда!»~
@9458 = ~«Да, Улей... самую худшую часть Сигила. Никогда в жизни не видел столько огня... Я себе шел, никого не трогал — и вдруг все вокруг загорелось! Дома, улицы, люди, их дети... а это проклятый маг только хохотал, все время! Я махнул за угол и вроде немного оторвался, а следующее, что я помню — моя чертова голова загорелась! С того времени все стало... только хуже...» — открытый глаз духа злобно сверкает.~
@9459 = ~«Кем был тот волшебник?»~
@9460 = ~0200dab3~
@9461 = ~0200dab4~
@9462 = ~0200dab2~
@9463 = ~«Даже фрактолам не будет пощады!»~
@9464 = ~«Понятно. У меня к тебе еще вопросы...»~
@9465 = ~«Это все, что я хотел узнать. Прощай».~
