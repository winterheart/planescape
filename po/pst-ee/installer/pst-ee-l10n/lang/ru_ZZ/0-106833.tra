@3262 = ~Вришика~
@3263 = ~Зеленый абишай~
@3264 = ~Квелл~
@3265 = ~Упырь~
@3266 = ~Нордом~
@3267 = ~Мертвин Безголовый~
@3268 = ~Каменная голова~
@3269 = ~Ночная ведьма~
@3270 = ~Куратор~
@3271 = ~Чувствующий-проводник~
@3272 = ~Бандит с диким взглядом~
@3273 = ~Запредельный~
@3274 = ~Дэва~
@3275 = ~Доспехи убийцы милосердия~
@3276 = ~Поставщица~
@3277 = ~Мажор~
@3278 = ~Упырь~
@3279 = ~Черный абишай~
@3280 = ~Статуя~
@3281 = ~Корнугон~
@3282 = ~Красный абишай~
@3283 = ~Глабрезу~
@3284 = ~Нупперибо~
@3285 = ~Лемур~
@3286 = ~Гехрелет~
@3287 = ~Черепная крыса~
@3288 = ~Леди Боли~
@3289 = ~Крыса-оборотень~
@3290 = ~Сифилитик~
@3291 = ~Каменный упырь-голем~
@3292 = ~Эи-Вейн~
@3293 = ~Трокопотока~
@3294 = ~Тускампа~
@3295 = ~Токола~
@3296 = ~Большая Тень~
@3297 = ~Каменная статуя~
@3298 = ~Корнугон~
@3299 = ~Красный абишай~
@3300 = ~Глабрезу~
@3301 = ~Гехрелет~
@3302 = ~Крыса-оборотень~
@3303 = ~Черепная крыса~
@3304 = ~Леди Боли~
@3305 = ~Токола~
@3306 = ~Посетитель «Тлеющего трупа»~
@3307 = ~Гриллиг~
@3308 = ~Трича~
@3309 = ~Лемур~
@3310 = ~Неуклюжий зомби~
@3311 = ~Измученная женщина~
@3312 = ~Личиночный червь~
@3313 = ~Трелон~
@3314 = ~Тригит~
@3315 = ~Колонна черепов~
@3316 = ~Большая Тень~
@3317 = ~Тускампа~
@3318 = ~Убийца милосердия~
@3319 = ~Сомьен~
@3320 = ~Червь~
@3321 = ~Нупперибо~
@3322 = ~Лим-Лим~
@3323 = ~Трокопотока~
@3324 = ~Зеленый абишай~
@3325 = ~Этот черный ящер возвышается на два с половиной метра. Однако его огромный рост компенсируется тонким змееподобным телом. Позади волочится длинный цепкий хвост, из-за спины торчат кожаные крылья. От существа несет крепким уксусом... и жаром. Похоже, он не обращает на тебя внимания.~
@3326 = ~«Приветствую».~
@3327 = ~Я КРАСНЫЙ абишай, это большая разница с черными. На самом деле. Да, а еще я хочу тебя убить, как и все.~
@3328 = ~Очаровательно.~
@3329 = ~Я «зеленый» абишай. Мне тошно даже смотреть на себя.~
@3330 = ~Мне тоже. В смысле, на себя.~
@3331 = ~Гррр. Моя есть большой корнугон. Моя делать больно. Очень сильно много больно.~
@3332 = ~Я тоже. Приятно было встретиться.~
@3333 = ~Возможно, что черепные крысы в игре смогут общаться с персонажем. Если это так, вот для них шаблончик.~
@3334 = ~Как удобно.~
@3335 = ~test/Chris/8.25~
@3336 = ~test chris part 2 8.25~
@3337 = ~Ключ к комнате в Фестхолле~
@3338 = ~Записки Фина Эндли~
@3339 = ~Я один из последователей Мантуока. Пик-пик.~
@3340 = ~Ага, пик-пик.~
@3341 = ~Я один из «гнилого народа» зомби, что населяют катакомбы. Я волочусь с работы и на работу также, как и Крис Авелон.~
@3342 = ~«Что делаешь вечером?»~
@3343 = ~Я один из «гнилого народа» зомби, что населяют катакомбы. Я волочусь с работы и на работу также, как и Крис Авелон. Бла-бла-бла. Бла?~
@3344 = ~Да ты и пахнешь, как он.~
@3345 = ~Я — один из скелетов-последователей Харгримма. Мы воздаем почести мертвым, и чтим их жертву.~
@3346 = ~Я оставлю вас, славные скелеты.~
@3347 = ~«Указатель»~
@3348 = ~Посетитель, убийца милосердия~
@3349 = ~Ингресс~
@3350 = ~Сомьен~
@3351 = ~Поясок~
@3352 = ~Вонючий горшок~
@3353 = ~Старая жительница Улья~
@3354 = ~Смерть-имен~
@3355 = ~Тригит~
@3356 = ~Трелон~
@3357 = ~Квентин~
@3358 = ~Гигантский скелет~
@3359 = ~Трича~
@3360 = ~Личиночный червь~
@3361 = ~Лим-Лим~
@3362 = ~Гриллиг~
@3363 = ~«Есть тут человек по имени Гнилой Уильям. Темный и коварный тип. Он лидер Заточек с Темного переулка. Разыщи его в переулке и убей — и ты сослужишь хорошую службу добру. Не справишься — и зло восторжествует. Откажешься — и я тебя убью».~
@3364 = ~«У меня есть другие вопросы...»~
@3365 = ~Уйти.~
@3366 = ~Мне бы было очень интересно узнать, как дизайнер ухитрится все вытянуть. Это будет забавно!~
@3367 = ~«Пожалуйста. Я бы хотел задать тебе несколько вопросов...»~
@3368 = ~Может быть? Может быть, если только я тебе не засвечу тебе в твою жалкую зомбифицированную рожу.~
@3369 = ~«Мы бродяги. Нам приходится все время переходить с места на место. Мы попали сюда примерно в то же время, что и Гнилой Уильям и его Заточки с Темного переулка, и теперь мы бьемся за свои жизни. Мы просто берем плату за проход через это место. Они забирают жизни. По натуре мы добрые люди. Они — злые, ведомые злым человеком».~
@3370 = ~«Ты знаешь меня, незнакомец?»~
@3371 = ~«Я ищу Фарода».~
@3372 = ~«Кто ты?»~
@3373 = ~Знаешь, тебя послушать — можно и в штаны наложить.~
@3374 = ~[no text]~
@3375 = ~Мешочек~
@3376 = ~Нагрудник 2~
@3377 = ~Скрюченный костяной палец~
@3378 = ~Нагрудник 3~
@3379 = ~Тряпье~
@3380 = ~Бинты~
@3381 = ~Нагрудник 4~
@3382 = ~Треснувший бронзовый нагрудник~
@3383 = ~Кулак~
@3384 = ~Клинок гигантского скелета~
@3385 = ~Кулак зомби (удар)~
@3386 = ~Иголка и нитка~
@3387 = ~Руна брони~
@3388 = ~Корсаж безбожной жрицы~
@3389 = ~Кулак зомби (удар)~
@3390 = ~Кулак~
@3391 = ~Кожаный фартук~
@3392 = ~Скрюченный костяной палец~
@3393 = ~Руна малой защиты~
@3394 = ~Клинок гигантского скелета~
@3395 = ~Перо Дхолла~
@3396 = ~Я один из сборщиков в Погребенной деревне. Я брожу вокруг, собирая вещи и трупы для Фарода.~
@3397 = ~Звучит превосходно.~
@3398 = ~Я покупатель из Нижнего района. Я гуляю по округе, осматриваю товары, а вообще выполняю роль ветреной особы.~
@3399 = ~Отлично. Спасибо за уделенное «время».~
@3400 = ~Я покупательница из Нижнего района. Как и мужчины моего вида, я брожу по лавкам, смотрю товары и решаю, что мне купить. Я тебе не какая-нибудь пустышка.~
@3401 = ~Как интересно... то есть, насчет пустышки. Спасибо, что уделила мне время, дорогуша.~
@3402 = ~Я — одна из девушек Погребенной деревни. Я брожу по деревне, разыскивая тела и безделушки для Фарода.~
@3403 = ~Хороший. Плохой. Я тот, у кого пушка.~
@3404 = ~Перед тобой хрупкая девушка с бледным лицом. Из-за впалой кожи на щеках и шее кажется, будто она голодает. Судя по всему, она увлечена обследованием тела, лежащим перед ней, тыкая по телу пальцем.~
@3405 = ~~
@3406 = ~«Приветствую».~
@3407 = ~Оставить ее в покое.~
@3408 = ~Перед тобой изможденная женщина, одетая в лохмотья. Ее грязные волосы спутаны, а лицо совсем потемнело. На руках следы ожогов, правая рука превратилась в кусок оплавленного мяса... похоже, что она оплавилась, как воск, попавший в сильный жар.~
@3409 = ~«Приветствую».~
@3410 = ~Женщина не отвечает... похоже, она слишком увлечена трупом, лежащим перед ней. Следя за ее работой, ты случайно обращаешь внимание на ее руки... ее пальцы похожи на когти. Она с легкостью погружает их, словно ножи, в грудь трупа, доставая органы.~
@3411 = ~Я сказал, 'приветствую'.~
@3412 = ~«Приветствую, говорю».~
@3413 = ~«Приветствую, говорю».~
@3414 = ~«Что с твоими руками?»~
@3415 = ~«Что с твоими руками?»~
@3416 = ~Оставить ее в покое.~
@3417 = ~Женщина не отвечает.~
@3418 = ~Прикоснуться к женщине, привлечь ее внимание.~
@3419 = ~Оставить ее в покое.~
@3420 = ~Женщина не отвечает.~
@3421 = ~Женщина вздрагивает и круто разворачивается к тебе... у нее тусклые желтые глаза с маленькими оранжевыми точками вместо зрачков. При виде тебя ее удивление сменяется раздраженностью, она хмуро смотрит на тебя.~
@3422 = ~«Э... Приветствую».~
@3423 = ~Кажется, она тебя даже не слышала. Щурясь, она наклоняется вперед, как будто не может разглядеть тебя... что бы ни случилось с ее глазами, но ее вид с близкого расстояния вселяет страх. «Ты». Она соединяет когти вместе, затем делает странное движение рукой. «Найди НИТКУ и БАЛЬЗАМ, принеси СЮДА, к Эи-Вейн. Пшел — пшел — пшел».

^NПРИМЕЧАНИЕ: Только что вы получили задание. Задания отображаются в вашем дневнике в разделе «Задания». Чтобы увидеть все задания, полученные вами (а также их статус), просто выберите «Задания» из меню дневника.^-~
@3424 = ~Дать ей нитку и банку с бальзамирующей жидкостью.~
@3425 = ~«Сперва ответь на пару вопросов...»~
@3426 = ~«Сперва ответь на пару вопросов...»~
@3427 = ~«Что с твоими руками?»~
@3428 = ~«Что с твоими руками?»~
@3429 = ~Уйти.~
@3430 = ~Она отворачивается... непохоже, чтобы она тебя услышала. Должно быть, ее слух не лучше зрения.~
@3431 = ~Коснуться ее плеча, привлечь ее внимание.~
@3432 = ~Уйти.~
@3433 = ~Не теряя ни минуты, Эи-Вейн выхватывает нитку из твоих рук и цепляет на один из своих когтей, а затем начинает зашивать трупу грудь. Затем она берет бальзамирующую жидкость и начинает намазывать ею мертвеца.~
@3434 = ~Подождать.~
@3435 = ~Уйти.~
@3436 = ~Едва ты собираешься уйти, Эи-Вейн говорит: «Стой. Ты следующий».~
@3437 = ~Подождать.~
@3438 = ~Уйти. Быстро.~
@3439 = ~Спустя несколько минут она заканчивает. Щелкнув когтями, она поворачивается к тебе. К твоему удивлению, она протягивает руку и проводит когтями по твоим рукам и груди.~
@3440 = ~«Э, не то, чтобы я не польщен, но...»~
@3441 = ~«Э, не то, чтобы я не польщен, но...»~
@3442 = ~Продолжать строить из себя зомби.~
@3443 = ~Продолжать строить из себя зомби.~
@3444 = ~Оттолкнуть ее, уйти.~
@3445 = ~Она потрясена тем, что ты ее оттолкнул. «Зомфи? Ты не зомфи!» Она отступает на шаг, и ты не успеваешь среагировать, как она трижды хлопает в ладони. В ответ повсюду Морге раздается звон огромного колокола. ~
@3446 = ~Когда она касается твоих рук и тела, ты вдруг понимаешь, что она изучает твои шрамы. Она отводит свои когти, дважды ими щелкает, затем наклоняется вперед и осматривает татуировки на теле. «Хм-м. Кто это так тебя изрисовал? Никакого уважения к зомфи. Зомфи — не картина». Она принюхивается, затем похлопывает по твоим шрамам. «Этот в плохой форме, много шрамов, не законсервирован».~
@3447 = ~Подождать.~
@3448 = ~Неожиданно ее когти зацепляют нитку, которую ты принес, а другой рукой она молниеносно пронзает твою кожу в месте шрама. Не больнее, чем укол булавки. Кажется, она собирается тебя заштопать.~
@3449 = ~Позволить ей работать.~
@3450 = ~Оттолкнуть ее, уйти.~
@3451 = ~Эи-Вейн начинает зашивать твои шрамы; ощущения при этом на удивление безболезненны.

Закончив, она обнюхивает тебя, хмурится, затем окунает пальцы в бальзамирующую жидкость. В течении нескольких минут она наносит жидкость на твое тело... довольно странно, но ты чувствуешь себя *лучше*.~
@3452 = ~Позволить ей работать.~
@3453 = ~Позволить ей работать.~
@3454 = ~Эи-Вейн в последний раз прикасается к твоему телу, еще раз фыркает, кивает, а затем отмахивается своими когтями. «Готово. Пшел-пшел».~
@3455 = ~Минуточку. Мне нужен ключ от бальзамационной. У тебя он есть?~
@3456 = ~«Минуточку». Жестом ты показываешь, как открываешь что-то ключом. «Мне нужен ключ от бальзамационной. У тебя он есть?»~
@3457 = ~«Минуточку». Жестом ты показываешь, как открываешь что-то ключом. «Мне нужен ключ от бальзамационной. У тебя он есть?»~
@3458 = ~Перед тобой Эи-Вейн. Она все еще потрошит труп своими когтями. Ритм движений когтей что-то тебе напоминает, но ты не можешь вспомнить что.~
@3459 = ~Наблюдать за ней, изучая движения ее рук.~
@3460 = ~~
@3461 = ~~
@3462 = ~~
@3463 = ~Коснуться ее плеча, привлечь ее внимание.~
@3464 = ~Наблюдая за движением рук Эи-Вейн, ты чувствуешь покалывание в голове. Внезапно у тебя в глазах все начинает размываться и плыть...~
@3465 = ~~
@3466 = ~~
@3467 = ~~
@3468 = ~Заметив тебя, она поворачивается, а затем хмурится. «Тупые зомфи». Она нетерпеливо щелкает когтистыми пальцами, а затем делает движение рукой, как будто что-то зашивает. «Найди нитку и бальзам, принеси сюда, к Эи-Вейн. Пшел-пшел-пшел». ~
@3469 = ~Дать ей нитку и банку с бальзамирующей жидкостью.~
@3470 = ~«Минуточку». Жестом ты показываешь, как открываешь что-то ключом. «Мне нужен ключ от бальзамационной. У тебя он есть?»~
@3471 = ~Она наклоняется вперед, присматриваясь к твоему жесту, затем фыркает. Ее рука скрывается в одежде, затем появляется вместе с ключом, висящим на ее угрожающе-остром когте. Она кладет его тебе на ладонь. «Принеси потом обратно. Пшел-пшел».~
@3472 = ~Женщина не отвечает.~
@3473 = ~«Думаю, эта трухлявая цыпочка немного тугая на ухо, шеф. Давай просто свалим отсюда, а?»~
@3474 = ~«Что не так с ее руками?»~
@3475 = ~Прикоснуться к женщине, привлечь ее внимание.~
@3476 = ~Оставить ее в покое.~
@3477 = ~«Э... она из тифлингов, шеф. В их жилах течет лихая кровь нечисти. Кто-то из предков спутался с каким-то нечистым духом. Из-за этого некоторые из них немного тронутые... и обычно выглядят они соответствующе».~
@3478 = ~Прикоснуться к женщине, привлечь ее внимание.~
@3479 = ~Оставить ее в покое.~
@3480 = ~«Думаю, эта трухлявая цыпочка немного тугая на ухо, шеф. Давай просто свалим отсюда, а?»~
@3481 = ~«Э... она из тифлингов, шеф. В их жилах течет лихая кровь нечисти. Кто-то из предков спутался с каким-то нечистым духом. Из-за этого некоторые из них немного тронутые... и обычно выглядят они соответствующе».~
@3482 = ~Уйти.~
@3483 = ~«Что не так с ее руками?»~
@3484 = ~Уйти.~
@3485 = ~Она отворачивается... непохоже, чтобы она тебя услышала. ~
@3486 = ~Она отворачивается... непохоже, чтобы она тебя услышала. Должно быть, ее слух не лучше зрения.~
@3487 = ~«Похоже, у тебя новая подруга, шеф. Может, вас оставить наедине на часок, или?..»~
@3488 = ~«Замолкни, Морт».~
@3489 = ~Продолжать строить из себя зомби.~
@3490 = ~Оттолкнуть женщину.~
@3491 = ~«Ну хорошо...»~
@3492 = ~«Это второй случай в моей жизни, когда я счастлив, что у меня нет носа».~
@3493 = ~Заметив тебя, она поворачивается, а затем хмурится. «Тупые зомфи». Она нетерпеливо щелкает когтистыми пальцами, а затем делает движение рукой, как будто что-то зашивает. «Ты готов. Все зашито. Пшел-пшел-пшел». ~
@3494 = ~«Что с твоими руками?»~
@3495 = ~«Что с твоими руками?»~
@3496 = ~Уйти.~
@3497 = ~«Минуточку». Жестом ты показываешь, как открываешь что-то ключом. «Мне нужен ключ от бальзамационной. У тебя он есть?»~
@3498 = ~Она отворачивается... непохоже, чтобы она тебя услышала. Должно быть, ее слух не лучше зрения.~
@3499 = ~Уйти.~
@3500 = ~Мне нужен ключ. У тебя он есть?~
@3501 = ~«Минуточку». Жестом ты показываешь, как открываешь что-то ключом. «Мне нужен ключ от бальзамационной. У тебя он есть?»~
@3502 = ~«Минуточку». Жестом ты показываешь, как открываешь что-то ключом. «Мне нужен ключ от бальзамационной. У тебя он есть?»~
@3503 = ~РУНА МАЛОЙ ЗАЩИТЫ
Вызывает: «Броня»
Учит владельца заклинанию «Броня»
Уровень: 1 / маг
Дальность: 0
Длительность: пока не будет разрушена уроном
Скорость: 1
Область действия: 1 существо
Спасбросок: нет
Вес: 5
Используется только магами

После внимательного исследования рун, которыми покрыта поверхность этого нагрудника, ты делаешь вывод, что можешь высвободить силу рун и использовать ее для создания простого защитного заклинания, похожего на то, что защищало гигантского скелета. Однако активизация рун разрушит нагрудник.~
@3504 = ~КВИТАНЦИЯ БОГОЛЮДЕЙ
Вес: 0

Квитанция с оттиском символа боголюдей. Вероятно, ее можно использовать в Великой Литейной.~
@3505 = ~СКРЮЧЕННЫЙ КОСТЯНОЙ ПАЛЕЦ
Вес: 0

Это скрюченный костяной палец руки. Ты не вполне уверен, каким образом ему удается сохранять свою загнутую форму: похоже, нично не скрепляет между собой отдельные кости.~
@3506 = ~КОЖАНЫЙ РЕМЕНЬ
Вес: 1

Этот кожаный ремень использовался для связывания воедино костей скелета-рабочего. И хотя по краям он уже растрескался, он все еще достаточно крепкий.~
@3507 = ~МУСОР
Вес: 1

Коллекция всякого мусора... небольшие пружинки, сломанные болты, пара разломанных шестеренок. Кажется, кто-то считал, что эти предметы однажды пригодятся, но тебе они кажутся совершенно бесполезными.~
@3508 = ~ТРЯПЬЕ
Вес: 1

Эта плотная куча тряпья выглядит так, словно ее нарвали из какого-то из гобелена или чьей-то одежды.~
@3509 = ~КУЛАК ЗОМБИ (УДАР)
Вес: 0

Это ударная атака зомби.~
@3510 = ~Это один из кожаных ремней, использовавшихся для связывания воедино костей скелета. И хотя по краям он уже растрескался, он все еще достаточно крепкий.~
@3511 = ~СКРЮЧЕННЫЙ КОСТЯНОЙ ПАЛЕЦ
Вес: 0

Это скрюченный костяной палец руки. Ты не вполне уверен, каким образом ему удается сохранять свою загнутую форму: похоже, нично не скрепляет между собой отдельные кости.~
@3512 = ~КОЖАНЫЙ ФАРТУК
Вес: 5

Похоже, это тяжелый фартук, сделанный из шкуры какого-то животного. Подобные фартуки используются для защиты одежды рабочих от жара кузницы.~
@3513 = ~Квитанция со штампом в виде меча, излучающего солнечные лучи.~
@3514 = ~ТРЕНИРОВОЧНАЯ БУЛАВА
Урон: 1-2
Скорость: 5
Вес: 4
Специализация: дубинки
Используется только бойцами

На ощупь эта булава мягкая, даже пористая. Скорее всего, данное оружие использовалось для тренировок.~
@3515 = ~ЛЮБОПЫТНОЕ ЖЕЛЕЗНОЕ ИЗДЕЛИЕ
Вес: 10

Это блестящий образец филигранного металлического изделия, которое ты забрал в Великой Литейной. Оно кажется почти невесомым. Из него выдвигаются острые лезвия. Пока ты не представляешь, для чего оно предназначено, но, должно быть, оно достаточно важно, чтобы оставить его при себе.~
@3516 = ~КЛЕЩИ
Вес: 5

Покрытые сажей клещи, используемые для удержания железной руды в пылающем огне горна.~
@3517 = ~ЖЕЛЕЗНАЯ РУДА
Вес: 5

Кусок железной руды.~
@3518 = ~ТРЕСНУВШИЙ БРОНЗОВЫЙ НАГРУДНИК
Вес: 5

На поверхности этого сломанного бронзового нагрудника выгравировано множество рун. Ты получил его от гигантского скелета из Морга, после того как ты рассеял оживившие его чары.~
@3519 = ~КЛИНОК ГИГАНТСКОГО СКЕЛЕТА
Урон: 3-24 рубящий
Вес: 0
Используется только гигантскими скелетами

Это один из клинков гигантских скелетов.~
@3520 = ~А разве ты не должен быть более умным? Я имею в виду, ТЫ же нечистый высокого уровня, который тысячелетиями оттачивает свои злобу и интеллект, верно?~
@3521 = ~Эээ, ну в общем-то да, но гораздо проще просто много раз по рычать... Это производит впечатление на простофиль, знаешь ли.~
@3522 = ~Хенкельмонстр — высокое существо из Германии с длинными свисающими волосами.~
@3523 = ~Аазимары, противоположность тифлингов, — это дети небожителей, обитающих на Верхних планах, и смертных. Они несут в себе искру доброты, и все же некоторые из них идут наперекор своему наследию. Хотя обычно они — образцы добродетелей, им не следует просто так доверять.~
@3524 = ~Раздвоенный Язык — жертва Триаса, которого он называет «Предателем». Он подписал с дэва контракт, который обязал его заниматься благотворительностью до смерти Триаса. Он живет в костях Уль-Гориса во Внешних землях, прячась там от смертных и бессмертных. Он обладает знаниями и предметами, которые могут оказаться полезными.~
@3525 = ~Призрачное видение, Дейонарра, заявляет, что она знает тебя, что ты — ее «любовь». Что бы ни удерживало ее на физическом плане, оно обладает действительно огромной силой, позволяющей ей избегать смерти так долго. Похоже, смерть не изменила ее отношения к тебе.~
@3526 = ~Морт — говорящий череп. Единственное его оружие — это его рот, которым он либо насмехается, либо кусает. Похоже, он повсюду следует рядом, нравится тебе это или нет.

Интересно, как это ему удается парить по воздуху.~
@3527 = ~«Тленные» — хранители Морга, огромного здания, забитого мертвыми телами. Их фракция является кучкой довольно-таки угрюмых типов, редко проявляющих свои чувства или интересы к чему-то. Кажется, они увлечены только заботой о прибывающих в Морг телах, каталогизируя их, вскрывая, а затем хороня... неизвестно где.

Тленные подавляют все свои чувства, отвлекающие их от достижения «Истинной Смерти». Они воспринимают «жизнь» как временную задержку, тень Истинной Смерти, которой желают достичь все живые существа. Согласно философии Тленных, они должны отринуть от себя все свои страсти, после чего они смогут миновать это существование и достичь Истинной Смерти.~
@3528 = ~Дхолл очень стар, и он определенно не человек. У его кожи желтый оттенок, как у старого пергамента. Мертвые черные глаза расположены на костлявом лице... нечеловеческом лице; уши заострены. Большая белая борода ниспадает по его черным одеждам подобно водопаду. Он постоянно кашляет. Книга, с которой он работает, огромна, и, похоже, содержит много имен умерших, доставленных в Морг.

Дхолл — член фракции Тленных, которая верит в «Истинную Смерть», последнюю стадию небытия, которая ожидает всех после жизни. Дхолл утверждает, что знает тебя и встречал тебя много раз, называя тебя «Неугомонным». Он сказал, чтобы будет скрывать секрет твоего воскрешения из мертвых от остальной фракции. Похоже, он хочет, чтобы ты сам разобрался, что удерживает тебя от «Истинной Смерти».~
@3529 = ~Зомби — безмозглые тела, поднятые некромантом. В отличие от скелетов, у зомби на теле остается еще немало плоти, которая является как преимуществом, так и недостатком... они крепче и сильнее скелетов, но в то же время трупное окоченение сковывает их движение, делая их гораздо медлительнее живого человека.

Хотя зомби двигаются и атакуют очень медленно, но как только они настигают цель, проявляется вся их огромная сила. Их удар способен убить обычного человека с первого раза.~
@3530 = ~Эти скелеты получили некое подобие жизни с помощью некромантии. Хотя у них нет мускулов или сухожилий, их суставы соединены с помощью железных скоб, а кости укреплены кожаными ремнями и веревками под доспехами. Скелеты получают меньше урона от любого рубящего или колющего оружия. Дробящее оружие, например, дубины или молоты, наносит обычный урон. ~
@3531 = ~В отличие от других черепов в этой комнате, этот, похоже, живой и осознает окружающее. Глаза у него все еще свежи и влажны, и они следуют за твоими движениями. Кажется, череп пытается привлечь твое внимание.~
@3532 = ~Эти скелеты сделаны из костей гигантов. С помощью некромантии в них вдохнули подобие жизни. Хотя на них нет мускулов и жил, их суставы скреплены железными болтами, а кости усилены кожаными полосками и шнурами под доспехами. Размеры этих скелетов дают неверное представление об их огромной скорости и мастерстве владения огромными мечами.

Архаичная броня и оружие этих скелетов, похоже, не пострадали от времени, а их клинки остры как бритвы. Возможно, их броню каждый день чистит кто-то из рабочих Морга.

Рубящее и колющее оружие наносит скелетам меньший урон. Дробящее оружие, вроде булав и молотов, наносит обычный урон.~
@3533 = ~«Тленные» — хранители Морга, огромного здания, забитого мертвыми телами. Похоже, их фракция является кучкой довольно-таки угрюмых типов, редко проявляющих свои чувства или интересы к чему-то. Кажется, они увлечены только заботой о прибывающих в Морг телах, каталогизируя их, вскрывая, а затем хороня... неизвестно где.~
@3534 = ~Этот древний писарь очень стар... его кожа морщиниста и имеет желтый оттенок, как у старого пергамента. Мертвые черные глаза расположены на костлявом лице... нечеловеческом лице; уши заострены. Большая белая борода ниспадает по его черным одеждам подобно водопаду. Он постоянно кашляет. Книга, с которой он работает, огромна, и, похоже, содержит много имен.~
@3535 = ~Это призрачное видение — тайна для тебя. Это дух очень красивой девушки в длинном белом платье. Она выглядит несчастной, а странное свечение в ее глазах заставляет тебя чувствовать себя неуютно. Ты не можешь представить, что может заставлять подобное создание цепляться за нежизнь, но подозреваешь, что это связано с твоим нынешним положением.~
@3536 = ~Zombie Male Battle Cry 1 (Approach 1)~ [ZOMBW01]
@3537 = ~Giant Armored Skeleton Battle Cry 2 (Approach 2)~ [ARMSK02]
@3538 = ~Giant Armored Skeleton Damage 1~ [ARMSK06]
@3539 = ~Giant Armored Skeleton Damage 2~ [ARMSK07]
@3540 = ~Giant Armored Skeleton Death~ [ARMSK08]
@3541 = ~Cornugon Battle Cry 1 (Approach 1)~ [CORNU01]
@3542 = ~Zombie Male Battle Cry 2 (Approach 2)~ [ZOMBW02]
@3543 = ~Zombie Female Battle Cry 1 (Approach 1)~ [ZOMBF01]
@3544 = ~Zombie Female Battle Cry 2 (Approach 2)~ [ZOMBF02]
@3545 = ~Cranium Rat Battle Cry 2 (Approach 2)~ [CRRAT02]
@3546 = ~Cranium Rat Damage 1~ [CRRAT06]
@3547 = ~Zombie Female Damage 1~ [ZOMBF06]
@3548 = ~Zombie Female Damage 2~ [ZOMBF07]
@3549 = ~Zombie Female Death~ [ZOMBF08]
@3550 = ~Уйти.~
@3551 = ~«Силы небесные! Разве я не сказал тебе поговорить с Гнилым Уильямом? Ты тупой пень. ЗАТОЧКИ! В АТАКУ!»~
@3552 = ~Убежать.~
@3553 = ~Атаковать.~
@3554 = ~«Так ты убил того борца за справедливость? Отлично. Он сильно вредил нашему стилю. Поговори с Уильямом — у него есть для тебя кое-что приятное».~
@3555 = ~Уйти.~
@3556 = ~«Хватит болтать со мной, лучше избавься от этого борца за справедливость! Наши жизни в опасности, бедолага!»~
@3557 = ~Уйти.~
@3558 = ~«Я знал, что эта самонадеянная девчонка когда-нибудь навернется. Поговори с Гнилым Уильямом. Ему найдется что тебе сказать».~
@3559 = ~Уйти.~
@3560 = ~«Не будь бесполезным для общества, иди и убей!»~
@3561 = ~Уйти.~
@3562 = ~«Ты! Сдохни! ЗАТОЧКИ! В АТАКУ!»~
@3563 = ~Атаковать.~
@3564 = ~Убежать.~
@3565 = ~«Запоминай, что я скажу: не разговаривай со мной. Поговори с Кристалл. Поговори с Кристалл. Поговори с Кристалл. Уяснил картину?»~
@3566 = ~Уйти.~
@3567 = ~«Эй, приятель... Спасибо за этого правдоборца. Все наши, с кем я говорил, только рады этому. А уж Кристалл будет особенно рада».~
@3568 = ~Уйти.~
@3569 = ~«Мы высоко ценим помощь в борьбе с этим правдоборцем. Удачи с ним!»~
@3570 = ~Уйти.~
@3571 = ~«Заточек с Темного переулка больше нет! Переулок теперь наш!»~
@3572 = ~Уйти.~
@3573 = ~«Преподай урок этим Заточкам с Темного переулка!»~
@3574 = ~Уйти.~
@3575 = ~«Как ты посмел показать свою морду здесь? Умри мерзавец!»~
@3576 = ~Уйти.~
@3577 = ~«Эй! Свежее мясо! Выбирай — или ты мне отдаешь свои деньги, или я забираю твою душу».~
@3578 = ~«Вот все мои деньги. Не трогай меня».~
@3579 = ~«Есть еще деньги? Давай-ка проверим».~
@3580 = ~«Не в этот раз. Тебе придется взять их с моего тела».~
@3581 = ~«На, бери».~
@3582 = ~Фелл — павший дабус, бывший слуга Леди Боли и один из немногих оставшихся жрецов мертвого бога порталов, Аоскара. Он получил некоторую известность в качестве мастера татуировок, каким-то образом вдыхая жизнь в свои картины. Просто вернись в Феллу с рассказами о своих подвигах, и он сможет изобразить их на твоей коже, что позволит тебе черпать из них силу.~
@3583 = ~Падшая Грация — суккуб, одна из танарри, существ, буквально созданных из чистого хаоса и зла. Ее тело и разум — прекрасный образец для соблазна мужчин всех видов и возрастов. Она — владелица Борделя утоления интеллектуальной страсти.~
@3584 = ~Каким-то образом этот дрон обрел способность ощущать и сверг своего модрона-начальника. Однако, прежде чем он успел воплотить какие-либо из своих серьезных намерений, врубилась защита от сбоев куба модронов и поместила дрона в стазис. Теперь ты вновь активизировал его. Рад за тебя.~
@3585 = ~Эбб Коленоскрип — старый член Гармониума, который, удобно устроившись в кресле в Тлеющем трупе, с удовольствием треплет языком со всяким, кто готов его выслушать. Он просто кладезь информации, если только ты сможешь продраться сквозь его длинные пассажи и отступления.~
@3586 = ~Даккон — гитцерай, один из представителей немногословного народа с Лимбо. У него желтая морщинистая кожа. Похоже, он уже старик; в его маленьких черных глазах таится боль. У него есть клинок из странного металла.~
@3587 = ~Легкие дроны не представляют какой-либо угрозы: они были созданы, чтобы обеспечить базовый уровень сложности «странствующим приключенцам». Тем не менее, они мелкие и надоедливые.~
@3588 = ~Один из наивысших уровней иерархии баатезу во всем Бааторе, корнугоны, прокладывают себе путь через ряды собратьев с помощью бесчисленных поколений предательства, самопожертвований, обмана и всех видов порока. Покрытые шипами, с парой огромных крыльев и мощной мускулатурой, они похожи на безмозглых тварей и часто извлекают из этого выгоду: на самом деле они весьма умные существа, и насколько хитроумны их планы — словами не описать.~
@3589 = ~По отдельности черепные крысы — не более чем обычные мусорные крысы плюс небольшое дополнение в виде открытых пульсирующих мозгов в черепе. Но только дайте им собраться в группу, и они становятся намного более опасными: находясь вблизи других черепных крыс, они образуют коллективный разум, который становится все сильнее с каждой новой крысой. Их интеллект может быстро приблизиться к богоподобным созданиям, и они приобретают навыки магии и другие пугающие умственные способности. Ослабить коллективный разум можно, лишь убив большое количество крыс. Лучше всего при любой возможности их избегать.~
@3590 = ~Эти конструкты сильнее других существ, населяющих лабиринт модронов. Они бывают двух видов, один сильнее другого. Они оба сильнее легких дронов, и достаточно опасны, чтобы остерегаться их.~
@3591 = ~Дабусы являются слугами Леди Боли, таинственной повелительницы Сигила. Они парят над землей и общаются с помощью ребусов, цепочек символов, витающих вокруг них. По негласному приказу Леди они рушат стены и возводят целые улицы. В них есть что-то неправильное.~
@3592 = ~Эти горожане злы и подозрительны. Они носят поверх себя защитный слой клинков, повторяющий барьеры в их сердцах. Их внешность отражает их реальность.~
@3593 = ~Законники Проклятого жестоки и часто несправедливы. Они — всего лишь инструменты в руках местного диктатора, Товуса Гильяфа. Они поддерживают нищенское состояние и недоверчивости горожан.~
@3594 = ~Неизвестные существа~
@3595 = ~Ты еще не встречал ни одного существа из этой категории.~
@3596 = ~Сборщики — жалкие подобия людей, плывущие по течению в Улье. Они влачат подобие жизни, собирая тела умерших на улицах Улья и доставляя их к Моргу в обмен на деньги тленных. Ты знаешь, что однажды они уже приносили твое тело с улиц...~
@3597 = ~Эти монстры родом из плана-тюрьмы Карцери. Их огромные клыки наносят болезненные раны тем, кому не посчастливилось встретить их на пути. Естественный пластинчатый панцирь защищает их от сокрушительных атак. Непохоже, что они слишком умные, но отсутствие мозгов они компенсируют мышцами. Тем хуже.~
@3598 = ~Анна — тифлинг, дерзкая девчонка на пороге созревания. Когда она сердится, ее выдает мечущийся из стороны в сторону хвост. Она — смышленая беспризорница; Улей для нее — вторая шкура.~
@3599 = ~Адвокат — это тот, кто посвящает себя изучению сигильских законов, ища смысл в запутанной структуре правопорядка, которая не дает городу развалиться. Они могут представлять человека в суде, оформлять наследства (также известные как «завещания») и выполнять иные задачи, касающиеся чьей-либо гражданской позиции в обществе.~
@3600 = ~Абишаи — одна из низших форм баатезу, расы законопослушной нечисти, которая стремится навязать злу жестокую тиранию. Красные абишаи — наивысшие из абишаев, стоящие выше зеленого и черного подвидов. Они — пехота и стрелки на Кровавой войне. Они злобные и, в сравнении с остальными расами баатезу, не особо сообразительные. Красные абишаи находятся в шаге от повышение до более высоких форм баатезу.~
@3601 = ~Абишаи — одна из низших форм баатезу, расы законопослушной нечисти, которая стремится навязать злу жестокую тиранию. Зеленые абишаи — второй ранг абишаев: над черным и под красным подвидом. Они — пехота и стрелки на Кровавой войне. Они злобные и, в сравнении с остальными расами баатезу, не особо сообразительные.~
@3602 = ~Абишаи — одна из низших форм баатезу, расы законопослушной нечисти, которая стремится навязать злу жестокую тиранию. Черные абишаи — наиболее низкий подвид абишаев: под зеленым и красным подвидами. Они — пехота и стрелки на Кровавой войне. Они злобные и, в сравнении с остальными расами баатезу, не особо сообразительные.~
@3603 = ~Фарод Червеволосый — король сборщиков Улья, человек с покалеченным телом и духом. Однако его разум, похоже, не потерял своей остроты. Он держит Погребенную деревню в железной хватке, строя в шеренги даже разрозненную толпу. Он подлец и вор, и похоже, что он знает о тебе слишком многое, хотя и не делится этим без... уговоров.~
@3604 = ~Находясь на ступеньку выше лемура в пищевой цепи баатезу, нупперибо по сути являют собой глупую пузырящуюся глыбу плоти, состоящую из чистейшего зла и порядка. Ведомые жестокими кнутами своих начальников, их группы могут образовывать боевые шеренги, без усилий накрывающие врага. Само собой, нупперибо можно ранить только волшебным или священным оружием.~
@3605 = ~Этот модрон, похоже, слегка отличается от других встреченных тобой. В своих четырех руках он носит пару арбалетов, и, похоже, проявляет к тебе активный интерес.~
@3606 = ~Модроны, воплощение идеального порядка, происходят с Механуса, плана-механизма абсолютного порядка. Они придерживаются строгой кастовой системы, настолько совершенной, что они могут осознавать только смежные касты. Их унифицированный разум настолько идеален, что у них нет индивидуальности и собственного я. У них нет амбиций, нет эмоций, и они существуют лишь для того, чтобы выполнять приказы вышестоящих модронов.

Конечно, в любой системе должны быть изъяны. Существует вероятность, что модрон получит индивидуальность и станет бродягой. Ты не имеешь ни малейшего представления, как это может случиться.~
@3607 = ~Одна из наиболее пугающих фракций Сигила, Убийцы милосердия, или Красная Смерть, непоколебимы в своей погоне за справедливостью. Они верят, что без справедливости не может быть правды. Они назначили себя стражниками и палачами истинной справедливости во всей мультивселенной. Единственное достоинство, оправдывающее их, — это то, они вершат правосудие над всем, включая самих себя, и не навязывают несправедливых законов. Их фанатичная преданность вызывает беспокойство, но она может быть использована и против них самих. ~
@3608 = ~Хозяин Костей ночи Лотар держит в своем салоне полки, заполненные черепами. Они рассказывают давно забытые тайны, их шепот заполняет *его* череп сокровенными знаниями. Наверно, он один из тех немногих на свете, кто в самом деле может уничтожить тебя. Народ Сигила произносит его имя благоговейным полушепотом и активно стремится избегать оскорблений в его адрес.~
@3609 = ~Низшие представители орд законопослушно-злых баатезу, лемуры, представляют собой воплощения духов настоящего зла. Их используют в Кровавой войне как пушечное мясо, и их вряд ли назовешь умными. Чтобы ранить их, понадобится волшебное или священное оружие, поскольку их желеобразная плоть затягивает любые нанесенные раны.~
@3610 = ~Леди — загадка. Она широко известна в роли фактической правительницы Сигила, его защитницы и жертвы. Говорят, что она охраняет дверь в Клетку от бесконечных интриг богов, что она — предельное выражение равновесия в мультивселенной и пленница Города дверей. Существуют тысячи рассказов о ней — в одной даже говорится, что на самом деле она — шесть гигантских белок, одевшие головной убор, платье и кольцо левитации и иллюзий, — но ни один из них нельзя подтвердить. Она настоящая загадка, головоломка без решения.

Если кто-нибудь сердит ее, смещая равновесие в городе или поклоняясь ей, Леди может наказать виновного. Ее наказание может разнится от помещения в лабиринты, запутанные пекла с хитро спрятанным выходом, до отбрасывания тени на обидчика, покрывая его порезами и ранами от острых граней ее тени и оставляя в луже крови и куче собственных внутренностей. Любой из этих вариантом не особо привлекателен.~
@3611 = ~Эти безобидные насекомые — не более чем гигантские блохи. Однако их можно дрессировать, и они, похоже, преданы своим хозяевам. Насколько глубока их преданность — еще стоит изучить.~
@3612 = ~Эти похожие на птиц существа — податливые твари, живущие в стаях на Внешних землях. Кажется, они дружелюбны, но что случится, если их рассердить, остается загадкой. Интересно, какие они на вкус.~
@3613 = ~В баре «Тлеющий труп» над решеткой висит горящий человек. Его кожа пузырится и увечится, пламя вырывается из его глаз, и все же взгляд у него отдаленный, почти как если бы он наслаждался огнем.~
@3614 = ~Первым о сомьен тебя возвестил грохот их копыт. Четвероногие создания из чистого зла, сомьен имеют тело лошади и голову кошмара. Их шипастые плечи делают их еще более устрашающими. Похоже, они передвигаются в плотоядных стадах.~
@3615 = ~Гронки — крупные тупые существа, до глупости агрессивные. Обычно они кротки до тех пор, пока никто не нарушает их территорию, и, к несчастью, когда ты увидел одного из них, ты уже, наверно, ее нарушил. Лучше избегать с ними боя. Похоже, они невосприимчивы к дробящему оружию.~
@3616 = ~Эти вьючные животные сами по себе трусливы, и предпочитают охотится только вместе с собратьями. Они атакуют задними лапами, полосуя своих врагов бритвенно-острыми когтями. Похоже, они невосприимчивы к клинковому оружию...~
@3617 = ~Стражники боголюдей весьма преданы своей работе. Еще они очень уклончивы в ответах на вопрос, что творится в Литейной.~
@3618 = ~Еще одна фракция Сигила, боголюди, еще известна под названием «Верящие в Первопричину». Они верят, что все существа несут в себе искру божественности, что вся жизнь — это испытание, и каждый шаг — урок. Их непоколебимый оптимизм делает их весьма популярными. Они живут в Великой Литейной в Нижнем районе, мастеря одни из лучших металлических изделий на Планах.~
@3619 = ~Из всех танарри, демонических созданий, обитающих в Бездне хаоса и зла, немногое могут похвастаться хитростью, которой обладают похожие на собак глабрезу. Это избранные совратители умов смертных, предлагающие власть и знания, недоступные даже гениям. Конечно, эти знания имеют свою цену. Еще глабрезу — жестокие воины, числящиеся среди самых опасных существ, которые тебе встречались.~
@3620 = ~Гитцераи — давно отделившийся от гитьянки народ, и, в отличие от своих жестоких и злых бывших собратьев, гитцераи молчаливы и замкнуты, сжигаемые страстью, которая ведет их намного дальше, чем способно зайти большинство смертных. Они обитают в Лимбо, вечно меняющихся морях хаоса, живя в домах-крепостях, неуязвимых к нападениям местных жителей плана. Они изъясняются метафорами и легендами и держатся с тихим благородством.~
@3621 = ~Акаста — королева упырей из Мертвых Народов, слюнявая пожирательница плоти. Она не дает своей стае распасться в страхе перед Безмолвным Королем и неприкрытыми угрозами. Она груба, сильна и, несмотря на свою внешность, сообразительна. За ней нужен глаз да глаз.~
@3622 = ~Описание каменного голема-упыря.~
@3623 = ~У ходячих мертвецов много форм и размеров. У этого конкретного вида форма и размеры пожирателя падали, твари, которая живет за счет поедания мяса и костей, все равно, живых или мертвых. Упыри — дикие существа, у которых нет угрызений совести, а мозгов — так и подавно. К счастью, отделаться от них несложно.~
@3624 = ~Гехрелеты — нечисть-изгнанники планов, дикие воины, создающие себя из мертвых тел, разбросанных по сферам Карцери. Их боятся и презирают в равной мере, и заслуженно. Лучше держаться от них подальше. Если же тебе это не удастся, позаботься о том, чтобы при тебе было оружие, способное их отогнать.~
@3625 = ~Описание Железного Голема.~
@3626 = ~Эти существа куда менее приятны, чем земляные черви, вылезшие из земли после ливня. Они — огромные скользкие твари, питающиеся падалью. Из их ртов торчат острые зубы, способные оторвать крепкому мужчине руку, а ребенку — голову. ~
@3627 = ~Ликантропия — болезнь, передающаяся через укус зараженного существа, превращающая несчастную жертву в «оборотня», наполовину человека, наполовину зверя. Существует множество существ, распространяющих эту заразу: некоторые из них вполне благородны, другие вселяют страх и благоговение. Крысы не относятся ни к тем, ни к другим. Их родственники-оборотни — проныры мира оборотней, прячущиеся в тенях, всеми презираемые. Черты их характера в полной мере отражают это.

Мантуок, глас Многоединого, коллектива черепных крыс, — льстивый маленький ублюдок, чье лучшее качество в том, что он услужлив перед теми, у кого есть власть. Еще он в какой-то мере маг, и ради собственной выгоды готов продать своего хозяина. Похоже, он от души тебя ненавидит. Наверно, завидует.~
@3628 = ~Ликантропия — болезнь, передающаяся через укус зараженного существа, превращающая несчастную жертву в «оборотня», наполовину человека, наполовину зверя. Существует множество существ, распространяющих эту заразу: некоторые из них вполне благородны, другие вселяют страх и благоговение. Крысы не относятся ни к тем, ни к другим. Их родственники-оборотни — проныры мира оборотней, прячущиеся в тенях, всеми презираемые. Черты их характера в полной мере отражают это.~
@3629 = ~Этот доспех убийцы милосердия стоял в темнице Проклятого, наверное, многие годы. Он не потревожен, что странно, если учесть то, насколько жители Проклятого падки к быстрой наживе.~
@3630 = ~Ужасные создания с Нижних планов, варгульи, представляют собой отсеченные головы с крыльями. Мало того, что их укус смертелен, так еще по слухам укушенные сами становятся варгульями после смерти. Хотя варгульи не особо опасны в схватке один на один, они нападают стаями и могут оказаться смертельно опасными для неподготовленного странника. Бродящим по темным закоулкам и катакомбам следует быть начеку.~
@3631 = ~По слухам, в Черношипном лабиринте Равель можно найти саму легендарную ночную ведьму, но за века с тех пор, как она ушла из Сигила, ей предоставилась возможность изменить свой собственный лабиринт. Пока она бродила по лабиринту, с ее волос упали семена, и благодаря особой энергетике лабиринта появились эти существа, тригиты. В сущности, это разумные деревья, снедаемые жаждой крови.~
@3632 = ~Трокопотоки — большие белые крокодилообразные существа, любящие сырость. Они живут в катакомбах под улицами Сигила, сражаясь с варгульями и сборщиками, у которых хватило глупости забрести в их логово. Это настоящая легенда среди матерей Улья, которой пугают и детей, и преступников. Они существуют. Они мерзкие.~
@3633 = ~Триас — дэва, небожитель с Верхних планов. Ты впервые встретил его в тюрьме Проклятого, заключенного в обсидиановый пузырь. Его красота изумляет. От него исходит аура божественности, похожая на волну яркого света. Его крылья обуглены до кости, и все же он с гордостью терпит свои страдания.~
@3634 = ~Ты всегда считал, что жуки — это мелкие твари, которых можно раздавить ботинком. Ты бы не стал называть их разумными. И уж точно не назвал бы их садистами. По крайней мере, до тех пор, пока не увидел трелонов. Эти шипящие твари, похожие на жуков, живут в темноте и питают особую страсть к причинению боли. Похоже, что они — порождения Нижних планов: в них явно ощущается зло.~
@3635 = ~Описание Запредельного.~
@3636 = ~Харгримм, лидер скелетов из Мертвых Народов, является скелетом-жрецом, который несет слово Безмолвного Короля его последователям. Вместе с зомби Тухлой Мери и королевой упырей Акастой в двух других углах он составляет триумвират, который держит Мертвые Народы в состоянии шаткого равновесия. Смещение равновесия в ту или иную сторону приведет к хаосу.~
@3637 = ~Описание скелета в латах.~
@3638 = ~Эти тени довольно-таки похожи на два других встречавшихся тебе вида, однако они вооружены отвратительными когтями и страстным желанием твоей смерти. Они опасны и по одиночке, но обычно охотятся в стаях, становясь смертельно опасными.~
@3639 = ~Тени-скелеты, занявшие место первых встреченных тебе теней, похоже, куда более опасны. Их вытянутые конечности оканчиваются зловещими когтями, и они роятся как насекомые.~
@3640 = ~Эти тени — бледные женоподобные духи, бесшумно поднимающиеся из-под земли. Они нападают без предупреждения, и больше похожи не на воинов, а на кровожадных тварей.~
@3641 = ~Все рассказы о Равель Заморочке, которые ты слышал, готовили тебя к омерзительному монстру, который поглотит твою душу. Если она и намеревалась это сделать, то выбрала для этого странный способ. Несомненно, она безумна, и заточена в черношипном лабиринте колючек и зла. Ты не можешь удержаться и не пожалеть ее, несмотря на могущество, которым она обладает: она потеряла все, и даже не подозревает об этом.~
@3642 = ~Печальная правда жизни: нередко для женщины единственный способ выжить — это продавать свое тело и разум мужчинам, нуждающимся в разрядке и собеседнике. К несчастью, стоит отметить, что улицы Улья просто захламлены огромным количеством проституток.~
@3643 = ~Алу-демон, дитя танарри и отца-человека, имеет схожую с суккубом внешность. Кое-кто из них подавляет в себе зло. Куда большее число пытается превзойти своих нечистых родителей в абсолютном зле и жестокости. Мудрым решением будет не доверять танарри.~
@3644 = ~Кредо Гармониума, одной из фракций Сигила, — «Живи правильно». К несчастью для остальных, это переводится как «Живи как мы, не то пожалеешь». Они твердо верят в господство закона, и посему служат в качестве силовиков на сигильских улицах. Их красная броня помогает им выделяться на городских улицах.~
@3645 = ~Описание среднего боевого дрона.~
@3646 = ~Токола — это здоровенные неповоротливые гуманоиды. Их тела почти полностью покрыты коричневой шерстью, выступающая челюсть почти не скрывает уродливых зубов. Они — воины, для них нет ничего лучше славной потасовки. Лучше их не выводить из себя.~
@3647 = ~Эта отвратительная масса голов одиноко возвышается над огненными пустынями Авернуса, первого слоя Баатора. Похоже, что она состоит из голов лжецов и злонамеренных мудрецов — наказание для тех, кто небрежно относился к дару знаний. Ты слышал, что у Колонны есть сведения о твоем бессмертии — бесценная тайна, которая вела тебя к ним на протяжении этих долгих лет.~
@3648 = ~«Я ищу дневник».~
@3649 = ~«Я просто проходил мимо».~
@3650 = ~«Мне не нужны неприятности».~
@3651 = ~«Черный Бутон хочет твоей смерти».~
@3652 = ~«Кристалл хочет твоей смерти».~
@3653 = ~«Это не твое дело».~
@3654 = ~«Значит, ищешь Фарода? Что ж, за определенную плату я могу тебе сказать, где найти его».~
@3655 = ~«Сколько?»~
@3656 = ~«Хорошо, держи. Где он?»~
@3657 = ~«Я не заинтересован в этом».~
@3658 = ~«У меня нет столько».~
@3659 = ~«Это я уже слышал!»~
@3660 = ~«Спасибо. Прощай».~
@3661 = ~Он оценивающе смотрит на тебя. «Каких-то жалких пять медяков. Справедливая цена для такого отчаянного, как ты».~
@3662 = ~«А что мне от этого будет?»~
@3663 = ~«Я сделаю это».~
@3664 = ~«Нет. Я не наемный убийца».~
@3665 = ~«Сперва я хочу это обдумать».~
@3666 = ~«Я ищу дневник».~
@3667 = ~«Я просто проходил мимо».~
@3668 = ~«Ты можешь найти его на площади Старьевщиков. Ищи его и его сборщиков, и тогда у тебя не будет с этим затруднений».~
@3669 = ~«Мне не нужны неприятности».~
@3670 = ~«Черный Бутон хочет твоей смерти».~
@3671 = ~«Кристалл хочет твоей смерти».~
@3672 = ~«Ага, тогда, быть может, мы найдем более интересную тему. Есть тут рохля по имени Кристалл, заправляет маленькими сестричками, которых называют Бритвенными Ангелами. Избавься от нее, и тогда поговорим о награде».~
@3673 = ~«Это не твое дело».~
@3674 = ~«Я просто хочу знать, что мне от этого будет».~
@3675 = ~Карине нужен друг.~
@3676 = ~«Ну да, но ты ведь получил то, за что платил. Итак... что ты здесь делаешь?»~
@3677 = ~«Я тебе разве не сказал, что мы поговорим об этом только после того, как ты разберешься со своим мокрым делом? Я на полном серьезе, пень. Ты займешься этим или нет?»~
@3678 = ~«Великолепно! Возвращайся, когда закончишь. Мне не нужен твой скулеж по поводу того, что ты этого не можешь сделать. Мы заключили сделку и рассчитаемся позднее».~
@3679 = ~«Рекомендую изменить свое мнение. Не будем спешить, хорошо? Что скажешь насчет двух сотен монет?»~
@3680 = ~«Ты получишь то, что заслуживаешь, пень. Как насчет двух сотен монет, а? По рукам?»~
@3681 = ~«А как насчет большей суммы?»~
@3682 = ~«Хорошо, по рукам».~
@3683 = ~«Три сотни. Мое последнее слово».~
@3684 = ~«Ты сам выбрал этот путь. Жаль, что он не оказался верным, — он повышает свой голос. — Заточки! Разберитесь с этим потрохом!»~
@3685 = ~«Дневник, да? Не записная книжка? Не бухгалтерская? Именно дневник?» На миг он умолкает, и, когда ты уже готов ответить, говорит: «Если бы он оказался здесь, то он бы сразу пошел на разжигание костра. Нет, не видел».~
@3686 = ~«Просто проходил мимо, да? Как жаль. Никто не может пройти здесь бесплатно».~
@3687 = ~Он начинает хохотать и поднимает руку. «Не так быстро, приятель. Это не та плата, о которой я говорил. Это кое-что совсем другое. Видишь ли, есть здесь рохля, заправляет бандой на другой стороне улицы, и я хотел бы, чтобы ты записал ее в книгу мертвых... кровью. Ее зовут Кристалл».~
@3688 = ~«Небольшая плата кровью. Хорошая новость: эта кровь — не твоя. Кровь чужая — рохли по имени Кристалл, которая осмелилась пытаться отхватить у меня часть моей территории. Я хочу, чтоб ты нашел ее, и чтобы она пропала. Прикончи ее».~
@3689 = ~Я встретился с общительной девушкой по имени Карина. Она сказала мне, что люди ее избегают, и поэтому она одинока. Возможно, я смогу ей помочь.~
@3690 = ~«Нет. Я не наемный убийца».~
@3691 = ~Я встретил стражника Гармониума по имени Корвус. Кажется, он без ума от Карины, так что я сказал ему, что она ищет друга. Мне кажется, эти двое будут счастливы вместе.~
@3692 = ~«Конечно. Я сделаю это».~
@3693 = ~«Не беспокойся по этому поводу».~
@3694 = ~«Как насчет четырех сотен?»~
@3695 = ~«Нет. Я не хочу этого делать».~
@3696 = ~«Я сделаю это».~
@3697 = ~«Нет. Я не хочу этого делать».~
@3698 = ~«Ага, хорошая новость для тебя в том, что я не причиню тебя вреда. Нужно лишь выполнить небольшое поручение для меня. Ты меня внимательно слушаешь?»~
@3699 = ~«Нет. Я не хочу этого делать».~
@3700 = ~«По рукам. Считай, что она мертва».~
@3701 = ~Сражаться.~
@3702 = ~Сбежать.~
@3703 = ~«Я ищу Фарода».~
@3704 = ~«Я просто проходил мимо».~
@3705 = ~«Мне не нужны неприятности».~
@3706 = ~«Черный Бутон хочет твоей смерти».~
@3707 = ~«Кристалл хочет твоей смерти».~
@3708 = ~«Это не твое дело».~
@3709 = ~«Я уже заплатил».~
@3710 = ~Блеф: «Я уже заплатил».~
@3711 = ~«Какая цена?»~
@3712 = ~«Я хотел бы, чтобы ты назвал точную сумму».~
@3713 = ~«А что мне от этого будет?»~
@3714 = ~«Я сделаю это».~
@3715 = ~«Нет. Я не наемный убийца».~
@3716 = ~«Сперва я хочу это обдумать».~
@3717 = ~«А что мне от этого будет?»~
@3718 = ~«Сколько?»~
@3719 = ~«Боюсь, что мне это неинтересно».~
@3720 = ~«Я сделаю это».~
@3721 = ~«Нет. Я не наемный убийца».~
@3722 = ~«Сперва я хочу это обдумать».~
@3723 = ~«Что такое?»~
@3724 = ~«Да».~
@3725 = ~«Вот как. Так ты собираешься выполнять это поручение?»~
@3726 = ~«Не уверен».~
@3727 = ~Сражаться.~
@3728 = ~«Я — Черный Бутон. Я охочусь и жажду. Я — кара. Итак, объяви свои убеждения».~
@3729 = ~Понятно. Ну, спасибо.~
@3730 = ~«Я буду ждать тебя. Ступай. Сейчас же».~
@3731 = ~«Никаких вопросов. Только действия. Иди».~
@3732 = ~«Есть тут такая себе Кристалл. Она лидер Бритвенных Ангелов. Она пытается 'придать блеску' этому переулку и обратить его в яркий пример доброты. Убей ее — и будешь вознагражден. Не справишься — и за тобой будут охотиться до конца твоей жизни».~
@3733 = ~Его глаза ярко вспыхивают, затем смягчаются. Звук его голоса похож на выдох. «Нейтральный. Союзник. Ты понимаешь баланс. Окажи мне услугу. Я устраняю крайности».~
@3734 = ~«Я охочусь за Бритвенными Ангелами и Заточками с Темного переулка. Выбери одного из их лидеров и устрани его».~
@3735 = ~Его горящие глаза сужаются, и он шепчет: «Выходит, ты враг». Сделав неясное движение, он бросается в атаку!~
@3736 = ~«А теперь укрепим наши философии. Устроим поединок на оружии. Выигравший станет истинным победителем в нашей борьбе за правду».~
@3737 = ~Его глаза расширяются. «Ты бессмертен. Твоя правда вечна. Отдаю тебе должное. Это честь для меня. Прощай».~
@3738 = ~«Ты прикончил Гнилого Уильяма?»~
@3739 = ~Это первый узел.~
@3740 = ~Боже, первый узел. Что ты можешь сказать об этому узле?~
@3741 = ~Да срать я хотел на этот узел.~
@3742 = ~Первый узел очень захватывает, особенно в диалоге.~
@3743 = ~Какой ты грубый!~
@3744 = ~«Это ведь одна из студий Фелла? Давно хотел с ним познакомиться».~
@3745 = ~«Работай *быстрее*. Вперед. Я жду тебя». Он скрещивает руки.~
@3746 = ~«Твое следующее задание — убить Кристалл, лидера Бритвенных Ангелов. Баланс требует ее смерти».~
@3747 = ~«Ты прикончил Кристалл?»~
@3748 = ~«Твое следующее задание — прикончить Гнилого Уильяма, лидера Заточек с Темного переулка. Баланс требует этого от тебя».~
@3749 = ~«Я думаю, что лучше помогать тем, кому повезло меньше, чем мне. Я выбираю добро».~
@3750 = ~«Идея добра — для слабаков. Я выбираю зло».~
@3751 = ~«Ни того, ни другого. Крайности опасны».~
@3752 = ~«Кто ты?»~
@3753 = ~«Хорошо. Я сделаю это».~
@3754 = ~«Я не стану делать этого. Я не убиваю людей».~
@3755 = ~Сражаться.~
@3756 = ~Сбежать.~
@3757 = ~«Я думаю, что лучше помогать тем, кому повезло меньше, чем мне. Я выбираю добро».~
@3758 = ~«Идея добра — для слабаков. Я выбираю зло».~
@3759 = ~«Ни того, ни другого. Крайности опасны».~
@3760 = ~«Сперва я хочу задать несколько вопросов...»~
@3761 = ~Твоя Ловкость ниже средней.~
@3762 = ~«Я ухожу».~
@3763 = ~«Отлично».~
@3764 = ~«Я сделаю это».~
@3765 = ~«Я так не думаю».~
@3766 = ~Сражаться.~
@3767 = ~Сбежать.~
@3768 = ~«Что я могу сделать?»~
@3769 = ~«Я не думаю, что хочу помогать тебе».~
@3770 = ~«Я возьмусь за Бритвенных Ангелов».~
@3771 = ~«Я возьмусь за Заточек с Темного переулка».~
@3772 = ~«Гнилой Уильям, лидер Заточек с Темного переулка, уже мертв. Я убью Кристалл».~
@3773 = ~«Кристалл, лидер Бритвенных Ангелов, уже мертва. Я убью Гнилого Уильяма».~
@3774 = ~«Они оба уже мертвы».~
@3775 = ~«Не думаю, что я заинтересован помогать тебе».~
@3776 = ~Сражаться.~
@3777 = ~Сбежать.~
@3778 = ~«Я сделаю это, но я не могу умереть. В конечном счете ты проиграешь».~
@3779 = ~«Ты что, спятил?»~
@3780 = ~Сражаться.~
@3781 = ~«Прощай».~
@3782 = ~«Еще нет. И не собираюсь».~
@3783 = ~«Нет. Я работаю над этим».~
@3784 = ~«Да».~
@3785 = ~«Да».~
@3786 = ~«Вот и отлично».~
@3787 = ~«Я не буду этого делать».~
@3788 = ~«Я еще вернусь».~
@3789 = ~Фракция: Свободная Лига («Свободные»)

Девиз: Свободные — знатоки-индивидуалисты, собравшиеся вместе, чтобы защититься от остальных фракций. Истина? Нет «истины» — живи свободным или умри.~
@3790 = ~«Еще нет. И не собираюсь».~
@3791 = ~«Нет. Я работаю над этим».~
@3792 = ~«Да».~
@3793 = ~«Да».~
@3794 = ~«Я не хочу этого делать».~
@3795 = ~«Я еще вернусь».~
@3796 = ~«Так это ты избавился от этой карги Кристалл, да? Думаешь, теперь ты можешь не платить? Очень жаль, но это правда. Проходи».~
@3797 = ~«Спасибо. Прощай».~
@3798 = ~«Приветствую, странник. Кажется, теперь ты на территории Заточек с Темного переулка. Похоже, у тебя есть кошелек, который можно немного облегчить. И молись, что нам этого хватило».~
@3799 = ~«Мне нужно переговорить с вашим главарем».~
@3800 = ~«Сколько тебе надо?»~
@3801 = ~«Это не остановит меня просить тебя об этом каждый раз при встрече. Это нужно сделать».~
@3802 = ~«Далеко ли ты продвинулся в прописывании Гнилого Уильяма в книгу мертвых?»~
@3803 = ~«А я говорила, что буду продолжать тебя просить об этом, пока ты не согласишься».~
@3804 = ~«Тогда почему ты все еще треплешься со мной? Эту работу нужно выполнить!» Она отворачивается от тебя.~
@3805 = ~«Правда? Гнилой Уильям мертв? Благодарю тебя, путник, теперь ты никогда больше не будешь платить за проход через переулок Опасных Углов. Но у меня осталась еще одна просьба».~
@3806 = ~«Здесь есть опаснейший убийца, волк-одиночка, который носит имя 'Черный Бутон'. Он охотится на моих людей. Я прошу тебя остановить его».~
@3807 = ~«Звенелки. Твердой монетой. Много. Ты заинтересован?»~
@3808 = ~«Тогда разыщи Черного Бутона в переулке и пропиши его в книге мертвых. Когда он будет мертв, возвращайся — и я награжу тебя».~
@3809 = ~Она улыбается. «Ты, конечно, понимаешь, что я буду продолжать тебя просить до тех пор, пока ты не согласишься. До встречи, прощай».~
@3810 = ~«Ты нашел Черного Бутона? Избавил переулок от него?»~
@3811 = ~Найти долговую расписку Трист.~
@3812 = ~Она протягивает тебе огромный, весь в заплатках, кошелек. «Благодарю тебя от своего имени и от имени Бритвенных Ангелов. Теперь мы друзья, и мы не забудем тебя».~
@3813 = ~Женщину по имени Трист собираются продать в рабство, потому что она не может досказать, что заплатила долг перед Байроном Пикитом. Я согласился попробовать разыскать ее долговую расписку, чтобы освободить ее.~
@3814 = ~«Приветствую тебя, друг. Прими мои благодарности. Будь в переулке — насколько это возможно — как дома. Прощай».~
@3815 = ~Я вернул Трист долговую расписку и теперь она свободна.~
@3816 = ~«Пожалуйста, попробуй. Он вырезает моих людей».~
@3817 = ~~
@3818 = ~«Расскажи мне о свой банде».~
@3819 = ~«Расскажи мне о Бритвенных Ангелах».~
@3820 = ~«Расскажи мне о переулке».~
@3821 = ~«Я ищу Фарода».~
@3822 = ~«Я ищу дневник».~
@3823 = ~«Черный Бутон хочет убить тебя. И я здесь, чтобы это сделать».~
@3824 = ~«Гнилой Уильям хочет убить тебя. И я здесь, чтобы это сделать».~
@3825 = ~«Ничего».~
@3826 = ~«Расскажи мне о свой банде».~
@3827 = ~«Расскажи мне о Бритвенных Ангелах».~
@3828 = ~«Расскажи мне о переулке».~
@3829 = ~«Я ищу Фарода».~
@3830 = ~«Я ищу дневник».~
@3831 = ~«Черный Бутон хочет убить тебя. И я здесь, чтобы это сделать».~
@3832 = ~«Ничего».~
@3833 = ~«Звучит неплохо».~
@3834 = ~ «Спасибо за информацию. Прощай».~
@3835 = ~«Включая и вас?»~
@3836 = ~«Понятно. Ладно, мне нужно идти. Прощай».~
@3837 = ~«Тебе не встречался где-нибудь поблизости дневник?»~
@3838 = ~Найти доказательства того, что Байрон Пикит — преступник.~
@3839 = ~«Спасибо. Прощай».~
@3840 = ~У вора Ленни на складе хранится доказательство того, что Байрон Пикит — преступник. Мне нужно пойти туда и забрать его.~
@3841 = ~«Хорошо. Ты не знаешь, где я могу найти человека по имени Фарод?»~
@3842 = ~Я дал показания стражнику Гармониума Корвусу, что Байрон Пикит является преступником. Он арестовал Байрона и проследит, что тот предстал перед лицом правосудия.~
@3843 = ~«Все равно благодарю. Прощай».~
@3844 = ~«Расскажи мне о свой банде».~
@3845 = ~«Звучит заманчиво. Договорились».~
@3846 = ~«Я не убийца».~
@3847 = ~«Как угодно. Прощай».~
@3848 = ~«Может быть. Прощай».~
@3849 = ~Убить абишая Гросука для Себастиона.~
@3850 = ~Маг по имени Себастион хочет, чтобы я убил абишая по имени Гросук. За это он поможет мне с моими шрамами.~
@3851 = ~«Прощай».~
@3852 = ~Я убил абишая Гросука для Себастиона. Он был благодарен и помог мне с моими шрамами.~
@3853 = ~Я согласился убить Гнилого Уильяма.~
@3854 = ~«Забудь. Я не хочу этого делать».~
@3855 = ~«Тогда я сделаю это».~
@3856 = ~«Я убью его».~
@3857 = ~«Уж очень он похож на меня. Прощай».~
@3858 = ~«Я не хочу этого делать».~
@3859 = ~«Тогда, наверное, мне лучше это сделать».~
@3860 = ~«Я все еще не хочу этого делать. Прощай».~
@3861 = ~Cornugon Damage 1~ [CORNU06]
@3862 = ~Zombie Male Damage1~ [ZOMBW06]
@3863 = ~Zombie Male Damage2~ [ZOMBW07]
@3864 = ~Zombie Male Death~ [ZOMBW08]
@3865 = ~Skeleton Worker Battle Cry 2 (Approach 2)~ [SKELW02]
@3866 = ~Skeleton Worker Damage 1~ [SKELW06]
@3867 = ~Skeleton Worker Damage 2~ [SKELW07]
@3868 = ~Skeleton Worker Death~ [SKELW08]
@3869 = ~[no text]~
@3870 = ~«Эй! Эй! Что ты делаешь?»~
@3871 = ~«Я *хотел* поговорить с этим парнем. Проблемы?»~
@3872 = ~«Ничего. Идем».~
@3873 = ~«Если ты собираешься трясти черепушкой с трухлявыми, то, пожалуйста, без меня. Я с ними не в лучших отношениях... и тебе не стоит с ними родниться. Они скорее спалят тебя или заживо зароют, чем будут слушать. Не валяй дурака, давай выбираться отсюда».~
@3874 = ~«Спасибо за совет, но я *все еще* хочу поговорить с этим парнем».~
@3875 = ~«Согласен. Идем».~
@3876 = ~«Эй! Ты оглох, что ли? Ты что творишь?»~
@3877 = ~«Слушай, я хочу поговорить с этим парнем. Проблемы?»~
@3878 = ~«Ничего. Идем».~
@3879 = ~«Тогда *не слушай* меня больше — тебя похоронят».~
@3880 = ~«Да-да, а ты сможешь поплакаться на панихиде. А пока — умолкни».~
@3881 = ~«А, ты прав. Забудь об этом. Идем».~
@3882 = ~Оставить тело, уйти.~
@3883 = ~Ты недостаточно быстр, и тленный уворачивается от твоего выпада. Отступив на шаг, он быстро хлопает в ладони три раза. В ответ во всем Морге раздается звон огромного железного колокола.~
@3884 = ~«Ну хорошо...»~
@3885 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@3886 = ~«Давай, зови их. Буду рад с ними встретиться».~
@3887 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@3888 = ~«Давай, зови их. Буду рад с ними встретиться».~
@3889 = ~Ты наклоняешься, чтобы «шепнуть» ему что-то на ухо, тленный тоже наклоняется. Как только он оказывается на расстоянии вытянутой руки, ты хватаешь его за виски и резко сворачиваешь голову влево. ~
@3890 = ~«Нельзя дать тебе предупредить своих друзей...»~
@3891 = ~Тленный явно что-то подозревает. Похоже, он хочет что-то сказать, затем едва качает головой и возвращается к своим обязанностям.~
@3892 = ~Уйти прочь.~
@3893 = ~Тленный внимательно тебя осматривает. «Ты не из наших. Что ты здесь делаешь? Ты из анархистов? Или шпион другой фракции? Кажется, здесь есть дело для стражников...»~
@3894 = ~Тленный кивает, затем возвращается к своим обязанностям.~
@3895 = ~Уйти прочь.~
@3896 = ~Тленный хмурится. «Это имя мне незнакомо».~
@3897 = ~Тленный продолжает хмуриться, но затем слегка кивает. «Ну хорошо. Что я могу сделать для тебя, посвященный?»~
@3898 = ~«Я недавно посвящен. Прости мое невежество».~
@3899 = ~«Я... недавно здесь. Я... пытаюсь изучить порядки».~
@3900 = ~«Ну... к чему имена? Храни веру, э-э, посвященный».~
@3901 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@3902 = ~«У меня есть пара вопросов...» ~
@3903 = ~«На этот раз — ничего. Прощай».~
@3904 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@3905 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@3906 = ~Ложь: «Меня зовут... э-э, Адан».~
@3907 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@3908 = ~«Как меня зовут — не твое дело. Я должен идти. Прощай».~
@3909 = ~«Я... недавно здесь. Я... пытаюсь изучить обстановку».~
@3910 = ~«Ну... к чему имена? Храни веру, э-э, посвященный».~
@3911 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@3912 = ~«Ну... к чему имена? Храни веру, э-э, посвященный».~
@3913 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@3914 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@3915 = ~Свернуть ему шею до того, как он сможет позвать на помощь.~
@3916 = ~«Нет-нет... не он... то есть, я хотел сказать, не шпион... понимаешь, я очнулся на одной из плит... и...»~
@3917 = ~Уйти. Быстро.~
@3918 = ~«Я... недавно здесь. Я... пытаюсь изучить обстановку».~
@3919 = ~«Ну... к чему имена? Храни веру, э-э, посвященный».~
@3920 = ~«Если ты не можешь помочь мне, я поищу кого-нибудь, кто сможет. Прощай».~
@3921 = ~«Я слышал о тебе, пень... ты — тот, кто спрашивает всех о Фароде, верно? Если ты еще не нашел его, попробуй поискать его на севере отсюда, на площади Старьевщиков».~
@3922 = ~«Это не твое дело».~
@3923 = ~«Было приятно поболтать с тобой. Прощай».~
@3924 = ~Оставить зомби в покое.~
@3925 = ~«Тогда прощай». ~
@3926 = ~«Тогда прощай». ~
@3927 = ~Кто-то позаботился о том, чтобы связать кости скелета кожаными ремнями, окутывающими тело на манер, напоминающий мускулы и сухожилия. Ремни привязаны к железными скобам, вбитым в суставы скелета. Кажется, этот скелет довольно долго служил: на костях видно много трещин, залитых вонючим клеем.~
@3928 = ~Попробовать вытащить скобы из суставов скелета.~
@3929 = ~Попробовать вытащить скобы из суставов скелета.~
@3930 = ~Попробовать вытащить скобы из суставов скелета.~
@3931 = ~Попробовать вытащить скобы из суставов скелета.~
@3932 = ~Попробовать вытащить скобы из суставов скелета.~
@3933 = ~Попробовать вытащить скобы из суставов скелета.~
@3934 = ~Попробовать вытащить скобы из суставов скелета.~
@3935 = ~Попробовать вытащить скобы из суставов скелета.~
@3936 = ~«Как насчет этого скелета, Морт? Пойдет такое тело?»~
@3937 = ~Оставить скелет в покое.~
@3938 = ~Оставить скелет в покое.~
@3939 = ~Оставить скелет в покое.~
@3940 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@3941 = ~«Приятно было поболтать с тобой, Костяшка. Будь здоров».~
@3942 = ~Оставить скелет в покое.~
@3943 = ~Оставить скелет в покое.~
@3944 = ~Попробовать вытащить скобы из суставов скелета.~
@3945 = ~Попробовать вытащить скобы из суставов скелета.~
@3946 = ~Попробовать вытащить скобы из суставов скелета.~
@3947 = ~«Не против, если я возьму немного ремешков и скоб?»~
@3948 = ~«Не против, если я возьму немного ремешков и скоб?»~
@3949 = ~«Не против, если я возьму немного ремешков и скоб?»~
@3950 = ~Оставить скелет в покое.~
@3951 = ~Оставить скелет в покое.~
@3952 = ~Оставить скелет в покое.~
@3953 = ~Ты вытягиваешь скобы, но для этого тебе не хватает сил. Должно быть, их очень хорошо забили.~
@3954 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хммм. Я еще вернусь, Костяшка».~
@3955 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хммм. Я еще вернусь, Костяшка».~
@3956 = ~«Если бы у меня был подходящий инструмент, я бы смог их вытащить... хммм. Я еще вернусь, Костяшка».~
@3957 = ~Оставить скелет в покое.~
@3958 = ~Оставить скелет в покое.~
@3959 = ~Оставить скелет в покое.~
@3960 = ~Ты вытягиваешь скобы изо всех сил, и после некоторых усилий ты выдираешь их из суставов. Скелет разваливается, хотя некоторые кости продолжают шевелиться.~
@3961 = ~С помощью ломика ты вырываешь скобы из суставов. Скелет разваливается, хотя некоторые кости продолжают шевелиться.~
@3962 = ~«Прости, Костяшка...»~
@3963 = ~«Прости, Костяшка...»~
@3964 = ~«Эй, шеф. Это уже вандализм. Эти скобы — возможно, единственное, что не дает рассыпаться этому мешку с костями. Знаешь, с такими приятелями некромантия чудес не творит».~
@3965 = ~«И что?»~
@3966 = ~«О... Я не хотел ему навредить».~
@3967 = ~«Ну, тогда ладно. Может, в другой раз».~
@3968 = ~«Да нет, ничего». Морт делает странный жест. Тебе это кажется похожим на пожимание плечами. «Просто не был уверен, что ты это знаешь. Валяй, можешь попробовать».~
@3969 = ~Попробовать вытащить скобы из суставов скелета.~
@3970 = ~Попробовать вытащить скобы из суставов скелета.~
@3971 = ~Попробовать вытащить скобы из суставов скелета.~
@3972 = ~«Неважно, может быть, в другой раз».~
@3973 = ~«Неважно, может быть, в другой раз».~
@3974 = ~«Хм-м. Интересно, что подумает этот седобородый, если *я* возьму взаймы его тело...»~
@3975 = ~«Седобородый?»~
@3976 = ~«Не думаю, что он имеет что-то против».~
@3977 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@3978 = ~«Седобородый... ну знаешь, старикашка, старичье, рухлядь... старый».~
@3979 = ~«Ну, не думаю, что у него есть хоть один аргумент против. Почему бы и не взять его тело?»~
@3980 = ~«Что-то мне подсказывает, что будь у тебя руки, ты бы был в два раза назойливее. Идем».~
@3981 = ~Морт изучает скелет, но затем качает головой. «Не... Мне нужно что-нибудь посвежее. И что-нибудь чуть более величественней... а этот какой-то весь скрипучий и в трещинах».~
@3982 = ~«А ты, значит, нет?»~
@3983 = ~«Ладно. Идем».~
@3984 = ~«Ох, да ты просто кладезь хохм, — Морт свирепо смотрит на тебя. — Да и вообще. НА СЕБЯ посмотри. Зеркала молят о пощаде, когда ты проходишь мимо них».~
@3985 = ~«Да? Зато у *меня* все при себе».~
@3986 = ~«Идем».~
@3987 = ~Морт фыркает. Тебе совершенно непонятно, как это ему удалось без легких.~
@3988 = ~«Позволь мне сказать, Морт. Нет ничего лучше, чем ходить, размахивать руками, вдыхать свежий воздух через полные легкие. Иметь тело — это ОЧЕНЬ приятно».~
@3989 = ~«Идем».~
@3990 = ~«Помощь тебе в побеге из препараторской только что теперь добавлена в мой растущий список сожалений, — Морт снова фыркает. — Надо было оставить тебя там гнить... подольше, то есть».~
@3991 = ~«Очень приятно это слышать. Идем».~
@3992 = ~«Приветствую».~
@3993 = ~«Приветствую».~
@3994 = ~«Приветствую».~
@3995 = ~«Приветствую».~
@3996 = ~Осмотреть гигантского скелета... осторожно.~
@3997 = ~Посмотреть, сможешь ли ты разрушить чары, наложенные на нагрудник скелета.~
@3998 = ~Попробовать вытащить клинок из рук скелета.~
@3999 = ~Попробовать вытащить клинок из рук скелета.~
@4000 = ~Попробовать вытащить винты, держащие доспехи скелета.~
@4001 = ~Попробовать вытащить винты, держащие доспехи скелета.~
@4002 = ~«Эй, а как насчет ЭТОГО скелета, Морт? Пойдет такое тело?»~
@4003 = ~Использовать на скелете свою способность «История костей».~
@4004 = ~Оставить скелета в покое.~
@4005 = ~Как только ты касаешься скелета, по всему Моргу раздается звон железного колокола... а скелет моментально пробуждается, поднимая клинок для нападения!~
@4006 = ~Едва начав, ты внезапно останавливаешься... твой взгляд останавливается на доспехах скелета. Что-то в символах, вырезанных на нагруднике, заставляет тебя задержаться. Если эти скелеты — охранники, то лучше их не беспокоить, иначе... они могут проснуться. ~
@4007 = ~Замысловатые бронзовые доспехи скелета закреплены на грудной клетке и плечах с помощью нескольких железных скоб. Изучив тело под броней, ты замечаешь, что такие же железные скобы закреплены на плечевых, локтевых, тазовых и коленных суставах. Куча тонких кожаных лент и прочных веревок вьются по всей длине рук и ног скелета на манер мускулов и сухожилий.~
@4008 = ~Несмотря на почтенный возраст доспехов, за ними хорошо присматривали. Они ярко блестят, и символы, вырезанные на нагруднике, играют на свету, слегка подрагивая каждый раз, когда ты пытаешься сконцентрироваться на них. ~
@4009 = ~Почти неосознанно ты расслабляешь взгляд и оглядываешь символы. Спустя минуту символы перестают дрожать и превращаются в цепочку рун, бегущих вверх и вниз по нагруднику. Довольно странно, но цепляющиеся друг за друга руны напоминают тебе цепи... едва поняв это, неожиданно ты вспоминаешь, что эти руны являются какими-то охранными чарами. ~
@4010 = ~Ты изучаешь руны некоторое время, но никак не можешь расшифровать чары. Они довольно сложно выглядят, и тебе приходится сильно сосредотачиваться.~
@4011 = ~Ты изучаешь образец рун, пробегающий через нагрудник. По своей сути они являются слабым защитным заклинанием, но несколько черепоподобных и шарообразных следов, идущих по краям доспехов заставляют тебя думать о более сильных наложенных некромантских и охранных заклинаниях. Если дотронуться до скелета, то, скорее всего, он пробудится... и будет защищаться.~
@4012 = ~Ты думаешь, что если исказить образец рун на нагруднике, то заклинания будут разрушены, но это достаточно сложно... шаблон защищен, в нем присутствуют неверные символы, которые могут пробудить скелет.~
@4013 = ~Как только ты начинаешь работать с рунами, украшающими нагрудник, по всему Моргу раздается звон железного колокола... а скелет моментально пробуждается, поднимая клинок в атаку!~
@4014 = ~Работа очень сложна, и поначалу ты несколько раз срываешься, но все же медленно, но верно твой разум начинает концентрироваться, и руны разрушаются под твоей атакой. Спустя несколько минут, ты избавляешь скелет от наложенных на него заклинаний. Падая на пол, он разваливается с сильным грохотом!~
@4015 = ~На секунду ты замираешь, но никто не обращает внимания на шум. Ты осматриваешь предметы, оставшиеся от скелета на полу. Большинство из них слишком тяжелые или слишком древние, чтобы ими воспользоваться, но ты обнаруживаешь часть нагрудника скелета с большей частью разрушенного заклинания, написанного на нем. Ты чувствуешь, что эта вещь может пригодиться. ~
@4016 = ~На этот раз снятие заклинаний заняло гораздо меньше времени, и руны быстро разрушаются под твоей атакой. Спустя несколько минут, ты избавляешь скелет от наложенных на него заклинаний. Помня о прошлом случае, ты подхватываешь скелет до того, как он упадет, и тяжело пыхтя, медленно кладешь его на пол.~
@4017 = ~Ты быстро оглядываешь останки скелета и, как и в прошлый раз, обнаруживаешь часть нагрудника скелета... как и в первый раз, на нем высечен фрагмент разрушенного заклинания. Эта вещь может пригодиться.~
@4018 = ~Морт скалит зубы.~
@4019 = ~«Ну, так да или?..»~
@4020 = ~«Ой... извини». Морт подлетает к голове скелета, смотрит на нее, затем спускается вниз, попутно изучая доспехи и клинок. «О да. Да, думаю, такое подойдет».~
@4021 = ~«А какого тогда Баатора ты СПРАШИВАЕШЬ меня? Практикуешься в навыках жестокости? — Морт негодующе раскачивается. — И это после всего, что я сделал для тебя...»~
@4022 = ~Морт уставился на тебя. «Мы что теперь, ЖЕНАТЫ? Что это за бред —  'я не хочу причинить тебе вред'? — Морт выразительно на тебя смотрит. — Если ты ПО-НАСТОЯЩЕМУ обо мне заботишься, то найди способ закрепить мою голову на теле гигантского скелета».~
@4023 = ~«Хорошо... секунду, я вытащу из него голову». ~
@4024 = ~«Хорошо... секунду, я вытащу из него голову». ~
@4025 = ~«Ну не знаю. Оно такое здоровое, вряд ли ты сможешь с таким управиться».~
@4026 = ~«Я думаю, лучше оставить его в покое».~
@4027 = ~«Хорошо... секунду, я вытащу из него голову». ~
@4028 = ~«Хорошо... секунду, я вытащу из него голову». ~
@4029 = ~«Я думаю о твоей безопасности, Морт. Я опасаюсь, что присоединив твою голову к этому, причиню какой-нибудь вред тебе».~
@4030 = ~«Все же я думаю, что лучше оставить его в покое. Идем отсюда».~
@4031 = ~«Хорошо... секунду, я вытащу из него голову». ~
@4032 = ~«Хорошо... секунду, я вытащу из него голову». ~
@4033 = ~«Извини, я не так сильно о тебе забочусь. Идем».~
@4034 = ~«Я говорю, оставь его в покое. А теперь идем отсюда».~
@4035 = ~Посмотреть, сможешь ли ты разрушить чары, наложенные на нагрудник скелета.~
@4036 = ~Попробовать вытащить клинок из рук скелета.~
@4037 = ~Попробовать вытащить клинок из рук скелета.~
