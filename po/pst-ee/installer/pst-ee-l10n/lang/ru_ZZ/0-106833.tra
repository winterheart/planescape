@16483 = ~«У меня есть другие вопросы...»~
@16484 = ~«Это все, что я хотел услышать. Прощай».~
@16485 = ~«Кто он такой?»~
@16486 = ~«Где мне найти работу?»~
@16487 = ~«Куда бы мне пойти поразвлечься?»~
@16488 = ~«У меня есть другие вопросы...»~
@16489 = ~«Тогда пойду, поищу его. Прощай».~
@16490 = ~«Сборщик?»~
@16491 = ~«О чем это ты?»~
@16492 = ~«Откуда ты это знаешь?»~
@16493 = ~«О чем это ты?»~
@16494 = ~«Откуда ты это знаешь?»~
@16495 = ~«Что ты имел в виду под 'нечто большее'?»~
@16496 = ~«Откуда ты узнал об этом сборщике?»~
@16497 = ~«Что ты имел в виду под 'нечто большее'?»~
@16498 = ~«Откуда ты узнал об этом сборщике?»~
@16499 = ~«Давай».~
@16500 = ~«Тогда неважно. У меня есть другие вопросы».~
@16501 = ~«Забудь, что я спрашивал. Прощай».~
@16502 = ~«У меня есть с собой пять крысиных хвостов».~
@16503 = ~«Черепных крыс?»~
@16504 = ~«Понял».~
@16505 = ~«Не думаю, что это стоит моего времени».~
@16506 = ~«У меня есть с собой пять крысиных хвостов».~
@16507 = ~«Понял».~
@16508 = ~«Не думаю, что это стоит моего времени».~
@16509 = ~«Да. Где мне найти работу?»~
@16510 = ~«Да. Куда бы мне пойти поразвлечься?»~
@16511 = ~«Да, у меня есть еще вопросы...»~
@16512 = ~«Нет, больше ничего. Прощай».~
@16513 = ~«Да. Где мне найти работу?»~
@16514 = ~«Да. Куда бы мне пойти поразвлечься?»~
@16515 = ~«Да, у меня есть еще вопросы...»~
@16516 = ~«Нет, больше ничего. Прощай».~
@16517 = ~«У меня есть несколько вопросов...» ~
@16518 = ~«Я хотел извиниться».~
@16519 = ~«Я хотел извиниться».~
@16520 = ~«Я хотел извиниться».~
@16521 = ~Уйти.~
@16522 = ~«Спасибо. У меня есть несколько вопросов...»~
@16523 = ~«Хорошо. Прощай».~
@16524 = ~Уйти.~
@16525 = ~«У меня есть те крысиные хвосты».~
@16526 = ~«У меня есть несколько вопросов...» ~
@16527 = ~«Я просто проходил мимо. Прощай».~
@16528 = ~«Да».~
@16529 = ~«Еще нет. У меня есть вопросы...»~
@16530 = ~«Еще нет. Прощай».~
@16531 = ~«Теперь я хочу услышать эту твою тайну».~
@16532 = ~«Внимания?»~
@16533 = ~«Продолжай...»~
@16534 = ~«Я выслушаю оставшуюся часть в другой раз. Прощай».~
@16535 = ~«Понятно. Продолжай...»~
@16536 = ~«Я выслушаю оставшуюся часть в другой раз. Прощай».~
@16537 = ~«Пожалуйста, продолжай...»~
@16538 = ~«Я выслушаю оставшуюся часть в другой раз. Прощай».~
@16539 = ~«Интересно. Продолжай...»~
@16540 = ~«Я выслушаю оставшуюся часть в другой раз. Прощай».~
@16541 = ~«Мажор?»~
@16542 = ~«Скажи мне».~
@16543 = ~«Расскажешь мне в другой раз. Прощай».~
@16544 = ~«Тогда продолжай...»~
@16545 = ~«Я выслушаю оставшуюся часть в другой раз. Прощай».~
@16546 = ~«Ты уверен насчет всего этого?»~
@16547 = ~«Зачем нечисти разговаривать со сборщиком?»~
@16548 = ~«Интересная байка. Прощай».~
@16549 = ~«Зачем нечисти разговаривать со сборщиком?»~
@16550 = ~«Зачем нечисти разговаривать со сборщиком?»~
@16551 = ~«Интересная байка. Прощай».~
@16552 = ~«Спасибо за информацию. У меня есть еще вопросы...»~
@16553 = ~«Быть может, я так и сделаю, если его встречу. Прощай».~
@16554 = ~«Спасибо за информацию. У меня есть еще вопросы...»~
@16555 = ~«Быть может, я так и сделаю, если его встречу. Прощай».~
@16556 = ~«Понял».~
@16557 = ~«Не думаю, что это стоит моего времени».~
@16558 = ~«У меня есть несколько вопросов...» ~
@16559 = ~«Я просто проходил мимо. Прощай».~
@16560 = ~Едва ты прерываешь ход его мыслей, как он тут же переключается на тебя. Говорит он спокойно и неспешно, но голос его полон скорби. «О... приветствую и тебя, друг. Как тебе сегодняшний день?»~
@16561 = ~Он улыбается, но в его глаза все еще видна скорбь. «Это хорошо, друг. Надеюсь, что удача не покинет тебя». Он собирается вернуться назад к дереву.~
@16562 = ~Он еще больше впадает в уныние. «Очень плохо, друг... Горестно слышать это. Надеюсь, что удача вернется к тебе». Он собирается вернуться назад к дереву.~
@16563 = ~Мужчина изумленно смотрит на тебя, но затем уверенно кивает. «Да, друг, есть. По крайней мере, для меня... хотя это мало на что влияет». Он собирается вернуться назад к дереву.~
@16564 = ~Он слегка пожимает плечами, улыбаясь. «Удача сопутствует мне, хотя в данный момент я опечален».~
@16565 = ~Он похлопывает по деревцу рядом с собой. «Эти деревья, в Улье. Они умирают, друг, и никому нет до этого дела». Он поднимает руку, словно пытаясь тебя прервать. «Может быть, для кого-то это неважно, но это важно для меня. Я чувствую досаду, когда вижу, что последние остатки жизни и красоты в этом районе брошены умирать. Ты можешь это понять, друг?»~
@16566 = ~«Это долгая история... не для случайного прохожего, который захочет ради нее тут стоять. Скажем так, все усилия, которые я прикладываю, чтобы растрясти людей, просто... игнорируются».~
@16567 = ~Он вздыхает. «Я ожидал этого: никому нет никакого дела. Просто оставь меня наедине с моими мыслями, хорошо?» Он отворачивается от тебя.~
@16568 = ~«Я хочу, чтобы они... они... — похоже, он раздражен тем, что не может подобрать нужные слова, — *заботились*. Разве я многого прошу, друг?» Он искренне смотрит на тебя.~
@16569 = ~Поначалу удивившись, он выпаливает: «Правда?! О! Это удивительно. Возможно, ты захочешь...» Он умолкает, будто что-то заподозрив. Он успокаивается, продолжая своим обычным размеренным голосом. «В любом случае, это хорошо. Кажется, у тебя 'есть вопросы' ко мне, так что...»~
@16570 = ~Впервые старик выглядит подлинно счастливым. Просияв, он говорит: «Очень сложно здесь выжить... Оглянись, и ты поймешь, о чем я говорю, друг. Не знаю, смогут ли деревья тут цвести, даже если каким-то образом *найдут* достаточно света и чистой воды...»~
@16571 = ~Он радостно кивает. «Но если достаточное количество людей будет *заботиться*... в самом деле *захочет*, чтобы деревья жили... Я знаю, тогда они выживут! Они снова зазеленеют и зацветут!»~
@16572 = ~Он понимающе улыбается, качая головой. «Ты здесь недавно, мне теперь это понятно. Ты не понимаешь, как все *работает* в Сигиле, друг. Убеждения — это основа всего здесь... Всего!»~
@16573 = ~«Я *прав*, я уверен в этом». Чувство убежденности окружает его словно аура. Он больше не похож на того, с кем ты разговаривал в начале. «Все, что я прошу у тебя, друг, — просто позаботиться о них, подарить им надежду на восстановление. Со временем, когда будет достаточно людей, желающих этого, это станет реальностью. Ты сможешь сделать это для меня, друг?»~
@16574 = ~«Великолепно, друг мой, великолепно! Спасибо тебе... ты вернул мне уверенность. Возможно, я найду еще людей, подобных тебе, которые выслушают меня... Возможно, мы сможем все изменить. Итак, что я могу сделать для тебя, друг?»~
@16575 = ~«Великолепно, друг мой, великолепно! Спасибо тебе... ты вернул мне уверенность. Возможно, я найду еще людей, подобных тебе, которые выслушают меня... Возможно, мы сможем все изменить. А что думают твои спутники, друг? Можешь переговорить с ними от моего имени?»~
@16576 = ~«Постой, друг... выслушай меня». Чувство убежденности окружает его словно аура. Он больше не похож на того, с кем ты разговаривал в начале. «Единственное, что я прошу у тебя, — просто позаботиться о них, подарить им надежду на восстановление. Со временем, когда будет достаточно людей, желающих этого, это станет реальностью. Ты сможешь сделать это для меня, друг?»~
@16577 = ~«Просто оглянись, друг. Можешь ли ты представить, что *здесь* можно спокойно жить? Мало того, что здесь отвратительные условия, так еще в эту часть Сигила дабусы редко приходят».~
@16578 = ~«Ну, дабусы. Уверен, ты встречал их уже... Они — слуги Леди, заботятся о городе. Разумеется, одной части достается больше, чем другой». Он огорченно смотрит на рядом стоящее деревце.~
@16579 = ~«Леди Боли, друг. Хозяйка Сигила», — он останавливается на полуслове. Нарисовав полукруг на груди, он наклоняется к тебе и шепчет: «Лучше о ней не разговаривать. Знай только, что она единолично правит городом — даже когда кажется, что это не так. И не будем больше об этом».~
@16580 = ~«Улей — очень опасное место, но не в этом дело... Леди присматривает за дабусами, поэтому никто, кто еще в своем уме, не станет ссориться с ней, друг. Я думаю, что это все из-за Фелла».~
@16581 = ~«Фелл? Он... э-э-э... друг, я просто тебе скажу, что он — единственный дабус, который не служит Леди. Не знаю всей 'темноты', как тут говорят, но его сторонятся остальные дабусы, а он живет здесь, в Улье. Открыл тату-салон, но почти все сигильцы остерегаются туда ходить».~
@16582 = ~«Салон Фелла находится через несколько домов к востоку отсюда, он отмечен его персональным символом — белый овал, пронзенный ударом молнии. Я никогда там не был, друг, но насколько я понимаю, он способен превращать изображения из своей речи... Ты ведь знаешь, что дабусы изъясняются изображениями, да? Ребусами?»~
@16583 = ~Он кивает. «Так вот, он каким-то образом может превращать изображения из своей речи в татуировки. И это непростые татуировки — я слышал, что в них заключена магия, и не только в процессе их нанесения. Хотя я мало что об этом знаю».~
@16584 = ~«Да, так общаются. Ты поймешь, что я имею в виду, когда попытаешься заговорить с одним из них. Вместо речи у них над головами появятся цепочки символов, — он теребит пальцами над головой, пытаясь продемонстрировать это. — И слушателю остается только разгадать, что хотел сказать дабус. Но я слышал, что со временем их начинаешь понимать все лучше и лучше». Он пожимает плечами.~
@16585 = ~«Понимаешь, друг, когда он ушел от Леди, многие подумали, что рано или поздно он все равно попадет в ее тень. И, конечно же, никто не захочет оказаться рядом, если *это* произойдет».~
@16586 = ~«Как я уже сказал, друг, я не знаю точно. Я слышал только смутные слухи, будто он встал не на ту сторону, когда какая-то сила решила столкнуться лбами с Леди. Можешь сам его спросить об этом, друг. Я слышал, что он достаточно дружелюбен, хоть и немного странный».~
@16587 = ~Он кивает, ожидая твоего вопроса.~
@16588 = ~«Местные зовут меня Скорбящим-по-деревьям, друг».~
@16589 = ~«Попусту трачу свое время, друг». Он горестно вздыхает.~
@16590 = ~«Это самое ужасное место, которое можно найти в Сигиле. Больше и рассказать-то не о чем». Он печально улыбается.~
@16591 = ~«В Улье? Сомневаюсь, что ты найдешь ее здесь, если только ты не вор. Всегда можно собирать тела и относить их к воротам Морга, если ты в настолько отчаянном положении. Я слышал, что тленные платят за них несколько монет для того, чтобы улицы и переулки Улья не были настолько отвратительными».~
@16592 = ~«Ну что ж, друг... Сложновато в таком месте найти что-нибудь развлекательное. Будь я на твоем месте, я бы искал развлечений в другом районе. Так безопаснее».~
@16593 = ~«Здесь? Да все, друг. Все. Ну, может быть, я неопасен. Хе-хе».~
@16594 = ~«Извини, друг. С тех пор, как я здесь очутился, я говорил со многими людьми... но не могу вспомнить никого с таким именем».~
@16595 = ~«Не припомню такого. Когда ты в последний раз его видел, друг?»~
@16596 = ~«Здравствуй, друг».~
@16597 = ~Он смотрит на тебя всего лишь несколько секунд, после чего отводит взгляд. «А, это снова ты... друг».~
@16598 = ~«Извини... друг. Сейчас я очень занят. Может быть, мы сможем поговорить в другой раз».~
@16599 = ~Он молча оглядывается на тебя. «Я принимаю твои извинения, друг. У тебя есть ко мне вопросы?»~
@16600 = ~«Божество, друг. Бог. Обычно у Леди нет никаких проблем с ними, покуда она держит их подальше от Сигила. А того звали Аоскаром, но об этом деле я почти ничего не знаю».~
@16601 = ~«Леди Боли, друг. Хозяйка Сигила», — он останавливается на полуслове. Нарисовав полукруг на груди, он наклоняется к тебе и шепчет: «Лучше о ней не разговаривать. Знай только, что она единолично правит городом — даже когда кажется, что это не так. И не будем больше об этом».~
@16602 = ~Мужчина со всей серьезностью кивает. «Насколько я понял, Леди уничтожила его. Не стоит забывать об этом, если решишься поссориться с ней или ее слугами».~
@16603 = ~Завидев тебя, Скорбящий-по-деревьям широко улыбается. «А, это ты, друг мой, ты вернулся! Что-то от меня нужно?»~
@16604 = ~«Нет, еще нет, друг. Но я не теряю надежду — каждый день общаюсь с людьми».~
@16605 = ~«Да, друг, есть! Они столь малозаметны, что их почти не разглядеть, но смотри: вот свежий побег из деревца, вот пучок новых почек. Теперь это только дело времени. Спасибо тебе еще раз, ты вернул мне надежду».~
@16606 = ~Скорбящий выглядит обеспокоенно. «Что-то не так, друг? Почему-то ты выглядишь разозленным...»~
@16607 = ~«Великолепно, друг мой, великолепно! Спасибо тебе... ты вернул мне уверенность. Возможно, я найду еще людей, подобных тебе, которые выслушают меня... Возможно, мы сможем все изменить. Итак, что я могу сделать для тебя, друг?»~
@16608 = ~«Великолепно, друг мой, великолепно! Спасибо тебе... ты вернул мне уверенность. Возможно, я найду еще людей, подобных тебе, которые выслушают меня... Возможно, мы сможем все изменить. А что думают твои спутники, друг? Можешь переговорить с ними от моего имени?»~
@16609 = ~Скорбящий-по-деревьям улыбается тебе, но выглядит озадаченно. «Отчего ты стал такой радостный, друг?»~
@16610 = ~Скорбящий-по-деревьям улыбается тебе, но выглядит озадаченно. «Отчего ты стал такой радостный, друг?»~
@16611 = ~Скорбящий-по-деревьям с ужасом осознает, что сейчас может произойти. Неожиданно он врывается в самое пекло, оказываясь между Игнусом и деревьями. «Нет! Стой! Ты не можешь!»~
@16612 = ~Завидев тебя, Скорбящий-по-деревьям широко улыбается. «А, это ты, друг мой, ты вернулся! Деревьям все лучше и лучше с каждым днем. Что-то от меня нужно?»~
@16613 = ~«А? А, да, шеф, конечно — как скажешь».~
@16614 = ~Морт некоторое время молча на тебя смотрит, а затем кивает. «Да, я смогу. Если это настолько важно для тебя, я сделаю это».~
@16615 = ~«Знаешь, я *вообще* не представляю, что из этого может получиться. Этот знаток сделан из камня, шеф. Эти малютки просто не справятся с ним».~
@16616 = ~«Ого, вот оно как оборачивается. Не могу *поверить*, что ты вообще тратишь на это время, босс!»~
@16617 = ~«Знаешь, шеф, я повидал много причудливых штуковин... Но он поразил мой разум только тем, что это вообще *возможно*».~
@16618 = ~«О! Я не могу на это смотреть!»~
@16619 = ~На этой стойке сушатся различные растения.~
@16620 = ~Эта лампа излучает мягкий желтый свет... Она не мерцает, в отличие от факела или свечи.~
@16621 = ~«Че? Эй, ты ж это несерьезно!»~
@16622 = ~«Ха! Разбежалась! Поищи-ка кого-нибудь другого мямлить про свои дурацкие деревья. Ты, верно, рехнулся, раз решил, что я будут тратить время на то, чтобы думать про такое. Точно, рехнулся!»~
@16623 = ~Ее ухмылка в конце концов превращается в улыбку. «А, Баатор с ним! Если ты настолько пустоголовый, чтобы вляпаться в это, так почему бы и нет? Лады, я 'позабочусь' о твоих деревьях, рубака. Будешь за это должен, усек?»~
@16624 = ~Игнус медленно поворачивается, чтобы встретиться с тобой взглядом. «*Да-а-а*?»~
@16625 = ~Игнус поворачивается к деревьям, воздух вокруг него становиться невыносимо жарким. «*Да-а-а... ссссжечь...*»~
@16626 = ~Игнус ужасающе хохочет, из его глотки вырываются брызги пламени. «*Ты вссстал между мной и тем, что горит? Гори-и-и тогда и ты-ы...*»~
@16627 = ~Грация кивает. «Несомненно. Я считаю, что это великолепная идея».~
@16628 = ~«Твой запрос очень увлекателен. Деревья в Улье? Это как в городах на Лимбо. Они — живое свидетельство воли людей, которые не склоняются перед всепоглощающим окружением. Принять то, что было им навязано или оставлено, и преуспеть в этом. Я тоже позабочусь об этих деревьях».~
@16629 = ~Даккон кивает. «Да... конечно».~
@16630 = ~«Определение: Помощь, требуется».~
@16631 = ~«Каким образом мне следует их обслуживать».~
@16632 = ~«Запрос: Помочь Скорбящему (псевдоним: Скорбящий-по-деревьям) (Проявить к деревьям нежность). Неверное название команды/объекта».~
@16633 = ~«Команда понята. Параметры приняты. Каково предназначение высказанного желания».~
@16634 = ~«Запрошенное желание будет выполнено незамедлительно».~
@16635 = ~Вейлор безмолвен и неподвижен. Если бы не мерцающие красные огоньки в глазах, он был бы похож на статую.~
@16636 = ~Наконец из пустого шлема эхом доносится голос Вейлора: *Состояние деревьев для меня несущественно. Их смерть ни справедлива, ни несправедлива — это просто смерть*.~
@16637 = ~В этих полках книги, книги, одни только книги. Все они отсортированы по алфавиту и лежат на полках в определенном порядке.~
@16638 = ~Кажется, когда-то это была виселица. Вот только теперь на ней подвешена лампа.~
@16639 = ~Кажется, этим балкам уже несколько веков... на вид они крепкие как камень.~
@16640 = ~Это тряпье выглядит так, словно его грызли.~
@16641 = ~Эта стена готова обвалиться в любой момент. Камни расшатаны; то тут, то там видны дыры.~
@16642 = ~Края этих полок раньше были покрыты символами, но сейчас их уже не разобрать. Возможно, раньше здесь была библиотека?~
@16643 = ~«Приветствую...»~
@16644 = ~Оставить мужчину в покое.~
@16645 = ~«Я нахожу его неплохим».~
@16646 = ~«Я нахожу его ужасным».~
@16647 = ~«А есть разница?»~
@16648 = ~«Это не имеет значения. У меня есть вопросы...»~
@16649 = ~«Неважно... Прощай».~
@16650 = ~«А каким ты находишь этот день?»~
@16651 = ~«Постой... У меня еще вопросы...»~
@16652 = ~«Прощай».~
@16653 = ~«А каким ты находишь этот день?»~
@16654 = ~«Постой... У меня еще вопросы...»~
@16655 = ~«Прощай».~
@16656 = ~«Тогда я нахожу его неплохим».~
@16657 = ~«Тогда я нахожу его ужасным».~
@16658 = ~«Мало что меняет? Что ты имеешь в виду?»~
@16659 = ~«Постой... У меня еще вопросы...»~
@16660 = ~«Прощай».~
@16661 = ~«Отчего так?»~
@16662 = ~«Это очень плохо. У меня есть вопросы...»~
@16663 = ~«Это очень плохо. Прощай».~
@16664 = ~«Да... ты прав, это очень печально».~
@16665 = ~«Нет. Все умирает со временем. Почему ты озабочен подобными вещами?»~
@16666 = ~«Нет, не могу. Если только эти деревья не нужны кому-то, кому до них дело?»~
@16667 = ~«Да. У меня есть несколько вопросов...»~
@16668 = ~«Понимаю. Прощай».~
@16669 = ~«А что ты хочешь получить от этих людей?»~
@16670 = ~«Понятно. У меня есть другие вопросы...» ~
@16671 = ~«Тогда прощай». ~
@16672 = ~Уйти.~
@16673 = ~«Заботились о чем?»~
@16674 = ~«Наверное, нет. У меня есть несколько вопросов...»~
@16675 = ~«Возможно, нет. Прощай».~
@16676 = ~«Да, у меня... э-э-э, есть вопросы...»~
@16677 = ~«Нет, не в этот раз. Что ты собирался у меня спросить?»~
@16678 = ~«Нет, нету. Прощай».~
@16679 = ~«Продолжай...»~
@16680 = ~«Я выслушаю тебя в другой раз. Прощай».~
@16681 = ~«Что? В этом нет смысла».~
@16682 = ~«Возможно, ты прав».~
@16683 = ~«Возможно, они смогут. У меня есть вопросы...»~
@16684 = ~«Это может случиться. Прощай».~
@16685 = ~«Возможно, ты прав».~
@16686 = ~«Может быть и так. У меня есть вопросы...»~
@16687 = ~«Возможно. Прощай».~
@16688 = ~Правда: «Да, я помогу».~
@16689 = ~Правда: «Да, я помогу».~
@16690 = ~Ложь: «Да, я помогу».~
@16691 = ~Ложь: «Да, я помогу».~
@16692 = ~«Нет, но у меня есть вопросы...»~
@16693 = ~«Нет, не смогу. Прощай».~
@16694 = ~«У меня есть вопросы...» ~
@16695 = ~«Ничего, спасибо. Прощай».~
@16696 = ~В этих нишах книги, книги, одни только книги. Все они отсортированы по алфавиту и лежат на полках в определенном порядке.~
@16697 = ~Этот чан наполнен разлагающимися частями тела. Все они тщательно вычищены.~
@16698 = ~«Что думаешь, Морт?»~
@16699 = ~«Анна? А ты?»~
@16700 = ~«Игнус?»~
@16701 = ~«Грация, ты не могла бы в этом помочь?»~
@16702 = ~«Даккон, ты поможешь этому человеку?»~
@16703 = ~«Даккон, помоги этому человеку».~
@16704 = ~Основание этого саркофага было сдвинуто с начальной позиции.~
@16705 = ~От свечки исходит слабый свет.~
@16706 = ~«Нордом, как ты думаешь, ты сможешь помочь?»~
@16707 = ~«Вейлор, ты сможешь помочь?»~
@16708 = ~«Возможно, позже. У меня есть вопросы...»~
@16709 = ~«Может, в другой раз. Прощай».~
@16710 = ~Правда: «Да, я помогу».~
@16711 = ~Правда: «Да, я помогу».~
@16712 = ~Куча гниющих частей тела... руки, ноги, туловища, кое-где даже можно найти голову. Все они тщательно вычищены.~
@16713 = ~Ложь: «Да, я помогу».~
@16714 = ~Ложь: «Да, я помогу».~
@16715 = ~«Нет, но у меня есть вопросы...»~
@16716 = ~Похоще, эти кучи тряпья служат кому-то постелью.~
@16717 = ~«Нет, не смогу. Прощай».~
@16718 = ~«Дабусы?»~
@16719 = ~Стены этих мусорных районов сделаны из отбросов, спрессованных под весом гор мусора, лежащего наверху.~
@16720 = ~«Почему так?»~
@16721 = ~«У меня есть другие вопросы...»~
@16722 = ~«Это все, что я хотел узнать. Прощай».~
@16723 = ~«Леди?»~
@16724 = ~«Почему они сюда не ходят?»~
@16725 = ~Похоже, это было частью какого-то более старого здания... Возможно, его завалило мусором.~
@16726 = ~«У меня есть другие вопросы...»~
@16727 = ~«Это все, что я хотел узнать. Прощай».~
@16728 = ~Огромный бронзовый колокол. Должно быть, это верхняя комната колокольни.~
@16729 = ~Мусор в этой комнате нагроможден таким образом, чтобы образовать «выбоину» в горе мусора.~
@16730 = ~Это колокольня, ведущая в мусорные районы.~
@16731 = ~Стены в этом районе — это смесь неутрамбованного мусора и настоящих стен больших зданий... сам район выглядит так, словно когда-то он мог быть целым городским кварталом.~
@16732 = ~Похоже, кто-то давным-давно поставил здесь эту телегу.~
@16733 = ~Похоже на стену старой сторожки.~
@16734 = ~У этой сломанной телеги бывали дни получше.~
@16735 = ~«Хорошо. Почему сюда не ходят дабусы?»~
@16736 = ~«Понимаю. У меня есть другие вопросы...»~
@16737 = ~«Больше не буду ее при тебе упоминать. Прощай».~
@16738 = ~«Дабусы?»~
@16739 = ~«Леди?»~
@16740 = ~«Кто такой Фелл?»~
@16741 = ~«У меня есть другие вопросы...»~
@16742 = ~«Это все, что я хотел узнать. Прощай».~
@16743 = ~«Расскажи мне об этом тату-салоне».~
@16744 = ~«Почему этого места нужно опасаться?»~
@16745 = ~«И ты не знаешь, почему теперь его сторонятся?»~
@16746 = ~«У меня есть другие вопросы...»~
@16747 = ~«Это все, что я хотел узнать. Прощай».~
@16748 = ~«Да, продолжай».~
@16749 = ~«Они так общаются?»~
@16750 = ~«Так почему же этого места нужно опасаться?»~
@16751 = ~«И ты не знаешь, почему теперь его сторонятся?»~
@16752 = ~«У меня есть другие вопросы...»~
@16753 = ~«Это все, что я хотел узнать. Прощай».~
@16754 = ~«Понятно. Вернемся к другой теме».~
@16755 = ~«Расскажи мне о его тату-салоне».~
@16756 = ~«И ты не знаешь, почему теперь его сторонятся?»~
@16757 = ~«У меня есть другие вопросы...»~
@16758 = ~«Это все, что я хотел узнать. Прощай».~
@16759 = ~«Какая-то сила?»~
@16760 = ~«Леди?»~
@16761 = ~«Расскажи мне о его тату-салоне».~
@16762 = ~«Почему его салона нужно опасаться?»~
@16763 = ~«У меня есть другие вопросы...»~
@16764 = ~«Это все, что я хотел узнать. Прощай».~
@16765 = ~«Есть ли какие-нибудь изменения в деревьях?»~
@16766 = ~«Есть ли какие-нибудь изменения в деревьях?»~
@16767 = ~«Кто ты?»~
@16768 = ~«Что ты здесь делаешь?»~
@16769 = ~«Почему все деревья погибают?»~
@16770 = ~«Что ты можешь рассказать об этом месте?»~
@16771 = ~«Я разыскиваю человека по имени Фарод».~
@16772 = ~«Я ищу потерянный дневник».~
@16773 = ~«Неважно. Прощай».~
@16774 = ~«Почему так?»~
@16775 = ~«Что ты здесь делаешь?»~
@16776 = ~«У меня есть другие вопросы...»~
@16777 = ~«Тогда прощай, Скорбящий-по-деревьям».~
@16778 = ~«О чем это ты?»~
@16779 = ~«Понятно. У меня есть другие вопросы...»~
@16780 = ~«Тогда не буду тебя отвлекать. Прощай».~
@16781 = ~«Тогда почему ты здесь?»~
@16782 = ~«А что, если я ищу работу?»~
@16783 = ~«Где я могу развлечься?»~
@16784 = ~«У меня есть другие вопросы...»~
@16785 = ~«Тогда прощай». ~
@16786 = ~«Почему ты тогда здесь?»~
@16787 = ~«Где я могу развлечься?»~
@16788 = ~«У меня есть другие вопросы...»~
@16789 = ~«Тогда прощай». ~
@16790 = ~«А что здесь опасного?»~
@16791 = ~«Где здесь можно найти работу?»~
@16792 = ~«У меня есть другие вопросы...»~
@16793 = ~«Тогда прощай». ~
@16794 = ~«Где здесь можно найти работу?»~
@16795 = ~«У меня есть другие вопросы...»~
@16796 = ~«Это все, что я хотел узнать. Прощай».~
@16797 = ~«У меня есть другие вопросы...»~
@16798 = ~«Тогда прощай». ~
@16799 = ~«Я не уверен. У меня есть несколько вопросов...»~
@16800 = ~«Не могу сказать. Прощай».~
@16801 = ~«Приветствую. У меня есть вопросы...»~
@16802 = ~«Здравствуй... и прощай».~
@16803 = ~«У меня есть вопросы...» ~
@16804 = ~«Я хочу извиниться за прошлую грубость».~
@16805 = ~Ложь: «Я сожалею о прошлой грубости... Я хочу извиниться».~
@16806 = ~«Я хочу извиниться за прошлую грубость».~
@16807 = ~«Тогда прощай». ~
@16808 = ~«Да...»~
@16809 = ~«Нет, это все, что я хотел сказать. Прощай».~
@16810 = ~«Леди?»~
@16811 = ~«Звали?»~
@16812 = ~«Расскажи мне о его тату-салоне».~
@16813 = ~«Почему его салона нужно опасаться?»~
@16814 = ~«У меня есть другие вопросы...»~
@16815 = ~«Это все, что я хотел узнать. Прощай».~
@16816 = ~«Хорошо. Расскажи мне о тату-салоне Фелла».~
@16817 = ~«Почему салона Фелла нужно опасаться?»~
@16818 = ~«Понимаю. У меня есть другие вопросы...»~
@16819 = ~«Больше не буду ее при тебе упоминать. Прощай».~
@16820 = ~«Леди?»~
@16821 = ~«Расскажи мне о тату-салоне Фелла».~
@16822 = ~«Почему салона Фелла нужно опасаться?»~
@16823 = ~«У меня есть другие вопросы...»~
@16824 = ~«Это все, что я хотел узнать. Прощай».~
@16825 = ~«Да, у меня есть вопросы...»~
@16826 = ~«Нет, я хотел попросить Морта помочь тебе».~
@16827 = ~«Нет, я хотел попросить Анну помочь тебе».~
@16828 = ~«Нет, я хотел попросить Игнуса помочь тебе».~
@16829 = ~«Нет, я хотел попросить Падшую Грацию помочь тебе».~
@16830 = ~«Нет, я хотел попросить Даккона помочь тебе».~
@16831 = ~«Нет, но я нашел тебе помощника. Даккон, помоги этому человеку».~
@16832 = ~«Нет, я хотел попросить Нордома помочь тебе».~
