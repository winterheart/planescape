@19518 = ~[no text]~
@19519 = ~СЫР
Вес: 0

Это кусок сыра.~
@19520 = ~<<BAD TEXT -- OVERWRITE>>~
@19521 = ~Это~
@19522 = ~[no text]~
@19523 = ~«Кто здесь живет?»~
@19524 = ~Этот разлагающийся труп женщины сперва совершенно тебя не замечает. Однако при твоем приближении она поворачивается и медленно кивает, как бы приветствуя тебя.~
@19525 = ~Зомби тихо стонет в ответ: «Пыыы... выыы...» С каждым ее выдохом воздух наполняется запахом разложения.~
@19526 = ~«Туууххх... ммммееее-ииии». Зомби издает нечленораздельные стоны... ты не можешь разобрать ничего из того, что она сказала.~
@19527 = ~Зомби тихо стонет в ответ. Только твое умение разговаривать с мертвыми позволяет тебе понять, что она говорит: «Приии-вет».~
@19528 = ~Труп переминается с ноги на ногу, потом отвечает: «Воп-рос?»~
@19529 = ~Труп сонно кивает. «Воп... росы».~
@19530 = ~Следует долгая пауза. «Ууууу? — зомби пожимает плечами, одно из которых поднимается выше другого. — Ссспроси Мммери, Тухххлую Мммери».~
@19531 = ~«Доммма. Ууу ммменя дома, — остатки мышц ее лица натягивают рот, что можно расценить как улыбку. — Ссстрана Безмммолвного Кооороля, Мммертвые Наароды».~
@19532 = ~Зомби пару секунд пялится на тебя. «Выыыполняю сссвои оообязанности. Дееелаю раааботу для Беезмолвного Кооороля. Ссслужу хорошоооо».~
@19533 = ~«Мммного ктоо. Мыыы, ссскелеты, ууупыри, — ее рука медленно поднимается и указывает на восток. — крррысы, — ее рука делает тяжелый взмах, указывая на тебя. — Жииивые».~
@19534 = ~«Мммного ктоо. Мыыы, ссскелеты, ууупыри, — ее рука медленно указывает на восток. — крррысы».~
@19535 = ~Труп качает головой вперед-назад. «Сссооооэгооо...»~
@19536 = ~«Тсссленный. Ссспроси Мммери, Тухххлую Мммери».~
@19537 = ~Зомби кладет свои гниющие руки на грудь, изуродованную разложением. «Сссильные! — она показывает рукой себе на ноги, потом на висок. — Мееедленные. Хххе... — труп издает тревожное бульканье, которое почему-то напоминает тебе хихиканье. — Глаавная уу нааас — Тууухлая Мммери...»~
@19538 = ~«Ооо ком? Коостях? Ууупырях?»~
@19539 = ~«Кооости! — ее голос почему-то звучит восхищенно. — Уууправлят нааами, наааправляют наас. Вмееесте мыы ссстроим Мееертвые Наароды».~
@19540 = ~«Хххаргриммм ууправляет кооостями. Гооворит ссс Беезмолвным Кооролем, пооотом ссс Тууухлой Мммери. Мммери гоооворит сс наами, даает нааам рааботу». Она кивает.~
@19541 = ~И снова она медленно поднимает руку и махает ею на восток. «Крыыысы...» Влажные ошметки ее верхней губы вытягиваются в ухмылку; по коричневато-желтым зубам стекает вязкая черная жидкость. «Еееедять мееертых... ееедят... плооохие. Теееперь боооятся ууупырей. Сссторонятся нааас».~
@19542 = ~«Ууу... ссспроси Мммери. Тууухлую Мммери».~
@19543 = ~Зомби указывает на свой живот, в котором через прогнившие дыры видны внутренние органы. «Веечно голооодые. Здееесь закооон Бееезмолвного Кооороля нее даееет им ееесть мееертвых. Ууупыри зааащищают нас, ооохраняюють ээти зааали».~
@19544 = ~«Ооот крыыс. Иии, — она поднимает руку и указывает наверх, — жииивых, ссс повееерхности. Оони прииходят, чтообы треевожить мееертвых, краасть их».~
@19545 = ~«Ооона ууправляет наами. Ссследит за наами. Пееередает нааам ссслово Беезмолвного Кооороля».~
@19546 = ~«Поовелитель Меертвых Нааародов. Ссспроси Мммери. Тууухлую Мммери».~
@19547 = ~Труп стоит неподвижно, уставившись на тебя. Наконец она отвечает: «Нннет. Ссспроси Мммери. Тууухлую Мммери».~
@19548 = ~Когда зомби замечает тебя, в ее мертвых глазах появляется проблеск узнавания. «Ууууу».~
@19549 = ~Этот разлагающийся труп женщины сперва совершенно тебя не замечает. Однако при твоем приближении она поворачивается и медленно кивает, как бы приветствуя тебя.~
@19550 = ~Труп качает головой. «Ссспроси Мммери. Тухххлую Мммери».~
@19551 = ~«Ух ты, шеф... ну что за красотка? Мало где встретишь такую милашку, как эта, знаешь ли».~
@19552 = ~Морт закатывает глаза. «Ха! Однажды ты поймешь, о чем я говорю».~
@19553 = ~«Ага, видишь ли, это я... эй! — Морт поворачивается к тебе. — Ты что, издеваешься надо мной?»~
@19554 = ~«Приветствую...»~
