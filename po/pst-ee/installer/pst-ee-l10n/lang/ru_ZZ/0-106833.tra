@41358 = ~«Тогда, может быть, сыграем?»~
@41359 = ~«Вообще-то, я хотел задать тебе несколько вопросов».~
@41360 = ~«Вообще-то, я хотел задать тебе несколько вопросов».~
@41361 = ~«Если подумать, мне уже пора уходить. Прощай».~
