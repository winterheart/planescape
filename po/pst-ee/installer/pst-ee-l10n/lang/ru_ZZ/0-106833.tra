@33850 = ~«А находится Пристанище головорезов?»~
@33851 = ~«Это все, что я хотел узнать. Прощай».~
@33852 = ~«Где находится бар 'Тлеющий труп'?»~
@33853 = ~«Где находится тату-салон?»~
@33854 = ~«Куда ведут северо-западные ворота?»~
@33855 = ~«А находится Пристанище головорезов?»~
@33856 = ~«Это все, что я хотел узнать. Прощай».~
@33857 = ~«Где находится бар 'Тлеющий труп'?»~
@33858 = ~«Где находится тату-салон?»~
@33859 = ~«Куда ведут северо-западные ворота?»~
@33860 = ~«Куда ведут юго-западные ворота?»~
@33861 = ~«Это все, что я хотел узнать. Прощай».~
@33862 = ~Перед тобой пожилой мужчина с длинными седыми волосами и обветренной желтой кожей. Несмотря на очевидный возраст, стоит он прямо. Улыбаясь, он отвешивает тебе небольшой поклон.~
@33863 = ~«Приветствую».~
@33864 = ~Игнорировать его.~
@33865 = ~«И я тебя тоже, рубака. Чем могу служить?» В ожидании ответа он поднимает бровь.~
@33866 = ~«У меня есть несколько вопросов...» ~
@33867 = ~«Мне нужны кое-какие заклинания».~
@33868 = ~«Мне интересно, что у тебя есть на продажу».~
@33869 = ~«Неважно. Прощай».~
@33870 = ~Он хмурится. «Прости, рубака, но я торгую не информацией, а товарами магической природы. Если тебе нужна информация, тебе придется поискать ее в другом месте».~
@33871 = ~«Мне нужны кое-какие заклинания».~
@33872 = ~«Покажи мне, что у тебя на продажу».~
@33873 = ~«Понятно. Прощай».~
@33874 = ~Null node~
@33875 = ~~
@33876 = ~~
@33877 = ~Ты видишь Аалека, торговца магией. «Добрый день, рубака. Приятно снова видеть тебя. Чем могу служить?»~
@33878 = ~«Дай-ка взглянуть на твои товары еще раз».~
@33879 = ~«Неважно. Прощай».~
@33880 = ~Он кивает и окидывает рынок взглядом. «Прости, рубака, но я торгую только магическими товарами. Поговори-ка с Угольком. Он стоит за печкой, прямо у выхода».~
@33881 = ~«Покажи мне, что у тебя на продажу».~
@33882 = ~«Спасибо. Прощай».~
@33883 = ~Перед тобой угрюмый старик. Его лицо — сплетение складок и морщин.~
@33884 = ~«Приветствую».~
@33885 = ~Не обращать на него внимания.~
@33886 = ~Он отвешивает тебе короткий сдержанный поклон. «Ага, привет тебе. Зовут Анце. Чего надо?»~
@33887 = ~«У меня есть несколько вопросов...» ~
@33888 = ~«Неважно. Прощай».~
@33889 = ~Он одаривает тебя беззубой ухмылкой. «Думаю, потрепаться с тобой время найдется. Чего хочешь знать?»~
@33890 = ~«Я ищу кое-кого по имени Лотар, он же Повелитель Костей...»~
@33891 = ~«У меня украли череп. Ты не знаешь кого-нибудь, кто бы мог это сделать?»~
@33892 = ~«А для чего эта печь?»~
@33893 = ~«Я хочу купить кое-какое оружие».~
@33894 = ~«Я хочу купить кое-какие магические вещи».~
@33895 = ~«Я должен идти. Прощай».~
@33896 = ~«Не скажу, что когда-либо слышал о Лотаре... — он щурит глаза, размышляя. — Но этот *костяшка*, да, слыхал о нем. Трепаться с ним даже и не думай. Сильный рубака, с мертвяками якшается, и все такое».~
@33897 = ~«Где мне найти его?»~
@33898 = ~«Что ты можешь о нем рассказать?»~
@33899 = ~«Я должен идти. Прощай».~
@33900 = ~Он пожимает плечами. «А хрен его знает. Такой рубака селится, где захочет. Ни один пень с ним спорить не станет, это уж точно».~
@33901 = ~«Что ты можешь о нем рассказать?»~
@33902 = ~«Понятно. У меня есть другие вопросы...»~
@33903 = ~«Я должен идти. Прощай».~
@33904 = ~Он издает резкий смешок. «Ты все услышал, рубака. А больше я ничего не знаю».~
@33905 = ~«Где мне найти его?»~
@33906 = ~«Понятно. У меня есть другие вопросы...»~
@33907 = ~«Я должен идти. Прощай».~
@33908 = ~Он пытается изобразить интерес, но проваливается с треском. «Печально это слышать, рубака. Раз думаешь, что украли — жалуйся в Гармониум».~
@33909 = ~«Гармониум?»~
@33910 = ~«Спасибо тебе, у меня есть другие вопросы...»~
@33911 = ~«Я должен идти. Прощай».~
@33912 = ~Он улыбается. «Закон, рубака. Громилы Гармониума — закон в Сигиле. Раз шмотки пропали, им и жалуйся».~
@33913 = ~«Ты считаешь, что Гармониум может вернуть мне череп?»~
@33914 = ~«Понятно. У меня есть другие вопросы...»~
@33915 = ~Он начинает было говорить, но задумывается. Мгновение спустя, он начинает тихо посмеиваться. «Не, рубака. Не думаю. Забудь».~
@33916 = ~«Я должен идти. Прощай».~
@33917 = ~«Можешь с Аалеком перетереть, он рядом. Может, у него есть, что нужно». Он показывает на прилавок слева.~
@33918 = ~«У меня есть еще вопросы...»~
@33919 = ~«Спасибо. Прощай».~
@33920 = ~Он смотрит на печь и переходит на шепот. «Печь ни для чего, кроме как учить моего лентяя ответственности. Он вечно болтает и треплется, и все такое. Думает, он ученый, а настоящей работы даже и не нюхал. Если вопросы серьезные... ну, спроси лучше его, а не меня».~
@33921 = ~«У меня есть еще вопросы...»~
@33922 = ~«Понятно. Прощай».~
@33923 = ~Null node~
@33924 = ~~
@33925 = ~~
@33926 = ~~
@33927 = ~нейтрально доброе.

Нейтрально добрые персонажи верят в баланс между порядком и хаосом, но при этом склоняются к совершению добрых поступков.~
@33928 = ~хаотично доброе.

Хаотично добрые персонажи не приемлют систему и порядок. Они — одиночки, склонные совершать добрые поступки.~
@33929 = ~законопослушно нейтральное.

Законопослушно нейтральные персонажи верят в порядок во всем.~
@33930 = ~Твое Обаяние попало в мифы. Твои лидерство, облик и командирские навыки могут воззвать планы к войне.~
@33931 = ~Твое Обаяние легендарно. Ты прирожденный лидер; целые армии пойдут на смерть ради тебя.~
@33932 = ~Твое Обаяние намного выше, чему у любого смертного. Одного твоего присутствия достаточно, что многие сложили свои жизни ради тебя.~
@33933 = ~Твое Телосложение выделяет тебя среди самых выносливых существ во всей мультивселенной. Ты получаешь +<STAT_CONVAL1> к очкам жизни за уровень.~
@33934 = ~Твое Телосложение легендарно. Ты получаешь +<STAT_CONVAL1> к очкам жизни за уровень.~
@33935 = ~Твое Телосложение намного выше, чем у любого смертного. Ты получаешь +<STAT_CONVAL1> к очкам жизни за уровень.~
@33936 = ~Твоя Ловкость позволяет тебе уворачиваться от атак самой смерти. Ты получаешь бонус +<STAT_DEXVAL1> к Классу Брони.~
@33937 = ~Твоя Ловкость легендарна. Ты получаешь бонус +<STAT_DEXVAL1> к Классу Брони.~
@33938 = ~Твоя Ловкость намного выше, чем у любого смертного. Ты получаешь бонус +<STAT_DEXVAL1> к Классу Брони.~
@33939 = ~Твоя Мудрость выделяет тебя среди самых мудрых существ во всей мультивселенной. Ты получаешь огромный бонус ко всем получаемым очкам опыта.~
@33940 = ~Твоя Мудрость легендарна. Ты получаешь солидный бонус ко всем получаемым очкам опыта.~
@33941 = ~Твоя Мудрость намного выше, чем у любого смертного. Ты получаешь солидный бонус ко всем получаемым очкам опыта.~
@33942 = ~Твой Интеллект выделяет тебя среди самых блестящих умов во всей мультивселенной.~
@33943 = ~Твой Интеллект легендарен. Количество заклинаний, которые ты можешь занести в свою книгу заклинаний, не ограничено.~
@33944 = ~Твой Интеллект намного выше, чем у любого смертного. Количество заклинаний, которые ты можешь занести в свою книгу заклинаний, не ограничено.~
@33945 = ~Твоя Сила выделяет тебя среди самых сильных существ во всей мультивселенной. Ты получаешь бонус +<STAT_STRVAL1> к вероятности попадания и +<STAT_STRVAL2> к урону в рукопашной.~
@33946 = ~Твоя Сила легендарна. Ты получаешь +<STAT_STRVAL1> к вероятности попадания и +<STAT_STRVAL2> к урону в рукопашной.~
@33947 = ~Твоя Сила намного выше, чем у любого смертного. Ты получаешь +<STAT_STRVAL1> к вероятности попадания и +<STAT_STRVAL2> к урону в рукопашной.~
@33948 = ~истинно нейтральное.

Истинно нейтральные персонажи верят в поддержание баланса между порядком и хаосом. Они не отдают предпочтения ни тому, ни другому и противостоят любому, кто пытается перетянуть их на свою сторону.~
@33949 = ~хаотично нейтральное.

Хаотично нейтральные персонажи не верят в порядок. Это мировоззрение безумцев, сумасшедших и импульсивных персонажей. ~
@33950 = ~законопослушно злое.

Законопослушно злые персонажи верят в «организованное зло» и предпочитают творить злодеяния в упорядоченной и строгой манере.~
@33951 = ~нейтрально злое.

Нейтрально злые персонажи верят в баланс между порядком и хаосом, но при этом склоняются к совершению злых поступков.~
@33952 = ~хаотично злое.

Хаотично злые персонажи являются выдержкой подлости. Их ничто не волнует — ни порядок, ни правда, ни справедливость. При любой возможности они преследуют только собственные цели.~
@33953 = ~Перемещение пламени~
@33954 = ~У тебя Сила ребенка. Ты получаешь -%d к вероятности попадания и -%d к урону в рукопашной.~
@33955 = ~Твоя Сила достойна жалости. Ты получаешь -%d к вероятности попадания и -%d к урону в рукопашной.~
@33956 = ~Твоя Сила ниже средней. Ты получаешь -%d к вероятности попадания в рукопашной.~
@33957 = ~Стряхнуть воспоминание.~
@33958 = ~«Я знал, что ты вернешься, шеф! Все-таки понял, что я нужен тебе, а?»~ [MRT516]
@33959 = ~«Да... идем».~
@33960 = ~«Не сейчас, Морт».~
@33961 = ~«Пф-ф. Ну хорошо, не знаю, как долго я смогу здесь быть, так что я даю тебе ПОСЛЕДНИЙ шанс. Ты уверен, что не хочешь моего мудрого совета и быстрой остроты?»~
@33962 = ~«Морт, у тебя НЕТ ни того, ни другого».~
@33963 = ~«Ладно. Я передумал. Давай, идем».~
@33964 = ~«Не сейчас, Морт. Может быть, потом».~
@33965 = ~«Ты пытаешься задеть мои чувства, шеф? Погоди, разве я что-то не так сказал? Или это из-за того, что у меня нет рук? Что?»~
@33966 = ~«Ладно. Я передумал. Давай, идем».~
@33967 = ~«Ничего такого. Просто сейчас я не нуждаюсь в твоей компании. Прощай, Морт».~
@33968 = ~«Ну хорошо, я не собираюсь ждать тебя ВЕЧНО, так что тебе лучше вернуться, как только ты передумаешь».~
@33969 = ~«Я так и сделаю. Прощай, Морт».~
@33970 = ~«Что тебя гложет, шеф?»~
@33971 = ~~
@33972 = ~Даккон поворачивается при твоем приближении. Его глаза похожи на отполированный уголь. «Я *знал*, что ты вернешься. Ты желаешь, чтобы наши пути соединились?»~ [DAK207]
@33973 = ~«Да. Мне нужна твоя помощь, Даккон».~
@33974 = ~«Нет, Даккон, не сейчас».~
@33975 = ~«Теперь у нас единый путь».~ [DAK206]
@33976 = ~«Тогда вперед».~
@33977 = ~«Тогда наши пути должны разойтись».~
@33978 = ~«Прощай, Даккон».~
@33979 = ~«Какова твоя воля?»~ [DAK205]
@33980 = ~«На этот раз ничего. Просто проверяю, что ты еще со мной».~
@33981 = ~Анна наблюдает за твоим приближением, ее хвост мечется из стороны в сторону. «Ну так, э-э-э... тебе еще нужна моя помощь?»~ [ANA454A]
@33982 = ~«Я хочу, чтобы мы снова путешествовали вместе».~
@33983 = ~«Нет, извини, что побеспокоил тебя».~
@33984 = ~«О, на этот раз ты УВЕРЕН? Ты уже оставлял меня здесь, и больше мне не хочется. У меня нет времени на твои метания, нет уж. Если в этот раз ты не уверен на все сто, тебе лучше уйти».~
@33985 = ~«Я уверен. Мне нужна твоя помощь, Анна».~
@33986 = ~«Тогда мне лучше уйти. Прощай».~
@33987 = ~«Пф-ф-ф. Не пойму, зачем, но я пойду с тобой. Тебе пригодиться любая помощь, это уж точно».~
@33988 = ~«Ладно, идем».~
@33989 = ~«А? Че те понадобилось?»~ [ANA579B]
@33990 = ~«Ничего, Анна. Просто проверяю, что ты все еще со мной».~
@33991 = ~Когда ты подходишь, Игнус шипит, воздух дрожит от окружающего его жара. «*Пока-а-а я ждал здессссь... мыссссли наполнялисссссь огнем...*»~ [IGN247]
@33992 = ~«Игнус, мне нужна твоя помощь».~
@33993 = ~~
@33994 = ~«*Я твой... пока ссссмерть не придет к нам обоим...*»~ [IGN248]
@33995 = ~«Хорошо. Уходим».~
@33996 = ~В его глотке вспыхивает огонь, из почерневших зубов вырывается язык пламени. «*Да-а-а-а?..*»~ [IGN249]
@33997 = ~«Игнус, из-за чего ты стал таким?»~
@33998 = ~«Вейлор... йоу, братан. Брось горевать, пошли, потусуемся. Тут нужно исправить несправедливость».~
@33999 = ~Вейлор безмолвен и неподвижен. Если бы не мерцающие красные огоньки в глазах, он был бы похож на статую.~
@34000 = ~«Вейлор, мне нужна твоя помощь. Ты пойдешь со мной?»~
@34001 = ~«Вейлор, мне нужна твоя помощь. Ты пойдешь со мной?»~
@34002 = ~*Я ПОЙДУ*~ [VHA127]
@34003 = ~«Тогда пошли».~
@34004 = ~Вейлор безмолвен и неподвижен. Если бы не мерцающие красные огоньки в глазах, он был бы похож на статую.~
@34005 = ~«Я хотел задать тебе несколько вопросов, Вейлор...»~
@34006 = ~Похоже, Нордом глубоко погружен в свои мысли. В буквальном смысле. Он пощелкивает и жужжит, словно счетная машина.~
@34007 = ~«Нордом, мне нужна твоя помощь. Ты пойдешь со мной?»~
@34008 = ~Оставить Нордома наедине со своими «мыслями».~
@34009 = ~«Рот» Нордома принимает форму причудливого скошенного полукруга. «Ответ утвердительный! Допуск получен, совершен обмен разрешениями». Оба арбалета начинают усиленно трещать и звенеть, практически дрожа от этого в его руках. «Статус: полная готовность, ожидаю инструкций».~ [NOR298]
@34010 = ~«Тогда вперед».~
@34011 = ~Нордом внимательно смотрит на свои арбалеты. Они обмениваются различными щелчками, сначала один, затем другой, словно общаясь друг с другом.~
@34012 = ~~
@34013 = ~Не обращать внимания на... куб.~
@34014 = ~Когда ты подходишь, Падшая Грация поднимает взгляд. «Ты хочешь, чтобы я снова путешествовала с тобой?»~ [FFG247]
@34015 = ~«Да, если ты не против».~
@34016 = ~«Не сейчас... Просто хотел справиться, как у тебя дела».~
@34017 = ~Она кивает. «С удовольствием».~ [FFG249]
@34018 = ~«Идем».~
@34019 = ~Она кивает. «Спасибо. Как мило с твоей стороны, — она слегка улыбается. — Если в будущем понадобится моя помощь, ты сможешь найти меня здесь».~
@34020 = ~«Спасибо, Грация. Может, я еще передумаю».~
@34021 = ~«Да?»~ [FFG003]
@34022 = ~«Что ты можешь рассказать о танарри?»~
@34023 = ~«Приветствую...»~
@34024 = ~Игнорировать его.~
@34025 = ~Он зловеще улыбается акульим оскалом. Его глаза похожи на сияющие черные светила. Он говорит тихим и скрипучим голосом: «Гаоха тоже приветствует тебя... Пришел сыграть в игру, да?»~
@34026 = ~«Нет, но у меня есть несколько вопросов...»~
@34027 = ~«Да, я сыграю».~
@34028 = ~«Нет... Прощай».~
@34029 = ~Едва он собирается что-то сказать, как его глаза — сияющие и черные, словно черный янтарь — останавливаются на Дакконе. С секунду они молча смотрят друг на друга, после чего гитцерай с татуировками возвращается к тебе. Он говорит тихим и скрипучим голосом: «Гаоха тоже приветствует тебя... Пришел сыграть в игру, да?»~
@34030 = ~«Нет, но у меня есть несколько вопросов...»~
@34031 = ~«Да, я сыграю».~
@34032 = ~«Нет... Прощай».~
@34033 = ~Улыбка тут же пропадает с лица Гаохи. Он качает головой. «Вопросы не интересны мне. Только игра... бросок кости, сверкание монеты выигранной или проигранной, да? — он подбрасывает игральную кость на ладони. — «Ты... не интересуешься такими вещами?»~
@34034 = ~«Хорошо... Я сыграю».~
@34035 = ~«Хорошо... Я сыграю».~
@34036 = ~«Нет. Прощай».~
@34037 = ~Гаоха вытаскивает из своего жакета монету. «Эта монета? Твоя монета, — он кладет ее у твоих ног, после чего достает другую. — Эта монета? Гаохи». Он кладет ее у своих ног, после берет большим и указательным пальцами две игральные кости. «Кости... мы вдвоем кидаем по одной, да?»~
@34038 = ~«Продолжай...»~
@34039 = ~«Ты кидаешь больше, обе монеты... — он подхватывает монеты с земли и протягивает их тебе. — твои. Гаоха кидает больше? — он быстро прячет медяки назад в куртку. — Мои. Никто не кинул больше? Монеты лежат для другого броска. Итак — сколько монет будет лежать у твоих ног?»~
@34040 = ~«Один медяк».~
@34041 = ~~
@34042 = ~~
@34043 = ~~
@34044 = ~~
@34045 = ~~
@34046 = ~~
@34047 = ~~
@34048 = ~~
@34049 = ~~
@34050 = ~~
@34051 = ~~
