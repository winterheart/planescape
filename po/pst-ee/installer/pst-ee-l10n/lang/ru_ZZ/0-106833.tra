@40386 = ~Предмет +3 к невосприимчивости~
@40387 = ~Предмет +2 к невосприимчивости~
@40388 = ~Маскировка сброшена~
@40389 = ~«Ты стремишься быть... Чувствующей?»~
@40390 = ~«Не сейчас. У меня другой вопрос...»~
@40391 = ~«Возможно и так. Прощай».~
@40392 = ~«У меня есть другие вопросы...»~
@40393 = ~«Это все, что я хотел узнать. Прощай».~
@40394 = ~«У меня есть другие вопросы...»~
@40395 = ~«Это все, что я хотел узнать. Прощай».~
@40396 = ~«Неважно. У меня другой вопрос...»~
@40397 = ~«Забудь об этом, Джульетта. Прощай».~
@40398 = ~«Десятая проститутка — кто она?»~
@40399 = ~«Неважно. У меня другой вопрос...»~
@40400 = ~«Забудь об этом, Джульетта. Прощай».~
@40401 = ~«Тогда у меня еще вопрос...»~
@40402 = ~«В таком случае, прощай».~
@40403 = ~«Что не так, Джульетта?»~
@40404 = ~«У меня есть несколько вопросов...» ~
@40405 = ~«Я просто проходил мимо, Джульетта. Счастливо».~
@40406 = ~«Еще нет. Прощай».~
@40407 = ~«На самом деле, да. Он был убит горем, и решил уступить место твоей 'новой любви'».~
@40408 = ~«Монтекки намеревался уступить место твоей «новой любви», так что я сказал ему, что это был розыгрыш. Не уверен, что он теперь будет делать».~
@40409 = ~«Монтекки это, похоже, безразлично... Кажется, он сказал, что он 'в любом случае, устал от всего этого'».~
@40410 = ~«Я отдал ему письма, но... не увидел никакой реакции. Советую тебе как-нибудь поговорить с ним лично».~
@40411 = ~«Монтекки это, похоже, безразлично... И, кажется, он сказал что-то о другой своей любовнице».~
@40412 = ~«Я отдал ему письма, но... не увидел никакой реакции. Советую тебе как-нибудь поговорить с ним лично».~
@40413 = ~«Хватит рыдать... я хочу услышать ответы на свои вопросы сейчас же — у нас был уговор».~
@40414 = ~«Жаль, что все так вышло. Я вернусь в другой раз, Джульетта. Прощай».~
@40415 = ~Тихо уйти.~
@40416 = ~~
@40417 = ~~
@40418 = ~«Поскольку теперь он все знает, ты также можешь открыто обсудить с ним свои чувства по поводу ваших отношений».~
@40419 = ~«Это твое решение — я выполнил свою часть. А теперь ответь на мои вопросы...»~
@40420 = ~«Я не уверен. У меня есть несколько вопросов...»~
@40421 = ~«Не знаю. Прощай».~
@40422 = ~«Конечно. А теперь ответь на мои вопросы...»~
@40423 = ~«Конечно. У меня есть другие вопросы...»~
@40424 = ~«Пожалуйста. Прощай».~
@40425 = ~~
@40426 = ~«Возможно. В любом случае, я сделал свое дело... Теперь я хотел бы услышать ответы на свои вопросы».~
@40427 = ~«Возможно. У меня есть еще вопросы...»~
@40428 = ~«Может, и так. Прощай, Джульетта».~
@40429 = ~«Почему бы тебе просто не *поговорить* с ним об этом? Ты просто обязана попытаться открыто обсудить ваши отношения, прежде чем выдумывать еще один план».~
@40430 = ~«Возможно. В любом случае, я сделал свое дело... Теперь я хотел бы услышать ответы на свои вопросы».~
@40431 = ~«Возможно. У меня есть еще вопросы...»~
@40432 = ~«Может, и так. Прощай, Джульетта».~
@40433 = ~«Еще нет. Прощай».~
@40434 = ~«На самом деле, да. Он был убит горем, и решил оставить тебя мне».~
@40435 = ~«Монтекки намеревался оставить мне тебя, так что я сказал ему, что это был обман. Не уверен, что он теперь будет делать».~
@40436 = ~«Монтекки это, похоже, безразлично...»~
@40437 = ~«Я выдвинул свои требования, но... не увидел никакой реакции. Он даже не захотел со мной драться. Советую тебе как-нибудь поговорить с ним лично».~
@40438 = ~«Монтекки это, похоже, безразлично...»~
@40439 = ~«Я выдвинул свои требования, но... не увидел никакой реакции. Советую тебе как-нибудь поговорить с ним лично».~
@40440 = ~«Нет».~
@40441 = ~«Нет. Припоминаю, что он сказал, что 'в любом случае, устал от этого'».~
@40442 = ~«Нет. К тому же, припоминаю, что он говорил что-то о другой своей любовнице».~
@40443 = ~«У меня несколько вопросов, Джульетта».~
@40444 = ~«Я просто проходил мимо. Прощай, Джульетта».~
@40445 = ~«Да, так и есть...»~
@40446 = ~«Нет, просто проходил мимо. Прощай, Джульетта».~
@40447 = ~«Правда? Интересно. У меня еще один вопрос...»~
@40448 = ~«Понятно... Это все, что я хотел узнать. Прощай, Джульетта».~
@40449 = ~«У меня есть другие вопросы...»~
@40450 = ~«Это все, что я хотел узнать. Прощай».~
@40451 = ~Фигура отвечает; ее голос тихий и беспощадный, словно скрежет стального кинжала по камню: «Да? Пришел поговорить с Мариссой, не так ли? Как грубо с твоей стороны врываться в темную комнату и вот так топтаться за перегородкой... грубо и безрассудно». Тебе слышится тихий шорох, похожий на легкий бриз... или шипение змей?~
@40452 = ~«Прошу прощения... Не думал, что тут кто-то есть».~
@40453 = ~«У меня есть несколько вопросов...» ~
@40454 = ~«Тогда прощай» .~
@40455 = ~Женщина пренебрежительно хмыкает. «Но ведь понятно, что в комнате кто-то *есть*, разве нет? Так ты уйдешь?»~
@40456 = ~«Пока нет... У меня есть несколько вопросов».~
@40457 = ~«Да... прощай».~
@40458 = ~«Так *вот* оно что!» Слышится слабое шипение; в голосе женщины появляются нотки сарказма. «О-о-о, просто не могу дождаться...»~
@40459 = ~«Спрашивай».~
@40460 = ~«Я нашел твою малиновую вуаль...»~
@40461 = ~«Я нашел твою малиновую вуаль...»~
@40462 = ~«Почему ты остаешься за ширмой?»~
@40463 = ~«Почему ты остаешься за ширмой?»~
@40464 = ~«Почему здесь так темно?»~
@40465 = ~«Почему здесь так темно?»~
@40466 = ~«Что ты здесь делаешь?»~
@40467 = ~«Что ты можешь сказать об этом месте?»~
@40468 = ~Ты слышишь слабое шипение. «Потому что у меня пропала кое-какая вещь, и потому что кое-что незваное явилось мне на порог».~
@40469 = ~«А ты можешь превратить в статую, скажем, лим-лима?»~
@40470 = ~«А ты можешь превратить в статую, скажем, лим-лима?»~
@40471 = ~«А ты можешь превратить в статую, скажем, лим-лима?»~
@40472 = ~«Что ты можешь рассказать о молчаливой проститутке?»~
@40473 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40474 = ~«Мне сказали, что не так давно ты, крадучись, выходила из комнаты Вивьен... Это как-то связано с пропажей ее аромата?»~
@40475 = ~«Мне сказали, что не так давно ты, крадучись, выходила из комнаты Вивьен... Это как-то связано с пропажей ее аромата?»~
@40476 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40477 = ~«Тебе что-нибудь известно о Равель Заморочке?»~
@40478 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая или где она находится?»~
@40479 = ~«Вообще-то, ничего особенного. Прощай».~
@40480 = ~«Что пропало?»~
@40481 = ~«У меня еще вопрос...»~
@40482 = ~«В таком случае, я ухожу. Прощай».~
@40483 = ~«Моя вуаль... моя малиновая вуаль. Ты ее случайно не видел?»~
@40484 = ~«Нет... а зачем она? Это просто обычная вуаль?»~
@40485 = ~«Нет. У меня есть несколько вопросов...»~
@40486 = ~«Нет. Прощай».~
@40487 = ~Марисса издает тихий вздох. «Нет, не совсем. Она помогает мне в общении... то есть, в общении лицом к лицу».~
@40488 = ~«Зачем тебе прятать свое лицо?»~
@40489 = ~«У меня еще вопрос...»~
@40490 = ~«Это все, что я хотел узнать. Прощай».~
@40491 = ~«Хватит с меня этих глупых вопросов! Как же ты мне надоел! Чего ты *хочешь*?»~
@40492 = ~«Только несколько ответов...»~
@40493 = ~«Ничего. Прощай».~
@40494 = ~«Чтобы предотвратить некоторые нежеланные... и смущающие меня... несчастные случаи. Так чего же ты все-таки хочешь?»~
@40495 = ~«Я хочу, чтобы ты вышла на свет».~
@40496 = ~«Только несколько ответов...»~
@40497 = ~«Ничего. Прощай».~
@40498 = ~«Сижу здесь наедине со своими мыслями. Слушаю твои разговоры. Тишина каждой из этих вещей — в прямом и переносном смысле — просто оглушительна».~
@40499 = ~«Почему у тебя такой дурной нрав?»~
@40500 = ~«Мне было бы интересно послушать твои мысли...»~
@40501 = ~«У меня еще вопрос...»~
@40502 = ~«Это все, что я хотел узнать. Прощай».~
@40503 = ~«О, не думаю. На данный момент ты найдешь их весьма нелестными. Так чего же ты все-таки *хочешь*?»~
@40504 = ~«Почему у тебя такой дурной нрав?»~
@40505 = ~«Только несколько ответов...»~
@40506 = ~«Ничего. Прощай».~
@40507 = ~«Ты хочешь, чтобы я вышла из-за ширмы на свет и поговорила с тобой лицом к лицу? — Марисса смеется, слышен звук трущихся друг о друга чешуек. — Нет, лучше не стоит. Темнота мне подходит, и тебе, несомненно, тоже».~
@40508 = ~«Почему здесь так темно?»~
@40509 = ~«Пожалуйста, выйди на свет...»~
@40510 = ~«Тогда у меня другой вопрос...»~
@40511 = ~«В таком случае, прощай».~
@40512 = ~«Нет, и 'пожалуйста' не поможет убедить меня. Так чего же ты *хочешь*? Ты ведь не для того сюда пришел, чтобы *увидеть* меня?»~
@40513 = ~«Я *в самом деле* хочу увидеть, какая ты...»~
@40514 = ~«Тогда у меня другой вопрос...»~
@40515 = ~«В таком случае, прощай».~
@40516 = ~«Ты не хочешь этого».~
@40517 = ~«О, да».~
@40518 = ~«Тогда у меня другой вопрос...»~
@40519 = ~«В таком случае, прощай».~
@40520 = ~«А как выглядишь *ты*? Нас обоих скрывает темнота. Сыграем в игру? А то мне ужасно скучно. Дай, угадаю... ты человеческое существо мужского пола?»~
@40521 = ~«Да».~
@40522 = ~«Думаю, да...»~
@40523 = ~«Никаких игр. У меня есть вопрос...»~
@40524 = ~«В данный момент мне не до игр. Прощай».~
@40525 = ~«Тебя... ранили в горло?»~
@40526 = ~«Да».~
@40527 = ~«Я не вижу, но думаю, что да».~
@40528 = ~«Больше никаких игр. У меня есть вопрос...»~
@40529 = ~«В данный момент мне не до игр. Прощай».~
@40530 = ~«Ты думаешь? Как об этом можно не знать?»~
@40531 = ~«Это вроде как непросто».~
@40532 = ~«Я действительно не имею четкого представления о том, кто я».~
@40533 = ~«Забудь об этом. У меня вопрос...»~
@40534 = ~«Неважно. Прощай, Марисса».~
@40535 = ~«В самом деле? Должно быть, это слишком сложно для такого заурядного ума как мой».~
@40536 = ~«Я действительно не имею четкого представления о том, кто я».~
@40537 = ~«Забудь об этом. У меня вопрос...»~
@40538 = ~«Неважно. Прощай, Марисса».~
@40539 = ~«Правда? Это весьма... интересно...» В темноте слышится шипение.~
@40540 = ~«Хм... опиши мне себя».~
@40541 = ~Правда: «Я высокий, мускулистый, с ужасными шрамами».~
@40542 = ~Ложь: «Я высок, атлетически сложен... очень красив...»~
@40543 = ~«Сперва ты, Марисса».~
@40544 = ~«Нет, спасибо. У меня вопрос...»~
@40545 = ~«Я не в духе. Прощай».~
@40546 = ~«В самом деле? Хм-м... — она на миг умолкает. — Откуда у тебя эти ужасные шрамы? Постой... забудь об этом. Я не желаю знать».~
@40547 = ~«А теперь опиши мне себя».~
@40548 = ~«Хорошо. У меня вопрос...»~
@40549 = ~«Отлично. Прощай, Марисса».~
@40550 = ~«О, правда? Подойди ко мне — *очень* близко, чтобы мы могли видеть друг друга...» От нее исходит тихое шипение...~
@40551 = ~Подойти к ней поближе.~
@40552 = ~Остаться на месте.~
@40553 = ~Ты подходишь так, так что практически соприкасаешься лицом с Мариссой, и пытаешься разглядеть ее лицо. У нее красивое лицо, ее кожа бледна и безупречна, однако вместо волос у нее клубок извивающихся шипящих змей. Глаза Мариссы — бриллиантовый оттенок голубого — почему-то кажутся тебе странными, и тут до тебя доходит, что на самом деле это татуировки на ее закрытых веках. «Готов к сюрпризу?» Ее рот искривляется в зловещей ухмылке...~
@40554 = ~Отвернуться.~
@40555 = ~«Конечно, удиви меня».~
@40556 = ~«Давай обмениваться — эпитет на эпитет? Я начинаю — стройная. Ты должен сказать следующий эпитет».~
@40557 = ~«Высокий».~
@40558 = ~«Мускулистый».~
@40559 = ~«Покрытый шрамами».~
@40560 = ~«Нет... никаких игр. У меня есть вопрос...»~
@40561 = ~«В данный момент мне не до игр. Прощай».~
@40562 = ~«М-м-м. Скажем... бледнокожая».

Так вы и дальше обмениваетесь прилагательными, пока она, наконец, не описывает себя: стройная, бледнокожая, красивая женщина с раздвоенным языком, извивающимися змеями вместо волос, и сияющими глазами... которые, насколько ты понял, она должна держать закрытыми.~
@40563 = ~«Ты демон?»~
@40564 = ~«Похоже, ты выглядишь... весьма необычно, Марисса».~
@40565 = ~Марисса издает легкий смешок, сопровождаемый слабым шипением. «Нет, вряд ли... хотя я и обладаю силами, которые можно *назвать* демоническими. К примеру, мой взгляд обращает живую плоть в камень. И глазом не моргнешь, как превратишься в статую...»~
@40566 = ~«Живую плоть в камень? Ты можешь превратить в статую, скажем, лим-лима?»~
@40567 = ~«Живую плоть в камень? Ты можешь превратить в статую, скажем, лим-лима?»~
@40568 = ~«Живую плоть в камень? Ты можешь превратить в статую, скажем, лим-лима?»~
@40569 = ~«Должно быть, временами это причиняет беспокойства».~
@40570 = ~«Должно быть, временами это причиняет беспокойства».~
@40571 = ~«Должно быть, временами это причиняет беспокойства».~
@40572 = ~«Интересно. У меня вопрос...»~
@40573 = ~«Понятно. Ну что ж, мне нужно идти. Прощай, Марисса».~
@40574 = ~«Ты так думаешь? Должно быть, из-за этого-то я и сижу здесь одна, в темноте, и прячусь за перегородкой». Хотя ты не можешь видеть Мариссу, ты уверен, что она ухмыляется; неожиданно она вздыхает. «Если бы я только знала, куда запропастилась моя малиновая вуаль. Ты ее случайно не видел?»~
@40575 = ~«Нет... а зачем она? Это просто обычная вуаль?»~
@40576 = ~«Нет. У меня есть несколько вопросов...»~
@40577 = ~«Нет. Прощай».~
@40578 = ~«Ты так думаешь? Должно быть, из-за этого-то я и сижу здесь одна, в темноте, и прячусь за перегородкой». Хотя ты не можешь видеть Мариссу, ты уверен, что она ухмыляется; неожиданно она вздыхает. «Если бы я только знала, куда запропастилась моя малиновая вуаль».~
@40579 = ~«У меня с собой твоя вуаль, Марисса...»~
@40580 = ~«У меня с собой твоя вуаль, Марисса...»~
@40581 = ~«У меня вопрос...»~
@40582 = ~«Прощай, Марисса».~
@40583 = ~«Моя малиновая вуаль позволяет мне путешествовать с минимальным риском того, что это произойдет, так что не все так ужасно».~
@40584 = ~«У меня вопрос...»~
@40585 = ~«Прощай, Марисса».~
@40586 = ~«Тогда передай мне ее, пожалуйста».~
@40587 = ~«Конечно. Держи...»~
@40588 = ~«Сперва дай мне что-нибудь взамен...»~
@40589 = ~Ты держишь перед собой малиновую вуаль и чувствуешь, как она забирает ее у тебя из рук. «О, да, так намного лучше, — когда она открывает глаза, перед тобой возникают две сияющие красным светом точки. — Значит, вот ты какой... пожалуй, лучше бы я не открывала своих глаз».~
@40590 = ~«Следи за своим раздвоенным языком, Марисса».~
@40591 = ~«У меня вопрос...»~
@40592 = ~«Прощай, Марисса».~
@40593 = ~«Даже не начинай».~
@40594 = ~«У меня вопрос...»~
@40595 = ~«Прощай, Марисса».~
@40596 = ~«Конечно... какой же ты все-таки *корыстный*. Вот... протяни руку, вот мое запястье... на нем ты найдешь золотой браслет. Забирай его — он твой. Уверяю, он тебе пригодится больше, чем моя вуаль».~
@40597 = ~«Вообще-то... забудь. Вот, просто забери свою вуаль».~
@40598 = ~Взять браслет.~
@40599 = ~Ты снимаешь браслет с утонченного запястья Мариссы...~
@40600 = ~Марисса издает легкий смешок, сопровождаемый слабым шипением. «О, да-да. И я одним лишь взглядом обращаю живую плоть в камень. И глазом не моргнешь, как превратишься в статую...»~
@40601 = ~«Живую плоть в камень? Ты можешь превратить в статую, скажем, лим-лима?»~
@40602 = ~«Живую плоть в камень? Ты можешь превратить в статую, скажем, лим-лима?»~
@40603 = ~«Живую плоть в камень? Ты можешь превратить в статую, скажем, лим-лима?»~
@40604 = ~«Должно быть, временами это причиняет беспокойства».~
@40605 = ~«Должно быть, временами это причиняет беспокойства».~
@40606 = ~«Должно быть, временами это причиняет беспокойства».~
@40607 = ~«Интересно. У меня вопрос...»~
@40608 = ~«Понятно. Ну что ж, мне нужно идти. Прощай, Марисса».~
@40609 = ~Марисса описывает себя следующим образом: стройная, бледнокожая, красивая женщина с раздвоенным языком, извивающимися змеями вместо волос, и сияющими глазами... которые, насколько ты понял, она должна держать закрытыми.~
@40610 = ~«Ты демон?»~
@40611 = ~«Похоже, ты выглядишь... весьма необычно, Марисса».~
@40612 = ~«Ты сомневаешься в моей оценке относительно тебя? Может ли быть, что ты не такой, каким кажешься?»~
@40613 = ~Подойти к ней поближе.~
@40614 = ~«Хорошо... Я высокий, мускулистый, весь в ужасных шрамах».~
@40615 = ~«Просто забудь об этом. У меня есть вопрос...»~
@40616 = ~«Не бери в голову. Прощай».~
@40617 = ~«Нет, я не в духе. Уверена, здешние девочки будут рады поведать тебе все о маленькой школе госпожи Грации для будущих чувствующих... иди, поищи кого-нибудь из них».~
@40618 = ~«Чувствующих?»~
@40619 = ~«Пока нет, у меня еще вопрос...»~
@40620 = ~«Может, так и сделаю. Прощай».~
@40621 = ~«Да-да... кучка глупцов, посвятивших себя переживаниям и тому подобным вещам. Безусловно, мне не нужно быть чувствующей, чтобы *быть* чувствующей... и как только я получу доступ к Фестхоллу и устану от его сенсориумов, я попросту уйду».~
@40622 = ~«Расскажи мне о сенсориумах».~
@40623 = ~«У меня еще вопрос...»~
@40624 = ~«Это все, что я хотел узнать. Прощай».~
@40625 = ~«Это залы, где в так называемых 'камнях переживаний' хранится чувственный опыт. Их два: публичный сенсориум, открытый для всех в Городском Фестхолле, и сенсориум чувствующих, открытый только для членов Общества Восприятия, чувствующих».~
@40626 = ~«У меня еще вопрос...»~
@40627 = ~«Это все, что я хотел узнать. Прощай».~
@40628 = ~«Не знаю... но я, к примеру, не буду удивлена. Во имя Геры, ты только *посмотри* на эту девчонку! Впрочем, спроси у Джульетты — они с ней когда-то дружили... пока не появился Монтекки».~
@40629 = ~«У меня еще вопрос...»~
@40630 = ~«Это все, что я хотел узнать. Прощай».~
@40631 = ~«Большую часть времени я провожу в своей комнате, но мне кажется, что даже *я* бы узнала, появись тут десятая ученица. Пока такой нет».~
@40632 = ~«У меня еще вопрос...»~
@40633 = ~«Это все, что я хотел узнать. Прощай».~
@40634 = ~«Нет. А тебе? — до тебя из темноты доносится раздраженный вздох. — Спроси у Ив. Она собирает истории, и, быть может, расскажет тебе что-нибудь полезное».~
@40635 = ~«Неважно. У меня другой вопрос...»~
@40636 = ~«Забудь, что я спрашивал. Прощай».~
@40637 = ~«Нет, без понятия».~
@40638 = ~«У меня еще вопрос...»~
@40639 = ~«Я уже должен идти. Прощай».~
@40640 = ~Марисса ничего не отвечает, хотя из темноты вокруг нее слышится сердитое шипение. «Да, я, бывало, прокрадывалась в комнату Вивьен за ее духами... хотя я сомневаюсь, что здесь ты найдешь хоть кого-нибудь, кто этим не занимался. Если ты подразумеваешь, что я взяла ее *личный* аромат, что ж... не стесняйся, обнюхай тут все. Уверяю, ты не найдешь его ни на мне, ни в моей комнате».~
@40641 = ~«У меня еще вопрос...»~
@40642 = ~«Это все, что я хотел узнать. Прощай».~
@40643 = ~Холодный жестокий голос Мариссы шипит из темноты: «Вернулся! Полагаю, на этот раз ты сюда не просто так зашел? Или снова будешь задавать свои бессмысленные вопросы?»~
@40644 = ~«Вообще-то, я принес твою малиновую вуаль...»~
@40645 = ~«Вообще-то, я принес твою малиновую вуаль...»~
@40646 = ~«Еще немного 'бессмысленных' вопросов, Марисса».~
@40647 = ~«Просто проходил мимо. Прощай».~
@40648 = ~Красные глаза Мариссы светятся в темноте. «Да?» — ее вопрос сопровождается слабым шипением.~
@40649 = ~«Марисса, у меня есть несколько вопросов...»~
@40650 = ~«Ничего, просто проходил мимо. Прощай».~
@40651 = ~Ты отворачиваешься как раз в тот момент, когда Марисса раскрывает глаза; краешком глаза ты замечаешь красный свет, который исходит от них. «О... — она разочарованно вздыхает. — Ты отвернулся! И ты выглядишь *вовсе* не так, как говорил... ай-яй-яй. Ну же, обернись ко мне; я снова закрыла глаза».~
@40652 = ~«У меня вопрос...»~
@40653 = ~«Все в порядке... Уже ухожу. Счастливо».~
@40654 = ~Глаза Мариссы внезапно раскрываются, окутывая тебя холодным красным светом... это последнее, что видят твои глаза, поскольку они — так же как и остальная часть тебя — навеки превращаются в камень.~
@40655 = ~«Аааа...»~
@40656 = ~Марисса некоторое время молчит, потом отвечает: «Сначала я потеряла свою малиновую вуаль... но теперь... даже не знаю. Наверное, я привыкла общаться со своими клиентами таким образом, и мне это стало нравиться. Думаю, со временем мне это надоест, и я снова решусь выйти в Сигил, но пока... мне и здесь удобно».~
@40657 = ~«У меня еще вопрос...»~
@40658 = ~«Это все, что я желал знать. Прощай, Марисса».~
@40659 = ~Марисса ничего не отвечает, хотя из темноты вокруг нее слышится сердитое шипение. «Да, я, бывало, прокрадывалась в комнату Вивьен за ее духами... хотя я сомневаюсь, что здесь ты найдешь хоть кого-нибудь, кто этим не занимался. Если ты подразумеваешь, что я взяла ее *личный* аромат, что ж... не стесняйся, обнюхай тут все. Уверяю, ты не найдешь его ни на мне, ни в моей комнате. Возможно, тот, кто забрал мою малиновую вуаль, прихватил и запах Вивьен».~
@40660 = ~«Твою вуаль украли?»~
@40661 = ~«У меня еще вопрос...»~
@40662 = ~«Это все, что я хотел узнать. Прощай».~
@40663 = ~«Да... Экко. Знала я одну Экко, но ее имя звучит немного по-другому. В прочем, я ничего не знаю об этой девчонке. Спроси о ней Долору. Я слышала, она подружилась с прежним любовником Экко».~
@40664 = ~«У меня еще вопрос...»~
@40665 = ~«Это все, что я хотел узнать. Прощай».~
@40666 = ~«Думаю, да... будь у тебя лим-лим, я была бы не против. И я *могла* бы согласиться, будь у меня моя малиновая вуаль... однако я не знаю, куда она подевалась. Ты случайно не видел ее?»~
@40667 = ~«Нет... а зачем она? Это просто обычная вуаль?»~
@40668 = ~«Нет. У меня есть несколько вопросов...»~
@40669 = ~«Нет. Прощай».~
@40670 = ~«Думаю, да... будь у тебя лим-лим, я была бы не против. И я *могла* бы согласиться, будь у меня моя малиновая вуаль».~
@40671 = ~«У меня еще вопрос...»~
@40672 = ~«Это все, что я хотел узнать. Прощай».~
@40673 = ~«Думаю, да... а что? Ты что, принес с собой лим-лима?»~
@40674 = ~«Да».~
@40675 = ~«Пока нет».~
@40676 = ~«Вообще-то, забудь. У меня есть вопрос».~
@40677 = ~«Забудь, что я спрашивал, Марисса... Прощай».~
@40678 = ~«Тогда давай его сюда...» Марисса берет у тебя из рук маленькое веселое существо... оно радостно щебечет «Пийо! Пийо!», не подозревая об уготованной ему судьбе. ~
@40679 = ~После зловещей вспышки бледно-красного света веселое щебетание лим-лима внезапно и тревожно прерывается. Марисса передает тебе лим-лима — теперь уже вещь из холодного тяжелого камня.~
@40680 = ~«Спасибо, Марисса. У меня вопрос...»~
@40681 = ~«Благодарю тебя, Марисса. Прощай».~
@40682 = ~«Ну, так или иначе, это спорный вопрос, — она громко вздыхает. — Не пойму, почему ты вообще мне этим докучаешь».~
@40683 = ~«У меня еще вопрос...»~
@40684 = ~«Это все, что я хотел узнать. Прощай».~
@40685 = ~Морт тихонько шепчет: «Ух ты... жуткая девчонка».~
@40686 = ~«Прошу прощения, миледи... Не думал, что тут кто-нибудь есть».~
@40687 = ~«У меня есть несколько вопросов, миледи...»~
@40688 = ~«В таком случае, прощайте, миледи».~
@40689 = ~«Ничего, я просто проходил мимо. Прощай».~
@40690 = ~Похоже, этот серьезный мужчина все еще пытается что-то разгадать. Когда ты приближаешься к нему, он прерывает ход своих мыслей и смотрит на тебя. «Да?»~
@40691 = ~«У меня есть несколько вопросов...» ~
@40692 = ~«Ничего, я просто проходил мимо. Прощай».~
@40693 = ~Он выглядит немного раздраженным, но ничего не говорит.~
@40694 = ~«Ты, похоже, чем-то обеспокоен...»~
@40695 = ~«Что ты здесь делаешь?»~
@40696 = ~«Что ты можешь рассказать об этом месте?»~
@40697 = ~«Что ты можешь рассказать о молчаливой куртизанке?»~
@40698 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40699 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40700 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40701 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@40702 = ~«Я переговорил со всеми девятью куртизанками... ты не знаешь, кто десятая или где она находится?»~
@40703 = ~«Вообще-то, неважно. Прощай».~
@40704 = ~Мужчина мрачнеет. «Нет то чтобы обеспокоен... Просто пытаюсь придумать способ обыграть Долору».~
@40705 = ~«Кого?»~
@40706 = ~«Да, она — достойный соперник».~
@40707 = ~«Сам-то я с ней еще не играл».~
@40708 = ~«У меня другой вопрос...»~
@40709 = ~«Это все, что я хотел узнать. Прощай».~
@40710 = ~«Долора — одна из здешних куртизанок. Сдержанная, прекрасно образованная, очень умная... ее разум — как бритва, честно. Если ищешь сложную задачку — попробуй обыграть ее в стратегическую игру».~
@40711 = ~«Значит, ты ни разу ее не обыгрывал?»~
@40712 = ~«У меня другой вопрос...»~
@40713 = ~«Это все, что я хотел узнать. Прощай».~
@40714 = ~Помрачнев, он качает головой. «Когда-то я играл с женщиной по имени Вивьен, и пришел к выводу, что я довольно искусен в игре... но потом я встретил Долору. У меня сильное подозрение, что Вивьен позволяла мне выигрывать, но я никогда ее не спрашивал об этом».~
@40715 = ~«У меня другой вопрос...»~
@40716 = ~«Это все, что я хотел узнать. Прощай».~
@40717 = ~«Отдыхаю после оглушительного поражения, которое мне устроила Долора. И все же мне кажется, в этот раз я почти что победил ее, так что я пытаюсь придумать, что бы мне предпринять, чтобы выиграть в следующий раз».~
@40718 = ~«Кто такая Долора?»~
@40719 = ~«Сам-то я с ней еще не играл».~
@40720 = ~«У меня другой вопрос...»~
@40721 = ~«Это все, что я хотел узнать. Прощай».~
@40722 = ~Он кивает. «Что-нибудь еще, или...?»~
@40723 = ~«Да, у меня еще один вопрос...»~
@40724 = ~«Нет, это все. Прощай».~
@40725 = ~«Слушай, мне нужно кое о чем поразмыслить. Так что, если ты не против...»~
@40726 = ~«Погоди-ка... Позволь спросить о чем-нибудь еще...»~
@40727 = ~«Тогда извини, что отвлек. Прощай».~
@40728 = ~«Отлично. Прощай».~
@40729 = ~«На самом деле, ничего».~
@40730 = ~«У меня другой вопрос...»~
@40731 = ~«Тогда прощай».~
@40732 = ~«Равель, говоришь? Я никогда не спрашивал ее об этом. Может, тебе попробовать».~
@40733 = ~«У меня другой вопрос...»~
@40734 = ~«Тогда прощай».~
@40735 = ~«Возможно, я так и сделаю. Прощай».~
@40736 = ~«Нет. Я в последнее время не разговаривал с Вивьен; я даже и не знал, что она его потеряла. А жаль: у нее ведь всегда был *самый* что ни на есть поразительный эротический запах...»~
@40737 = ~«У меня другой вопрос...»~
@40738 = ~«Это все, что я хотел узнать. Прощай».~
@40739 = ~«Нет. Что-нибудь еще?»~
@40740 = ~«У меня другой вопрос...»~
@40741 = ~«Тогда прощай».~
@40742 = ~«Нет, — мужчина ухмыляется, затем вздыхает. — То есть да. Она — ночная ведьма, она попала в один из лабиринтов Леди, она — персонаж порядка сотни детских страшилок... но держу пари, что это не те сведения, которые тебе нужны».~
@40743 = ~«У меня другой вопрос...»~
@40744 = ~«И на том спасибо. Прощай».~
@40745 = ~Он качает головой. «Нет, насколько я знаю, здесь их только девять».~
@40746 = ~«У меня другой вопрос...»~
@40747 = ~«Тогда прощай».~
@40748 = ~Похоже, это странное кубическое создание является в равной мере машиной и органическим существом. Пока ты подходишь к нему, оно молча следит за тобой широко раскрытыми немигающими глазами. На его лице нет ни намека на эмоции.~
@40749 = ~«Приветствую...»~
@40750 = ~Оставить его в покое.~
@40751 = ~Модрон молча смотрит на тебя.~
@40752 = ~«У меня есть несколько вопросов...» ~
@40753 = ~«У меня есть несколько вопросов...» ~
@40754 = ~Оставить его в покое.~
@40755 = ~Его голос имеет металлический оттенок и дрожит, как будто издается каким-то поломанным музыкальным инструментом: «Твое приветствие возвращено». Когда существо моргает, раздается тихий *щелк*. В воздухе между вами нависает неловкая тишина.~
@40756 = ~«У меня есть несколько вопросов...» ~
@40757 = ~«У меня есть несколько вопросов...» ~
@40758 = ~«Идентифицируй себя».~
@40759 = ~«Но как же... мои вопросы...»~
@40760 = ~«Неважно, кто я».~
@40761 = ~Ложь: «Я... Адан».~
@40762 = ~«Я не уверен в том, кто я такой».~
@40763 = ~«Забудь... Прощай».~
@40764 = ~«Определение личности субъекта имеет высокий приоритет. Предоставление ответов на различные вопросы, которые может задавать субъект, имеет низкий приоритет. Идентифицируй себя».~
@40765 = ~«Неважно, кто я».~
@40766 = ~Ложь: «Я... Адан».~
@40767 = ~«Я не уверен в том, кто я такой».~
@40768 = ~«Забудь... Прощай».~
@40769 = ~«Мнение субъекта относительно важности собственной личности не является существенным. Мы считаем личность субъекта важной; таким образом, для любых намерений и целей важно определить личность».~
@40770 = ~Ложь: «Я... Адан».~
@40771 = ~«Я не уверен в том, кто я такой».~
@40772 = ~«Забудь... Прощай».~
@40773 = ~Существо слегка наклоняется вперед, потом назад. Непонятно только, что означает это движение: поклон или кивок. «Субъекту Адану мы представимся как модроны, тип квадрон, крылатый вариант».~
@40774 = ~«У меня есть несколько вопросов...»~
@40775 = ~«Я уже должен идти. Прощай».~
@40776 = ~«Мы желаем узнать, почему это так».~
@40777 = ~«Это неважно, правда...»~
@40778 = ~«Я его не знаю. Просто не могу вспомнить».~
@40779 = ~Ложь: «Я... Адан».~
@40780 = ~«Забудь... Прощай».~
@40781 = ~«У всего должно быть имя; каждый должен быть идентифицирован. Мы находим твой ответ неудовлетворительным, однако на данный момент этого будет достаточно, — существо умолкает и удивленно смотрит на тебя. — Субъекту мы представимся как модроны, тип квадрон, крылатый вариант».~
@40782 = ~«У меня есть несколько вопросов...»~
@40783 = ~«Я уже должен идти. Прощай».~
@40784 = ~«Субъект может задавать вопросы».~
@40785 = ~«Ты знаешь, что это за маленькое игрушечное существо в форме куба?»~
@40786 = ~«Что ты здесь делаешь?»~
@40787 = ~«Что ты можешь рассказать об этом месте?»~
@40788 = ~«Что ты можешь рассказать о молчаливой куртизанке?»~
@40789 = ~«Я слышал, что Кесай-Серри — дочь Равель. Это правда?»~
@40790 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40791 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40792 = ~«Ты что-нибудь знаешь о Равель Заморочке?»~
@40793 = ~«Я переговорил со всеми девятью куртизанками... ты не знаешь, кто десятая или где она находится?»~
@40794 = ~«На самом деле, неважно. Прощай».~
@40795 = ~«Наша цель — наблюдение».~
@40796 = ~«И что вы наблюдаете?»~
@40797 = ~«У меня есть другие вопросы...»~
@40798 = ~«Это все, что я хотел узнать. Прощай».~
@40799 = ~«Мы наблюдаем за одной из служащих этого заведения».~
@40800 = ~«За кем вы наблюдаете?»~
@40801 = ~«У меня есть другие вопросы...»~
@40802 = ~«Это все, что я хотел узнать. Прощай».~
@40803 = ~«Как было сказано ранее, мы наблюдаем за одной из служащих этого заведения».~
@40804 = ~«Да, но за кем *именно* вы наблюдаете?»~
@40805 = ~«У меня есть другие вопросы...»~
@40806 = ~«Это все, что я хотел узнать. Прощай».~
@40807 = ~«Объект нашего наблюдения носит имя Долора».~
@40808 = ~«Зачем вы за ней следите?»~
@40809 = ~«У меня есть другие вопросы...»~
@40810 = ~«Это все, что я хотел узнать. Прощай».~
@40811 = ~«Нас не проинформировали относительно конкретной цели или целей, которые послужили причиной получения нами текущего задания. Команда нашего старшего пентадрона — достаточное основание для выполнения указанного задания; цель или цели для нас не являются существенными».~
@40812 = ~«У меня есть другие вопросы...»~
@40813 = ~«Это все, что я хотел узнать. Прощай».~
@40814 = ~«Здание расположено в части Сигила, общеизвестной под названием Чиновничий район. Мы не можем дать точные координаты, так как поверхность Сигила меняется через отрезки времени, которые в данный момент не определены. Само здание известно под названием Бордель утоления интеллектуальной страсти. В общих чертах его можно определить как языковую школу. В школе обучаются преимущественно женщины, собирающиеся с некоторого момента (который мы не можем определить, и который колеблется от ученицы к ученице) стать фрактотумами Общества Восприятия».~
@40815 = ~«Общества Восприятия?»~
@40816 = ~«У меня есть другие вопросы...»~
@40817 = ~«Это все, что я хотел узнать. Прощай».~
@40818 = ~«Мы предоставим краткое определение Общества Восприятия: фракция, чье фундаментальное убеждение заключается в том, что истинное понимание мультивселенной и всех ее секретов приходит с опытом».~
@40819 = ~«У меня есть другие вопросы...»~
@40820 = ~«Это все, что я хотел узнать. Прощай».~
@40821 = ~«Упомянутый субъект носит имя Экко. Мы не собрали больше никакой информации относительно упомянутого субъекта».~
@40822 = ~«У меня есть другие вопросы...»~
@40823 = ~«Это все, что я хотел узнать. Прощай».~
@40824 = ~«Даже если бы мы могли с уверенностью выдвинуть гипотезу относительно того, о какой Равель идет речь, мы так или иначе не владеем средствами определения того, была ли Равель матерью Кесай или нет».~
@40825 = ~«Какая Равель? Их что, несколько?»~
@40826 = ~«У меня есть другие вопросы...»~
@40827 = ~«Это все, что я хотел узнать. Прощай».~
@40828 = ~«Мы не способны проверить этот факт, но необходимо учитывать, что 11032 планов бесконечны по масштабу, и не менее 3701 из них населены разумными существами, у которых есть собственные имена. Из этого можно сделать вывод, что в любой момент времени может существовать бесконечное количество существ с таким именем».~
@40829 = ~«У меня есть другие вопросы...»~
@40830 = ~«Это все, что я хотел узнать. Прощай».~
@40831 = ~«Нет. Если ты еще не занялся этим, мы предлагаем тебе применить методический подход и опросить всех обитателей этого здания».~
@40832 = ~«У меня есть другие вопросы...»~
@40833 = ~«Тогда я продолжу расспрашивать. Счастливо».~
@40834 = ~«Мы ничего не знаем о существе или объекте с таким названием».~
@40835 = ~«У меня есть другие вопросы...»~
@40836 = ~«Тогда прощай» .~
@40837 = ~«Нет. Мы еще не пытались каталогизировать всех обитателей этого здания, и не намерены делать это когда-либо».~
@40838 = ~«У меня есть другие вопросы...»~
@40839 = ~«Тогда прощай» .~
@40840 = ~Внешний вид предмета в твоих руках идентичен модрону во всех аспектах, кроме размера. Он моргает раз, потом еще раз, и произносит: «Этот предмет — портальный куб. Пользователю необходимо сконфигурировать его конечности определенным образом, чтобы он активизировался. После активизации портальный куб перенесет пользователя в место, на которое он был настроен в процессе своего создания».~
@40841 = ~«И как же его правильно активизировать?»~
@40842 = ~«И куда же этот куб отправит пользователя?»~
@40843 = ~«Мы не располагаем такой информацией. Более девяноста семи процентов всех портальных кубов имеют небольшие различия в принципе действия. Мы не присутствовали при создании этого портального куба, и нам не предоставили инструкций по его использованию. Если субъект изъявляет желание воспользоваться портальным кубом, ему придется определить способ его использования и то, куда он ведет, экспериментальным путем».~
@40844 = ~«У меня есть другие вопросы...»~
@40845 = ~«Тогда прощай» .~
@40846 = ~«Брось, шеф! Мы в доме, где полным-полно самых сексуальных цыпочек по эту сторону мультивселенной, а ты останавливаешься, чтобы поболтать с *модронами*?»~
@40847 = ~«Что ты можешь рассказать о них, Морт?»~
@40848 = ~Не обращать внимания на Морта и поздороваться с модроном.~
@40849 = ~«Прошу прощения, Морт, но я разговариваю с модроном».~
@40850 = ~«Хорошо. Идем, Морт».~
@40851 = ~Морт издает звук крайнего отвращения. «Что тут сказать? Мелкие назойливые механические жучки... без передыху трудятся над навязыванием закона и порядка в мультивселенной. Заметь, не *добра*... только порядка. Давай просто забудем о них и пойдем поболтаем с дамочками, а?»~
@40852 = ~Не обращать внимания на Морта и поздороваться с модроном.~
@40853 = ~«Прошу прощения, Морт, но я разговариваю с модроном».~
@40854 = ~«Хорошо. Идем, Морт».~
@40855 = ~Морт громко вздыхает. «Ладно, как знаешь... Только не говори, что я тебя не предупреждал. Хотя ты, наверное, многого от них не добьешься... у них довольно странная манера разговора».~
@40856 = ~«Приветствую...»~
@40857 = ~Оставить ее в покое.~
@40858 = ~Голос женщины звучит глубоко и чувственно: «Приветствую *тебя*, господин, — ее горящие глаза блуждают по тебе. — Я — Кесай-Серри. Скажи, что я могу сделать для тебя, ммм?»~
@40859 = ~«Кесай? Ты дочь Равель?»~
@40860 = ~«А что ты обычно делаешь для своих клиентов?»~
@40861 = ~«У меня есть несколько вопросов...» ~
@40862 = ~«Ничего, спасибо. Прощай».~
@40863 = ~Кесай искренне смеется, обнажив зубы, которые, судя по длине, можно называть клыками. Она качает головой и улыбается Морту: «Верно, и все же... что я могу сделать для тебя?»~
@40864 = ~«Кесай? Ты дочь Равель?»~
@40865 = ~«А что ты обычно делаешь для своих клиентов?»~
@40866 = ~«У меня есть несколько вопросов...» ~
@40867 = ~«Ничего, спасибо. Прощай».~
@40868 = ~Они изгибает брови дугой. «Дразнишься, а? — улыбается тебе Кесай, смотря на тебя горящими красными глазами. — Возвращайся назад, когда захочешь поговорить, хорошо, мммм?»~
@40869 = ~Уйти.~
@40870 = ~«Разговариваю, конечно же! Обычно о снах, чаще всего — об эротических... но не всегда! — Кесай, улыбаясь, подмигивает. — Итак! Может быть, расскажешь мне о своих? Не стесняйся, я многое слышала. Ничто меня не сможет потрясти или удивить, я люблю слушать сны людей. Мы даже можем обменяться ими, если хочешь, но ты будешь первым».~
@40871 = ~«Мои сны поменялись с тех пор, как я увидел тебя...»~
@40872 = ~«Мои сны поменялись с тех пор, как я увидел тебя, моя госпожа...»~
@40873 = ~«У меня не так уж много снов. Долгое время у меня их вообще не было».~
@40874 = ~«Вообще-то, у меня... нет снов».~
@40875 = ~«Нет... Я не хочу».~
@40876 = ~«Я бы хотел, но у меня слишком мало времени».~
@40877 = ~Кесай надувает губки, затем вздыхает. «Как пожелаешь! Я буду ждать тебя, если ты вдруг передумаешь...»~
@40878 = ~«Постой... У меня есть несколько вопросов...»~
@40879 = ~«Ладно. Прощай».~
@40880 = ~«Ну где же они, где? — улыбается Кесай. — Давай же, давай... послушаем об этом! Что тебе снится, ммм?»~
@40881 = ~«У меня не так уж много снов. Долгое время у меня их вообще не было».~
@40882 = ~«Вообще-то, у меня... нет снов».~
@40883 = ~«Я бы не хотел об этом говорить».~
@40884 = ~«Я бы хотел рассказать, но у меня слишком мало времени».~
@40885 = ~«Ну *где* же они, где? — улыбается Кесай, пожирая тебя своими сверкающими красными глазами. — Ты выглядишь как настоящий дикарь. Скажи мне — ты груб со своими любовницами? Я имею в виду, в *действии*... физическом смысле?»~
@40886 = ~«Ты имеешь в виду 'жестокий'?»~
@40887 = ~«Почему ты об этом спрашиваешь?»~
@40888 = ~«Нет, на самом деле я очень нежный».~
@40889 = ~«Да, думаю, я такой».~
@40890 = ~«Если только это доставляет удовольствие им».~
@40891 = ~«Все зависит от того, в каком я настроении».~
@40892 = ~«На самом деле, я... не знаю».~
@40893 = ~«Да не допустят небеса, нет! — Кесай раздраженно смотрит на тебя. — Некоторые люди делают это очень *медленно* и *чувственно*... а другие — быстро, грубо и сумбурно, понимаешь? Я просто хочу узнать, к кому ты относишься».~
@40894 = ~«Почему ты об этом спрашиваешь?»~
@40895 = ~«Вообще-то, я очень нежный».~
@40896 = ~«Думаю, я немного грубоват».~
@40897 = ~~
@40898 = ~~
@40899 = ~«Я груб, если только это доставляет им удовольствие».~
@40900 = ~«Все зависит от того, в каком я настроении».~
@40901 = ~«На самом деле, я... не знаю».~
@40902 = ~Кесай пожимает плечами. «Просто интересно... очень увлекательно разговаривать о любовном контакте. Многие не любят говорить об этом, но очень важно уметь делать это, особенно со своим партнером — от этого будет хорошо обоим! Я очень надеюсь, что мои клиенты будут разговаривать со своими партнерами на подобные темы. Да, ты ведь так и не ответил на мой вопрос...»~
@40903 = ~«Вообще-то, я очень нежный».~
@40904 = ~«Думаю, я немного грубоват».~
@40905 = ~«Я груб, если только это доставляет им удовольствие».~
@40906 = ~«Все зависит от того, в каком я настроении».~
@40907 = ~«На самом деле, я... не знаю».~
@40908 = ~Кесай кивает, улыбаясь. «Я так и знала, что ты это скажешь. Я сама немного грубовата... Мне нравится, когда меня носят на руках, а еще я люблю кусать! Только у меня острые зубы, поэтому приходится быть осторожной. Иногда я слишком увлекаюсь и проливаю немного крови, представляешь?»~
@40909 = ~«У тебя острые зубы?»~
@40910 = ~«Я бы не возражал, если...»~
@40911 = ~«Такое мне *вовсе* не по душе...»~
@40912 = ~«Да... что ж, у меня есть несколько вопросов...»~
@40913 = ~«Понятно. Я должен немедленно идти. Прощай».~
@40914 = ~«Скорее всего, бродила по Внешним землям. Это ведь был риторический вопрос?» Подмигнув Морту, она поворачивается к тебе.~
@40915 = ~«У тебя острые зубы?»~
@40916 = ~«Не думаю, что я бы возражал против укусов...»~
@40917 = ~«Укусы мне *совсем* не по душе...»~
@40918 = ~«У меня есть несколько вопросов, Кесай...»~
@40919 = ~«Я должен немедленно идти. Прощай».~
@40920 = ~Кесай кивает. «Угу, это так. Хочешь посмотреть? Вот...» Открыв рот, она проводит своим фиолетовым языком по нижним зубам. Они настолько длинные, что их можно считать клыками.~
@40921 = ~«Не думаю, что я бы возражал против укусов...»~
@40922 = ~«Укус такими зубами мне *вовсе* не придется по душе...»~
@40923 = ~«Понятно. У меня есть несколько вопросов, Кесай...»~
@40924 = ~«Я должен немедленно идти. Прощай».~
@40925 = ~Кесай громко смеется. «Так или иначе, сомневаюсь, что я могу прокусить твою толстую шкуру. Она еще чувствует хоть что-нибудь?»~
@40926 = ~«Нет, к сожалению. Шрамы очень толстые».~
@40927 = ~«Я не хочу говорить об этом».~
@40928 = ~«О, какая досада. У тебя *так* много шрамов... — Кесай внимательно смотрит на твое лицо. — Даже на губах и на веках... скажи мне, у тебя шрамы повсюду? Ну, понимаешь... совсем *повсюду*?»~
@40929 = ~«Нет, конечно же. Некоторым частям каким-то образом удалось избежать повреждений».~
@40930 = ~«Я не хочу говорить об этом».~
@40931 = ~«Это хорошо! — Кесай мило смеется, затем принимает серьезный вид, положив руки на пояс. — Знаешь, ты ведь так и *не рассказал* мне о своих снах. Давай, расскажи мне о них!»~
@40932 = ~«У меня не так уж много снов. Долгое время у меня их вообще не было».~
@40933 = ~«Вообще-то, у меня... нет снов».~
@40934 = ~«Я бы не хотел об этом говорить».~
@40935 = ~«Я бы хотел рассказать, но у меня слишком мало времени».~
@40936 = ~«Вот видишь? Вот почему очень важно говорить о таких вещах, особенно с любимым человеком. Первое совокупление может пройти гораздо лучше, если пара перед этим обсудит акт... Кроме того, об этом ведь очень занятно разговаривать, ммм?» Кесай широко улыбается, ее глаза ярко пылают, словно пара алых рубинов.~
@40937 = ~«Да, можно и так сказать».~
@40938 = ~«Нет, я думаю, что это очень личная тема, которую нельзя брать наскоком».~
@40939 = ~«Я не хотел бы разговаривать об этом».~
@40940 = ~Кесай кивает, отрешенно о чем-то думая. «Слушай... ты ведь так и *не рассказал* мне о своих снах. Давай, расскажи мне о них!»~
@40941 = ~«У меня не так уж много снов. Долгое время у меня их вообще не было».~
@40942 = ~«Вообще-то, у меня... нет снов».~
@40943 = ~«Я бы не хотел об этом говорить».~
@40944 = ~«Я бы хотел рассказать, но у меня слишком мало времени».~
@40945 = ~Кесай надувает губки, затем пожимает плечами. «Если тебе неудобно об этом говорить, то все в порядке. Я только скажу, что у тебя не должно быть никаких сомнений перед своей любимой. Такие вещи очень важно обсуждать, особенно перед совершением акта, понимаешь? Так будет лучше для вас обоих».~
@40946 = ~«Я запомню это».~
@40947 = ~«Думаю, тебе лучше позаботиться о своих делах».~
@40948 = ~Она просто улыбается в ответ. «Слушай... ты ведь так и *не рассказал* мне о своих снах. Давай, расскажи мне о них!»~
@40949 = ~«У меня не так уж много снов. Долгое время у меня их вообще не было».~
@40950 = ~«Вообще-то, у меня... нет снов».~
@40951 = ~«Я бы не хотел об этом говорить».~
@40952 = ~«Я бы хотел рассказать, но у меня слишком мало времени».~
@40953 = ~Закатив свои огненно-красные глаза, Кесай усмехается. «Знаешь ли, вообще-то это *ты* пришел ко *мне*. Если подобные вещи тебе неприятны, ты волен уйти и поговорить с одной из других девушек».~
@40954 = ~«Нет, пока нет — у меня есть несколько вопросов...»~
@40955 = ~«Тогда я так и сделаю. Прощай».~
@40956 = ~Кесай удивленно поднимает брови. «Правда? Как печально! Знаешь, даже у нечистых и дэва есть свои сны. Ты *уверен*, что у тебя их нет?»~
@40957 = ~«Да, уверен. Никаких снов».~
@40958 = ~«Хмм. Это так необычно! Даже и не знаю, что сказать...»~
@40959 = ~«Что ж, у меня есть несколько вопросов...»~
@40960 = ~«Все в порядке. Прощай, Кесай».~
@40961 = ~«Не было вообще? Как странно! Даже у нечистых и дэва есть свои сны. Ты *уверен*, что у тебя их нет?» Кесай приближается тебе, нетерпеливо ожидая твоего ответа.~
@40962 = ~«Это скорее кошмары, чем сны. Видения лабиринта из черных шипов... ночной ведьмы по имени Равель...»~
@40963 = ~«Вообще-то, я не хотел бы это обсуждать».~
@40964 = ~Кесай некоторое время хранит молчание. «А? Ах... кошмары. Понимаю... это так печально, правда...»~
@40965 = ~«Ты уверена? Кажется, ты немного смятена...»~
@40966 = ~«Да, наверное. У меня есть несколько вопросов...»~
@40967 = ~«Все в порядке. Прощай, Кесай».~
@40968 = ~«Со мной все в порядке, спасибо». Кесай улыбается тебе.~
@40969 = ~«Тогда я бы хотел задать несколько вопросов...»~
@40970 = ~«Мне нужно идти. Прощай, Кесай».~
@40971 = ~Кесай смотрит на тебя своими малиновыми глазами, ожидая вопроса.~
@40972 = ~«Кесай, я поговорил с Кимаскси. Она сказала мне, что она — твоя единокровная сестра, и что твоя мать — Равель».~
@40973 = ~«Ты случайно не дочь Равель?»~
@40974 = ~«Что ты такое?»~
@40975 = ~«Извини за вопрос, но что ты такое?»~
@40976 = ~«Что ты такое?»~
@40977 = ~«Извини за вопрос, но что ты такое?»~
@40978 = ~«Что ты здесь делаешь?»~
@40979 = ~«Что ты можешь сказать об этом месте?»~
@40980 = ~«Что ты можешь рассказать о молчаливой проститутке?»~
@40981 = ~«Я пытаюсь найти аромат Вивьен... Ты не знаешь, где он может быть?»~
@40982 = ~«Я пытаюсь найти малиновую вуаль Мариссы... Ты не знаешь, где она может быть?»~
@40983 = ~«Тебе что-нибудь известно о Равель Заморочке?»~
@40984 = ~«Я переговорил со всеми девятью проститутками... ты не знаешь, кто десятая ученица или где она находится?»~
@40985 = ~«Ничего особенного. Прощай».~
@40986 = ~Кесай качает головой. «Как, разве я тебе еще не говорила? — она выпрямляется, выпячивая свою пышную грудь вперед. — Я — женщина! — она поднимает бровь. — Вижу, мой ответ тебя не удовлетворил... На самом деле, я — отмеченная планами. Это все, что тебе нужно знать».~
@40987 = ~«Кесай, я поговорил с Кимаскси. Она сказала мне, что она — твоя единокровная сестра, и что твоя мать — Равель».~
@40988 = ~«Ты дочь Равель?»~
@40989 = ~«У меня есть другой вопрос...»~
@40990 = ~«Это все, что я хотел узнать. Прощай».~
@40991 = ~Кесай качает головой «Как, разве я тебе еще не говорила? — она выпрямляется, выпячивая свою пышную грудь вперед. — Я — женщина! — она поднимает бровь. — Вижу, мой ответ тебя не удовлетворил... На самом деле, я — отмеченная планами, как и твоя подруга, — Кесай указывает на Анну. — Это все, что тебе нужно знать».~
@40992 = ~«Кесай, я поговорил с Кимаскси. Она сказала мне, что она — твоя единокровная сестра, и что твоя мать — Равель».~
@40993 = ~«Ты дочь Равель?»~
@40994 = ~«У меня есть другой вопрос...»~
@40995 = ~«Это все, что я хотел узнать. Прощай».~
@40996 = ~«Похоже, что забавляюсь твоими вопросами, — она улыбается тебе. — На самом деле, я — ученица госпожи Грации. Как и все проститутки Борделя».~
@40997 = ~«Ученица?»~
@40998 = ~«У меня есть другой вопрос...»~
@40999 = ~«Это все, что я хотел узнать. Прощай».~
@41000 = ~«Да. Бордель на самом деле является школой для женщин, которые хотят стать чувствующими. Госпожа Грация обучает нас способам общения, чтобы мы могли лучше знать себя и окружающий мир. Это позволит нам лучше познать планы, понимаешь?»~
@41001 = ~«Расскажи мне о чувствующих».~
@41002 = ~«У меня есть другой вопрос...»~
@41003 = ~«Это все, что я хотел узнать. Прощай».~
@41004 = ~Общество Восприятия верит, что мультивселенную можно понять, только познав ее... Чем больше опыт познания, тем ты ближе к пониманию тайн мультивселенной. Интригует, правда? Думаю, я родилась для того, чтобы стать одной из них — я просто обожаю *познавать*».~
@41005 = ~«У меня есть другой вопрос...»~
@41006 = ~«Это все, что я хотел узнать. Прощай».~
@41007 = ~«Конечно. Бордель утоления интеллектуальной страсти на самом деле является школой для женщин, которые хотят стать чувствующими. Госпожа Грация обучает нас способам общения, чтобы мы могли лучше знать себя и окружающий мир. Это позволит нам лучше познать планы, понимаешь?»~
@41008 = ~«Расскажи мне о чувствующих».~
@41009 = ~«У меня есть другой вопрос...»~
@41010 = ~«Это все, что я хотел узнать. Прощай».~
@41011 = ~«Нет, не знаю, — Кесай хмурится. — Многие говорят, что она слишком чопорная, но со мной она была так мила... делала комплименты о моих глазах... и пахла она так приятно! Надеюсь, что она найдет свой аромат. Попробуй расспросить об этом Ненни: она ходит повсюду, может быть, она что-то видела».~
@41012 = ~«Знаешь, а у тебя очень красивые глаза».~
@41013 = ~«Знаешь, а у тебя очень красивые глаза».~
@41014 = ~«У меня есть другой вопрос...»~
@41015 = ~«Это все, что я хотел узнать. Прощай».~
@41016 = ~«О, спасибо! Знаешь, в темноте они светятся... странно, да? — она смотрит на тебя. — У тебя тоже красивые глаза... такие темные и таинственные! В них чувствуется характер».~
@41017 = ~«Спасибо, Кесай. У меня есть другой вопрос...»~
@41018 = ~«Спасибо. Прощай, Кесай».~
@41019 = ~Кесай-Серри пожимает плечами и снова поворачивается к тебе.~
@41020 = ~«Хмм. Нет, я ее не видела с тех пор, как она надела ее в последний раз... но Ненни могла видеть что-нибудь, попробуй расспросить ее. Пожалуй, это даже хорошо... Марисса никогда не выходит из своей комнаты без вуали, поэтому мы все избавлены от ее неприятного языка... осталась только Кимаскси, — Кесай улыбается. — Из них двоих Кимаскси еще хуже».~
@41021 = ~«Каким образом?»~
@41022 = ~«У меня есть другой вопрос...»~
@41023 = ~«Это все, что я хотел узнать. Прощай».~
@41024 = ~«Марисса надменная и подлая, но Кимаскси... она — жестокий и злобный монстр в женском обличье, с ядовитым языком и повадками балора. Я не могу понять, *почему* с ней кто-то хочет общаться — ее ядовитые уста больше подходят для свежевания, но, тем не менее, у нее есть свои постоянные клиенты».~
@41025 = ~«У меня есть другой вопрос...»~
@41026 = ~«Это все, что я хотел узнать. Прощай».~
@41027 = ~«Нет. Ничего».~
@41028 = ~«Ты уверена? Кажется, ты немного расстроена...»~
@41029 = ~«У меня есть другой вопрос...»~
@41030 = ~«Это все, что я хотел узнать. Прощай».~
@41031 = ~Ее красные глаза зло смотрят на тебя. «Конечно же, я уверена! Больше не спрашивай меня о ней».~
@41032 = ~«Хорошо. У меня есть другие вопросы...»~
@41033 = ~«Тогда прощай».~
@41034 = ~«Десятая? — Кесай шаркает ногами, поджав губки, будто в раздумье. — Нет... нас только девять. Всегда было девять проституток, если только госпожа Грация не внесла новые изменения, о которых я еще не знаю».~
@41035 = ~«У меня есть другой вопрос...»~
@41036 = ~«Это все, что я хотел узнать. Прощай».~
@41037 = ~Неожиданно Кесай обнажает свои зубы, глаза превращаются горящие алым щели. «Что?! Откуда ты это услышал?»~
@41038 = ~«Экко рассказала мне».~
@41039 = ~«Это просто слухи».~
@41040 = ~«Возмутительно! Если нечестивая ведьма была бы моей матерью, то я бы *знала* об этом! А теперь хватит досаждать меня этим».~
@41041 = ~«Тогда кто твоя мать?»~
@41042 = ~«Хорошо. У меня есть другие вопросы...»~
@41043 = ~«Тогда прощай».~
@41044 = ~«Не знаю, понятно? Меня вырастил отец; я никогда не знала, кто моя мать. Я разве *похожа* на ночную ведьму?!»~
@41045 = ~«Ну... кожа... и глаза... и зубы, может быть, тоже...»~
@41046 = ~«Нет, нет, конечно же, нет».~
@41047 = ~Кесай-Серри смотрит на тебя пылающими глазами. «Пожалуй, мы поговорим *потом*, а сейчас я больше не в настроении. Прощай».~
@41048 = ~«Прощай».~
@41049 = ~Кесай рычит, ее пылающие глаза полны злобы. «Это... это... черт, как я ненавижу эту женщину! Как ты вообще *поверил* в этот вздор?»~
@41050 = ~«Она сказала, что ты не поверишь в это и можешь не знать этого, но это правда. Она сказала, что ты можешь спросить у своего отца... он тебе все расскажет».~
@41051 = ~Кесай некоторое время молча смотрит на тебя. «Дай мне пару минут». Отвернувшись от тебя, она начинает что-то тихо нашептывать... Воздух вокруг нее начинает сверкать, наполняясь медным запахом, словно теплой кровью...~
@41052 = ~Терпеливо ждать.~
@41053 = ~Напрячь слух, попробовать услышать то, что она говорит.~
@41054 = ~Ты наклоняешься к Кесай, пытаясь услышать, что она шепчет.

«Хогазаненель, Изгнанный принц Итага, Маркиз Кровавых теней, отец мой, услышь меня, я взываю к тебе...»~
@41055 = ~Продолжать слушать.~
@41056 = ~Прекратить слушать.~
@41057 = ~«Да, любимый отец, это я, Кесай-Серри. Я хочу задать тебе один вопрос, который я задавала тебе много раз...»~
@41058 = ~Продолжать слушать.~
@41059 = ~Прекратить слушать.~
@41060 = ~«Да, любимый отец. Мне надоело слышать этот вопрос и не знать на него ответа. Ты *должен* сказать мне... Я не прошу ни о чем, кроме этого. Скажи мне, умоляю тебя...»~
@41061 = ~Продолжать слушать.~
@41062 = ~Прекратить слушать.~
@41063 = ~«Д-да... да, любимый отец, я понимаю. Спасибо... Прощай...»~
@41064 = ~«Ну что? Что он сказал?»~
@41065 = ~Вернуться назад, сделать вид, что ты ничего не слышал.~
@41066 = ~Кесай до самого последнего момента стоит к тебе спиной. «Не может быть, чтобы эта чертова ведьма была моей матерью. Я прожила уже много лет и до сих пор не постарела, только... эти странные сны временами, — она вздрагивает. — Но я не хочу быть наследницей всего того зла, что она причинила, не хочу попасться на глаза Леди, как моя мать. Она натворила столько зла!»~
@41067 = ~«Скажи, что ты знаешь о ней?»~
@41068 = ~«Мне нужна частичка тебя, Кесай».~
@41069 = ~«Я не стал бы об этом беспокоиться, Кесай; ты ничем не похожа на Равель. Прощай».~
@41070 = ~«Я слышала, что она задавала людям невозможные загадки, на которые может ответить только она сама. И съедала их, если они отвечали неправильно, или оставляла их висеть в своих ужасных садах в качестве назидания остальным. Тех немногих, кто смог убежать от нее, она мучила в их снах, загоняя как лошадей, ломая волю и бросая их души в унылое забвение Серой пустоши...»~
@41071 = ~«Продолжай...»~
@41072 = ~«Мне нужна частичка тебя, Кесай».~
@41073 = ~«Все в порядке... тебе не нужно больше ничего говорить. Прощай, Кесай».~
@41074 = ~«Говорят, ее магия была выше всего, что было раньше: это была фантазия, сотканная из кошмаров и материи. Камень изгибался под ее волей словно мягкая глина, она попирала своими ногами законы планов, она могла соткать иллюзию из ничего... а из иллюзии — соткать нечто реальное, что могло напугать, убить или разрушить».~
@41075 = ~«Продолжай...»~
@41076 = ~«Мне нужна частичка тебя, Кесай».~
@41077 = ~«Все в порядке... тебе не нужно больше ничего говорить. Прощай, Кесай».~
@41078 = ~«Она была госпожой всех Темных искусств, хозяйкой и повелительницей их всех. Она натравила тени на законника, посмевшего зачитать ей законы Сигила, и они поглотили его, оставив только язык, пальцы и лицо. Она вывернула наизнанку убийц милосердия и разрушила дома неугодных ей. Под ее началом были ужасные, ужасные силы».~
@41079 = ~«Продолжай...»~
@41080 = ~«Мне нужна частичка тебя, Кесай».~
@41081 = ~«Все в порядке... тебе не нужно больше ничего говорить. Прощай, Кесай».~
@41082 = ~«Она могла свободно менять свой облик, пользовалась этим для разрушения ради развлечения, или для кражи знаний у других. Она была чудовищем, как и все, что появилось на Серой пустоши».~
@41083 = ~«Продолжай...»~
@41084 = ~«Мне нужна частичка тебя, Кесай».~
@41085 = ~«Все в порядке... тебе не нужно больше ничего говорить. Прощай, Кесай».~
@41086 = ~«В конце концов, она стала грозиться открыть Клетку и выпустить ярость планов внутрь. К счастью, ей это не удалось. Все ее существо было посвящено злу...»~
@41087 = ~«Продолжай...»~
@41088 = ~«Мне нужна частичка тебя, Кесай».~
@41089 = ~«Все в порядке... тебе не нужно больше ничего говорить. Прощай, Кесай».~
@41090 = ~«Не знаю, мертва ли она... Но теперь я знаю, что она — моя мать, — плечи Кесай опустились, голова безвольно поникла. — Ах, если бы у меня были слезы, чтобы я смогла горько заплакать!»~
@41091 = ~Попробовать утешить ее.~
@41092 = ~Попробовать утешить ее.~
@41093 = ~Попробовать утешить ее.~
@41094 = ~«Мне нужна частичка тебя, Кесай».~
@41095 = ~«Я не стал бы об этом беспокоиться, Кесай; ты ничем не похожа на Равель. Прощай».~
@41096 = ~Она выглядит настороженной. «Пардон?»~
@41097 = ~«Ключ к порталу в лабиринт Равель — это часть ее самой, а в тебе течет ее кровь. Это достаточно близко».~
@41098 = ~«Неважно. Прощай».~
@41099 = ~«Просто... просто оставь меня. Со мной будет все хорошо. Мне нужно время, чтобы это обдумать, вот и все».~
@41100 = ~«Хорошо, но... Мне нужна частичка тебя».~
@41101 = ~«Я не стал бы об этом беспокоиться, Кесай; ты ничем не похожа на Равель. Прощай».~
@41102 = ~«Спасибо... спасибо за участие... со мной будет все хорошо. Мне нужно время, чтобы это обдумать, вот и все».~
@41103 = ~«Мне не хочется просить об этом... но мне нужна частичка тебя, Кесай».~
@41104 = ~«Я не стал бы об этом беспокоиться, Кесай; ты ничем не похожа на Равель. Прощай».~
@41105 = ~Она неожиданно падает тебе на руки, дрожа, словно ее разрывают рыдания. Некоторое время Кесай стоит, держась за тебя... но затем она отстраняется. «Спасибо, но... со мной будет все хорошо. Мне нужно время, чтобы это обдумать, вот и все».~
@41106 = ~«Мне не хочется просить об этом... но мне нужна частичка тебя, Кесай».~
@41107 = ~«Я не стал бы об этом беспокоиться, Кесай; ты ничем не похожа на Равель. Прощай».~
@41108 = ~У Кесай перехватывает дыхание. «Ты собираешься найти ее? — ее удивление быстро сменяется настороженностью. — Что... что тебе нужно от меня?»~
@41109 = ~«Скорее всего, твоя кровь. Одна-две капли, не больше».~
@41110 = ~Она кивает. «Но... у тебя есть что-нибудь, чтобы ее носить? Кусок ткани, носовой платок или что-то в этом роде?»~
@41111 = ~«Да... вот...»~
@41112 = ~«Нет, нету».~
@41113 = ~Кесай берет носовой платок и осторожно прокусывает клыком кончик своего пальца. Обронив несколько капель крови на ткань, она возвращает платок тебе. «Ты подвергаешь себя смертельной опасности. Даже если истории о матери сильно преувеличены, она все равно ужасно сильна и полна зла. Удачи».~
@41114 = ~«Да, это я уже слышал. Спасибо и прощай».~
@41115 = ~Кесай вздыхает, оглядываясь по сторонам. «Я уверена, что в Борделе что-нибудь найдется. Принеси его мне, как найдешь, хорошо? Тогда я дам тебе кровь».~
@41116 = ~«В таком случае, я вернусь, как найду носовой платок. Прощай».~
@41117 = ~Кесай-Серри, убрав волнистую прядь волос со своих ярких алых глаз, тепло улыбается тебе, когда ты появляешься рядом с ней. «Ну что же, и снова здравствуй... Я могу что-либо сделать для тебя, ммм?»~
@41118 = ~«Кесай? Ты дочь Равель?»~
@41119 = ~«Это зависит... а что ты можешь делать?»~
@41120 = ~«У меня есть несколько вопросов...» ~
@41121 = ~«Ничего, спасибо. Прощай».~
@41122 = ~Кесай-Серри, убрав волнистую прядь волос со своих ярких алых глаз, тепло улыбается тебе, когда ты появляешься рядом с ней. «Не беспокойся, я злюсь не долго. Я могу что-либо сделать для тебя, ммм?»~
@41123 = ~«Кесай? Ты дочь Равель?»~
@41124 = ~«Это зависит... а что ты можешь делать?»~
@41125 = ~«У меня есть несколько вопросов...» ~
@41126 = ~«Ничего, спасибо. Прощай».~
@41127 = ~Кесай-Серри, убрав волнистую прядь волос со своих ярких алых глаз, тепло улыбается тебе, когда ты появляешься рядом с ней. «Ну что же, и снова здравствуй... Я могу что-либо сделать для тебя, ммм?»~
@41128 = ~«Да... У меня есть носовой платок...»~
@41129 = ~«Это зависит... а что ты можешь делать?»~
@41130 = ~«У меня есть несколько вопросов...» ~
@41131 = ~«Ничего, спасибо. Прощай».~
@41132 = ~«А, это Экко. Она очень милая, но немногословная. Я знаю, что однажды она что-то сказала, из-за чего случилась страшная трагедия... из-за которой она больше не разговаривает, — Кесай, улыбаясь, пожимает плечами. — Довольно интересная история, но я не знаю, правда ли это. Попробуй спросить Долору... Я видела, как она разговаривала с бывшим любовником Экко, который знал ее, когда она еще разговаривала».~
@41133 = ~«У меня есть другой вопрос...»~
@41134 = ~«Это все, что я хотел узнать. Прощай».~
@41135 = ~«Все что угодно! — кричит Морт. — Ты можешь сделать со мной все что захочешь!»~
@41136 = ~«Я вот-вот разрыдаюсь... где же была эта крошка, когда у меня было *тело*?!»~
@41137 = ~«Пф-ф, — Анна усмехается, закатывая глаза. — Идиот».~
@41138 = ~Не обращать внимания на комментарий Анны.~
@41139 = ~«Не обращай на нее внимания, Кесай».~
@41140 = ~«Анна, пожалуйста... это всего лишь комплимент».~
@41141 = ~«Не злись, Анна... ты тоже очень красивая».~
@41142 = ~Анна холодно на тебя смотрит, но ничего не говорит.~
@41143 = ~«Ты на че намекаешь, ты, жалкий недоумок?! Думаешь, что я *ревную* к этой болтливой дуре? Ну ты и лох!» Анна сплевывает и отворачивается от тебя.~
@41144 = ~«Тсссс... Небольшой совет, шеф: с этого момента я бы вел себя потише. Не нужно больше вписывать трупы в книгу мертвых без необходимости... особенно женские. К тому же, их убийство может заинтересовать здешних смотрителей».~
@41145 = ~«Кажется, ты еще не говорил об этом... *кто* такие эти смотрители?»~
@41146 = ~«Эти трупы... откуда они все берутся?»~
@41147 = ~«Почему тебя так заботят женские тела?»~
@41148 = ~«Ладно... Я... попробую это запомнить».~
@41149 = ~«Они зовут себя 'тленными'. Ты их не пропустишь: они питают особую тягу к черному цвету и окоченевшему выражению лица. Они — всего лишь кучка свихнувшихся упырей, поклоняющихся смерти. Они верят в то, что все должны умереть... и лучше раньше, чем позже».~
@41150 = ~«Я запутался... какое тленным дело, если я сбегу?»~
@41151 = ~«Ты что, вообще ничего не слушал?! Я сказал, что трухлявые верят в то, что ВСЕ должны умереть, и лучше раньше, чем позже. Думаешь, что трупы, которых ты видел, счастливее в книге мертвых, чем вне ее?»~
@41152 = ~«Эти трупы, которых я видел здесь... откуда они все берутся?»~
@41153 = ~«До этого ты говорил, чтобы я не убивал *женские* трупы. Почему?»~
@41154 = ~«Ладно... Я... попробую это запомнить».~
@41155 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — все, что осталось от тех бедолаг, кто продал свои тела смотрителям».~
@41156 = ~«Просвяти меня... *кто* такие эти смотрители?»~
@41157 = ~«До этого ты говорил, чтобы я не убивал *женские* трупы. Почему?»~
@41158 = ~«Ладно... Я... попробую это запомнить».~
@41159 = ~«Чт... ты *серьезно*? Послушай, шеф, у этих мертвых крошек есть последняя возможность познакомиться с такими крутыми громилами как мы. Нам следует быть более *деликатными*... не ломать их ради ключей, не отрывать им конечности, ничего такого».~
@41160 = ~«Последняя возможность? Погоди... о *чем* это ты толкуешь?»~
@41161 = ~«Шеф, ОНИ мертвы, МЫ тоже мертвы... улавливаешь, куда я клоню? А? А?»~
@41162 = ~«Нет... не очень, если честно».~
@41163 = ~«Ты это *несерьезно*».~
@41164 = ~«Шеф, для нас до этих ковыляющих цыпочек — открытая дорога. Мы *все* мертвы, по крайней мере один раз: у нас есть общая тема для разговоров. Они предрасположены к мужчинам с нашим опытом смерти».~
@41165 = ~«Постой... разве ты не говорил до этого, что я *не мертвый*?»~
@41166 = ~«Ну... хорошо, *ты*, может быть, и не мертвый, а вот *я* — да. И как я уже говорил, я не против разделить гроб с какой-нибудь из здешних красивеньких жилистых покойниц». Морт начинает в предвкушении щелкать зубами. «Конечно же, у здешних смотрителей есть приоритет, так что им это навряд ли понравится...»~
@41167 = ~«Еще раз, кто эти смотрители?»~
@41168 = ~«Но откуда берутся все эти трупы?»~
@41169 = ~«Ладно... Я попробую это запомнить».~
@41170 = ~«Послушай, шеф. Очевидно, ты еще не отошел от свидания со смертью, поэтому у меня два небольших совета для тебя. Во-первых, если у тебя возникают вопросы, *спроси* меня, хорошо?»

^NПРИМЕЧАНИЕ: <SPEAKTO>^-~
@41171 = ~«Хорошо... если у меня возникнут вопросы, я спрошу у тебя».~
@41172 = ~«Во-вторых, если ты хоть *наполовину* забывчив от того, каким кажешься, то начни записывать свои мысли: как только ты встретишь то, что *может* быть важным, запиши это, чтобы не забыть».~
@41173 = ~«Если бы у меня был бы дневник, который *должен* был быть рядом со мной, я бы так и поступил».~
@41174 = ~«Тогда заведи себе новый, шеф. Без проблем. Вокруг для тебя полным-полно пергамента и чернил».~
@41175 = ~«Хм-м. Ну хорошо. Хуже от этого не будет... Заведу себе новый».~
@41176 = ~«Записывай в него каждый свой шаг. Если начнешь забывать важные вещи... например, кто ты... или, что еще важнее, кто *я*... то воспользуйся им, чтобы освежить свою память».

^NПРИМЕЧАНИЕ: Чтобы получить доступ к дневнику, выберите кнопку дневника из быстрого меню. Ваш дневник будет автоматически обновляться в течение всей игры.^-~
@41177 = ~«Ладно... Уяснил. Идем».~
@41178 = ~«Что гложет тебя, шеф?»~
@41179 = ~«Можешь еще раз прочитать, что у меня вытатуировано на спине?»~
@41180 = ~«Еще раз, что это за место?»~
@41181 = ~«Это место такое огромное... Кто за ним присматривает?»~
@41182 = ~«Еще раз, кто эти смотрители?»~
@41183 = ~«Эти трупы... откуда они все берутся?»~
@41184 = ~«До этого ты говорил, чтобы я не убивал *женские* трупы. Почему?»~
@41185 = ~«Как мне использовать эти бинты?»~
@41186 = ~«Пока ничего, Морт. Просто проверяю, что ты еще со мной».~
@41187 = ~«Пока ничего, Морт. Просто проверяю, что ты еще со мной».~
@41188 = ~«Эй, шеф, *да ладно* тебе. Только не говори, что ты опять все забыл».~
@41189 = ~«Мне просто нужно освежить свою память, вот и все».~
@41190 = ~«Ладно, неважно. У меня есть другие вопросы...»~
@41191 = ~«Ладно, забудь. Идем».~
@41192 = ~«Ладно, забудь. Идем».~
@41193 = ~«Готов поспорить, что услышу ЭТО много раз». Морт прочищает горло. «Посмотрим...

'Я знаю, что ты чувствуешь себя так, как будто ты выпил несколько бочонков помоев из Стикса, но тебе надо СОСРЕДОТОЧИТЬСЯ. Среди твоих вещей есть ДНЕВНИК, который прольет свет на это темное дело. ФАРОД сможет дополнить оставшуюся часть истории, если его уже не записали в книгу мертвых'.~
@41194 = ~«Фарод... хм-м. Продолжай».~
@41195 = ~«Неважно. У меня есть другие вопросы...»~
@41196 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41197 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41198 = ~«Сейчас, сейчас, погоди, — Морт на миг умолкает. — Хорошо, вот последний кусок...»

'Не потеряй дневник, иначе мы вновь окажемся в Стиксе. И что бы ты ни делал, НЕ ГОВОРИ никому КТО ты и ЧТО с тобой произошло, иначе тебя живо отправят в крематорий. Делай так, как я сказал: ПРОЧТИ дневник, а затем НАЙДИ Фарода'.~
@41199 = ~«Когда я очнулся, рядом со мной не было дневника?»~
@41200 = ~«Неважно. У меня есть другие вопросы...»~
@41201 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41202 = ~«Нет... тебя обобрали догола. Как я уже говорил, похоже, что достаточно того дневника, что выбит у тебя на теле».~
@41203 = ~«Забудь. Я уже достаточно наслушался. Идем».~
@41204 = ~«Ты уверен, что не знаешь никого по имени Фарод?»~
@41205 = ~«И то правда. У меня есть другие вопросы...»~
@41206 = ~«Ладно. Идем».~
@41207 = ~«Ладно. Идем».~
@41208 = ~«Неа. В общем, какой-нибудь пень да знает, как добраться до него. Надо поспрашивать в округе... ПОСЛЕ того, как мы выберемся отсюда».~
@41209 = ~«Перед тем как мы пойдем, у меня есть еще вопросы...»~
@41210 = ~«Ладно. Идем».~
@41211 = ~«Ладно. Идем».~
@41212 = ~«Оно называется 'Моргом'... это такое большое черное здание с чарующей архитектурой беременной паучихи».~
@41213 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41214 = ~«Это все, что я хотел узнать. Спасибо».~
@41215 = ~«Это все, что я хотел узнать. Спасибо».~
@41216 = ~«Они зовут себя 'тленными'. Ты их не пропустишь: они питают особую тягу к черному цвету и окоченевшему выражению лица. Они — всего лишь кучка свихнувшихся упырей, поклоняющихся смерти. Они верят в то, что все должны умереть... и лучше раньше, чем позже».~
@41217 = ~«Я запутался... какое тленным дело, если я сбегу?»~
@41218 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41219 = ~«Понятно. Тогда я буду осторожен».~
@41220 = ~«Понятно. Тогда я буду осторожен».~
@41221 = ~«Ты что, вообще ничего не слушал?! Я сказал, что трухлявые верят в то, что ВСЕ должны умереть, и лучше раньше, чем позже. Думаешь, что трупы, которых ты видел, счастливее в книге мертвых, чем вне ее?»~
@41222 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41223 = ~«Ладно... Я... попробую это запомнить».~
@41224 = ~«Ладно... Я... попробую это запомнить».~
@41225 = ~«Нууу... просто *используй* их. Останавливает кровотечение и все такое».

^NПРИМЕЧАНИЕ: <BANDAGES2>^-~
@41226 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41227 = ~«Спасибо. Думаю, я смогу с ними справиться».~
@41228 = ~«Спасибо. Думаю, я смогу с ними справиться».~
@41229 = ~«Смерть посещает планы каждый день, шеф. Эти увальни — все, что осталось от тех бедолаг, кто продал свои тела смотрителям».~
@41230 = ~«Ясно. У меня есть другие вопросы к тебе...»~
@41231 = ~«Ладно... Я... попробую это запомнить».~
@41232 = ~«Ладно... Я... попробую это запомнить».~
@41233 = ~«Чт... ты *серьезно*? Послушай, шеф, у этих мертвых крошек есть последняя возможность познакомиться с такими крутыми громилами как мы. Нам следует быть более *деликатными*... не ломать их ради ключей, не отрывать им конечности, ничего такого».~
@41234 = ~«Последняя возможность? Погоди... о *чем* это ты толкуешь?»~
@41235 = ~«Неважно. У меня к тебе еще вопросы...»~
@41236 = ~«Ладно... Я... попробую это запомнить».~
@41237 = ~«Шеф, ОНИ мертвы, МЫ тоже мертвы... улавливаешь, куда я клоню? А? А?»~
@41238 = ~«Нет... не очень, если честно».~
@41239 = ~«Ты это *несерьезно*».~
@41240 = ~«Неважно. У меня к тебе еще вопросы...»~
@41241 = ~«Я достаточно наслушался. Идем».~
@41242 = ~«Шеф, для нас до этих ковыляющих цыпочек — открытая дорога. Мы *все* мертвы, по крайней мере один раз: у нас есть общая тема для разговоров. Они предрасположены к мужчинам с нашим опытом смерти».~
@41243 = ~«Постой... разве ты не говорил до этого, что я *не мертвый*?»~
@41244 = ~«Неважно. У меня к тебе еще вопросы...»~
@41245 = ~«Я достаточно наслушался. Идем».~
@41246 = ~«Ну... хорошо, *ты*, может быть, и не мертвый, а вот *я* — да. И как я уже говорил, я не против разделить гроб с какой-нибудь из здешних красивеньких жилистых покойниц». Морт начинает в предвкушении щелкать зубами. «Конечно же, у здешних смотрителей есть приоритет, так что им это навряд ли понравится...»~
@41247 = ~«У меня есть другие вопросы к тебе, Морт...»~
@41248 = ~«Я достаточно наслушался. Идем».~
@41249 = ~«Димтри, ты меня слышишь?»~
@41250 = ~«Я знал, что ты вернешься, шеф! Все-таки понял, что я нужен тебе, а?»~
@41251 = ~«Да... идем».~
@41252 = ~«Не сейчас, Морт».~
@41253 = ~«Пф-ф. Ну хорошо, не знаю, как долго я смогу здесь быть, так что я даю тебе ПОСЛЕДНИЙ шанс. Ты уверен, что не хочешь моего мудрого совета и быстрой остроты?»~
@41254 = ~«Морт, у тебя НЕТ ни того, ни другого».~
@41255 = ~«Ладно. Я передумал. Давай, идем».~
@41256 = ~«Не сейчас, Морт. Может быть, потом».~
@41257 = ~«Ты пытаешься задеть мои чувства, шеф? Погоди, разве я что-то не так сказал? Или это из-за того, что у меня нет рук? Что?»~
@41258 = ~«Ладно. Я передумал. Давай, идем».~
@41259 = ~«Ничего такого. Просто сейчас я не нуждаюсь в твоей компании. Прощай, Морт».~
@41260 = ~«Ну хорошо, я не собираюсь ждать тебя ВЕЧНО, так что тебе лучше вернуться, как только ты передумаешь».~
@41261 = ~«Я так и сделаю. Прощай, Морт».~
@41262 = ~«Силы небесные. Это одна из этих ЧЕРТОВЫХ книг».~
@41263 = ~«Что такое?»~
@41264 = ~«Если я прав, то это та книга, куда они записывают имена всех несчастных бедолаг, которым не повезло оказаться здесь».~
@41265 = ~«А мое имя может быть там?»~
@41266 = ~«Э... ну... *Возможно*. Чтобы определить это, нужно потрясти черепушкой вон с тем парящим трухлявиком. Вот только я не уверен, что это хорошая идея».~
@41267 = ~«Мне нужны ответы. Я поговорю с ним».~
@41268 = ~«Сегодня ты немногословен, Димтри!»~
@41269 = ~«Этот гроб будет самым лучшим из тех, что мне доводилось собирать, верно, Димтри?»~
@41270 = ~«Димтри, ты самый лучший друг на свете».~
@41271 = ~Мудрость улучшена в качестве бонуса за специализацию.~
@41272 = ~Удача улучшена в качестве бонуса за специализацию.~
@41273 = ~Телосложение улучшено в качестве бонуса за специализацию.~
@41274 = ~Сила улучшена в качестве бонуса за специализацию.~
@41275 = ~Нет~
@41276 = ~Ловкость улучшена в качестве бонуса за специализацию.~
@41277 = ~<GAMEDAYS> дней и <HOUR> часов.~
@41278 = ~Время с группой:~
@41279 = ~Любимое заклинание:~
@41280 = ~Любимое оружие:~
@41281 = ~Число убитых:~
@41282 = ~Голос у женщины мягкий, спокойный, без всякой интонации; он звучит несколько «отдаленно», как будто не принадлежит ей. «Приветствую... Меня зовут Долора. Могу ли я быть чем-нибудь полезной?»~
@41283 = ~Она закрывает глаза, затем касается рукой своего сердца, слегка наклонив голову. «Если тебе будет угодно, я могу достаточно профессионально вести дискуссию на любую научную или академическую тему. Также я хорошо играю в различные стратегические игры — если ты хочешь играть. Только у меня здесь все необходимое лишь для нескольких игр».~
@41284 = ~Долора никак не реагирует — ни улыбкой, ни гневом, отвечая все тем же ровным голосом: «Тогда ты ошибся в предназначении этого заведения. Бордель утоляет страсти интеллектуального характера, а не физиологического. Да и к тому же, могу тебя заверить — мною партнер будет лишь разочарован».~
@41285 = ~«Просто такова моя сущность. Позволь мне продемонстрировать». Она пытается прикоснуться к твоей руке...~
@41286 = ~Долора проводит тыльной стороной ладони по твоей руке. Ее кожа гладкая и сухая, но холодная как сталь. От этого прикосновения по твоему телу пробегает дрожь, а волосы на руке становятся дыбом. «Не ломай голову над вопросом, кто или что я. Просто знай, что такова моя сущность».~
@41287 = ~Ты убираешь руку до того, как она тебя касается. «Так и быть. Я лишь хотела показать тебе, что я имела в виду. Я бы не причинила тебе вреда».~
@41288 = ~Долора кивает. «Да, это так. Но я не энциклопедия и не репетитор, я не собираюсь обучать своих клиентов. Однако, если у тебя есть тема для обсуждения... влияние пятнадцати фракций на политику Сигила, наиболее эффективная стратегия ведения битв в войнах Ахерона, смысл бытия... я буду рада выбрать противоположную точку зрения и столкнуться с тобой в дискуссии».~
@41289 = ~За несколько минут разговора Долора сокрушила каждый из твоих доводов с небрежной легкостью; ее контраргументы делают твои слабые попытки отстаивать свою позицию жалкими и глупыми. Похоже, победа не доставила ей большого удовольствия, тем не менее, она предлагает: «Если хочешь, мы можем подискутировать на эту тему еще раз... На этот раз, если пожелаешь, я могу защищать твою точку зрения».~
@41290 = ~Долора кивает. «Госпожа Грация распорядилась, чтобы я была беспощадной. Другая ее ученица после длительной дискуссии всегда позволяет клиенту побеждать. Это воля госпожи Грации — я обеспечиваю другой вид впечатлений для посетителей».~
@41291 = ~Ты прикладываешь все усилия, но этого недостаточно. Долора легко и непринужденно сокрушает каждый из твоих доводов своей железной логикой. Похоже, победа не доставила ей большого удовольствия, тем не менее, она предлагает: «Если хочешь, мы можем подискутировать на эту тему еще раз... На этот раз, если пожелаешь, я могу защищать твою точку зрения».~
@41292 = ~Ты выбираешь тему и начинаешь. Поначалу ты держишься неплохо... но со временем начинаешь сдавать свои позиции — Долора сокрушает твои доводы один за другим своей железной логикой. Похоже, победа не доставила ей большого удовольствия, тем не менее, она предлагает: «Если хочешь, мы можем подискутировать на эту тему еще раз... На этот раз, если пожелаешь, я могу защищать твою точку зрения».~
@41293 = ~Ты выбираешь тему и начинаешь... дискуссия все продолжается и продолжается, вы обмениваетесь доводами и контрдоводами, методично пытаясь выяснить друг у друга слабые стороны. Во время разговора у тебя появляется странное чувство... воспоминание, пытающееся всплыть в памяти...~
@41294 = ~Хотя Долоре и было невероятно сложно это сделать, она, наконец, побеждает тебя... ее железная логика в конечном счете сокрушает твои даже самые блестящие аргументы. Похоже, победа не доставила ей большого удовольствия, тем не менее, она одобрительно кивает. «Ты весьма красноречивый оратор, с этим не поспоришь. Думаю, если бы у тебя было немного времени на исследования, то я бы перед тобой не устояла».~
@41295 = ~Долора кивает. «Если хочешь, мы можем подискутировать на эту тему еще раз... На этот раз, если пожелаешь, я могу защищать твою точку зрения».~
@41296 = ~Ты выбираешь тему и начинаешь... дискуссия все продолжается и продолжается, вы обмениваетесь доводами и контрдоводами, методично пытаясь выяснить у друг друга слабые стороны. Хотя Долоре и было невероятно сложно это сделать, она, наконец, побеждает тебя... ее железная логика в конечном счете сокрушает твои даже самые блестящие аргументы. Похоже, победа не доставила ей большого удовольствия, тем не менее, она одобрительно кивает. «Ты весьма красноречивый оратор, с этим не поспоришь. Думаю, если бы у тебя было немного времени на исследования, то я бы перед тобой не устояла».~
@41297 = ~Ты выбираешь тему и начинаешь... дискуссия все продолжается и продолжается, вы обмениваетесь доводами и контрдоводами, методично пытаясь выяснить друг у друга слабые стороны. Во время разговора у тебя появляется странное чувство... воспоминание, пытающееся всплыть в памяти...~
@41298 = ~Жестко атакуя железную логику Долоры, ты, наконец, одерживаешь победу. Она одобрительно кивает. «Ты весьма красноречивый оратор, с этим не поспоришь. Думаю, если бы у меня было немного времени на исследования, ты бы передо мной не устоял».~
@41299 = ~Ты выбираешь тему и начинаешь... дискуссия все продолжается и продолжается, вы обмениваетесь доводами и контрдоводами, методично пытаясь выяснить у друг друга слабые стороны. Жестко атакуя железную логику Долоры, ты, наконец, одерживаешь победу. Она удовлетворенно кивает. «Ты весьма красноречивый оратор, с этим не поспоришь. Думаю, если бы у меня было немного времени на исследования, ты бы передо мной не устоял».~
@41300 = ~«Конечно. Ты хочешь сыграть в какую-то определенную игру?»~
@41301 = ~«Тогда вот... позволь мне показать одну игру». Долора достает тонкую лакированную коробочку, которая раскладывается в небольшую размеченную на клетки доску. В коробочке находится много отполированных каменных фишек... половина из них — черные, половина — белые. «У этой игры много названий. Объяснить тебе правила?»~
@41302 = ~Долора объясняет тебе правила игры — как ходить фишками, какие условия выигрыша. Эта игра кажется тебе чем-то неуловимо знакомой. «Правила просты, верно? Однако в самой игре таится большая сложность. Чтобы постичь ее, потребуется много времени. Сыграем?»~
@41303 = ~Несмотря на то, что ты определенно играл в эту игру раньше, твоя игра ужасна... Долора так быстро и легко побеждает тебя, что становится даже смешно. Тем не менее, она не улыбается и не торжествует, а просто начинает тихонько убирать игру. «Боюсь, сколько бы ты не практиковался, это мало чем тебе поможет — подобные игры тебе просто не по зубам».~
@41304 = ~Долора кивает. «Госпожа Грация распорядилась, чтобы я не поддавалась. Другая ее ученица играет так, что противнику в конце концов удается победить. Это воля госпожи Грации: я обеспечиваю другой вид впечатлений для посетителей — предоставить по-настоящему трудную задачу, вместо того чтобы тешить чье-то самомнение».~
@41305 = ~Несмотря на то, что ты определенно играл в эту игру раньше, Долора с легкостью с тобой расправляется. Тем не менее, она не улыбается и не торжествует, а просто начинает тихонько убирать игру. «Похоже, ты уяснил суть игры. Со временем ты сможешь стать достаточно умелым игроком».~
@41306 = ~За игрой ты понимаешь, что ты уже раньше в нее играл. Однако даже самые лучшие приемы не помогают против хорошо просчитанной стратегии Долоры... ты сдаешь позиции одну за другой, пока, наконец, не проигрываешь окончательно. Тем не менее, она не улыбается и не торжествует, а просто начинает тихонько убирать игру. «Похоже, ты хорошо уяснил суть игры. Со временем ты сможешь стать очень умелым игроком».~
@41307 = ~Убийств в группе:~
@41308 = ~Опыт в группе:~
@41309 = ~~
@41310 = ~За игрой ты понимаешь, что ты уже раньше в нее играл. Ты вспоминаешь несколько тактических уловок и стратегий, с помощью которых ты раньше побеждал, пытаешься использовать любую возможность победить ее. Неожиданно у тебя возникает странное чувство... воспоминание, пытающееся всплыть в памяти...~
@41311 = ~По ходу игры Долора нейтрализует твои даже самые искусные ходы. Несмотря на все твои усилия, ты сдаешься под натиском ее хорошо рассчитанной стратегии. Тем не менее, она не улыбается и не торжествует, а просто начинает тихонько убирать игру. «Ты отличный игрок. Со временем ты сможешь стать мастером этой игры».~
@41312 = ~За игрой ты понимаешь, что ты раньше уже в нее играл. Ты вспоминаешь несколько тактических уловок и стратегий, с помощью которых ты раньше побеждал, пытаешься использовать любую возможность победить ее. Однако Долора нейтрализует твои даже самые искусные ходы один за другим. Несмотря на все твои усилия, ты сдаешься под натиском ее хорошо рассчитанной стратегии. Тем не менее, она не улыбается и не торжествует, а просто начинает тихонько убирать игру. «Ты отличный игрок. Уверена, что со временем ты сможешь стать мастером этой игры».~
@41313 = ~За игрой ты понимаешь, что ты раньше уже в нее играл. Ты вспоминаешь несколько тактических уловок и стратегий, с помощью которых ты раньше побеждал, используешь любую возможность победить ее. Неожиданно у тебя возникает странное чувство... воспоминание, пытающееся всплыть в памяти...~
@41314 = ~Долора отлично играет, нейтрализуя твои даже самые искусные ходы, но в итоге твои отвлекающие атаки и просчитанные маневры сокрушают ее хорошо проработанную стратегию. Она одобрительно кивает и начинает убирать игру. «Ты отличный игрок, возможно, даже мастер. Я восхищаюсь твоим умением».~
@41315 = ~За игрой ты понимаешь, что ты раньше уже в нее играл. Ты вспоминаешь несколько тактических уловок и стратегий, с помощью которых ты раньше побеждал, используешь любую возможность победить ее. Долора отлично играет, нейтрализуя твои даже самые искусные ходы, но в итоге твои отвлекающие атаки и хорошо просчитанные маневры сокрушают ее хорошо проработанную стратегию. Она одобрительно кивает и начинает убирать игру. «Ты отличный игрок, возможно, даже мастер. Я восхищаюсь твоим умением».~
@41316 = ~Долора опускает взгляд на пол со звуком, который можно принять за несчастный вздох. «Я готова обслужить тебя как клиента, но в данный момент я бы не хотела отвечать ни на какие вопросы... прости, но боюсь, что тебе придется на какое-то время смириться с этим».~
@41317 = ~Оторвав взгляд от пола, она смотрит тебе в глаза. Тебя снова поражает бледность кожи и холод ее серебряных глаз. «Нет... нет, боюсь, что нет. Мои проблемы слишком личного характера. Наверное, со временем все разрешится благополучно».~
@41318 = ~«Уверена? — Долора умолкает, как бы задумавшись. — Нет. Весельчак, моя первая любовь, по-прежнему владеет ключами от моего сердца. Пока они у него, я не вольна полюбить другого. Вот в чем причина моей тоски».~
@41319 = ~Долора качает головой. «Я не могу уйти отсюда. Почему — это слишком личное, и я не собираюсь делиться этим с незнакомцем, хоть он и добр ко мне. Достаточно сказать, что я не могу сама искать Весельчака».~
@41320 = ~Долора кивает, на ее губах появляется малейший намек на улыбку. Она склоняет голову. «Я буду благодарна, если ты найдешь Весельчака и поговоришь с ним. Он — член Общества Восприятия, так что тебе стоит поспрашивать о нем в Городском Фестхолле».~
@41321 = ~«У меня есть немного драгоценностей, которые я получила в подарок. Этого должно быть достаточно для вознаграждения. Весельчак — член Общества Восприятия, поэтому тебе стоит поспрашивать о нем в Городском Фестхолле».~
@41322 = ~Холодные стальные глаза Долоры вспыхивают, когда она замечает твое приближение. «Приветствую. Чем я могу быть полезной тебе?»~
@41323 = ~Глаза Долоры вспыхивают, когда она замечает тебя. «Ты нашел его? Он согласился вернуть ключи к моему сердцу?»~
@41324 = ~Несколько секунда Долора молча смотрит на тебя. «Где же они?»~
@41325 = ~«Наконец-то...» Она берет у тебя ключи, ее рука касается твоей. Ее кожа суха и холодна на ощупь, словно холодный металл. «Это послужит мне хорошую службу. Спасибо тебе».~
@41326 = ~Долора кивает и вынимает пару браслетов из своей сумки на боку. «Теперь они твои. Ты заслужил их».~
@41327 = ~Глаза Долоры вспыхивают, когда она замечает тебя. «Ключи от моего сердца... ты нашел, где их потерял?»~
@41328 = ~«Конечно. Я отвечу на твои вопросы, если смогу».~
@41329 = ~Долора закрывает глаза. «Весельчак никогда не рассказывал мне много о моей конструкции. Я мало знаю о внутреннем устройстве моего тела, так же как и ты — о своем. Внешне я женщина во всех аспектах... не считая фактуры и температуры тела. Твое любопытство удовлетворено?»~
@41330 = ~«Как он действует — для меня загадка, так же как и разум любого человека. Когда я впервые пришла сюда, я не понимала эмоций, да и сама их не имела. Но теперь у меня есть... чувства... хотя я только начинаю их понимать».~
@41331 = ~«Я могу лишь предполагать, что Весельчак сделал их, чтобы не было риска того, что я уйду от него до того, как он потеряет интерес к своему эксперименту. Но теперь, когда ключи у меня, я вольна создавать и обладать собственными эмоциями».~
@41332 = ~«Я, как любая другая женщина здесь, являюсь ученицей госпожи Грации. Она обучает нас различным способам общения и вербального связи. Большинство учениц хотят стать членами Общества Восприятия, и здесь, под надзором госпожи, проходят обучение для подготовки к последнему обряду посвящения фракции».~
@41333 = ~«Я многое узнала. И да, это доставляет мне удовольствие». Она некоторое время улыбается; эта эмоция выглядит неуклюже на ее бледном лице, словно она никогда этого не делала.~
@41334 = ~«Тебе стоит поискать ответы на подобные вопросы у госпожи Грации. Она ответит на них гораздо лучше, чем я».~
@41335 = ~«Да, могу. Бордель утоления интеллектуальной страсти — это школа; его проститутки обучаются различным способам общения и вербального связи. Если тебе необходимо более развернутое пояснение, рекомендую поговорить с владелицей этого заведения, госпожой Грацией».~
@41336 = ~«Наверное, ты имеешь в виду ее личный аромат, который, по ее словам, украла одна из здешних проституток. Не знаю, у кого он сейчас. Однако, ты можешь расспросить Ненни — она подмечает многое из того, что здесь происходит».~
@41337 = ~«Вивьен использует определенную сторону Искусства для создания, изменения и улучшения обонятельных свойств объектов, живых или мертвых. Возможно, вор тоже владеет одним из этих навыков. Однако ее аромат мог остаться на одном из предметов, а не на воре — иначе бы Вивьен сразу же узнала по запаху, кто вор».~
@41338 = ~Долора качает головой. «Я не видела вуаль Мариссы с тех пор, как она в последний раз надела ее вне своих покоев. Это было достаточно давно, — она на миг закрывает глаза, затем продолжает. — Ненни знает многое из того, что здесь происходит. Спроси ее об этом — возможно, она что-нибудь видела».~
@41339 = ~«Я знаю, что она была — или является, если она еще в числе живых — ночной ведьмой, невероятно сильной и злой. Леди Боли отправила ее во внепространственную темницу за преступления против Сигила. Тебе следует поговорить о ней с Ив. Она знает огромное количество историй, и, скорее всего, расскажет тебе о Равель».~
@41340 = ~В памяти всплывает огромный зал... просторное место, заполненное хорошо одетой знатью... какой-то званый вечер. Перед тобой стоит какой-то невысокий, безупречно одетый мужчина, на котором висит золотой медальон. Медальон украшен символом, в котором ты смутно узнаешь «Знак Единого». Вы оба стоите в кругу, образованном слушающими вашу дискуссию зрителями.~
@41341 = ~«Но... но это же невозможно!» — ошеломленно произносит мужчина.

«Но это так, — ты слышишь собственный голос. — Я привел несколько неоспоримых доводов и множество примеров. Ты просто не существуешь».

«Но... это не так! Если я приму это, то я... я...»~
@41342 = ~«Да. Ты прекратишь существовать».

И тут мужчина попросту исчезает — без каких-либо вспышек, клубов дыма или фанфар.~
@41343 = ~Зрители охают и ахают, кто-то аплодирует... Ты делаешь энергичный поклон и с легкой и довольной улыбкой уходишь прочь.

Внезапно ты осознаешь, что Долора внимательно смотрит на тебя. «С тобой все в порядке? Может быть, закончим дискуссию в другой раз?..»~
@41344 = ~Воспоминание затянутого дымом поля битвы заполняет твой разум... ты сидишь на огромном четырехногом животном на вершине холма. Рев горнов разносит твои приказы солдатам внизу.~
@41345 = ~Ты видишь, как твои силы разделяются надвое, солдаты разбегаются вправо и влево от вражеской армии, пробивающейся наверх к холму, чтобы сокрушить вражеского командира — тебя.~
@41346 = ~«Глупцы, — думаешь ты с кривой усмешкой. — Мои всадники нападут с холма и моментально остановят их продвижение... А в это время мои «отступающие» пехотинцы нападут на них с флангов! Еще одна победа будет моей...»

Неожиданно ты осознаешь, что Долора внимательно смотрит на тебя. «С тобой все в порядке? Если хочешь, мы можем завершить игру в другой раз...»~
@41347 = ~Она качает головой. «Боюсь, ты ошибаешься. Десятой ученицы нет, если только это не новое поступление».~
@41348 = ~Лицо Долоры озаряется, когда она видит тебе. «И снова здравствуй. Чем я могу быть полезной тебе?»~
@41349 = ~«Я тоже слышала похожий слух, но ничего об этом не знаю. Может быть, другая девушка сможет дать ответ, или сама Кесай. Спроси Джульетту... они с Кесай были близкими подругами, пока Джульетта не повстречала Монтекки».~
@41350 = ~«Да. Ее зовут Экко. Ее голос — и вообще все ее средства общения — были украдены и уничтожены. Однажды Экко своими речами соблазнила любовника богини Парамиши. Парамиша в ревностном гневе выкрала голос Экко, заключила его в хрустальный сосуд и бросила в пасть мегогаламдраги. Для Экко голос потерян навсегда. Только другой, новый голос сможет вернуть ей способность общаться. Я знаю это, потому что однажды сама разговаривала с тем любовником Парамиши».~
@41351 = ~Вы заканчиваете игру с тем же результатом.

«Очень увлекательная игра. Еще раз?»~
@41352 = ~Оставить ее в покое.~
@41353 = ~«Чем ты можешь быть мне полезной, Долора?»~
@41354 = ~«Ничем, но у меня есть несколько вопросов...»~
@41355 = ~«Нет, я просто хотел повидаться с тобой. Прощай».~
@41356 = ~«Я надеялся на что-то более «телесное»...»~
