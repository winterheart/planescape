@34914 = ~*Фыркает*~
@34915 = ~::Хихикает::~
@34916 = ~«За-а-абы-ы-ы-ыла сво-о-ое имя-я-я...»~
@34917 = ~«Сво-о-ое имя-я-я?..»~
@34918 = ~::Стонет::~
@34919 = ~«Жду не дождусь».~
@34920 = ~Этот труп бродит по треугольной траектории. Достигнув одного из углов треугольника, он замирает, затем поворачивается и ковыляет к следующему углу. На боку его черепа вытатуирован номер «965». При твоем приближении он останавливается и пялится на тебя.~
@34921 = ~~
@34922 = ~Этот труп бродит по треугольной траектории. Достигнув одного из углов треугольника, он замирает, затем поворачивается и ковыляет к следующему углу. На боку его черепа вытатуирован номер «965». При твоем приближении он останавливается и пялится на тебя.~
@34923 = ~«Итак... почему ты ходишь вдоль треугольника?»~
@34924 = ~~
@34925 = ~~
@34926 = ~~
@34927 = ~Труп уставился на тебя невидящим взглядом.~
@34928 = ~Оставить труп в покое.~
@34929 = ~~
@34930 = ~~
@34931 = ~Этот труп ходит от плиты к плите, перевязывая лежащих на них мертвецов. На левом виске у него выбит номер «396»; его губы крепко зашиты. Ты замечаешь, что труп несет в руках несколько бинтов... похоже, они могут пригодиться.~
@34932 = ~«Ты не против, если я одолжу у тебя эти бинты?»~
@34933 = ~Труп продолжает пялиться на тебя.~
@34934 = ~Попробовать забрать бинты у зомби.~
@34935 = ~«Ты не против, если я одолжу у тебя эти бинты?»~
@34936 = ~Попробовать забрать бинты у зомби.~
@34937 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@34938 = ~Труп не шевелится. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@34939 = ~Оставить труп в покое.~
@34940 = ~Использовать на трупе свою способность «История костей».~
@34941 = ~«Было приятно с тобой поболтать. Прощай».~
@34942 = ~Голова трупа была отрублена, а после наспех пришита назад. Несколько различных швов, все в разной степени потрепанности, указывают на то, голова в процессе работы постоянно отваливалась и возвращалась на место. На виске вырезан номер «79», рядом с неровным зубчатым кругом, выжженным на лбу.~
@34943 = ~«Итак... что тут у нас интересного?»~
@34944 = ~Труп продолжает пялиться на тебя.~
@34945 = ~Оставить труп в покое.~
@34946 = ~Осмотреть зубчатый круг.~
@34947 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@34948 = ~Использовать на трупе свою способность «История костей».~
@34949 = ~Труп не реагирует. Кажется, он слишком далек от того, чтобы отвечать на твои вопросы.~
@34950 = ~Оставить труп в покое.~
@34951 = ~«Было приятно с тобой поболтать. Прощай».~
@34952 = ~Оставить труп в покое.~
@34953 = ~На лбу этого трупа чернилами написан номер «1201», чернила стекли на глаза, щеки и челюсти. Чернильные капли падают с лица, ты замечаешь, что они попадают в зашитый рот, из которого торчит уголок какой-то записки.~
@34954 = ~Попробовать вытащить записку.~
@34955 = ~Записка во рту зомби заляпана гноем. Если ты попытаешься вытащить бумагу сквозь стежки, она порвется на части. Попытка вскрыть зомби уничтожит записку — тебе нужно найти деликатный способ удалить швы перед тем, как достать записку.~
@34956 = ~Срезать швы скальпелем.~
@34957 = ~«Знаешь, мне известно, что ты не зомби. Тебе никого не одурачить».~
@34958 = ~Использовать на трупе свою способность «История костей».~
@34959 = ~«Было приятно поболтать с тобой. Прощай».~
@34960 = ~Ты ловко перерезаешь швы на рту зомби, и его челюсти раскрываются. Ты осторожно вынимаешь записку изо рта трупа... несмотря на состояние бумаги, записи все еще можно разобрать.

^NПРИМЕЧАНИЕ: <READSTUFF>^-~
@34961 = ~Снова осмотреть труп. ~
@34962 = ~Оставить труп в покое.~
