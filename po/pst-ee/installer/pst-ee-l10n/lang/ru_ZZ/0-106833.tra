@2760 = ~Не обращать внимания на инцидент и уйти.~
@2761 = ~Схватить его за руку.~
@2762 = ~Схватить его за руку.~
@2763 = ~This is Node 4. You must have had Morte.~
@2764 = ~TEST Computer~
@2765 = ~TEST P133~
@2766 = ~TEST Win98~
@2767 = ~TEST Win95 1.5~
@2768 = ~TEST Newest OS~
@2769 = ~TEST just a bug fix~
@2770 = ~Привет ТЕСТ, большой мальчик...~
@2771 = ~Слабая варгулья~
@2772 = ~Гронк~
@2773 = ~Удар Гронка~
@2774 = ~Удар Гронка~
@2775 = ~Укус варгульи~
@2776 = ~Укус варгульи~
@2777 = ~«Эй! Ты что творишь?!»~
@2778 = ~Атаковать его.~
@2779 = ~Не обращать внимания на инцидент и уйти.~
@2780 = ~«*После* того, как ты ответишь на несколько вопросов, 'тленный'».~
@2781 = ~Существо поворачивается к тебе, и над его головой появляется несколько символов. Они окружены слабым сиянием и... парят в воздухе.~
@2782 = ~«Ох, силы небесные! Чертов дабус».~
@2783 = ~«Что не так?»~
@2784 = ~«Понятно».~
@2785 = ~Роб хочет проверить команды склада для проверки интерфейса.~
@2786 = ~«О, правда? Ради сексапильного Роба Холлуэя я сделаю что угодно. Какой вид склада ты хочешь увидеть?»~
@2787 = ~«Покажи мне, пожалуйста, 'Store1'».~
@2788 = ~«Он — дабус. Они 'разговаривают' ребусами, этими тупыми словесными головоломками. Если *ты* не знаешь, что он говорит, то тогда нам лучше поискать кого-нибудь из местных или какой-нибудь другой способ общаться с ними... если нам это надо. Чертово племя. Знаешь что? Да они *умеют* разговаривать, просто они хотят вывести из себя того, кто пытается разгадать их головоломки».~
@2789 = ~«Говорят, что они слуги Леди Боли. Они парят повсюду и ломают, чинят и латают Сигил по ее капризу. Они хуже трупных мух, — Морт вздыхает. — Не нужно их трогать, а не то Леди... рассердится».~
@2790 = ~«Покажи мне, пожалуйста, 'Inn1'».~
@2791 = ~«Что за 'дабус'?»~
@2792 = ~Даже издалека ты слышишь запах дерьма и тухлого мяса, исходящую от этого человека. Хотя он явно слаб и немощен, длинные тонкие пальцы и впалые глаза придают ему зловещий вид, когда он рыскает по мусору вокруг себя. То, как он пускает слюни и вращает глазами, наталкивает тебя на мысль, что он безумен.~
@2793 = ~Он пытается сосредоточиться на тебе, но его взгляд блуждает. Его глаза глубоко посажены в запавших глазницах, а кожа ужасно бледна и поражена какой-то хворью: она покрыта сыпью и желтоватыми лоскутами, которые, судя по их виду, готовы отвалиться в любой момент. Исходящее от него зловоние ужасно. Как только ты раскрываешь рот, чтобы заговорить, он облизывает губы и сглатывает. «Ты миррр-твяк?»~
@2794 = ~Криворотый пока не может с тобой разговаривать. Уже имени достаточно, чтобы понять, почему.~
@2795 = ~Ну и ладно. Все равно.~
@2796 = ~Вираго пока не может разговаривать. Скорее всего, она будет представлена в заскриптованной сценке.~
@2797 = ~Ладно, ладно! Уф.~
@2798 = ~Модрон-бродяга~
@2799 = ~Скелет-торговец~
@2800 = ~Мертвое Тело~
@2801 = ~Мар~
@2802 = ~По сравнению с другими, на вид этот мужчина не так угрюм и насторожен по отношению к прохожим. Он весело шагает, время от времени осматривая землю с обеих сторон. Когда ты подходишь, он приветливо кивает тебе.~
@2803 = ~«Здорово, рубака! Слушай... не видал жмуриков поблизости?»~
@2804 = ~Сборщик~
@2805 = ~Могильник~
@2806 = ~Сборщик-разбойник~
@2807 = ~Криворотый~
@2808 = ~Вираго~
@2809 = ~Желтопалый~
@2810 = ~Подойдя к мужчине в коричневом балахоне с капюшоном, ты замечаешь, что он что-то тихо себе бормочет и время от времени кивает.~
@2811 = ~Ну, спасибо за предупреждение.~
@2812 = ~Она пожимает плечами. «Я — предводительница Бритвенных Ангелов. Это то, что тебе действительно следует знать. Я создала их, они выполняют мои приказы. Итак, что тебе надо от меня?»~
@2813 = ~«Мы пришли сюда, когда крупные банды захватили Мусорные районы неподалеку от площади Старьевщиков. Мы оказались здесь почти в то же время, что и Заточки с Темного переулка, у которых берлога на другой стороне. Они — кучка беспринципных разбойников, — здесь она делает паузу. — Мы тоже разбойники, но мы не убиваем, если можем обойтись без этого. Нам просто нужно на что-то жить, и, принимая во внимание наше положение, взимание пошлины — лучший способ для этого».~
@2814 = ~«Как-то раз одному полоумному заклинателю взбрело в голову, что это местечко будет выглядеть гораздо лучше сгоревшим дотла. И это распахнуло сюда двери для всех преступников и бандитов».~
@2815 = ~Она сплевывает. «Червеволосый? Его можно найти на площади Старьевщиков. Поспрашивай тамошних. Точно привлечешь к себе чье-то внимание».~
@2816 = ~{Уйти}~
@2817 = ~«Дневник? Книжка? Здесь? В переулке? Ха! Извини — все горящие предметы здесь идут на растопку костров для еды».~
@2818 = ~«Перед тем, как ты уйдешь, я бы хотела попросить тебя об одолжении. Этот кусок улицы слишком мал для нас и Заточек с Темного переулка. У нас есть милосердие. У них — ненависть. Убей их главаря, Гнилого Уильяма, и ты сможешь свободно ходить по переулку до конца своей жизни. Ты часто будешь здесь ходить, и это сэкономит тебе кучу звенелок».~
@2819 = ~«Отнюдь. Просто у нас нет ничего лучшего. Мы ведь обитатели Улья. Даже со своим скудным образованием я не могу выбраться отсюда. Жители Улья никому не нужны, так что мы просто делаем так, чтобы о нас не забыли вообще».~
@2820 = ~«Ага. Но я полагаю, что если мы закрепимся в переулке и избавимся от Заточек, то мы обеспечим себя на некоторое время».~
@2821 = ~«Я верю в твой успех. Возвращайся, когда закончишь, хорошо? Удачи».~
@2822 = ~«Может и нет. Решай — убить бешеную собаку и ее свору или всегда платить при переходе через переулок. Выбор за тобой».~
@2823 = ~Этот человек двигается с пугающей скоростью, и кажется, будто он здесь лишь наполовину. В его расплывчатом образе выделяются горящие глаза, их безумие пронзает твое сердце. «Ты». Его голос обдает ледяным порывом. «Объяви свои убеждения. Ты сторонник добра или зла?»~
@2824 = ~Перед тобой крепкий жилистый мужчина. Его самоуверенное лицо с острыми чертами имеет немного рассеянный вид. Взгляд у него ясный и суровый. Он вял, и в то же время всегда готов к действиям; в своих мозолистых руках он держит нож. «Итак. Еще один посетитель к Гнилому Уильяму. Выкладывай, что у тебя на уме, путник. Излагай ясно, и, быть может, мы тебя отпустим».~
@2825 = ~«Эй, путник! Теперь ты на территории Бритвенных Ангелов... поговори с Кристалл, нашим главарем. У нее найдется что тебе сказать».~
@2826 = ~«О, Бездна, ты кто такой? Иди поговори с Гнилым Уильямом — если ему не понравятся твои ответы, он тебя прирежет. Если не поговоришь с ним, тебя прирежем мы. А теперь двигай!»~
@2827 = ~Я Охо. Я умственно-отсталый, болтающий с черепными крысками в стене. У меня пока нет всего диалога.~
@2828 = ~Я Охо. Я умственно-отсталый из Погребенной деревни, болтающий с черепными крысками в стене. Мой диалог еще не готов.~
@2829 = ~«Много волос. Зубы. Все друзья укусить. Некоторые стать еда. Некоторые стать волосатые. Они покинуть Охо».~
@2830 = ~«Что здесь произошло?»~
@2831 = ~Ты видишь глупую на вид женщину, облаченную в тяжелое платье из мешковины. Она ковыляет по комнате, ее суставы трещат, когда она нагибается, чтобы взять вещи с одного из столов. Ее волосы собраны на затылке костяной шпилькой; у нее кислое болезненное выражение лица. Она что-то мурлычет себе нараспев.~
@2832 = ~Ты видишь Марту. Она ковыляет по комнате, ее суставы трещат, когда она нагибается, чтобы взять вещи с одного из столов. Она что-то мурлычет себе нараспев.~
@2833 = ~«Хе. Еще раз спасибо. Чего ты хочешь?»~
@2834 = ~«Я хочу поторговать».~
@2835 = ~Стражник смотрит на тебя со смешанным чувством страха и ненависти, однако все же торопиться открыть ворота. Когда ты проходишь мимо, он отводит от тебя глаза.~
@2836 = ~«Доброго утречка, старина!»~
@2837 = ~(Простой сборщик-разбойник еще не готов.)~
@2838 = ~Ну хорошо. Я вернусь, когда тебе будет что мне сказать... или что-нибудь отдать.~
@2839 = ~Мы — братки, стоим, охраняем ворота в Мусорные районы и Погребенную деревню. Чтоб пройти, тебе придется либо кинуть нас, либо отдубасить.~
@2840 = ~Звучит захватывающе. Жду не дождусь, когда ДИЗАЙНЕР это ЗАКОНЧИТ. Хорошего ДНЯ, сэры.~
@2841 = ~Перед тобой пожилой человек, тяжело припавший на костыль; его левая нога вывернута так, будто он пытался идти в двух направлениях одновременно, и поплатился за это. Его серая кожа тяжело свисает с его черепа, и покрыта старческими пятнами. Он что-то бормочет и причмокивает, обводя взглядом помещение.~
@2842 = ~Ты видишь Фарода. Он обводит взглядом помещение, бормоча что-то себе под нос и причмокивая. Его бледная кожа выделяется даже в неверном свете факелов.~
@2843 = ~«О, трупик... — Фарод поворачивается, когда ты подходишь, его костыль клацает по плитам двора. — Здравствуй-здравствуй...»~
@2844 = ~Я Даккон, гитцерай. Один из членов отряда. Пока мне нечего сказать. Но вы можете заценить мою крутую анимацию боя. Жаль, что у убитых мной монстров пока еще нет анимации смерти, как в фильмах про самураев...
Даккон: «Поглядите мой меч: корошикару!»
Бандит из Улья: «А-а-а... мунен нари-и-и...» *Ш-ш-ш-ш* <--- бьет *фонтан* артериальной крови
Даккон: «Хм». *дзинь* <-- меч *карач* прячется в ножны
(Вишневые потоки льются сверху экрана)~
@2845 = ~Позже, Даккон. Жду не дождусь, когда ты присоединишься к отряду.~
@2846 = ~Это потрескивающее и пышущее жаром существо медленно корчится над железной решеткой на полу бара. Должно быть, когда-то это был человек, но теперь его кожа обуглена до неузнаваемости. Потоки огня образуют кольцо вокруг его тела, языки пламени лижут остатки плоти, отчего те пузырятся и стекают как воск по скелету существа.~
@2847 = ~Существо не реагирует. Оно медленно корчится в пламени: оно живое, но, похоже, *не замечает* ничего, кроме окружающего его пламени. Его кожа — огонь, его сердце — пламя. Из какого-то темного уголка твоей памяти к тебе приходит осознание того, что это создание *опасно*.~
@2848 = ~Вейлор безмолвен и неподвижен. Если бы не мерцающие красные огоньки в глазах, он был бы похож на статую.~
@2849 = ~«Я зайду позже, когда этим гигантским доспехам будет что сказать».~
@2850 = ~«Привет. Я — местная пуританка-суккуб. Также я могу стать твоей спутницей... ЕСЛИ ты поимеешь меня».~
@2851 = ~«О, я обязательно ПОИМЕЮ тебя. Ха-ха. До встречи, танарри».~
@2852 = ~Перед тобой куб с четырьмя руками и двумя ногами. Несмотря на то, что с виду он явно механический, на передней грани у него странное органическое зеленое лицо с двумя большими овальными глазами. Кажется, куб не замечает тебя; он самозабвенно смотрит на два арбалета, прикрепленных к рукам. С верхнего левого угла свисает многогранная линза. Похоже, что она предназначена для того, чтобы опускаться к глазу куба, подобно оптическому прицелу.~
@2853 = ~«Э... Приветствую?..»~
@2854 = ~Аэтелгрин~
@2855 = ~Барр~
@2856 = ~Квинт~
@2857 = ~Охо~
@2858 = ~Житель Нижнего района~
@2859 = ~Торговец~
@2860 = ~Торгаш~
@2861 = ~Житель деревни~
@2862 = ~«Попробуй».~
@2863 = ~Илквикс~
@2864 = ~Гилтспур~
@2865 = ~Хамрис~
@2866 = ~Анаци~
@2867 = ~Лазло~
@2868 = ~Уголек-да-Пепел~
@2869 = ~Сборщик-разбойник~
@2870 = ~Житель Нижнего района~
@2871 = ~Нарушитель Пенн~
@2872 = ~Марта~
@2873 = ~Этот старик немного смахивает на ученого. Его одежда невероятно чиста, опрятна и ухожена. Он часто останавливается, чтобы смахнуть или сдуть с себя пыль. На его тунике вышит символ, изображающий стилизованный кинжал, пронзающий пламя.~
@2874 = ~«Приветствую...»~
@2875 = ~Запах разложения, исходящий от этой древней с виду упырихи, вызывает тошноту даже на расстоянии. Ее серо-зеленая кожа поражена могильным гниением и гноящимися язвами, а ее пальцы с длинными загнутыми когтями покрыты засохшей кровью и грязью. В ее волосах, свисающих до колен, полно копошащихся насекомых и червей. Они почти полностью скрывают ее лицо, оставляя только дикий клыкастый оскал и свисающий серый язык.~
@2876 = ~«Приветствую...»~
@2877 = ~Я УЛИЦА ПРОТЯЖНЫХ ВЗДОХОВ. Я ГОВОРЮ ПРОПИСНЫМИ БУКВАМИ, ВЕДЬ Я ТАКАЯ БОООЛЬШАЯ.~
@2878 = ~Спасибо за участие. Я вернусь, когда ты закончишь.~
@2879 = ~Ты пытаешься обыскать шкаф, но тут его ручки выскакивают из твоих рук и ящики сами по себе захлопываются. Из шкафа доносится презрительное *пф!*...~
@2880 = ~«Привет?»~
@2881 = ~Когда ты обращаешься к трупу Берта, он начинает дергаться. «Чего... чего ты хочешь?»~
@2882 = ~«Хотел задать тебе пару вопросов...»~
@2883 = ~Изувеченный труп Лаудена при твоем приближении начинает тяжело двигаться. «Чего ты хочешь, а?»~
@2884 = ~«Просто ответь на несколько вопросов, Лауден».~
@2885 = ~Я торговец. Я не уверен, ГДЕ я буду в игре, но уверен, что скоро выясню.~
@2886 = ~Не могу дождаться, чтобы увидеть твои товары. Пока.~
@2887 = ~Когда ты подходишь, этот добродушный пожилой мужчина оборачивается и вежливо кивает. «Приветствую... могу ли я чем-то помочь?»~
@2888 = ~«Да, у меня есть несколько вопросов...»~
@2889 = ~Эта суровая пожилая женщина явно куда-то спешит. Заметив твое приближение, она неодобрительно тебя разглядывает, хмуро поджав губы.~
@2890 = ~Не раньше, чем ты покажешь свои буфера, лапочка.~
@2891 = ~Я толстый пыхтящий карманник из района аристократов. Скорее всего, ты уже встречал других моих товарищей в районе низшего сословия.~
@2892 = ~Да, точно. Наверно, прямо сейчас пойду их искать. Прощай.~
@2893 = ~Этот гигант носит такие же гигантские, богато украшенные красные доспехи. Когда ты подходишь к нему, он рассматривает тебя, внимательно, но без страха.~
@2894 = ~Из его шлема эхом раздается зычный бас: «Приветствую, гражданин. Я Само-Собой... телохранитель Усердной, Четвертого судьи района. Тебе придется извинить меня, но мой долг — быть рядом с ней. Прощай».~
@2895 = ~«Приветствую...»~
@2896 = ~Оставить мужчину в покое.~
@2897 = ~«У меня есть несколько вопросов...» ~
@2898 = ~«Что-то не так с моим внешним видом?»~
@2899 = ~Я злой, погрязший в клише босс конструктов, который правит кубом модронов. Поклонись передо мной и плачь, плоть.~
@2900 = ~Поклонись мне, злой дрон. Хорошего дня... и счастливо оставаться.~
@2901 = ~Я особо опасный механический конструкт, сделанный из самого лабиринта модронов для того, чтобы встретить незваных гостей. Не уверен, будет ли у меня диалог, но если что — это его начало.~
@2902 = ~Ну, рад был с тобой поболтать. Уверен, у тебя все сложится... э, то есть, как только дизайнер тебя закончит. ~
@2903 = ~Я один из низкоуровневых механических конструктов, что наполняют Лабиринт модронов. В мои обязанности входит проверка на храбрость всех вошедших в лабиринт незваных гостей. Ты чувствуешь, что готов сразиться со мной?~
@2904 = ~Пока нет, но уверен, что почувствую. Прощай.~
@2905 = ~Я один из конструктов среднего уровня опасности из лабиринта модронов. Я еще даже не знаю, буду ли я существовать. Возможно, я не более чем диалог, и большим я не стану.~
@2906 = ~На такой исход я мог лишь надеяться. Счастливо.~
@2907 = ~Ты видишь высокого стройного мужчину со стеклянным взглядом. Кажется, он поглощен каким-то рассказом владельца лавки. Он временами кивает, но сам ничего не говорит.~
@2908 = ~«Приветствую».~
@2909 = ~Девушка кивает и слегка улыбается. Твои ноздри наполняет восхитительный запах ее волос.~
@2910 = ~Она кивает.~
@2911 = ~Человек смотрит в твоем направлении. Его глаза — темные щелочки, похожие на узкие порезы под бровями. Голос у него низкий и хриплый, вопреки его худощавому телосложению. «Отвали».~
@2912 = ~«В твоем случае за твою просьбу Лотар запросит всего один череп из катакомб внизу. Там, за Затопленными Народами, есть закрытая гробница, куда моим слугам так и не удалось проникнуть. Принеси мне череп того, кто покоится в ней, и я отвечу на все твои вопросы. На ВСЕ, на которые смогу. Ты ДОБУДЕШЬ этот череп».~
@2913 = ~«Благодаря тебе, для меня все кончено! Они буду приходить снова и снова... о, я нашлю на вас мучения... ой... прости. Я сказал, не подумав».~
@2914 = ~«Хорошо. Мне нужно кое-что из твоих припасов. Что у тебя есть?»~
@2915 = ~Я гитьянки, который пытается завести игрока в западню.~
@2916 = ~Отлично, тогда я буду держаться от тебя подальше. Прощай.~
@2917 = ~У этого мужчины бледно-желтая кожа и остроконечные уши. Его глаза — словно черные камушки. Он носит гибкую кольчугу, покрытую изысканной эмалью. Когда ты подходишь, он смотрит на тебя с подозрением, положив руку на эфес своего меча. Он молчит.~
@2918 = ~«Приветствую, звенящий мечом».~
@2919 = ~Этот умелый воин-гитцерай внимательно следит за твоим приближением. Когда ты подходишь ближе, он внезапно обнажает меч и бросается в атаку!~
@2920 = ~Звучит неплохо, но Даккон, кажется, еще даже не реализован. Пока.~
@2921 = ~Глаза этой суровой гитцерайки полны ненависти. «*Знай*, что ты забрал у меня родных. *Знай*, что ты об этом *пожалеешь*». Ее руки начинают плести в воздухе светящийся узор.~
@2922 = ~«О чем это ты?»~
@2923 = ~Этот невысокий крепкий мужчина средних лет носит одежду, которая, казалось бы, выткана из сверкающего золота. В своей руке он держит кусок ткани, туго натянутый на деревянную раму; в данный момент он вышивает на ткани какой-то узор.~
@2924 = ~«Приветствую...»~
@2925 = ~Это труп мужчины с удивленным выражением на лице с крючковатым носом. Сложно сказать, от чего он именно умер: то ли от многочисленных страшных резаных ран на животе и горле, то ли от потери крови из-за того, что его рука вырвана из плеча.~
@2926 = ~Это труп мужчины с удивленным выражением на лице с крючковатым носом. Сложно сказать, от чего он именно умер: то ли от многочисленных страшных резаных ран на животе и горле, то ли от потери крови из-за того, что его рука вырвана из плеча.~
@2927 = ~Этот скелет носит нечто похожее на одежды древнего жреца, тяжелые и богато украшенные. Он держит впечатляющий массивный посох c позолоченным черепом, рогами с замысловатой резьбой и болтающимися сверху побрякушками.~
@2928 = ~«Приветствую...»~
@2929 = ~Я, скорее всего, призрак, который летает по Сигилу и кое-каким другим зонам. Я даже не знаю, сделают ли меня.~
@2930 = ~Жизнь полна неопределенностей... и похоже, даже после смерти в этом плане нет никакого прогресса.~
@2931 = ~Я Фейн, лидер клана Голодных Псов Лающих в Пристанище головорезов. Я ЗЛОЙ человек. ЗЛОЙ! ЗЛОЙ! ~
@2932 = ~Твои хаоситеки все друг на друга похожи. Много лают и не кусаются.~
@2933 = ~Этот человек с бешеными глазами согнулся, лая и завывая на всю мощь своих легких. Под его густыми спутанными волосами ты замечаешь ряд странных татуировок... они меняются от кричащих лиц до странных геометрических фигур и чего то, похожего на строки стихов. Он почти голый, однако грязь, покрывающая его, придает ему вполне благопристойный вид.~
@2934 = ~Человек кружит перед тобой, затем издает низкий рык. Несколько секунд он продолжает рычать, затем начинает неистово лаять на тебя. Ты слышишь, как издалека кто-то лает ему в ответ.~
@2935 = ~Этот человек одет в мягкие синие одежды, покрытые замысловатым узором. Тем не менее, несмотря на их богатый вид, они выглядят помятыми и поношенными. Ты оцениваешь его возраст где-то между концом четвертого и началом шестого десятка... морщины от переживаний делают более точное определение затруднительным. Когда ты входишь, человек медленно поворачивается к тебе; при этом у тебя возникает жуткое чувство, что ты *знаешь* его... или знал когда-то.~
@2936 = ~«Приветствую...»~
@2937 = ~Оранжевая туника и приличных размеров живот этого невысокого лысеющего мужчины делают его похожим на ходячую тыкву. Он рассеянно и неспешно похлопывает себя по огромному пузу, будто это барабан. Его необычная перекошенная улыбка и странный блеск в глазах создают впечатление того, что он слегка не в себе.~
@2938 = ~«Приветствую...»~
@2939 = ~Перед тобой трепетно-сладострастная женщина с копной роскошных волнистых черных волос, голубоватой кожей и малиновыми глазами, сверкающими блеском рубинов. Хотя она не так уж и красива в типичном понимании этого слова, но нельзя сказать, что необычные черты делают ее непривлекательной.~
@2940 = ~«Приветствую...»~
@2941 = ~Эта дикая c виду девушка-тифлинг сердито встречает твой взгляд. На ее татуированном теле практически нет одежды: только узкие кожаные трусики, черный суконный бюстгальтер и бронированные наплечники, которые служат скорее украшением, чем настоящей защитой. Ее стоящие дыбом волосы, также как и короткий мех, покрывающий ее козьи ножки, — вызывающе белые. В ушах, ноздрях, губах и бровях болтаются многочисленные серебряные кольца. На ней надет кожаный ошейник с надписью «Кимаскси Змееязыкая».~
@2942 = ~«Приветствую...»~
@2943 = ~Эта привлекательная женщина средних лет мечтательно бродит туда-сюда, рассеянно покусывая ноготь на большом пальце; взгляд ее устремлен в никуда. Одета она в элегантные, хоть и немного измятые одежды, а волосы ее слегка взъерошены.~
@2944 = ~«Дар?»~
@2945 = ~«Здравствуйте, сигильцы! Занимайте свои места и послушайте о 'тайнах', о которых я буду говорить!»~
@2946 = ~Слушать.~
@2947 = ~«Хорошо! А теперь слушаем сюда... это семинар о *войне*. Если вы здесь, чтоб послушать о Кровавой войне — устраивайтесь поудобней. Если нет — вы ошиблись комнатой, и лучше вам вынести отсюдова свои изнеженные сигильские филейные части».~
@2948 = ~Слушать.~
@2949 = ~«Я *известен* как Приверженец Трех Планов, гитцерайский ученый. Если вы здесь ради моей лекции, то она уже вот-вот начнется».~
@2950 = ~«Я преследовал своего старого врага — теневого злодея Тира Танелеля...» Он делает паузу, ожидая аплодисментов, но, не дождавшись, продолжает: «Он вызвал какую-то демоническую магию, открыл для себя проход и бросился в него. Я ринулся за ним, чтобы не дать ему сбежать... и оказался здесь».~
@2951 = ~«Снова ты? Чего тебе нужно от старого Лотара? Я отдал тебе твоего друга-черепа и ответил на твои вопросы. Предупреждаю: я не собираюсь тратить на тебя весь день». Его взгляд падает на тебя с силой кувалды.~
@2952 = ~«Я хотел бы задать еще несколько вопросов».~
@2953 = ~Я крысооборотень, агент, представляющий коллектив черепных крыс, известный под названием Многоединый.~
@2954 = ~Рад встрече с тобой, крысооборотень. Уверен, что мы уже скоро скрестим наши мечи и слова.~
@2955 = ~Ты ошеломлен звуком сотен голосов, говорящих в унисон в твоей голове: у них сила и настойчивость, присущая попрошайкам. «ГОВОРИ, ЗАЧЕМ ПРИШЕЛ, ДВУНОГИЙ. ОТВЕЧАЙ БЫСТРО И ПРАВДИВО. ТЫ В ЗАЛАХ МНОГОЕДИНОГО. ТЫ НЕ УЙДЕШЬ, ПОКА МЫ ЭТОГО НЕ ПОЗВОЛИМ. ЗНАЙ, ЧТО МЫ МОЖЕМ ЧИТАТЬ ТВОИ МЫСЛИ, И ЧУВСТВУЕМ ЛОЖЬ».~
@2956 = ~«Кто вы?»~
@2957 = ~Приглядываясь к фигуре за перегородкой, ты с трудом различаешь стройную женскую фигуру в темноте. Она оборачивается к тебе, но ты не можешь разглядеть ее лицо.~
@2958 = ~Оставить ее в покое.~
@2959 = ~«Приветствую...»~
@2960 = ~С этим человеком определенно что-то *не так*... его шатающаяся походка, то, как он натыкается на все, как безучастно смотрит в пустое место. Приблизившись к нему, ты, наконец, понимаешь, в чем дело... у него нет головы. Та штука у него на плечах — просто искусно сделанный деревянный протез... фальшивая голова.~
@2961 = ~«Приветствую?..»~
@2962 = ~«Мне нужно, чтобы ты передал сообщение. Вот. Возьми его, и еще монеты».~
@2963 = ~«Хм. Как... любопытно».~
@2964 = ~Эта миниатюрная привлекательная девушка блаженно улыбается и мурлычет себе под нос. Ее большие бледно-голубые глаза, похоже, без устали поглощают все вокруг нее.~
@2965 = ~«Приветствую...»~
@2966 = ~Я зловещая книга заклинаний, которую ты можешь носить у себя в инвентаре.~
@2967 = ~Зловещая, говоришь? Заклинаний, значит? Я здесь! А теперь меня нет.~
@2968 = ~Ты видишь косоглазого парня, чья кожа морщится и бурлит по всему его телу. Он облизывает свои обветренные губы прыщавым языком. Наблюдая за ним, ты замечаешь, что его правый глаз двигается независимо от левого, фокусируясь на тебе. Секундой позже левый глаз быстро поворачивается и смотрит на тебя, потом возвращается на исходную позицию. Правый глаз моргает. Из его горла доносится странное бульканье.~
@2969 = ~«Приветствую...»~
@2970 = ~«Я был в гробнице, о которой ты говорил. Там пусто».~
@2971 = ~«Какие у меня гарантии, что ты сдержишь свое слово?»~
@2972 = ~Я пьяный драчун, которому нравится шататься по Чиновничьему району и устраивать драки. Если увидишь меня, точно станешь моей жертвой, так что берегись.~
@2973 = ~Нет, мне кажется, это ТЕБЕ лучше поберечься.~
@2974 = ~Это гранитная статуя мужчины в натуральную величину, с руками, сложенными по бокам, и закрытыми глазами. Она прекрасно выполнена, полна деталей и невероятно правдоподобна... настолько, что ты даже начинаешь сомневаться, действительно ли это статуя.~
@2975 = ~Ого... Что за каменный генаси? А знаешь что — забудь. Даже знать не хочу.~
@2976 = ~Пухлая крючконосая старуха перед тобой не очень-то похожа на миф: одета она в простую (хоть и грязную) коричневую рубаху и гетры, с множеством мешочков, свисающих с ее потрепанного пояса. Похоже, она не замечает твоего присутствия, и увлечена скорее рассматриванием запутанных черных корней, образующих пол лабиринта, чем происходящим вокруг себя.~
@2977 = ~Рассмотреть ее немного.~
@2978 = ~Я один из «шаблонных» членов Революционной лиги, хотя все мы на самом деле обладаем индивидуальностью.~
@2979 = ~Да, конечно же. Прощай.~
@2980 = ~Перед тобой куб с парой рук, ног и парой небольших крылышек по бокам. Спереди у куба есть лицо, которое при твоем приближении фокусирует на тебе взгляд.~
@2981 = ~«Приветствую».~
@2982 = ~Эта темноволосая девушка бесцельно смотрит в пустоту, горько вздыхая и время от времени теребя швы на своем зеленом вельветовом платье. Трудно сказать, подавлена она или просто скучает.~
@2983 = ~Оставить ее в покое.~
@2984 = ~«Приветствую...»~
@2985 = ~«Я один из 'типичных' чувствующих в Городском Фестхолле. Рад встрече».~
@2986 = ~«Рад оставить тебя».~
@2987 = ~Перед тобой невероятно привлекательная женщина; ее окружает какая-то неосязаемая аура, от которой с ней так и *хочется* заговорить. Когда ты подходишь к ней, она бросает на тебя робкий взгляд, затем дарит тебе понимающую улыбку.~
@2988 = ~«Приветствую...»~
@2989 = ~Золотистая кожа этого высокого мужчины слегка искрится, почти как металлическая. Ты не можешь определить, настоящая она, или это просто краска. Он спокойно наблюдает за твоим приближением и делает почтительный поклон, когда ты подходишь ближе. «Добро пожаловать в Городской Фестхолл, путник; мы — Сплинтер, привратник Фестхолла и Король-Жрец Ура. Чем мы можем помочь тебе?» Несмотря на его покорное предложение помощи, голос у него могучий и властный — низкий рокот, отражающийся от стен зала.~
@2990 = ~Ну, раз уж ты уничтожил мир, я не горю желанием болтать с тобой, если только ты не «загорелся» идеей уничтожить что-нибудь еще.~
@2991 = ~Эта пахнущая плесенью женщина-зомби выглядит исключительно старой, почти как мумия. У ее кожи вид гниющего серо-зеленого мяса, один из глаз выпал, оставив на лице темную дыру. Она говорит медленно и хрипло: «Пы-пы-пыривееествую».~
@2992 = ~«Приветствую...»~
@2993 = ~ИТАК, ТЫ ПРИШЕЛ.~ [TRA059]
@2994 = ~~
@2995 = ~Перед тобой существо с кожей цвета слоновой кости и ослепительно белыми волосами. Его крылья опалены, перья уничтожены, но он все еще излучает мир и любовь. Он стоит, словно в раздумье, не замечая твоего присутствия, и держит руки по бокам. Его запястья крепко закованы в цепи, прикрепленные к помосту, на котором он стоит. И хотя ты не припоминаешь, чтобы когда-либо видел дэва, но сердцем чувствуешь, что это и есть он.~
@2996 = ~«Я искал тебя, дэва».~
@2997 = ~Негативный символ~
@2998 = ~Татуировка воссоединения~
@2999 = ~Эта высокая элегантная женщина с резкими чертами лица и королевскими манерами — поразительный пример аристократической красоты. Ее одежда, похоже, соткана из серебряных нитей, а на ее ожерелье висит маленький пузырек. Она источает диковинный эротический запах, который, казалось бы, притягивает тебя к ней.~
@3000 = ~«Приветствую...»~
@3001 = ~Эта женщина с резкими чертами лица выглядит привлекательно, хотя ее темно-синяя кожа и желтые глаза немного настораживают. Когда она изучает тебя, у нее за спиной раскрываются два небольших крыла, как у летучей мыши, затем убираются обратно.~
@3002 = ~~
@3003 = ~Перед тобой хорошо одетая пожилая женщина в платье из ткани персикового и золотистого цветов. Она стоит неподвижно, чопорно сложив руки на груди. Она кивает в твоем направлении. Только сейчас ты замечаешь, что у нее нет зрачков: глаза у нее полностью белые. «Приветствую, сэр. Я Ивана. Добро пожаловать в мою галерею. Чувствуйте себя как дома, осмотритесь тут. Можете находиться здесь столько, сколько пожелаете. Если у вас возникнут вопросы относительно экспонатов, задавайте их без колебаний».~
@3004 = ~«У меня есть несколько вопросов, Ивана...»~
@3005 = ~У этой привлекательной девушки добрые глаза цвета морской волны, и взгляд ее направлен куда-то вдаль.~
@3006 = ~«Приветствую...»~
@3007 = ~Этот мужчина выглядит... затравленным. Можно предположить, что он плохо спит: веки полуприкрыты, волосы грязные и нечесаные, в бороде то и дело попадаются куски пищи. Похоже, он не замечает твоего присутствия.~
@3008 = ~«Приветствую...»~
@3009 = ~В волосах этой женщины средних лет уже пробивается проседь. Ее лицо тревожно... едва увидев тебя, кажется, не может выбрать — сначала попросить тебя уйти или же позвать мужчину у стола.~
@3010 = ~«Приветствую».~
@3011 = ~Ты видишь слегка сутулого старика с густой серой бородой и львиной гривой седых волос. Он носит пару наплечников от доспехов и держит шлем на руках. Он курит трубку и носит мешочек с табаком на поясе. На вид он довольно силен, однако немного страдает излишним весом и одышкой. «Ты только посмотри на себя, парень! Никогда еще не видел ни у кого столько шрамов — будто на тебе плащ из них! Ты где был — отсыпался в зернодробилке?! — он смеется. — О, я просто подтруниваю, парень, без обид. Я надеюсь, ты не обижаешься. Я — Эбб». Он протягивает руку.~
@3012 = ~«Приветствую, Эбб».~
@3013 = ~При твоем приближении Фелл поворачивается к тебе. Идущая за тобой Анна, поймав на себе взгляд Фелла, застывает.~
@3014 = ~«Зачем делать это каждые пять дней, в чем смысл?.. А, неважно, давай их сюда».~
@3015 = ~У мужчины перед тобой большие глаза и хрупкое тело. Кажется, он смущен и напуган видом окружающих его посетителей бара, однако, увидев тебя, он испытывает невероятное облегчение.~
@3016 = ~«Приветствую?»~
@3017 = ~Ты видишь железное... существо. Его размеры поражают. Если бы оно встало в полный рост, оно проломило бы крышу осадной башни. Под мостиком рокочет оглушающее эхо ударов молота по наковальне, а воздух заполнен запахом сажи и пепла. ~
@3018 = ~Оставить голема в покое.~
@3019 = ~«Приветствую».~
@3020 = ~Перед тобой мужчина сурового вида с квадратной челюстью. Он обращается к тебе с широкой улыбкой: «Как дела, рубака, добрый день». Он смотрит на тебя прищуренно, затем протягивает тебе руку.~
@3021 = ~Пожать его руку: «Приветствую».~
@3022 = ~Этот пожилой мужчина пялится на кружку с элем; на его лице лежит печать страданий. Помятая оловянная кружка выглядит необычно: на ней выгравировано несколько странных рун и бородатых лиц, ее покрывает тонкий слой инея. При твоем приближении он поднимает голову. «Приветствую... сэр...» Кажется, он немного пьян.~
@3023 = ~Татуировка злобы~
@3024 = ~Перед тобой больная гитцерайка. Она сгорблена, ее постоянный кашель явно причиняет ей боль: она держит у лица платок, насквозь пропитанный кровью и мокротой. Она следит за тобой, шипя.~
@3025 = ~«Приветствую».~
@3026 = ~Ты видишь юношу с бледно-желтой кожей. Его одежда грязная и нуждается в починке. В данный момент он приглядывает за печью.~
@3027 = ~«Приветствую».~
@3028 = ~Я торговец из Нижнего района. Я торгую на открытом рынке прямо перед аукционом.~
@3029 = ~Надеюсь, что хоть когда-нибудь я смогу КУПИТЬ что-нибудь у вас, ребята.~
@3030 = ~Я больной житель с Нижнего района. У меня есть потрясающая жизненная история, но я так занят кашлем, что не могу ничего сказать.~
@3031 = ~Может быть, это и к лучшему.~
@3032 = ~Ты видишь сутулого худого человека, который сгорбился над столом и что-то быстро пишет на листе бумаги. Волосы у него редкие и тусклые, и зачесаны назад в «хвостик», а его крючковатый нос украшают тонкие очки. Его возраст — где-то между началом второго десятка и концом четвертого. Обращаясь к тебе, он не поднимает головы. «Чего ты хочешь? Давай быстрее».~
@3033 = ~«Кто ты?»~
@3034 = ~Я недружелюбный житель Нижнего района. Прочь с дороги.~
@3035 = ~Ага, заглохни, приятель.~
@3036 = ~Я замкнутый житель Нижнего района. Небеса запретили воровать у меня секреты!~
@3037 = ~Чертова хитрая задница...~
@3038 = ~Я, наверное, единственный человек из всех в Нижнем районе, кто не против поговорить с незнакомцем. Я редчайшее исключение из всей массы.~
@3039 = ~Неважно. Может быть, мы поговорим снова, когда ты будешь готов, и тогда я проверю, действительно ли ты исключение или нет.~
@3040 = ~Абишай~
@3041 = ~Бармен~
@3042 = ~Стражник боголюдей~
@3043 = ~Путешественник по планам~
@3044 = ~Рабочий склада~
@3045 = ~Молодой Богочеловек~
@3046 = ~Анархист Проклятого~
@3047 = ~Смотритель свалки~
@3048 = ~Посетитель борделя~
@3049 = ~Посетитель бара~
@3050 = ~Наставник~
@3051 = ~Борец за справедливость~
@3052 = ~Воин-первичник~
@3053 = ~Аукционист~
@3054 = ~Больная гитцерайка~
@3055 = ~Мочай~
@3056 = ~Тегарин~
@3057 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого не хватает зуба с правой стороны. Заметив Анну и Падшую Грацию рядом с тобой, он скрежещет зубами, шипя: «Убери своих червей с Бездны, тогда и поговорим. Иначе мы ничего не скажем». Он смачно сплевывает.~
@3058 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого небольшой шрам под левым глазом. Заметив Анну и Падшую Грацию рядом с тобой, он скрежещет зубами, шипя: «Убери своих червей с Бездны, тогда и поговорим. Иначе мы ничего не скажем». Он смачно сплевывает.~
@3059 = ~«Тогда прощай». ~
@3060 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого небольшой шрам под левым глазом. Заметив Анну рядом с тобой, он скрежещет зубами, шипя: «Убери своего демонического червя, тогда и поговорим. Иначе мы ничего не скажем». Он смачно сплевывает.~
@3061 = ~Перед тобой чешуйчатый нечистый, очень похожий на своего собрата, стоящего рядом: у обоих проколото левое ухо, оба — черные ящеры со сложенными сзади перепончатыми крыльями. Только у этого не хватает зуба с правой стороны. Заметив Анну рядом с тобой, он скрежещет зубами, шипя: «Убери своего демонического червя, тогда и поговорим. Иначе мы ничего не скажем». Он смачно сплевывает.~
@3062 = ~ЧЕРЕП-КУЛОН
Вес: 1

Этот необычный кулон в форме черепа сделан из какого-то серебристого металла. Череп окружают шесть кристаллов, образуя нечто вроде короны. Через глазок над черепом продет кожаный шнурок.~
@3063 = ~МАЛЫЙ МЕЧ
Урон: 1-6
Вес: 3
Скорость: 3

Типичный малый меч моделей, вооруженных им (к примеру, горожан из высшего сословия).~
@3064 = ~КОСТЯНОЙ ПАЛЕЦ
Вес: 0

Это полностью разложившийся, практически без плоти, костяной палец человекоподобного существа размером примерно с тебя. На пальце надето какое-то необычное кольцо. Это замысловатый предмет, украшенный десятками крошечных декоративных выступов и ободков. Оно, как ни странно, намертво приросло к пальцу, и теперь его не снимешь, сколько бы усилий не прилагалось... почти как если бы зубчатые кромки кольца впились в безжизненный палец и отказывались его отпускать.~
@3065 = ~Это ожерелье из вычищенных острых зубов.~
@3066 = ~«Это ведь одна из студий Фелла? Давно хотел с ним познакомиться».~
@3067 = ~Первичник смотрит на тебя с отвращением. «Чего ТЕБЕ?» — уже само произношение полно ярости и затаенной обиды.~
@3068 = ~Кандриан встает, когда ты подходишь к нему. «Зубастая женщина передала тебе вот это, — говорит он, что-то протягивая в руке. — Она хотела выразить свою признательность, сравнять баланс в счетной книге, так сказать, а заодно и распрощаться с этими проклятыми штучками». На его ладони пляшут зубы Ингресс, которые он осторожно кладет тебе в руку. «Наслаждайся, искатель».~
@3069 = ~Ты видишь широкоплечее коренастое нечто с собачьей головой и четырьмя руками. Одна пара крупных мускулистых рук оканчивается ужасными зазубренными клешнями, которые выглядят так, будто могут вырвать саму душу из сопротивляющейся жертвы. Оно обращается к тебе неожиданно нежным голосом. «О, путешественник! Я вижу, ты привел с собой достойных компаньонов, — оно прерывает речь, чтобы понюхать воздух, — и *восхитительно* пахнущих. Я знал твоего отца, Анна. Он до сих пор батрачит в Бездне. Госпожа Грация, ваша мать Красная Пелена будет рада услышать новости о вашем добром здравии».~
@3070 = ~Ты видишь неподвижно стоящего человека. Ни один его мускул не шевелится. Присмотревшись, ты понимаешь, что он даже не дышит — просто стоит. Его глазницы пусты. В них горит тусклый серый свет, который, казалось бы, немного поигрывает. Заглядывая в них, ты ощущаешь сверхъестественное опустошающее чувство пронизывающей тебя бесконечной пустоты, как будто ты заглянул в вечность. Голова медленно поворачивается к тебе (ты отмечаешь, что ни один мускул под его кожей по-прежнему не шевелится), и он произносит чистым, мелодичным голосом: «Какая приятная встреча, скиталец. Ты опять все забыл, не так ли?»~
@3071 = ~Я Джаркел трехликий. В теории ты сможешь пообщаться со всеми меня тремя и получить головоломки, в зависимости от того, какие напитки ты мне принесешь. Возможно, за это я дам тебе что-нибудь прикольное.~
@3072 = ~Ты видишь неряшливого лохматого мужчину. От него сильно несет алкоголем. «Да? Чего тебе? — он пододвигает поближе и осматривает тебя сверху донизу. — Похоже, тебе нужен ЛЕКАРЬ!» Он громко хохочет над своей несмешной шуткой, обдавая тебя тошнотворной смесью запахов дешевого пойла и плохо пережеванной пищи.~
@3073 = ~Когда ты подходишь к женщине, чтобы поговорить с ней, глаза Игнуса наполняются огнем, и, до того, как ты успеваешь остановить его, он обнимает ее. Она обнимает его в ответ, теряясь в его пламени. Она даже не кричит. Последнее ее мгновение четко вжигается в твою память: ее глаза полны огненной страсти и всепоглощающей любви. От нее ничего не осталось — даже пепла.~
@3074 = ~Я дрянь, я лгунья, я воровка, я твоя мать, я гнойная болячка, которая надоедает... Стоп, это уже было у Мередит Брукс. А я — всего лишь торговец, который лжет, и через мою ложь ты сможешь узнать правду. Может быть.~
@3075 = ~В Серую пустошь попадаешь, лишь отчаявшись. Но потом, конечно, ты теряешь даже отчаянье. Подожди немного, я внесу в игру немного настоящей философии Унылых.~
@3076 = ~Перед тобой человек с загрубевшей кожей и слегка бледноватым лицом. Его зубы кажутся острее обычных, а глаза наполнены давно опостылевшей скукой. Голос у него гнусавый и обрывистый. «Опять ты? Чего на этот раз?»~
@3077 = ~«Опять я? Что ты имеешь в виду?»~
@3078 = ~«Да иду я, иду! Хватит мне докучать!»~
@3079 = ~Ты, похоже, настоящий неудачник. Жду не дождусь убить тебя.~
@3080 = ~Сарос~
@3081 = ~Стражник боголюдей~
@3082 = ~Богочеловек~
@3083 = ~Стражник Проклятого~
@3084 = ~Рабочий склада~
@3085 = ~Анархист Проклятого~
@3086 = ~Костолом~
@3087 = ~Авель Многодум~
@3088 = ~Посетитель борделя~
@3089 = ~Димтри~
@3090 = ~Илай Хейвлок~
@3091 = ~Кривой Гизис~
@3092 = ~Хайлциин~
@3093 = ~Харгримм Суровый~
@3094 = ~Гонсалвис~
@3095 = ~Солдат гитьянки~
@3096 = ~Йиминн~
@3097 = ~Фьюл Раздвоенный Язык~
@3098 = ~Фейн~
@3099 = ~Падшая Грация~
@3100 = ~Экко~
@3101 = ~Усердная~
@3102 = ~Защитник смерти~
@3103 = ~Неопасный конструкт~
@3104 = ~Конструкт средней опасности~
@3105 = ~Очень опасный конструкт~
@3106 = ~Злой Маг, конструкт~
@3107 = ~Убежденный Металл~
@3108 = ~Житель Чиновничьего района~
@3109 = ~Берт~
@3110 = ~Алаис~
@3111 = ~Хэпгуд~
@3112 = ~Брока~
@3113 = ~Луис ле Шкаф~
@3114 = ~Улица Протяжных вздохов~
@3115 = ~Адан Воображенный~
@3116 = ~Акаста~
@3117 = ~Смотритель свалки~
@3118 = ~Фелл~
@3119 = ~Винокур~
@3120 = ~Эбб Коленоскрип~
@3121 = ~Адан~
@3122 = ~Серый пустынник~
@3123 = ~Джаркел~
@3124 = ~Даккон~
@3125 = ~О~
@3126 = ~Игнус~
@3127 = ~Черный Бутон~
@3128 = ~Житель~
@3129 = ~Кандриан~
@3130 = ~Хенсдейл~
@3131 = ~Баркис~
@3132 = ~Пожилая женщина~
@3133 = ~Адвокат~
@3134 = ~Житель Проклятого~
@3135 = ~Суккуб~
@3136 = ~Скелет-жрец~
@3137 = ~Портной~
@3138 = ~Гитьянки~
@3139 = ~Хромой корнугон~
@3140 = ~Проститутка~
@3141 = ~Лидер Голодных Псов~
@3142 = ~Лектор~
@3143 = ~Неопасный конструкт~
@3144 = ~Конструкт средней опасности~
@3145 = ~Очень опасный конструкт~
@3146 = ~Злой Маг, конструкт~
@3147 = ~Железный голем~
@3148 = ~Служащий~
@3149 = ~Скелет~
@3150 = ~Шкаф~
@3151 = ~Улица Протяжных вздохов~
@3152 = ~Древняя упыриха~
@3153 = ~Житель Чиновничьего района~
@3154 = ~Костолом~
@3155 = ~Головорез Проклятого~
@3156 = ~Стражник Проклятого~
@3157 = ~Винокур~
@3158 = ~Тлеющий труп~
@3159 = ~Богочеловек~
@3160 = ~Привет. Я работаю на складе в Проклятом. Если меня вежливо попросить, то я скажу тебе, что тут собираются анархисты, и, возможно, ты сам решишь встретиться с ними.~
@3161 = ~Конечно. А еще, может быть, срежу себе корешок.~
@3162 = ~Этот человек окидывает тебя полным недоверия взглядом, быстро отводит глаза в сторону, проигнорировав тебя, и возвращается к незавершенному делу. Вся толпа как будто готовится к какому-то вооруженному восстанию.~
@3163 = ~Уйти.~
@3164 = ~Ты видишь молодого человека, примеряющего неподходящие вещи. Он смотрит на тебя скучающим взглядом.~
@3165 = ~«Приветствую».~
@3166 = ~Ты видишь старика, стоящего рядом с небольшой толпой. Они собрались вокруг предмета, похожего на гильотину.~
@3167 = ~«Приветствую».~
@3168 = ~Ты отвлекаешь от работы этого здоровяка, и он кисло смотрит на тебя. Похоже, он немного медлительный, но искренний: не такой отвратительный, как остальные горожане. «Да? Чего тебе?»~
@3169 = ~«Кто ты?»~
@3170 = ~Эти ворота удерживаются тяжелыми замками и шипами. Похоже на то, что никакими подручными средствами их открыть не удастся.~
@3171 = ~Произнести слова, которые дал тебе Триас.~
@3172 = ~Перед тобой юноша с угрюмым лицом. Он что-то бормочет себе под нос; похоже, он чем-то озабочен.~
@3173 = ~«Приветствую».~
@3174 = ~«Пожалуйста! Спаси меня! Они хотят меня убить просто за то, что я делаю свою работу! Я не хотел никому навредить! Нельзя же просто смотреть, как они превращают город в развалины!» Он начинает рыдать. «Пожалуйста... сделай хоть что-нибудь!»~
@3175 = ~«Лучше я буду смотреть на то, как ты умрешь».~
@3176 = ~Сиабха плюет тебе под ноги. «Плешивый пес! Да как ты смеешь говорить со мной после того, как из-за твоих лживых слов меня упекли сюда! Предатель! Чтоб тебя Стикс засосал и выкинул на берег только белые кости, и пусть из них выточат флейты для армий дерьмоедов!»~
@3177 = ~~
@3178 = ~Лицо этой женщины с орлиным профилем имеет надменный вид. В разговоре с тобой она буквально излучает презрение. «У меня полно дел. Не задерживай меня».~
@3179 = ~Слыхал, что ты ищешь способ попасть в Тюрьму. Как только я получу нормальный диалог, я скажу тебе, как это сделать.~
@3180 = ~«У меня всего лишь пара вопросов...»~
@3181 = ~А потом я смогу добраться до этого изменника ангела Триаса! Круто!~
@3182 = ~Ай! Меня схватили работорговцы! Мне нужна помощь!~
@3183 = ~Жди, пока я не появлюсь!~
@3184 = ~Перед робкий человечек с бегающими испуганными глазами. «Пожалуйста, не бей меня! — он вот-вот заплачет. — Они меня убьют, если найдут!»~
@3185 = ~«Кто тебя убьет?»~
@3186 = ~Я завсегдатай бара Проклятого. Имя сменю потом.~
@3187 = ~Хорошо, хорошо.~
@3188 = ~Я тоже завсегдатай этого замечательного заведения.~
@3189 = ~Должно быть, это действительно замечательное место.~
@3190 = ~Как и двое предыдущих, я частый посетитель этого места.  Хотя по идее я должна быть женского пола и посетительницей. Ха-ха!~
@3191 = ~Да ты настоящий бунтарь.~
@3192 = ~Завсегдатай 4. Йау.~
@3193 = ~Да. Йау.~
@3194 = ~Может быть, я расскажу тебе о туннелях. Это хорошо?~
@3195 = ~Да, это хорошо. Пока это не станет плохо.~
@3196 = ~Тебя окликает грязный, воняющий отбросами старик: «Приятель! Задержись на минутку! Я должен рассказать тебе, что здесь произошло!»~
@3197 = ~«Кто ты?»~
@3198 = ~Я — одно из тел, висящих на воротах Проклятого. У нас нескольких один диалог. Мы рассказываем тебе то, что ты не хочешь слушать.~
@3199 = ~Даже слышать не хочу.~
@3200 = ~Эта немолодая знатная женщина приветствует тебя элегантным реверансом. «Приветствую, сэр. Прежде чем вы зададите вопрос, позволю себе заметить, что я здесь — постоянный клиент, а не одна из учениц».~
@3201 = ~«Постоянный клиент?»~
@3202 = ~Этот энергичный аристократ с презрением наблюдает за твоим приближением. «Я здесь, чтобы разговаривать с дамами, сэр, но *не с такими*, как вы. И, безусловно, я надеюсь, вы не намерены докучать мне вопросами или чем-то в этом роде».~
@3203 = ~«На самом деле, у меня есть несколько вопросов...»~
@3204 = ~Этот джентльмен ничем не примечателен, если только не считать синяка под глазом, как будто ему врезали. Он слегка кивает, когда ты подходишь. «Приветствую, сэр».~
@3205 = ~«Приветствую. У меня есть несколько вопросов...»~
@3206 = ~Этот человек сильно нахмурился, сосредоточившись на чем-то. При твоем приближении он окидывает тебя взглядом и коротко кивает. «Да?»~
@3207 = ~«У меня есть несколько вопросов...» ~
@3208 = ~Похоже, это странное кубическое создание является в равной мере машиной и органическим существом. Пока ты подходишь к нему, оно молча следит за тобой широко раскрытыми немигающими глазами. На его лице нет ни намека на эмоции.~
@3209 = ~Эта дверь запечатана.~
@3210 = ~Адвокат~
@3211 = ~Лауден~
@3212 = ~Кесай-Серри~
@3213 = ~Вивьен~
